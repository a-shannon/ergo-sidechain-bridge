{
  "name": "ergo-sidechain-bridge-v1",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Clean V1 Ergo <-> Frontier/EVM sidechain bridge (stock Ergo 6.0.3 compatible, EIP-0045 graduation ready)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts.test.ts",
    "test:mutations": "vitest run tests/ergoscript-mutations.test.ts",
    "test:e2e": "tsx scripts/e2e-live.ts",
    "test:timelock-frontier": "tsx scripts/test-timelock-frontier.ts",
    "fuzz:evm-frontier": "tsx scripts/fuzz-evm-frontier.ts",
    "audit:verify": "tsx scripts/verify-audit-manifest.ts",
    "gen:mtls": "tsx scripts/generate-mtls-certs.ts",
    "cli": "tsx src/cli.ts",
    "status:testnet": "tsx src/cli.ts status --config config.testnet.live.json",
    "reconstruct:testnet": "tsx src/cli.ts reconstruct --config config.testnet.live.json",
    "ui:testnet": "tsx src/cli.ts ui --config config.testnet.live.json",
    "signer-node": "tsx src/cli.ts signer-node"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "blakejs": "^1.2.1",
    "ergo-lib-wasm-nodejs": "^0.28.0",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.5.0",
    "vitest": "4.1.12"
  }
}

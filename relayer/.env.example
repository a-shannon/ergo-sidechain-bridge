# Ergo Sidechain Bridge relayer example environment.
#
# Copy this file to `.env` for local development.
# Do not commit `.env`.
#
# Security model:
# - The Ergo node should be treated as an RPC endpoint.
# - Do not put the bridge mnemonic into the node wallet.
# - Ergo transactions are signed locally by the relayer with FleetSDK / ergo-lib-wasm.

# Ergo node RPC
ERGO_NODE_URL=http://localhost:9052
ERGO_API_KEY=hello
ERGO_NETWORK_PREFIX=16

# Local signing wallet.
# Replace with a funded Ergo testnet mnemonic used only by this relayer process.
WALLET_MNEMONIC="replace this with a funded testnet mnemonic"

# Substrate / Frontier endpoints
SUBSTRATE_WS_URL=ws://localhost:9945
SUBSTRATE_EVM_URL=http://localhost:9945

# Optional. If omitted, config.ts uses the standard local Frontier dev key.
# EVM_PRIVATE_KEY=0x...

# Sidechain identity committed into the SPV tracker key.
SPV_SIDECHAIN_ID_HEX=1111111111111111111111111111111111111111111111111111111111111111

# Core bridge timing
CONFIRMATION_DEPTH=50
POLLING_INTERVAL_MS=5000

# Explicit broadcast opt-in. Keep false for dry-run/preflight sessions.
BRIDGE_BROADCAST_ENABLED=false

# Aggregate settlement path
AGGREGATE_SETTLEMENT_ENABLED=true
AGGREGATE_BATCH_ENABLED=true
AGGREGATE_BATCH_MAX_CLAIMS=10
AGGREGATE_ANCHOR_MIN_CONFIRMATIONS=10
AGGREGATE_ANCHOR_LOOKBACK_BLOCKS=720

# Aggregate deploy defaults
AGGREGATE_SINGLETON_VALUE_NANOERG=5000000
AGGREGATE_UNLOCK_LIQUIDITY_NANOERG=100000000

# Committee placeholders for deploy / compile scripts.
# For Phase 010a, replace with the committee key set and threshold.
COMMITTEE_PUBKEY_HEX=
COMMITTEE_THRESHOLD=1

# Optional compile overrides for batch unlock when compiling outside `--check`.
# Normally loaded from contracts/deployed_state.json after deployment.
# TRACKER_NFT_ID=
# DUP_AGGREGATE_BATCH_NFT_ID=


+fn canonical_application_hex(
+	encoded: &str,
+	min: usize,
+	max: usize,
+) -> Result<Vec<u8>, &'static str> {
+	let payload = encoded.strip_prefix("0x").ok_or("hex prefix")?;
+	if payload.len() < min * 2
+		|| payload.len() > max * 2
+		|| payload.len() % 2 != 0
+		|| !payload
+			.bytes()
+			.all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+	{
+		return Err("bounded canonical hex");
+	}
+	hex::decode(payload).map_err(|_| "hex bytes")
+}
+
+fn decode_signed_application_calls(
+	statement: &PooledReserveMintReservationStatementBytesV4,
+	encoded: [&str; 3],
+	ergo_recipient: &str,
+) -> Result<SignedApplicationCalls, &'static str> {
+	let validated = validate_pooled_reserve_mint_reservation_statement_v4(statement)
+		.map_err(|_| "canonical reservation")?;
+	let intent = &validated.statement.source_intent;
+	let deployer = evm_address(H256::from(EVM_SECRET));
+	if intent.bridge_address != contract_address(deployer, 1)
+		|| intent.token_address != contract_address(deployer, 0)
+		|| intent.amount != MINIMUM_PEG_OUT_NANO_ERG + BRIDGE_FEE_NANO_ERG
+	{
+		return Err("LAB application profile");
+	}
+	if intent.recipient == H160::zero()
+		|| intent.recipient == deployer
+		|| intent.recipient == intent.bridge_address
+		|| intent.recipient == intent.token_address
+	{
+		return Err("fresh owner");
+	}
+	let recipient_public_key: [u8; 33] = canonical_application_hex(ergo_recipient, 33, 33)?
+		.try_into()
+		.map_err(|_| "recipient length")?;
+	let point = libsecp256k1::PublicKey::parse_slice(&recipient_public_key, None)
+		.map_err(|_| "recipient point")?;
+	if point.serialize_compressed() != recipient_public_key {
+		return Err("compressed recipient");
+	}
+	let data = [
+		abi_call(
+			b"mintSERG(address,uint256,bytes32)",
+			&[
+				H256::from(intent.recipient),
+				H256::from_low_u64_be(intent.amount),
+				validated.statement.mint_identity,
+			],
+		),
+		abi_call(
+			b"approve(address,uint256)",
+			&[
+				H256::from(intent.bridge_address),
+				H256::from_low_u64_be(intent.amount),
+			],
+		),
+		abi_call_with_dynamic_bytes(
+			b"pegOut(uint256,bytes)",
+			H256::from_low_u64_be(intent.amount),
+			&recipient_public_key,
+		),
+	];
+	let targets = [
+		intent.bridge_address,
+		intent.token_address,
+		intent.bridge_address,
+	];
+	let mut calls = Vec::with_capacity(3);
+	for index in 0..3 {
+		calls.push(decode_signed_application_transaction(
+			encoded[index],
+			intent.recipient,
+			index as u64,
+			targets[index],
+			&data[index],
+		)?);
+	}
+	Ok(SignedApplicationCalls {
+		statement_id: validated.statement_id,
+		owner: intent.recipient,
+		recipient_public_key,
+		transactions: calls.try_into().map_err(|_| "three calls")?,
+	})
+}
+
+fn decode_signed_application_transaction(
+	encoded: &str,
+	owner: H160,
+	nonce: u64,
+	target: H160,
+	data: &[u8],
+) -> Result<Transaction, &'static str> {
+	let bytes = canonical_application_hex(encoded, 1, 1024)?;
+	let tx: LegacyTransaction = rlp::decode(&bytes).map_err(|_| "legacy transaction")?;
+	if rlp::encode(&tx).as_ref() != bytes.as_slice() {
+		return Err("canonical RLP");
+	}
+	if !tx.signature.is_low_s() {
+		return Err("low s");
+	}
+	if tx.signature.chain_id() != Some(TEST_CHAIN_ID) {
+		return Err("chain id");
+	}
+	if tx.nonce != U256::from(nonce) {
+		return Err("nonce");
+	}
+	if tx.gas_price != U256::from(TEST_GAS_PRICE) {
+		return Err("gas price");
+	}
+	if tx.gas_limit != U256::from(TEST_GAS_LIMIT) {
+		return Err("gas limit");
+	}
+	if tx.value != U256::zero() {
+		return Err("value");
+	}
+	if tx.action != TransactionAction::Call(target) {
+		return Err("destination");
+	}
+	if tx.input != data {
+		return Err("calldata");
+	}
+	let mut signature = [0u8; 64];
+	signature[..32].copy_from_slice(tx.signature.r().as_bytes());
+	signature[32..].copy_from_slice(tx.signature.s().as_bytes());
+	let signature =
+		libsecp256k1::Signature::parse_standard_slice(&signature).map_err(|_| "signature")?;
+	let recovery =
+		libsecp256k1::RecoveryId::parse(tx.signature.standard_v()).map_err(|_| "recovery id")?;
+	let message = libsecp256k1::Message::parse(tx.clone().to_message().hash().as_fixed_bytes());
+	let public = libsecp256k1::recover(&message, &signature, &recovery)
+		.map_err(|_| "signature recovery")?
+		.serialize();
+	if H160::from_slice(&keccak_256(&public[1..])[12..]) != owner {
+		return Err("signer");
+	}
+	Ok(Transaction::Legacy(tx))
+}

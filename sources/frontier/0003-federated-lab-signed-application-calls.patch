+#[test]
+fn federated_lab_signed_calls_reject_signature_and_encoding_aliases() {
+	let secret = H256::repeat_byte(7);
+	let owner = evm_address(secret);
+	let target = H160::repeat_byte(9);
+	let data = vec![1, 2, 3, 4];
+	for nonce in 0..3 {
+		let Transaction::Legacy(base) =
+			signed_legacy_transaction(secret, nonce, TransactionAction::Call(target), data.clone())
+		else {
+			panic!("legacy fixture");
+		};
+		let check = |bytes: &[u8]| {
+			decode_signed_application_transaction(
+				&format!("0x{}", hex::encode(bytes)),
+				owner,
+				nonce,
+				target,
+				&data,
+			)
+		};
+		let encoded = rlp::encode(&base);
+		assert!(check(&encoded).is_ok());
+		let mut trailing = encoded.to_vec();
+		trailing.push(0);
+		assert!(rlp::decode::<LegacyTransaction>(&trailing).is_err());
+		assert_eq!(check(&trailing), Err("legacy transaction"));
+		let mut high_s = base.clone();
+		let order = U256::from_big_endian(&hex_literal::hex!(
+			"fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141"
+		));
+		let s = order - U256::from_big_endian(base.signature.s().as_bytes());
+		high_s.signature = TransactionSignature::new(
+			TEST_CHAIN_ID * 2 + 35 + u64::from(base.signature.standard_v() ^ 1),
+			*base.signature.r(),
+			H256::from(s.to_big_endian()),
+		)
+		.expect("high-s alias remains recoverable");
+		assert_eq!(check(&rlp::encode(&high_s)), Err("low s"));
+		let original = rlp::Rlp::new(&encoded);
+		let mut alias = RlpStream::new_list(9);
+		for index in 0..9 {
+			if index == 4 {
+				alias.append_raw(&[0], 1);
+			} else {
+				alias.append_raw(original.at(index).expect("field").as_raw(), 1);
+			}
+		}
+		assert!(
+			check(&alias.out()).is_err(),
+			"nonminimal zero value must reject"
+		);
+		let mut typed = vec![2];
+		typed.extend_from_slice(&encoded);
+		assert!(check(&typed).is_err());
+		assert!(check(&encoded[..encoded.len() - 1]).is_err());
+		assert!(check(&vec![0; 1025]).is_err());
+		assert!(decode_signed_application_transaction(
+			&format!("0x{}", hex::encode(&encoded).to_uppercase()),
+			owner,
+			nonce,
+			target,
+			&data
+		)
+		.is_err());
+	}
+}

+		.expect("Ethereum block exists");
+	let statuses = client
+		.runtime_api()
+		.current_transaction_statuses(block)
+		.expect("Ethereum statuses query succeeds")
+		.expect("Ethereum statuses exist");
+	let receipts = client
+		.runtime_api()
+		.current_receipts(block)
+		.expect("Ethereum receipts query succeeds")
+		.expect("Ethereum receipts exist");
+	assert_eq!(ethereum.transactions.len(), hashes.len());
+	assert_eq!(statuses.len(), hashes.len());
+	assert_eq!(receipts.len(), hashes.len());
+	for (index, hash) in hashes.iter().enumerate() {
+		assert_eq!(ethereum.transactions[index].hash(), *hash);
+		assert_eq!(statuses[index].transaction_hash, *hash);
+		assert_eq!(statuses[index].transaction_index as usize, index);
+		let data = match &receipts[index] {
+			pallet_ethereum::Receipt::Legacy(data) => data,
+			_ => panic!("exact legacy receipt required"),
+		};
+		assert_eq!(data.status_code, 1);
+		assert_eq!(data.logs, statuses[index].logs);
+	}
+}

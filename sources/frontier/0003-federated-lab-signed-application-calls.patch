+struct SignedApplicationCalls {
+	statement_id: H256,
+	owner: H160,
+	recipient_public_key: [u8; 33],
+	transactions: [Transaction; 3],
+}
+
+fn reject_reference_application_authority(keys: &[[u8; 32]]) -> Result<(), &'static str> {
+	let reference = ReferenceFederatedPooledReserveSourceProofProfileV1::profile();
+	if keys
+		.iter()
+		.any(|key| reference.signer_public_keys.contains(key))
+	{
+		return Err("public fixture authority");
+	}
+	Ok(())
+}
+
+#[test]
+fn federated_lab_signed_calls_reject_reference_authority() {
+	let reference = ReferenceFederatedPooledReserveSourceProofProfileV1::profile();
+	assert_eq!(
+		reject_reference_application_authority(&reference.signer_public_keys),
+		Err("public fixture authority")
+	);
+	// Reject each published key, including a mixed set with a non-reference majority.
+	for key in &reference.signer_public_keys {
+		assert_eq!(
+			reject_reference_application_authority(&[[7; 32], *key, [8; 32]]),
+			Err("public fixture authority")
+		);
+	}
+	assert_eq!(
+		reject_reference_application_authority(&[[7; 32], [8; 32]]),
+		Ok(())
+	);
+}

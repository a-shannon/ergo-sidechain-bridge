+#[test]
+fn federated_lab_signed_calls_bind_complete_application() {
+	let secret = H256::repeat_byte(7);
+	let owner = evm_address(secret);
+	let deployer = evm_address(H256::from(EVM_SECRET));
+	let bridge = contract_address(deployer, 1);
+	let token = contract_address(deployer, 0);
+	let base = reservation_statement_from_environment(bridge, token);
+	let statement_for = |bridge: H160, token: H160, owner: H160, amount: u64| {
+		let mut bytes = base.to_vec();
+		bytes[98..118].copy_from_slice(bridge.as_bytes());
+		bytes[118..138].copy_from_slice(token.as_bytes());
+		bytes[234..242].copy_from_slice(&amount.to_be_bytes());
+		bytes[242..262].copy_from_slice(owner.as_bytes());
+		bytes[487..495].copy_from_slice(&amount.to_be_bytes());
+		let intent_id = domain_hash(b"E2S_PEG_IN_SOURCE_INTENT_V2", &bytes[33..262]);
+		bytes[262..294].copy_from_slice(intent_id.as_bytes());
+		let statement: PooledReserveMintReservationStatementBytesV4 =
+			bytes.try_into().expect("fixed statement");
+		validate_pooled_reserve_mint_reservation_statement_v4(&statement)
+			.expect("self-consistent changed statement");
+		statement
+	};
+	let statement = statement_for(bridge, token, owner, 15_000_000);
+	let validated =
+		validate_pooled_reserve_mint_reservation_statement_v4(&statement).expect("canonical");
+	let point = libsecp256k1::PublicKey::from_secret_key(
+		&libsecp256k1::SecretKey::parse_slice(H256::repeat_byte(8).as_bytes())
+			.expect("synthetic fixture"),
+	)
+	.serialize_compressed();
+	let point_hex = format!("0x{}", hex::encode(point));
+	let data = [
+		abi_call(
+			b"mintSERG(address,uint256,bytes32)",
+			&[
+				H256::from(owner),
+				H256::from_low_u64_be(15_000_000),
+				validated.statement.mint_identity,
+			],
+		),
+		abi_call(
+			b"approve(address,uint256)",
+			&[H256::from(bridge), H256::from_low_u64_be(15_000_000)],
+		),
+		abi_call_with_dynamic_bytes(
+			b"pegOut(uint256,bytes)",
+			H256::from_low_u64_be(15_000_000),
+			&point,
+		),
+	];
+	let targets = [bridge, token, bridge];
+	let sign_call = |index: usize, input: Vec<u8>| {
+		let Transaction::Legacy(tx) = signed_legacy_transaction(
+			secret,
+			index as u64,
+			TransactionAction::Call(targets[index]),
+			input,
+		) else {
+			panic!("legacy");
+		};
+		format!("0x{}", hex::encode(rlp::encode(&tx)))
+	};
+	let calls = [
+		sign_call(0, data[0].clone()),
+		sign_call(1, data[1].clone()),
+		sign_call(2, data[2].clone()),
+	];
+	let check = |statement: &PooledReserveMintReservationStatementBytesV4,
+	             calls: &[String; 3],
+	             point: &str| {
+		decode_signed_application_calls(statement, [&calls[0], &calls[1], &calls[2]], point)
+			.map(|_| ())
+	};
+	assert_eq!(check(&statement, &calls, &point_hex), Ok(()));
+	for forbidden in [deployer, bridge, token] {
+		assert_eq!(
+			check(
+				&statement_for(bridge, token, forbidden, 15_000_000),
+				&calls,
+				&point_hex
+			),
+			Err("fresh owner")
+		);
+	}
+	for changed in [
+		statement_for(H160::repeat_byte(8), token, owner, 15_000_000),
+		statement_for(bridge, H160::repeat_byte(8), owner, 15_000_000),
+		statement_for(bridge, token, owner, 15_000_001),
+	] {
+		assert_eq!(
+			check(&changed, &calls, &point_hex),
+			Err("LAB application profile")
+		);
+	}
+	assert_eq!(
+		check(&statement, &calls, &format!("0x02{}", "00".repeat(32))),
+		Err("recipient point")
+	);
+	for (left, right) in [(0, 1), (0, 2), (1, 2)] {
+		let mut swapped = calls.clone();
+		swapped.swap(left, right);
+		assert_eq!(check(&statement, &swapped, &point_hex), Err("nonce"));
+	}
+	for index in 0..3 {
+		// Re-sign each mutation so only the complete-calldata binding rejects it.
+		for offset in 0..data[index].len() {
+			let mut changed_data = data[index].clone();
+			changed_data[offset] ^= 1;
+			let mut changed = calls.clone();
+			changed[index] = sign_call(index, changed_data);
+			assert_eq!(
+				check(&statement, &changed, &point_hex),
+				Err("calldata"),
+				"role {index}, byte {offset}"
+			);
+		}
+	}
+}

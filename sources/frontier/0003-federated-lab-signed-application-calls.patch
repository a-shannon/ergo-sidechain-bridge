+#[test]
+fn federated_lab_signed_calls_reject_single_field_changes() {
+	let secret = H256::repeat_byte(7);
+	let owner = evm_address(secret);
+	let target = contract_address(evm_address(H256::from(EVM_SECRET)), 1);
+	let data = abi_call(
+		b"mintSERG(address,uint256,bytes32)",
+		&[
+			H256::from(owner),
+			H256::from_low_u64_be(15_000_000),
+			H256::repeat_byte(9),
+		],
+	);
+	for nonce in 0..3 {
+		let base = LegacyTransactionMessage {
+			nonce: U256::from(nonce),
+			gas_price: U256::from(TEST_GAS_PRICE),
+			gas_limit: U256::from(TEST_GAS_LIMIT),
+			action: TransactionAction::Call(target),
+			value: U256::zero(),
+			input: data.clone(),
+			chain_id: Some(TEST_CHAIN_ID),
+		};
+		let check = |message: LegacyTransactionMessage, key: H256| {
+			let transaction = sign_legacy_message(message, key);
+			let encoded = format!("0x{}", hex::encode(rlp::encode(&transaction)));
+			decode_signed_application_transaction(&encoded, owner, nonce, target, &data)
+		};
+		assert!(check(base.clone(), secret).is_ok());
+		assert_eq!(check(base.clone(), H256::repeat_byte(8)), Err("signer"));
+		let mut wrong = base.clone();
+		wrong.chain_id = Some(TEST_CHAIN_ID + 1);
+		assert_eq!(check(wrong, secret), Err("chain id"));
+		let mut wrong = base.clone();
+		wrong.chain_id = None;
+		assert_eq!(check(wrong, secret), Err("chain id"));
+		let mut wrong = base.clone();
+		wrong.nonce += U256::one();
+		assert_eq!(check(wrong, secret), Err("nonce"));
+		let mut wrong = base.clone();
+		wrong.gas_price += U256::one();
+		assert_eq!(check(wrong, secret), Err("gas price"));
+		let mut wrong = base.clone();
+		wrong.gas_limit += U256::one();
+		assert_eq!(check(wrong, secret), Err("gas limit"));
+		let mut wrong = base.clone();
+		wrong.value = U256::one();
+		assert_eq!(check(wrong, secret), Err("value"));
+		let mut wrong = base.clone();
+		wrong.action = TransactionAction::Create;
+		assert_eq!(check(wrong, secret), Err("destination"));
+		let mut wrong = base.clone();
+		wrong.action = TransactionAction::Call(owner);
+		assert_eq!(check(wrong, secret), Err("destination"));
+		for index in 0..data.len() {
+			let mut wrong = base.clone();
+			wrong.input[index] ^= 1;
+			assert_eq!(
+				check(wrong, secret),
+				Err("calldata"),
+				"nonce {nonce}, byte {index}"
+			);
+		}
+		let mut wrong = base.clone();
+		wrong.input.push(0);
+		assert_eq!(check(wrong, secret), Err("calldata"));
+	}
+}

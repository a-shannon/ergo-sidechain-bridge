+	assert_eq!(account_before.nonce, U256::from(3u64));
+	let sidechain_id = client
+		.block_hash(0)
+		.expect("genesis hash query succeeds")
+		.expect("genesis block exists");
+	let record_key = processed_peg_in_storage_key(sidechain_id, ergo_box_id);
+	let profile_key = storage_value_key(b"BridgeCommitment", b"CurrentPegInProfile");
+	let bridge_address_key = storage_value_key(b"BridgeCommitment", b"BridgeAddress");
+	let events_key = storage_value_key(b"System", b"Events");
+	assert!(storage_at(&client, before.best_hash, &record_key).is_none());
+	assert!(storage_at(&client, before.best_hash, &profile_key).is_none());
+	assert_eq!(
+		storage_at(&client, before.best_hash, &bridge_address_key),
+		Some(bridge_address.encode()),
+	);
+	let events_before = storage_at(&client, before.best_hash, &events_key);
+	let current_block_before = client
+		.runtime_api()
+		.current_block(before.best_hash)
+		.expect("current Ethereum block query succeeds");
+	let receipts_before = client
+		.runtime_api()
+		.current_receipts(before.best_hash)
+		.expect("current Ethereum receipts query succeeds");
+	let statuses_before = client
+		.runtime_api()
+		.current_transaction_statuses(before.best_hash)
+		.expect("current Ethereum statuses query succeeds");
+
+	let mint_input = abi_call(
+		b"mintSERG(address,uint256,bytes32)",
+		&[
+			H256::from(recipient),
+			H256::from_low_u64_be(amount),
+			ergo_box_id,
+		],
+	);
+	let pool_mint = ethereum_extrinsic(signed_legacy_transaction(
+		secret,
+		account_before.nonce.low_u64(),
+		TransactionAction::Call(bridge_address),
+		mint_input.clone(),
+	));
+	assert_eq!(
+		client
+			.runtime_api()
+			.validate_transaction(
+				before.best_hash,
+				TransactionSource::External,
+				pool_mint,
+				before.best_hash,
+			)
+			.expect("transaction-pool validation executes"),
+		Err(TransactionValidityError::Invalid(
+			InvalidTransaction::Custom(181,)
+		)),
+	);
+
+	let mint = ethereum_extrinsic(signed_legacy_transaction(
+		secret,
+		account_before.nonce.low_u64() + 1,
+		TransactionAction::Call(bridge_address),
+		mint_input,
+	));
+	let retarget_legacy_profile = RuntimeCall::Sudo(pallet_sudo::Call::sudo {
+		call: Box::new(RuntimeCall::BridgeCommitment(
+			BridgeCommitmentCall::set_bridge_address {
+				address: Some(H160::repeat_byte(0xbb)),
+			},
+		)),
+	});
+	let prefix_extrinsics = vec![
+		timestamp_extrinsic(24_000),
+		signed_sudo_extrinsic(
+			&client,
+			&signer,
+			account_before.nonce.low_u32(),
+			retarget_legacy_profile,
+		),
+	];
+	let mut candidate_extrinsics = prefix_extrinsics.clone();
+	candidate_extrinsics.push(mint.clone());
+
+	// The exact pre-dispatch hook rejects before EVM execution, while the already
+	// applied prefix remains finalizable in the disposable candidate overlay.
+	let overlay_header = Header::new(
+		before.best_number + 1,
+		Default::default(),
+		Default::default(),
+		before.best_hash,
+		Digest::default(),
+	);
+	let mut overlay_api = client.runtime_api();
+	overlay_api.set_call_context(CallContext::Onchain);
+	overlay_api
+		.initialize_block(before.best_hash, &overlay_header)
+		.expect("candidate overlay initializes from the accepted parent");
+	for extrinsic in prefix_extrinsics.iter().cloned() {
+		overlay_api
+			.apply_extrinsic(before.best_hash, extrinsic)
+			.expect("candidate prefix extrinsic executes")
+			.expect("candidate prefix extrinsic is valid")
+			.expect("candidate prefix dispatch succeeds");
+	}
+	assert_eq!(
+		overlay_api
+			.apply_extrinsic(before.best_hash, mint)
+			.expect("candidate mint validation executes"),
+		Err(TransactionValidityError::Invalid(
+			InvalidTransaction::Custom(181,)
+		)),
+	);
+	let overlay_view = |target: H160, input: Vec<u8>| {
+		let info = overlay_api
+			.call(
+				before.best_hash,
+				owner,
+				target,
+				input,
+				U256::zero(),
+				U256::from(500_000u64),
+				None,
+				None,
+				None,
+				false,
+				None,
+			)
+			.expect("candidate overlay EVM view executes")
+			.expect("candidate overlay EVM view dispatch succeeds");
+		assert!(matches!(info.exit_reason, evm::ExitReason::Succeed(_)));
+		assert_eq!(info.value.len(), 32);
+		U256::from_big_endian(&info.value)
+	};
+	assert_eq!(
+		overlay_view(bridge_address, abi_call(b"sergToken()", &[])),
+		U256::from_big_endian(H256::from(token_address).as_bytes()),
+	);
+	assert_eq!(
+		overlay_view(bridge_address, processed_call.clone()),
+		U256::zero(),
+	);
+	assert_eq!(
+		overlay_view(token_address, supply_call.clone()),
+		U256::zero(),
+	);
+	assert_eq!(
+		overlay_view(token_address, balance_call.clone()),
+		U256::zero(),
+	);
+	overlay_api
+		.finalize_block(before.best_hash)
+		.expect("candidate prefix finalizes after direct mint pre-dispatch rejection");
+	drop(overlay_api);
+
+	let mut authoring = BlockBuilderBuilder::new(client.as_ref())
+		.on_parent_block(before.best_hash)
+		.with_parent_block_number(before.best_number)
+		.build()
+		.expect("candidate block builder starts from the accepted parent");
+	for extrinsic in prefix_extrinsics.iter().cloned() {
+		authoring
+			.push(extrinsic)
+			.expect("candidate prefix extrinsic executes");
+	}
+	let authoring_rejection = authoring
+		.push(candidate_extrinsics[2].clone())
+		.expect_err("direct legacy mint must reject before EVM execution")
+		.to_string();
+	assert!(
+		authoring_rejection
+			.contains("TransactionValidityError::Invalid(InvalidTransaction::Custom(181))",),
+		"unexpected authoring rejection: {authoring_rejection}",
+	);
+
+	// A block author can omit the invalid transaction and continue authoring the
+	// exact valid prefix; the owner call no longer poisons the whole attempt.
+	let mut survivor_builder = BlockBuilderBuilder::new(client.as_ref())
+		.on_parent_block(before.best_hash)
+		.with_parent_block_number(before.best_number)
+		.build()
+		.expect("surviving block builder starts from the accepted parent");
+	for extrinsic in prefix_extrinsics.iter().cloned() {
+		survivor_builder
+			.push(extrinsic)
+			.expect("surviving prefix extrinsic executes");
+	}
+	let survivor = survivor_builder
+		.build()
+		.expect("valid prefix block finalizes after direct mint rejection")
+		.block;
+	let survivor_hash = survivor.hash();
+	let survivor_header = survivor.header();
+	assert_eq!(*survivor_header.parent_hash(), before.best_hash);
+	assert_eq!(*survivor_header.number(), before.best_number + 1);
+
+	let extrinsics_root = frame_system::extrinsics_root::<BlakeTwo256, _>(
+		&candidate_extrinsics,
+		VERSION.extrinsics_root_state_version(),
+	);
+
+	let header = Header::new(
+		before.best_number + 1,
+		extrinsics_root,
+		*survivor_header.state_root(),
+		before.best_hash,
+		survivor_header.digest().clone(),
+	);
+	let candidate = Block::new(header, candidate_extrinsics);
+	let candidate_hash = candidate.hash();
+	let (header, body) = candidate.deconstruct();
+	let mut params = BlockImportParams::new(BlockOrigin::File, header);
+	params.body = Some(body);
+	params.state_action = StateAction::Execute;
+	params.fork_choice = Some(ForkChoiceStrategy::Custom(true));
+	let importer = fc_consensus::FrontierBlockImport::new(client.clone(), client.clone());
+	let rejection = block_on(importer.import_block(params))
+		.expect_err("direct legacy mint must reject during raw candidate import")
+		.to_string();
+	assert!(

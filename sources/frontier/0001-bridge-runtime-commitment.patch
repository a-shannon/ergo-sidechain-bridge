+				.map_err(|_| Error::<T>::CausalPegInSourceProofProfileActivationBlocked)?;
+			let current_height = frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+			let runtime_profile = CurrentCausalPegInProfileV2::<T>::get()
+				.ok_or(Error::<T>::InvalidCausalPegInProfile)?;
+			let (profile, v1_profile) =
+				validate_causal_runtime_profile::<T>(&runtime_profile, current_height)
+					.map_err(|_| Error::<T>::InvalidCausalPegInProfile)?;
+			let pending = PendingCausalPegInsV2::<T>::get(record_key)
+				.ok_or(Error::<T>::CausalPegInAdmissionMissing)?;
+			let receipt = CausalPegInAdmissionReceiptsV1::<T>::get(record_key)
+				.ok_or(Error::<T>::CausalPegInAdmissionMissing)?;
+			let native_parent_height = current_height
+				.checked_sub(1)
+				.ok_or(Error::<T>::InvalidPendingCausalPegInAdmission)?;
+			let native_parent_block_hash = frame_system::Pallet::<T>::parent_hash();

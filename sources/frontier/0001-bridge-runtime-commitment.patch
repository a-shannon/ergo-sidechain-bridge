+/// A strict outer request or composed contract-state verification failure.
+#[derive(Debug, Error)]
+pub enum NativeFrontierPegInContractStateRequestError {
+	/// Shared request byte, JSON, hex, or decimal parsing failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// Outer request schema did not match V1.
+	#[error("unsupported finalized peg-in Frontier contract-state request schema")]
+	Schema,
+	/// Statement schema did not match V1.
+	#[error("unsupported peg-in Frontier contract-state statement schema")]
+	StatementSchema,
+	/// Bridge or token address was zero or their identities collided.
+	#[error("bridge and token addresses must be nonzero and distinct")]
+	InvalidContractAddresses,
+	/// One expected runtime-code byte count is outside the shared profile bound.
+	#[error("invalid expected {field} runtime-code byte count")]
+	RuntimeCodeBytes {
+		/// Stable bridge or token code identity.
+		field: &'static str,
+	},
+	/// One supplied exact storage key differs from canonical derivation.
+	#[error("statement {field} differs from the canonical Frontier key")]
+	StorageKey {
+		/// Stable statement field whose derived key differed.
+		field: &'static str,
+	},
+	/// Canonical serialization of one nested request failed.
+	#[error("failed to serialize nested request")]
+	NestedRequestSerialization(#[source] serde_json::Error),
+	/// The unchanged event verifier rejected the nested event request.
+	#[error(transparent)]
+	Event(#[from] NativeFrontierPegInEventRequestError),
+	/// The unchanged execution-identity verifier rejected the nested request.
+	#[error(transparent)]
+	ExecutionIdentity(#[from] NativeFrontierExecutionIdentityRequestError),
+	/// Authenticated code or deciding storage semantics failed.
+	#[error(transparent)]
+	ContractState(#[from] FrontierPegInContractStateProofError),
+}
+
+/// Verify one exact composed request entirely offline and without side effects.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<
+	NativeFrontierPegInContractStateVerification,
+	NativeFrontierPegInContractStateRequestError,
+> {
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(NativeCheckpointRequestError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_REQUEST_BYTES,
+		}
+		.into());
+	}
+	let request: NativeFrontierPegInContractStateRequest =
+		serde_json::from_slice(raw_request).map_err(NativeCheckpointRequestError::Json)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativeFrontierPegInContractStateRequestError::Schema);
+	}
+	if request.statement.schema != STATEMENT_SCHEMA {
+		return Err(NativeFrontierPegInContractStateRequestError::StatementSchema);
+	}
+
+	let bridge_address = parse_address(
+		"statement.bridgeAddressHex",
+		&request.statement.bridge_address_hex,
+	)?;
+	let token_address = parse_address(
+		"statement.tokenAddressHex",
+		&request.statement.token_address_hex,
+	)?;
+	if bridge_address == H160::zero()
+		|| token_address == H160::zero()
+		|| bridge_address == token_address
+	{
+		return Err(NativeFrontierPegInContractStateRequestError::InvalidContractAddresses);
+	}
+	let bridge_code = parse_code_expectation(
+		"bridge",
+		&request.statement.bridge_runtime_code_sha256_hex,
+		&request.statement.bridge_runtime_code_bytes,
+	)?;
+	let token_code = parse_code_expectation(
+		"token",
+		&request.statement.token_runtime_code_sha256_hex,
+		&request.statement.token_runtime_code_bytes,
+	)?;
+
+	let nested_event_request_bytes = serde_json::to_vec(&request.event_request)
+		.map_err(NativeFrontierPegInContractStateRequestError::NestedRequestSerialization)?;
+	let nested_event =
+		verify_event_request_bytes(&nested_event_request_bytes, trusted_anchor_digest_hex)?;
+	let nested_execution_request_bytes =
+		serde_json::to_vec(&request.event_request.execution_identity_request)
+			.map_err(NativeFrontierPegInContractStateRequestError::NestedRequestSerialization)?;
+	let context = verify_request_bytes_with_context(
+		&nested_execution_request_bytes,
+		trusted_anchor_digest_hex,
+	)?;
+	let event = verify_frontier_peg_in_event_v1(&context.execution_state, &context.state_nodes)
+		.map_err(NativeFrontierPegInEventRequestError::Event)?;
+
+	validate_key(
+		"bridgeAccountCodeStorageKeyHex",
+		&request.statement.bridge_account_code_storage_key_hex,
+		&derive_evm_account_code_storage_key(bridge_address),
+	)?;
+	validate_key(
+		"tokenAccountCodeStorageKeyHex",
+		&request.statement.token_account_code_storage_key_hex,
+		&derive_evm_account_code_storage_key(token_address),
+	)?;
+	validate_key(
+		"bridgeOwnerStorageKeyHex",
+		&request.statement.bridge_owner_storage_key_hex,
+		&derive_evm_account_storage_key(bridge_address, H256::from_low_u64_be(0)),
+	)?;
+	validate_key(
+		"bridgeConfigurationStorageKeyHex",
+		&request.statement.bridge_configuration_storage_key_hex,
+		&derive_evm_account_storage_key(bridge_address, H256::from_low_u64_be(3)),
+	)?;
+	validate_key(
+		"processedPegInStorageKeyHex",
+		&request.statement.processed_peg_in_storage_key_hex,
+		&derive_evm_account_storage_key(
+			bridge_address,
+			derive_processed_peg_in_mapping_slot(event.ergo_box_id),
+		),
+	)?;
+	validate_key(
+		"tokenTotalSupplyStorageKeyHex",
+		&request.statement.token_total_supply_storage_key_hex,
+		&derive_evm_account_storage_key(token_address, H256::from_low_u64_be(2)),
+	)?;
+	validate_key(
+		"tokenOwnerStorageKeyHex",
+		&request.statement.token_owner_storage_key_hex,
+		&derive_evm_account_storage_key(token_address, H256::from_low_u64_be(5)),
+	)?;
+
+	let state = verify_frontier_peg_in_contract_state_v1(
+		&event,
+		&context.state_nodes,
+		bridge_address,
+		token_address,
+		bridge_code,
+		token_code,
+	)?;
+	let event_verification = EmbeddedFrontierPegInEventVerificationOutput::from(nested_event);
+	let trust_anchor_digest_hex = event_verification.trust_anchor_digest_hex.clone();
+
+	Ok(NativeFrontierPegInContractStateVerification {
+		schema: VERIFICATION_SCHEMA.to_owned(),
+		status: VERIFICATION_STATUS.to_owned(),
+		request_digest_hex: format_hash(BlakeTwo256::hash(raw_request)),
+		trust_anchor_digest_hex,
+		event_verification,
+		contract_state: VerifiedFrontierPegInContractStateOutput {
+			state_root_hex: format_hash(state.state_root),
+			bridge_address_hex: format_bytes(state.bridge_address.as_bytes()),
+			token_address_hex: format_bytes(state.token_address.as_bytes()),
+			bridge_account_code_storage_key_hex: format_bytes(
+				&state.bridge_account_code_storage_key,
+			),
+			token_account_code_storage_key_hex: format_bytes(&state.token_account_code_storage_key),
+			bridge_runtime_code_sha256_hex: format_bytes(&state.bridge_runtime_code_sha256),
+			bridge_runtime_code_bytes: state.bridge_runtime_code_bytes.to_string(),
+			token_runtime_code_sha256_hex: format_bytes(&state.token_runtime_code_sha256),
+			token_runtime_code_bytes: state.token_runtime_code_bytes.to_string(),
+			bridge_owner_storage_key_hex: format_bytes(&state.bridge_owner_storage_key),
+			bridge_configuration_storage_key_hex: format_bytes(
+				&state.bridge_configuration_storage_key,
+			),
+			processed_peg_in_storage_key_hex: format_bytes(&state.processed_peg_in_storage_key),
+			token_total_supply_storage_key_hex: format_bytes(&state.token_total_supply_storage_key),
+			token_owner_storage_key_hex: format_bytes(&state.token_owner_storage_key),
+			bridge_owner_address_hex: format_bytes(state.bridge_owner.as_bytes()),
+			bridge_token_address_hex: format_bytes(state.configured_token.as_bytes()),
+			bridge_paused: state.paused,
+			processed_peg_in: state.processed_peg_in,
+			token_total_supply: state.token_total_supply.to_string(),
+			token_owner_address_hex: format_bytes(state.token_owner.as_bytes()),
+			proof_node_count: state.proof_node_count,
+			proof_bytes: state.proof_bytes,
+			verified: true,
+		},
+		boundary: VerificationBoundaryOutput {
+			sidechain_finality_verified: true,
+			execution_identity_verified: true,
+			receipt_state_proof_verified: true,
+			receipts_root_recomputed: true,
+			transaction_status_verified: true,
+			successful_receipt_verified: true,
+			deposit_event_semantics_verified: true,
+			evm_code_state_verified: true,
+			evm_storage_state_verified: true,
+			native_verifier_execution_authenticated: false,
+			runtime_build_attestation_verified: false,
+			runtime_code_identity_verified: false,
+			historical_mint_absence_verified: false,
+			committed_vault_transition_verified: false,
+			mint_authorized: false,
+			daemon_admission_authorized: false,
+			transaction_mutation_enabled: false,
+			gate5_closed: false,
+			production_readiness_verified: false,
+		},
+	})
+}
+
+fn parse_address(field: &'static str, value: &str) -> Result<H160, NativeCheckpointRequestError> {
+	let bytes = parse_byte_hex(field, value, 20)?;
+	if bytes.len() != 20 {
+		return Err(NativeCheckpointRequestError::Hex {
+			field,
+			reason: "expected exactly 20 bytes",
+		});
+	}
+	Ok(H160::from_slice(&bytes))
+}
+
+fn parse_code_expectation(
+	field: &'static str,
+	sha256_hex: &str,
+	bytes_decimal: &str,
+) -> Result<FrontierRuntimeCodeExpectationV1, NativeFrontierPegInContractStateRequestError> {
+	let sha256 = parse_hash("statement.runtimeCodeSha256Hex", sha256_hex)?;
+	let bytes_u64 = parse_decimal_u64("statement.runtimeCodeBytes", bytes_decimal)?;
+	let bytes = usize::try_from(bytes_u64)
+		.map_err(|_| NativeFrontierPegInContractStateRequestError::RuntimeCodeBytes { field })?;
+	if bytes == 0 || bytes > MAX_FRONTIER_EVM_RUNTIME_CODE_BYTES {
+		return Err(NativeFrontierPegInContractStateRequestError::RuntimeCodeBytes { field });
+	}
+	Ok(FrontierRuntimeCodeExpectationV1 {
+		sha256: *sha256.as_fixed_bytes(),
+		bytes,
+	})
+}
+
+fn validate_key(
+	field: &'static str,
+	supplied_hex: &str,
+	expected: &[u8],
+) -> Result<(), NativeFrontierPegInContractStateRequestError> {
+	let supplied = parse_byte_hex("statement.storageKeyHex", supplied_hex, expected.len())?;
+	if supplied != expected {
+		return Err(NativeFrontierPegInContractStateRequestError::StorageKey { field });
+	}
+	Ok(())
+}

+	pub record: PegInRecordExpectationRequest,
+}
+
+/// Complete finalized Peg-In Runtime Identity V2 verification request.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativePegInStateRequest {
+	/// Exact request schema.

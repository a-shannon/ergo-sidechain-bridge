+
+fn validate_runtime_code_expectation<T: Config>(
+	address: H160,
+	expected_sha256: H256,
+	expected_bytes: u32,
+) -> bool {
+	let code = pallet_evm::AccountCodes::<T>::get(address);
+	!code.is_empty()
+		&& expected_sha256 != H256::zero()
+		&& expected_bytes != 0
+		&& u32::try_from(code.len()) == Ok(expected_bytes)
+		&& H256::from(sha2_256(&code)) == expected_sha256
+}
+
+fn evm_storage_word<T: Config>(address: H160, slot: H256) -> H256 {
+	pallet_evm::AccountStorages::<T>::get(address, slot)
+}
+
+fn decode_address_word(word: H256) -> Result<H160, &'static str> {
+	if word.as_bytes()[..12].iter().any(|byte| *byte != 0) {
+		return Err("EVM address storage word has nonzero high padding");
+	}
+	Ok(H160::from_slice(&word.as_bytes()[12..]))
+}
+
+fn decode_bridge_configuration(word: H256) -> Result<(H160, bool), &'static str> {
+	let bytes = word.as_bytes();
+	if bytes[..11].iter().any(|byte| *byte != 0) {
+		return Err("bridge configuration has nonzero high padding");
+	}
+	let paused = match bytes[11] {
+		0 => false,
+		1 => true,
+		_ => return Err("bridge pause flag is not a canonical boolean"),
+	};
+	Ok((H160::from_slice(&bytes[12..]), paused))
+}
+
+fn derive_processed_peg_in_mapping_slot(ergo_box_id: H256) -> H256 {
+	let mut encoded = [0u8; 64];
+	encoded[..32].copy_from_slice(ergo_box_id.as_bytes());
+	encoded[63] = BRIDGE_PROCESSED_PEG_INS_MAPPING_SLOT as u8;
+	H256::from(keccak_256(&encoded))
+}
+
+fn derive_token_balance_mapping_slot(recipient: H160) -> H256 {
+	let mut encoded = [0u8; 64];
+	encoded[12..32].copy_from_slice(recipient.as_bytes());
+	encoded[63] = TOKEN_BALANCES_MAPPING_SLOT as u8;
+	H256::from(keccak_256(&encoded))
+}
+
+fn validate_causal_runtime_profile<T: Config>(
+	runtime_profile: &CausalPegInRuntimeProfileV2,
+	current_native_height: u64,
+) -> Result<(AdmissionProfileV2, PegInProfile), &'static str> {
+	ensure_causal_peg_in_source_proof_profile_execution_allowed::<T>()?;
+	let decoded = decode_admission_profile_v2(&runtime_profile.profile_bytes)?;
+	if derive_profile_id_v2(&runtime_profile.profile_bytes)? != runtime_profile.profile_id
+		|| decoded.activation_height >= current_native_height
+	{
+		return Err("causal peg-in profile is not active in the direct parent");
+	}
+	let v1_profile = CurrentPegInProfile::<T>::get()
+		.ok_or("causal peg-in profile has no active V1 runtime profile")?;
+	validate_active_peg_in_profile(
+		&v1_profile,
+		decoded.sidechain_id,
+		decoded.bridge_address,
+		BridgeProfileRevision::<T>::get(),
+	)?;
+	if BridgeAddress::<T>::get() != Some(decoded.bridge_address)
+		|| !validate_runtime_code_expectation::<T>(
+			decoded.bridge_address,
+			runtime_profile.bridge_runtime_code_sha256,
+			runtime_profile.bridge_runtime_code_bytes,
+		) || !validate_runtime_code_expectation::<T>(
+		decoded.token_address,
+		runtime_profile.token_runtime_code_sha256,
+		runtime_profile.token_runtime_code_bytes,
+	) {
+		return Err("causal peg-in runtime profile does not match active contract state");
+	}
+	Ok((decoded, v1_profile))
+}
+
+fn validate_parent_pending_admission<T: Config>(
+	record_key: H256,
+	pending: &PendingCausalPegInAdmissionV2,
+	receipt: &CausalPegInAdmissionReceiptV1,
+	runtime_profile: &CausalPegInRuntimeProfileV2,
+	profile: &AdmissionProfileV2,
+	v1_profile: &PegInProfile,
+	native_parent_block_hash: H256,
+	native_parent_height: u64,
+	enforce_mint_freshness: bool,
+) -> Result<ParentCausalMintSnapshotV2, &'static str> {
+	let validated = validate_admission_v2(
+		&runtime_profile.profile_bytes,
+		&pending.source_intent_bytes,
+		&pending.statement_bytes,
+	)?;
+	let source_proof_profile = T::CausalPegInSourceProofProfile::profile();
+	let source_proof_profile_id =
+		derive_federated_source_proof_profile_id_v1(&source_proof_profile)?;
+	let source_proof_request_digest = derive_federated_source_proof_request_digest_v1(
+		&validated,
+		&pending.source_intent_bytes,
+		&pending.statement_bytes,
+	);
+	let native_mint_height = native_parent_height
+		.checked_add(1)
+		.ok_or("causal peg-in native parent height exceeds uint64")?;
+	if validated.profile_id != runtime_profile.profile_id
+		|| pending.profile_id != runtime_profile.profile_id
+		|| pending.admission_id != validated.admission_id
+		|| pending.proof_system_id != profile.proof_system_id
+		|| pending.proof_profile_id != profile.proof_profile_id
+		|| pending.proof_system_id != federated_source_proof_system_id_v1()
+		|| pending.proof_profile_id != source_proof_profile_id
+		|| record_key != validated.statement.legacy_mint_identity
+		|| pending.admitted_at_native_height < profile.activation_height
+		|| pending.admitted_at_native_height > native_parent_height
+		|| validated.source_intent.sidechain_id != v1_profile.sidechain_id
+		|| validated.source_intent.bridge_address != v1_profile.bridge_address
+		|| receipt.format_version != 1
+		|| receipt.profile_id != runtime_profile.profile_id
+		|| receipt.admission_id != validated.admission_id
+		|| receipt.source_proof_request_digest != source_proof_request_digest
+		|| receipt.source_proof_result_id == H256::zero()
+		|| receipt.source_proof_digest == H256::zero()
+		|| receipt.verifier_executable_sha256 == H256::zero()
+		|| receipt.verifier_profile_id != source_proof_profile.verifier_profile_id
+		|| receipt.admitted_at_native_height != pending.admitted_at_native_height
+		|| receipt.expires_at_native_height <= receipt.admitted_at_native_height
+		|| (enforce_mint_freshness && receipt.expires_at_native_height <= native_mint_height)
+	{
+		return Err("pending causal admission does not match its active parent profile");
+	}
+	if InvalidatedCausalPegInsV1::<T>::contains_key(record_key) {
+		return Err("causal peg-in invalidation tombstone exists in the direct parent");
+	}
+	if ProcessedPegIns::<T>::contains_key(record_key)
+		|| ConsumedCausalPegInsV3::<T>::contains_key(record_key)
+	{
+		return Err("causal peg-in replay state already exists in the direct parent");
+	}
+
+	let bridge_address = validated.profile.bridge_address;
+	let token_address = validated.profile.token_address;
+	let bridge_owner = decode_address_word(evm_storage_word::<T>(
+		bridge_address,
+		H256::from_low_u64_be(BRIDGE_OWNER_SLOT),
+	))?;
+	let bridge_configuration = evm_storage_word::<T>(
+		bridge_address,
+		H256::from_low_u64_be(BRIDGE_CONFIGURATION_SLOT),
+	);
+	let (configured_token, paused) = decode_bridge_configuration(bridge_configuration)?;
+	if configured_token != token_address || paused {
+		return Err("bridge configuration is not the active unpaused causal token profile");
+	}
+	if evm_storage_word::<T>(
+		bridge_address,
+		derive_processed_peg_in_mapping_slot(validated.statement.source_box_id),
+	) != H256::zero()
+	{
+		return Err("Solidity peg-in replay state already exists in the direct parent");
+	}
+	let token_owner = decode_address_word(evm_storage_word::<T>(
+		token_address,
+		H256::from_low_u64_be(TOKEN_OWNER_SLOT),
+	))?;
+	if token_owner != bridge_address {
+		return Err("token owner differs from the active bridge in the direct parent");
+	}
+	let token_total_supply = U256::from_big_endian(
+		evm_storage_word::<T>(
+			token_address,
+			H256::from_low_u64_be(TOKEN_TOTAL_SUPPLY_SLOT),
+		)
+		.as_bytes(),
+	);
+	let recipient_balance = U256::from_big_endian(
+		evm_storage_word::<T>(
+			token_address,
+			derive_token_balance_mapping_slot(validated.source_intent.recipient),
+		)
+		.as_bytes(),
+	);
+
+	Ok(ParentCausalMintSnapshotV2 {
+		profile_id: runtime_profile.profile_id,
+		pending_blake2b256: H256::from(blake2_256(&pending.encode())),
+		admission_receipt_blake2b256: H256::from(blake2_256(&receipt.encode())),
+		runtime_profile_v1: v1_profile.clone(),
+		admission_id: validated.admission_id,
+		source_intent_id: validated.source_intent_id,
+		source_box_id: validated.statement.source_box_id,
+		recipient: validated.source_intent.recipient,
+		amount: validated.source_intent.amount,
+		token_address,
+		native_parent_block_hash,
+		native_parent_height,
+		bridge_owner,
+		bridge_configuration,
+		token_owner,
+		token_total_supply,
+		recipient_balance,
+	})
+}
+
+fn clear_parent_causal_snapshots<T: Config>() {
+	for key in ParentCausalMintSnapshotKeysV2::<T>::take() {
+		ParentCausalMintSnapshotsV2::<T>::remove(key);
+	}
+	ParentCausalPegInProfileSnapshotV2::<T>::kill();
+	ParentPegInRuntimeProfileSnapshotV1::<T>::kill();
+	ParentLegacyMintQuarantineAddressV1::<T>::kill();
+}
+
+fn snapshot_parent_legacy_mint_quarantine<T: Config>() {
+	if let Some(bridge_address) = BridgeAddress::<T>::get() {
+		ParentLegacyMintQuarantineAddressV1::<T>::put(bridge_address);
+	}
+}
+
+fn clear_parent_pooled_reserve_snapshots_v4<T: Config>() {
+	for key in ParentPooledReserveMintSnapshotKeysV4::<T>::take() {
+		ParentPooledReserveMintSnapshotsV4::<T>::remove(key);
+	}
+	ParentPooledReserveMintReservationProfileSnapshotV4::<T>::kill();
+}
+
+impl<T: Config> OnBlockStored for Pallet<T> {
+	fn max_weight() -> Weight {
+		T::MaxCallbackWeight::get()
+	}
+
+	fn on_block_started() -> Result<(), &'static str> {
+		if pooled_reserve_mint_reservation_mode_active::<T>()
+			&& (CausalPegInEnforcementActivatedV2::<T>::get()
+				|| CurrentCausalPegInProfileV2::<T>::get().is_some()
+				|| !PendingCausalPegInKeys::<T>::get().is_empty()
+				|| PendingCausalPegInsV2::<T>::iter_keys().next().is_some()
+				|| CausalPegInAdmissionReceiptsV1::<T>::iter_keys()
+					.next()
+					.is_some())
+		{
+			return Err("pooled-reserve and legacy causal peg-in modes cannot coexist");
+		}
+		if ParentCausalPegInProfileSnapshotV2::<T>::exists()
+			|| ParentPegInRuntimeProfileSnapshotV1::<T>::exists()
+			|| !ParentCausalMintSnapshotKeysV2::<T>::get().is_empty()
+		{
+			return Err("stale causal peg-in parent snapshot exists");
+		}
+		if ParentLegacyMintQuarantineAddressV1::<T>::exists() {
+			return Err("stale legacy mint quarantine snapshot exists");
+		}
+		if ParentPooledReserveMintReservationProfileSnapshotV4::<T>::exists()
+			|| !ParentPooledReserveMintSnapshotKeysV4::<T>::get().is_empty()
+			|| ParentPooledReserveMintSnapshotsV4::<T>::iter_keys()
+				.next()
+				.is_some()
+		{
+			return Err("stale pooled-reserve mint parent snapshot exists");
+		}
+		if pooled_reserve_mint_reservation_mode_active::<T>() {
+			snapshot_parent_pooled_reserve_mints_v4::<T>()?;
+			snapshot_parent_legacy_mint_quarantine::<T>();
+			return Ok(());
+		}
+
+		let pending_keys = PendingCausalPegInKeys::<T>::get();
+		let Some(runtime_profile) = CurrentCausalPegInProfileV2::<T>::get() else {
+			if pending_keys.is_empty() {
+				snapshot_parent_legacy_mint_quarantine::<T>();
+				return Ok(());
+			}
+			return Err("pending causal admissions exist without an active profile");
+		};
+		let current_native_height =
+			frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+		let native_parent_height = current_native_height
+			.checked_sub(1)
+			.ok_or("causal peg-in profile cannot run in the genesis block")?;
+		let native_parent_block_hash = frame_system::Pallet::<T>::parent_hash();
+		if native_parent_block_hash == H256::zero() {
+			return Err("causal peg-in direct-parent block hash must not be zero");
+		}
+		let (profile, v1_profile) =
+			validate_causal_runtime_profile::<T>(&runtime_profile, current_native_height)?;
+
+		if pending_keys.windows(2).any(|pair| pair[0] >= pair[1]) {
+			return Err("pending causal admission key list is not strictly ordered");
+		}
+		let mut active_keys = Vec::with_capacity(pending_keys.len());
+		let mut snapshots = Vec::with_capacity(pending_keys.len());
+		let mut expired = Vec::new();
+		for record_key in pending_keys.iter().copied() {
+			let pending = PendingCausalPegInsV2::<T>::get(record_key)
+				.ok_or("pending causal admission key has no admission value")?;
+			let receipt = CausalPegInAdmissionReceiptsV1::<T>::get(record_key)
+				.ok_or("pending causal admission key has no authenticated source-proof receipt")?;
+			let is_expired = receipt.expires_at_native_height <= current_native_height;
+			let snapshot = validate_parent_pending_admission::<T>(
+				record_key,
+				&pending,
+				&receipt,
+				&runtime_profile,
+				&profile,
+				&v1_profile,
+				native_parent_block_hash,
+				native_parent_height,
+				!is_expired,
+			)?;
+			if is_expired {
+				expired.push((
+					record_key,
+					pending.admission_id,
+					receipt.source_proof_result_id,
+				));
+			} else {
+				active_keys.push(record_key);
+				snapshots.push((record_key, snapshot));
+			}
+		}
+		let active_keys: BoundedVec<H256, T::MaxPegInsPerBlock> = active_keys
+			.try_into()
+			.map_err(|_| "active causal admission keys exceed the runtime bound")?;
+
+		for (record_key, admission_id, source_proof_result_id) in expired {
+			PendingCausalPegInsV2::<T>::remove(record_key);
+			CausalPegInAdmissionReceiptsV1::<T>::remove(record_key);
+			Self::deposit_event(Event::CausalPegInAdmissionInvalidated {
+				record_key,
+				admission_id,
+				source_proof_result_id,
+				reason: CausalSourceInvalidationReasonV1::Expired,
+				invalidation_id: None,
+				proof_digest: None,
+			});
+		}
+		PendingCausalPegInKeys::<T>::put(&active_keys);
+
+		ParentCausalPegInProfileSnapshotV2::<T>::put(&runtime_profile);
+		ParentPegInRuntimeProfileSnapshotV1::<T>::put(&v1_profile);
+		ParentCausalMintSnapshotKeysV2::<T>::put(&active_keys);
+		for (record_key, snapshot) in snapshots {
+			ParentCausalMintSnapshotsV2::<T>::insert(record_key, snapshot);
+		}
+		snapshot_parent_legacy_mint_quarantine::<T>();
+		Ok(())
+	}
+
+	fn on_block_stored(
+		block: &Block,
+		receipts: &[Receipt],
+		statuses: &[TransactionStatus],
+	) -> Result<(), &'static str> {
+		if block.transactions.len() != receipts.len() || receipts.len() != statuses.len() {
+			return Err("Frontier block, receipt, and transaction-status counts differ");
+		}
+		validate_frontier_block_alignment(block, receipts, statuses)?;
+		let sidechain_id = frame_system::Pallet::<T>::block_hash(BlockNumberFor::<T>::zero());
+		let execution_block_hash = block.header.hash();
+		let current_native_height =
+			frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+		let pooled_reserve_enforcement =
+			PooledReserveMintReservationEnforcementActivatedV4::<T>::get();
+		let pooled_reserve_profile = CurrentPooledReserveMintReservationProfileV4::<T>::get();
+		let pooled_reserve_route = pooled_reserve_enforcement || pooled_reserve_profile.is_some();
+		if pooled_reserve_route {
+			ensure_pooled_reserve_mint_reservation_profile_execution_allowed::<T>()?;
+			if !pooled_reserve_enforcement {
+				return Err("pooled-reserve profile exists without sticky enforcement");
+			}
+			let profile = pooled_reserve_profile
+				.as_ref()
+				.ok_or("pooled-reserve enforcement has no active profile")?;
+			validate_pooled_reserve_mint_reservation_runtime_profile_v4::<T>(
+				profile,
+				current_native_height,
+			)?;
+		}
+		let parent_causal_profile = ParentCausalPegInProfileSnapshotV2::<T>::get();
+		let parent_pooled_reserve_profile =
+			ParentPooledReserveMintReservationProfileSnapshotV4::<T>::get();
+		let current_causal_profile = CurrentCausalPegInProfileV2::<T>::get();
+		let parent_v1_profile = ParentPegInRuntimeProfileSnapshotV1::<T>::get();
+		let current_v1_profile = CurrentPegInProfile::<T>::get();
+		let legacy_quarantine_addresses = legacy_mint_quarantine_candidates::<T>();
+		let causal_profile_route =
+			parent_causal_profile.is_some() || current_causal_profile.is_some();
+		let causal_route = causal_profile_route || CausalPegInEnforcementActivatedV2::<T>::get();
+		if pooled_reserve_route && causal_route {
+			return Err("pooled-reserve and legacy causal peg-in modes cannot coexist");
+		}
+		if causal_route {
+			ensure_causal_peg_in_source_proof_profile_execution_allowed::<T>()?;
+		}
+		if !pooled_reserve_route && !causal_route && !legacy_peg_in_mint_execution_allowed::<T>() {
+			if contains_successful_peg_in_at_addresses(receipts, &legacy_quarantine_addresses) {
+				return Err(
+					"legacy PegIn mint execution is disabled for the inherited bridge address",
+				);
+			}
+		}
+		if parent_causal_profile.is_some() && parent_v1_profile != current_v1_profile {
+			return Err("V1 peg-in profile changed while its parent causal profile was active");
+		}
+		if (causal_route || pooled_reserve_route)
+			&& frame_system::Pallet::<T>::digest()
+				.logs()
+				.iter()
+				.any(|item| matches!(item, DigestItem::RuntimeEnvironmentUpdated))
+		{
+			return Err("runtime upgrade is forbidden after causal peg-in activation");
+		}
+
+		let causal_profile_changed = causal_profile_route
+			&& (parent_causal_profile != current_causal_profile
+				|| parent_v1_profile != current_v1_profile);
+		let mut causal_bridge_addresses = Vec::new();
+		for profile in [
+			parent_causal_profile.as_ref(),
+			current_causal_profile.as_ref(),
+		]
+		.into_iter()
+		.flatten()
+		{
+			let bridge_address =
+				decode_admission_profile_v2(&profile.profile_bytes)?.bridge_address;
+			if !causal_bridge_addresses.contains(&bridge_address) {
+				causal_bridge_addresses.push(bridge_address);
+			}
+		}
+		for profile in [parent_v1_profile.as_ref(), current_v1_profile.as_ref()]
+			.into_iter()
+			.flatten()
+		{
+			if !causal_bridge_addresses.contains(&profile.bridge_address) {
+				causal_bridge_addresses.push(profile.bridge_address);
+			}
+		}
+		if causal_route {
+			let forbidden_legacy_addresses: Vec<H160> = legacy_quarantine_addresses
+				.iter()
+				.copied()
+				.filter(|address| !causal_bridge_addresses.contains(address))
+				.collect();
+			if contains_successful_peg_in_at_addresses(receipts, &forbidden_legacy_addresses) {
+				return Err("legacy PegIn event is forbidden after causal profile activation");
+			}
+		}
+
+		let pooled_reserve_mint_records = if pooled_reserve_route {
+			let pooled_reserve_bridge_address = pooled_reserve_profile
+				.as_ref()
+				.ok_or("pooled-reserve enforcement has no active profile")?
+				.bridge_address;
+			let forbidden_legacy_addresses: Vec<H160> = legacy_quarantine_addresses
+				.iter()
+				.copied()
+				.filter(|address| *address != pooled_reserve_bridge_address)
+				.collect();
+			if contains_successful_peg_in_at_addresses(receipts, &forbidden_legacy_addresses) {
+				return Err("legacy PegIn event is forbidden after pooled-reserve activation");
+			}
+			collect_pooled_reserve_mints_v4(
+				receipts,
+				statuses,
+				pooled_reserve_bridge_address,
+				T::MaxPegInsPerBlock::get(),
+			)?
+		} else {
+			Vec::new()
+		};
+
+		let peg_in_records = if pooled_reserve_route {
+			Vec::new()
+		} else if causal_route && causal_profile_changed {
+			if contains_successful_peg_in_at_addresses(receipts, &causal_bridge_addresses) {
+				return Err("causal peg-in profile changed in the mint block");
+			}
+			Vec::new()
+		} else if let Some(profile) = current_v1_profile.as_ref() {
+			let bridge_address =
+				BridgeAddress::<T>::get().ok_or("active peg-in profile has no bridge address")?;
+			validate_active_peg_in_profile(
+				profile,
+				sidechain_id,
+				bridge_address,
+				BridgeProfileRevision::<T>::get(),
+			)?;
+			let records = collect_peg_in_records_detailed(
+				profile,
+				block.header.number,
+				execution_block_hash,
+				receipts,
+				statuses,
+				T::MaxPegInsPerBlock::get(),
+			)?;
+			for collected in &records {
+				if ProcessedPegIns::<T>::contains_key(collected.record_key) {
+					return Err("processed peg-in record already exists");
+				}
+			}
+			records
+		} else {
+			Vec::new()
+		};
+
+		let pooled_reserve_consumptions = if pooled_reserve_route {
+			let current_profile = pooled_reserve_profile
+				.as_ref()
+				.ok_or("pooled-reserve enforcement has no active profile")?;
+			match parent_pooled_reserve_profile.as_ref() {
+				Some(parent_profile) => validate_pooled_reserve_mint_consumptions_v4::<T>(
+					block,
+					receipts,
+					statuses,
+					&pooled_reserve_mint_records,
+					parent_profile,
+					current_profile,
+				)?,
+				None => {
+					let token_mint_effects = collect_successful_token_mint_effects(
+						receipts,
+						current_profile.token_address,
+					)?;
+					if !pooled_reserve_mint_records.is_empty() || !token_mint_effects.is_empty() {
+						return Err(
+							"pooled-reserve mint has no direct-parent reservation snapshot",
+						);
+					}
+					if current_profile.activation_height
+						!= frame_system::Pallet::<T>::block_number().saturated_into::<u64>()
+					{
+						return Err("pooled-reserve direct-parent profile snapshot is missing");
+					}
+					Vec::new()
+				}
+			}
+		} else {
+			if parent_pooled_reserve_profile.is_some()
+				|| !ParentPooledReserveMintSnapshotKeysV4::<T>::get().is_empty()
+				|| ParentPooledReserveMintSnapshotsV4::<T>::iter_keys()
+					.next()
+					.is_some()
+			{
+				return Err("pooled-reserve parent snapshot exists outside V4 mode");
+			}
+			Vec::new()
+		};
+
+		let causal_consumptions = if causal_route && !peg_in_records.is_empty() {
+			if !causal_profile_route {
+				return Err("legacy peg-in authorization remains disabled after causal activation");
+			}
+			validate_causal_consumptions::<T>(
+				block,
+				receipts,
+				statuses,
+				&peg_in_records,
+				parent_causal_profile
+					.as_ref()
+					.ok_or("causal mint has no direct-parent profile snapshot")?,
+				current_causal_profile
+					.as_ref()
+					.ok_or("causal mint has no active post profile")?,
+			)?
+		} else {
+			Vec::new()
+		};
+		let remaining_pending_keys = if causal_consumptions.is_empty() {
+			None
+		} else {
+			let consumed_keys: Vec<H256> = causal_consumptions
+				.iter()
+				.map(|consumption| consumption.record_key)
+				.collect();
+			let remaining: BoundedVec<H256, T::MaxPegInsPerBlock> =
+				PendingCausalPegInKeys::<T>::get()
+					.into_iter()
+					.filter(|key| !consumed_keys.contains(key))
+					.collect::<Vec<_>>()
+					.try_into()
+					.map_err(|_| "remaining causal admission keys exceed the runtime bound")?;
+			Some(remaining)
+		};
+		let remaining_pooled_reserve_pending_keys = if pooled_reserve_consumptions.is_empty() {
+			None
+		} else {
+			let consumed_keys: BTreeSet<H256> = pooled_reserve_consumptions
+				.iter()
+				.map(|consumption| consumption.mint_identity)
+				.collect();
+			let remaining: BoundedVec<H256, T::MaxPegInsPerBlock> =
+				validated_pooled_reserve_mint_reservation_index_v4::<T>()
+					.map_err(|_| {
+						"pooled-reserve mint reservation index changed into invalid state"
+					})?
+					.into_iter()
+					.filter(|key| !consumed_keys.contains(key))
+					.collect::<Vec<_>>()
+					.try_into()
+					.map_err(|_| {
+						"remaining pooled-reserve mint reservations exceed the runtime bound"
+					})?;
+			Some(remaining)
+		};
+
+		let bridge_address = BridgeAddress::<T>::get();
+		let produced = if let Some(bridge_address) = bridge_address {
+			produce_commitment(
+				bridge_address,
+				sidechain_id,
+				block.header.number,
+				execution_block_hash,
+				receipts,
+				statuses,
+				T::MaxBurnsPerBlock::get(),
+			)?
+		} else {
+			None
+		};
+
+		let leaf_hashes: Option<BoundedVec<H256, T::MaxBurnsPerBlock>> = produced
+			.as_ref()
+			.map(|commitment| {
+				commitment
+					.leaf_hashes
+					.clone()
+					.try_into()
+					.map_err(|_| "bridge burn count exceeds the configured runtime bound")
+			})
+			.transpose()?;
+
+		// Complete all fallible validation before mutating storage or emitting events.
+		CurrentCommitment::<T>::kill();
+		CurrentLeafHashes::<T>::kill();
+		if pooled_reserve_route {
+			for consumption in pooled_reserve_consumptions {
+				PendingPooledReserveMintReservationsV4::<T>::remove(consumption.mint_identity);
+				ConsumedPooledReserveMintReservationsV4::<T>::insert(
+					consumption.mint_identity,
+					&consumption.consumed,
+				);
+				Pallet::<T>::deposit_event(Event::PooledReserveMintReservationConsumedV4 {
+					mint_identity: consumption.mint_identity,
+					statement_id: consumption.statement_id,
+					profile_id: consumption.profile_id,
+					recipient: consumption.recipient,
+					amount: consumption.amount,
+					execution_block_hash: consumption.consumed.execution_block_hash,
+					transaction_hash: consumption.consumed.transaction_hash,
+					event_index: consumption.consumed.event_index,
+				});
+			}
+			if let Some(remaining_pending_keys) = remaining_pooled_reserve_pending_keys {
+				PendingPooledReserveMintReservationKeysV4::<T>::put(remaining_pending_keys);
+			}
+		} else if causal_route {
+			for consumption in causal_consumptions {
+				PendingCausalPegInsV2::<T>::remove(consumption.record_key);
+				CausalPegInAdmissionReceiptsV1::<T>::remove(consumption.record_key);
+				ProcessedPegIns::<T>::insert(consumption.record_key, &consumption.record);
+				ConsumedCausalPegInsV3::<T>::insert(consumption.record_key, &consumption.consumed);
+				Pallet::<T>::deposit_event(Event::PegInRecordStored {
+					record_key: consumption.record_key,
+					profile_revision: consumption.record.profile_revision,
+					ergo_box_id: consumption.record.ergo_box_id,
+					recipient: consumption.record.recipient,
+					amount: consumption.record.amount,
+					execution_block_hash: consumption.record.execution_block_hash,
+					transaction_hash: consumption.record.transaction_hash,
+					event_index: consumption.record.event_index,
+				});
+				Pallet::<T>::deposit_event(Event::CausalPegInAdmissionConsumed {
+					record_key: consumption.record_key,
+					admission_id: consumption.admission_id,
+					execution_block_hash: consumption.record.execution_block_hash,
+					transaction_hash: consumption.record.transaction_hash,
+					event_index: consumption.record.event_index,
+				});
+			}
+			if let Some(remaining_pending_keys) = remaining_pending_keys {
+				PendingCausalPegInKeys::<T>::put(remaining_pending_keys);
+			}
+		} else {
+			for collected in peg_in_records {
+				let record_key = collected.record_key;
+				let record = collected.record;
+				ProcessedPegIns::<T>::insert(record_key, &record);
+				Pallet::<T>::deposit_event(Event::PegInRecordStored {
+					record_key,
+					profile_revision: record.profile_revision,
+					ergo_box_id: record.ergo_box_id,
+					recipient: record.recipient,
+					amount: record.amount,
+					execution_block_hash: record.execution_block_hash,
+					transaction_hash: record.transaction_hash,
+					event_index: record.event_index,
+				});
+			}
+		}
+		if let (Some(produced), Some(leaf_hashes)) = (produced, leaf_hashes) {
+			CurrentLeafHashes::<T>::put(leaf_hashes);
+			CurrentCommitment::<T>::put(&produced.record);
+			Pallet::<T>::deposit_event(Event::BridgeEventRootStored {
+				format_version: produced.record.format_version,
+				execution_block_hash: produced.record.execution_block_hash,
+				bridge_event_root: produced.record.bridge_event_root,
+				burn_leaf_count: produced.record.burn_leaf_count,
+			});
+		}
+		clear_parent_causal_snapshots::<T>();
+		clear_parent_pooled_reserve_snapshots_v4::<T>();
+		Ok(())
+	}
+}
+
+fn validate_active_peg_in_profile(
+	profile: &PegInProfile,
+	sidechain_id: H256,
+	bridge_address: H160,
+	profile_revision: u64,
+) -> Result<(), &'static str> {
+	if profile.format_version != PEG_IN_PROFILE_FORMAT_VERSION
+		|| profile.sidechain_id != sidechain_id
+		|| profile.bridge_address != bridge_address
+		|| profile.profile_revision != profile_revision
+	{
+		return Err("active peg-in profile does not match runtime bridge state");
+	}
+	Ok(())
+}
+
+fn validate_frontier_block_alignment(
+	block: &Block,
+	receipts: &[Receipt],
+	statuses: &[TransactionStatus],
+) -> Result<(), &'static str> {
+	for (transaction_index, ((transaction, receipt), status)) in block
+		.transactions
+		.iter()
+		.zip(receipts.iter())
+		.zip(statuses.iter())
+		.enumerate()
+	{
+		let expected_transaction_index = u32::try_from(transaction_index)
+			.map_err(|_| "Frontier transaction index exceeds uint32")?;
+		if transaction.hash() != status.transaction_hash {
+			return Err("Frontier block transaction hash differs from transaction status");
+		}
+		if status.transaction_index != expected_transaction_index {
+			return Err("Frontier transaction status index is not canonical");
+		}
+		let (receipt_status, receipt_logs) = receipt_status_and_logs(receipt);
+		if receipt_status > 1 {
+			return Err("Frontier receipt status code must be zero or one");
+		}
+		if status.logs != *receipt_logs {
+			return Err("Frontier receipt logs differ from transaction-status logs");
+		}
+	}
+	Ok(())
+}
+
+fn contains_successful_peg_in_at_addresses(receipts: &[Receipt], addresses: &[H160]) -> bool {
+	receipts.iter().any(|receipt| {
+		let (status, logs) = receipt_status_and_logs(receipt);
+		status == 1
+			&& logs.iter().any(|log| {
+				addresses.contains(&log.address) && log.topics.first() == Some(&peg_in_topic())
+			})
+	})
+}
+
+#[cfg(test)]
+fn collect_peg_in_records(
+	profile: &PegInProfile,
+	sidechain_height: U256,
+	execution_block_hash: H256,
+	receipts: &[Receipt],
+	statuses: &[TransactionStatus],
+	max_peg_ins: u32,
+) -> Result<Vec<(H256, PegInRecord)>, &'static str> {
+	Ok(collect_peg_in_records_detailed(
+		profile,
+		sidechain_height,
+		execution_block_hash,
+		receipts,
+		statuses,
+		max_peg_ins,
+	)?
+	.into_iter()
+	.map(|collected| (collected.record_key, collected.record))
+	.collect())
+}
+
+fn collect_peg_in_records_detailed(
+	profile: &PegInProfile,
+	sidechain_height: U256,
+	execution_block_hash: H256,
+	receipts: &[Receipt],
+	statuses: &[TransactionStatus],
+	max_peg_ins: u32,
+) -> Result<Vec<CollectedPegInRecord>, &'static str> {
+	if profile.format_version != PEG_IN_PROFILE_FORMAT_VERSION {
+		return Err("unsupported peg-in profile format version");
+	}
+	if profile.bridge_address == H160::zero() {
+		return Err("peg-in profile bridge address must not be zero");
+	}
+	if profile.profile_revision == 0 {
+		return Err("peg-in profile revision must be positive");
+	}
+	if receipts.len() != statuses.len() {
+		return Err("Frontier receipt and transaction-status counts differ");
+	}
+	if sidechain_height > U256::from(u64::MAX) {
+		return Err("Frontier block height exceeds the peg-in V1 uint64 bound");
+	}
+	let mut records = Vec::new();
+	let mut record_keys = BTreeSet::new();
+	let mut global_log_index: u64 = 0;
+	for (transaction_index, (receipt, status)) in receipts.iter().zip(statuses.iter()).enumerate() {
+		let expected_transaction_index = u32::try_from(transaction_index)
+			.map_err(|_| "Frontier transaction index exceeds uint32")?;
+		if status.transaction_index != expected_transaction_index {
+			return Err("Frontier transaction status index is not canonical");
+		}
+		let (receipt_status, receipt_logs) = receipt_status_and_logs(receipt);
+		if status.logs != *receipt_logs {
+			return Err("Frontier receipt logs differ from transaction-status logs");
+		}
+		if receipt_status > 1 {
+			return Err("Frontier receipt status code must be zero or one");
+		}
+
+		for (transaction_log_index, log) in receipt_logs.iter().enumerate() {
+			let event_index = u32::try_from(global_log_index)
+				.map_err(|_| "Frontier global log index exceeds uint32")?;
+			global_log_index = global_log_index
+				.checked_add(1)
+				.ok_or("Frontier global log index overflow")?;
+
+			if receipt_status == 0
+				|| log.address != profile.bridge_address
+				|| log.topics.first() != Some(&peg_in_topic())
+			{
+				continue;
+			}
+			if execution_block_hash == H256::zero() {
+				return Err("peg-in execution block hash must not be zero");
+			}
+			if status.transaction_hash == H256::zero() {
+				return Err("peg-in transaction hash must not be zero");
+			}
+			if sidechain_height <= U256::from(profile.activation_height) {
+				return Err("PegIn block must follow the active profile activation block");
+			}
+
+			let (recipient, amount, ergo_box_id) = parse_peg_in_log(log)?;
+			let record_key = derive_peg_in_record_key(profile.sidechain_id, ergo_box_id);
+			if !record_keys.insert(record_key) {
+				return Err("duplicate processed peg-in record in Frontier block");
+			}
+			if records.len() >= max_peg_ins as usize {
+				return Err("peg-in count exceeds the configured runtime bound");
+			}
+			records.push(CollectedPegInRecord {
+				record_key,
+				record: PegInRecord {
+					format_version: PEG_IN_RECORD_FORMAT_VERSION,
+					sidechain_id: profile.sidechain_id,
+					bridge_address: profile.bridge_address,
+					profile_revision: profile.profile_revision,
+					profile_activation_height: profile.activation_height,
+					ergo_box_id,
+					recipient,
+					amount,
+					sidechain_height: sidechain_height.low_u64(),
+					execution_block_hash,
+					transaction_hash: status.transaction_hash,
+					event_index,
+				},
+				transaction_index: expected_transaction_index,
+				transaction_log_index: u32::try_from(transaction_log_index)
+					.map_err(|_| "Frontier transaction log index exceeds uint32")?,
+			});
+		}
+	}
+
+	Ok(records)
+}
+
+fn transfer_topic() -> H256 {
+	H256::from(keccak_256(ERC20_TRANSFER_EVENT_SIGNATURE))
+}
+
+fn parse_transfer_log(log: &Log) -> Result<(H160, H160, U256), &'static str> {
+	if log.topics.len() != 3 {
+		return Err("ERC-20 Transfer log must contain signature, from, and to topics");
+	}
+	if log.topics[1].as_bytes()[..12]
+		.iter()
+		.chain(log.topics[2].as_bytes()[..12].iter())
+		.any(|byte| *byte != 0)
+	{
+		return Err("ERC-20 Transfer address topic has noncanonical ABI padding");
+	}
+	if log.data.len() != 32 {
+		return Err("ERC-20 Transfer amount must be one exact ABI word");
+	}
+	Ok((
+		H160::from_slice(&log.topics[1].as_bytes()[12..]),
+		H160::from_slice(&log.topics[2].as_bytes()[12..]),
+		U256::from_big_endian(&log.data),
+	))
+}
+
+fn collect_pooled_reserve_mints_v4(
+	receipts: &[Receipt],
+	statuses: &[TransactionStatus],
+	bridge_address: H160,
+	max_records: u32,
+) -> Result<Vec<CollectedPooledReserveMintV4>, &'static str> {
+	let mut records = Vec::new();
+	let mut global_log_index = 0u64;
+	for (transaction_index, receipt) in receipts.iter().enumerate() {
+		let (status, logs) = receipt_status_and_logs(receipt);
+		for (transaction_log_index, log) in logs.iter().enumerate() {
+			let event_index = u32::try_from(global_log_index)
+				.map_err(|_| "pooled-reserve global event index exceeds uint32")?;
+			global_log_index = global_log_index
+				.checked_add(1)
+				.ok_or("pooled-reserve global event index overflow")?;
+			if status != 1
+				|| log.address != bridge_address
+				|| log.topics.first() != Some(&peg_in_topic())
+			{
+				continue;
+			}
+			let (recipient, amount, mint_identity) = parse_peg_in_log(log)?;
+			if records.len() >= max_records as usize {
+				return Err("pooled-reserve mint count exceeds the configured runtime bound");
+			}
+			let transaction_index = u32::try_from(transaction_index)
+				.map_err(|_| "pooled-reserve transaction index exceeds uint32")?;
+			let transaction_log_index = u32::try_from(transaction_log_index)
+				.map_err(|_| "pooled-reserve transaction log index exceeds uint32")?;
+			let transaction_hash = statuses
+				.get(transaction_index as usize)
+				.ok_or("pooled-reserve mint transaction status is absent")?
+				.transaction_hash;
+			records.push(CollectedPooledReserveMintV4 {
+				mint_identity,
+				recipient,
+				amount,
+				transaction_hash,
+				transaction_index,
+				transaction_log_index,
+				event_index,
+			});
+		}
+	}
+	Ok(records)
+}
+
+fn collect_successful_token_mint_effects(
+	receipts: &[Receipt],
+	token_address: H160,
+) -> Result<Vec<(u32, u32, H160, U256)>, &'static str> {
+	let mut effects = Vec::new();
+	for (transaction_index, receipt) in receipts.iter().enumerate() {
+		let (status, logs) = receipt_status_and_logs(receipt);
+		if status != 1 {
+			continue;
+		}
+		for (transaction_log_index, log) in logs.iter().enumerate() {
+			if log.address != token_address || log.topics.first() != Some(&transfer_topic()) {
+				continue;
+			}
+			let (from, to, amount) = parse_transfer_log(log)?;
+			if from != H160::zero() || amount.is_zero() {
+				continue;
+			}
+			effects.push((
+				u32::try_from(transaction_index)
+					.map_err(|_| "token mint transaction index exceeds uint32")?,
+				u32::try_from(transaction_log_index)
+					.map_err(|_| "token mint log index exceeds uint32")?,
+				to,
+				amount,
+			));
+		}
+	}
+	Ok(effects)
+}
+
+fn validate_pooled_reserve_mint_consumptions_v4<T: Config>(
+	block: &Block,
+	receipts: &[Receipt],
+	statuses: &[TransactionStatus],
+	records: &[CollectedPooledReserveMintV4],
+	parent_profile: &PooledReserveMintReservationRuntimeProfileV4,
+	current_profile: &PooledReserveMintReservationRuntimeProfileV4,
+) -> Result<Vec<ValidatedPooledReserveMintConsumptionV4>, &'static str> {
+	if parent_profile != current_profile {
+		return Err("pooled-reserve mint profile changed in the mint block");
+	}
+	let current_native_height = frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+	if block.header.number > U256::from(u64::MAX)
+		|| block.header.number.low_u64() != current_native_height
+	{
+		return Err("pooled-reserve native and execution heights differ");
+	}
+	let profile_id = validate_pooled_reserve_mint_reservation_runtime_profile_v4::<T>(
+		current_profile,
+		current_native_height,
+	)?;
+	if current_profile.activation_height >= current_native_height {
+		return Err("pooled-reserve mint profile is not active in the direct parent");
+	}
+	if !validate_runtime_code_expectation::<T>(
+		current_profile.bridge_address,
+		current_profile.bridge_runtime_code_sha256,
+		current_profile.bridge_runtime_code_bytes,
+	) || !validate_runtime_code_expectation::<T>(
+		current_profile.token_address,
+		current_profile.token_runtime_code_sha256,
+		current_profile.token_runtime_code_bytes,
+	) {
+		return Err("pooled-reserve mint changed reviewed EVM runtime code");
+	}
+
+	let parent_keys = ParentPooledReserveMintSnapshotKeysV4::<T>::get();
+	let current_pending_keys = validated_pooled_reserve_mint_reservation_index_v4::<T>()
+		.map_err(|_| "pooled-reserve mint reservation index changed into invalid state")?;
+	let token_mint_effects =
+		collect_successful_token_mint_effects(receipts, current_profile.token_address)?;
+	if token_mint_effects.len() != records.len() {
+		return Err("each pooled-reserve mint requires one exact token mint effect");
+	}
+
+	let bridge_owner = decode_address_word(evm_storage_word::<T>(
+		current_profile.bridge_address,
+		H256::from_low_u64_be(BRIDGE_OWNER_SLOT),
+	))?;
+	let bridge_configuration = evm_storage_word::<T>(
+		current_profile.bridge_address,
+		H256::from_low_u64_be(BRIDGE_CONFIGURATION_SLOT),
+	);
+	let (configured_token, paused) = decode_bridge_configuration(bridge_configuration)?;
+	let token_owner = decode_address_word(evm_storage_word::<T>(
+		current_profile.token_address,
+		H256::from_low_u64_be(TOKEN_OWNER_SLOT),
+	))?;
+	if configured_token != current_profile.token_address
+		|| paused
+		|| token_owner != current_profile.bridge_address
+	{
+		return Err("pooled-reserve mint changed bridge configuration or ownership");
+	}
+	let post_supply = U256::from_big_endian(
+		evm_storage_word::<T>(
+			current_profile.token_address,
+			H256::from_low_u64_be(TOKEN_TOTAL_SUPPLY_SLOT),
+		)
+		.as_bytes(),
+	);
+
+	let mut seen_mint_identities = BTreeSet::new();
+	let mut consumed_token_mint_effects = BTreeSet::new();
+	let mut expected_supply_delta = U256::zero();
+	let mut parent_supply = None;
+	let mut recipient_deltas: BTreeMap<H160, (U256, U256)> = BTreeMap::new();
+	let mut consumptions = Vec::with_capacity(records.len());
+	for record in records {
+		if !seen_mint_identities.insert(record.mint_identity) {
+			return Err("pooled-reserve mint identity appears more than once in the block");
+		}
+		if !parent_keys.contains(&record.mint_identity)
+			|| !current_pending_keys.contains(&record.mint_identity)
+		{
+			return Err("pooled-reserve mint has no direct-parent pending reservation");
+		}
+		let snapshot = ParentPooledReserveMintSnapshotsV4::<T>::get(record.mint_identity)
+			.ok_or("pooled-reserve mint has no direct-parent reservation snapshot")?;
+		let pending = PendingPooledReserveMintReservationsV4::<T>::get(record.mint_identity)
+			.ok_or("pooled-reserve mint removed its pending reservation before finalization")?;
+		if H256::from(blake2_256(&pending.encode())) != snapshot.pending_blake2b256 {
+			return Err("pooled-reserve pending reservation changed in the mint block");
+		}
+		validate_pending_pooled_reserve_mint_reservation_v4::<T>(
+			current_profile,
+			profile_id,
+			&pending,
+			current_native_height,
+		)
+		.map_err(|_| "pooled-reserve pending reservation is invalid at mint")?;
+		let validated =
+			validate_pooled_reserve_mint_reservation_statement_v4(&pending.statement_bytes)?;
+		assert_pooled_reserve_mint_reservation_matches_profile_v4(current_profile, &validated)?;
+		let legacy_mint_identity = derive_legacy_mint_identity_for_reservation_v4(&validated);
+		if record.mint_identity == legacy_mint_identity
+			|| snapshot.legacy_mint_identity != legacy_mint_identity
+		{
+			return Err("pooled-reserve mint used the legacy mint identity");
+		}
+		if pending.expires_at_native_height <= current_native_height {
+			return Err("pooled-reserve mint reservation expired before execution");
+		}
+		if snapshot.profile_id != profile_id
+			|| snapshot.statement_id != validated.statement_id
+			|| snapshot.mint_identity != validated.statement.mint_identity
+			|| snapshot.recipient != validated.statement.source_intent.recipient
+			|| snapshot.amount != validated.statement.source_intent.amount
+			|| snapshot.bridge_address != current_profile.bridge_address
+			|| snapshot.token_address != current_profile.token_address
+			|| snapshot.native_parent_block_hash != frame_system::Pallet::<T>::parent_hash()
+			|| snapshot.native_parent_height.checked_add(1) != Some(current_native_height)
+		{
+			return Err("pooled-reserve mint does not match its direct-parent reservation");
+		}
+		if snapshot.bridge_owner != bridge_owner
+			|| snapshot.bridge_configuration != bridge_configuration
+			|| snapshot.token_owner != token_owner
+		{
+			return Err("pooled-reserve mint changed direct-parent bridge authority");
+		}
+		if ConsumedPooledReserveMintReservationsV4::<T>::contains_key(record.mint_identity)
+			|| InvalidatedPooledReserveMintReservationsV4::<T>::contains_key(record.mint_identity)
+			|| legacy_causal_replay_state_exists::<T>(record.mint_identity)
+			|| legacy_causal_replay_state_exists::<T>(legacy_mint_identity)
+			|| legacy_causal_invalidation_exists::<T>(record.mint_identity)
+			|| legacy_causal_invalidation_exists::<T>(legacy_mint_identity)
+		{
+			return Err("pooled-reserve mint replay or invalidation state appeared before commit");
+		}
+		if record.recipient != snapshot.recipient || record.amount != snapshot.amount {
+			return Err("pooled-reserve PegIn event does not match its source reservation");
+		}
+		let status = statuses
+			.get(record.transaction_index as usize)
+			.ok_or("pooled-reserve mint transaction status is absent")?;
+		if status.transaction_hash != record.transaction_hash {
+			return Err("pooled-reserve mint transaction hash differs from its status");
+		}
+		let matching_effects: Vec<(u32, u32)> = token_mint_effects
+			.iter()
+			.filter(
+				|(transaction_index, transaction_log_index, recipient, amount)| {
+					*transaction_index == record.transaction_index
+						&& *transaction_log_index < record.transaction_log_index
+						&& *recipient == record.recipient
+						&& *amount == U256::from(record.amount)
+						&& !consumed_token_mint_effects
+							.contains(&(*transaction_index, *transaction_log_index))
+				},
+			)
+			.map(|(transaction_index, transaction_log_index, _, _)| {
+				(*transaction_index, *transaction_log_index)
+			})
+			.collect();
+		if matching_effects.len() != 1 {
+			return Err("pooled-reserve PegIn lacks one exact preceding token mint");
+		}
+		if !consumed_token_mint_effects.insert(matching_effects[0]) {
+			return Err("pooled-reserve token mint effect was reused");
+		}
+		if evm_storage_word::<T>(
+			current_profile.bridge_address,
+			derive_processed_peg_in_mapping_slot(record.mint_identity),
+		) != H256::from_low_u64_be(1)
+		{
+			return Err("pooled-reserve mint did not set the exact Solidity replay marker");
+		}
+
+		match parent_supply {
+			Some(value) if value != snapshot.token_total_supply => {
+				return Err("pooled-reserve mint snapshots disagree on parent token supply")
+			}
+			None => parent_supply = Some(snapshot.token_total_supply),
+			_ => {}
+		}
+		expected_supply_delta = expected_supply_delta
+			.checked_add(U256::from(record.amount))
+			.ok_or("pooled-reserve mint supply delta overflow")?;
+		let recipient_entry = recipient_deltas
+			.entry(record.recipient)
+			.or_insert((snapshot.recipient_balance, U256::zero()));
+		if recipient_entry.0 != snapshot.recipient_balance {
+			return Err("pooled-reserve mint snapshots disagree on parent recipient balance");
+		}
+		recipient_entry.1 = recipient_entry
+			.1
+			.checked_add(U256::from(record.amount))
+			.ok_or("pooled-reserve recipient delta overflow")?;
+		consumptions.push(ValidatedPooledReserveMintConsumptionV4 {
+			mint_identity: record.mint_identity,
+			statement_id: validated.statement_id,
+			profile_id,
+			recipient: record.recipient,
+			amount: record.amount,
+			consumed: ConsumedPooledReserveMintReservationV4 {
+				format_version: POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4,
+				profile_id,
+				statement_id: validated.statement_id,
+				mint_identity: record.mint_identity,
+				consumed_at_native_height: current_native_height,
+				execution_block_hash: block.header.hash(),
+				transaction_hash: record.transaction_hash,
+				event_index: record.event_index,
+			},
+		});
+	}
+
+	if let Some(parent_supply) = parent_supply {
+		if parent_supply.checked_add(expected_supply_delta) != Some(post_supply) {
+			return Err("pooled-reserve mint token supply delta is not exact");
+		}
+	}
+	for (recipient, (parent_balance, expected_delta)) in recipient_deltas {
+		let post_balance = U256::from_big_endian(
+			evm_storage_word::<T>(
+				current_profile.token_address,
+				derive_token_balance_mapping_slot(recipient),
+			)
+			.as_bytes(),
+		);
+		if parent_balance.checked_add(expected_delta) != Some(post_balance) {
+			return Err("pooled-reserve mint recipient balance delta is not exact");
+		}
+	}
+	Ok(consumptions)
+}
+
+fn validate_paired_token_mint(
+	receipts: &[Receipt],
+	token_address: H160,
+	collected: &CollectedPegInRecord,
+) -> Result<(), &'static str> {
+	let mut global_log_index: u64 = 0;
+	let mut relevant_effects = 0usize;
+	let mut paired = false;
+	for (transaction_index, receipt) in receipts.iter().enumerate() {
+		let (status, logs) = receipt_status_and_logs(receipt);
+		for (transaction_log_index, log) in logs.iter().enumerate() {
+			let current_global_index = global_log_index;
+			global_log_index = global_log_index
+				.checked_add(1)
+				.ok_or("Frontier global log index overflow")?;
+			if status != 1
+				|| log.address != token_address
+				|| log.topics.first() != Some(&transfer_topic())
+			{
+				continue;
+			}
+			let (from, to, amount) = parse_transfer_log(log)?;
+			if amount.is_zero() {
+				continue;
+			}
+			let affects_supply = from == H160::zero() || to == H160::zero();
+			let affects_recipient =
+				from == collected.record.recipient || to == collected.record.recipient;
+			if !affects_supply && !affects_recipient {
+				continue;
+			}
+			relevant_effects += 1;
+			if u32::try_from(transaction_index) == Ok(collected.transaction_index)
+				&& from == H160::zero()
+				&& to == collected.record.recipient
+				&& amount == U256::from(collected.record.amount)
+				&& u32::try_from(transaction_log_index)
+					.map(|index| index < collected.transaction_log_index)
+					.unwrap_or(false)
+				&& u32::try_from(current_global_index)
+					.map(|index| index < collected.record.event_index)
+					.unwrap_or(false)
+			{
+				paired = true;
+			}
+		}
+	}
+	if relevant_effects != 1 || !paired {
+		return Err("causal PegIn requires one exact preceding ERC-20 mint effect");
+	}
+	Ok(())
+}
+
+fn validate_causal_consumptions<T: Config>(
+	block: &Block,
+	receipts: &[Receipt],
+	statuses: &[TransactionStatus],
+	records: &[CollectedPegInRecord],
+	parent_profile: &CausalPegInRuntimeProfileV2,
+	current_profile: &CausalPegInRuntimeProfileV2,
+) -> Result<Vec<ValidatedCausalConsumption>, &'static str> {
+	if parent_profile != current_profile {
+		return Err("causal peg-in profile changed in the mint block");
+	}
+	if records.len() != 1 {
+		return Err("causal peg-in T20C profile permits exactly one mint per block");
+	}
+	if block.header.number > U256::from(u64::MAX) {
+		return Err("causal peg-in execution height exceeds uint64");
+	}
+	let native_mint_height = frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+	if block.header.number.low_u64() != native_mint_height {
+		return Err("causal peg-in native and execution heights differ");
+	}
+	let parent_v1_profile = ParentPegInRuntimeProfileSnapshotV1::<T>::get()
+		.ok_or("causal mint has no parent V1 profile snapshot")?;
+	if CurrentPegInProfile::<T>::get() != Some(parent_v1_profile.clone()) {
+		return Err("V1 peg-in profile changed in the causal mint block");
+	}
+	let parent_keys = ParentCausalMintSnapshotKeysV2::<T>::get();
+	if PendingCausalPegInKeys::<T>::get() != parent_keys {
+		return Err("pending causal admission keys changed in the mint block");
+	}
+
+	let collected = &records[0];
+	if !parent_keys.contains(&collected.record_key) {
+		return Err("causal mint has no direct-parent pending key");
+	}
+	let snapshot = ParentCausalMintSnapshotsV2::<T>::get(collected.record_key)
+		.ok_or("causal mint has no direct-parent admission snapshot")?;
+	let pending = PendingCausalPegInsV2::<T>::get(collected.record_key)
+		.ok_or("causal mint removed its pending admission before finalization")?;
+	let receipt = CausalPegInAdmissionReceiptsV1::<T>::get(collected.record_key)
+		.ok_or("causal mint removed its source-proof receipt before finalization")?;
+	if H256::from(blake2_256(&pending.encode())) != snapshot.pending_blake2b256 {
+		return Err("pending causal admission changed in the mint block");
+	}
+	if H256::from(blake2_256(&receipt.encode())) != snapshot.admission_receipt_blake2b256 {
+		return Err("causal source-proof receipt changed in the mint block");
+	}
+	let validated: ValidatedAdmissionV2 = validate_admission_v2(
+		&current_profile.profile_bytes,
+		&pending.source_intent_bytes,
+		&pending.statement_bytes,
+	)?;
+	if validated.profile_id != current_profile.profile_id
+		|| pending.profile_id != current_profile.profile_id
+		|| pending.admission_id != validated.admission_id
+		|| pending.proof_system_id != validated.profile.proof_system_id
+		|| pending.proof_profile_id != validated.profile.proof_profile_id
+		|| snapshot.profile_id != current_profile.profile_id
+		|| snapshot.admission_id != validated.admission_id
+		|| snapshot.source_intent_id != validated.source_intent_id
+		|| collected.record_key != validated.statement.legacy_mint_identity
+		|| snapshot.source_box_id != validated.statement.source_box_id
+		|| snapshot.recipient != validated.source_intent.recipient
+		|| snapshot.amount != validated.source_intent.amount
+		|| snapshot.token_address != validated.source_intent.token_address
+		|| snapshot.runtime_profile_v1 != parent_v1_profile
+	{
+		return Err("causal mint does not match its direct-parent admission snapshot");
+	}
+	if snapshot.native_parent_block_hash != frame_system::Pallet::<T>::parent_hash()
+		|| snapshot.native_parent_height.checked_add(1) != Some(native_mint_height)
+	{
+		return Err("causal mint is not the direct native child of its admission snapshot");
+	}
+	if ProcessedPegIns::<T>::contains_key(collected.record_key)
+		|| ConsumedCausalPegInsV3::<T>::contains_key(collected.record_key)
+	{
+		return Err("causal replay state appeared before callback commit");
+	}
+	if InvalidatedCausalPegInsV1::<T>::contains_key(collected.record_key) {
+		return Err("causal invalidation tombstone appeared before callback commit");
+	}
+	if collected.record.sidechain_id != validated.source_intent.sidechain_id
+		|| collected.record.bridge_address != validated.source_intent.bridge_address
+		|| collected.record.profile_revision != parent_v1_profile.profile_revision
+		|| collected.record.profile_activation_height != parent_v1_profile.activation_height
+		|| collected.record.ergo_box_id != validated.statement.source_box_id
+		|| collected.record.recipient != validated.source_intent.recipient
+		|| collected.record.amount != validated.source_intent.amount
+		|| collected.record.sidechain_height != native_mint_height
+		|| collected.record.execution_block_hash != block.header.hash()
+	{
+		return Err("causal mint event does not match its source intent and runtime profile");
+	}
+	let status = statuses
+		.get(collected.transaction_index as usize)
+		.ok_or("causal mint transaction index is absent")?;
+	if status.transaction_hash != collected.record.transaction_hash {
+		return Err("causal mint transaction hash differs from its indexed status");
+	}
+	validate_paired_token_mint(receipts, snapshot.token_address, collected)?;
+
+	if !validate_runtime_code_expectation::<T>(
+		validated.profile.bridge_address,
+		current_profile.bridge_runtime_code_sha256,
+		current_profile.bridge_runtime_code_bytes,
+	) || !validate_runtime_code_expectation::<T>(
+		validated.profile.token_address,
+		current_profile.token_runtime_code_sha256,
+		current_profile.token_runtime_code_bytes,
+	) {
+		return Err("causal mint changed reviewed EVM runtime code");
+	}
+	let bridge_owner = decode_address_word(evm_storage_word::<T>(
+		validated.profile.bridge_address,
+		H256::from_low_u64_be(BRIDGE_OWNER_SLOT),
+	))?;
+	let bridge_configuration = evm_storage_word::<T>(
+		validated.profile.bridge_address,
+		H256::from_low_u64_be(BRIDGE_CONFIGURATION_SLOT),
+	);
+	let (configured_token, paused) = decode_bridge_configuration(bridge_configuration)?;
+	let token_owner = decode_address_word(evm_storage_word::<T>(
+		validated.profile.token_address,
+		H256::from_low_u64_be(TOKEN_OWNER_SLOT),
+	))?;
+	if bridge_owner != snapshot.bridge_owner
+		|| bridge_configuration != snapshot.bridge_configuration
+		|| configured_token != snapshot.token_address
+		|| paused
+		|| token_owner != snapshot.token_owner
+		|| token_owner != validated.profile.bridge_address
+	{
+		return Err("causal mint changed bridge configuration or ownership");
+	}
+	if evm_storage_word::<T>(
+		validated.profile.bridge_address,
+		derive_processed_peg_in_mapping_slot(validated.statement.source_box_id),
+	) != H256::from_low_u64_be(1)
+	{
+		return Err("causal mint did not set the exact Solidity replay marker");
+	}
+	let post_supply = U256::from_big_endian(
+		evm_storage_word::<T>(
+			validated.profile.token_address,
+			H256::from_low_u64_be(TOKEN_TOTAL_SUPPLY_SLOT),
+		)
+		.as_bytes(),
+	);
+	let post_balance = U256::from_big_endian(
+		evm_storage_word::<T>(
+			validated.profile.token_address,
+			derive_token_balance_mapping_slot(validated.source_intent.recipient),
+		)
+		.as_bytes(),
+	);
+	let amount = U256::from(validated.source_intent.amount);
+	if snapshot.token_total_supply.checked_add(amount) != Some(post_supply)
+		|| snapshot.recipient_balance.checked_add(amount) != Some(post_balance)
+	{
+		return Err("causal mint supply or recipient balance delta is not exact");
+	}
+
+	let consumed_bytes = encode_consumed_admission_v3(&ConsumedAdmissionV3Fields {
+		admission_id: validated.admission_id,
+		source_intent_id: validated.source_intent_id,
+		legacy_mint_identity: validated.statement.legacy_mint_identity,
+		native_parent_block_hash: snapshot.native_parent_block_hash,
+		native_mint_height,
+		execution_block_hash: collected.record.execution_block_hash,
+		execution_height: collected.record.sidechain_height,
+		transaction_hash: collected.record.transaction_hash,
+		transaction_index: collected.transaction_index,
+		event_index: collected.record.event_index,
+		processed_record_blake2b256: H256::from(blake2_256(&collected.record.encode())),
+	});
+	validate_consumed_admission_v3(&consumed_bytes)?;
+	let consumed: ConsumedAdmissionV3Bytes = consumed_bytes
+		.to_vec()
+		.try_into()
+		.map_err(|_| "consumed causal admission exceeds its exact runtime bound")?;
+	Ok(vec![ValidatedCausalConsumption {
+		record_key: collected.record_key,
+		admission_id: validated.admission_id,
+		record: collected.record.clone(),
+		consumed,
+	}])
+}
+
+fn produce_commitment(
+	bridge_address: H160,
+	sidechain_id: H256,
+	sidechain_height: U256,
+	execution_block_hash: H256,
+	receipts: &[Receipt],
+	statuses: &[TransactionStatus],
+	max_burns: u32,
+) -> Result<Option<ProducedCommitment>, &'static str> {
+	if receipts.len() != statuses.len() {
+		return Err("Frontier receipt and transaction-status counts differ");
+	}
+	if sidechain_height > U256::from(u64::MAX) {
+		return Err("Frontier block height exceeds the V1 uint64 bound");
+	}
+
+	let mut leaf_hashes = Vec::new();
+	let mut burn_ids = BTreeSet::new();
+	let mut global_log_index: u64 = 0;
+	for (transaction_index, (receipt, status)) in receipts.iter().zip(statuses.iter()).enumerate() {
+		let expected_transaction_index = u32::try_from(transaction_index)
+			.map_err(|_| "Frontier transaction index exceeds uint32")?;
+		if status.transaction_index != expected_transaction_index {
+			return Err("Frontier transaction status index is not canonical");
+		}
+		let (receipt_status, receipt_logs) = receipt_status_and_logs(receipt);
+		if status.logs != *receipt_logs {
+			return Err("Frontier receipt logs differ from transaction-status logs");
+		}
+		if receipt_status > 1 {
+			return Err("Frontier receipt status code must be zero or one");
+		}
+
+		for log in receipt_logs {
+			let event_index = u32::try_from(global_log_index)
+				.map_err(|_| "Frontier global log index exceeds uint32")?;
+			global_log_index = global_log_index
+				.checked_add(1)
+				.ok_or("Frontier global log index overflow")?;
+
+			if receipt_status == 0 || log.address != bridge_address {
+				continue;
+			}
+			if log.topics.first() != Some(&peg_out_topic()) {
+				continue;
+			}
+
+			let (amount, recipient_ergo_tree_hash) = parse_peg_out_log(log)?;
+			let burn_id = derive_burn_id(sidechain_id, status.transaction_hash, event_index);
+			if !burn_ids.insert(burn_id) {
+				return Err("duplicate bridge burn ID in Frontier block");
+			}
+			if leaf_hashes.len() >= max_burns as usize {
+				return Err("bridge burn count exceeds the configured runtime bound");
+			}
+			leaf_hashes.push(hash_burn_leaf(&BurnLeafFields {
+				sidechain_id,
+				execution_block_hash,
+				burn_id,
+				transaction_hash: status.transaction_hash,
+				event_index,
+				recipient_ergo_tree_hash,
+				amount,
+			}));
+		}
+	}
+
+	if leaf_hashes.is_empty() {
+		return Ok(None);
+	}
+	let burn_leaf_count =
+		u32::try_from(leaf_hashes.len()).map_err(|_| "bridge burn count exceeds uint32")?;
+	let bridge_event_root = merkle_root(&leaf_hashes)?;
+	Ok(Some(ProducedCommitment {
+		record: BridgeEventCommitment {
+			format_version: BRIDGE_EVENT_ROOT_FORMAT_VERSION,
+			sidechain_id,
+			sidechain_height: sidechain_height.low_u64(),
+			execution_block_hash,
+			bridge_event_root,
+			burn_leaf_count,
+		},
+		leaf_hashes,
+	}))
+}
+
+fn receipt_status_and_logs(receipt: &Receipt) -> (u8, &Vec<Log>) {
+	match receipt {
+		Receipt::Legacy(data) | Receipt::EIP2930(data) | Receipt::EIP1559(data) => {
+			(data.status_code, &data.logs)
+		}
+	}
+}
+
+fn peg_out_topic() -> H256 {
+	H256::from(keccak_256(PEG_OUT_EVENT_SIGNATURE))
+}
+
+fn peg_in_topic() -> H256 {
+	H256::from(keccak_256(PEG_IN_EVENT_SIGNATURE))
+}
+
+fn parse_peg_in_log(log: &Log) -> Result<(H160, u64, H256), &'static str> {
+	if log.topics.len() != 2 {
+		return Err("PegIn log must contain signature and indexed recipient topics");
+	}
+	let recipient_topic = log.topics[1].as_bytes();
+	if recipient_topic[..12].iter().any(|byte| *byte != 0) {
+		return Err("PegIn indexed recipient topic must use canonical ABI address padding");
+	}
+	let recipient = H160::from_slice(&recipient_topic[12..]);
+	if recipient == H160::zero() {
+		return Err("PegIn recipient must not be the zero address");
+	}
+	if log.data.len() != 64 {
+		return Err("PegIn ABI data must be exactly two words");
+	}
+	let amount = U256::from_big_endian(&log.data[..32]);
+	if amount.is_zero() || amount > U256::from(i64::MAX as u64) {
+		return Err("PegIn amount must be a positive Ergo Long");
+	}
+	let ergo_box_id = H256::from_slice(&log.data[32..]);
+	if ergo_box_id == H256::zero() {
+		return Err("PegIn Ergo box ID must not be zero");
+	}
+	Ok((recipient, amount.low_u64(), ergo_box_id))
+}
+
+fn derive_peg_in_record_key(sidechain_id: H256, ergo_box_id: H256) -> H256 {
+	let mut preimage = Vec::with_capacity(PEG_IN_RECORD_KEY_DOMAIN.len() + 32 + 32);
+	preimage.extend_from_slice(PEG_IN_RECORD_KEY_DOMAIN);
+	preimage.extend_from_slice(sidechain_id.as_bytes());
+	preimage.extend_from_slice(ergo_box_id.as_bytes());
+	H256::from(blake2_256(&preimage))
+}
+
+fn parse_peg_out_log(log: &Log) -> Result<(u64, H256), &'static str> {
+	if log.topics.len() != 2 {
+		return Err("PegOut log must contain signature and indexed user topics");
+	}
+	if log.topics[1].as_bytes()[..12].iter().any(|byte| *byte != 0) {
+		return Err("PegOut indexed user topic must be canonical ABI address padding");
+	}
+	if log.data.len() != 160 {
+		return Err("PegOut ABI data must be exactly five words");
+	}
+
+	let amount = U256::from_big_endian(&log.data[0..32]);
+	if amount.is_zero() || amount > U256::from(i64::MAX as u64) {
+		return Err("PegOut amount must be a positive Ergo Long");
+	}
+	if U256::from_big_endian(&log.data[32..64]) != U256::from(64u64) {
+		return Err("PegOut recipient offset must be canonical ABI offset 64");
+	}
+	let recipient_len = U256::from_big_endian(&log.data[64..96]);
+	let recipient_len = if recipient_len == U256::from(33u64) {
+		33usize
+	} else if recipient_len == U256::from(36u64) {
+		36usize
+	} else {
+		return Err("PegOut recipient must be a 33-byte key or 36-byte P2PK ErgoTree");
+	};
+	if log.data[(96 + recipient_len)..]
+		.iter()
+		.any(|byte| *byte != 0)
+	{
+		return Err("PegOut recipient ABI padding must be zero");
+	}
+
+	let recipient = &log.data[96..(96 + recipient_len)];
+	let ergo_tree = if recipient_len == 33 {
+		if !matches!(recipient[0], 0x02 | 0x03) {
+			return Err("PegOut compressed public key prefix must be 02 or 03");
+		}
+		let mut tree = Vec::with_capacity(36);
+		tree.extend_from_slice(&P2PK_ERGO_TREE_PREFIX);
+		tree.extend_from_slice(recipient);
+		tree
+	} else {
+		if recipient[..3] != P2PK_ERGO_TREE_PREFIX || !matches!(recipient[3], 0x02 | 0x03) {
+			return Err("PegOut 36-byte recipient must be a canonical P2PK ErgoTree");
+		}
+		recipient.to_vec()
+	};
+
+	Ok((amount.low_u64(), H256::from(blake2_256(&ergo_tree))))
+}
+
+fn derive_burn_id(sidechain_id: H256, transaction_hash: H256, event_index: u32) -> H256 {
+	let mut bytes = Vec::with_capacity(BURN_ID_DOMAIN.len() + 32 + 32 + 4);
+	bytes.extend_from_slice(BURN_ID_DOMAIN);
+	bytes.extend_from_slice(sidechain_id.as_bytes());
+	bytes.extend_from_slice(transaction_hash.as_bytes());
+	bytes.extend_from_slice(&event_index.to_be_bytes());
+	H256::from(blake2_256(&bytes))
+}
+
+fn hash_burn_leaf(leaf: &BurnLeafFields) -> H256 {
+	let mut encoded = Vec::with_capacity(205);
+	encoded.push(BURN_LEAF_VERSION);
+	encoded.extend_from_slice(leaf.sidechain_id.as_bytes());
+	encoded.extend_from_slice(leaf.execution_block_hash.as_bytes());
+	encoded.extend_from_slice(leaf.burn_id.as_bytes());
+	encoded.extend_from_slice(leaf.transaction_hash.as_bytes());
+	encoded.extend_from_slice(&leaf.event_index.to_be_bytes());
+	encoded.extend_from_slice(leaf.recipient_ergo_tree_hash.as_bytes());
+	encoded.extend_from_slice(&leaf.amount.to_be_bytes());
+	encoded.extend_from_slice(&[0u8; 32]);
+
+	let mut preimage = Vec::with_capacity(BURN_LEAF_DOMAIN.len() + encoded.len());
+	preimage.extend_from_slice(BURN_LEAF_DOMAIN);
+	preimage.extend_from_slice(&encoded);
+	H256::from(blake2_256(&preimage))
+}
+
+fn merkle_root(leaves: &[H256]) -> Result<H256, &'static str> {
+	if leaves.is_empty() {
+		return Err("bridge event root requires at least one burn leaf");
+	}
+	let mut level = leaves.to_vec();
+	while level.len() > 1 {
+		let mut next = Vec::with_capacity((level.len() + 1) / 2);
+		for pair in level.chunks(2) {
+			let left = pair[0];
+			let right = pair.get(1).copied().unwrap_or(left);
+			let mut preimage = Vec::with_capacity(BURN_NODE_DOMAIN.len() + 64);
+			preimage.extend_from_slice(BURN_NODE_DOMAIN);
+			preimage.extend_from_slice(left.as_bytes());
+			preimage.extend_from_slice(right.as_bytes());
+			next.push(H256::from(blake2_256(&preimage)));
+		}
+		level = next;
+	}
+	Ok(level[0])
+}

+//! Standard-input entrypoint for non-signing causal source-proof result derivation.
+
+use std::{
+	env,
+	io::{self, Read},
+	process::ExitCode,
+};
+
+use bridge_checkpoint_verifier::peg_in_causal_source_proof_result_v1::MAX_REQUEST_BYTES;
+
+fn main() -> ExitCode {
+	match run() {
+		Ok(()) => ExitCode::SUCCESS,
+		Err(error) => {
+			eprintln!("causal source-proof result derivation failed: {error}");
+			ExitCode::from(2)
+		}
+	}
+}
+
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+	if env::args().nth(1).is_some() {
+		return Err("this producer accepts no command-line arguments".into());
+	}
+	let mut request = Vec::new();
+	io::stdin()
+		.take((MAX_REQUEST_BYTES + 1) as u64)
+		.read_to_end(&mut request)?;
+	let result =
+		bridge_checkpoint_verifier::peg_in_causal_source_proof_result_v1::verify_request_bytes(
+			&request,
+		)?;
+	serde_json::to_writer(io::stdout().lock(), &result)?;
+	Ok(())
+}

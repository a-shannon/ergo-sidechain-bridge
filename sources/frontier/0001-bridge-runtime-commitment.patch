@@ -0,0 +1,107 @@
+use std::{
+	io::Write,
+	process::{Command, Output, Stdio},
+};
+
+use bridge_checkpoint_verifier::{
+	fixture::{deterministic_fixture_request, deterministic_fixture_trusted_anchor_digest_hex},
+	peg_in::NativePegInStateVerification,
+	peg_in_fixture::{
+		deterministic_membership_fixture_request,
+		deterministic_trusted_anchor_digest_hex as deterministic_peg_in_trusted_anchor_digest_hex,
+	},
+	NativeCheckpointVerification,
+};
+
+#[test]
+fn requires_separate_trust_root_and_verifies_the_pinned_fixture() {
+	let request = serde_json::to_vec(&deterministic_fixture_request()).unwrap();
+	let trusted_digest = deterministic_fixture_trusted_anchor_digest_hex();
+
+	let missing = run_verifier(&[], &request);
+	assert!(!missing.status.success());
+	assert!(missing.stdout.is_empty());
+
+	let wrong = run_verifier(
+		&[
+			"--trusted-anchor-digest",
+			"0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
+		],
+		&request,
+	);
+	assert!(!wrong.status.success());
+	assert!(wrong.stdout.is_empty());
+
+	let accepted = run_verifier(&["--trusted-anchor-digest", &trusted_digest], &request);
+	assert!(accepted.status.success());
+	assert!(accepted.stderr.is_empty());
+	let verified: NativeCheckpointVerification = serde_json::from_slice(&accepted.stdout).unwrap();
+	assert_eq!(
+		verified.status,
+		"NATIVE_CHECKPOINT_VERIFIED_RELATIVE_TO_REVIEWED_TRUST_ROOT"
+	);
+	assert_eq!(verified.trust_anchor_digest_hex, trusted_digest);
+}
+
+#[test]
+fn keeps_burn_and_peg_in_cli_profiles_separate() {
+	let peg_in_request = serde_json::to_vec(&deterministic_membership_fixture_request()).unwrap();
+	let peg_in_trusted_digest = deterministic_peg_in_trusted_anchor_digest_hex();
+	let burn_request = serde_json::to_vec(&deterministic_fixture_request()).unwrap();
+	let burn_trusted_digest = deterministic_fixture_trusted_anchor_digest_hex();
+
+	let accepted = run_verifier(
+		&[
+			"--verify-peg-in-state",
+			"--trusted-anchor-digest",
+			&peg_in_trusted_digest,
+		],
+		&peg_in_request,
+	);
+	assert!(accepted.status.success());
+	assert!(accepted.stderr.is_empty());
+	let verified: NativePegInStateVerification = serde_json::from_slice(&accepted.stdout).unwrap();
+	assert_eq!(verified.runtime_state.outcome, "MEMBERSHIP");
+	assert!(!verified.boundary.mint_authorized);
+
+	let wrong_peg_in_trust_root = run_verifier(
+		&[
+			"--verify-peg-in-state",
+			"--trusted-anchor-digest",
+			"0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
+		],
+		&peg_in_request,
+	);
+	assert!(!wrong_peg_in_trust_root.status.success());
+	assert!(wrong_peg_in_trust_root.stdout.is_empty());
+
+	let peg_in_through_burn = run_verifier(
+		&["--trusted-anchor-digest", &peg_in_trusted_digest],
+		&peg_in_request,
+	);
+	assert!(!peg_in_through_burn.status.success());
+	assert!(peg_in_through_burn.stdout.is_empty());
+
+	let burn_through_peg_in = run_verifier(
+		&[
+			"--verify-peg-in-state",
+			"--trusted-anchor-digest",
+			&burn_trusted_digest,
+		],
+		&burn_request,
+	);
+	assert!(!burn_through_peg_in.status.success());
+	assert!(burn_through_peg_in.stdout.is_empty());
+}
+
+fn run_verifier(arguments: &[&str], request: &[u8]) -> Output {
+	let mut child = Command::new(env!("CARGO_BIN_EXE_bridge-checkpoint-verifier"))
+		.args(arguments)
+		.stdin(Stdio::piped())
+		.stdout(Stdio::piped())
+		.stderr(Stdio::piped())
+		.spawn()
+		.unwrap();
+	child.stdin.as_mut().unwrap().write_all(request).unwrap();
+	child.wait_with_output().unwrap()
+}

+		invalidation_id.as_bytes(),
+	)
+}
+
+pub fn verify_federated_pooled_reserve_invalidation_v1(
+	source_profile: &FederatedPooledReserveSourceProofProfileV1,
+	runtime_profile: &PooledReserveMintReservationRuntimeProfileV4,
+	pending: &PendingPooledReserveMintReservationV4,
+	current_native_height: u64,
+	invalidation: &FederatedPooledReserveInvalidationV1,
+) -> Result<VerifiedFederatedPooledReserveInvalidationV1, &'static str> {
+	validate_federated_pooled_reserve_source_proof_profile_v1(source_profile)?;
+	let runtime_profile_id =
+		validate_pooled_reserve_mint_reservation_profile_v4(runtime_profile)?;
+	let validated =
+		validate_pooled_reserve_mint_reservation_statement_v4(&pending.statement_bytes)?;
+	let proof_system_id = federated_pooled_reserve_source_proof_system_id_v1();
+	let proof_profile_id =
+		derive_federated_pooled_reserve_source_proof_profile_id_v1(source_profile)?;
+	let key_set_digest =
+		derive_federated_pooled_reserve_source_key_set_digest_v1(source_profile)?;
+	if pending.format_version != POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4
+		|| pending.profile_id != runtime_profile_id
+		|| pending.statement_id != validated.statement_id
+		|| pending.mint_identity != validated.statement.mint_identity
+		|| pending.source_proof_system_id != proof_system_id
+		|| pending.source_proof_profile_id != proof_profile_id
+		|| invalidation.proof_system_id != proof_system_id
+		|| invalidation.proof_profile_id != proof_profile_id
+		|| invalidation.federation_epoch != source_profile.federation_epoch
+		|| invalidation.source_attestation_key_set_digest != key_set_digest
+		|| invalidation.source_attestation_threshold != source_profile.threshold
+		|| invalidation.runtime_profile_id != runtime_profile_id
+		|| invalidation.statement_id != pending.statement_id
+		|| invalidation.mint_identity != pending.mint_identity
+		|| invalidation.source_proof_result_id != pending.source_proof_result_id
+	{
+		return Err("federated pooled-reserve invalidation does not bind the pending reservation");
+	}
+	validate_federated_pooled_reserve_validity_window_v1(
+		invalidation.issued_at_native_height,
+		invalidation.expires_at_native_height,
+		current_native_height,
+		runtime_profile.activation_height,
+		source_profile.max_validity_blocks,
+		u64::from(runtime_profile.max_pending_blocks),
+	)?;
+	let invalidation_id = derive_federated_pooled_reserve_invalidation_id_v1(invalidation)?;
+	let attestation_digest =
+		derive_federated_pooled_reserve_invalidation_attestation_digest_v1(invalidation_id);
+	let signature_set_digest = validate_federated_threshold_signatures_v1(
+		&source_profile.signer_public_keys,
+		source_profile.threshold,
+		&invalidation.signatures,
+		attestation_digest,
+		FEDERATED_INVALIDATION_SIGNATURE_SET_DOMAIN_V1,
+	)?;
+	let mut proof_preimage = Vec::with_capacity(64);
+	proof_preimage.extend_from_slice(invalidation_id.as_bytes());
+	proof_preimage.extend_from_slice(signature_set_digest.as_bytes());
+	Ok(VerifiedFederatedPooledReserveInvalidationV1 {
+		runtime_profile_id,
+		statement_id: pending.statement_id,
+		mint_identity: pending.mint_identity,
+		source_proof_result_id: pending.source_proof_result_id,
+		reason_code: federated_pooled_reserve_invalidation_reason_code_v1(
+			invalidation.reason,
+		),
+		invalidation_id,
+		proof_digest: domain_hash(FEDERATED_INVALIDATION_ENVELOPE_DOMAIN_V1, &proof_preimage),
+		issued_at_native_height: invalidation.issued_at_native_height,
+		expires_at_native_height: invalidation.expires_at_native_height,
+	})
+}
+
+fn federated_pooled_reserve_invalidation_reason_code_v1(
+	reason: FederatedPooledReserveInvalidationReasonV1,
+) -> u8 {
+	match reason {
+		FederatedPooledReserveInvalidationReasonV1::StaleCheckpoint => {
+			POOLED_RESERVE_MINT_RESERVATION_INVALIDATION_REASON_STALE_CHECKPOINT_V4
+		}
+		FederatedPooledReserveInvalidationReasonV1::SourceReorg => {
+			POOLED_RESERVE_MINT_RESERVATION_INVALIDATION_REASON_SOURCE_REORG_V4
+		}
+		FederatedPooledReserveInvalidationReasonV1::ConflictingSourceViews => {
+			POOLED_RESERVE_MINT_RESERVATION_INVALIDATION_REASON_CONFLICTING_SOURCE_VIEWS_V4
+		}
+	}
+}
+
+fn validate_federated_pooled_reserve_validity_window_v1(
+	issued_at_native_height: u64,
+	expires_at_native_height: u64,
+	current_native_height: u64,
+	activation_height: u64,
+	profile_max_validity_blocks: u64,
+	runtime_max_validity_blocks: u64,
+) -> Result<(), &'static str> {
+	let lifetime = expires_at_native_height
+		.checked_sub(issued_at_native_height)
+		.ok_or("federated pooled-reserve source proof validity window underflows")?;
+	if issued_at_native_height < activation_height
+		|| issued_at_native_height > current_native_height
+		|| current_native_height >= expires_at_native_height
+		|| lifetime == 0
+		|| lifetime > profile_max_validity_blocks
+		|| lifetime > runtime_max_validity_blocks
+	{
+		return Err("federated pooled-reserve source proof is stale or outside its window");
+	}
+	Ok(())
+}

+			CausalPegInAdmissionReceiptsV1::<T>::insert(record_key, &receipt);
+			PendingCausalPegInKeys::<T>::put(pending_keys);
+			Self::deposit_event(Event::CausalPegInAdmissionStored {
+				record_key,
+				admission_id: pending.admission_id,
+				request_digest: receipt.source_proof_request_digest,
+				result_id: receipt.source_proof_result_id,
+				proof_digest: receipt.source_proof_digest,

+	let (forwarded_survivor_header, forwarded_survivor_body) = forwarded_survivor.deconstruct();
+	let mut forwarded_survivor_params =
+		BlockImportParams::new(BlockOrigin::File, forwarded_survivor_header);
+	forwarded_survivor_params.body = Some(forwarded_survivor_body);
+	forwarded_survivor_params.state_action = StateAction::Execute;
+	forwarded_survivor_params.fork_choice = Some(ForkChoiceStrategy::Custom(true));
+	let forwarded_survivor_importer =
+		fc_consensus::FrontierBlockImport::new(client.clone(), client.clone());

+		let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+		let state_root = *backend.root();
+		let proof = prove_read(backend, requested_keys.iter().map(Vec::as_slice))
+			.expect("deterministic state must produce the requested V2 proof");
+		(state_root, proof.into_iter_nodes().collect())
+	}

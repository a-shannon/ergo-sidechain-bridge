+pub fn derive_federated_pooled_reserve_source_key_set_digest_v1(
+	profile: &FederatedPooledReserveSourceProofProfileV1,
+) -> Result<H256, &'static str> {
+	validate_federated_pooled_reserve_source_proof_profile_v1(profile)?;
+	let mut encoded = Vec::with_capacity(2 + profile.signer_public_keys.len() * 32);
+	encoded.extend_from_slice(&(profile.signer_public_keys.len() as u16).to_be_bytes());
+	for signer in &profile.signer_public_keys {
+		encoded.extend_from_slice(signer);
+	}
+	Ok(domain_hash(FEDERATED_SOURCE_KEY_SET_DOMAIN_V1, &encoded))
+}

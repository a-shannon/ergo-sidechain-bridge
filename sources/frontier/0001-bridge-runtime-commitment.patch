+				&v1_profile,
+				native_parent_block_hash,
+				native_parent_height,
+				false,
+			)
+			.map_err(|_| Error::<T>::InvalidPendingCausalPegInAdmission)?;
+			ensure!(
+				current_height >= receipt.expires_at_native_height,
+				Error::<T>::CausalPegInAdmissionNotExpired
+			);
+			remove_pending_admission::<T>(record_key)
+				.map_err(|_| Error::<T>::InvalidPendingCausalPegInAdmission)?;
+			Self::deposit_event(Event::CausalPegInAdmissionInvalidated {

+		let mut intent = deterministic_fixture_request();
+		intent.source_intent_canonical_hex =
+			replace_byte(&intent.source_intent_canonical_hex, 169, 0x01);
+		assert!(!verify(&intent));
+
+		let mut statement = deterministic_fixture_request();
+		statement.statement_canonical_hex =
+			replace_byte(&statement.statement_canonical_hex, 33, 0x00);
+		assert!(!verify(&statement));
+
+		let mut candidate = deterministic_fixture_request();
+		candidate.candidate_id_hex = format!("0x{}", "42".repeat(32));
+		assert!(!verify(&candidate));
+	}
+
+	#[test]
+	fn rejects_static_profile_finality_depth_and_height_window_mutations() {
+		let mut proof_system = deterministic_fixture_request();
+		proof_system.admission_profile_canonical_hex =
+			replace_byte(&proof_system.admission_profile_canonical_hex, 233, 0x37);
+		assert!(!verify(&proof_system));
+
+		let mut finality = deterministic_fixture_request();
+		finality.statement_canonical_hex =
+			replace_byte(&finality.statement_canonical_hex, 345, 0x26);
+		assert!(!verify(&finality));
+
+		let mut confirmations = deterministic_fixture_request();
+		confirmations.statement_canonical_hex =
+			replace_byte(&confirmations.statement_canonical_hex, 380, 9);
+		assert!(!verify(&confirmations));
+
+		let mut window = deterministic_fixture_request();
+		window.expires_at_native_height = "1066".to_owned();
+		assert!(!verify(&window));
+	}
+}

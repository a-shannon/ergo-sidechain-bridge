+	fn rebind_block(fixture: &mut Fixture) {
+		fixture.block.header.transactions_root = ethereum::util::ordered_trie_root(
+			fixture
+				.block
+				.transactions
+				.iter()
+				.map(EnvelopedEncodable::encode),
+		);
+		fixture.block.header.receipts_root = ethereum::util::ordered_trie_root(
+			fixture.receipts.iter().map(EnvelopedEncodable::encode),
+		);
+		let mut bloom = Bloom::default();
+		for receipt in &fixture.receipts {
+			accrue_logs(receipt_fields(receipt).1, &mut bloom);
+		}
+		fixture.block.header.logs_bloom = bloom;
+		fixture.record.execution_block_hash = fixture.block.header.hash();
+	}

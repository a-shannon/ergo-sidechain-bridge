+#[cfg(test)]
+mod tests {
+	use super::*;
+
+	fn nibble(value: u8) -> u8 {
+		match value {
+			b'0'..=b'9' => value - b'0',
+			b'a'..=b'f' => value - b'a' + 10,
+			_ => panic!("test vector must be lowercase hexadecimal"),
+		}
+	}
+
+	fn hex_bytes(value: &str) -> Vec<u8> {
+		value
+			.trim()
+			.as_bytes()
+			.chunks_exact(2)
+			.map(|chunk| (nibble(chunk[0]) << 4) | nibble(chunk[1]))
+			.collect()
+	}
+
+	fn h256(value: &str) -> H256 {
+		H256::from_slice(&hex_bytes(value))
+	}
+
+	fn witness() -> Vec<u8> {
+		hex_bytes(include_str!(
+			"test-vectors/ergo-utxo-state-runtime-witness-v1.hex"
+		))
+	}
+
+	#[test]
+	fn verifies_the_exact_typescript_witness_without_authority() {
+		let bytes = witness();
+		assert_eq!(bytes.len(), 652);
+		assert_eq!(
+			H256::from(sha2_256(&bytes)),
+			h256("1dacdf4bf5b1aecbb9d4cf04a1dc58a18b8a41ad1434a65ddf226a3fe2ffc900")
+		);
+		assert_eq!(
+			ergo_utxo_state_runtime_witness_family_id_v1(),
+			h256("2d7b1929093f488d83a1a25b4ada38c40237920cb88908f6aa5976b677a43a26")
+		);
+		assert_eq!(
+			ergo_utxo_state_runtime_verifier_profile_id_v1(),
+			h256("9e90fc9e2e50e3adbfddc89177277406a5ef3a70b062214b9f958960ea309050")
+		);
+		let verified = verify_ergo_utxo_state_runtime_witness_v1(&bytes).unwrap();
+		assert_eq!(
+			verified.witness_id,
+			h256("e7c82bef7d520d0f30d1122221f97f41ae1d275d495a5e5e41df517367fdebf5")
+		);
+		assert_eq!(verified.expected_vault_box.len(), 175);
+		assert_eq!(verified.proof.len(), 280);
+	}
+
+	#[test]
+	fn rejects_envelope_binding_and_proof_mutations_without_panicking() {
+		let canonical = witness();
+		for offset in [0usize, 8, 9, 10, 12, 16, 60, 92, 125, 126, 127, 128, 129, 193, 197, 372, 373, 651] {
+			let mut mutant = canonical.clone();
+			mutant[offset] ^= 1;
+			assert!(
+				verify_ergo_utxo_state_runtime_witness_v1(&mutant).is_err(),
+				"offset {offset} was not isolated"
+			);
+		}
+		assert!(verify_ergo_utxo_state_runtime_witness_v1(
+			&canonical[..canonical.len() - 1]
+		)
+		.is_err());
+
+		let mut different_absent_key = canonical.clone();
+		different_absent_key[161] ^= 1;
+		let verified = verify_ergo_utxo_state_runtime_witness_v1(&different_absent_key).unwrap();
+		assert_ne!(
+			verified.refundable_source_box_id,
+			verify_ergo_utxo_state_runtime_witness_v1(&canonical)
+				.unwrap()
+				.refundable_source_box_id
+		);
+		assert_ne!(
+			verified.witness_id,
+			derive_ergo_utxo_state_runtime_witness_id_v1(&canonical).unwrap()
+		);
+	}
+
+	#[test]
+	fn rejects_unused_direction_bytes_and_invalid_internal_framing() {
+		let canonical = witness();
+		let mut extended = canonical.clone();
+		extended.push(0);
+		let total = extended.len() as u32;
+		extended[12..16].copy_from_slice(&total.to_be_bytes());
+		extended[56..60].copy_from_slice(&281u32.to_be_bytes());
+		assert_eq!(
+			verify_ergo_utxo_state_runtime_witness_v1(&extended),
+			Err("Ergo UTXO runtime proof contains unused direction bytes")
+		);
+
+		let mut invalid_tag = canonical;
+		invalid_tag[372] = 5;
+		assert_eq!(
+			verify_ergo_utxo_state_runtime_witness_v1(&invalid_tag),
+			Err("Ergo UTXO runtime proof contains an invalid internal balance")
+		);
+	}
+}

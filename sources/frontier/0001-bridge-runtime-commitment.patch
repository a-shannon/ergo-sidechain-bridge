+++ b/bridge/checkpoint-verifier/src/fixture.rs
@@ -0,0 +1,396 @@
+//! Reproducible cross-language fixture with a real authority handoff and trie proof.
+
+use std::collections::BTreeMap;
+
+use base64::{engine::general_purpose::STANDARD, Engine as _};
+use bridge_state_proof::{
+	derive_grandpa_trust_anchor_digest, BridgeEventCommitmentV1, BRIDGE_COMMITMENT_STORAGE_KEY,
+};
+use finality_grandpa::{Commit, Precommit, SignedPrecommit};
+use sc_consensus_grandpa::{FinalityProof, GrandpaJustification};
+use scale_codec::Encode;
+use serde::Serialize;
+use serde_json::{json, Value};
+use sp_consensus_grandpa::{AuthorityList, SetId};
+use sp_core::{ed25519, Pair, H256};
+use sp_runtime::{
+	traits::{BlakeTwo256, Header as _},
+	Digest, DigestItem, StateVersion,
+};
+use sp_state_machine::{prove_read, InMemoryBackend};
+
+use crate::{
+	verify_request_bytes, LinkedGrandpaProofRequest, NativeBlock, NativeCheckpointRequest,
+	NativeCheckpointVerification, NativeHeader, TrustAnchorRequest, REQUEST_SCHEMA,
+};
+
+const INITIAL_SET_ID: SetId = 7;
+const ROUND: u64 = 11;
+/// Stable schema for the checked-in cross-language fixture wrapper.
+pub const FIXTURE_VECTOR_SCHEMA: &str = "e2s.native-finalized-bridge-checkpoint.vector.v2";
+
+/// Checked-in deterministic request and its exact successful native result.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct NativeCheckpointFixtureVector {
+	/// Exact fixture wrapper schema.
+	pub schema: String,
+	/// Independently supplied digest used as the fixture trust root.
+	pub trusted_anchor_digest_hex: String,
+	/// Strict native verifier request.
+	pub request: NativeCheckpointRequest,
+	/// Expected result for the canonical compact JSON request bytes.
+	pub expected: NativeCheckpointVerification,
+	/// Exact synthetic read-only RPC responses used to exercise package collection.
+	pub rpc_fixture: NativeCheckpointRpcFixture,
+}
+
+/// Synthetic read-only RPC fixture generated from the same real cryptographic material.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct NativeCheckpointRpcFixture {
+	/// Identifies this input as deterministic local test material only.
+	pub synthetic: bool,
+	/// Exact RPC method, parameter, and result tuples available to the collector.
+	pub responses: Vec<NativeCheckpointRpcResponse>,
+}
+
+/// One exact synthetic JSON-RPC result.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct NativeCheckpointRpcResponse {
+	/// Read-only RPC method.
+	pub method: String,
+	/// Exact positional parameters.
+	pub params: Value,
+	/// Exact method result.
+	pub result: Value,
+}
+
+#[derive(Encode)]
+struct FixtureWarpFragment {
+	header: NativeHeader,
+	justification: GrandpaJustification<NativeBlock>,
+}
+
+#[derive(Encode)]
+struct FixtureWarpProof {
+	proofs: Vec<FixtureWarpFragment>,
+	is_finished: bool,
+}
+
+/// Build one deterministic request whose cryptographic signatures and state proof are real.
+///
+/// The keys are fixed test-only material generated inside this function. The returned artifact
+/// contains public authorities and signatures, never signing seeds.
+pub fn deterministic_fixture_request() -> NativeCheckpointRequest {
+	deterministic_fixture_material().0
+}
+
+/// Return the test-only trust root separately from the proof-serving request.
+pub fn deterministic_fixture_trusted_anchor_digest_hex() -> String {
+	deterministic_fixture_material().1
+}
+
+fn deterministic_fixture_material() -> (NativeCheckpointRequest, String, NativeCheckpointRpcFixture)
+{
+	let (initial_pairs, initial_authorities) = authority_fixture(21);
+	let (next_pairs, next_authorities) = authority_fixture(31);
+	let sidechain_id = H256::repeat_byte(0x11);
+	let commitment = BridgeEventCommitmentV1 {
+		format_version: 1,
+		sidechain_id,
+		sidechain_height: 1_024,
+		execution_block_hash: H256::repeat_byte(0x22),
+		bridge_event_root: H256::from_slice(
+			&hex::decode("af06acdab6c0a84382ba80bd42c1e80d9f8494cacd8954ca1226f00522c8976e")
+				.expect("Frontier cross-language event root must be hex"),
+		),
+		burn_leaf_count: 3,
+	};
+	let (state_root, state_nodes) = state_proof(&commitment);
+
+	let anchor = NativeHeader::new(
+		1_023,
+		H256::repeat_byte(0x40),
+		H256::repeat_byte(0x41),
+		H256::repeat_byte(0x00),
+		Digest::default(),
+	);
+	let change = sp_consensus_grandpa::ConsensusLog::ScheduledChange(
+		sp_consensus_grandpa::ScheduledChange {
+			delay: 0,
+			next_authorities: next_authorities.clone(),
+		},
+	);
+	let target = NativeHeader::new(
+		1_024,
+		H256::repeat_byte(0x42),
+		state_root,
+		anchor.hash(),
+		Digest::default(),
+	);
+	let transition = NativeHeader::new(
+		1_025,
+		H256::repeat_byte(0x43),
+		H256::repeat_byte(0x44),
+		target.hash(),
+		Digest {
+			logs: vec![DigestItem::Consensus(
+				sp_consensus_grandpa::GRANDPA_ENGINE_ID,
+				change.encode(),
+			)],
+		},
+	);
+	let horizon = NativeHeader::new(
+		1_026,
+		H256::repeat_byte(0x45),
+		H256::repeat_byte(0x46),
+		transition.hash(),
+		Digest::default(),
+	);
+
+	let transition_justification =
+		signed_justification(&transition, &initial_pairs, INITIAL_SET_ID);
+	let horizon_justification = signed_justification(&horizon, &next_pairs, INITIAL_SET_ID + 1);
+	let source_warp_proof = FixtureWarpProof {
+		proofs: vec![
+			FixtureWarpFragment {
+				header: transition.clone(),
+				justification: transition_justification.clone(),
+			},
+			FixtureWarpFragment {
+				header: horizon.clone(),
+				justification: horizon_justification.clone(),
+			},
+		],
+		is_finished: true,
+	}
+	.encode();
+	let selected_linked_proof = FixtureWarpProof {
+		proofs: vec![FixtureWarpFragment {
+			header: transition.clone(),
+			justification: transition_justification,
+		}],
+		is_finished: false,
+	}
+	.encode();
+	let finality_proof: FinalityProof<NativeHeader> = FinalityProof {
+		block: horizon.hash(),
+		justification: horizon_justification.encode(),
+		unknown_headers: vec![transition.clone(), horizon.clone()],
+	};
+	let trust_anchor_digest = derive_grandpa_trust_anchor_digest(
+		sidechain_id,
+		anchor.hash(),
+		u64::from(*anchor.number()),
+		INITIAL_SET_ID,
+		&initial_authorities,
+	);
+
+	let request = NativeCheckpointRequest {
+		schema: REQUEST_SCHEMA.to_owned(),
+		trust_anchor: TrustAnchorRequest {
+			sidechain_id_hex: hash_hex(sidechain_id),
+			checkpoint_hash_hex: hash_hex(anchor.hash()),
+			checkpoint_number: u64::from(*anchor.number()).to_string(),
+			grandpa_set_id: INITIAL_SET_ID.to_string(),
+			authority_list_scale_hex: bytes_hex(&initial_authorities.encode()),
+		},
+		target_native_block_hash_hex: hash_hex(target.hash()),
+		target_header_scale_hex: bytes_hex(&target.encode()),
+		linked_grandpa_proofs: vec![LinkedGrandpaProofRequest {
+			ancestry_headers_scale_hex: vec![
+				bytes_hex(&target.encode()),
+				bytes_hex(&transition.encode()),
+			],
+			proof_scale_hex: bytes_hex(&selected_linked_proof),
+		}],
+		checkpoint_tail_headers_scale_hex: vec![bytes_hex(&horizon.encode())],
+		finality_proof_scale_hex: bytes_hex(&finality_proof.encode()),
+		runtime_state_proof_nodes_hex: state_nodes.iter().map(|node| bytes_hex(node)).collect(),
+	};
+	let storage_key = bytes_hex(&BRIDGE_COMMITMENT_STORAGE_KEY);
+	let target_hash = hash_hex(target.hash());
+	let rpc_fixture = NativeCheckpointRpcFixture {
+		synthetic: true,
+		responses: vec![
+			rpc_response(
+				"chain_getBlockHash",
+				json!([0]),
+				json!(hash_hex(sidechain_id)),
+			),
+			rpc_response(
+				"chain_getBlockHash",
+				json!([anchor.number()]),
+				json!(hash_hex(anchor.hash())),
+			),
+			rpc_response(
+				"chain_getFinalizedHead",
+				json!([]),
+				json!(hash_hex(horizon.hash())),
+			),
+			rpc_response(
+				"chain_getHeader",
+				json!([hash_hex(horizon.hash())]),
+				serde_json::to_value(&horizon).expect("fixture header must serialize"),
+			),
+			rpc_response(
+				"chain_getHeader",
+				json!([target_hash]),
+				serde_json::to_value(&target).expect("fixture header must serialize"),
+			),
+			rpc_response(
+				"chain_getBlockHash",
+				json!([target.number()]),
+				json!(target_hash),
+			),
+			rpc_response(
+				"bridge_grandpaWarpProof",
+				json!([hash_hex(anchor.hash())]),
+				json!({
+					"encoding": "base64",
+					"proof": STANDARD.encode(&source_warp_proof),
+				}),
+			),
+			rpc_response(
+				"chain_getBlockHash",
+				json!([transition.number()]),
+				json!(hash_hex(transition.hash())),
+			),
+			rpc_response(
+				"chain_getBlockHash",
+				json!([target.number()]),
+				json!(target_hash),
+			),
+			rpc_response(
+				"chain_getBlockHash",
+				json!([horizon.number()]),
+				json!(hash_hex(horizon.hash())),
+			),
+			rpc_response(
+				"chain_getBlockHash",
+				json!([horizon.number()]),
+				json!(hash_hex(horizon.hash())),
+			),
+			rpc_response(
+				"chain_getHeader",
+				json!([hash_hex(transition.hash())]),
+				serde_json::to_value(&transition).expect("fixture header must serialize"),
+			),
+			rpc_response(
+				"chain_getHeader",
+				json!([target_hash]),
+				serde_json::to_value(&target).expect("fixture header must serialize"),
+			),
+			rpc_response(
+				"chain_getHeader",
+				json!([hash_hex(horizon.hash())]),
+				serde_json::to_value(&horizon).expect("fixture header must serialize"),
+			),
+			rpc_response(
+				"grandpa_proveFinality",
+				json!([target.number()]),
+				json!(bytes_hex(&finality_proof.encode())),
+			),
+			rpc_response(
+				"state_getStorage",
+				json!([storage_key, target_hash]),
+				json!(bytes_hex(&commitment.encode())),
+			),
+			rpc_response(
+				"state_getReadProof",
+				json!([[storage_key], target_hash]),
+				json!({
+					"at": target_hash,
+					"proof": state_nodes.iter().map(|node| bytes_hex(node)).collect::<Vec<_>>(),
+				}),
+			),
+		],
+	};
+	(request, hash_hex(trust_anchor_digest), rpc_fixture)
+}
+
+/// Build the checked-in fixture wrapper and its digest-bound expected result.
+pub fn deterministic_fixture_vector() -> NativeCheckpointFixtureVector {
+	let (request, trusted_anchor_digest_hex, rpc_fixture) = deterministic_fixture_material();
+	let raw_request = serde_json::to_vec(&request)
+		.expect("the deterministic request must have a canonical JSON representation");
+	let expected = verify_request_bytes(&raw_request, &trusted_anchor_digest_hex)
+		.expect("the deterministic request must pass native verification");
+	NativeCheckpointFixtureVector {
+		schema: FIXTURE_VECTOR_SCHEMA.to_owned(),
+		trusted_anchor_digest_hex,
+		request,
+		expected,
+		rpc_fixture,
+	}
+}
+
+fn rpc_response(method: &str, params: Value, result: Value) -> NativeCheckpointRpcResponse {
+	NativeCheckpointRpcResponse {
+		method: method.to_owned(),
+		params,
+		result,
+	}
+}
+
+fn authority_fixture(first_seed: u8) -> (Vec<ed25519::Pair>, AuthorityList) {
+	let pairs = (first_seed..first_seed + 3)
+		.map(|seed| ed25519::Pair::from_seed(&[seed; 32]))
+		.collect::<Vec<_>>();
+	let authorities = pairs
+		.iter()
+		.map(|pair| (pair.public().into(), 1u64))
+		.collect();
+	(pairs, authorities)
+}
+
+fn signed_justification(
+	header: &NativeHeader,
+	pairs: &[ed25519::Pair],
+	set_id: SetId,
+) -> GrandpaJustification<NativeBlock> {
+	let precommit = Precommit {
+		target_hash: header.hash(),
+		target_number: *header.number(),
+	};
+	let message = sp_consensus_grandpa::Message::<NativeHeader>::Precommit(precommit.clone());
+	let payload = sp_consensus_grandpa::localized_payload(ROUND, set_id, &message);
+	let precommits = pairs
+		.iter()
+		.map(|pair| SignedPrecommit {
+			precommit: precommit.clone(),
+			signature: pair.sign(&payload).into(),
+			id: pair.public().into(),
+		})
+		.collect();
+	sp_consensus_grandpa::GrandpaJustification::<NativeHeader> {
+		round: ROUND,
+		commit: Commit {
+			target_hash: header.hash(),
+			target_number: *header.number(),
+			precommits,
+		},
+		votes_ancestries: Vec::new(),
+	}
+	.into()
+}
+
+fn state_proof(commitment: &BridgeEventCommitmentV1) -> (H256, Vec<Vec<u8>>) {
+	let mut state = BTreeMap::new();
+	state.insert(BRIDGE_COMMITMENT_STORAGE_KEY.to_vec(), commitment.encode());
+	let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+	let root = *backend.root();
+	let proof = prove_read(backend, &[BRIDGE_COMMITMENT_STORAGE_KEY.as_slice()])
+		.expect("the deterministic in-memory state must produce a read proof");
+	(root, proof.into_iter_nodes().collect())
+}
+
+fn hash_hex(value: H256) -> String {
+	bytes_hex(value.as_bytes())
+}
+
+fn bytes_hex(value: &[u8]) -> String {
+	format!("0x{}", hex::encode(value))
+}

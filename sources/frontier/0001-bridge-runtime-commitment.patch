+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct AdmissionStatementV2 {
+	source_intent_id: H256,
+	legacy_mint_identity: H256,
+	source_box_id: H256,
+	source_creation_transaction_id: H256,
+	source_lock_ergo_tree_hash: H256,
+	commitment_transaction_id: H256,
+	vault_box_id: H256,
+	vault_ergo_tree_hash: H256,
+	commitment_inclusion_height: u64,
+	acceptance_checkpoint_height: u64,
+	finality_policy_id: H256,
+	required_confirmations: u32,
+}
+
+/// Validate an exact request and derive only the non-signing V1 result fields.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+) -> Result<PegInCausalSourceProofResultProducerOutputV1, PegInCausalSourceProofResultProducerErrorV1>
+{
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::RequestTooLarge);
+	}
+	let request: PegInCausalSourceProofResultProducerRequestV1 =
+		serde_json::from_slice(raw_request)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Schema);
+	}
+
+	let candidate_id = fixed_hash("candidateIdHex", &request.candidate_id_hex, true)?;
+	let profile_bytes = fixed_wire(
+		"admissionProfileCanonicalHex",
+		&request.admission_profile_canonical_hex,
+		ADMISSION_PROFILE_BYTES,
+	)?;
+	let source_intent_bytes = fixed_wire(
+		"sourceIntentCanonicalHex",
+		&request.source_intent_canonical_hex,
+		SOURCE_INTENT_BYTES,
+	)?;
+	let statement_bytes = fixed_wire(
+		"statementCanonicalHex",
+		&request.statement_canonical_hex,
+		ADMISSION_STATEMENT_BYTES,
+	)?;
+
+	let profile = decode_profile(&profile_bytes)?;
+	let profile_id = domain_hash(ADMISSION_PROFILE_DOMAIN, &profile_bytes);
+	let source_intent = decode_source_intent(&source_intent_bytes)?;
+	let source_intent_id = domain_hash(SOURCE_INTENT_DOMAIN, &source_intent_bytes);
+	let statement = decode_statement(&statement_bytes)?;
+	let admission_id = domain_hash(ADMISSION_DOMAIN, &statement_bytes);
+	validate_bindings(
+		&profile,
+		profile_id,
+		&source_intent,
+		source_intent_id,
+		&statement,
+		admission_id,
+		candidate_id,
+	)?;
+
+	let source_box = bounded_object(
+		"sourceBoxCanonicalHex",
+		&request.source_box_canonical_hex,
+		MAX_CANONICAL_SOURCE_OBJECT_BYTES,
+	)?;
+	let commitment_transaction = bounded_object(
+		"commitmentTransactionCanonicalHex",
+		&request.commitment_transaction_canonical_hex,
+		MAX_CANONICAL_SOURCE_PROOF_BYTES,
+	)?;
+	let vault_successor = bounded_object(
+		"vaultSuccessorCanonicalHex",
+		&request.vault_successor_canonical_hex,
+		MAX_CANONICAL_SOURCE_OBJECT_BYTES,
+	)?;
+	let inclusion_proof = bounded_object(
+		"inclusionProofCanonicalHex",
+		&request.inclusion_proof_canonical_hex,
+		MAX_CANONICAL_SOURCE_PROOF_BYTES,
+	)?;
+	let checkpoint_ancestry = bounded_object(
+		"checkpointAncestryCanonicalHex",
+		&request.checkpoint_ancestry_canonical_hex,
+		MAX_CANONICAL_SOURCE_PROOF_BYTES,
+	)?;
+	let finality_proof = bounded_object(
+		"finalityProofCanonicalHex",
+		&request.finality_proof_canonical_hex,
+		MAX_CANONICAL_SOURCE_PROOF_BYTES,
+	)?;
+	let verifier_executable = fixed_hash(
+		"verifierExecutableSha256Hex",
+		&request.verifier_executable_sha256_hex,
+		true,
+	)?;
+
+	let issued_at_native_height =
+		parse_decimal_u64("issuedAtNativeHeight", &request.issued_at_native_height)?;
+	let expires_at_native_height =
+		parse_decimal_u64("expiresAtNativeHeight", &request.expires_at_native_height)?;
+	let Some(validity_blocks) = expires_at_native_height.checked_sub(issued_at_native_height)
+	else {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::ValidityWindow);
+	};
+	if validity_blocks == 0 || validity_blocks > MAX_VALIDITY_BLOCKS {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::ValidityWindow);
+	}
+
+	let mut request_preimage = Vec::with_capacity(
+		SOURCE_PROOF_REQUEST_DOMAIN.len() + 32 + source_intent_bytes.len() + statement_bytes.len(),
+	);
+	request_preimage.extend_from_slice(SOURCE_PROOF_REQUEST_DOMAIN);
+	request_preimage.extend_from_slice(profile_id.as_bytes());
+	request_preimage.extend_from_slice(&source_intent_bytes);
+	request_preimage.extend_from_slice(&statement_bytes);
+	let request_digest = H256::from(blake2_256(&request_preimage));
+
+	Ok(PegInCausalSourceProofResultProducerOutputV1 {
+		schema: RESULT_SCHEMA.to_owned(),
+		status: RESULT_STATUS.to_owned(),
+		request_digest_hex: format_hash(request_digest),
+		result: PegInCausalSourceProofResultFieldsV1 {
+			format_version: SOURCE_PROOF_RESULT_FORMAT_VERSION,
+			request_digest_hex: format_hash(request_digest),
+			source_box_canonical_blake2b256_hex: hash_bytes(&source_box),
+			commitment_transaction_canonical_blake2b256_hex: hash_bytes(&commitment_transaction),
+			vault_successor_canonical_blake2b256_hex: hash_bytes(&vault_successor),
+			inclusion_proof_blake2b256_hex: hash_bytes(&inclusion_proof),
+			checkpoint_ancestry_blake2b256_hex: hash_bytes(&checkpoint_ancestry),
+			finality_proof_blake2b256_hex: hash_bytes(&finality_proof),
+			verifier_executable_sha256_hex: format_hash(verifier_executable),
+			verifier_profile_id_hex: format_hash(static_hash(VERIFIER_PROFILE_ID_HEX)),
+			issued_at_native_height: issued_at_native_height.to_string(),
+			expires_at_native_height: expires_at_native_height.to_string(),
+		},
+		boundary: PegInCausalSourceProofResultBoundaryV1 {
+			admission_bindings_validated: true,
+			canonical_objects_hashed: true,
+			source_canonicality_verified: false,
+			source_proof_execution_authenticated: false,
+			signatures_produced: false,
+			signing_authorized: false,
+			runtime_admission_written: false,
+			lifecycle_advanced: false,
+			mint_authorized: false,
+			reconciliation_hold_release_authorized: false,
+			submission_authorized: false,
+			broadcast_authorized: false,
+			gate5_closed: false,
+			production_ready: false,
+		},
+	})
+}
+
+fn decode_profile(
+	bytes: &[u8],
+) -> Result<AdmissionProfileV2, PegInCausalSourceProofResultProducerErrorV1> {
+	require_version(bytes, "admission profile")?;
+	let profile = AdmissionProfileV2 {
+		source_network_id: h256(bytes, 1),
+		sidechain_id: h256(bytes, 33),
+		bridge_address: h160(bytes, 65),
+		token_address: h160(bytes, 85),
+		settlement_profile_id: h256(bytes, 105),
+		source_lock_ergo_tree_hash: h256(bytes, 137),
+		vault_ergo_tree_hash: h256(bytes, 169),
+		finality_policy_id: h256(bytes, 201),
+		proof_system_id: h256(bytes, 233),
+		proof_profile_id: h256(bytes, 265),
+	};
+	if profile.source_network_id == H256::zero()
+		|| profile.sidechain_id == H256::zero()
+		|| profile.bridge_address == H160::zero()
+		|| profile.token_address == H160::zero()
+		|| profile.bridge_address == profile.token_address
+		|| profile.settlement_profile_id == H256::zero()
+		|| profile.source_lock_ergo_tree_hash == H256::zero()
+		|| profile.vault_ergo_tree_hash == H256::zero()
+		|| profile.finality_policy_id == H256::zero()
+		|| profile.proof_system_id == H256::zero()
+		|| profile.proof_profile_id == H256::zero()
+		|| u64_at(bytes, 297) == 0
+	{
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"profile contains a zero or aliased identity",
+		));
+	}
+	Ok(profile)
+}
+
+fn decode_source_intent(
+	bytes: &[u8],
+) -> Result<SourceIntentV2, PegInCausalSourceProofResultProducerErrorV1> {
+	require_version(bytes, "source intent")?;
+	let intent = SourceIntentV2 {
+		source_network_id: h256(bytes, 1),
+		sidechain_id: h256(bytes, 33),
+		bridge_address: h160(bytes, 65),
+		token_address: h160(bytes, 85),
+		settlement_profile_id: h256(bytes, 105),
+		admission_profile_id: h256(bytes, 137),
+		source_asset_id: h256(bytes, 169),
+		amount: u64_at(bytes, 201),
+	};
+	if intent.source_network_id == H256::zero()
+		|| intent.sidechain_id == H256::zero()
+		|| intent.bridge_address == H160::zero()
+		|| intent.token_address == H160::zero()
+		|| intent.bridge_address == intent.token_address
+		|| intent.settlement_profile_id == H256::zero()
+		|| intent.admission_profile_id == H256::zero()
+		|| intent.source_asset_id != H256::zero()
+		|| intent.amount == 0
+		|| intent.amount > i64::MAX as u64
+		|| h160(bytes, 209) == H160::zero()
+	{
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"source intent contains an unsupported Ergo settlement field",
+		));
+	}
+	Ok(intent)
+}
+
+fn decode_statement(
+	bytes: &[u8],
+) -> Result<AdmissionStatementV2, PegInCausalSourceProofResultProducerErrorV1> {
+	require_version(bytes, "admission statement")?;
+	let statement = AdmissionStatementV2 {
+		source_intent_id: h256(bytes, 1),
+		legacy_mint_identity: h256(bytes, 33),
+		source_box_id: h256(bytes, 65),
+		source_creation_transaction_id: h256(bytes, 97),
+		source_lock_ergo_tree_hash: h256(bytes, 133),
+		commitment_transaction_id: h256(bytes, 165),
+		vault_box_id: h256(bytes, 201),
+		vault_ergo_tree_hash: h256(bytes, 233),
+		commitment_inclusion_height: u64_at(bytes, 297),
+		acceptance_checkpoint_height: u64_at(bytes, 337),
+		finality_policy_id: h256(bytes, 345),
+		required_confirmations: u32_at(bytes, 377),
+	};
+	for (value, label) in [
+		(statement.source_intent_id, "statement source intent ID"),
+		(statement.legacy_mint_identity, "legacy mint identity"),
+		(statement.source_box_id, "source box ID"),
+		(
+			statement.source_creation_transaction_id,
+			"source creation transaction ID",
+		),
+		(
+			statement.source_lock_ergo_tree_hash,
+			"source-lock ErgoTree hash",
+		),
+		(
+			statement.commitment_transaction_id,
+			"commitment transaction ID",
+		),
+		(statement.vault_box_id, "vault box ID"),
+		(statement.vault_ergo_tree_hash, "vault ErgoTree hash"),
+		(h256(bytes, 265), "commitment inclusion block ID"),
+		(h256(bytes, 305), "acceptance checkpoint block ID"),
+		(statement.finality_policy_id, "statement finality policy ID"),
+	] {
+		if value == H256::zero() {
+			return Err(PegInCausalSourceProofResultProducerErrorV1::Zero(label));
+		}
+	}
+	if statement.required_confirmations == 0 {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"required confirmations must be positive",
+		));
+	}
+	if statement.source_creation_transaction_id == statement.commitment_transaction_id
+		|| statement.source_box_id == statement.vault_box_id
+	{
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"source and commitment identities must be distinct",
+		));
+	}
+	let Some(observed_depth) = statement
+		.acceptance_checkpoint_height
+		.checked_sub(statement.commitment_inclusion_height)
+		.and_then(|delta| delta.checked_add(1))
+	else {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"checkpoint precedes commitment inclusion",
+		));
+	};
+	if observed_depth < u64::from(statement.required_confirmations) {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"checkpoint does not satisfy required confirmations",
+		));
+	}
+	Ok(statement)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn validate_bindings(
+	profile: &AdmissionProfileV2,
+	profile_id: H256,
+	intent: &SourceIntentV2,
+	intent_id: H256,
+	statement: &AdmissionStatementV2,
+	admission_id: H256,
+	candidate_id: H256,
+) -> Result<(), PegInCausalSourceProofResultProducerErrorV1> {
+	if profile.finality_policy_id != static_hash(FINALITY_POLICY_ID_HEX)
+		|| profile.proof_system_id != static_hash(PROOF_SYSTEM_ID_HEX)
+		|| profile.proof_profile_id != static_hash(PROOF_PROFILE_ID_HEX)
+	{
+		return Err(PegInCausalSourceProofResultProducerErrorV1::StaticProfile(
+			"profile identities do not select the exact V1 federated compatibility profile",
+		));
+	}
+	if intent.source_network_id != profile.source_network_id
+		|| intent.sidechain_id != profile.sidechain_id
+		|| intent.bridge_address != profile.bridge_address
+		|| intent.token_address != profile.token_address
+		|| intent.settlement_profile_id != profile.settlement_profile_id
+		|| intent.admission_profile_id != profile_id
+	{
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"source intent does not match the exact profile",
+		));
+	}
+	if statement.source_intent_id != intent_id
+		|| statement.source_lock_ergo_tree_hash != profile.source_lock_ergo_tree_hash
+		|| statement.vault_ergo_tree_hash != profile.vault_ergo_tree_hash
+		|| statement.finality_policy_id != profile.finality_policy_id
+	{
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"statement does not match its profile and source intent",
+		));
+	}
+	let mut legacy_preimage = Vec::with_capacity(LEGACY_MINT_IDENTITY_DOMAIN.len() + 64);
+	legacy_preimage.extend_from_slice(LEGACY_MINT_IDENTITY_DOMAIN);
+	legacy_preimage.extend_from_slice(intent.sidechain_id.as_bytes());
+	legacy_preimage.extend_from_slice(statement.source_box_id.as_bytes());
+	if statement.legacy_mint_identity != H256::from(blake2_256(&legacy_preimage)) {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"statement does not preserve the V1 mint identity",
+		));
+	}
+	if statement.required_confirmations != REQUIRED_CONFIRMATIONS {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::StaticProfile(
+			"required confirmations are not exactly 10",
+		));
+	}
+	if candidate_id != admission_id {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			"candidate identity does not equal the admission identity",
+		));
+	}
+	Ok(())
+}
+
+fn fixed_wire(
+	field: &'static str,
+	value: &str,
+	expected: usize,
+) -> Result<Vec<u8>, PegInCausalSourceProofResultProducerErrorV1> {
+	let bytes = parse_byte_hex(field, value, expected)?;
+	if bytes.len() != expected {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::FixedLength { field, expected });
+	}
+	Ok(bytes)
+}
+
+fn bounded_object(
+	field: &'static str,
+	value: &str,
+	max_bytes: usize,
+) -> Result<Vec<u8>, PegInCausalSourceProofResultProducerErrorV1> {
+	Ok(parse_byte_hex(field, value, max_bytes)?)
+}
+
+fn fixed_hash(
+	field: &'static str,
+	value: &str,
+	nonzero: bool,
+) -> Result<H256, PegInCausalSourceProofResultProducerErrorV1> {
+	let bytes = fixed_wire(field, value, 32)?;
+	let hash = H256::from_slice(&bytes);
+	if nonzero && hash == H256::zero() {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Zero(field));
+	}
+	Ok(hash)
+}
+
+fn require_version(
+	bytes: &[u8],
+	label: &'static str,
+) -> Result<(), PegInCausalSourceProofResultProducerErrorV1> {
+	if bytes[0] != ADMISSION_FORMAT_VERSION {
+		return Err(PegInCausalSourceProofResultProducerErrorV1::Admission(
+			label,
+		));
+	}
+	Ok(())
+}
+
+fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+	let mut preimage = Vec::with_capacity(domain.len() + bytes.len());
+	preimage.extend_from_slice(domain);
+	preimage.extend_from_slice(bytes);
+	H256::from(blake2_256(&preimage))
+}
+
+fn hash_bytes(bytes: &[u8]) -> String {
+	format_hash(H256::from(blake2_256(bytes)))
+}
+
+fn static_hash(value: &str) -> H256 {
+	let bytes = hex::decode(value).expect("static 32-byte lowercase hex identity");
+	H256::from_slice(&bytes)
+}
+
+fn h160(bytes: &[u8], offset: usize) -> H160 {
+	H160::from_slice(&bytes[offset..offset + 20])
+}
+
+fn h256(bytes: &[u8], offset: usize) -> H256 {
+	H256::from_slice(&bytes[offset..offset + 32])
+}
+
+fn u32_at(bytes: &[u8], offset: usize) -> u32 {
+	u32::from_be_bytes(
+		bytes[offset..offset + 4]
+			.try_into()
+			.expect("fixed checked wire"),
+	)
+}
+
+fn u64_at(bytes: &[u8], offset: usize) -> u64 {
+	u64::from_be_bytes(
+		bytes[offset..offset + 8]
+			.try_into()
+			.expect("fixed checked wire"),
+	)
+}

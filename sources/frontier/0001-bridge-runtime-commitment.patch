+		assert_eq!(
+			verify_witness(&input_identity_drift),
+			Err("Ergo Scorex refundable source input binding is invalid")
+		);
+	}
+
+	#[test]
+	fn isolates_vault_register_and_output_body_failures() {
+		let canonical = golden_witness();
+		let ranges = section_ranges(&canonical);
+		let profile = parse_profile_v1::<InitialErgoNativeCompatibilityParserProfileV1>(
+			&canonical[ranges[0].0..ranges[0].1],
+		)
+		.unwrap();
+		let transaction =
+			parse_transaction_v1(&canonical[ranges[1].0..ranges[1].1], &profile).unwrap();
+		let source = parse_source_box_v1(&canonical[ranges[3].0..ranges[3].1], &profile).unwrap();
+		for (register_index, offset) in [(0usize, 2usize), (1, 2), (2, 4), (3, 2)] {
+			let mut owned: Vec<Vec<u8>> = transaction.outputs[0]
+				.registers
+				.iter()
+				.map(|value| value.to_vec())
+				.collect();
+			owned[register_index][offset] ^= 1;
+			let borrowed: Vec<&[u8]> = owned.iter().map(Vec::as_slice).collect();
+			assert_eq!(
+				parse_vault_registers_v1(&borrowed, &source),
+				Err("Ergo Scorex vault registers do not bind the refundable source")
+			);
+		}
+
+		let exact_tree = vec![0u8; 4_092];
+		let exact = OutputV1 {
+			value_nano_erg: 1,
+			ergo_tree: &exact_tree,
+			creation_height: 0,
+			registers: Vec::new(),
+		};
+		assert_eq!(
+			serialize_output_v1(&exact).unwrap().len(),
+			MAX_OUTPUT_BYTES_V1
+		);
+		let oversized_tree = vec![0u8; 4_093];
+		let oversized = OutputV1 {
+			ergo_tree: &oversized_tree,
+			..exact
+		};
+		assert_eq!(
+			serialize_output_v1(&oversized),
+			Err("Ergo Scorex output body exceeds its bound")
+		);
+	}
+}
diff --git a/template/runtime/src/peg_in_ergo_utxo_state_runtime_witness.rs b/template/runtime/src/peg_in_ergo_utxo_state_runtime_witness.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c870a00533acd7224d7316761d2a3d3c578e0c4a
--- /dev/null
+++ b/template/runtime/src/peg_in_ergo_utxo_state_runtime_witness.rs
@@ -0,0 +1,630 @@
+use alloc::{boxed::Box, vec::Vec};
+
+use bytes::Bytes;
+use ergo_avltree_rust::{
+	authenticated_tree_ops::AuthenticatedTreeOps,
+	batch_avl_verifier::BatchAVLVerifier,
+	batch_node::{AVLTree, Node, NodeHeader},
+	operation::{Digest32, Operation},
+};
+use sp_core::{
+	hashing::{blake2_256, sha2_256},
+	H256,
+};
+
+pub const ERGO_UTXO_STATE_RUNTIME_WITNESS_FORMAT_V1: u8 = 1;
+
+const MAGIC_V1: &[u8; 8] = b"E2UTXW01";
+const FAMILY_DOMAIN_V1: &[u8] = b"E2S_ERGO_UTXO_STATE_RUNTIME_WITNESS_FAMILY_V1";
+const WITNESS_ID_DOMAIN_V1: &[u8] = b"E2S_ERGO_UTXO_STATE_RUNTIME_WITNESS_ID_V1";
+const VERIFIER_PROFILE_DOMAIN_V1: &[u8] = b"E2S_ERGO_UTXO_STATE_RUNTIME_VERIFIER_PROFILE_V1";
+const SECTION_COUNT_V1: usize = 2;
+const ENVELOPE_HEADER_BYTES_V1: usize = 60;
+const BINDING_SECTION_V1: u8 = 1;
+const PROOF_SECTION_V1: u8 = 2;
+const DIGEST_BYTES_V1: usize = 32;
+const STATE_ROOT_BYTES_V1: usize = 33;
+const KEY_BYTES_V1: usize = 32;
+const MAX_VALUE_BYTES_V1: usize = 4 * 1024;
+const MAX_PROOF_BYTES_V1: usize = 16 * 1024;
+const MAX_WITNESS_BYTES_V1: usize =
+	ENVELOPE_HEADER_BYTES_V1 + 137 + MAX_VALUE_BYTES_V1 + MAX_PROOF_BYTES_V1;
+const OPERATION_COUNT_V1: u8 = 2;
+const MEMBERSHIP_OPERATION_V1: u8 = 1;
+const NON_MEMBERSHIP_OPERATION_V1: u8 = 2;
+const LEAF_TAG_V1: u8 = 2;
+const LABEL_TAG_V1: u8 = 3;
+const END_TAG_V1: u8 = 4;
+
+#[derive(Clone, Eq, PartialEq, Debug)]
+pub struct VerifiedErgoUtxoStateRuntimeWitnessV1 {
+	pub witness_id: H256,
+	pub verifier_profile_id: H256,
+	pub state_root: [u8; STATE_ROOT_BYTES_V1],
+	pub vault_box_id: H256,
+	pub refundable_source_box_id: H256,
+	pub expected_vault_box: Vec<u8>,
+	pub expected_vault_box_sha256: H256,
+	pub proof: Vec<u8>,
+	pub proof_sha256: H256,
+}
+
+struct ParsedWitnessV1 {
+	state_root: [u8; STATE_ROOT_BYTES_V1],
+	vault_box_id: [u8; KEY_BYTES_V1],
+	refundable_source_box_id: [u8; KEY_BYTES_V1],
+	expected_vault_box: Vec<u8>,
+	proof: Vec<u8>,
+}
+
+struct FramedNodeV1 {
+	kind: FramedNodeKindV1,
+	label: [u8; DIGEST_BYTES_V1],
+	depth: usize,
+}
+
+enum FramedNodeKindV1 {
+	Label,
+	Leaf {
+		key: [u8; KEY_BYTES_V1],
+		next_key: [u8; KEY_BYTES_V1],
+		value: Vec<u8>,
+	},
+	Internal {
+		left: Box<FramedNodeV1>,
+		right: Box<FramedNodeV1>,
+	},
+}
+
+pub fn ergo_utxo_state_runtime_witness_family_id_v1() -> H256 {
+	H256::from(blake2_256(FAMILY_DOMAIN_V1))
+}
+
+pub fn ergo_utxo_state_runtime_verifier_profile_id_v1() -> H256 {
+	H256::from(blake2_256(VERIFIER_PROFILE_DOMAIN_V1))
+}
+
+pub fn derive_ergo_utxo_state_runtime_witness_id_v1(
+	witness_bytes: &[u8],
+) -> Result<H256, &'static str> {
+	if witness_bytes.len() < ENVELOPE_HEADER_BYTES_V1
+		|| witness_bytes.len() > MAX_WITNESS_BYTES_V1
+	{
+		return Err("Ergo UTXO runtime witness length is outside its bound");
+	}
+	let mut bytes = Vec::with_capacity(WITNESS_ID_DOMAIN_V1.len() + witness_bytes.len());
+	bytes.extend_from_slice(WITNESS_ID_DOMAIN_V1);
+	bytes.extend_from_slice(witness_bytes);
+	Ok(H256::from(blake2_256(&bytes)))
+}
+
+pub fn verify_ergo_utxo_state_runtime_witness_v1(
+	witness_bytes: &[u8],
+) -> Result<VerifiedErgoUtxoStateRuntimeWitnessV1, &'static str> {
+	let parsed = parse_ergo_utxo_state_runtime_witness_v1(witness_bytes)?;
+	validate_proof_framing_and_bindings_v1(&parsed)?;
+	replay_ergo_utxo_state_lookups_v1(&parsed)?;
+	Ok(VerifiedErgoUtxoStateRuntimeWitnessV1 {
+		witness_id: derive_ergo_utxo_state_runtime_witness_id_v1(witness_bytes)?,
+		verifier_profile_id: ergo_utxo_state_runtime_verifier_profile_id_v1(),
+		state_root: parsed.state_root,
+		vault_box_id: H256::from(parsed.vault_box_id),
+		refundable_source_box_id: H256::from(parsed.refundable_source_box_id),
+		expected_vault_box_sha256: H256::from(sha2_256(&parsed.expected_vault_box)),
+		proof_sha256: H256::from(sha2_256(&parsed.proof)),
+		expected_vault_box: parsed.expected_vault_box,
+		proof: parsed.proof,
+	})
+}
+
+fn parse_ergo_utxo_state_runtime_witness_v1(
+	witness_bytes: &[u8],
+) -> Result<ParsedWitnessV1, &'static str> {
+	if witness_bytes.len() < ENVELOPE_HEADER_BYTES_V1
+		|| witness_bytes.len() > MAX_WITNESS_BYTES_V1
+	{
+		return Err("Ergo UTXO runtime witness length is outside its bound");
+	}
+	let mut envelope = CursorV1::new(witness_bytes);
+	if envelope.take(8)? != MAGIC_V1 {
+		return Err("Ergo UTXO runtime witness magic is unsupported");
+	}
+	if envelope.u8()? != ERGO_UTXO_STATE_RUNTIME_WITNESS_FORMAT_V1 {
+		return Err("Ergo UTXO runtime witness format is unsupported");
+	}
+	if envelope.u8()? != 0 || envelope.u16()? as usize != SECTION_COUNT_V1 {
+		return Err("Ergo UTXO runtime witness envelope shape is unsupported");
+	}
+	if envelope.u32()? as usize != witness_bytes.len() {
+		return Err("Ergo UTXO runtime witness total length is inconsistent");
+	}
+	if H256::from(envelope.array::<DIGEST_BYTES_V1>()?)
+		!= ergo_utxo_state_runtime_witness_family_id_v1()
+	{
+		return Err("Ergo UTXO runtime witness format-family ID is unsupported");
+	}
+	let binding_length = section_length_v1(&mut envelope, BINDING_SECTION_V1)?;
+	let proof_length = section_length_v1(&mut envelope, PROOF_SECTION_V1)?;
+	if binding_length
+		.checked_add(proof_length)
+		.ok_or("Ergo UTXO runtime witness section lengths overflow")?
+		!= witness_bytes.len() - ENVELOPE_HEADER_BYTES_V1
+	{
+		return Err("Ergo UTXO runtime witness section lengths are inconsistent");
+	}
+	let mut binding = CursorV1::new(envelope.take(binding_length)?);
+	if H256::from(binding.array::<DIGEST_BYTES_V1>()?)
+		!= ergo_utxo_state_runtime_verifier_profile_id_v1()
+	{
+		return Err("Ergo UTXO runtime verifier profile is not statically registered");
+	}
+	let state_root = binding.array::<STATE_ROOT_BYTES_V1>()?;
+	if binding.u8()? != KEY_BYTES_V1 as u8
+		|| binding.u8()? != OPERATION_COUNT_V1
+		|| binding.u8()? != MEMBERSHIP_OPERATION_V1
+		|| binding.u8()? != NON_MEMBERSHIP_OPERATION_V1
+	{
+		return Err("Ergo UTXO runtime lookup profile is unsupported");
+	}
+	let vault_box_id = binding.array::<KEY_BYTES_V1>()?;
+	let refundable_source_box_id = binding.array::<KEY_BYTES_V1>()?;
+	let value_length = binding.u32()? as usize;
+	if value_length == 0 || value_length > MAX_VALUE_BYTES_V1 {
+		return Err("Ergo UTXO runtime expected vault box length is outside its bound");
+	}
+	let expected_vault_box = binding.take(value_length)?.to_vec();
+	binding.end("Ergo UTXO runtime binding section contains trailing bytes")?;
+	if proof_length == 0 || proof_length > MAX_PROOF_BYTES_V1 {
+		return Err("Ergo UTXO runtime proof length is outside its bound");
+	}
+	let proof = envelope.take(proof_length)?.to_vec();
+	envelope.end("Ergo UTXO runtime witness contains trailing bytes")?;
+	Ok(ParsedWitnessV1 {
+		state_root,
+		vault_box_id,
+		refundable_source_box_id,
+		expected_vault_box,
+		proof,
+	})
+}
+
+fn validate_proof_framing_and_bindings_v1(
+	witness: &ParsedWitnessV1,
+) -> Result<(), &'static str> {
+	if witness.vault_box_id == witness.refundable_source_box_id {
+		return Err("Ergo UTXO runtime lookup keys must be distinct");
+	}
+	for key in [&witness.vault_box_id, &witness.refundable_source_box_id] {
+		if key.iter().all(|value| *value == 0) || key.iter().all(|value| *value == 0xff) {
+			return Err("Ergo UTXO runtime lookup key is outside the AVL key domain");
+		}
+	}
+	if blake2_256(&witness.expected_vault_box) != witness.vault_box_id {
+		return Err("Ergo UTXO runtime vault bytes do not derive the vault box ID");
+	}
+	let (root, direction_start) =
+		parse_proof_tree_v1(&witness.proof, witness.state_root[STATE_ROOT_BYTES_V1 - 1])?;
+	if root.label != witness.state_root[..DIGEST_BYTES_V1] {
+		return Err("Ergo UTXO runtime proof root disagrees with the state root");
+	}
+	let direction_bit = consume_lookup_v1(
+		&root,
+		&witness.vault_box_id,
+		Some(&witness.expected_vault_box),
+		&witness.proof,
+		direction_start,
+		0,
+	)?;
+	let direction_bit = consume_lookup_v1(
+		&root,
+		&witness.refundable_source_box_id,
+		None,
+		&witness.proof,
+		direction_start,
+		direction_bit,
+	)?;
+	let direction_bytes = direction_bit.div_ceil(8);
+	if witness.proof.len() != direction_start + direction_bytes {
+		return Err("Ergo UTXO runtime proof contains unused direction bytes");
+	}
+	let used_bits = direction_bit % 8;
+	if used_bits != 0 && direction_bytes != 0 {
+		let used_mask = (1u8 << used_bits) - 1;
+		if witness.proof[witness.proof.len() - 1] & !used_mask != 0 {
+			return Err("Ergo UTXO runtime proof contains nonzero direction padding");
+		}
+	}
+	Ok(())
+}
+
+fn parse_proof_tree_v1(
+	proof: &[u8],
+	declared_height: u8,
+) -> Result<(FramedNodeV1, usize), &'static str> {
+	let mut stack: Vec<FramedNodeV1> = Vec::new();
+	let mut offset = 0usize;
+	let mut nodes = 0usize;
+	let mut previous_leaf_next_key: Option<[u8; KEY_BYTES_V1]> = None;
+	let maximum_nodes = 4usize
+		.checked_mul(declared_height as usize)
+		.and_then(|value| value.checked_add(3))
+		.ok_or("Ergo UTXO runtime proof node bound overflows")?;
+	loop {
+		let tag = *proof
+			.get(offset)
+			.ok_or("Ergo UTXO runtime proof is truncated before its tree terminator")?;
+		offset += 1;
+		if tag == END_TAG_V1 {
+			break;
+		}
+		nodes += 1;
+		if nodes > maximum_nodes {
+			return Err("Ergo UTXO runtime proof tree exceeds its operation bound");
+		}
+		if tag == LABEL_TAG_V1 {
+			let (label, next) = array_at_v1::<DIGEST_BYTES_V1>(proof, offset)?;
+			offset = next;
+			stack.push(FramedNodeV1 {
+				kind: FramedNodeKindV1::Label,
+				label,
+				depth: 0,
+			});
+			previous_leaf_next_key = None;
+			continue;
+		}
+		if tag == LEAF_TAG_V1 {
+			let key = if let Some(previous) = previous_leaf_next_key {
+				previous
+			} else {
+				let (value, next) = array_at_v1::<KEY_BYTES_V1>(proof, offset)?;
+				offset = next;
+				value
+			};
+			let (next_key, next) = array_at_v1::<KEY_BYTES_V1>(proof, offset)?;
+			offset = next;
+			let (length_bytes, next) = array_at_v1::<4>(proof, offset)?;
+			offset = next;
+			let value_length = u32::from_be_bytes(length_bytes) as usize;
+			if value_length == 0 || value_length > MAX_VALUE_BYTES_V1 {
+				return Err("Ergo UTXO runtime proof leaf value length is outside its bound");
+			}
+			let end = offset
+				.checked_add(value_length)
+				.ok_or("Ergo UTXO runtime proof leaf value length overflows")?;
+			let value = proof
+				.get(offset..end)
+				.ok_or("Ergo UTXO runtime proof is truncated in a leaf value")?
+				.to_vec();
+			offset = end;
+			if key >= next_key {
+				return Err("Ergo UTXO runtime proof leaf key interval is invalid");
+			}
+			let mut preimage = Vec::with_capacity(1 + KEY_BYTES_V1 * 2 + value.len());
+			preimage.push(0);
+			preimage.extend_from_slice(&key);
+			preimage.extend_from_slice(&value);
+			preimage.extend_from_slice(&next_key);
+			stack.push(FramedNodeV1 {
+				kind: FramedNodeKindV1::Leaf {
+					key,
+					next_key,
+					value,
+				},
+				label: blake2_256(&preimage),
+				depth: 0,
+			});
+			previous_leaf_next_key = Some(next_key);
+			continue;
+		}
+		if !matches!(tag, 0 | 1 | 0xff) {
+			return Err("Ergo UTXO runtime proof contains an invalid internal balance");
+		}
+		let right = stack
+			.pop()
+			.ok_or("Ergo UTXO runtime proof internal node underflows its stack")?;
+		let left = stack
+			.pop()
+			.ok_or("Ergo UTXO runtime proof internal node underflows its stack")?;
+		let depth = 1usize
+			.checked_add(core::cmp::max(left.depth, right.depth))
+			.ok_or("Ergo UTXO runtime proof depth overflows")?;
+		let mut preimage = Vec::with_capacity(66);
+		preimage.extend_from_slice(&[1, tag]);
+		preimage.extend_from_slice(&left.label);
+		preimage.extend_from_slice(&right.label);
+		stack.push(FramedNodeV1 {
+			kind: FramedNodeKindV1::Internal {
+				left: Box::new(left),
+				right: Box::new(right),
+			},
+			label: blake2_256(&preimage),
+			depth,
+		});
+	}
+	if stack.len() != 1 {
+		return Err("Ergo UTXO runtime proof tree does not contain one root");
+	}
+	let root = stack
+		.pop()
+		.ok_or("Ergo UTXO runtime proof tree has no root")?;
+	if root.depth > declared_height as usize {
+		return Err("Ergo UTXO runtime proof exceeds the declared tree height");
+	}
+	Ok((root, offset))
+}
+
+fn consume_lookup_v1(
+	root: &FramedNodeV1,
+	key: &[u8; KEY_BYTES_V1],
+	expected_value: Option<&[u8]>,
+	proof: &[u8],
+	direction_start: usize,
+	initial_direction_bit: usize,
+) -> Result<usize, &'static str> {
+	let mut node = root;
+	let mut direction_bit = initial_direction_bit;
+	loop {
+		match &node.kind {
+			FramedNodeKindV1::Internal { left, right } => {
+				let byte_offset = direction_start
+					.checked_add(direction_bit / 8)
+					.ok_or("Ergo UTXO runtime proof direction offset overflows")?;
+				let direction = *proof
+					.get(byte_offset)
+					.ok_or("Ergo UTXO runtime proof direction bits are truncated")?;
+				let left_selected = direction & (1 << (direction_bit % 8)) != 0;
+				direction_bit += 1;
+				node = if left_selected { left } else { right };
+			},
+			FramedNodeKindV1::Label => {
+				return Err("Ergo UTXO runtime lookup terminates at an unresolved label");
+			},
+			FramedNodeKindV1::Leaf {
+				key: leaf_key,
+				next_key,
+				value,
+			} => {
+				if let Some(expected) = expected_value {
+					if key != leaf_key || value.as_slice() != expected {
+						return Err("Ergo UTXO runtime vault membership proof is invalid");
+					}
+				} else if !(key > leaf_key && key < next_key) {
+					return Err(
+						"Ergo UTXO runtime refundable source non-membership proof is invalid",
+					);
+				}
+				return Ok(direction_bit);
+			},
+		}
+	}
+}
+
+fn replay_ergo_utxo_state_lookups_v1(
+	witness: &ParsedWitnessV1,
+) -> Result<(), &'static str> {
+	let state_root = Bytes::copy_from_slice(&witness.state_root);
+	let proof = Bytes::copy_from_slice(&witness.proof);
+	let mut verifier = BatchAVLVerifier::new(
+		&state_root,
+		&proof,
+		AVLTree::new(label_only_resolver_v1, KEY_BYTES_V1, None),
+		Some(OPERATION_COUNT_V1 as usize),
+		Some(0),
+	)
+	.map_err(|_| "Ergo UTXO runtime proof reconstruction failed")?;
+	let observed_vault = verifier
+		.perform_one_operation(&Operation::Lookup(Bytes::copy_from_slice(
+			&witness.vault_box_id,
+		)))
+		.map_err(|_| "Ergo UTXO runtime vault membership replay failed")?
+		.ok_or("Ergo UTXO runtime vault membership replay returned non-membership")?;
+	if observed_vault.as_ref() != witness.expected_vault_box.as_slice() {
+		return Err("Ergo UTXO runtime vault membership replay returned different bytes");
+	}
+	if verifier
+		.perform_one_operation(&Operation::Lookup(Bytes::copy_from_slice(
+			&witness.refundable_source_box_id,
+		)))
+		.map_err(|_| "Ergo UTXO runtime source non-membership replay failed")?
+		.is_some()
+	{
+		return Err("Ergo UTXO runtime source non-membership replay returned membership");
+	}
+	let digest = verifier
+		.digest()
+		.ok_or("Ergo UTXO runtime replay produced no digest")?;
+	if digest.as_ref() != witness.state_root {
+		return Err("Ergo UTXO runtime lookups changed the supplied state root");
+	}
+	Ok(())
+}
+
+fn label_only_resolver_v1(digest: &Digest32) -> Node {
+	Node::LabelOnly(NodeHeader::new(Some(*digest), None))
+}
+
+fn section_length_v1(
+	cursor: &mut CursorV1<'_>,
+	expected_id: u8,
+) -> Result<usize, &'static str> {
+	if cursor.u8()? != expected_id || cursor.u8()? != 0 {
+		return Err("Ergo UTXO runtime witness section directory is unsupported");
+	}
+	Ok(cursor.u32()? as usize)
+}
+
+fn array_at_v1<const N: usize>(
+	bytes: &[u8],
+	offset: usize,
+) -> Result<([u8; N], usize), &'static str> {
+	let end = offset
+		.checked_add(N)
+		.ok_or("Ergo UTXO runtime proof offset overflows")?;
+	let value = bytes
+		.get(offset..end)
+		.ok_or("Ergo UTXO runtime proof is truncated")?;
+	Ok((
+		value
+			.try_into()
+			.map_err(|_| "Ergo UTXO runtime proof array length is invalid")?,
+		end,
+	))
+}
+
+struct CursorV1<'a> {
+	bytes: &'a [u8],
+	offset: usize,
+}
+
+impl<'a> CursorV1<'a> {
+	fn new(bytes: &'a [u8]) -> Self {
+		Self { bytes, offset: 0 }
+	}
+
+	fn take(&mut self, length: usize) -> Result<&'a [u8], &'static str> {
+		let end = self
+			.offset
+			.checked_add(length)
+			.ok_or("Ergo UTXO runtime witness cursor overflows")?;
+		let value = self
+			.bytes
+			.get(self.offset..end)
+			.ok_or("Ergo UTXO runtime witness is truncated")?;
+		self.offset = end;
+		Ok(value)
+	}
+
+	fn array<const N: usize>(&mut self) -> Result<[u8; N], &'static str> {
+		self.take(N)?
+			.try_into()
+			.map_err(|_| "Ergo UTXO runtime witness array length is invalid")
+	}
+
+	fn u8(&mut self) -> Result<u8, &'static str> {
+		Ok(self.take(1)?[0])
+	}
+
+	fn u16(&mut self) -> Result<u16, &'static str> {
+		Ok(u16::from_be_bytes(self.array::<2>()?))
+	}
+
+	fn u32(&mut self) -> Result<u32, &'static str> {
+		Ok(u32::from_be_bytes(self.array::<4>()?))
+	}
+
+	fn end(&self, message: &'static str) -> Result<(), &'static str> {
+		if self.offset != self.bytes.len() {
+			return Err(message);
+		}
+		Ok(())
+	}
+}

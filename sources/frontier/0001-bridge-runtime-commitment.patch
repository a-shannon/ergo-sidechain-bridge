+const STATEMENT_ID_DOMAIN: &[u8] = b"E2S_POOLED_RESERVE_MINT_RESERVATION_V4";
+const PROFILE_ID_DOMAIN: &[u8] = b"E2S_POOLED_RESERVE_MINT_RESERVATION_PROFILE_V4";
+const SOURCE_INTENT_ID_DOMAIN: &[u8] = b"E2S_PEG_IN_SOURCE_INTENT_V2";

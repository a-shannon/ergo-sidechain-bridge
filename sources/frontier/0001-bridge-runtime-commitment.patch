+pub struct RejectedErgoAutolykosCommittedVaultRuntimeStatementConsumerV2;
+
+impl ErgoAutolykosCommittedVaultRuntimeStatementConsumerV2
+	for RejectedErgoAutolykosCommittedVaultRuntimeStatementConsumerV2
+{

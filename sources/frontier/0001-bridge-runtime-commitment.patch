@@ -0,0 +1,1533 @@
+//! Authenticated Frontier receipt, status, and `PegIn` event semantics.
+//!
+//! This profile consumes an already verified V1 native-to-Frontier execution identity and the
+//! same bounded trie proof extended with `Ethereum::CurrentReceipts` and
+//! `Ethereum::CurrentTransactionStatuses`. It recomputes the receipt trie root, binds canonical
+//! transaction/status ordering, requires a successful target receipt, and parses the exact
+//! Solidity `PegIn(address,uint256,bytes32)` log selected by the runtime's global log index.
+//! EVM account/code/storage state, runtime build provenance, deposit-vault eligibility, historical
+//! absence, mint authority, and release readiness remain separate obligations.
+
+use ethereum::{EnvelopedEncodable, Log, ReceiptV3, TransactionV2};
+use ethereum_types::{Bloom, BloomInput};
+use fp_rpc::TransactionStatus;
+use scale_codec::{Compact, Decode, DecodeAll, Encode};
+use sp_core::{hashing::keccak_256, sha2_256, twox_128, H160, H256, U256};
+use sp_runtime::traits::BlakeTwo256;
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+use crate::{
+	peg_in::PegInRuntimeRecordV1,
+	peg_in_frontier_execution_identity_v1::{
+		validate_proof_bounds, FrontierExecutionIdentityProofError,
+		VerifiedFrontierExecutionIdentityV1,
+	},
+};
+
+const PEG_IN_EVENT_SIGNATURE: &[u8] = b"PegIn(address,uint256,bytes32)";
+const TRANSFER_EVENT_SIGNATURE: &[u8] = b"Transfer(address,address,uint256)";
+
+/// Maximum raw `Ethereum::CurrentReceipts` SCALE bytes accepted by this profile.
+pub const MAX_FRONTIER_CURRENT_RECEIPTS_SCALE_BYTES: usize = 8 * 1024 * 1024;
+/// Maximum raw `Ethereum::CurrentTransactionStatuses` SCALE bytes accepted by this profile.
+pub const MAX_FRONTIER_CURRENT_TRANSACTION_STATUSES_SCALE_BYTES: usize = 8 * 1024 * 1024;
+
+/// Derive the exact top-trie key for `Ethereum::CurrentReceipts`.
+pub fn derive_ethereum_current_receipts_storage_key() -> [u8; 32] {
+	derive_ethereum_storage_value_key(b"CurrentReceipts")
+}
+
+/// Derive the exact top-trie key for `Ethereum::CurrentTransactionStatuses`.
+pub fn derive_ethereum_current_transaction_statuses_storage_key() -> [u8; 32] {
+	derive_ethereum_storage_value_key(b"CurrentTransactionStatuses")
+}
+
+/// Exact successful `PegIn` event recovered from authenticated Frontier state.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedFrontierPegInEventV1 {
+	/// Native state root used by both the execution-identity and receipt/status proofs.
+	pub state_root: H256,
+	/// Exact top-trie key for `Ethereum::CurrentReceipts`.
+	pub current_receipts_storage_key: [u8; 32],
+	/// SHA-256 of the exact authenticated receipts SCALE bytes.
+	pub current_receipts_scale_sha256: [u8; 32],
+	/// Exact authenticated receipts SCALE byte length.
+	pub current_receipts_scale_bytes: usize,
+	/// Exact top-trie key for `Ethereum::CurrentTransactionStatuses`.
+	pub current_transaction_statuses_storage_key: [u8; 32],
+	/// SHA-256 of the exact authenticated statuses SCALE bytes.
+	pub current_transaction_statuses_scale_sha256: [u8; 32],
+	/// Exact authenticated statuses SCALE byte length.
+	pub current_transaction_statuses_scale_bytes: usize,
+	/// Recomputed Ethereum receipts trie root.
+	pub receipts_root: H256,
+	/// Number of authenticated receipts.
+	pub receipt_count: usize,
+	/// Number of authenticated transaction statuses.
+	pub transaction_status_count: usize,
+	/// Zero-based transaction position of the selected receipt and event.
+	pub transaction_index: usize,
+	/// Zero-based log position inside the selected transaction receipt.
+	pub transaction_log_index: usize,
+	/// Runtime-defined global log index across every receipt in the block.
+	pub global_event_index: u32,
+	/// Exact successful receipt type identifier.
+	pub receipt_type: &'static str,
+	/// Exact transaction hash bound by block body, status, record, and event.
+	pub transaction_hash: H256,
+	/// Exact bridge contract that emitted the event.
+	pub bridge_address: H160,
+	/// Exact event signature topic.
+	pub event_signature_topic: H256,
+	/// Exact indexed sidechain recipient.
+	pub recipient: H160,
+	/// Exact raw nanoERG amount carried by the event.
+	pub amount: u64,
+	/// Exact source Ergo deposit identity carried by the event.
+	pub ergo_box_id: H256,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+}
+
+/// Exact ERC-20 mint log paired with one authenticated successful peg-in.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedFrontierTokenMintV1 {
+	/// Exact token contract that emitted the mint log.
+	pub token_address: H160,
+	/// Exact transaction hash shared with the authenticated `PegIn` event.
+	pub transaction_hash: H256,
+	/// Zero-based transaction position of the mint and peg-in logs.
+	pub transaction_index: usize,
+	/// Zero-based log position inside the successful transaction receipt.
+	pub transaction_log_index: usize,
+	/// Runtime-defined global log index across every receipt in the block.
+	pub global_event_index: u32,
+	/// Exact mint source, required to be the zero address.
+	pub from: H160,
+	/// Exact sidechain recipient shared with the authenticated `PegIn` event.
+	pub recipient: H160,
+	/// Exact raw token amount shared with the authenticated `PegIn` event.
+	pub amount: U256,
+}
+
+/// A reason authenticated Frontier receipt or `PegIn` semantics were rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum FrontierPegInEventProofError {
+	/// The prerequisite execution identity or shared proof bounds failed.
+	#[error(transparent)]
+	ExecutionIdentity(#[from] FrontierExecutionIdentityProofError),
+	/// The supplied nodes do not reconstruct both exact reads under the execution state root.
+	#[error("Frontier receipt/status proof is invalid for the authenticated state root")]
+	InvalidProof,
+	/// `Ethereum::CurrentReceipts` is absent from authenticated native state.
+	#[error("Ethereum::CurrentReceipts is absent from authenticated native state")]
+	CurrentReceiptsMissing,
+	/// `Ethereum::CurrentTransactionStatuses` is absent from authenticated native state.
+	#[error("Ethereum::CurrentTransactionStatuses is absent from authenticated native state")]
+	CurrentTransactionStatusesMissing,
+	/// One authenticated storage value was empty.
+	#[error("authenticated {field} is empty")]
+	EmptyValue {
+		/// Stable field name used by the rejecting verifier branch.
+		field: &'static str,
+	},
+	/// One authenticated storage value exceeded its byte limit.
+	#[error("authenticated {field} exceeds {max} bytes: {actual}")]
+	ValueTooLarge {
+		/// Stable field name used by the rejecting verifier branch.
+		field: &'static str,
+		/// Exact authenticated byte length.
+		actual: usize,
+		/// Maximum accepted byte length.
+		max: usize,
+	},
+	/// A SCALE vector length was malformed or differed from the block transaction count.
+	#[error("authenticated {field} vector length differs from the Frontier transaction count")]
+	VectorLength {
+		/// Stable field name used by the rejecting verifier branch.
+		field: &'static str,
+	},
+	/// A SCALE value was malformed, had trailing bytes, or was non-canonical.
+	#[error("authenticated {field} SCALE value is malformed or non-canonical")]
+	Scale {
+		/// Stable field name used by the rejecting verifier branch.
+		field: &'static str,
+	},
+	/// A receipt envelope type differs from the transaction type at the same position.
+	#[error("Frontier receipt type differs from its transaction type at index {index}")]
+	ReceiptTypeMismatch {
+		/// Zero-based block transaction position.
+		index: usize,
+	},
+	/// A status index is not its canonical block-body position.
+	#[error("Frontier transaction status index is not canonical at index {index}")]
+	StatusIndexMismatch {
+		/// Zero-based block transaction position.
+		index: usize,
+	},
+	/// A status transaction hash differs from its block transaction.
+	#[error("Frontier transaction status hash differs from the block body at index {index}")]
+	StatusTransactionHashMismatch {
+		/// Zero-based block transaction position.
+		index: usize,
+	},
+	/// Receipt and status logs differ at the same transaction position.
+	#[error("Frontier receipt and transaction-status logs differ at index {index}")]
+	StatusLogsMismatch {
+		/// Zero-based block transaction position.
+		index: usize,
+	},
+	/// A receipt bloom differs from its exact logs.
+	#[error("Frontier receipt bloom differs from its logs at index {index}")]
+	ReceiptBloomMismatch {
+		/// Zero-based block transaction position.
+		index: usize,
+	},
+	/// A status bloom differs from its exact logs.
+	#[error("Frontier transaction-status bloom differs from its logs at index {index}")]
+	StatusBloomMismatch {
+		/// Zero-based block transaction position.
+		index: usize,
+	},
+	/// The block header bloom differs from all authenticated receipt logs.
+	#[error("Frontier block logs bloom differs from authenticated receipts")]
+	HeaderBloomMismatch,
+	/// One receipt status was outside the EIP-658 zero/one domain.
+	#[error("Frontier receipt status code is outside zero or one at index {index}")]
+	InvalidReceiptStatus {
+		/// Zero-based block transaction position.
+		index: usize,
+	},
+	/// The ordered receipt envelopes do not reproduce the authenticated block header root.
+	#[error("Frontier receipts do not reproduce the authenticated block receipts root")]
+	ReceiptsRootMismatch,
+	/// The selected record transaction index drifted from the authenticated block mapping.
+	#[error("processed peg-in transaction index is outside the authenticated receipt set")]
+	RecordTransactionIndex,
+	/// The selected receipt records a failed/reverted execution.
+	#[error("processed peg-in receipt did not succeed")]
+	ReceiptFailed,
+	/// The runtime-defined global event index is absent from the authenticated receipts.
+	#[error("processed peg-in global event index is absent from authenticated receipts")]
+	EventIndexMissing,
+	/// The global event index resolves to a different transaction than the processed record.
+	#[error("processed peg-in global event index resolves to another transaction")]
+	EventTransactionMismatch,
+	/// The selected log is not emitted by the exact bridge contract.
+	#[error("PegIn log address differs from the processed record bridge address")]
+	EventAddressMismatch,
+	/// The selected log does not have exactly signature and indexed-recipient topics.
+	#[error("PegIn log must contain exactly two topics")]
+	EventTopicCount,
+	/// The selected log has the wrong event signature.
+	#[error("PegIn log signature topic is invalid")]
+	EventSignature,
+	/// The indexed recipient topic is not canonical ABI address padding.
+	#[error("PegIn indexed recipient topic has nonzero ABI padding")]
+	RecipientPadding,
+	/// The selected recipient is zero or differs from the processed record.
+	#[error("PegIn recipient differs from the processed record")]
+	RecipientMismatch,
+	/// The selected log data is not exactly two ABI words.
+	#[error("PegIn ABI data must contain exactly two words")]
+	EventDataLength,
+	/// The selected amount is zero, exceeds Ergo's signed-Long domain, or differs from the record.
+	#[error("PegIn amount differs from the processed record or its positive Ergo Long domain")]
+	AmountMismatch,
+	/// The selected source box is zero or differs from the processed record.
+	#[error("PegIn Ergo box ID differs from the processed record")]
+	ErgoBoxIdMismatch,
+	/// More than one successful bridge `PegIn` event names the same source box in this block.
+	#[error("authenticated block contains duplicate successful PegIn events for the source box")]
+	DuplicatePegIn,
+	/// The flattened log index cannot be represented in the V1 uint32 domain.
+	#[error("Frontier global log index exceeds uint32")]
+	EventIndexOverflow,
+	/// The token address must be nonzero and differ from the bridge.
+	#[error("paired mint token address must be nonzero and differ from the bridge")]
+	InvalidTokenAddress,
+	/// Re-verifying the shared receipt proof produced another peg-in identity.
+	#[error("paired mint receipt proof differs from the authenticated PegIn event")]
+	PairedEventMismatch,
+	/// A token `Transfer` log has a noncanonical topic count or address topic.
+	#[error("authenticated token Transfer log has malformed topics")]
+	TransferTopics,
+	/// A token `Transfer` log has a noncanonical uint256 data word.
+	#[error("authenticated token Transfer log has malformed data")]
+	TransferData,
+	/// No exact same-transaction mint log matches the peg-in.
+	#[error("authenticated successful receipt lacks the exact paired token mint log")]
+	PairedMintMissing,
+	/// The exact mint is not ordered before the bridge event emitted by the same call.
+	#[error("authenticated paired token mint log must precede the PegIn log")]
+	PairedMintOrderingMismatch,
+	/// More than one supply or recipient effect prevents one-event delta attribution.
+	#[error("authenticated block has additional token supply or recipient effects")]
+	AmbiguousTokenEffects,
+}
+
+/// Verify receipts, statuses, and the exact successful `PegIn` event under the execution root.
+pub fn verify_frontier_peg_in_event_v1(
+	execution: &VerifiedFrontierExecutionIdentityV1,
+	proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedFrontierPegInEventV1, FrontierPegInEventProofError> {
+	let proof_bytes = validate_proof_bounds(proof_nodes)?;
+	let receipts_key = derive_ethereum_current_receipts_storage_key();
+	let statuses_key = derive_ethereum_current_transaction_statuses_storage_key();
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let values = read_proof_check::<BlakeTwo256, _>(
+		execution.state_root,
+		proof,
+		[receipts_key.as_slice(), statuses_key.as_slice()],
+	)
+	.map_err(|_| FrontierPegInEventProofError::InvalidProof)?;
+
+	let raw_receipts = required_value(
+		&values,
+		&receipts_key,
+		"Ethereum::CurrentReceipts",
+		MAX_FRONTIER_CURRENT_RECEIPTS_SCALE_BYTES,
+		FrontierPegInEventProofError::CurrentReceiptsMissing,
+	)?;
+	let raw_statuses = required_value(
+		&values,
+		&statuses_key,
+		"Ethereum::CurrentTransactionStatuses",
+		MAX_FRONTIER_CURRENT_TRANSACTION_STATUSES_SCALE_BYTES,
+		FrontierPegInEventProofError::CurrentTransactionStatusesMissing,
+	)?;
+	let expected_count = execution.current_block.transactions.len();
+	validate_scale_vec_len(raw_receipts, expected_count, "Ethereum::CurrentReceipts")?;
+	validate_scale_vec_len(
+		raw_statuses,
+		expected_count,
+		"Ethereum::CurrentTransactionStatuses",
+	)?;
+	let receipts = Vec::<ReceiptV3>::decode_all(&mut &raw_receipts[..]).map_err(|_| {
+		FrontierPegInEventProofError::Scale {
+			field: "Ethereum::CurrentReceipts",
+		}
+	})?;
+	let statuses = Vec::<TransactionStatus>::decode_all(&mut &raw_statuses[..]).map_err(|_| {
+		FrontierPegInEventProofError::Scale {
+			field: "Ethereum::CurrentTransactionStatuses",
+		}
+	})?;
+	if receipts.encode().as_slice() != raw_receipts.as_slice()
+		|| statuses.encode().as_slice() != raw_statuses.as_slice()
+	{
+		return Err(FrontierPegInEventProofError::Scale {
+			field: "Ethereum receipt/status state",
+		});
+	}
+	let mut block_bloom = Bloom::default();
+	for (index, ((transaction, receipt), status)) in execution
+		.current_block
+		.transactions
+		.iter()
+		.zip(receipts.iter())
+		.zip(statuses.iter())
+		.enumerate()
+	{
+		if !receipt_matches_transaction(transaction, receipt) {
+			return Err(FrontierPegInEventProofError::ReceiptTypeMismatch { index });
+		}
+		let (status_code, receipt_logs, receipt_bloom, _) = receipt_fields(receipt);
+		if status_code > 1 {
+			return Err(FrontierPegInEventProofError::InvalidReceiptStatus { index });
+		}
+		let expected_index = u32::try_from(index)
+			.map_err(|_| FrontierPegInEventProofError::StatusIndexMismatch { index })?;
+		if status.transaction_index != expected_index {
+			return Err(FrontierPegInEventProofError::StatusIndexMismatch { index });
+		}
+		if status.transaction_hash != transaction.hash() {
+			return Err(FrontierPegInEventProofError::StatusTransactionHashMismatch { index });
+		}
+		if status.logs != *receipt_logs {
+			return Err(FrontierPegInEventProofError::StatusLogsMismatch { index });
+		}
+		let recomputed_bloom = logs_bloom(receipt_logs);
+		if *receipt_bloom != recomputed_bloom {
+			return Err(FrontierPegInEventProofError::ReceiptBloomMismatch { index });
+		}
+		if status.logs_bloom != recomputed_bloom {
+			return Err(FrontierPegInEventProofError::StatusBloomMismatch { index });
+		}
+		accrue_logs(receipt_logs, &mut block_bloom);
+	}
+	if execution.current_block.header.logs_bloom != block_bloom {
+		return Err(FrontierPegInEventProofError::HeaderBloomMismatch);
+	}
+	let receipts_root =
+		ethereum::util::ordered_trie_root(receipts.iter().map(EnvelopedEncodable::encode));
+	if execution.current_block.header.receipts_root != receipts_root {
+		return Err(FrontierPegInEventProofError::ReceiptsRootMismatch);
+	}
+
+	let transaction_index = execution.record_transaction_index;
+	let target_receipt = receipts
+		.get(transaction_index)
+		.ok_or(FrontierPegInEventProofError::RecordTransactionIndex)?;
+	let target_status = statuses
+		.get(transaction_index)
+		.ok_or(FrontierPegInEventProofError::RecordTransactionIndex)?;
+	if target_status.transaction_hash != execution.record.transaction_hash {
+		return Err(
+			FrontierPegInEventProofError::StatusTransactionHashMismatch {
+				index: transaction_index,
+			},
+		);
+	}
+	let (target_status_code, _, _, receipt_type) = receipt_fields(target_receipt);
+	if target_status_code != 1 {
+		return Err(FrontierPegInEventProofError::ReceiptFailed);
+	}
+
+	let (selected_transaction_index, transaction_log_index, selected_log) =
+		select_global_log(&receipts, execution.record.event_index)?;
+	if selected_transaction_index != transaction_index {
+		return Err(FrontierPegInEventProofError::EventTransactionMismatch);
+	}
+	let parsed = parse_exact_peg_in_log(selected_log, &execution.record)?;
+	let mut matching_box_events = 0usize;
+	for receipt in &receipts {
+		let (status_code, logs, _, _) = receipt_fields(receipt);
+		if status_code != 1 {
+			continue;
+		}
+		for log in logs {
+			if log.address == execution.record.bridge_address
+				&& log.topics.first() == Some(&peg_in_topic())
+			{
+				let candidate = parse_peg_in_log(log)?;
+				if candidate.ergo_box_id == execution.record.ergo_box_id {
+					matching_box_events += 1;
+				}
+			}
+		}
+	}
+	if matching_box_events != 1 {
+		return Err(FrontierPegInEventProofError::DuplicatePegIn);
+	}
+
+	Ok(VerifiedFrontierPegInEventV1 {
+		state_root: execution.state_root,
+		current_receipts_storage_key: receipts_key,
+		current_receipts_scale_sha256: sha2_256(raw_receipts),
+		current_receipts_scale_bytes: raw_receipts.len(),
+		current_transaction_statuses_storage_key: statuses_key,
+		current_transaction_statuses_scale_sha256: sha2_256(raw_statuses),
+		current_transaction_statuses_scale_bytes: raw_statuses.len(),
+		receipts_root,
+		receipt_count: receipts.len(),
+		transaction_status_count: statuses.len(),
+		transaction_index,
+		transaction_log_index,
+		global_event_index: execution.record.event_index,
+		receipt_type,
+		transaction_hash: execution.record.transaction_hash,
+		bridge_address: execution.record.bridge_address,
+		event_signature_topic: peg_in_topic(),
+		recipient: parsed.recipient,
+		amount: parsed.amount,
+		ergo_box_id: parsed.ergo_box_id,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+/// Verify the exact same-transaction ERC-20 mint paired with an authenticated peg-in.
+///
+/// The V1 profile is deliberately single-effect: every nonzero token `Transfer` that changes
+/// supply or touches the peg-in recipient is inspected across successful receipts. Exactly one
+/// such effect must exist, and it must be `Transfer(0, recipient, amount)` in the peg-in
+/// transaction. Blocks with another mint, burn, or recipient transfer fail closed rather than
+/// attributing an aggregate state delta to one event.
+pub fn verify_frontier_token_mint_v1(
+	execution: &VerifiedFrontierExecutionIdentityV1,
+	proof_nodes: &[Vec<u8>],
+	expected_event: &VerifiedFrontierPegInEventV1,
+	token_address: H160,
+) -> Result<VerifiedFrontierTokenMintV1, FrontierPegInEventProofError> {
+	if token_address == H160::zero() || token_address == expected_event.bridge_address {
+		return Err(FrontierPegInEventProofError::InvalidTokenAddress);
+	}
+	let verified_event = verify_frontier_peg_in_event_v1(execution, proof_nodes)?;
+	if &verified_event != expected_event {
+		return Err(FrontierPegInEventProofError::PairedEventMismatch);
+	}
+
+	let receipts_key = derive_ethereum_current_receipts_storage_key();
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let values =
+		read_proof_check::<BlakeTwo256, _>(execution.state_root, proof, [receipts_key.as_slice()])
+			.map_err(|_| FrontierPegInEventProofError::InvalidProof)?;
+	let raw_receipts = required_value(
+		&values,
+		&receipts_key,
+		"Ethereum::CurrentReceipts",
+		MAX_FRONTIER_CURRENT_RECEIPTS_SCALE_BYTES,
+		FrontierPegInEventProofError::CurrentReceiptsMissing,
+	)?;
+	validate_scale_vec_len(
+		raw_receipts,
+		execution.current_block.transactions.len(),
+		"Ethereum::CurrentReceipts",
+	)?;
+	let receipts = Vec::<ReceiptV3>::decode_all(&mut &raw_receipts[..]).map_err(|_| {
+		FrontierPegInEventProofError::Scale {
+			field: "Ethereum::CurrentReceipts",
+		}
+	})?;
+	if receipts.encode().as_slice() != raw_receipts.as_slice() {
+		return Err(FrontierPegInEventProofError::Scale {
+			field: "Ethereum::CurrentReceipts",
+		});
+	}
+
+	let mut global_index = 0u32;
+	let mut relevant_effects = 0usize;
+	let mut paired = None;
+	let mut paired_with_wrong_order = false;
+	for (transaction_index, receipt) in receipts.iter().enumerate() {
+		let (status_code, logs, _, _) = receipt_fields(receipt);
+		for (transaction_log_index, log) in logs.iter().enumerate() {
+			let current_global_index = global_index;
+			global_index = global_index
+				.checked_add(1)
+				.ok_or(FrontierPegInEventProofError::EventIndexOverflow)?;
+			if status_code != 1
+				|| log.address != token_address
+				|| log.topics.first() != Some(&transfer_topic())
+			{
+				continue;
+			}
+			let transfer = parse_transfer_log(log)?;
+			if transfer.amount.is_zero() {
+				continue;
+			}
+			let affects_supply = transfer.from == H160::zero() || transfer.to == H160::zero();
+			let affects_recipient = transfer.from == expected_event.recipient
+				|| transfer.to == expected_event.recipient;
+			if !affects_supply && !affects_recipient {
+				continue;
+			}
+			relevant_effects += 1;
+			if transaction_index == expected_event.transaction_index
+				&& transfer.from == H160::zero()
+				&& transfer.to == expected_event.recipient
+				&& transfer.amount == U256::from(expected_event.amount)
+			{
+				if transaction_log_index < expected_event.transaction_log_index
+					&& current_global_index < expected_event.global_event_index
+				{
+					paired = Some(VerifiedFrontierTokenMintV1 {
+						token_address,
+						transaction_hash: expected_event.transaction_hash,
+						transaction_index,
+						transaction_log_index,
+						global_event_index: current_global_index,
+						from: transfer.from,
+						recipient: transfer.to,
+						amount: transfer.amount,
+					});
+				} else {
+					paired_with_wrong_order = true;
+				}
+			}
+		}
+	}
+	if relevant_effects == 0 {
+		return Err(FrontierPegInEventProofError::PairedMintMissing);
+	}
+	if relevant_effects != 1 {
+		return Err(FrontierPegInEventProofError::AmbiguousTokenEffects);
+	}
+	if paired_with_wrong_order {
+		return Err(FrontierPegInEventProofError::PairedMintOrderingMismatch);
+	}
+	paired.ok_or(FrontierPegInEventProofError::PairedMintMissing)
+}
+
+struct ParsedPegInLog {
+	recipient: H160,
+	amount: u64,
+	ergo_box_id: H256,
+}
+
+struct ParsedTransferLog {
+	from: H160,
+	to: H160,
+	amount: U256,
+}
+
+fn derive_ethereum_storage_value_key(name: &[u8]) -> [u8; 32] {
+	let mut key = [0u8; 32];
+	key[..16].copy_from_slice(&twox_128(b"Ethereum"));
+	key[16..].copy_from_slice(&twox_128(name));
+	key
+}
+
+fn required_value<'a>(
+	values: &'a std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+	field: &'static str,
+	max: usize,
+	missing: FrontierPegInEventProofError,
+) -> Result<&'a Vec<u8>, FrontierPegInEventProofError> {
+	let value = values
+		.get(key)
+		.and_then(|value| value.as_ref())
+		.ok_or(missing)?;
+	if value.is_empty() {
+		return Err(FrontierPegInEventProofError::EmptyValue { field });
+	}
+	if value.len() > max {
+		return Err(FrontierPegInEventProofError::ValueTooLarge {
+			field,
+			actual: value.len(),
+			max,
+		});
+	}
+	Ok(value)
+}
+
+fn validate_scale_vec_len(
+	bytes: &[u8],
+	expected: usize,
+	field: &'static str,
+) -> Result<(), FrontierPegInEventProofError> {
+	let Compact(length) = Compact::<u32>::decode(&mut &bytes[..])
+		.map_err(|_| FrontierPegInEventProofError::VectorLength { field })?;
+	let length = usize::try_from(length)
+		.map_err(|_| FrontierPegInEventProofError::VectorLength { field })?;
+	if length != expected {
+		return Err(FrontierPegInEventProofError::VectorLength { field });
+	}
+	Ok(())
+}
+
+fn receipt_fields(receipt: &ReceiptV3) -> (u8, &Vec<Log>, &Bloom, &'static str) {
+	match receipt {
+		ReceiptV3::Legacy(data) => (data.status_code, &data.logs, &data.logs_bloom, "legacy"),
+		ReceiptV3::EIP2930(data) => (data.status_code, &data.logs, &data.logs_bloom, "eip2930"),
+		ReceiptV3::EIP1559(data) => (data.status_code, &data.logs, &data.logs_bloom, "eip1559"),
+	}
+}
+
+fn receipt_matches_transaction(transaction: &TransactionV2, receipt: &ReceiptV3) -> bool {
+	matches!(
+		(transaction, receipt),
+		(TransactionV2::Legacy(_), ReceiptV3::Legacy(_))
+			| (TransactionV2::EIP2930(_), ReceiptV3::EIP2930(_))
+			| (TransactionV2::EIP1559(_), ReceiptV3::EIP1559(_))
+	)
+}
+
+fn logs_bloom(logs: &[Log]) -> Bloom {
+	let mut bloom = Bloom::default();
+	accrue_logs(logs, &mut bloom);
+	bloom
+}
+
+fn accrue_logs(logs: &[Log], bloom: &mut Bloom) {
+	for log in logs {
+		bloom.accrue(BloomInput::Raw(log.address.as_bytes()));
+		for topic in &log.topics {
+			bloom.accrue(BloomInput::Raw(topic.as_bytes()));
+		}
+	}
+}
+
+fn select_global_log(
+	receipts: &[ReceiptV3],
+	expected_index: u32,
+) -> Result<(usize, usize, &Log), FrontierPegInEventProofError> {
+	let mut global_index = 0u32;
+	for (transaction_index, receipt) in receipts.iter().enumerate() {
+		let (_, logs, _, _) = receipt_fields(receipt);
+		for (transaction_log_index, log) in logs.iter().enumerate() {
+			if global_index == expected_index {
+				return Ok((transaction_index, transaction_log_index, log));
+			}
+			global_index = global_index
+				.checked_add(1)
+				.ok_or(FrontierPegInEventProofError::EventIndexOverflow)?;
+		}
+	}
+	Err(FrontierPegInEventProofError::EventIndexMissing)
+}
+
+fn peg_in_topic() -> H256 {
+	H256::from(keccak_256(PEG_IN_EVENT_SIGNATURE))
+}
+
+fn transfer_topic() -> H256 {
+	H256::from(keccak_256(TRANSFER_EVENT_SIGNATURE))
+}
+
+fn parse_transfer_log(log: &Log) -> Result<ParsedTransferLog, FrontierPegInEventProofError> {
+	if log.topics.len() != 3 || log.topics[0] != transfer_topic() {
+		return Err(FrontierPegInEventProofError::TransferTopics);
+	}
+	let from = decode_address_topic(log.topics[1])?;
+	let to = decode_address_topic(log.topics[2])?;
+	if log.data.len() != 32 {
+		return Err(FrontierPegInEventProofError::TransferData);
+	}
+	Ok(ParsedTransferLog {
+		from,
+		to,
+		amount: U256::from_big_endian(&log.data),
+	})
+}
+
+fn decode_address_topic(topic: H256) -> Result<H160, FrontierPegInEventProofError> {
+	if topic.as_bytes()[..12].iter().any(|byte| *byte != 0) {
+		return Err(FrontierPegInEventProofError::TransferTopics);
+	}
+	Ok(H160::from_slice(&topic.as_bytes()[12..]))
+}
+
+fn parse_exact_peg_in_log(
+	log: &Log,
+	record: &PegInRuntimeRecordV1,
+) -> Result<ParsedPegInLog, FrontierPegInEventProofError> {
+	if log.address != record.bridge_address {
+		return Err(FrontierPegInEventProofError::EventAddressMismatch);
+	}
+	let parsed = parse_peg_in_log(log)?;
+	if parsed.recipient != record.recipient {
+		return Err(FrontierPegInEventProofError::RecipientMismatch);
+	}
+	if parsed.amount != record.amount {
+		return Err(FrontierPegInEventProofError::AmountMismatch);
+	}
+	if parsed.ergo_box_id != record.ergo_box_id {
+		return Err(FrontierPegInEventProofError::ErgoBoxIdMismatch);
+	}
+	Ok(parsed)
+}
+
+fn parse_peg_in_log(log: &Log) -> Result<ParsedPegInLog, FrontierPegInEventProofError> {
+	if log.topics.len() != 2 {
+		return Err(FrontierPegInEventProofError::EventTopicCount);
+	}
+	if log.topics[0] != peg_in_topic() {
+		return Err(FrontierPegInEventProofError::EventSignature);
+	}
+	let recipient_topic = log.topics[1].as_bytes();
+	if recipient_topic[..12].iter().any(|byte| *byte != 0) {
+		return Err(FrontierPegInEventProofError::RecipientPadding);
+	}
+	let recipient = H160::from_slice(&recipient_topic[12..]);
+	if recipient == H160::zero() {
+		return Err(FrontierPegInEventProofError::RecipientMismatch);
+	}
+	if log.data.len() != 64 {
+		return Err(FrontierPegInEventProofError::EventDataLength);
+	}
+	let amount = U256::from_big_endian(&log.data[..32]);
+	if amount.is_zero() || amount > U256::from(i64::MAX as u64) {
+		return Err(FrontierPegInEventProofError::AmountMismatch);
+	}
+	let ergo_box_id = H256::from_slice(&log.data[32..]);
+	if ergo_box_id == H256::zero() {
+		return Err(FrontierPegInEventProofError::ErgoBoxIdMismatch);
+	}
+	Ok(ParsedPegInLog {
+		recipient,
+		amount: amount.low_u64(),
+		ergo_box_id,
+	})
+}

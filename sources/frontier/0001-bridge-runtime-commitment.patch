+
+pub fn verify_federated_pooled_reserve_source_proof_v1(
+	source_profile: &FederatedPooledReserveSourceProofProfileV1,
+	runtime_profile: &PooledReserveMintReservationRuntimeProfileV4,
+	validated: &ValidatedPooledReserveMintReservationV4,
+	statement_bytes: &[u8],
+	current_native_height: u64,
+	proof: &PooledReserveMintReservationSourceProofEnvelopeV4,
+) -> Result<VerifiedPooledReserveMintReservationSourceProofV4, &'static str> {
+	validate_federated_pooled_reserve_source_proof_profile_v1(source_profile)?;
+	let runtime_profile_id =
+		validate_pooled_reserve_mint_reservation_profile_v4(runtime_profile)?;
+	let revalidated = validate_pooled_reserve_mint_reservation_statement_v4(statement_bytes)?;
+	if &revalidated != validated {
+		return Err("federated pooled-reserve source proof statement binding drifted");
+	}
+	let proof_system_id = federated_pooled_reserve_source_proof_system_id_v1();
+	let proof_profile_id =
+		derive_federated_pooled_reserve_source_proof_profile_id_v1(source_profile)?;
+	if proof.format_version != POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4
+		|| proof.proof_system_id != proof_system_id
+		|| proof.proof_profile_id != proof_profile_id
+		|| runtime_profile.source_proof_system_id != proof_system_id
+		|| runtime_profile.source_proof_profile_id != proof_profile_id
+	{
+		return Err("federated pooled-reserve source proof has an invalid profile identity");
+	}
+	let decoded = FederatedPooledReserveSourceProofEnvelopeV1::decode_all(
+		&mut &proof.proof_bytes[..],
+	)
+	.map_err(|_| "federated pooled-reserve source proof bytes are not canonical")?;
+	if decoded.encode().as_slice() != proof.proof_bytes.as_slice() {
+		return Err("federated pooled-reserve source proof encoding is not canonical");
+	}
+	let key_set_digest =
+		derive_federated_pooled_reserve_source_key_set_digest_v1(source_profile)?;
+	let result = &decoded.result;
+	if result.federation_epoch != source_profile.federation_epoch
+		|| result.source_attestation_key_set_digest != key_set_digest
+		|| result.source_attestation_threshold != source_profile.threshold
+		|| result.verifier_profile_id != source_profile.verifier_profile_id
+		|| result.issued_at_native_height != proof.issued_at_native_height
+		|| result.expires_at_native_height != proof.expires_at_native_height
+	{
+		return Err("federated pooled-reserve source proof does not bind its static profile");
+	}
+	validate_federated_pooled_reserve_validity_window_v1(
+		result.issued_at_native_height,
+		result.expires_at_native_height,
+		current_native_height,
+		runtime_profile.activation_height,
+		source_profile.max_validity_blocks,
+		u64::from(runtime_profile.max_pending_blocks),
+	)?;
+	let statement_bytes_digest = H256::from(blake2_256(statement_bytes));
+	let request_digest = derive_federated_pooled_reserve_source_proof_request_digest_v1(
+		runtime_profile_id,
+		validated.statement_id,
+		statement_bytes_digest,
+		proof_system_id,
+		proof_profile_id,
+		source_profile.federation_epoch,
+		key_set_digest,
+		source_profile.threshold,
+		result.issued_at_native_height,
+		result.expires_at_native_height,
+	);
+	if result.request_digest != request_digest {
+		return Err("federated pooled-reserve source proof does not bind the exact request");
+	}
+	let result_id = derive_federated_pooled_reserve_source_proof_result_id_v1(result)?;
+	let attestation_digest =
+		derive_federated_pooled_reserve_source_proof_attestation_digest_v1(result_id);
+	let signature_set_digest = validate_federated_threshold_signatures_v1(
+		&source_profile.signer_public_keys,
+		source_profile.threshold,
+		&decoded.signatures,
+		attestation_digest,
+		FEDERATED_PROOF_SIGNATURE_SET_DOMAIN_V1,
+	)?;
+	let mut proof_preimage = Vec::with_capacity(64);
+	proof_preimage.extend_from_slice(result_id.as_bytes());
+	proof_preimage.extend_from_slice(signature_set_digest.as_bytes());
+	Ok(VerifiedPooledReserveMintReservationSourceProofV4 {
+		runtime_profile_id,
+		statement_id: validated.statement_id,
+		statement_bytes_digest,
+		proof_system_id,
+		proof_profile_id,
+		issued_at_native_height: result.issued_at_native_height,
+		expires_at_native_height: result.expires_at_native_height,
+		proof_request_digest: request_digest,
+		proof_result_id: result_id,
+		proof_digest: domain_hash(FEDERATED_PROOF_ENVELOPE_DOMAIN_V1, &proof_preimage),
+	})
+}
+
+pub fn derive_federated_pooled_reserve_invalidation_id_v1(
+	invalidation: &FederatedPooledReserveInvalidationV1,
+) -> Result<H256, &'static str> {
+	if invalidation.format_version != FEDERATED_POOLED_RESERVE_SOURCE_PROOF_FORMAT_VERSION_V1
+		|| invalidation.federation_epoch == 0
+		|| invalidation.source_attestation_threshold < 2
+		|| [
+			invalidation.proof_system_id,
+			invalidation.proof_profile_id,
+			invalidation.source_attestation_key_set_digest,
+			invalidation.runtime_profile_id,
+			invalidation.statement_id,
+			invalidation.mint_identity,
+			invalidation.source_proof_result_id,
+			invalidation.evidence_digest,
+			invalidation.observed_checkpoint_block_id,
+		]
+		.iter()
+		.any(|value| *value == H256::zero())
+	{
+		return Err("federated pooled-reserve source invalidation is malformed");
+	}
+	let reason_code = federated_pooled_reserve_invalidation_reason_code_v1(invalidation.reason);
+	let mut encoded = Vec::with_capacity(1 + 8 + 2 + 32 * 9 + 1 + 24);
+	encoded.push(invalidation.format_version);
+	encoded.extend_from_slice(invalidation.proof_system_id.as_bytes());
+	encoded.extend_from_slice(invalidation.proof_profile_id.as_bytes());
+	encoded.extend_from_slice(&invalidation.federation_epoch.to_be_bytes());
+	encoded.extend_from_slice(invalidation.source_attestation_key_set_digest.as_bytes());
+	encoded.extend_from_slice(&invalidation.source_attestation_threshold.to_be_bytes());
+	encoded.extend_from_slice(invalidation.runtime_profile_id.as_bytes());
+	encoded.extend_from_slice(invalidation.statement_id.as_bytes());
+	encoded.extend_from_slice(invalidation.mint_identity.as_bytes());
+	encoded.extend_from_slice(invalidation.source_proof_result_id.as_bytes());
+	encoded.push(reason_code);
+	encoded.extend_from_slice(invalidation.evidence_digest.as_bytes());
+	encoded.extend_from_slice(invalidation.observed_checkpoint_block_id.as_bytes());
+	encoded.extend_from_slice(&invalidation.observed_checkpoint_height.to_be_bytes());
+	encoded.extend_from_slice(&invalidation.issued_at_native_height.to_be_bytes());
+	encoded.extend_from_slice(&invalidation.expires_at_native_height.to_be_bytes());
+	Ok(domain_hash(FEDERATED_INVALIDATION_DOMAIN_V1, &encoded))
+}

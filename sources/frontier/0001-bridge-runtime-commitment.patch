+pub fn validate_pooled_reserve_mint_reservation_statement_v4(
+	bytes: &[u8],
+) -> Result<ValidatedPooledReserveMintReservationV4, &'static str> {
+	if bytes.len() != POOLED_RESERVE_MINT_RESERVATION_STATEMENT_V4_BYTES
+		|| bytes[0] != POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4
+	{
+		return Err("pooled-reserve mint-reservation statement has an unsupported wire format");
+	}
+	let lineage_profile_id = h256(bytes, 1);
+	let source_intent_bytes = &bytes[33..33 + SOURCE_INTENT_V2_BYTES];
+	let source_intent = decode_source_intent_v2(source_intent_bytes)?;
+	let source_intent_id = h256(bytes, 262);
+	let mint_identity = h256(bytes, 294);
+	let source_lock_box_id = h256(bytes, 326);
+	let reserve_transition_transaction_id = h256(bytes, 358);
+	let deposit_commitment = h256(bytes, 390);
+	let successor_reserve_box_id = h256(bytes, 422);
+	let mut successor_reserve_digest = [0u8; 33];
+	successor_reserve_digest.copy_from_slice(&bytes[454..487]);
+	let successor_reserve_liability = u64_be(bytes, 487);
+	let ergo_deposit_finality_policy_id = h256(bytes, 495);
+	let inclusion_header_id = h256(bytes, 527);
+	let inclusion_height = u32_be(bytes, 559);
+	let target_header_id = h256(bytes, 563);
+	let target_height = u32_be(bytes, 595);
+	let required_successor_depth = u32_be(bytes, 599);
+
+	if lineage_profile_id == H256::zero()
+		|| source_intent_id == H256::zero()
+		|| mint_identity == H256::zero()
+		|| source_lock_box_id == H256::zero()
+		|| reserve_transition_transaction_id == H256::zero()
+		|| deposit_commitment == H256::zero()
+		|| successor_reserve_box_id == H256::zero()
+		|| successor_reserve_digest.iter().all(|byte| *byte == 0)
+		|| successor_reserve_liability == 0
+		|| successor_reserve_liability > i64::MAX as u64
+		|| ergo_deposit_finality_policy_id == H256::zero()
+		|| inclusion_header_id == H256::zero()
+		|| target_header_id == H256::zero()
+		|| required_successor_depth == 0
+	{
+		return Err(
+			"pooled-reserve mint-reservation statement contains a zero or unsupported field",
+		);
+	}
+	if source_intent.admission_profile_id != lineage_profile_id
+		|| derive_source_intent_id_v2(source_intent_bytes)? != source_intent_id
+	{
+		return Err("pooled-reserve mint-reservation source intent is inconsistent");
+	}
+	if successor_reserve_liability < source_intent.amount {
+		return Err("pooled-reserve mint-reservation liability is lower than the source amount");
+	}
+	if source_lock_box_id == successor_reserve_box_id || inclusion_header_id == target_header_id {
+		return Err("pooled-reserve mint-reservation aliases distinct source identities");
+	}
+	let expected_target_height = inclusion_height
+		.checked_add(required_successor_depth)
+		.ok_or("pooled-reserve mint-reservation finality height overflows")?;
+	if target_height != expected_target_height {
+		return Err("pooled-reserve mint-reservation finality target is inconsistent");
+	}
+	if mint_identity
+		!= derive_pooled_reserve_mint_identity_v4(
+			lineage_profile_id,
+			source_lock_box_id,
+			deposit_commitment,
+		) {
+		return Err("pooled-reserve mint-reservation V4 mint identity is inconsistent");
+	}
+	let statement = PooledReserveMintReservationStatementV4 {
+		lineage_profile_id,
+		source_intent,
+		source_intent_id,
+		mint_identity,
+		source_lock_box_id,
+		reserve_transition_transaction_id,
+		deposit_commitment,
+		successor_reserve_box_id,
+		successor_reserve_digest,
+		successor_reserve_liability,
+		ergo_deposit_finality_policy_id,
+		inclusion_header_id,
+		inclusion_height,
+		target_header_id,
+		target_height,
+		required_successor_depth,
+	};
+	Ok(ValidatedPooledReserveMintReservationV4 {
+		statement,
+		statement_id: domain_hash(RESERVATION_STATEMENT_ID_DOMAIN_V4, bytes),
+	})
+}

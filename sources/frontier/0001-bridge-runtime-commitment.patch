+pub fn derive_federated_pooled_reserve_source_proof_result_id_v1(
+	result: &FederatedPooledReserveSourceProofResultV1,
+) -> Result<H256, &'static str> {
+	if result.format_version != FEDERATED_POOLED_RESERVE_SOURCE_PROOF_FORMAT_VERSION_V1
+		|| result.federation_epoch == 0
+		|| result.source_attestation_threshold < 2
+		|| [
+			result.source_attestation_key_set_digest,
+			result.request_digest,
+			result.source_lock_box_canonical_blake2b256,
+			result.reserve_transition_transaction_canonical_blake2b256,
+			result.successor_reserve_box_canonical_blake2b256,
+			result.inclusion_proof_blake2b256,
+			result.checkpoint_ancestry_blake2b256,
+			result.finality_proof_blake2b256,
+			result.verifier_executable_sha256,
+			result.verifier_profile_id,
+		]
+		.iter()
+		.any(|value| *value == H256::zero())
+	{
+		return Err("federated pooled-reserve source-proof result is malformed");
+	}
+	let mut encoded = Vec::with_capacity(1 + 8 + 2 + 32 * 10 + 16);
+	encoded.push(result.format_version);
+	encoded.extend_from_slice(&result.federation_epoch.to_be_bytes());
+	encoded.extend_from_slice(result.source_attestation_key_set_digest.as_bytes());
+	encoded.extend_from_slice(&result.source_attestation_threshold.to_be_bytes());
+	for value in [
+		result.request_digest,
+		result.source_lock_box_canonical_blake2b256,
+		result.reserve_transition_transaction_canonical_blake2b256,
+		result.successor_reserve_box_canonical_blake2b256,
+		result.inclusion_proof_blake2b256,
+		result.checkpoint_ancestry_blake2b256,
+		result.finality_proof_blake2b256,
+		result.verifier_executable_sha256,
+		result.verifier_profile_id,
+	] {
+		encoded.extend_from_slice(value.as_bytes());
+	}
+	encoded.extend_from_slice(&result.issued_at_native_height.to_be_bytes());
+	encoded.extend_from_slice(&result.expires_at_native_height.to_be_bytes());
+	Ok(domain_hash(FEDERATED_PROOF_RESULT_DOMAIN_V1, &encoded))
+}

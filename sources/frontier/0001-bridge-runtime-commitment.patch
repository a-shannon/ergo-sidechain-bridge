+/// Exact raw Substrate storage key whose value is the deployed runtime Wasm.
+pub const RUNTIME_CODE_STORAGE_KEY: [u8; 5] = *b":code";
+/// Maximum raw runtime Wasm accepted by this proof profile.
+pub const MAX_RUNTIME_CODE_BYTES: usize = 4 * 1024 * 1024;
+/// Maximum trie nodes accepted by the three-key runtime-identity profile.
+pub const MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODES: usize = 512;
+/// Maximum aggregate trie-node bytes accepted by the runtime-identity profile.
+pub const MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_BYTES: usize = 8 * 1024 * 1024;
+/// Maximum individual trie-node size accepted by the runtime-identity profile.
+pub const MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODE_BYTES: usize = 4 * 1024 * 1024;
+
+/// Exact statement-bound identity expected for the raw `:code` value.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RuntimeCodeExpectationV2 {
+	/// SHA-256 digest of the exact raw Wasm bytes stored under `:code`.
+	pub artifact_sha256: [u8; 32],
+	/// Exact raw Wasm byte length.
+	pub artifact_size_bytes: usize,
+}
+
+/// A reason the Peg-In Runtime Identity V2 proof was rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum PegInRuntimeIdentityProofError {
+	/// The inherited V1 profile or record predicate failed.
+	#[error(transparent)]
+	PegInState(#[from] PegInStateProofError),
+	/// No trie nodes were supplied.
+	#[error("peg-in runtime identity proof is empty")]
+	EmptyProof,
+	/// The proof contains more nodes than the V2 profile permits.
+	#[error("peg-in runtime identity proof contains too many nodes: {actual} > {max}")]
+	TooManyNodes {
+		/// Supplied node count.
+		actual: usize,
+		/// Configured maximum node count.
+		max: usize,
+	},
+	/// One trie node exceeds the V2 per-node byte limit.
+	#[error("peg-in runtime identity proof node {index} exceeds {max} bytes: {actual}")]
+	NodeTooLarge {
+		/// Zero-based node index.
+		index: usize,
+		/// Supplied node size.
+		actual: usize,
+		/// Configured maximum node size.
+		max: usize,
+	},
+	/// The aggregate trie proof exceeds the V2 byte limit.
+	#[error("peg-in runtime identity proof exceeds {max} bytes: {actual}")]
+	ProofTooLarge {
+		/// Supplied aggregate node bytes.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// The raw proof repeats an encoded trie node.
+	#[error("peg-in runtime identity proof contains duplicate nodes")]
+	DuplicateNodes,
+	/// The supplied nodes do not reconstruct every exact V2 read under the state root.
+	#[error("peg-in runtime identity proof is invalid for the authenticated state root")]
+	InvalidProof,
+	/// The statement expected a zero runtime artifact digest.
+	#[error("expected runtime code SHA-256 digest is zero")]
+	ZeroRuntimeCodeDigest,
+	/// The statement expected an empty runtime artifact.
+	#[error("expected runtime code size is zero")]
+	ZeroRuntimeCodeSize,
+	/// The statement expected a runtime larger than the V2 profile permits.
+	#[error("expected runtime code exceeds {max} bytes: {actual}")]
+	ExpectedRuntimeCodeTooLarge {
+		/// Statement-bound byte length.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// The `:code` key was absent from authenticated runtime state.
+	#[error("runtime code is absent from authenticated runtime state")]
+	RuntimeCodeMissing,
+	/// The authenticated `:code` value was empty.
+	#[error("authenticated runtime code is empty")]
+	RuntimeCodeEmpty,
+	/// The authenticated `:code` value exceeds the V2 profile.
+	#[error("authenticated runtime code exceeds {max} bytes: {actual}")]
+	RuntimeCodeTooLarge {
+		/// Authenticated byte length.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// The authenticated runtime size differs from the statement.
+	#[error("authenticated runtime code size differs from the expected statement")]
+	RuntimeCodeSizeMismatch,
+	/// The authenticated runtime SHA-256 differs from the statement.
+	#[error("authenticated runtime code SHA-256 differs from the expected statement")]
+	RuntimeCodeDigestMismatch,
+	/// The active profile key is absent.
+	#[error("current peg-in profile is absent from authenticated runtime state")]
+	ProfileMissing,
+	/// The profile storage value has the wrong fixed width.
+	#[error("peg-in runtime profile SCALE value must be exactly {expected} bytes, got {actual}")]
+	ProfileLength {
+		/// Supplied storage value length.
+		actual: usize,
+		/// Required V1 length.
+		expected: usize,
+	},
+	/// The profile storage value is not canonical V1 SCALE.
+	#[error("peg-in runtime profile SCALE value is malformed")]
+	ProfileDecode,
+	/// The authenticated profile differs from the exact statement value.
+	#[error("authenticated peg-in runtime profile differs from the expected statement")]
+	ProfileMismatch,
+	/// A membership statement proved absence.
+	#[error("processed peg-in record is absent from authenticated runtime state")]
+	RecordMissing,
+	/// A non-membership statement proved a value.
+	#[error("processed peg-in record is present but the statement requires non-membership")]
+	UnexpectedRecord,
+	/// The record storage value has the wrong fixed width.
+	#[error("peg-in runtime record SCALE value must be exactly {expected} bytes, got {actual}")]
+	RecordLength {
+		/// Supplied storage value length.
+		actual: usize,
+		/// Required V1 length.
+		expected: usize,
+	},
+	/// The record storage value is not canonical V1 SCALE.
+	#[error("peg-in runtime record SCALE value is malformed")]
+	RecordDecode,
+	/// The authenticated record differs from the exact statement value.
+	#[error("authenticated peg-in runtime record differs from the expected statement")]
+	RecordMismatch,
+}

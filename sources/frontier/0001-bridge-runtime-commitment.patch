+//! Standard-input entrypoint for the offline bridge checkpoint verifier.
+
+use std::{
+	env,
+	io::{self, Read},
+	process::ExitCode,
+};
+
+use bridge_checkpoint_verifier::{verify_request_bytes, MAX_REQUEST_BYTES};
+
+enum VerificationMode {
+	BurnCheckpoint,
+	PegInState,
+	PooledReserveMintReservationStateV4,
+}
+
+fn main() -> ExitCode {
+	match run() {
+		Ok(()) => ExitCode::SUCCESS,
+		Err(error) => {
+			eprintln!("bridge checkpoint verification failed: {error}");
+			ExitCode::from(2)
+		}
+	}
+}
+
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+	let mut arguments = env::args();
+	let _program = arguments.next();
+	let mode = match arguments.next().as_deref() {
+		Some("--trusted-anchor-digest") => VerificationMode::BurnCheckpoint,
+		Some("--verify-peg-in-state") => {
+			if arguments.next().as_deref() != Some("--trusted-anchor-digest") {
+				return Err("expected --trusted-anchor-digest <0x-prefixed-digest>".into());
+			}
+			VerificationMode::PegInState
+		}
+		Some("--verify-pooled-reserve-mint-reservation-state-v4") => {
+			if arguments.next().as_deref() != Some("--trusted-anchor-digest") {
+				return Err("expected --trusted-anchor-digest <0x-prefixed-digest>".into());
+			}
+			VerificationMode::PooledReserveMintReservationStateV4
+		}
+		_ => {
+			return Err(
+				"expected [--verify-peg-in-state|--verify-pooled-reserve-mint-reservation-state-v4] --trusted-anchor-digest <0x-prefixed-digest>".into(),
+			)
+		}
+	};
+	let trusted_anchor_digest = arguments
+		.next()
+		.ok_or("expected --trusted-anchor-digest <0x-prefixed-digest>")?;
+	if arguments.next().is_some() {
+		return Err(
+			"expected [--verify-peg-in-state|--verify-pooled-reserve-mint-reservation-state-v4] --trusted-anchor-digest <0x-prefixed-digest>".into(),
+		);
+	}
+	let mut request = Vec::new();
+	io::stdin()
+		.take((MAX_REQUEST_BYTES + 1) as u64)
+		.read_to_end(&mut request)?;
+	match mode {
+		VerificationMode::BurnCheckpoint => {
+			let verified = verify_request_bytes(&request, &trusted_anchor_digest)?;
+			serde_json::to_writer(io::stdout().lock(), &verified)?;
+		}
+		VerificationMode::PegInState => {
+			let verified = bridge_checkpoint_verifier::peg_in::verify_request_bytes(
+				&request,
+				&trusted_anchor_digest,
+			)?;
+			serde_json::to_writer(io::stdout().lock(), &verified)?;
+		}
+		VerificationMode::PooledReserveMintReservationStateV4 => {
+			let verified =
+				bridge_checkpoint_verifier::pooled_reserve_mint_reservation_state_v4::verify_request_bytes(
+					&request,
+					&trusted_anchor_digest,
+				)?;
+			serde_json::to_writer(io::stdout().lock(), &verified)?;
+		}
+	}
+	Ok(())
+}

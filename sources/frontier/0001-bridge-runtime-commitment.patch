+	#[pallet::call]
+	impl<T: Config> Pallet<T> {
+		/// Configure the only EVM contract whose successful PegIn and PegOut logs are accepted.
+		#[pallet::call_index(0)]
+		#[pallet::weight(T::DbWeight::get().reads_writes(5, 5))]
+		pub fn set_bridge_address(origin: OriginFor<T>, address: Option<H160>) -> DispatchResult {
+			ensure_root(origin)?;
+			ensure!(
+				legacy_peg_in_mint_execution_allowed::<T>(),
+				Error::<T>::LegacyPegInProfileMutationBlocked
+			);
+			ensure!(
+				!pooled_reserve_mint_reservation_mode_active::<T>(),
+				Error::<T>::PooledReserveMintReservationProfileFrozen
+			);
+			ensure!(
+				CurrentCausalPegInProfileV2::<T>::get().is_none(),
+				Error::<T>::CausalPegInProfileMustBeDisabled
+			);
+			ensure!(
+				!CausalPegInEnforcementActivatedV2::<T>::get(),
+				Error::<T>::CausalPegInV1ProfileFrozen
+			);
+			ensure!(
+				is_supported_bridge_address(address),
+				Error::<T>::ZeroBridgeAddress
+			);
+			let profile_revision = BridgeProfileRevision::<T>::get()
+				.checked_add(1)
+				.ok_or(ArithmeticError::Overflow)?;
+			BridgeProfileRevision::<T>::put(profile_revision);
+			match address {
+				Some(value) => {
+					let sidechain_id =
+						frame_system::Pallet::<T>::block_hash(BlockNumberFor::<T>::zero());
+					let activation_height =
+						frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+					BridgeAddress::<T>::put(value);
+					CurrentPegInProfile::<T>::put(PegInProfile {
+						format_version: PEG_IN_PROFILE_FORMAT_VERSION,
+						sidechain_id,
+						bridge_address: value,
+						profile_revision,
+						activation_height,
+					});
+					Self::deposit_event(Event::PegInProfileActivated {
+						bridge_address: value,
+						profile_revision,
+						activation_height,
+					});
+				}
+				None => {
+					BridgeAddress::<T>::kill();
+					CurrentPegInProfile::<T>::kill();
+					Self::deposit_event(Event::PegInProfileDisabled { profile_revision });
+				}
+			}
+			CurrentCommitment::<T>::kill();
+			CurrentLeafHashes::<T>::kill();
+			Self::deposit_event(Event::BridgeAddressSet { address });
+			Ok(())
+		}
+
+		/// Activate one exact causal peg-in profile. This does not admit a deposit.
+		#[pallet::call_index(1)]
+		#[pallet::weight(T::MaxCallbackWeight::get())]
+		pub fn set_causal_peg_in_profile(
+			origin: OriginFor<T>,
+			profile: Option<CausalPegInRuntimeProfileV2>,
+		) -> DispatchResult {
+			ensure_root(origin)?;
+			ensure!(
+				!pooled_reserve_mint_reservation_mode_active::<T>(),
+				Error::<T>::PooledReserveMintReservationLegacyPegInModeConflict
+			);
+			if profile.is_some() {
+				ensure!(
+					T::CausalPegInSourceProofProfileActivationAllowed::get(),
+					Error::<T>::CausalPegInSourceProofProfileActivationBlocked
+				);
+			}
+			Self::activate_causal_peg_in_profile(profile)
+		}

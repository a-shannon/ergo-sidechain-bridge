+use std::{
+	io::Write,
+	process::{Command, Output, Stdio},
+};
+
+use bridge_checkpoint_verifier::{
+	pooled_reserve_mint_reservation_state_v4::{
+		NativeFinalizedPooledReserveMintReservationStateVerificationV4, VERIFIED_STATUS,
+	},
+	pooled_reserve_mint_reservation_state_v4_fixture::{
+		deterministic_absent_fixture_request, deterministic_pending_fixture_request,
+		deterministic_trusted_anchor_digest_hex,
+	},
+};
+
+const MODE: &str = "--verify-pooled-reserve-mint-reservation-state-v4";
+
+#[test]
+fn verifies_pending_without_requiring_a_bridge_event_commitment() {
+	let request = serde_json::to_vec(&deterministic_pending_fixture_request()).unwrap();
+	let trusted_digest = deterministic_trusted_anchor_digest_hex();
+	let accepted = run_verifier(
+		&[MODE, "--trusted-anchor-digest", &trusted_digest],
+		&request,
+	);
+	assert!(
+		accepted.status.success(),
+		"{}",
+		String::from_utf8_lossy(&accepted.stderr)
+	);
+	assert!(accepted.stderr.is_empty());
+	let verified: NativeFinalizedPooledReserveMintReservationStateVerificationV4 =
+		serde_json::from_slice(&accepted.stdout).unwrap();
+	assert_eq!(verified.status, VERIFIED_STATUS);
+	assert_eq!(verified.reservation_state.status, "pending");
+	assert!(verified.reservation_state.runtime_code_state_proof_verified);
+	assert!(verified.reservation_state.seven_key_state_proof_verified);
+	assert!(verified.reservation_state.non_authorizing);
+	assert!(!verified.boundary.mint_authorized);
+	assert!(!verified.boundary.signing_enabled);
+	assert!(!verified.boundary.submission_enabled);
+	assert!(!verified.boundary.broadcast_enabled);
+	assert!(!verified.boundary.gate5_closed);
+}
+
+#[test]
+fn verifies_absent_only_as_explicit_non_authorizing_pre_reservation_state() {
+	let request = serde_json::to_vec(&deterministic_absent_fixture_request()).unwrap();
+	let trusted_digest = deterministic_trusted_anchor_digest_hex();
+	let accepted = run_verifier(
+		&[MODE, "--trusted-anchor-digest", &trusted_digest],
+		&request,
+	);
+	assert!(
+		accepted.status.success(),
+		"{}",
+		String::from_utf8_lossy(&accepted.stderr)
+	);
+	let verified: NativeFinalizedPooledReserveMintReservationStateVerificationV4 =
+		serde_json::from_slice(&accepted.stdout).unwrap();
+	assert_eq!(verified.reservation_state.status, "absent");
+	assert!(!verified.reservation_state.pending_index_contains_target);
+	assert!(verified
+		.reservation_state
+		.lifecycle_record_scale_hex
+		.is_none());
+	assert!(verified.reservation_state.non_authorizing);
+	assert!(!verified.boundary.mint_authorized);
+}
+
+#[test]
+fn rejects_wrong_trust_root_runtime_identity_and_wrong_cli_profile_independently() {
+	let canonical = deterministic_pending_fixture_request();
+	let request = serde_json::to_vec(&canonical).unwrap();
+	let wrong_trust = run_verifier(
+		&[
+			MODE,
+			"--trusted-anchor-digest",
+			"0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
+		],
+		&request,
+	);
+	assert!(!wrong_trust.status.success());
+	assert!(wrong_trust.stdout.is_empty());
+
+	let mut wrong_runtime = canonical;
+	wrong_runtime.statement.bridge_runtime_code_sha256_hex =
+		"0xeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee".to_owned();
+	let wrong_runtime = run_verifier(
+		&[
+			MODE,
+			"--trusted-anchor-digest",
+			&deterministic_trusted_anchor_digest_hex(),
+		],
+		&serde_json::to_vec(&wrong_runtime).unwrap(),
+	);
+	assert!(!wrong_runtime.status.success());
+	assert!(wrong_runtime.stdout.is_empty());
+
+	let wrong_profile = run_verifier(
+		&[
+			"--trusted-anchor-digest",
+			&deterministic_trusted_anchor_digest_hex(),
+		],
+		&request,
+	);
+	assert!(!wrong_profile.status.success());
+	assert!(wrong_profile.stdout.is_empty());
+}
+
+fn run_verifier(arguments: &[&str], request: &[u8]) -> Output {
+	let mut child = Command::new(env!("CARGO_BIN_EXE_bridge-checkpoint-verifier"))
+		.args(arguments)
+		.stdin(Stdio::piped())
+		.stdout(Stdio::piped())
+		.stderr(Stdio::piped())
+		.spawn()
+		.unwrap();
+	child.stdin.as_mut().unwrap().write_all(request).unwrap();
+	child.wait_with_output().unwrap()
+}

+fn push_unique_address(addresses: &mut Vec<H160>, address: Option<H160>) {
+	if let Some(address) = address {
+		if !addresses.contains(&address) {
+			addresses.push(address);
+		}
+	}
+}
+
+fn legacy_mint_quarantine_addresses(
+	parent_legacy_address: Option<H160>,
+	bridge_address: Option<H160>,
+	parent_v1_address: Option<H160>,
+	current_v1_address: Option<H160>,
+) -> Vec<H160> {
+	let mut addresses = Vec::new();
+	for address in [
+		parent_legacy_address,
+		bridge_address,
+		parent_v1_address,
+		current_v1_address,
+	] {
+		push_unique_address(&mut addresses, address);
+	}
+	addresses
+}
+
+fn legacy_mint_quarantine_candidates<T: Config>() -> Vec<H160> {
+	legacy_mint_quarantine_addresses(
+		ParentLegacyMintQuarantineAddressV1::<T>::get(),
+		BridgeAddress::<T>::get(),
+		ParentPegInRuntimeProfileSnapshotV1::<T>::get().map(|profile| profile.bridge_address),
+		CurrentPegInProfile::<T>::get().map(|profile| profile.bridge_address),
+	)
+}
+
+fn direct_call_target_and_input(transaction: &Transaction) -> Option<(H160, &[u8])> {
+	let (action, input) = match transaction {
+		Transaction::Legacy(transaction) => (&transaction.action, transaction.input.as_slice()),
+		Transaction::EIP2930(transaction) => (&transaction.action, transaction.input.as_slice()),
+		Transaction::EIP1559(transaction) => (&transaction.action, transaction.input.as_slice()),
+	};
+	match action {
+		TransactionAction::Call(target) => Some((*target, input)),
+		TransactionAction::Create => None,
+	}
+}
+
+fn direct_legacy_mint_target(transaction: &Transaction) -> Option<H160> {
+	let (target, input) = direct_call_target_and_input(transaction)?;
+	(input.len() >= 4 && input[..4] == LEGACY_MINT_SERG_CALL_SELECTOR).then_some(target)
+}
+
+pub(crate) fn direct_legacy_mint_transaction_requires_policy(transaction: &Transaction) -> bool {
+	direct_legacy_mint_target(transaction).is_some()
+}
+
+fn forbidden_direct_legacy_mint_addresses<T: Config>(
+	use_parent_profile_snapshot: bool,
+) -> Result<Vec<H160>, &'static str> {
+	let parent_legacy_address = ParentLegacyMintQuarantineAddressV1::<T>::get();
+	let bridge_address = BridgeAddress::<T>::get();
+	let parent_v1_profile = ParentPegInRuntimeProfileSnapshotV1::<T>::get();
+	let current_v1_profile = CurrentPegInProfile::<T>::get();
+	let mut forbidden = legacy_mint_quarantine_addresses(
+		parent_legacy_address,
+		bridge_address,
+		parent_v1_profile
+			.as_ref()
+			.map(|profile| profile.bridge_address),
+		current_v1_profile
+			.as_ref()
+			.map(|profile| profile.bridge_address),
+	);
+	let (pooled_reserve_profile, causal_profile, v1_profile) = if use_parent_profile_snapshot {
+		(
+			ParentPooledReserveMintReservationProfileSnapshotV4::<T>::get(),
+			ParentCausalPegInProfileSnapshotV2::<T>::get(),
+			parent_v1_profile,
+		)
+	} else {
+		(
+			CurrentPooledReserveMintReservationProfileV4::<T>::get(),
+			CurrentCausalPegInProfileV2::<T>::get(),
+			current_v1_profile,
+		)
+	};
+	let pooled_reserve_enforced = !use_parent_profile_snapshot
+		&& PooledReserveMintReservationEnforcementActivatedV4::<T>::get();
+	let causal_enforced =
+		!use_parent_profile_snapshot && CausalPegInEnforcementActivatedV2::<T>::get();
+	let pooled_reserve_route = pooled_reserve_profile.is_some() || pooled_reserve_enforced;
+	let causal_route = causal_profile.is_some() || causal_enforced;
+
+	if pooled_reserve_route && causal_route {
+		return Err("pooled-reserve and legacy causal peg-in modes cannot coexist");
+	}
+	if pooled_reserve_route {
+		ensure_pooled_reserve_mint_reservation_profile_execution_allowed::<T>()?;
+		if !use_parent_profile_snapshot && !pooled_reserve_enforced {
+			return Err("pooled-reserve profile exists without sticky enforcement");
+		}
+		let active_address = pooled_reserve_profile
+			.ok_or("pooled-reserve route has no active profile")?
+			.bridge_address;
+		forbidden.retain(|address| *address != active_address);
+		return Ok(forbidden);
+	}
+	if causal_route {
+		ensure_causal_peg_in_source_proof_profile_execution_allowed::<T>()?;
+		let mut active_addresses = Vec::new();
+		if let Some(profile) = causal_profile.as_ref() {
+			push_unique_address(
+				&mut active_addresses,
+				Some(decode_admission_profile_v2(&profile.profile_bytes)?.bridge_address),
+			);
+		}
+		if let Some(profile) = v1_profile {
+			push_unique_address(&mut active_addresses, Some(profile.bridge_address));
+		}
+		forbidden.retain(|address| !active_addresses.contains(address));
+		return Ok(forbidden);
+	}
+	if legacy_peg_in_mint_execution_allowed::<T>() {
+		forbidden.clear();
+	}
+	Ok(forbidden)
+}
+
+pub(crate) fn ensure_direct_legacy_mint_transaction_allowed<T: Config>(
+	transaction: &Transaction,
+	use_parent_profile_snapshot: bool,
+) -> Result<(), &'static str> {
+	let Some(target) = direct_legacy_mint_target(transaction) else {
+		return Ok(());
+	};
+	if forbidden_direct_legacy_mint_addresses::<T>(use_parent_profile_snapshot)?.contains(&target) {
+		return Err("direct legacy mint transaction targets a quarantined bridge address");
+	}
+	Ok(())
+}
+
+fn validate_pooled_reserve_mint_reservation_index_v4<T: Config>(
+	target_mint_identity: H256,
+) -> Result<(Vec<H256>, usize), Error<T>> {
+	let pending_keys = validated_pooled_reserve_mint_reservation_index_v4::<T>()?;
+	let indexed = pending_keys.binary_search(&target_mint_identity);
+	let stored = PendingPooledReserveMintReservationsV4::<T>::contains_key(target_mint_identity);
+	match (indexed, stored) {
+		(Ok(_), true) => Err(Error::<T>::PooledReserveMintReservationAlreadyExists),
+		(Err(_), true) | (Ok(_), false) => {
+			Err(Error::<T>::InvalidPooledReserveMintReservationIndex)
+		}
+		(Err(insertion_index), false) => Ok((pending_keys, insertion_index)),
+	}
+}
+
+fn validated_pooled_reserve_mint_reservation_index_v4<T: Config>() -> Result<Vec<H256>, Error<T>> {
+	let pending_keys = PendingPooledReserveMintReservationKeysV4::<T>::get().to_vec();
+	if pending_keys.windows(2).any(|pair| pair[0] >= pair[1]) {
+		return Err(Error::<T>::InvalidPooledReserveMintReservationIndex);
+	}
+	let max_pending = T::MaxPegInsPerBlock::get() as usize;
+	let mut stored_keys = Vec::with_capacity(pending_keys.len());
+	for key in PendingPooledReserveMintReservationsV4::<T>::iter_keys() {
+		if stored_keys.len() >= max_pending {
+			return Err(Error::<T>::InvalidPooledReserveMintReservationIndex);
+		}
+		stored_keys.push(key);
+	}
+	stored_keys.sort_unstable();
+	if stored_keys != pending_keys {
+		return Err(Error::<T>::InvalidPooledReserveMintReservationIndex);
+	}
+	for key in &pending_keys {
+		let pending = PendingPooledReserveMintReservationsV4::<T>::get(key)
+			.ok_or(Error::<T>::InvalidPooledReserveMintReservationIndex)?;
+		if pending.format_version != POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4
+			|| pending.mint_identity != *key
+		{
+			return Err(Error::<T>::InvalidPooledReserveMintReservationIndex);
+		}
+	}
+	Ok(pending_keys)
+}
+
+fn validate_pooled_reserve_mint_reservation_runtime_profile_v4<T: Config>(
+	profile: &PooledReserveMintReservationRuntimeProfileV4,
+	current_height: u64,
+) -> Result<H256, &'static str> {
+	let profile_id = validate_pooled_reserve_mint_reservation_profile_v4(profile)?;
+	if profile.activation_height > current_height {
+		return Err("pooled-reserve mint-reservation profile is not active");
+	}
+	if profile.source_proof_system_id
+		!= T::PooledReserveMintReservationSourceProofVerifier::proof_system_id()
+		|| profile.source_proof_profile_id
+			!= T::PooledReserveMintReservationSourceProofVerifier::proof_profile_id()
+	{
+		return Err("pooled-reserve mint-reservation profile selects an unknown source proof");
+	}
+	Ok(profile_id)
+}
+
+fn validate_pending_pooled_reserve_mint_reservation_v4<T: Config>(
+	profile: &PooledReserveMintReservationRuntimeProfileV4,
+	profile_id: H256,
+	pending: &PendingPooledReserveMintReservationV4,
+	current_height: u64,
+) -> Result<(), Error<T>> {
+	let validated = validate_pooled_reserve_mint_reservation_statement_v4(&pending.statement_bytes)
+		.map_err(|_| Error::<T>::InvalidPooledReserveMintReservationState)?;
+	assert_pooled_reserve_mint_reservation_matches_profile_v4(profile, &validated)
+		.map_err(|_| Error::<T>::InvalidPooledReserveMintReservationState)?;
+	let latest_expiry = pending
+		.reserved_at_native_height
+		.checked_add(u64::from(profile.max_pending_blocks))
+		.ok_or(Error::<T>::InvalidPooledReserveMintReservationState)?;
+	ensure!(
+		pending.format_version == POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4
+			&& pending.profile_id == profile_id
+			&& pending.statement_id == validated.statement_id
+			&& pending.mint_identity == validated.statement.mint_identity
+			&& pending.source_statement_bytes_digest
+				== H256::from(blake2_256(&pending.statement_bytes))
+			&& pending.source_proof_system_id == profile.source_proof_system_id
+			&& pending.source_proof_profile_id == profile.source_proof_profile_id
+			&& pending.source_proof_issued_at_native_height >= profile.activation_height
+			&& pending.source_proof_issued_at_native_height <= pending.reserved_at_native_height
+			&& pending.source_proof_request_digest != H256::zero()
+			&& pending.source_proof_result_id != H256::zero()
+			&& pending.source_proof_digest != H256::zero()
+			&& pending.reserved_at_native_height <= current_height
+			&& pending.expires_at_native_height > pending.reserved_at_native_height
+			&& pending.expires_at_native_height <= latest_expiry,
+		Error::<T>::InvalidPooledReserveMintReservationState
+	);
+	Ok(())
+}
+
+fn snapshot_parent_pooled_reserve_mints_v4<T: Config>() -> Result<(), &'static str> {
+	ensure_pooled_reserve_mint_reservation_profile_execution_allowed::<T>()?;
+	let current_native_height = frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+	let native_parent_height = current_native_height
+		.checked_sub(1)
+		.ok_or("pooled-reserve mint reservation cannot run in the genesis block")?;
+	let native_parent_block_hash = frame_system::Pallet::<T>::parent_hash();
+	if native_parent_block_hash == H256::zero() {
+		return Err("pooled-reserve mint direct-parent block hash must not be zero");
+	}
+	let profile = CurrentPooledReserveMintReservationProfileV4::<T>::get()
+		.ok_or("pooled-reserve enforcement has no active profile")?;
+	let profile_id = validate_pooled_reserve_mint_reservation_runtime_profile_v4::<T>(
+		&profile,
+		current_native_height,
+	)?;
+	if profile.activation_height >= current_native_height {
+		return Err("pooled-reserve mint profile is not active in the direct parent");
+	}
+	if !validate_runtime_code_expectation::<T>(
+		profile.bridge_address,
+		profile.bridge_runtime_code_sha256,
+		profile.bridge_runtime_code_bytes,
+	) || !validate_runtime_code_expectation::<T>(
+		profile.token_address,
+		profile.token_runtime_code_sha256,
+		profile.token_runtime_code_bytes,
+	) {
+		return Err("pooled-reserve mint profile does not match reviewed EVM runtime code");
+	}
+
+	let pending_keys = validated_pooled_reserve_mint_reservation_index_v4::<T>()
+		.map_err(|_| "pooled-reserve mint reservation index is invalid")?;
+	let bridge_owner = decode_address_word(evm_storage_word::<T>(
+		profile.bridge_address,
+		H256::from_low_u64_be(BRIDGE_OWNER_SLOT),
+	))?;
+	let bridge_configuration = evm_storage_word::<T>(
+		profile.bridge_address,
+		H256::from_low_u64_be(BRIDGE_CONFIGURATION_SLOT),
+	);
+	let (configured_token, paused) = decode_bridge_configuration(bridge_configuration)?;
+	let token_owner = decode_address_word(evm_storage_word::<T>(
+		profile.token_address,
+		H256::from_low_u64_be(TOKEN_OWNER_SLOT),
+	))?;
+	if configured_token != profile.token_address || paused || token_owner != profile.bridge_address
+	{
+		return Err("pooled-reserve mint bridge configuration is not active and exact");
+	}
+	let token_total_supply = U256::from_big_endian(
+		evm_storage_word::<T>(
+			profile.token_address,
+			H256::from_low_u64_be(TOKEN_TOTAL_SUPPLY_SLOT),
+		)
+		.as_bytes(),
+	);
+
+	let mut active_keys = Vec::with_capacity(pending_keys.len());
+	let mut snapshots = Vec::with_capacity(pending_keys.len());
+	for mint_identity in pending_keys {
+		let pending = PendingPooledReserveMintReservationsV4::<T>::get(mint_identity)
+			.ok_or("pooled-reserve pending key has no reservation")?;
+		validate_pending_pooled_reserve_mint_reservation_v4::<T>(
+			&profile,
+			profile_id,
+			&pending,
+			current_native_height,
+		)
+		.map_err(|_| "pooled-reserve pending reservation is invalid")?;
+		let validated =
+			validate_pooled_reserve_mint_reservation_statement_v4(&pending.statement_bytes)?;
+		let legacy_mint_identity = derive_legacy_mint_identity_for_reservation_v4(&validated);
+		if ConsumedPooledReserveMintReservationsV4::<T>::contains_key(mint_identity)
+			|| InvalidatedPooledReserveMintReservationsV4::<T>::contains_key(mint_identity)
+			|| legacy_causal_replay_state_exists::<T>(mint_identity)
+			|| legacy_causal_replay_state_exists::<T>(legacy_mint_identity)
+			|| legacy_causal_invalidation_exists::<T>(mint_identity)
+			|| legacy_causal_invalidation_exists::<T>(legacy_mint_identity)
+		{
+			return Err("pooled-reserve mint reservation conflicts with terminal replay state");
+		}
+		if pending.expires_at_native_height <= current_native_height {
+			continue;
+		}
+		if evm_storage_word::<T>(
+			profile.bridge_address,
+			derive_processed_peg_in_mapping_slot(mint_identity),
+		) != H256::zero()
+		{
+			return Err("pooled-reserve Solidity replay marker already exists");
+		}
+		let recipient = validated.statement.source_intent.recipient;
+		let recipient_balance = U256::from_big_endian(
+			evm_storage_word::<T>(
+				profile.token_address,
+				derive_token_balance_mapping_slot(recipient),
+			)
+			.as_bytes(),
+		);
+		active_keys.push(mint_identity);
+		snapshots.push((
+			mint_identity,
+			ParentPooledReserveMintSnapshotV4 {
+				profile_id,
+				pending_blake2b256: H256::from(blake2_256(&pending.encode())),
+				statement_id: validated.statement_id,
+				mint_identity,
+				legacy_mint_identity,
+				recipient,
+				amount: validated.statement.source_intent.amount,
+				bridge_address: profile.bridge_address,
+				token_address: profile.token_address,
+				native_parent_block_hash,
+				native_parent_height,
+				bridge_owner,
+				bridge_configuration,
+				token_owner,
+				token_total_supply,
+				recipient_balance,
+			},
+		));
+	}
+	let active_keys: BoundedVec<H256, T::MaxPegInsPerBlock> = active_keys
+		.try_into()
+		.map_err(|_| "active pooled-reserve mint reservations exceed the runtime bound")?;
+	ParentPooledReserveMintReservationProfileSnapshotV4::<T>::put(&profile);
+	ParentPooledReserveMintSnapshotKeysV4::<T>::put(&active_keys);
+	for (mint_identity, snapshot) in snapshots {
+		ParentPooledReserveMintSnapshotsV4::<T>::insert(mint_identity, snapshot);
+	}
+	Ok(())
+}
+
+fn legacy_causal_invalidation_exists<T: Config>(record_key: H256) -> bool {
+	InvalidatedCausalPegInsV1::<T>::contains_key(record_key)
+}
+
+fn legacy_causal_replay_state_exists<T: Config>(record_key: H256) -> bool {
+	ProcessedPegIns::<T>::contains_key(record_key)
+		|| PendingCausalPegInsV2::<T>::contains_key(record_key)
+		|| CausalPegInAdmissionReceiptsV1::<T>::contains_key(record_key)
+		|| ConsumedCausalPegInsV3::<T>::contains_key(record_key)
+}
+
+fn remove_pending_admission<T: Config>(record_key: H256) -> Result<(), &'static str> {
+	let mut pending_keys = PendingCausalPegInKeys::<T>::get().to_vec();
+	let index = pending_keys
+		.binary_search(&record_key)
+		.map_err(|_| "pending causal admission is absent from the sole ordered index")?;
+	if !PendingCausalPegInsV2::<T>::contains_key(record_key)
+		|| !CausalPegInAdmissionReceiptsV1::<T>::contains_key(record_key)
+	{
+		return Err("pending causal admission map and receipt are incomplete");
+	}
+	pending_keys.remove(index);
+	let pending_keys: BoundedVec<H256, T::MaxPegInsPerBlock> = pending_keys
+		.try_into()
+		.map_err(|_| "remaining causal admission keys exceed the runtime bound")?;
+	PendingCausalPegInsV2::<T>::remove(record_key);
+	CausalPegInAdmissionReceiptsV1::<T>::remove(record_key);
+	PendingCausalPegInKeys::<T>::put(pending_keys);
+	Ok(())
+}

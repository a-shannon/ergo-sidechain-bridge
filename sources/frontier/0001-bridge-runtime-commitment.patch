+//! Strict composed verification for one finalized Frontier peg-in mint transition.
+//!
+//! The request preserves an unchanged T20B event-block contract-state request and adds the exact
+//! direct-parent header plus a bounded parent trie proof. The event block's verified GRANDPA
+//! ancestry authenticates the parent hash. This verifier proves the local pre/post transition but
+//! cannot establish committed-vault eligibility, executable provenance, mint admission, Gate 5
+//! closure, or release readiness.
+
+use bridge_state_proof::{
+	peg_in::derive_processed_peg_in_storage_key_v1,
+	peg_in_frontier_contract_state_v1::{
+		derive_evm_account_storage_key, FrontierRuntimeCodeExpectationV1,
+	},
+	peg_in_frontier_event_v1::verify_frontier_peg_in_event_v1,
+	peg_in_frontier_execution_identity_v1::{
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES,
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+	},
+	peg_in_frontier_mint_transition_v1::{
+		derive_token_balance_mapping_slot, verify_frontier_peg_in_mint_transition_v1,
+		FrontierPegInMintTransitionProofError,
+	},
+};
+use scale_codec::DecodeAll;
+use serde::{Deserialize, Serialize};
+use sp_core::H160;
+use sp_runtime::traits::{BlakeTwo256, Hash as _, Header as _};
+use thiserror::Error;
+
+use crate::{
+	format_bytes, format_hash, parse_byte_hex, parse_decimal_u64, parse_hash,
+	peg_in_frontier_contract_state_v1::{
+		verify_request_bytes as verify_contract_state_request_bytes,
+		EmbeddedFrontierPegInEventVerificationOutput, NativeFrontierPegInContractStateRequest,
+		NativeFrontierPegInContractStateRequestError, NativeFrontierPegInContractStateVerification,
+		VerificationBoundaryOutput as T20bBoundary, VerifiedFrontierPegInContractStateOutput,
+	},
+	peg_in_frontier_execution_identity_v1::{
+		verify_request_bytes_with_context, NativeFrontierExecutionIdentityRequestError,
+	},
+	NativeCheckpointRequestError, NativeHeader, MAX_NATIVE_HEADER_BYTES,
+};
+
+/// Maximum exact UTF-8 JSON bytes accepted by the two-proof transition profile.
+pub const MAX_MINT_TRANSITION_REQUEST_BYTES: usize = 64 * 1024 * 1024;
+/// Stable request schema.
+pub const REQUEST_SCHEMA: &str = "e2s.native-finalized-peg-in-frontier-mint-transition-request.v1";
+/// Stable exact-key statement schema.
+pub const STATEMENT_SCHEMA: &str = "e2s.peg-in-frontier-mint-transition-statement.v1";
+/// Stable successful verification schema.
+pub const VERIFICATION_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-frontier-mint-transition-verification.v1";
+/// Stable status preserving the supplied-trust-root boundary.
+pub const VERIFICATION_STATUS: &str =
+	"NATIVE_PEG_IN_FRONTIER_MINT_TRANSITION_VERIFIED_RELATIVE_TO_SUPPLIED_TRUST_ROOT_DIGEST";
+
+/// Exact derived parent/post keys bound by the request.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct FrontierPegInMintTransitionStatementRequest {
+	/// Exact statement schema.
+	pub schema: String,
+	/// Exact native processed-record key proved absent in the parent.
+	pub parent_native_processed_record_storage_key_hex: String,
+	/// Exact recipient balance top-trie key proved in both states.
+	pub recipient_balance_storage_key_hex: String,
+}
+
+/// One unchanged event-block request plus an exact direct-parent proof.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFrontierPegInMintTransitionRequest {
+	/// Exact outer request schema.
+	pub schema: String,
+	/// Unchanged finalized T20B event-block contract-state request.
+	pub contract_state_request: NativeFrontierPegInContractStateRequest,
+	/// Expected hash of the direct native parent.
+	pub parent_native_block_hash_hex: String,
+	/// Canonical SCALE direct-parent header.
+	pub parent_header_scale_hex: String,
+	/// Raw trie nodes proving the exact parent state surface.
+	pub parent_state_proof_nodes_hex: Vec<String>,
+	/// Exact derived-key statement.
+	pub statement: FrontierPegInMintTransitionStatementRequest,
+}
+
+/// Status-free projection of the unchanged T20B verification.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct EmbeddedFrontierPegInContractStateVerificationOutput {
+	/// Exact nested result schema.
+	pub schema: String,
+	/// Digest of exact canonical nested request bytes.
+	pub request_digest_hex: String,
+	/// Exact supplied trust-anchor digest.
+	pub trust_anchor_digest_hex: String,
+	/// Nested authenticated event report.
+	pub event_verification: EmbeddedFrontierPegInEventVerificationOutput,
+	/// Nested authenticated event-block contract state.
+	pub contract_state: VerifiedFrontierPegInContractStateOutput,
+	/// Unchanged T20B claim boundary.
+	pub boundary: T20bBoundary,
+}
+
+impl From<NativeFrontierPegInContractStateVerification>
+	for EmbeddedFrontierPegInContractStateVerificationOutput
+{
+	fn from(value: NativeFrontierPegInContractStateVerification) -> Self {
+		let NativeFrontierPegInContractStateVerification {
+			schema,
+			status: _,
+			request_digest_hex,
+			trust_anchor_digest_hex,
+			event_verification,
+			contract_state,
+			boundary,
+		} = value;
+		Self {
+			schema,
+			request_digest_hex,
+			trust_anchor_digest_hex,
+			event_verification,
+			contract_state,
+			boundary,
+		}
+	}
+}
+
+/// Exact direct-parent and finalized child identities.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedParentLinkOutput {
+	/// Direct-parent native block hash.
+	pub parent_native_block_hash_hex: String,
+	/// Direct-parent native height.
+	pub parent_native_height: String,
+	/// Direct-parent native state root.
+	pub parent_state_root_hex: String,
+	/// Finalized event-block native hash.
+	pub event_native_block_hash_hex: String,
+	/// Finalized event-block native height.
+	pub event_native_height: String,
+	/// Confirms exact hash linkage and consecutive heights.
+	pub direct_parent_verified: bool,
+}
+
+/// Exact authenticated pre/post transition values.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedMintTransitionOutput {
+	/// Exact native runtime-code SHA-256 in the parent.
+	pub parent_runtime_code_sha256_hex: String,
+	/// Exact native runtime-code byte length in the parent.
+	pub parent_runtime_code_bytes: String,
+	/// Native processed-record key proved absent in the parent.
+	pub parent_native_processed_record_storage_key_hex: String,
+	/// Parent Solidity replay state.
+	pub parent_processed_peg_in: bool,
+	/// Event-block Solidity replay state.
+	pub post_processed_peg_in: bool,
+	/// Parent token supply.
+	pub parent_token_total_supply: String,
+	/// Event-block token supply.
+	pub post_token_total_supply: String,
+	/// Exact supply delta.
+	pub token_total_supply_delta: String,
+	/// Recipient balance mapping slot.
+	pub recipient_balance_slot_hex: String,
+	/// Recipient balance top-trie key.
+	pub recipient_balance_storage_key_hex: String,
+	/// Parent recipient balance.
+	pub parent_recipient_balance: String,
+	/// Event-block recipient balance.
+	pub post_recipient_balance: String,
+	/// Exact recipient-balance delta.
+	pub recipient_balance_delta: String,
+	/// Exact paired mint token.
+	pub mint_token_address_hex: String,
+	/// Exact paired mint transaction hash.
+	pub mint_transaction_hash_hex: String,
+	/// Exact paired mint transaction position.
+	pub mint_transaction_index: usize,
+	/// Exact paired mint receipt-log position.
+	pub mint_transaction_log_index: usize,
+	/// Exact paired mint global log position.
+	pub mint_global_event_index: u32,
+	/// Exact paired mint source, always zero.
+	pub mint_from_address_hex: String,
+	/// Exact paired mint recipient.
+	pub mint_recipient_address_hex: String,
+	/// Exact paired mint raw amount.
+	pub mint_amount: String,
+	/// Parent proof node count.
+	pub parent_proof_node_count: usize,
+	/// Parent proof raw bytes.
+	pub parent_proof_bytes: usize,
+	/// Post proof node count.
+	pub post_proof_node_count: usize,
+	/// Post proof raw bytes.
+	pub post_proof_bytes: usize,
+	/// Confirms every transition check succeeded.
+	pub verified: bool,
+}
+
+/// Explicit non-authorizing boundary for T20C.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerificationBoundaryOutput {
+	/// Finality succeeded relative to the supplied trust root.
+	pub sidechain_finality_verified: bool,
+	/// Direct native parent linkage was verified.
+	pub direct_parent_verified: bool,
+	/// Parent and post-state proofs were verified.
+	pub pre_post_state_verified: bool,
+	/// Exact replay transition was verified.
+	pub replay_transition_verified: bool,
+	/// Exact supply and recipient-balance deltas were verified.
+	pub exact_mint_deltas_verified: bool,
+	/// Exact same-transaction mint log was verified.
+	pub paired_mint_log_verified: bool,
+	/// Single-effect block policy was verified.
+	pub single_token_effect_verified: bool,
+	/// Executable verifier identity is not established here.
+	pub native_verifier_execution_authenticated: bool,
+	/// Reviewed deployment/build lineage is not joined inside Rust.
+	pub reviewed_deployment_lineage_verified: bool,
+	/// The preceding committed-vault transition remains separate.
+	pub committed_vault_transition_verified: bool,
+	/// Historical mint absence before the direct parent remains separate.
+	pub historical_mint_absence_verified: bool,
+	/// This proof cannot authorize mint admission.
+	pub mint_authorized: bool,
+	/// This proof cannot authorize daemon admission.
+	pub daemon_admission_authorized: bool,
+	/// This proof cannot mutate transactions or state.
+	pub transaction_mutation_enabled: bool,
+	/// This proof does not close Gate 5.
+	pub gate5_closed: bool,
+	/// This proof does not establish production readiness.
+	pub production_readiness_verified: bool,
+}
+
+/// Successful direct-parent mint-transition verification.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFrontierPegInMintTransitionVerification {
+	/// Exact result schema.
+	pub schema: String,
+	/// Stable supplied-trust-root status.
+	pub status: String,
+	/// Blake2b-256 digest of exact outer request bytes.
+	pub request_digest_hex: String,
+	/// Exact inherited trust-anchor digest.
+	pub trust_anchor_digest_hex: String,
+	/// Status-free nested T20B verification.
+	pub contract_state_verification: EmbeddedFrontierPegInContractStateVerificationOutput,
+	/// Exact authenticated parent linkage.
+	pub parent_link: VerifiedParentLinkOutput,
+	/// Exact authenticated transition values.
+	pub transition: VerifiedMintTransitionOutput,
+	/// Non-negotiable claim boundary.
+	pub boundary: VerificationBoundaryOutput,
+}
+
+/// A strict outer request or composed transition failure.
+#[derive(Debug, Error)]
+pub enum NativeFrontierPegInMintTransitionRequestError {
+	/// Shared JSON, hex, decimal, or collection parsing failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// Outer request schema did not match V1.
+	#[error("unsupported finalized peg-in Frontier mint-transition request schema")]
+	Schema,
+	/// Statement schema did not match V1.
+	#[error("unsupported peg-in Frontier mint-transition statement schema")]
+	StatementSchema,
+	/// Nested T20B verification failed.
+	#[error(transparent)]
+	ContractState(#[from] NativeFrontierPegInContractStateRequestError),
+	/// Nested execution context reconstruction failed.
+	#[error(transparent)]
+	ExecutionIdentity(#[from] NativeFrontierExecutionIdentityRequestError),
+	/// Canonical nested request serialization failed.
+	#[error("failed to serialize nested contract-state request")]
+	NestedRequestSerialization(#[source] serde_json::Error),
+	/// Parent header SCALE was malformed.
+	#[error("parentHeaderScaleHex is not one canonical native header")]
+	ParentHeaderScale,
+	/// Nested finalized event header SCALE was malformed.
+	#[error("nested targetHeaderScaleHex is not one canonical native header")]
+	EventHeaderScale,
+	/// Parent hash differs from either the request or event header.
+	#[error("supplied parent header is not the finalized event header's exact parent")]
+	ParentHashMismatch,
+	/// Parent and event heights are not consecutive.
+	#[error("supplied parent and finalized event heights are not consecutive")]
+	ParentHeightMismatch,
+	/// One derived statement key differs from the canonical key.
+	#[error("mint-transition statement {field} differs from the canonical key")]
+	StorageKey {
+		/// Stable field identity.
+		field: &'static str,
+	},
+	/// Composed state transition verification failed.
+	#[error(transparent)]
+	Transition(#[from] FrontierPegInMintTransitionProofError),
+}
+
+/// Verify one exact composed request entirely offline and without side effects.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<
+	NativeFrontierPegInMintTransitionVerification,
+	NativeFrontierPegInMintTransitionRequestError,
+> {
+	if raw_request.len() > MAX_MINT_TRANSITION_REQUEST_BYTES {
+		return Err(NativeCheckpointRequestError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_MINT_TRANSITION_REQUEST_BYTES,
+		}
+		.into());
+	}
+	let request: NativeFrontierPegInMintTransitionRequest =
+		serde_json::from_slice(raw_request).map_err(NativeCheckpointRequestError::Json)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativeFrontierPegInMintTransitionRequestError::Schema);
+	}
+	if request.statement.schema != STATEMENT_SCHEMA {
+		return Err(NativeFrontierPegInMintTransitionRequestError::StatementSchema);
+	}
+
+	let nested_request_bytes = serde_json::to_vec(&request.contract_state_request)
+		.map_err(NativeFrontierPegInMintTransitionRequestError::NestedRequestSerialization)?;
+	let nested =
+		verify_contract_state_request_bytes(&nested_request_bytes, trusted_anchor_digest_hex)?;
+	let execution_request = &request
+		.contract_state_request
+		.event_request
+		.execution_identity_request;
+	let execution_request_bytes = serde_json::to_vec(execution_request)
+		.map_err(NativeFrontierPegInMintTransitionRequestError::NestedRequestSerialization)?;
+	let context =
+		verify_request_bytes_with_context(&execution_request_bytes, trusted_anchor_digest_hex)?;
+	let event = verify_frontier_peg_in_event_v1(&context.execution_state, &context.state_nodes)
+		.map_err(FrontierPegInMintTransitionProofError::MintLog)?;
+
+	let event_header_bytes = parse_byte_hex(
+		"contractStateRequest.eventRequest.executionIdentityRequest.targetHeaderScaleHex",
+		&execution_request.target_header_scale_hex,
+		MAX_NATIVE_HEADER_BYTES,
+	)?;
+	let event_header = NativeHeader::decode_all(&mut &event_header_bytes[..])
+		.map_err(|_| NativeFrontierPegInMintTransitionRequestError::EventHeaderScale)?;
+	let parent_hash = parse_hash(
+		"parentNativeBlockHashHex",
+		&request.parent_native_block_hash_hex,
+	)?;
+	let parent_header_bytes = parse_byte_hex(
+		"parentHeaderScaleHex",
+		&request.parent_header_scale_hex,
+		MAX_NATIVE_HEADER_BYTES,
+	)?;
+	let parent_header = NativeHeader::decode_all(&mut &parent_header_bytes[..])
+		.map_err(|_| NativeFrontierPegInMintTransitionRequestError::ParentHeaderScale)?;
+	let expected_event_number = (*parent_header.number())
+		.checked_add(1)
+		.ok_or(NativeFrontierPegInMintTransitionRequestError::ParentHeightMismatch)?;
+	if expected_event_number != *event_header.number() {
+		return Err(NativeFrontierPegInMintTransitionRequestError::ParentHeightMismatch);
+	}
+	if parent_header.hash() != parent_hash || *event_header.parent_hash() != parent_hash {
+		return Err(NativeFrontierPegInMintTransitionRequestError::ParentHashMismatch);
+	}
+
+	let parent_nodes = parse_parent_nodes(&request.parent_state_proof_nodes_hex)?;
+	let bridge_address = parse_address(
+		"contractStateRequest.statement.bridgeAddressHex",
+		&request.contract_state_request.statement.bridge_address_hex,
+	)?;

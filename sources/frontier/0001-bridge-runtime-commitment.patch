+		}
+
+		let mut mutants = Vec::new();
+		let mut mutant = canonical.clone();
+		mutant[0] = 2;
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[KNOWN_BRANCH_COUNT_OFFSET..KNOWN_BRANCH_COUNT_OFFSET + 2].fill(0);
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[TARGET_BLOCK_VERSION_OFFSET] = 5;
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[CONFIRMATIONS_OFFSET..CONFIRMATIONS_OFFSET + 4].fill(0);
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[TRANSACTION_COUNT_OFFSET..TRANSACTION_COUNT_OFFSET + 4].fill(0);
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[COMMITTED_TRANSACTION_ID_OFFSET] ^= 1;
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[SOURCE_INPUT_COUNT_OFFSET] = 2;
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[VAULT_OUTPUT_INDEX_OFFSET + 3] = 1;
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[ASSET_ID_OFFSET] = 1;
+		mutants.push(mutant);
+		let mut mutant = canonical.clone();
+		mutant[AMOUNT_OFFSET..AMOUNT_OFFSET + 8].fill(0);
+		mutants.push(mutant);
+		for mutant in mutants {
+			assert!(validate_ergo_autolykos_committed_vault_statement_v1(&mutant).is_err());
+		}
+	}
+}

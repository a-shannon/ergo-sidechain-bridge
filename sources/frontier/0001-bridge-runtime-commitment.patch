+//! Exact V4 pooled-reserve mint-reservation state under one authenticated native state root.
+//!
+//! This module verifies runtime code identity plus six V4 storage surfaces in one trie proof.
+//! It classifies authenticated state but never authorizes mint, signing, submission, or broadcast.
+
+use scale_codec::{Decode, DecodeAll, Encode};
+use sp_core::{blake2_128, hashing::blake2_256, sha2_256, twox_128, H160, H256};
+use sp_runtime::traits::BlakeTwo256;
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+const PALLET_NAME: &[u8] = b"BridgeCommitment";
+const CURRENT_PROFILE: &[u8] = b"CurrentPooledReserveMintReservationProfileV4";
+const ENFORCEMENT: &[u8] = b"PooledReserveMintReservationEnforcementActivatedV4";
+const PENDING_KEYS: &[u8] = b"PendingPooledReserveMintReservationKeysV4";
+const PENDING_RESERVATIONS: &[u8] = b"PendingPooledReserveMintReservationsV4";
+const CONSUMED_RESERVATIONS: &[u8] = b"ConsumedPooledReserveMintReservationsV4";
+const INVALIDATED_RESERVATIONS: &[u8] = b"InvalidatedPooledReserveMintReservationsV4";
+const STATEMENT_ID_DOMAIN: &[u8] = b"E2S_POOLED_RESERVE_MINT_RESERVATION_V4";
+const PROFILE_ID_DOMAIN: &[u8] = b"E2S_POOLED_RESERVE_MINT_RESERVATION_PROFILE_V4";
+const SOURCE_INTENT_ID_DOMAIN: &[u8] = b"E2S_PEG_IN_SOURCE_INTENT_V2";
+const MINT_ID_DOMAIN: &[u8] = b"E2S_PEG_IN_MINT_ID_V4";
+
+/// Raw Substrate runtime-code storage key.
+pub const RUNTIME_CODE_STORAGE_KEY: &[u8] = b":code";
+/// Fixed V4 reservation statement size.
+pub const POOLED_RESERVE_MINT_RESERVATION_STATEMENT_V4_BYTES: usize = 603;
+/// Maximum pending identities accepted from the pinned runtime profile.
+pub const MAX_PENDING_POOLED_RESERVE_MINT_RESERVATIONS_V4: usize = 256;
+/// Maximum authenticated runtime-code bytes accepted by the V4 proof.
+pub const MAX_POOLED_RESERVE_MINT_RESERVATION_RUNTIME_CODE_BYTES: usize = 4 * 1024 * 1024;
+/// Maximum raw trie nodes accepted for the seven-key V4 proof.
+pub const MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODES: usize = 512;
+/// Maximum aggregate trie proof bytes.
+pub const MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_BYTES: usize = 8 * 1024 * 1024;
+/// Maximum individual trie node bytes.
+pub const MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODE_BYTES: usize = 4 * 1024 * 1024;
+
+/// Exact SCALE profile stored by the pinned V4 runtime.
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+pub struct PooledReserveMintReservationRuntimeProfileV4 {
+	/// Wire format version.
+	pub format_version: u8,
+	/// Immutable reservation-lineage profile.
+	pub lineage_profile_id: H256,
+	/// Ergo source-network identity.
+	pub source_network_id: H256,
+	/// Native sidechain identity.
+	pub sidechain_id: H256,
+	/// Frontier bridge contract.
+	pub bridge_address: H160,
+	/// Frontier token contract.
+	pub token_address: H160,
+	/// Exact reviewed Frontier bridge runtime-code digest.
+	pub bridge_runtime_code_sha256: H256,
+	/// Exact reviewed Frontier bridge runtime-code length.
+	pub bridge_runtime_code_bytes: u32,
+	/// Exact reviewed Frontier token runtime-code digest.
+	pub token_runtime_code_sha256: H256,
+	/// Exact reviewed Frontier token runtime-code length.
+	pub token_runtime_code_bytes: u32,
+	/// Ergo settlement profile.
+	pub settlement_profile_id: H256,
+	/// Ergo deposit-finality policy.
+	pub ergo_deposit_finality_policy_id: H256,
+	/// Statically registered source-proof system.
+	pub source_proof_system_id: H256,
+	/// Statically registered source-proof profile.
+	pub source_proof_profile_id: H256,
+	/// First native height at which the profile applies.
+	pub activation_height: u64,
+	/// Maximum pending reservation lifetime.
+	pub max_pending_blocks: u32,
+}
+
+/// Exact SCALE pending reservation stored by the pinned V4 runtime.
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+pub struct PendingPooledReserveMintReservationV4 {
+	/// Wire format version.
+	pub format_version: u8,
+	/// Active profile identity.
+	pub profile_id: H256,
+	/// Exact 603-byte reservation statement.
+	pub statement_bytes: Vec<u8>,
+	/// Domain-separated statement identity.
+	pub statement_id: H256,
+	/// Permanent mint reservation identity.
+	pub mint_identity: H256,
+	/// Blake2b-256 digest of `statement_bytes`.
+	pub source_statement_bytes_digest: H256,
+	/// Source-proof system identity.
+	pub source_proof_system_id: H256,
+	/// Source-proof profile identity.
+	pub source_proof_profile_id: H256,
+	/// Native height bound into the source-proof result.
+	pub source_proof_issued_at_native_height: u64,
+	/// Exact source-proof request digest.
+	pub source_proof_request_digest: H256,
+	/// Exact source-proof result identity.
+	pub source_proof_result_id: H256,
+	/// Exact source-proof envelope digest.
+	pub source_proof_digest: H256,
+	/// Native reservation height.
+	pub reserved_at_native_height: u64,
+	/// Terminal native height for this pending reservation.
+	pub expires_at_native_height: u64,
+}
+
+/// Exact SCALE consumed reservation stored by the pinned V4 runtime.
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+pub struct ConsumedPooledReserveMintReservationV4 {
+	/// Wire format version.
+	pub format_version: u8,
+	/// Active profile identity.
+	pub profile_id: H256,
+	/// Domain-separated statement identity.
+	pub statement_id: H256,
+	/// Permanent mint reservation identity.
+	pub mint_identity: H256,
+	/// Native consumption height.
+	pub consumed_at_native_height: u64,
+	/// Frontier execution block containing the mint.
+	pub execution_block_hash: H256,
+	/// Frontier transaction containing the mint.
+	pub transaction_hash: H256,
+	/// Global event position.
+	pub event_index: u32,
+}
+
+/// Exact SCALE invalidated reservation stored by the pinned V4 runtime.
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+pub struct InvalidatedPooledReserveMintReservationV4 {
+	/// Wire format version.
+	pub format_version: u8,
+	/// Active profile identity.
+	pub profile_id: H256,
+	/// Domain-separated statement identity.
+	pub statement_id: H256,
+	/// Permanent mint reservation identity.
+	pub mint_identity: H256,
+	/// Native invalidation height.
+	pub invalidated_at_native_height: u64,
+	/// Versioned nonzero invalidation reason.
+	pub reason_code: u8,
+	/// Permanent invalidation identity.
+	pub invalidation_id: H256,
+}
+
+/// Caller-supplied exact storage keys that must match deterministic derivation.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct PooledReserveMintReservationStateStorageKeysV4 {
+	/// Active profile `StorageValue` key.
+	pub current_profile: Vec<u8>,
+	/// Sticky enforcement `StorageValue` key.
+	pub enforcement: Vec<u8>,
+	/// Ordered pending-key index `StorageValue` key.
+	pub pending_keys: Vec<u8>,
+	/// Target pending map key.
+	pub pending_reservation: Vec<u8>,
+	/// Target consumed map key.
+	pub consumed_reservation: Vec<u8>,
+	/// Target invalidated map key.
+	pub invalidated_reservation: Vec<u8>,
+}
+
+/// Validated identities parsed from the exact 603-byte statement.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ValidatedPooledReserveMintReservationStatementV4 {
+	/// Exact statement bytes.
+	pub statement_bytes: Vec<u8>,
+	/// Domain-separated statement identity.
+	pub statement_id: H256,
+	/// Permanent reservation and mint identity.
+	pub mint_identity: H256,
+	/// Immutable reservation-lineage profile.
+	pub lineage_profile_id: H256,
+	/// Ergo source-network identity.
+	pub source_network_id: H256,
+	/// Native sidechain identity.
+	pub sidechain_id: H256,
+	/// Frontier bridge contract.
+	pub bridge_address: H160,
+	/// Frontier token contract.
+	pub token_address: H160,
+	/// Ergo settlement profile.
+	pub settlement_profile_id: H256,
+	/// Ergo deposit-finality policy.
+	pub ergo_deposit_finality_policy_id: H256,
+}
+
+/// Mutually exclusive authenticated lifecycle state.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum PooledReserveMintReservationStateV4 {
+	/// No target lifecycle record exists; this is a non-authorizing pre-reservation state.
+	Absent,
+	/// One exact pending reservation exists and appears exactly once in the ordered index.
+	Pending(PendingPooledReserveMintReservationV4),
+	/// One exact terminal consumed record exists and is absent from the pending index.
+	Consumed(ConsumedPooledReserveMintReservationV4),
+	/// One exact terminal invalidation record exists and is absent from the pending index.
+	Invalidated(InvalidatedPooledReserveMintReservationV4),
+}
+
+impl PooledReserveMintReservationStateV4 {
+	/// Stable lowercase lifecycle label.
+	pub fn status(&self) -> &'static str {
+		match self {
+			Self::Absent => "absent",
+			Self::Pending(_) => "pending",
+			Self::Consumed(_) => "consumed",
+			Self::Invalidated(_) => "invalidated",
+		}
+	}
+}
+
+/// Authenticated V4 state result. It classifies state and grants no funds authority.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct VerifiedPooledReserveMintReservationStateV4 {
+	/// Exact authenticated native state root.
+	pub state_root: H256,
+	/// Exact target statement identities.
+	pub statement: ValidatedPooledReserveMintReservationStatementV4,
+	/// Canonical active runtime profile.
+	pub profile: PooledReserveMintReservationRuntimeProfileV4,
+	/// Domain-separated active profile identity.
+	pub profile_id: H256,
+	/// Sticky V4 enforcement flag.
+	pub enforcement_active: bool,
+	/// Strictly ascending pending index.
+	pub pending_keys: Vec<H256>,
+	/// Mutually exclusive target lifecycle classification.
+	pub reservation_state: PooledReserveMintReservationStateV4,
+	/// Runtime code SHA-256 authenticated by the same trie proof.
+	pub runtime_code_sha256: H256,
+	/// Runtime code byte length authenticated by the same trie proof.
+	pub runtime_code_bytes: usize,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate bounded trie-node bytes consumed.
+	pub proof_bytes: usize,
+}
+
+/// One exact V4 state-proof rejection.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum PooledReserveMintReservationStateProofErrorV4 {
+	/// The proof is empty.
+	#[error("pooled-reserve V4 state proof is empty")]
+	EmptyProof,
+	/// The proof contains too many nodes.
+	#[error("pooled-reserve V4 state proof contains too many nodes: {actual} > {max}")]
+	TooManyNodes {
+		/// Supplied count.
+		actual: usize,
+		/// Maximum count.
+		max: usize,
+	},
+	/// One proof node is too large.
+	#[error("pooled-reserve V4 state proof node {index} exceeds {max} bytes: {actual}")]
+	NodeTooLarge {
+		/// Node index.
+		index: usize,
+		/// Supplied bytes.
+		actual: usize,
+		/// Maximum bytes.
+		max: usize,
+	},
+	/// The aggregate proof is too large.
+	#[error("pooled-reserve V4 state proof exceeds {max} bytes: {actual}")]
+	ProofTooLarge {
+		/// Supplied bytes.
+		actual: usize,
+		/// Maximum bytes.
+		max: usize,
+	},
+	/// The raw proof repeats one encoded trie node.
+	#[error("pooled-reserve V4 state proof contains duplicate nodes")]
+	DuplicateNodes,
+	/// The seven exact reads cannot be reconstructed under the authenticated root.
+	#[error("pooled-reserve V4 seven-key proof is invalid for the authenticated state root")]
+	InvalidProof,
+	/// A caller-supplied storage key differs from deterministic derivation.
+	#[error("pooled-reserve V4 storage key does not match deterministic derivation: {field}")]
+	StorageKeyMismatch {
+		/// Stable key field.
+		field: &'static str,
+	},
+	/// Runtime code is absent.
+	#[error("pooled-reserve V4 runtime code is absent")]
+	RuntimeCodeMissing,
+	/// The expected runtime code exceeds the bounded verifier contract.
+	#[error("pooled-reserve V4 runtime code exceeds {max} bytes: {actual}")]
+	RuntimeCodeTooLarge {
+		/// Supplied expected byte length.
+		actual: usize,
+		/// Maximum accepted byte length.
+		max: usize,
+	},
+	/// Runtime code does not match exact expected bytes or SHA-256.
+	#[error("pooled-reserve V4 runtime code identity mismatch")]
+	RuntimeCodeMismatch,
+	/// Active V4 profile is absent.
+	#[error("pooled-reserve V4 active profile is absent")]
+	ProfileMissing,
+	/// One SCALE value is malformed or noncanonical.
+	#[error("pooled-reserve V4 {field} SCALE value is malformed")]
+	MalformedScale {
+		/// Stable field label.
+		field: &'static str,
+	},
+	/// The active profile is malformed, inactive, or inconsistent with the statement.
+	#[error("pooled-reserve V4 active profile is invalid or does not match the statement")]
+	ProfileMismatch,
+	/// Sticky V4 enforcement is absent or false.
+	#[error("pooled-reserve V4 enforcement is not active")]
+	EnforcementInactive,
+	/// The 603-byte statement, ID, or reservation key is malformed or inconsistent.
+	#[error("pooled-reserve V4 statement identity is invalid")]
+	StatementMismatch,
+	/// The pending index is too large, unordered, duplicated, or contains zero.
+	#[error("pooled-reserve V4 pending index is invalid")]
+	PendingIndexInvalid,
+	/// More than one target lifecycle map contains a value.
+	#[error("pooled-reserve V4 target lifecycle state is not mutually exclusive")]
+	StateConflict,
+	/// Pending state is not listed exactly once, or absent/terminal state remains listed.
+	#[error("pooled-reserve V4 target lifecycle state conflicts with the pending index")]
+	IndexStateConflict,
+	/// The pending record is not exactly bound to statement, profile, and lifecycle constraints.
+	#[error("pooled-reserve V4 pending record is inconsistent")]
+	PendingRecordMismatch,
+	/// The consumed record is not exactly bound to statement and profile.
+	#[error("pooled-reserve V4 consumed record is inconsistent")]
+	ConsumedRecordMismatch,
+	/// The invalidated record is not exactly bound to statement and profile.
+	#[error("pooled-reserve V4 invalidated record is inconsistent")]
+	InvalidatedRecordMismatch,
+}

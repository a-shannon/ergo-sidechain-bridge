diff --git a/bridge/checkpoint-verifier/src/bin/bridge-peg-in-causal-mint-transition-v2-verifier.rs b/bridge/checkpoint-verifier/src/bin/bridge-peg-in-causal-mint-transition-v2-verifier.rs

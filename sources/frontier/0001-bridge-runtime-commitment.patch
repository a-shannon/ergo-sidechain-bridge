+
+		let trailing = RpcWarpInspectionRequest {
+			schema: WARP_INSPECTION_REQUEST_SCHEMA.to_owned(),
+			proof_scale_hex: format!("{}00", source_warp_proof_hex()),
+			finality_horizon_number: "1026".to_owned(),
+		};
+		assert!(matches!(
+			inspect_rpc_warp_proof_request_bytes(&serde_json::to_vec(&trailing).unwrap()),
+			Err(RpcProofCodecError::Warp(
+				BridgeAuthorityTransitionError::ProofDecode
+			))
+		));

@@ -0,0 +1,1019 @@
+//! Finalized native-state proof profile for one processed peg-in and its Frontier block.
+//!
+//! The profile reads the exact Substrate runtime `:code` value and
+//! `Ethereum::CurrentBlock` plus one exact `ProcessedPegIns` record from one authenticated native
+//! state root. It binds the record's execution hash, transaction hash, and height to the decoded
+//! Frontier block while preserving the native and execution hashes as separate identities.
+//! Receipts, transaction statuses, EVM account/code/storage state, historical absence, and funds
+//! authority remain separate proof obligations.
+
+use bridge_finality_proof::{
+	verify_grandpa_finality_proof, BridgeFinalityProofError, VerifiedGrandpaFinalityProof,
+};
+use ethereum::BlockV2;
+use scale_codec::DecodeAll;
+use sp_consensus_grandpa::{AuthorityList, SetId};
+use sp_core::{sha2_256, twox_128, H256};
+use sp_runtime::traits::{BlakeTwo256, Block as BlockT, CheckedAdd, Header as HeaderT};
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+use crate::{
+	peg_in::{
+		derive_processed_peg_in_storage_key_v1, validate_record, PegInRuntimeRecordV1,
+		PegInStateProofError, PEG_IN_RECORD_V1_SCALE_BYTES, PROCESSED_PEG_IN_STORAGE_KEY_BYTES,
+	},
+	peg_in_runtime_identity_v2::{RuntimeCodeExpectationV2, RUNTIME_CODE_STORAGE_KEY},
+};
+
+/// Maximum raw `Ethereum::CurrentBlock` SCALE bytes accepted by this profile.
+pub const MAX_FRONTIER_CURRENT_BLOCK_SCALE_BYTES: usize = 8 * 1024 * 1024;
+/// Maximum trie nodes accepted by the three-key execution-identity profile.
+pub const MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES: usize = 512;
+/// Maximum aggregate trie-node bytes accepted by the execution-identity profile.
+pub const MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES: usize = 12 * 1024 * 1024;
+/// Maximum individual trie-node size accepted by the execution-identity profile.
+pub const MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES: usize = 8 * 1024 * 1024;
+
+/// Derive the exact top-trie key for `Ethereum::CurrentBlock`.
+pub fn derive_ethereum_current_block_storage_key() -> [u8; 32] {
+	let mut key = [0u8; 32];
+	key[..16].copy_from_slice(&twox_128(b"Ethereum"));
+	key[16..].copy_from_slice(&twox_128(b"CurrentBlock"));
+	key
+}
+
+/// A reason the Frontier execution-identity proof was rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum FrontierExecutionIdentityProofError {
+	/// No trie nodes were supplied.
+	#[error("Frontier execution identity proof is empty")]
+	EmptyProof,
+	/// The proof contains more nodes than the profile permits.
+	#[error("Frontier execution identity proof contains too many nodes: {actual} > {max}")]
+	TooManyNodes {
+		/// Supplied node count.
+		actual: usize,
+		/// Configured maximum node count.
+		max: usize,
+	},
+	/// One trie node exceeds the per-node byte limit.
+	#[error("Frontier execution identity proof node {index} exceeds {max} bytes: {actual}")]
+	NodeTooLarge {
+		/// Zero-based node index.
+		index: usize,
+		/// Supplied node size.
+		actual: usize,
+		/// Configured maximum node size.
+		max: usize,
+	},
+	/// The aggregate trie proof exceeds the byte limit.
+	#[error("Frontier execution identity proof exceeds {max} bytes: {actual}")]
+	ProofTooLarge {
+		/// Supplied aggregate node bytes.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// The raw proof repeats an encoded trie node.
+	#[error("Frontier execution identity proof contains duplicate nodes")]
+	DuplicateNodes,
+	/// The supplied nodes do not reconstruct all three exact reads under the state root.
+	#[error("Frontier execution identity proof is invalid for the authenticated state root")]
+	InvalidProof,
+	/// The expected runtime artifact digest is zero.
+	#[error("expected runtime code SHA-256 digest is zero")]
+	ZeroRuntimeCodeDigest,
+	/// The expected runtime artifact size is zero.
+	#[error("expected runtime code size is zero")]
+	ZeroRuntimeCodeSize,
+	/// The expected runtime artifact exceeds the shared runtime profile.
+	#[error("expected runtime code exceeds {max} bytes: {actual}")]
+	ExpectedRuntimeCodeTooLarge {
+		/// Statement-bound byte length.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// The expected processed-deposit record is invalid for this target.
+	#[error(transparent)]
+	PegInRecord(#[from] PegInStateProofError),
+	/// The `:code` key was absent from the authenticated native state.
+	#[error("runtime code is absent from authenticated native state")]
+	RuntimeCodeMissing,
+	/// The authenticated `:code` value was empty.
+	#[error("authenticated runtime code is empty")]
+	RuntimeCodeEmpty,
+	/// The authenticated runtime size differs from the expected statement.
+	#[error("authenticated runtime code size differs from the expected statement")]
+	RuntimeCodeSizeMismatch,
+	/// The authenticated runtime digest differs from the expected statement.
+	#[error("authenticated runtime code SHA-256 differs from the expected statement")]
+	RuntimeCodeDigestMismatch,
+	/// The derived processed-deposit key was absent from authenticated native state.
+	#[error("processed peg-in record is absent from authenticated native state")]
+	RecordMissing,
+	/// The authenticated record storage value has the wrong fixed width.
+	#[error("processed peg-in record SCALE value must be exactly {expected} bytes, got {actual}")]
+	RecordLength {
+		/// Authenticated byte length.
+		actual: usize,
+		/// Required fixed-width record length.
+		expected: usize,
+	},
+	/// The authenticated record is not canonical V1 SCALE.
+	#[error("processed peg-in record SCALE value is malformed")]
+	RecordDecode,
+	/// The authenticated record differs from the exact expected record.
+	#[error("authenticated processed peg-in record differs from the expected statement")]
+	RecordMismatch,
+	/// This profile must target the exact native state produced at the record height.
+	#[error("processed peg-in record height differs from the native target height")]
+	RecordHeightMismatch,
+	/// `Ethereum::CurrentBlock` was absent from authenticated native state.
+	#[error("Ethereum::CurrentBlock is absent from authenticated native state")]
+	CurrentBlockMissing,
+	/// The authenticated `CurrentBlock` value was empty.
+	#[error("authenticated Ethereum::CurrentBlock is empty")]
+	CurrentBlockEmpty,
+	/// The authenticated `CurrentBlock` value exceeds the profile limit.
+	#[error("authenticated Ethereum::CurrentBlock exceeds {max} bytes: {actual}")]
+	CurrentBlockTooLarge {
+		/// Authenticated byte length.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// The authenticated value is not one canonical SCALE `ethereum::BlockV2`.
+	#[error("authenticated Ethereum::CurrentBlock SCALE value is malformed")]
+	CurrentBlockDecode,
+	/// The block's transaction vector does not reproduce the header transaction root.
+	#[error("authenticated Ethereum::CurrentBlock transaction root is inconsistent")]
+	TransactionRootMismatch,
+	/// The block's ommer vector does not reproduce the header ommers hash.
+	#[error("authenticated Ethereum::CurrentBlock ommers hash is inconsistent")]
+	OmmersHashMismatch,
+	/// The decoded Frontier block number differs from the authenticated native height.
+	#[error("authenticated Frontier block height differs from the native state height")]
+	ExecutionHeightMismatch,
+	/// The decoded Frontier header hash differs from the expected execution identity.
+	#[error("authenticated Frontier block hash differs from the expected execution identity")]
+	ExecutionBlockHashMismatch,
+	/// The record transaction is absent from the authenticated Frontier block.
+	#[error("processed peg-in transaction is absent from authenticated Ethereum::CurrentBlock")]
+	RecordTransactionMissing,
+	/// The record transaction appears more than once in the authenticated Frontier block.
+	#[error("processed peg-in transaction is duplicated in authenticated Ethereum::CurrentBlock")]
+	RecordTransactionDuplicated,
+}
+
+/// A finalized execution-identity verification failure, preserving the owning layer.
+#[derive(Debug, Error)]
+pub enum FinalizedFrontierExecutionIdentityProofError {
+	/// GRANDPA signatures, ancestry, or exact target binding failed.
+	#[error(transparent)]
+	Finality(#[from] BridgeFinalityProofError),
+	/// Runtime-code or Frontier current-block state verification failed.
+	#[error(transparent)]
+	State(#[from] FrontierExecutionIdentityProofError),
+}
+
+/// Exact runtime and Frontier block identities recovered from one native state root.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedFrontierExecutionIdentityV1 {
+	/// State root used for trie verification.
+	pub state_root: H256,
+	/// Exact raw Substrate `:code` key queried by the verifier.
+	pub runtime_code_storage_key: [u8; 5],
+	/// SHA-256 of the authenticated raw runtime Wasm.
+	pub runtime_code_sha256: [u8; 32],
+	/// Exact authenticated raw runtime Wasm byte length.
+	pub runtime_code_size_bytes: usize,
+	/// Exact top-trie key for `Ethereum::CurrentBlock`.
+	pub current_block_storage_key: [u8; 32],
+	/// Exact derived `ProcessedPegIns` key queried by the verifier.
+	pub record_storage_key: [u8; PROCESSED_PEG_IN_STORAGE_KEY_BYTES],
+	/// Exact authenticated processed-deposit record.
+	pub record: PegInRuntimeRecordV1,
+	/// SHA-256 of the exact authenticated `CurrentBlock` SCALE value.
+	pub current_block_scale_sha256: [u8; 32],
+	/// Exact authenticated `CurrentBlock` SCALE byte length.
+	pub current_block_scale_bytes: usize,
+	/// Canonically decoded Frontier block.
+	pub current_block: BlockV2,
+	/// Recomputed Frontier execution-block hash.
+	pub execution_block_hash: H256,
+	/// Zero-based position of the record transaction in the authenticated block.
+	pub record_transaction_index: usize,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+}
+
+/// Frontier execution identity whose native header is finalized under the supplied GRANDPA set.
+#[derive(Debug)]
+pub struct VerifiedFinalizedFrontierExecutionIdentityV1<Block: BlockT> {
+	/// Full requested native header whose hash, number, ancestry, and state root were checked.
+	pub requested_header: Block::Header,
+	/// Native GRANDPA proof ending at an authenticated finalized target.
+	pub finality: VerifiedGrandpaFinalityProof<Block>,
+	/// Exact runtime and Frontier current-block state from the requested native state root.
+	pub state: VerifiedFrontierExecutionIdentityV1,
+}
+
+/// Verify exact runtime code and `Ethereum::CurrentBlock` in one native trie proof.
+pub fn verify_frontier_execution_identity_v1(
+	state_root: H256,
+	authenticated_native_height: u64,
+	expected_sidechain_id: H256,
+	expected_ergo_box_id: H256,
+	runtime_code: RuntimeCodeExpectationV2,
+	expected_record: &PegInRuntimeRecordV1,
+	proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedFrontierExecutionIdentityV1, FrontierExecutionIdentityProofError> {
+	validate_expectation(
+		runtime_code,
+		expected_sidechain_id,
+		expected_ergo_box_id,
+		authenticated_native_height,
+		expected_record,
+	)?;
+	let proof_bytes = validate_proof_bounds(proof_nodes)?;
+	let current_block_storage_key = derive_ethereum_current_block_storage_key();
+	let record_storage_key =
+		derive_processed_peg_in_storage_key_v1(expected_sidechain_id, expected_ergo_box_id);
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let values = read_proof_check::<BlakeTwo256, _>(
+		state_root,
+		proof,
+		[
+			RUNTIME_CODE_STORAGE_KEY.as_slice(),
+			current_block_storage_key.as_slice(),
+			record_storage_key.as_slice(),
+		],
+	)
+	.map_err(|_| FrontierExecutionIdentityProofError::InvalidProof)?;
+
+	let raw_runtime_code = values
+		.get(RUNTIME_CODE_STORAGE_KEY.as_slice())
+		.and_then(|value| value.as_ref())
+		.ok_or(FrontierExecutionIdentityProofError::RuntimeCodeMissing)?;
+	if raw_runtime_code.is_empty() {
+		return Err(FrontierExecutionIdentityProofError::RuntimeCodeEmpty);
+	}
+	if raw_runtime_code.len() != runtime_code.artifact_size_bytes {
+		return Err(FrontierExecutionIdentityProofError::RuntimeCodeSizeMismatch);
+	}
+	let runtime_code_sha256 = sha2_256(raw_runtime_code);
+	if runtime_code_sha256 != runtime_code.artifact_sha256 {
+		return Err(FrontierExecutionIdentityProofError::RuntimeCodeDigestMismatch);
+	}
+
+	let raw_record = values
+		.get(record_storage_key.as_slice())
+		.and_then(|value| value.as_ref())
+		.ok_or(FrontierExecutionIdentityProofError::RecordMissing)?;
+	if raw_record.len() != PEG_IN_RECORD_V1_SCALE_BYTES {
+		return Err(FrontierExecutionIdentityProofError::RecordLength {
+			actual: raw_record.len(),
+			expected: PEG_IN_RECORD_V1_SCALE_BYTES,
+		});
+	}
+	let record = PegInRuntimeRecordV1::decode_all(&mut &raw_record[..])
+		.map_err(|_| FrontierExecutionIdentityProofError::RecordDecode)?;
+	validate_record(
+		&record,
+		expected_sidechain_id,
+		expected_ergo_box_id,
+		authenticated_native_height,
+	)?;
+	if &record != expected_record {
+		return Err(FrontierExecutionIdentityProofError::RecordMismatch);
+	}
+	if record.sidechain_height != authenticated_native_height {
+		return Err(FrontierExecutionIdentityProofError::RecordHeightMismatch);
+	}
+
+	let raw_current_block = values
+		.get(current_block_storage_key.as_slice())
+		.and_then(|value| value.as_ref())
+		.ok_or(FrontierExecutionIdentityProofError::CurrentBlockMissing)?;
+	if raw_current_block.is_empty() {
+		return Err(FrontierExecutionIdentityProofError::CurrentBlockEmpty);
+	}
+	if raw_current_block.len() > MAX_FRONTIER_CURRENT_BLOCK_SCALE_BYTES {
+		return Err(FrontierExecutionIdentityProofError::CurrentBlockTooLarge {
+			actual: raw_current_block.len(),
+			max: MAX_FRONTIER_CURRENT_BLOCK_SCALE_BYTES,
+		});
+	}
+	let current_block = BlockV2::decode_all(&mut &raw_current_block[..])
+		.map_err(|_| FrontierExecutionIdentityProofError::CurrentBlockDecode)?;
+	let internally_recomputed = BlockV2::new(
+		current_block.header.clone().into(),
+		current_block.transactions.clone(),
+		current_block.ommers.clone(),
+	);
+	if internally_recomputed.header.transactions_root != current_block.header.transactions_root {
+		return Err(FrontierExecutionIdentityProofError::TransactionRootMismatch);
+	}
+	if internally_recomputed.header.ommers_hash != current_block.header.ommers_hash {
+		return Err(FrontierExecutionIdentityProofError::OmmersHashMismatch);
+	}
+	if current_block.header.number != authenticated_native_height.into() {
+		return Err(FrontierExecutionIdentityProofError::ExecutionHeightMismatch);
+	}
+	let execution_block_hash = current_block.header.hash();
+	if execution_block_hash != record.execution_block_hash {
+		return Err(FrontierExecutionIdentityProofError::ExecutionBlockHashMismatch);
+	}
+	let matching_transaction_indexes = current_block
+		.transactions
+		.iter()
+		.enumerate()
+		.filter_map(|(index, transaction)| {
+			(transaction.hash() == record.transaction_hash).then_some(index)
+		})
+		.collect::<Vec<_>>();
+	let record_transaction_index = match matching_transaction_indexes.as_slice() {
+		[] => return Err(FrontierExecutionIdentityProofError::RecordTransactionMissing),
+		[index] => *index,
+		_ => return Err(FrontierExecutionIdentityProofError::RecordTransactionDuplicated),
+	};
+
+	Ok(VerifiedFrontierExecutionIdentityV1 {
+		state_root,
+		runtime_code_storage_key: RUNTIME_CODE_STORAGE_KEY,
+		runtime_code_sha256,
+		runtime_code_size_bytes: raw_runtime_code.len(),
+		current_block_storage_key,
+		record_storage_key,
+		record,
+		current_block_scale_sha256: sha2_256(raw_current_block),
+		current_block_scale_bytes: raw_current_block.len(),
+		current_block,
+		execution_block_hash,
+		record_transaction_index,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+/// Verify one requested native header, GRANDPA finality, runtime code, and Frontier block mapping.
+pub fn verify_finalized_frontier_execution_identity_v1<Block>(
+	requested_header: Block::Header,
+	expected_sidechain_id: H256,
+	expected_set_id: SetId,
+	expected_authorities: &AuthorityList,
+	encoded_finality_proof: &[u8],
+	expected_ergo_box_id: H256,
+	runtime_code: RuntimeCodeExpectationV2,
+	expected_record: &PegInRuntimeRecordV1,
+	storage_proof_nodes: &[Vec<u8>],
+) -> Result<
+	VerifiedFinalizedFrontierExecutionIdentityV1<Block>,
+	FinalizedFrontierExecutionIdentityProofError,
+>
+where
+	Block: BlockT<Hash = H256>,
+	sp_runtime::traits::NumberFor<Block>:
+		sc_consensus_grandpa::BlockNumberOps + CheckedAdd + Copy + TryInto<u64>,
+{
+	let requested_hash = requested_header.hash();
+	let requested_number = *requested_header.number();
+	let finality = verify_grandpa_finality_proof::<Block>(
+		requested_hash,
+		requested_number,
+		expected_set_id,
+		expected_authorities,
+		encoded_finality_proof,
+	)?;
+	let requested_height = requested_number
+		.try_into()
+		.map_err(|_| FrontierExecutionIdentityProofError::ExecutionHeightMismatch)?;
+	let state = verify_frontier_execution_identity_v1(
+		*requested_header.state_root(),
+		requested_height,
+		expected_sidechain_id,
+		expected_ergo_box_id,
+		runtime_code,
+		expected_record,
+		storage_proof_nodes,
+	)?;
+
+	Ok(VerifiedFinalizedFrontierExecutionIdentityV1 {
+		requested_header,
+		finality,
+		state,
+	})
+}
+
+fn validate_expectation(
+	runtime_code: RuntimeCodeExpectationV2,
+	expected_sidechain_id: H256,
+	expected_ergo_box_id: H256,
+	authenticated_native_height: u64,
+	expected_record: &PegInRuntimeRecordV1,
+) -> Result<(), FrontierExecutionIdentityProofError> {
+	if runtime_code.artifact_sha256 == [0u8; 32] {
+		return Err(FrontierExecutionIdentityProofError::ZeroRuntimeCodeDigest);
+	}
+	if runtime_code.artifact_size_bytes == 0 {
+		return Err(FrontierExecutionIdentityProofError::ZeroRuntimeCodeSize);
+	}
+	if runtime_code.artifact_size_bytes > crate::peg_in_runtime_identity_v2::MAX_RUNTIME_CODE_BYTES
+	{
+		return Err(
+			FrontierExecutionIdentityProofError::ExpectedRuntimeCodeTooLarge {
+				actual: runtime_code.artifact_size_bytes,
+				max: crate::peg_in_runtime_identity_v2::MAX_RUNTIME_CODE_BYTES,
+			},
+		);
+	}
+	validate_record(
+		expected_record,
+		expected_sidechain_id,
+		expected_ergo_box_id,
+		authenticated_native_height,
+	)?;
+	if expected_record.sidechain_height != authenticated_native_height {
+		return Err(FrontierExecutionIdentityProofError::RecordHeightMismatch);
+	}
+	Ok(())
+}
+
+pub(crate) fn validate_proof_bounds(
+	proof_nodes: &[Vec<u8>],
+) -> Result<usize, FrontierExecutionIdentityProofError> {
+	if proof_nodes.is_empty() {
+		return Err(FrontierExecutionIdentityProofError::EmptyProof);
+	}
+	if proof_nodes.len() > MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES {
+		return Err(FrontierExecutionIdentityProofError::TooManyNodes {
+			actual: proof_nodes.len(),
+			max: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES,
+		});
+	}
+	let mut proof_bytes = 0usize;
+	for (index, node) in proof_nodes.iter().enumerate() {
+		if node.len() > MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES {
+			return Err(FrontierExecutionIdentityProofError::NodeTooLarge {
+				index,
+				actual: node.len(),
+				max: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+			});
+		}
+		proof_bytes = proof_bytes.checked_add(node.len()).ok_or(
+			FrontierExecutionIdentityProofError::ProofTooLarge {
+				actual: usize::MAX,
+				max: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES,
+			},
+		)?;
+		if proof_bytes > MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES {
+			return Err(FrontierExecutionIdentityProofError::ProofTooLarge {
+				actual: proof_bytes,
+				max: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES,
+			});
+		}
+	}
+	Ok(proof_bytes)
+}

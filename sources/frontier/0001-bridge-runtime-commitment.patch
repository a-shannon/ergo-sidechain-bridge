--- /dev/null
+++ b/bridge/checkpoint-verifier/src/bin/bridge-peg-in-causal-mint-transition-v2-verifier.rs
@@ -0,0 +1,44 @@
+//! Standard-input entrypoint for finalized causal peg-in mint transitions.
+
+use std::{
+	env,
+	io::{self, Read},
+	process::ExitCode,
+};
+
+use bridge_checkpoint_verifier::peg_in_causal_mint_transition_v2::MAX_CAUSAL_MINT_TRANSITION_REQUEST_BYTES;
+
+fn main() -> ExitCode {
+	match run() {
+		Ok(()) => ExitCode::SUCCESS,
+		Err(error) => {
+			eprintln!("causal peg-in mint-transition V2 verification failed: {error}");
+			ExitCode::from(2)
+		}
+	}
+}
+
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+	let mut arguments = env::args();
+	let _program = arguments.next();
+	if arguments.next().as_deref() != Some("--trusted-anchor-digest") {
+		return Err("expected --trusted-anchor-digest <0x-prefixed-digest>".into());
+	}
+	let trusted_anchor_digest = arguments
+		.next()
+		.ok_or("expected --trusted-anchor-digest <0x-prefixed-digest>")?;
+	if arguments.next().is_some() {
+		return Err("expected --trusted-anchor-digest <0x-prefixed-digest>".into());
+	}
+	let mut request = Vec::new();
+	io::stdin()
+		.take((MAX_CAUSAL_MINT_TRANSITION_REQUEST_BYTES + 1) as u64)
+		.read_to_end(&mut request)?;
+	let verified =
+		bridge_checkpoint_verifier::peg_in_causal_mint_transition_v2::verify_request_bytes(
+			&request,
+			&trusted_anchor_digest,
+		)?;
+	serde_json::to_writer(io::stdout().lock(), &verified)?;
+	Ok(())
+}

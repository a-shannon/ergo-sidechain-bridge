+
+	#[test]
+	fn rejects_unknown_fields_hash_drift_and_noncanonical_proofs() {
+		let fixture = deterministic_fixture_request();
+		let target_bytes =
+			hex::decode(fixture.target_header_scale_hex.strip_prefix("0x").unwrap()).unwrap();
+		let target = NativeHeader::decode_all(&mut &target_bytes[..]).unwrap();
+		let unknown = json!({
+			"schema": HEADER_ENCODING_REQUEST_SCHEMA,

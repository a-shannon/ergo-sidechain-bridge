+) -> Result<(), &'static str> {
+	let statement = &validated.statement;
+	let intent = &statement.source_intent;
+	if statement.lineage_profile_id != profile.lineage_profile_id
+		|| intent.source_network_id != profile.source_network_id
+		|| intent.sidechain_id != profile.sidechain_id
+		|| intent.bridge_address != profile.bridge_address
+		|| intent.token_address != profile.token_address
+		|| intent.settlement_profile_id != profile.settlement_profile_id
+		|| statement.ergo_deposit_finality_policy_id != profile.ergo_deposit_finality_policy_id
+	{
+		return Err("pooled-reserve mint-reservation statement does not match the active profile");
+	}

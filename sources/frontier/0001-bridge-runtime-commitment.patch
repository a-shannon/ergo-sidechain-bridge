+
+	const FIXTURE_PROOF_REQUEST_DOMAIN_V4: &[u8] =
+		b"E2S_POOLED_RESERVE_SOURCE_PROOF_REQUEST_TEST_ONLY_V4";
+	const FIXTURE_PROOF_RESULT_DOMAIN_V4: &[u8] =
+		b"E2S_POOLED_RESERVE_SOURCE_PROOF_RESULT_TEST_ONLY_V4";
+
+	pub struct BridgeAtomicityFixtureSourceProofVerifierV4;
+
+	impl PooledReserveMintReservationSourceProofVerifierV4
+		for BridgeAtomicityFixtureSourceProofVerifierV4
+	{
+		fn proof_system_id() -> H256 {
+			rejected_fixture_source_proof_system_id_v4()
+		}
+
+		fn proof_profile_id() -> H256 {
+			rejected_fixture_source_proof_profile_id_v4()
+		}
+
+		fn verify(
+			profile: &PooledReserveMintReservationRuntimeProfileV4,
+			validated: &ValidatedPooledReserveMintReservationV4,
+			statement_bytes: &[u8],
+			current_native_height: u64,
+			proof: &PooledReserveMintReservationSourceProofEnvelopeV4,
+		) -> Result<VerifiedPooledReserveMintReservationSourceProofV4, &'static str> {
+			let runtime_profile_id = validate_pooled_reserve_mint_reservation_profile_v4(profile)?;
+			let revalidated =
+				validate_pooled_reserve_mint_reservation_statement_v4(statement_bytes)?;
+			if &revalidated != validated {
+				return Err("pooled-reserve test source proof statement binding drifted");
+			}
+			if proof.format_version != POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4
+				|| proof.proof_system_id != Self::proof_system_id()
+				|| proof.proof_profile_id != Self::proof_profile_id()
+				|| proof.proof_system_id != profile.source_proof_system_id
+				|| proof.proof_profile_id != profile.source_proof_profile_id
+				|| proof.issued_at_native_height < profile.activation_height
+				|| proof.issued_at_native_height > current_native_height
+				|| proof.expires_at_native_height <= current_native_height
+			{
+				return Err("pooled-reserve test source proof has an invalid identity or window");
+			}
+			let lifetime = proof
+				.expires_at_native_height
+				.checked_sub(proof.issued_at_native_height)
+				.ok_or("pooled-reserve test source proof window underflows")?;
+			if lifetime == 0 || lifetime > u64::from(profile.max_pending_blocks) {
+				return Err("pooled-reserve test source proof exceeds the active profile window");
+			}
+			if statement_bytes.len() != POOLED_RESERVE_MINT_RESERVATION_STATEMENT_V4_BYTES {
+				return Err("pooled-reserve test source proof statement length drifted");
+			}
+			let statement_bytes_digest = H256::from(blake2_256(statement_bytes));
+			let request_digest = derive_fixture_source_proof_request_digest_v4(
+				runtime_profile_id,
+				validated.statement_id,
+				statement_bytes_digest,
+				proof.proof_system_id,
+				proof.proof_profile_id,
+				proof.issued_at_native_height,
+				proof.expires_at_native_height,
+			);
+			if proof.proof_bytes.as_slice() != request_digest.as_bytes() {
+				return Err("pooled-reserve test source proof bytes are invalid");
+			}
+			let proof_digest = H256::from(blake2_256(&proof.encode()));
+			let mut result_preimage = Vec::with_capacity(FIXTURE_PROOF_RESULT_DOMAIN_V4.len() + 64);
+			result_preimage.extend_from_slice(FIXTURE_PROOF_RESULT_DOMAIN_V4);
+			result_preimage.extend_from_slice(request_digest.as_bytes());
+			result_preimage.extend_from_slice(proof_digest.as_bytes());
+			Ok(VerifiedPooledReserveMintReservationSourceProofV4 {
+				runtime_profile_id,
+				statement_id: validated.statement_id,
+				statement_bytes_digest,
+				proof_system_id: proof.proof_system_id,
+				proof_profile_id: proof.proof_profile_id,
+				issued_at_native_height: proof.issued_at_native_height,
+				expires_at_native_height: proof.expires_at_native_height,
+				proof_request_digest: request_digest,
+				proof_result_id: H256::from(blake2_256(&result_preimage)),
+				proof_digest,
+			})
+		}
+	}
+
+	pub fn fixture_source_proof_v4(
+		profile: &PooledReserveMintReservationRuntimeProfileV4,
+		statement_bytes: &[u8],
+		issued_at_native_height: u64,
+		expires_at_native_height: u64,
+	) -> PooledReserveMintReservationSourceProofEnvelopeV4 {
+		let source_profile = ReferenceFederatedPooledReserveSourceProofProfileV1::profile();
+		let runtime_profile_id = validate_pooled_reserve_mint_reservation_profile_v4(profile)
+			.expect("test fixture runtime profile is canonical");
+		let validated = validate_pooled_reserve_mint_reservation_statement_v4(statement_bytes)
+			.expect("test fixture reservation statement is canonical");
+		let proof_system_id = federated_pooled_reserve_source_proof_system_id_v1();
+		let proof_profile_id =
+			derive_federated_pooled_reserve_source_proof_profile_id_v1(&source_profile)
+				.expect("test federated pooled-reserve profile is canonical");
+		let key_set_digest =
+			derive_federated_pooled_reserve_source_key_set_digest_v1(&source_profile)
+				.expect("test federated pooled-reserve key set is canonical");
+		let statement_bytes_digest = H256::from(blake2_256(statement_bytes));
+		let request_digest = derive_federated_pooled_reserve_source_proof_request_digest_v1(
+			runtime_profile_id,
+			validated.statement_id,
+			statement_bytes_digest,
+			proof_system_id,
+			proof_profile_id,
+			source_profile.federation_epoch,
+			key_set_digest,
+			source_profile.threshold,
+			issued_at_native_height,
+			expires_at_native_height,
+		);
+		let mut finality_preimage = Vec::with_capacity(64);
+		finality_preimage.extend_from_slice(validated.statement.inclusion_header_id.as_bytes());
+		finality_preimage.extend_from_slice(validated.statement.target_header_id.as_bytes());
+		let result = FederatedPooledReserveSourceProofResultV1 {
+			format_version: FEDERATED_POOLED_RESERVE_SOURCE_PROOF_FORMAT_VERSION_V1,
+			federation_epoch: source_profile.federation_epoch,
+			source_attestation_key_set_digest: key_set_digest,
+			source_attestation_threshold: source_profile.threshold,
+			request_digest,
+			source_lock_box_canonical_blake2b256: H256::from(blake2_256(
+				validated.statement.source_lock_box_id.as_bytes(),
+			)),
+			reserve_transition_transaction_canonical_blake2b256: H256::from(blake2_256(
+				validated
+					.statement
+					.reserve_transition_transaction_id
+					.as_bytes(),
+			)),
+			successor_reserve_box_canonical_blake2b256: H256::from(blake2_256(
+				validated.statement.successor_reserve_box_id.as_bytes(),
+			)),
+			inclusion_proof_blake2b256: H256::from(blake2_256(
+				validated.statement.inclusion_header_id.as_bytes(),
+			)),
+			checkpoint_ancestry_blake2b256: H256::from(blake2_256(
+				validated.statement.target_header_id.as_bytes(),
+			)),
+			finality_proof_blake2b256: H256::from(blake2_256(&finality_preimage)),
+			verifier_executable_sha256: H256::from(sha2_256(
+				b"federated-pooled-reserve-source-proof-block-import-fixture-v1",
+			)),
+			verifier_profile_id: source_profile.verifier_profile_id,
+			issued_at_native_height,
+			expires_at_native_height,
+		};
+		let result_id = derive_federated_pooled_reserve_source_proof_result_id_v1(&result)
+			.expect("test federated pooled-reserve result is canonical");
+		let attestation_digest =
+			derive_federated_pooled_reserve_source_proof_attestation_digest_v1(result_id);
+		let mut signatures = [
+			ed25519::Pair::from_seed(&[0x41; 32]),
+			ed25519::Pair::from_seed(&[0x42; 32]),
+		]
+		.into_iter()
+		.map(|pair| FederatedSourceProofSignatureV1 {
+			signer_public_key: pair.public().0,
+			signature: pair.sign(attestation_digest.as_bytes()).0,
+		})
+		.collect::<Vec<_>>();
+		signatures.sort_by_key(|item| item.signer_public_key);
+		let signatures: FederatedSourceProofSignaturesV1 = signatures
+			.try_into()
+			.expect("test threshold signatures fit the source-proof bound");
+		let inner = FederatedPooledReserveSourceProofEnvelopeV1 { result, signatures };
+		PooledReserveMintReservationSourceProofEnvelopeV4 {
+			format_version: POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4,
+			proof_system_id,
+			proof_profile_id,
+			issued_at_native_height,
+			expires_at_native_height,
+			proof_bytes: inner
+				.encode()
+				.try_into()
+				.expect("federated block-import proof fits the source-proof bound"),
+		}
+	}
+
+	pub fn fixture_source_invalidation_v4(
+		profile: &PooledReserveMintReservationRuntimeProfileV4,
+		pending: &PendingPooledReserveMintReservationV4,
+		reason: FederatedPooledReserveInvalidationReasonV1,
+		issued_at_native_height: u64,
+		expires_at_native_height: u64,
+	) -> FederatedPooledReserveInvalidationV1 {
+		let source_profile = ReferenceFederatedPooledReserveSourceProofProfileV1::profile();
+		let mut invalidation = FederatedPooledReserveInvalidationV1 {
+			format_version: FEDERATED_POOLED_RESERVE_SOURCE_PROOF_FORMAT_VERSION_V1,
+			proof_system_id: federated_pooled_reserve_source_proof_system_id_v1(),
+			proof_profile_id: derive_federated_pooled_reserve_source_proof_profile_id_v1(
+				&source_profile,
+			)
+			.expect("test federated pooled-reserve profile is canonical"),
+			federation_epoch: source_profile.federation_epoch,
+			source_attestation_key_set_digest:
+				derive_federated_pooled_reserve_source_key_set_digest_v1(&source_profile)
+					.expect("test federated pooled-reserve key set is canonical"),
+			source_attestation_threshold: source_profile.threshold,
+			runtime_profile_id: validate_pooled_reserve_mint_reservation_profile_v4(profile)
+				.expect("test runtime profile is canonical"),
+			statement_id: pending.statement_id,
+			mint_identity: pending.mint_identity,
+			source_proof_result_id: pending.source_proof_result_id,
+			reason,
+			evidence_digest: H256::from(blake2_256(
+				b"federated-pooled-reserve-source-invalidation-evidence-v1",
+			)),
+			observed_checkpoint_block_id: H256::from(blake2_256(
+				b"federated-pooled-reserve-observed-conflicting-checkpoint-v1",
+			)),
+			observed_checkpoint_height: issued_at_native_height.saturating_sub(1),
+			issued_at_native_height,
+			expires_at_native_height,
+			signatures: Vec::new().try_into().expect("empty signatures fit"),
+		};
+		let invalidation_id = derive_federated_pooled_reserve_invalidation_id_v1(&invalidation)
+			.expect("test federated pooled-reserve invalidation is canonical");
+		let attestation_digest =
+			derive_federated_pooled_reserve_invalidation_attestation_digest_v1(invalidation_id);
+		let mut signatures = [
+			ed25519::Pair::from_seed(&[0x41; 32]),
+			ed25519::Pair::from_seed(&[0x42; 32]),
+		]
+		.into_iter()
+		.map(|pair| FederatedSourceProofSignatureV1 {
+			signer_public_key: pair.public().0,
+			signature: pair.sign(attestation_digest.as_bytes()).0,
+		})
+		.collect::<Vec<_>>();
+		signatures.sort_by_key(|item| item.signer_public_key);
+		invalidation.signatures = signatures
+			.try_into()
+			.expect("test invalidation signatures fit the source-proof bound");
+		invalidation
+	}
+
+	fn derive_fixture_source_proof_request_digest_v4(
+		runtime_profile_id: H256,
+		statement_id: H256,
+		statement_bytes_digest: H256,
+		proof_system_id: H256,
+		proof_profile_id: H256,
+		issued_at_native_height: u64,
+		expires_at_native_height: u64,
+	) -> H256 {
+		let mut preimage = Vec::with_capacity(FIXTURE_PROOF_REQUEST_DOMAIN_V4.len() + 32 * 5 + 16);
+		preimage.extend_from_slice(FIXTURE_PROOF_REQUEST_DOMAIN_V4);
+		preimage.extend_from_slice(runtime_profile_id.as_bytes());
+		preimage.extend_from_slice(statement_id.as_bytes());
+		preimage.extend_from_slice(statement_bytes_digest.as_bytes());
+		preimage.extend_from_slice(proof_system_id.as_bytes());
+		preimage.extend_from_slice(proof_profile_id.as_bytes());
+		preimage.extend_from_slice(&issued_at_native_height.to_be_bytes());
+		preimage.extend_from_slice(&expires_at_native_height.to_be_bytes());
+		H256::from(blake2_256(&preimage))
+	}
+}

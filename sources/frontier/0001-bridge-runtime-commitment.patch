--- /dev/null
+++ b/bridge/checkpoint-verifier/src/lib.rs
@@ -0,0 +1,759 @@
+//! Strict offline verification for finalized Frontier bridge checkpoints.
+//!
+//! The verifier accepts only canonical, bounded JSON and SCALE material. It performs no RPC,
+//! signing, transaction construction, broadcast, or filesystem access.
+
+#![warn(missing_docs)]
+
+use bridge_finality_proof::{
+	MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS, MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+	MAX_FINALITY_PROOF_BYTES,
+};
+use bridge_state_proof::{
+	derive_grandpa_authority_set_hash, verify_deployment_checkpoint, DeploymentCheckpointError,
+	GrandpaDeploymentTrustAnchor, LinkedGrandpaAuthorityProofChunk, BRIDGE_COMMITMENT_STORAGE_KEY,
+	MAX_BRIDGE_COMMITMENT_PROOF_NODES, MAX_BRIDGE_COMMITMENT_PROOF_NODE_BYTES,
+	MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+};
+use scale_codec::{DecodeAll, Encode};
+use serde::{Deserialize, Serialize};
+use sp_consensus_grandpa::AuthorityList;
+use sp_core::H256;
+use sp_runtime::{
+	generic,
+	traits::{BlakeTwo256, Hash as _, Header as _},
+	OpaqueExtrinsic,
+};
+use thiserror::Error;
+
+/// Stable request schema consumed by the native verifier.
+pub const REQUEST_SCHEMA: &str = "e2s.native-finalized-bridge-checkpoint-request.v2";
+/// Stable successful verification schema emitted by the native verifier.
+pub const VERIFICATION_SCHEMA: &str = "e2s.native-finalized-bridge-checkpoint-verification.v2";
+/// Maximum exact UTF-8 request bytes accepted on standard input.
+pub const MAX_REQUEST_BYTES: usize = 32 * 1024 * 1024;
+/// Maximum encoded native header size accepted by the bridge profile.
+pub const MAX_NATIVE_HEADER_BYTES: usize = 64 * 1024;
+/// Maximum encoded authority-list size accepted by the bridge profile.
+pub const MAX_AUTHORITY_LIST_BYTES: usize = 4 * 1024;
+
+/// Pinned native header shape used by the Frontier template runtime.
+pub type NativeHeader = generic::Header<u32, BlakeTwo256>;
+/// Pinned native block shape used to decode GRANDPA proofs.
+pub type NativeBlock = generic::Block<NativeHeader, OpaqueExtrinsic>;
+
+/// Independently reviewed deployment trust root supplied to the verifier.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct TrustAnchorRequest {
+	/// Sidechain domain, normally the native genesis block hash.
+	pub sidechain_id_hex: String,
+	/// Reviewed finalized checkpoint hash.
+	pub checkpoint_hash_hex: String,
+	/// Reviewed finalized checkpoint number as an exact uint64 decimal string.
+	pub checkpoint_number: String,
+	/// GRANDPA set identifier reviewed for a checkpoint with no authority-change digest.
+	pub grandpa_set_id: String,
+	/// Canonical SCALE authority list that signs that checkpoint and later descendants.
+	pub authority_list_scale_hex: String,
+}
+
+/// One compact GRANDPA proof plus its omitted contiguous ancestry.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct LinkedGrandpaProofRequest {
+	/// Canonical SCALE headers descending from the preceding authenticated checkpoint.
+	pub ancestry_headers_scale_hex: Vec<String>,
+	/// Canonical SCALE compact GRANDPA warp proof.
+	pub proof_scale_hex: String,
+}
+
+/// Complete native checkpoint verification request.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeCheckpointRequest {
+	/// Exact request schema.
+	pub schema: String,
+	/// Public deployment trust root.
+	pub trust_anchor: TrustAnchorRequest,
+	/// Expected hash of the requested burn-bearing native block.
+	pub target_native_block_hash_hex: String,
+	/// Canonical SCALE requested native header.
+	pub target_header_scale_hex: String,
+	/// Hash-linked authority-transition proofs from the public trust root.
+	pub linked_grandpa_proofs: Vec<LinkedGrandpaProofRequest>,
+	/// Contiguous headers after the last linked handoff through the finality horizon.
+	pub checkpoint_tail_headers_scale_hex: Vec<String>,
+	/// Canonical SCALE `grandpa_proveFinality` response for the target.
+	pub finality_proof_scale_hex: String,
+	/// Raw trie nodes proving the exact runtime bridge-commitment key.
+	pub runtime_state_proof_nodes_hex: Vec<String>,
+}
+
+/// Verified requested native header identity.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedTargetOutput {
+	/// Native consensus hash.
+	pub native_block_hash_hex: String,
+	/// Native height as an exact uint64 decimal string.
+	pub native_height: String,
+	/// Authenticated native state root.
+	pub state_root_hex: String,
+}
+
+/// Verified GRANDPA authority path.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedAuthorityOutput {
+	/// Authenticated identifier of the set whose quorum signed the finality horizon.
+	pub finality_signing_set_id: String,
+	/// Canonical SCALE authority list whose quorum signed the finality horizon.
+	pub finality_signing_authority_list_scale_hex: String,
+	/// Domain-separated digest of the finality-signing authority list.
+	pub finality_signing_authority_set_hash_hex: String,
+	/// Number of authenticated scheduled authority handoffs.
+	pub transition_count: usize,
+	/// Confirms that every compact fragment was bound to contiguous ancestry.
+	pub linked_ancestry_verified: bool,
+}
+
+/// Verified exact GRANDPA finality horizon.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedFinalityOutput {
+	/// Signed horizon hash shared with the linked authority proof.
+	pub horizon_hash_hex: String,
+	/// Signed horizon height as an exact uint64 decimal string.
+	pub horizon_height: String,
+	/// Canonical SCALE embedded GRANDPA justification used by bridge commitments.
+	pub canonical_justification_scale_hex: String,
+	/// Confirms native signature, threshold, and exact ancestry verification.
+	pub verified: bool,
+}
+
+/// Verified exact-key runtime state inclusion.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedRuntimeStateOutput {
+	/// Fixed runtime storage key.
+	pub storage_key_hex: String,
+	/// Canonical SCALE V1 commitment recovered from the trie.
+	pub storage_value_scale_hex: String,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+	/// Confirms exact-key trie verification against the target state root.
+	pub verified: bool,
+}
+
+/// Typed bridge event commitment recovered from authenticated runtime state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedCommitmentOutput {
+	/// Sidechain domain encoded in runtime state.
+	pub sidechain_id_hex: String,
+	/// Native commitment height as an exact uint64 decimal string.
+	pub sidechain_height: String,
+	/// Frontier execution block hash committed by the runtime.
+	pub execution_block_hash_hex: String,
+	/// Canonical bridge event root.
+	pub bridge_event_root_hex: String,
+	/// Number of burn leaves in the root.
+	pub burn_leaf_count: u32,
+}
+
+/// Explicit claim boundary for one native verification result.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerificationBoundaryOutput {
+	/// Native sidechain finality is verified from the reviewed trust anchor.
+	pub sidechain_finality_verified: bool,
+	/// Ergo extension anchoring remains a separate unverified step.
+	pub ergo_extension_anchor_verified: bool,
+	/// ErgoScript acceptance remains a separate unverified step.
+	pub on_chain_acceptance_verified: bool,
+	/// This offline verifier cannot mutate transactions or chain state.
+	pub transaction_mutation_enabled: bool,
+	/// Native proof verification alone does not close Gate 5.
+	pub gate5_closed: bool,
+}
+
+/// Successful native checkpoint verification report.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeCheckpointVerification {
+	/// Exact successful output schema.
+	pub schema: String,
+	/// Always `VERIFIED` for emitted reports.
+	pub status: String,
+	/// Blake2b-256 digest of the exact request bytes consumed by the process.
+	pub request_digest_hex: String,
+	/// Recomputed public trust-anchor digest.
+	pub trust_anchor_digest_hex: String,
+	/// Requested target identity.
+	pub target: VerifiedTargetOutput,
+	/// Authenticated authority-transition result.
+	pub authority: VerifiedAuthorityOutput,
+	/// Exact finality horizon.
+	pub finality: VerifiedFinalityOutput,
+	/// Exact runtime-state inclusion result.
+	pub runtime_state: VerifiedRuntimeStateOutput,
+	/// Typed runtime bridge commitment.
+	pub commitment: VerifiedCommitmentOutput,
+	/// Non-negotiable claim boundary.
+	pub boundary: VerificationBoundaryOutput,
+}
+
+/// A strict request or native checkpoint verification failure.
+#[derive(Debug, Error)]
+pub enum NativeCheckpointRequestError {
+	/// Input exceeded the process-level request bound.
+	#[error("native checkpoint request exceeds {max} bytes: {actual}")]
+	RequestTooLarge {
+		/// Received request bytes.
+		actual: usize,
+		/// Configured maximum.
+		max: usize,
+	},
+	/// Input was not a strict request JSON object.
+	#[error("failed to decode strict native checkpoint request JSON: {0}")]
+	Json(#[from] serde_json::Error),
+	/// Request schema did not match the pinned V2 contract.
+	#[error("unsupported native checkpoint request schema")]
+	Schema,
+	/// One exact decimal string was malformed or outside its target type.
+	#[error("invalid decimal value for {field}")]
+	Decimal {
+		/// Stable field label.
+		field: &'static str,
+	},
+	/// One hex field was noncanonical, malformed, or outside its bound.
+	#[error("invalid hex value for {field}: {reason}")]
+	Hex {
+		/// Stable field label.
+		field: &'static str,
+		/// Stable rejection reason.
+		reason: &'static str,
+	},
+	/// One SCALE object was malformed or had trailing bytes.
+	#[error("failed to decode canonical SCALE value for {field}")]
+	Scale {
+		/// Stable field label.
+		field: &'static str,
+	},
+	/// A collection was outside its bridge policy bounds.
+	#[error("invalid collection size for {field}: {actual} (expected {min}..={max})")]
+	Collection {
+		/// Stable field label.
+		field: &'static str,
+		/// Received count.
+		actual: usize,
+		/// Minimum accepted count.
+		min: usize,
+		/// Maximum accepted count.
+		max: usize,
+	},
+	/// The supplied target hash did not equal the decoded header hash.
+	#[error("target native block hash does not match the decoded target header")]
+	TargetHashMismatch,
+	/// Native finality, transition, runtime-state, or commitment verification failed.
+	#[error(transparent)]
+	Checkpoint(#[from] DeploymentCheckpointError),
+}
+
+/// Verify one exact bounded JSON request entirely offline.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<NativeCheckpointVerification, NativeCheckpointRequestError> {
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(NativeCheckpointRequestError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_REQUEST_BYTES,
+		});
+	}
+	let request: NativeCheckpointRequest = serde_json::from_slice(raw_request)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativeCheckpointRequestError::Schema);
+	}
+	let trusted_anchor_digest = parse_hash("trustedAnchorDigestHex", trusted_anchor_digest_hex)?;
+
+	let sidechain_id = parse_hash(
+		"trustAnchor.sidechainIdHex",
+		&request.trust_anchor.sidechain_id_hex,
+	)?;
+	let checkpoint_hash = parse_hash(
+		"trustAnchor.checkpointHashHex",
+		&request.trust_anchor.checkpoint_hash_hex,
+	)?;
+	let checkpoint_number_u64 = parse_decimal_u64(
+		"trustAnchor.checkpointNumber",
+		&request.trust_anchor.checkpoint_number,
+	)?;
+	let checkpoint_number =
+		checkpoint_number_u64
+			.try_into()
+			.map_err(|_| NativeCheckpointRequestError::Decimal {
+				field: "trustAnchor.checkpointNumber",
+			})?;
+	let grandpa_set_id = parse_decimal_u64(
+		"trustAnchor.grandpaSetId",
+		&request.trust_anchor.grandpa_set_id,
+	)?;
+	let authority_bytes = parse_byte_hex(
+		"trustAnchor.authorityListScaleHex",
+		&request.trust_anchor.authority_list_scale_hex,
+		MAX_AUTHORITY_LIST_BYTES,
+	)?;
+	let authorities = AuthorityList::decode_all(&mut &authority_bytes[..]).map_err(|_| {
+		NativeCheckpointRequestError::Scale {
+			field: "trustAnchor.authorityListScaleHex",
+		}
+	})?;
+	let anchor = GrandpaDeploymentTrustAnchor::<NativeBlock> {
+		sidechain_id,
+		checkpoint_hash,
+		checkpoint_number,
+		set_id: grandpa_set_id,
+		authorities,
+	};
+
+	let expected_target_hash = parse_hash(
+		"targetNativeBlockHashHex",
+		&request.target_native_block_hash_hex,
+	)?;
+	let target_header_bytes = parse_byte_hex(
+		"targetHeaderScaleHex",
+		&request.target_header_scale_hex,
+		MAX_NATIVE_HEADER_BYTES,
+	)?;
+	let target_header = NativeHeader::decode_all(&mut &target_header_bytes[..]).map_err(|_| {
+		NativeCheckpointRequestError::Scale {
+			field: "targetHeaderScaleHex",
+		}
+	})?;
+	if target_header.hash() != expected_target_hash {
+		return Err(NativeCheckpointRequestError::TargetHashMismatch);
+	}
+
+	ensure_collection(
+		"linkedGrandpaProofs",
+		request.linked_grandpa_proofs.len(),
+		0,
+		MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+	)?;
+	let linked_proofs = request
+		.linked_grandpa_proofs
+		.iter()
+		.map(|chunk| {
+			ensure_collection(
+				"linkedGrandpaProofs.ancestryHeadersScaleHex",
+				chunk.ancestry_headers_scale_hex.len(),
+				1,
+				MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+			)?;
+			let ancestry_headers = chunk
+				.ancestry_headers_scale_hex
+				.iter()
+				.map(|encoded| {
+					let bytes = parse_byte_hex(
+						"linkedGrandpaProofs.ancestryHeadersScaleHex",
+						encoded,
+						MAX_NATIVE_HEADER_BYTES,
+					)?;
+					NativeHeader::decode_all(&mut &bytes[..]).map_err(|_| {
+						NativeCheckpointRequestError::Scale {
+							field: "linkedGrandpaProofs.ancestryHeadersScaleHex",
+						}
+					})
+				})
+				.collect::<Result<Vec<_>, _>>()?;
+			let encoded_proof = parse_byte_hex(
+				"linkedGrandpaProofs.proofScaleHex",
+				&chunk.proof_scale_hex,
+				MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+			)?;
+			Ok(LinkedGrandpaAuthorityProofChunk {
+				ancestry_headers,
+				encoded_proof,
+			})
+		})
+		.collect::<Result<Vec<_>, NativeCheckpointRequestError>>()?;
+	ensure_collection(
+		"checkpointTailHeadersScaleHex",
+		request.checkpoint_tail_headers_scale_hex.len(),
+		0,
+		MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+	)?;
+	let checkpoint_tail_headers = request
+		.checkpoint_tail_headers_scale_hex
+		.iter()
+		.map(|encoded| {
+			let bytes = parse_byte_hex(
+				"checkpointTailHeadersScaleHex",
+				encoded,
+				MAX_NATIVE_HEADER_BYTES,
+			)?;
+			NativeHeader::decode_all(&mut &bytes[..]).map_err(|_| {
+				NativeCheckpointRequestError::Scale {
+					field: "checkpointTailHeadersScaleHex",
+				}
+			})
+		})
+		.collect::<Result<Vec<_>, _>>()?;
+
+	let finality_proof = parse_byte_hex(
+		"finalityProofScaleHex",
+		&request.finality_proof_scale_hex,
+		MAX_FINALITY_PROOF_BYTES,
+	)?;
+	ensure_collection(
+		"runtimeStateProofNodesHex",
+		request.runtime_state_proof_nodes_hex.len(),
+		1,
+		MAX_BRIDGE_COMMITMENT_PROOF_NODES,
+	)?;
+	let state_nodes = request
+		.runtime_state_proof_nodes_hex
+		.iter()
+		.map(|node| {
+			parse_byte_hex(
+				"runtimeStateProofNodesHex",
+				node,
+				MAX_BRIDGE_COMMITMENT_PROOF_NODE_BYTES,
+			)
+		})
+		.collect::<Result<Vec<_>, _>>()?;
+
+	let verified = verify_deployment_checkpoint::<NativeBlock>(
+		&anchor,
+		trusted_anchor_digest,
+		target_header,
+		&linked_proofs,
+		&checkpoint_tail_headers,
+		&finality_proof,
+		&state_nodes,
+	)?;
+	let requested_header = &verified.finalized_state.requested_header;
+	let state = &verified.finalized_state.state;
+	let commitment = &state.commitment;
+	let request_digest = BlakeTwo256::hash(raw_request);
+	let authority_set_hash = derive_grandpa_authority_set_hash(&verified.authenticated_authorities);
+
+	Ok(NativeCheckpointVerification {
+		schema: VERIFICATION_SCHEMA.to_owned(),
+		status: "NATIVE_CHECKPOINT_VERIFIED_RELATIVE_TO_REVIEWED_TRUST_ROOT".to_owned(),
+		request_digest_hex: format_hash(request_digest),
+		trust_anchor_digest_hex: format_hash(verified.trust_anchor_digest),
+		target: VerifiedTargetOutput {
+			native_block_hash_hex: format_hash(requested_header.hash()),
+			native_height: u64::from(*requested_header.number()).to_string(),
+			state_root_hex: format_hash(*requested_header.state_root()),
+		},
+		authority: VerifiedAuthorityOutput {
+			finality_signing_set_id: verified.authenticated_set_id.to_string(),
+			finality_signing_authority_list_scale_hex: format_bytes(
+				&verified.authenticated_authorities.encode(),
+			),
+			finality_signing_authority_set_hash_hex: format_hash(authority_set_hash),
+			transition_count: verified.transition_count,
+			linked_ancestry_verified: true,
+		},
+		finality: VerifiedFinalityOutput {
+			horizon_hash_hex: format_hash(verified.finality_horizon_hash),
+			horizon_height: u64::from(verified.finality_horizon_number).to_string(),
+			canonical_justification_scale_hex: format_bytes(
+				&verified.finalized_state.finality.justification.encode(),
+			),
+			verified: true,
+		},
+		runtime_state: VerifiedRuntimeStateOutput {
+			storage_key_hex: format_bytes(&BRIDGE_COMMITMENT_STORAGE_KEY),
+			storage_value_scale_hex: format_bytes(&commitment.encode()),
+			proof_node_count: state.proof_node_count,
+			proof_bytes: state.proof_bytes,
+			verified: true,
+		},
+		commitment: VerifiedCommitmentOutput {
+			sidechain_id_hex: format_hash(commitment.sidechain_id),
+			sidechain_height: commitment.sidechain_height.to_string(),
+			execution_block_hash_hex: format_hash(commitment.execution_block_hash),
+			bridge_event_root_hex: format_hash(commitment.bridge_event_root),
+			burn_leaf_count: commitment.burn_leaf_count,
+		},
+		boundary: VerificationBoundaryOutput {
+			sidechain_finality_verified: true,
+			ergo_extension_anchor_verified: false,
+			on_chain_acceptance_verified: false,
+			transaction_mutation_enabled: false,
+			gate5_closed: false,
+		},
+	})
+}
+
+pub(crate) fn ensure_collection(
+	field: &'static str,
+	actual: usize,
+	min: usize,
+	max: usize,
+) -> Result<(), NativeCheckpointRequestError> {
+	if actual < min || actual > max {
+		return Err(NativeCheckpointRequestError::Collection {
+			field,
+			actual,
+			min,
+			max,
+		});
+	}
+	Ok(())
+}
+
+pub(crate) fn parse_decimal_u64(
+	field: &'static str,
+	value: &str,
+) -> Result<u64, NativeCheckpointRequestError> {
+	if value.is_empty()
+		|| (value.len() > 1 && value.starts_with('0'))
+		|| !value.bytes().all(|byte| byte.is_ascii_digit())
+	{
+		return Err(NativeCheckpointRequestError::Decimal { field });
+	}
+	value
+		.parse()
+		.map_err(|_| NativeCheckpointRequestError::Decimal { field })
+}
+
+pub(crate) fn parse_hash(
+	field: &'static str,
+	value: &str,
+) -> Result<H256, NativeCheckpointRequestError> {
+	let bytes = parse_byte_hex(field, value, 32)?;
+	if bytes.len() != 32 {
+		return Err(NativeCheckpointRequestError::Hex {
+			field,
+			reason: "expected exactly 32 bytes",
+		});
+	}
+	Ok(H256::from_slice(&bytes))
+}
+
+pub(crate) fn parse_byte_hex(
+	field: &'static str,
+	value: &str,
+	max_bytes: usize,
+) -> Result<Vec<u8>, NativeCheckpointRequestError> {
+	let Some(body) = value.strip_prefix("0x") else {
+		return Err(NativeCheckpointRequestError::Hex {
+			field,
+			reason: "missing lowercase 0x prefix",
+		});
+	};
+	if body.is_empty() || body.len() % 2 != 0 {
+		return Err(NativeCheckpointRequestError::Hex {
+			field,
+			reason: "expected nonempty even-length bytes",
+		});
+	}
+	if body.len() / 2 > max_bytes {
+		return Err(NativeCheckpointRequestError::Hex {
+			field,
+			reason: "value exceeds byte limit",
+		});
+	}
+	if !body
+		.bytes()
+		.all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+	{
+		return Err(NativeCheckpointRequestError::Hex {
+			field,
+			reason: "expected lowercase hexadecimal",
+		});
+	}
+	hex::decode(body).map_err(|_| NativeCheckpointRequestError::Hex {
+		field,
+		reason: "failed byte decoding",
+	})
+}
+
+pub(crate) fn format_hash(value: H256) -> String {
+	format_bytes(value.as_bytes())
+}
+
+pub(crate) fn format_bytes(value: &[u8]) -> String {
+	format!("0x{}", hex::encode(value))
+}

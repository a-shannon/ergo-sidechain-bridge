+	#[test]
+	fn verifies_real_membership_and_non_membership_vectors() {
+		let anchor = deterministic_trusted_anchor_digest_hex();
+		let membership = deterministic_membership_fixture_request();
+		let member =
+			verify_request_bytes(&serde_json::to_vec(&membership).unwrap(), &anchor).unwrap();
+		assert_eq!(member.runtime_state.outcome, "MEMBERSHIP");
+		assert_eq!(member.runtime_state.profile_storage_key_hex, None);
+		assert_eq!(member.runtime_state.profile_storage_value_scale_hex, None);
+		assert_eq!(member.profile, None);
+		assert!(member.record.is_some());
+		assert!(!member.boundary.mint_authorized);
+
+		let non_membership = deterministic_non_membership_fixture_request();
+		let absent =
+			verify_request_bytes(&serde_json::to_vec(&non_membership).unwrap(), &anchor).unwrap();
+		assert_eq!(absent.runtime_state.outcome, "NON_MEMBERSHIP");
+		assert!(absent.runtime_state.profile_storage_key_hex.is_some());
+		assert!(absent
+			.runtime_state
+			.profile_storage_value_scale_hex
+			.is_some());
+		assert!(absent.profile.is_some());
+		assert!(absent.record.is_none());
+		assert!(!absent.boundary.historical_mint_absence_verified);
+		assert!(!absent.boundary.runtime_code_identity_verified);
+
+		let vector = deterministic_fixture_vector();
+		assert_eq!(vector.membership.expected, member);
+		assert_eq!(vector.non_membership.expected, absent);
+	}

+		statement[TARGET_HEIGHT_OFFSET..TARGET_HEIGHT_OFFSET + 4]
+			.copy_from_slice(&relay.target_height.to_be_bytes());
+		statement[TARGET_BLOCK_VERSION_OFFSET] = relay.target_block_version;
+		statement[TARGET_HEADER_LENGTH_OFFSET..TARGET_HEADER_LENGTH_OFFSET + 4]
+			.copy_from_slice(&relay.target_canonical_header_length.to_be_bytes());
+		statement[CONFIRMATIONS_OFFSET..CONFIRMATIONS_OFFSET + 4]
+			.copy_from_slice(&relay.confirmations.to_be_bytes());
+		statement[REQUIRED_CONFIRMATIONS_OFFSET..REQUIRED_CONFIRMATIONS_OFFSET + 4]
+			.copy_from_slice(&relay.required_confirmations.to_be_bytes());
+		statement
+	}

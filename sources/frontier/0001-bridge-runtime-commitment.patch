+			statement_bytes: CausalAdmissionStatementBytes,
+			source_proof: FederatedSourceProofEnvelopeV1,
+		) -> DispatchResult {
+			let _submitter = ensure_signed(origin)?;
+			ensure!(
+				!pooled_reserve_mint_reservation_mode_active::<T>(),
+				Error::<T>::PooledReserveMintReservationLegacyPegInModeConflict
+			);
+			ensure_causal_peg_in_source_proof_profile_execution_allowed::<T>()
+				.map_err(|_| Error::<T>::CausalPegInSourceProofProfileActivationBlocked)?;
+			let current_height = frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+			let runtime_profile = CurrentCausalPegInProfileV2::<T>::get()
+				.ok_or(Error::<T>::InvalidCausalPegInProfile)?;
+			let (_decoded_profile, _v1_profile) =
+				validate_causal_runtime_profile::<T>(&runtime_profile, current_height)
+					.map_err(|_| Error::<T>::InvalidCausalPegInProfile)?;
+			let validated = validate_admission_v2(
+				&runtime_profile.profile_bytes,
+				&source_intent_bytes,
+				&statement_bytes,
+			)
+			.map_err(|_| Error::<T>::InvalidPendingCausalPegInAdmission)?;
+			let record_key = validated.statement.legacy_mint_identity;
+			ensure!(
+				!ProcessedPegIns::<T>::contains_key(record_key)
+					&& !ConsumedCausalPegInsV3::<T>::contains_key(record_key),
+				Error::<T>::CausalPegInAdmissionAlreadyExists
+			);
+			ensure!(
+				!PendingCausalPegInsV2::<T>::contains_key(record_key)
+					&& !CausalPegInAdmissionReceiptsV1::<T>::contains_key(record_key),
+				Error::<T>::CausalPegInAdmissionAlreadyExists
+			);
+			ensure!(
+				!InvalidatedCausalPegInsV1::<T>::contains_key(record_key),
+				Error::<T>::CausalPegInAdmissionPermanentlyInvalidated

+/// Build a finalized request containing one exact pending reservation.
+pub fn deterministic_pending_fixture_request(
+) -> NativeFinalizedPooledReserveMintReservationStateRequestV4 {
+	request_for(true)
+}
+
+/// Build a finalized request proving an explicit non-authorizing pre-reservation state.
+pub fn deterministic_absent_fixture_request(
+) -> NativeFinalizedPooledReserveMintReservationStateRequestV4 {
+	request_for(false)
+}
+
+fn request_for(include_pending: bool) -> NativeFinalizedPooledReserveMintReservationStateRequestV4 {
+	let statement = statement();
+	let statement_id = domain_hash(STATEMENT_ID_DOMAIN, &statement);
+	let mint_identity = H256::from_slice(&statement[294..326]);
+	let profile = profile();
+	let profile_id = domain_hash(PROFILE_ID_DOMAIN, &profile.encode());
+	let keys = derive_pooled_reserve_mint_reservation_state_storage_keys_v4(mint_identity);
+	let mut state = BTreeMap::new();
+	state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), RUNTIME_CODE.to_vec());
+	state.insert(keys.current_profile.clone(), profile.encode());
+	state.insert(keys.enforcement.clone(), true.encode());
+	state.insert(
+		keys.pending_keys.clone(),
+		if include_pending {
+			vec![mint_identity].encode()
+		} else {
+			Vec::<H256>::new().encode()
+		},
+	);
+	if include_pending {
+		state.insert(
+			keys.pending_reservation.clone(),
+			pending(
+				&statement,
+				statement_id,
+				mint_identity,
+				&profile,
+				profile_id,
+			)
+			.encode(),
+		);
+	}
+
+	let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+	let state_root = *backend.root();
+	let requested_keys = [
+		RUNTIME_CODE_STORAGE_KEY,
+		keys.current_profile.as_slice(),
+		keys.enforcement.as_slice(),
+		keys.pending_keys.as_slice(),
+		keys.pending_reservation.as_slice(),
+		keys.consumed_reservation.as_slice(),
+		keys.invalidated_reservation.as_slice(),
+	];
+	let proof = prove_read(backend, requested_keys)
+		.expect("deterministic V4 state must produce a seven-key proof");
+	let proof_nodes = proof.into_iter_nodes().collect::<Vec<_>>();
+
+	let target = NativeHeader::new(
+		TARGET_NUMBER,
+		H256::repeat_byte(if include_pending { 0x90 } else { 0x91 }),
+		state_root,
+		anchor_hash(),
+		Digest::default(),
+	);
+	let (pairs, authorities) = authority_fixture();
+	let finality_proof = signed_finality_proof(&target, &pairs);
+
+	NativeFinalizedPooledReserveMintReservationStateRequestV4 {
+		schema: REQUEST_SCHEMA.to_owned(),
+		trust_anchor: TrustAnchorRequest {
+			sidechain_id_hex: format_hash(profile.sidechain_id),
+			checkpoint_hash_hex: format_hash(anchor_hash()),
+			checkpoint_number: u64::from(ANCHOR_NUMBER).to_string(),
+			grandpa_set_id: SET_ID.to_string(),
+			authority_list_scale_hex: format_bytes(&authorities.encode()),
+		},
+		target_native_block_hash_hex: format_hash(target.hash()),
+		target_header_scale_hex: format_bytes(&target.encode()),
+		linked_grandpa_proofs: Vec::<LinkedGrandpaProofRequest>::new(),
+		checkpoint_tail_headers_scale_hex: vec![format_bytes(&target.encode())],
+		finality_proof_scale_hex: format_bytes(&finality_proof),
+		statement: statement_request(&statement, statement_id, mint_identity, &keys),
+		reservation_state_proof_nodes_hex: proof_nodes
+			.iter()
+			.map(|node| format_bytes(node))
+			.collect(),
+	}
+}
+
+fn profile() -> PooledReserveMintReservationRuntimeProfileV4 {
+	PooledReserveMintReservationRuntimeProfileV4 {
+		format_version: 4,
+		lineage_profile_id: H256::repeat_byte(0x10),
+		source_network_id: H256::repeat_byte(0x11),
+		sidechain_id: H256::repeat_byte(0x12),
+		bridge_address: H160::repeat_byte(0x13),
+		token_address: H160::repeat_byte(0x14),
+		bridge_runtime_code_sha256: H256::repeat_byte(0x28),
+		bridge_runtime_code_bytes: 5,
+		token_runtime_code_sha256: H256::repeat_byte(0x29),
+		token_runtime_code_bytes: 5,
+		settlement_profile_id: H256::repeat_byte(0x15),
+		ergo_deposit_finality_policy_id: H256::repeat_byte(0x25),
+		source_proof_system_id: H256::repeat_byte(0x30),
+		source_proof_profile_id: H256::repeat_byte(0x31),
+		activation_height: 900,
+		max_pending_blocks: 100,
+	}
+}

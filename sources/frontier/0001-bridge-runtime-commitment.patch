+	assert_eq!(value.len() % 2, 0);
+	value
+		.as_bytes()
+		.chunks_exact(2)
+		.map(|pair| {
+			let high = fixture_hex_nibble_v4(pair[0]);
+			let low = fixture_hex_nibble_v4(pair[1]);
+			(high << 4) | low
+		})
+		.collect()
+}

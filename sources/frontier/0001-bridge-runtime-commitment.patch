+const ADMISSION_RECEIPTS: &[u8] = b"CausalPegInAdmissionReceiptsV1";
+const INVALIDATED_ADMISSIONS: &[u8] = b"InvalidatedCausalPegInsV1";
+const PROCESSED_PEG_INS: &[u8] = b"ProcessedPegIns";
+const CONSUMED_ADMISSIONS: &[u8] = b"ConsumedCausalPegInsV3";
+const PROFILE_DOMAIN: &[u8] = b"E2S_PEG_IN_CAUSAL_PROFILE_V2";
+const SOURCE_INTENT_DOMAIN: &[u8] = b"E2S_PEG_IN_SOURCE_INTENT_V2";
+const ADMISSION_DOMAIN: &[u8] = b"E2S_PEG_IN_CAUSAL_ADMISSION_V2";
+const SOURCE_PROOF_REQUEST_DOMAIN: &[u8] = b"E2S_PEG_IN_ERGO_SOURCE_PROOF_REQUEST_V1";
+const SOURCE_PROOF_SYSTEM_DOMAIN: &[u8] = b"E2S_PEG_IN_ERGO_FEDERATED_SOURCE_PROOF_V1";
+const SOURCE_FINALITY_POLICY_DOMAIN: &[u8] = b"E2S_PEG_IN_ERGO_FEDERATED_CONFIRMATION_POLICY_V1";
+const SOURCE_VERIFIER_PROFILE_DOMAIN: &[u8] = b"E2S_PEG_IN_ERGO_FEDERATED_SOURCE_PROOF_RUNTIME_V1";
+
+/// Stable schema for the deterministic T20E-E vector wrapper.
+pub const FIXTURE_VECTOR_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-causal-mint-transition.vector.v3";
+
+/// One deterministic request and its exact successful native result.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CausalPegInMintTransitionFixtureVectorV3 {
+	/// Exact fixture wrapper schema.
+	pub schema: String,
+	/// Independently supplied trust-anchor digest.
+	pub trusted_anchor_digest_hex: String,
+	/// Strict composed causal transition request.
+	pub request: NativeFinalizedPegInCausalMintTransitionRequestV3,
+	/// Expected result for canonical compact request bytes.
+	pub expected: NativeFinalizedPegInCausalMintTransitionVerificationV3,
+}
+
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+struct CausalRuntimeProfileScaleV2 {
+	profile_bytes: Vec<u8>,
+	profile_id: H256,
+	bridge_runtime_code_sha256: H256,
+	bridge_runtime_code_bytes: u32,

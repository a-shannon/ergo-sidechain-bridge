+
+	struct Fixture {
+		event: VerifiedFrontierPegInEventV1,
+		proof_nodes: Vec<Vec<u8>>,
+		bridge: H160,
+		token: H160,
+	}
+
+	struct StateValues {
+		bridge_code: Option<Vec<u8>>,
+		token_code: Option<Vec<u8>>,
+		bridge_owner: Option<Vec<u8>>,
+		configuration: Option<Vec<u8>>,
+		replay: Option<Vec<u8>>,
+		total_supply: Option<Vec<u8>>,
+		token_owner: Option<Vec<u8>>,
+	}
+
+	impl StateValues {
+		fn valid() -> Self {
+			Self {
+				bridge_code: Some(BRIDGE_CODE.to_vec().encode()),
+				token_code: Some(TOKEN_CODE.to_vec().encode()),
+				bridge_owner: Some(address_word(H160::repeat_byte(0x33)).as_bytes().to_vec()),
+				configuration: Some(
+					configuration_word(H160::repeat_byte(0x21), false, None)
+						.as_bytes()
+						.to_vec(),
+				),
+				replay: Some(H256::from_low_u64_be(1).as_bytes().to_vec()),
+				total_supply: Some(word(U256::from(2_000_000u64)).as_bytes().to_vec()),
+				token_owner: Some(address_word(H160::repeat_byte(0x22)).as_bytes().to_vec()),
+			}
+		}
+	}
+
+	fn fixture(values: StateValues) -> Fixture {
+		let bridge = H160::repeat_byte(0x22);
+		let token = H160::repeat_byte(0x21);
+		let box_id = H256::repeat_byte(0x44);
+		let keys = [
+			derive_evm_account_code_storage_key(bridge),
+			derive_evm_account_code_storage_key(token),
+			derive_evm_account_storage_key(bridge, H256::from_low_u64_be(BRIDGE_OWNER_SLOT)),
+			derive_evm_account_storage_key(
+				bridge,
+				H256::from_low_u64_be(BRIDGE_CONFIGURATION_SLOT),
+			),
+			derive_evm_account_storage_key(bridge, derive_processed_peg_in_mapping_slot(box_id)),
+			derive_evm_account_storage_key(token, H256::from_low_u64_be(TOKEN_TOTAL_SUPPLY_SLOT)),
+			derive_evm_account_storage_key(token, H256::from_low_u64_be(TOKEN_OWNER_SLOT)),
+		];
+		let mut state = BTreeMap::new();
+		for (key, value) in keys.iter().zip([
+			values.bridge_code,
+			values.token_code,
+			values.bridge_owner,
+			values.configuration,
+			values.replay,
+			values.total_supply,
+			values.token_owner,
+		]) {
+			if let Some(value) = value {
+				state.insert(key.clone(), value);
+			}
+		}
+		let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+		let state_root = *backend.root();
+		let proof = prove_read(backend, keys.iter().map(Vec::as_slice)).unwrap();
+		Fixture {
+			event: event(state_root, bridge, box_id),
+			proof_nodes: proof.into_iter_nodes().collect(),
+			bridge,
+			token,
+		}
+	}
+
+	fn event(
+		state_root: H256,
+		bridge_address: H160,
+		ergo_box_id: H256,
+	) -> VerifiedFrontierPegInEventV1 {
+		VerifiedFrontierPegInEventV1 {
+			state_root,
+			current_receipts_storage_key: [0; 32],
+			current_receipts_scale_sha256: [0; 32],
+			current_receipts_scale_bytes: 1,
+			current_transaction_statuses_storage_key: [0; 32],
+			current_transaction_statuses_scale_sha256: [0; 32],
+			current_transaction_statuses_scale_bytes: 1,
+			receipts_root: H256::repeat_byte(1),
+			receipt_count: 1,
+			transaction_status_count: 1,
+			transaction_index: 0,
+			transaction_log_index: 0,
+			global_event_index: 0,
+			receipt_type: "legacy",
+			transaction_hash: H256::repeat_byte(2),
+			bridge_address,
+			event_signature_topic: H256::repeat_byte(3),
+			recipient: H160::repeat_byte(4),
+			amount: 2_000_000,
+			ergo_box_id,
+			proof_node_count: 1,
+			proof_bytes: 1,
+		}
+	}
+
+	fn verify_fixture(
+		fixture: &Fixture,
+	) -> Result<VerifiedFrontierPegInContractStateV1, FrontierPegInContractStateProofError> {
+		verify_with_expectations(fixture, bridge_expectation(), token_expectation())
+	}
+
+	fn verify_with_expectations(
+		fixture: &Fixture,
+		bridge_code: FrontierRuntimeCodeExpectationV1,
+		token_code: FrontierRuntimeCodeExpectationV1,
+	) -> Result<VerifiedFrontierPegInContractStateV1, FrontierPegInContractStateProofError> {
+		verify_frontier_peg_in_contract_state_v1(
+			&fixture.event,
+			&fixture.proof_nodes,
+			fixture.bridge,
+			fixture.token,
+			bridge_code,
+			token_code,
+		)
+	}
+
+	fn bridge_expectation() -> FrontierRuntimeCodeExpectationV1 {
+		FrontierRuntimeCodeExpectationV1 {
+			sha256: sha2_256(BRIDGE_CODE),
+			bytes: BRIDGE_CODE.len(),
+		}
+	}
+
+	fn token_expectation() -> FrontierRuntimeCodeExpectationV1 {
+		FrontierRuntimeCodeExpectationV1 {
+			sha256: sha2_256(TOKEN_CODE),
+			bytes: TOKEN_CODE.len(),
+		}
+	}
+
+	fn set_storage_case(values: &mut StateValues, index: usize, value: Option<Vec<u8>>) {
+		match index {
+			0 => values.bridge_owner = value,
+			1 => values.configuration = value,
+			2 => values.replay = value,
+			3 => values.total_supply = value,
+			4 => values.token_owner = value,
+			_ => unreachable!(),
+		}
+	}
+
+	fn address_word(address: H160) -> H256 {
+		let mut bytes = [0u8; 32];
+		bytes[12..].copy_from_slice(address.as_bytes());
+		H256::from(bytes)
+	}
+
+	fn padded_address_word(address: H160) -> H256 {
+		let mut word = address_word(address);
+		word.as_bytes_mut()[0] = 1;
+		word
+	}
+
+	fn configuration_word(token: H160, paused: bool, mutation: Option<(usize, u8)>) -> H256 {
+		let mut bytes = [0u8; 32];
+		bytes[11] = u8::from(paused);
+		bytes[12..].copy_from_slice(token.as_bytes());
+		if let Some((index, value)) = mutation {
+			bytes[index] = value;
+		}
+		H256::from(bytes)
+	}
+
+	fn word(value: U256) -> H256 {
+		H256::from(value.to_big_endian())
+	}
+}

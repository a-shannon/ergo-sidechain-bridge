+		assert!(matches!(
+			encode_rpc_headers_request_bytes(&serde_json::to_vec(&unknown).unwrap()),
+			Err(RpcProofCodecError::Json(_))
+		));
+
+		let target = NativeHeader::decode_all(&mut &target_bytes[..]).unwrap();
+		let drift = RpcHeaderEncodingRequest {
+			schema: HEADER_ENCODING_REQUEST_SCHEMA.to_owned(),
+			headers: vec![RpcHeaderObservation {
+				expected_hash_hex: format_hash(H256::repeat_byte(0xff)),
+				header: target,
+			}],
+		};
+		assert!(matches!(
+			encode_rpc_headers_request_bytes(&serde_json::to_vec(&drift).unwrap()),
+			Err(RpcProofCodecError::HeaderHashMismatch { index: 0 })

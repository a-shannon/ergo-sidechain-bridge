+fn causal_runtime_profile(
+	sidechain_id: H256,
+	bridge_address: H160,
+	token_address: H160,
+	activation_height: u64,
+	bridge_runtime_code: &[u8],
+	token_runtime_code: &[u8],
+) -> CausalPegInRuntimeProfileV2 {
+	const PROFILE_DOMAIN: &[u8] = b"E2S_PEG_IN_CAUSAL_PROFILE_V2";
+	let source_proof_profile = StaticErgoFederatedSourceProofProfileV1::profile();
+	let source_proof_profile_id =
+		derive_federated_source_proof_profile_id_v1(&source_proof_profile)
+			.expect("static source-proof profile is canonical");
+	let mut profile_bytes = vec![2];
+	profile_bytes.extend_from_slice(H256::repeat_byte(0x11).as_bytes());
+	profile_bytes.extend_from_slice(sidechain_id.as_bytes());
+	profile_bytes.extend_from_slice(bridge_address.as_bytes());
+	profile_bytes.extend_from_slice(token_address.as_bytes());
+	profile_bytes.extend_from_slice(H256::repeat_byte(0x55).as_bytes());
+	profile_bytes.extend_from_slice(H256::repeat_byte(0xcc).as_bytes());
+	profile_bytes.extend_from_slice(H256::repeat_byte(0xff).as_bytes());
+	profile_bytes.extend_from_slice(source_proof_profile.finality_policy_id.as_bytes());
+	profile_bytes.extend_from_slice(federated_source_proof_system_id_v1().as_bytes());
+	profile_bytes.extend_from_slice(source_proof_profile_id.as_bytes());
+	profile_bytes.extend_from_slice(&3u64.to_be_bytes());
+	profile_bytes.extend_from_slice(&activation_height.to_be_bytes());
+	let profile_id = causal_domain_hash(PROFILE_DOMAIN, &profile_bytes);
+	assert_eq!(
+		derive_profile_id_v2(&profile_bytes).expect("node-test causal profile is canonical"),
+		profile_id,
+	);
+
+	CausalPegInRuntimeProfileV2 {
+		profile_bytes: profile_bytes
+			.try_into()
+			.expect("causal profile fits its exact runtime bound"),
+		profile_id,
+		bridge_runtime_code_sha256: H256::from(sha2_256(bridge_runtime_code)),
+		bridge_runtime_code_bytes: bridge_runtime_code.len() as u32,
+		token_runtime_code_sha256: H256::from(sha2_256(token_runtime_code)),
+		token_runtime_code_bytes: token_runtime_code.len() as u32,
+	}
+}

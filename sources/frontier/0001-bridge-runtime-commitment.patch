+/// Derive one top-level bridge pallet `StorageValue` key.
+pub fn derive_bridge_storage_value_key_v4(storage_name: &[u8]) -> Vec<u8> {
+	let mut key = Vec::with_capacity(32);
+	key.extend_from_slice(&twox_128(PALLET_NAME));
+	key.extend_from_slice(&twox_128(storage_name));
+	key
+}
+
+/// Derive one bridge pallet `Blake2_128Concat<H256>` map key.
+pub fn derive_bridge_storage_map_key_v4(storage_name: &[u8], map_key: H256) -> Vec<u8> {
+	let mut key = derive_bridge_storage_value_key_v4(storage_name);
+	key.extend_from_slice(&blake2_128(map_key.as_bytes()));
+	key.extend_from_slice(map_key.as_bytes());
+	key
+}
+
+/// Derive all six V4 bridge storage keys for one target reservation identity.
+pub fn derive_pooled_reserve_mint_reservation_state_storage_keys_v4(
+	reservation_key: H256,
+) -> PooledReserveMintReservationStateStorageKeysV4 {
+	PooledReserveMintReservationStateStorageKeysV4 {
+		current_profile: derive_bridge_storage_value_key_v4(CURRENT_PROFILE),
+		enforcement: derive_bridge_storage_value_key_v4(ENFORCEMENT),
+		pending_keys: derive_bridge_storage_value_key_v4(PENDING_KEYS),
+		pending_reservation: derive_bridge_storage_map_key_v4(
+			PENDING_RESERVATIONS,
+			reservation_key,
+		),
+		consumed_reservation: derive_bridge_storage_map_key_v4(
+			CONSUMED_RESERVATIONS,
+			reservation_key,
+		),
+		invalidated_reservation: derive_bridge_storage_map_key_v4(
+			INVALIDATED_RESERVATIONS,
+			reservation_key,
+		),
+	}
+}
+
+/// Validate the exact V4 statement bytes, domain-separated ID, and reservation key.
+pub fn validate_pooled_reserve_mint_reservation_state_statement_v4(
+	statement_bytes: &[u8],
+	expected_statement_id: H256,
+	expected_reservation_key: H256,
+) -> Result<
+	ValidatedPooledReserveMintReservationStatementV4,
+	PooledReserveMintReservationStateProofErrorV4,
+> {
+	if statement_bytes.len() != POOLED_RESERVE_MINT_RESERVATION_STATEMENT_V4_BYTES
+		|| statement_bytes[0] != 4
+	{
+		return Err(PooledReserveMintReservationStateProofErrorV4::StatementMismatch);
+	}
+	let lineage_profile_id = h256(statement_bytes, 1);
+	let source_intent = &statement_bytes[33..262];
+	if source_intent[0] != 2 {
+		return Err(PooledReserveMintReservationStateProofErrorV4::StatementMismatch);
+	}
+	let source_network_id = h256(source_intent, 1);
+	let sidechain_id = h256(source_intent, 33);
+	let bridge_address = h160(source_intent, 65);
+	let token_address = h160(source_intent, 85);
+	let settlement_profile_id = h256(source_intent, 105);
+	let admission_profile_id = h256(source_intent, 137);
+	let source_asset_id = h256(source_intent, 169);
+	let amount = u64_be(source_intent, 201);
+	let recipient = h160(source_intent, 209);
+	let source_intent_id = h256(statement_bytes, 262);
+	let mint_identity = h256(statement_bytes, 294);
+	let source_lock_box_id = h256(statement_bytes, 326);
+	let reserve_transition_transaction_id = h256(statement_bytes, 358);
+	let deposit_commitment = h256(statement_bytes, 390);
+	let successor_reserve_box_id = h256(statement_bytes, 422);
+	let successor_reserve_digest = &statement_bytes[454..487];
+	let successor_reserve_liability = u64_be(statement_bytes, 487);
+	let ergo_deposit_finality_policy_id = h256(statement_bytes, 495);
+	let inclusion_header_id = h256(statement_bytes, 527);
+	let inclusion_height = u32_be(statement_bytes, 559);
+	let target_header_id = h256(statement_bytes, 563);
+	let target_height = u32_be(statement_bytes, 595);
+	let required_successor_depth = u32_be(statement_bytes, 599);
+
+	let computed_statement_id = domain_hash(STATEMENT_ID_DOMAIN, statement_bytes);
+	let computed_source_intent_id = domain_hash(SOURCE_INTENT_ID_DOMAIN, source_intent);
+	let computed_mint_identity =
+		derive_mint_identity(lineage_profile_id, source_lock_box_id, deposit_commitment);
+	let target_height_valid =
+		inclusion_height.checked_add(required_successor_depth) == Some(target_height);
+	if lineage_profile_id == H256::zero()
+		|| source_network_id == H256::zero()
+		|| sidechain_id == H256::zero()
+		|| bridge_address == H160::zero()
+		|| token_address == H160::zero()
+		|| bridge_address == token_address
+		|| settlement_profile_id == H256::zero()
+		|| admission_profile_id != lineage_profile_id
+		|| source_asset_id != H256::zero()
+		|| amount == 0
+		|| amount > i64::MAX as u64
+		|| recipient == H160::zero()
+		|| source_intent_id != computed_source_intent_id
+		|| mint_identity == H256::zero()
+		|| mint_identity != computed_mint_identity
+		|| mint_identity != expected_reservation_key
+		|| source_lock_box_id == H256::zero()
+		|| reserve_transition_transaction_id == H256::zero()
+		|| deposit_commitment == H256::zero()
+		|| successor_reserve_box_id == H256::zero()
+		|| source_lock_box_id == successor_reserve_box_id
+		|| successor_reserve_digest.iter().all(|byte| *byte == 0)
+		|| successor_reserve_liability < amount
+		|| successor_reserve_liability > i64::MAX as u64
+		|| ergo_deposit_finality_policy_id == H256::zero()
+		|| inclusion_header_id == H256::zero()
+		|| target_header_id == H256::zero()
+		|| inclusion_header_id == target_header_id
+		|| required_successor_depth == 0
+		|| !target_height_valid
+		|| computed_statement_id != expected_statement_id
+	{
+		return Err(PooledReserveMintReservationStateProofErrorV4::StatementMismatch);
+	}
+
+	Ok(ValidatedPooledReserveMintReservationStatementV4 {
+		statement_bytes: statement_bytes.to_vec(),
+		statement_id: computed_statement_id,
+		mint_identity,
+		lineage_profile_id,
+		source_network_id,
+		sidechain_id,
+		bridge_address,
+		token_address,
+		settlement_profile_id,
+		ergo_deposit_finality_policy_id,
+	})
+}
+
+/// Verify the seven exact reads and classify one V4 reservation lifecycle state.
+#[allow(clippy::too_many_arguments)]
+pub fn verify_pooled_reserve_mint_reservation_state_v4(
+	state_root: H256,
+	target_native_height: u64,
+	statement_bytes: &[u8],
+	expected_statement_id: H256,
+	reservation_key: H256,
+	expected_runtime_code_sha256: H256,
+	expected_runtime_code_bytes: usize,
+	supplied_storage_keys: &PooledReserveMintReservationStateStorageKeysV4,
+	proof_nodes: &[Vec<u8>],
+) -> Result<
+	VerifiedPooledReserveMintReservationStateV4,
+	PooledReserveMintReservationStateProofErrorV4,
+> {
+	let statement = validate_pooled_reserve_mint_reservation_state_statement_v4(
+		statement_bytes,
+		expected_statement_id,
+		reservation_key,
+	)?;
+	let derived_keys =
+		derive_pooled_reserve_mint_reservation_state_storage_keys_v4(reservation_key);
+	validate_supplied_keys(supplied_storage_keys, &derived_keys)?;
+	if expected_runtime_code_bytes > MAX_POOLED_RESERVE_MINT_RESERVATION_RUNTIME_CODE_BYTES {
+		return Err(
+			PooledReserveMintReservationStateProofErrorV4::RuntimeCodeTooLarge {
+				actual: expected_runtime_code_bytes,
+				max: MAX_POOLED_RESERVE_MINT_RESERVATION_RUNTIME_CODE_BYTES,
+			},
+		);
+	}
+	let proof_bytes = validate_proof_bounds(proof_nodes)?;
+	let values = read_seven_keys(state_root, proof_nodes, &derived_keys)?;
+
+	let runtime_code = required(&values, RUNTIME_CODE_STORAGE_KEY)
+		.ok_or(PooledReserveMintReservationStateProofErrorV4::RuntimeCodeMissing)?;
+	if runtime_code.len() != expected_runtime_code_bytes
+		|| H256::from(sha2_256(runtime_code)) != expected_runtime_code_sha256
+	{
+		return Err(PooledReserveMintReservationStateProofErrorV4::RuntimeCodeMismatch);
+	}
+
+	let profile_raw = required(&values, &derived_keys.current_profile)
+		.ok_or(PooledReserveMintReservationStateProofErrorV4::ProfileMissing)?;
+	let profile = decode_canonical::<PooledReserveMintReservationRuntimeProfileV4>(
+		profile_raw,
+		"active profile",
+	)?;
+	let profile_id = validate_profile(&profile, &statement, target_native_height)?;
+	let enforcement_raw = required(&values, &derived_keys.enforcement)
+		.ok_or(PooledReserveMintReservationStateProofErrorV4::EnforcementInactive)?;
+	if !decode_canonical::<bool>(enforcement_raw, "enforcement")? {
+		return Err(PooledReserveMintReservationStateProofErrorV4::EnforcementInactive);
+	}
+
+	let pending_keys = match required(&values, &derived_keys.pending_keys) {
+		Some(raw) => decode_pending_keys(raw)?,
+		None => Vec::new(),
+	};
+	let pending_raw = required(&values, &derived_keys.pending_reservation);
+	let consumed_raw = required(&values, &derived_keys.consumed_reservation);
+	let invalidated_raw = required(&values, &derived_keys.invalidated_reservation);
+	let present_count = usize::from(pending_raw.is_some())
+		+ usize::from(consumed_raw.is_some())
+		+ usize::from(invalidated_raw.is_some());
+	if present_count > 1 {
+		return Err(PooledReserveMintReservationStateProofErrorV4::StateConflict);
+	}
+	let index_count = pending_keys
+		.iter()
+		.filter(|key| **key == reservation_key)
+		.count();
+
+	let reservation_state = if let Some(raw) = pending_raw {
+		if index_count != 1 {
+			return Err(PooledReserveMintReservationStateProofErrorV4::IndexStateConflict);
+		}
+		let pending =
+			decode_canonical::<PendingPooledReserveMintReservationV4>(raw, "pending reservation")?;
+		validate_pending(
+			&pending,
+			&profile,
+			profile_id,
+			&statement,
+			target_native_height,
+		)?;
+		PooledReserveMintReservationStateV4::Pending(pending)
+	} else if let Some(raw) = consumed_raw {
+		if index_count != 0 {
+			return Err(PooledReserveMintReservationStateProofErrorV4::IndexStateConflict);
+		}
+		let consumed = decode_canonical::<ConsumedPooledReserveMintReservationV4>(
+			raw,
+			"consumed reservation",
+		)?;
+		validate_consumed(&consumed, profile_id, &statement, target_native_height)?;
+		PooledReserveMintReservationStateV4::Consumed(consumed)
+	} else if let Some(raw) = invalidated_raw {
+		if index_count != 0 {
+			return Err(PooledReserveMintReservationStateProofErrorV4::IndexStateConflict);
+		}
+		let invalidated = decode_canonical::<InvalidatedPooledReserveMintReservationV4>(
+			raw,
+			"invalidated reservation",
+		)?;
+		validate_invalidated(&invalidated, profile_id, &statement, target_native_height)?;
+		PooledReserveMintReservationStateV4::Invalidated(invalidated)
+	} else {
+		if index_count != 0 {
+			return Err(PooledReserveMintReservationStateProofErrorV4::IndexStateConflict);
+		}
+		PooledReserveMintReservationStateV4::Absent
+	};
+
+	Ok(VerifiedPooledReserveMintReservationStateV4 {
+		state_root,
+		statement,
+		profile,
+		profile_id,
+		enforcement_active: true,
+		pending_keys,
+		reservation_state,
+		runtime_code_sha256: expected_runtime_code_sha256,
+		runtime_code_bytes: expected_runtime_code_bytes,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+fn validate_supplied_keys(
+	supplied: &PooledReserveMintReservationStateStorageKeysV4,
+	derived: &PooledReserveMintReservationStateStorageKeysV4,
+) -> Result<(), PooledReserveMintReservationStateProofErrorV4> {
+	for (field, supplied, derived) in [
+		(
+			"currentProfileStorageKeyHex",
+			&supplied.current_profile,
+			&derived.current_profile,
+		),
+		(
+			"enforcementStorageKeyHex",
+			&supplied.enforcement,
+			&derived.enforcement,
+		),
+		(
+			"pendingKeysStorageKeyHex",
+			&supplied.pending_keys,
+			&derived.pending_keys,
+		),
+		(
+			"pendingReservationStorageKeyHex",
+			&supplied.pending_reservation,
+			&derived.pending_reservation,
+		),
+		(
+			"consumedReservationStorageKeyHex",
+			&supplied.consumed_reservation,
+			&derived.consumed_reservation,
+		),
+		(
+			"invalidatedReservationStorageKeyHex",
+			&supplied.invalidated_reservation,
+			&derived.invalidated_reservation,
+		),
+	] {
+		if supplied != derived {
+			return Err(
+				PooledReserveMintReservationStateProofErrorV4::StorageKeyMismatch { field },
+			);
+		}
+	}
+	Ok(())
+}
+
+fn validate_proof_bounds(
+	proof_nodes: &[Vec<u8>],
+) -> Result<usize, PooledReserveMintReservationStateProofErrorV4> {
+	if proof_nodes.is_empty() {
+		return Err(PooledReserveMintReservationStateProofErrorV4::EmptyProof);
+	}
+	if proof_nodes.len() > MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODES {
+		return Err(
+			PooledReserveMintReservationStateProofErrorV4::TooManyNodes {
+				actual: proof_nodes.len(),
+				max: MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODES,
+			},
+		);
+	}
+	let mut proof_bytes = 0usize;
+	for (index, node) in proof_nodes.iter().enumerate() {
+		if node.len() > MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODE_BYTES {
+			return Err(
+				PooledReserveMintReservationStateProofErrorV4::NodeTooLarge {
+					index,
+					actual: node.len(),
+					max: MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODE_BYTES,
+				},
+			);
+		}
+		proof_bytes = proof_bytes.checked_add(node.len()).ok_or(
+			PooledReserveMintReservationStateProofErrorV4::ProofTooLarge {
+				actual: usize::MAX,
+				max: MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_BYTES,
+			},
+		)?;
+		if proof_bytes > MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_BYTES {
+			return Err(
+				PooledReserveMintReservationStateProofErrorV4::ProofTooLarge {
+					actual: proof_bytes,
+					max: MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_BYTES,
+				},
+			);
+		}
+	}
+	Ok(proof_bytes)
+}
+
+fn read_seven_keys(
+	state_root: H256,
+	proof_nodes: &[Vec<u8>],
+	keys: &PooledReserveMintReservationStateStorageKeysV4,
+) -> Result<
+	std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	PooledReserveMintReservationStateProofErrorV4,
+> {
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| PooledReserveMintReservationStateProofErrorV4::DuplicateNodes)?;
+	let requested = [
+		RUNTIME_CODE_STORAGE_KEY,
+		keys.current_profile.as_slice(),
+		keys.enforcement.as_slice(),
+		keys.pending_keys.as_slice(),
+		keys.pending_reservation.as_slice(),
+		keys.consumed_reservation.as_slice(),
+		keys.invalidated_reservation.as_slice(),
+	];
+	read_proof_check::<BlakeTwo256, _>(state_root, proof, requested)
+		.map_err(|_| PooledReserveMintReservationStateProofErrorV4::InvalidProof)
+}
+
+fn required<'a>(
+	values: &'a std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+) -> Option<&'a [u8]> {
+	values.get(key).and_then(Option::as_deref)
+}
+
+fn decode_canonical<T: DecodeAll + Encode>(
+	raw: &[u8],
+	field: &'static str,
+) -> Result<T, PooledReserveMintReservationStateProofErrorV4> {
+	let decoded = T::decode_all(&mut &raw[..])
+		.map_err(|_| PooledReserveMintReservationStateProofErrorV4::MalformedScale { field })?;
+	if decoded.encode().as_slice() != raw {
+		return Err(PooledReserveMintReservationStateProofErrorV4::MalformedScale { field });
+	}
+	Ok(decoded)
+}
+
+fn decode_pending_keys(
+	raw: &[u8],
+) -> Result<Vec<H256>, PooledReserveMintReservationStateProofErrorV4> {
+	let keys = decode_canonical::<Vec<H256>>(raw, "pending index")?;
+	if keys.len() > MAX_PENDING_POOLED_RESERVE_MINT_RESERVATIONS_V4 {
+		return Err(PooledReserveMintReservationStateProofErrorV4::PendingIndexInvalid);
+	}
+	for (index, key) in keys.iter().enumerate() {
+		if *key == H256::zero() || (index > 0 && keys[index - 1] >= *key) {
+			return Err(PooledReserveMintReservationStateProofErrorV4::PendingIndexInvalid);
+		}
+	}
+	Ok(keys)
+}
+
+fn validate_profile(
+	profile: &PooledReserveMintReservationRuntimeProfileV4,
+	statement: &ValidatedPooledReserveMintReservationStatementV4,
+	target_native_height: u64,
+) -> Result<H256, PooledReserveMintReservationStateProofErrorV4> {
+	if profile.format_version != 4
+		|| profile.lineage_profile_id == H256::zero()
+		|| profile.source_network_id == H256::zero()
+		|| profile.sidechain_id == H256::zero()
+		|| profile.bridge_address == H160::zero()
+		|| profile.token_address == H160::zero()
+		|| profile.bridge_address == profile.token_address
+		|| profile.bridge_runtime_code_sha256 == H256::zero()
+		|| profile.bridge_runtime_code_bytes == 0
+		|| profile.token_runtime_code_sha256 == H256::zero()
+		|| profile.token_runtime_code_bytes == 0
+		|| profile.settlement_profile_id == H256::zero()
+		|| profile.ergo_deposit_finality_policy_id == H256::zero()
+		|| profile.source_proof_system_id == H256::zero()
+		|| profile.source_proof_profile_id == H256::zero()
+		|| profile.max_pending_blocks == 0
+		|| profile.activation_height > target_native_height
+		|| profile.lineage_profile_id != statement.lineage_profile_id
+		|| profile.source_network_id != statement.source_network_id
+		|| profile.sidechain_id != statement.sidechain_id
+		|| profile.bridge_address != statement.bridge_address
+		|| profile.token_address != statement.token_address
+		|| profile.settlement_profile_id != statement.settlement_profile_id
+		|| profile.ergo_deposit_finality_policy_id != statement.ergo_deposit_finality_policy_id
+	{
+		return Err(PooledReserveMintReservationStateProofErrorV4::ProfileMismatch);
+	}
+	Ok(domain_hash(PROFILE_ID_DOMAIN, &profile.encode()))
+}
+
+fn validate_pending(
+	pending: &PendingPooledReserveMintReservationV4,
+	profile: &PooledReserveMintReservationRuntimeProfileV4,
+	profile_id: H256,
+	statement: &ValidatedPooledReserveMintReservationStatementV4,
+	target_native_height: u64,
+) -> Result<(), PooledReserveMintReservationStateProofErrorV4> {
+	let latest_expiry = pending
+		.reserved_at_native_height
+		.checked_add(u64::from(profile.max_pending_blocks));
+	if pending.format_version != 4
+		|| pending.profile_id != profile_id
+		|| pending.statement_bytes != statement.statement_bytes
+		|| pending.statement_id != statement.statement_id
+		|| pending.mint_identity != statement.mint_identity
+		|| pending.source_statement_bytes_digest
+			!= H256::from(blake2_256(&statement.statement_bytes))
+		|| pending.source_proof_system_id != profile.source_proof_system_id
+		|| pending.source_proof_profile_id != profile.source_proof_profile_id
+		|| pending.source_proof_issued_at_native_height < profile.activation_height
+		|| pending.source_proof_issued_at_native_height > pending.reserved_at_native_height
+		|| pending.reserved_at_native_height > target_native_height
+		|| pending.source_proof_request_digest == H256::zero()
+		|| pending.source_proof_result_id == H256::zero()
+		|| pending.source_proof_digest == H256::zero()
+		|| pending.expires_at_native_height <= pending.reserved_at_native_height
+		|| latest_expiry
+			.map(|latest| pending.expires_at_native_height > latest)
+			.unwrap_or(true)
+	{
+		return Err(PooledReserveMintReservationStateProofErrorV4::PendingRecordMismatch);
+	}
+	Ok(())
+}
+
+fn validate_consumed(
+	consumed: &ConsumedPooledReserveMintReservationV4,
+	profile_id: H256,
+	statement: &ValidatedPooledReserveMintReservationStatementV4,
+	target_native_height: u64,
+) -> Result<(), PooledReserveMintReservationStateProofErrorV4> {
+	if consumed.format_version != 4
+		|| consumed.profile_id != profile_id
+		|| consumed.statement_id != statement.statement_id
+		|| consumed.mint_identity != statement.mint_identity
+		|| consumed.consumed_at_native_height > target_native_height
+		|| consumed.execution_block_hash == H256::zero()
+		|| consumed.transaction_hash == H256::zero()
+	{
+		return Err(PooledReserveMintReservationStateProofErrorV4::ConsumedRecordMismatch);
+	}
+	Ok(())
+}
+
+fn validate_invalidated(
+	invalidated: &InvalidatedPooledReserveMintReservationV4,
+	profile_id: H256,
+	statement: &ValidatedPooledReserveMintReservationStatementV4,
+	target_native_height: u64,
+) -> Result<(), PooledReserveMintReservationStateProofErrorV4> {
+	if invalidated.format_version != 4
+		|| invalidated.profile_id != profile_id
+		|| invalidated.statement_id != statement.statement_id
+		|| invalidated.mint_identity != statement.mint_identity
+		|| invalidated.invalidated_at_native_height > target_native_height
+		|| invalidated.reason_code == 0
+		|| invalidated.invalidation_id == H256::zero()
+	{
+		return Err(PooledReserveMintReservationStateProofErrorV4::InvalidatedRecordMismatch);
+	}
+	Ok(())
+}
+
+fn derive_mint_identity(
+	lineage_profile_id: H256,
+	source_lock_box_id: H256,
+	deposit_commitment: H256,
+) -> H256 {
+	let mut preimage = Vec::with_capacity(MINT_ID_DOMAIN.len() + 96);
+	preimage.extend_from_slice(MINT_ID_DOMAIN);
+	preimage.extend_from_slice(lineage_profile_id.as_bytes());
+	preimage.extend_from_slice(source_lock_box_id.as_bytes());
+	preimage.extend_from_slice(deposit_commitment.as_bytes());
+	H256::from(blake2_256(&preimage))
+}
+
+fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+	let mut preimage = Vec::with_capacity(domain.len() + bytes.len());
+	preimage.extend_from_slice(domain);
+	preimage.extend_from_slice(bytes);
+	H256::from(blake2_256(&preimage))
+}
+
+fn h256(bytes: &[u8], offset: usize) -> H256 {
+	H256::from_slice(&bytes[offset..offset + 32])
+}
+
+fn h160(bytes: &[u8], offset: usize) -> H160 {
+	H160::from_slice(&bytes[offset..offset + 20])
+}
+
+fn u32_be(bytes: &[u8], offset: usize) -> u32 {
+	u32::from_be_bytes(
+		bytes[offset..offset + 4]
+			.try_into()
+			.expect("four-byte slice"),
+	)
+}
+
+fn u64_be(bytes: &[u8], offset: usize) -> u64 {
+	u64::from_be_bytes(
+		bytes[offset..offset + 8]
+			.try_into()
+			.expect("eight-byte slice"),
+	)
+}

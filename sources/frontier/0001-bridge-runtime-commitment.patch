+
+	let finality_proof = parse_byte_hex(
+		"finalityProofScaleHex",
+		&request.finality_proof_scale_hex,
+		MAX_FINALITY_PROOF_BYTES,
+	)?;
+	let ergo_box_id = parse_hash("statement.ergoBoxIdHex", &request.statement.ergo_box_id_hex)?;
+	let record_bytes = exact_scale_bytes(
+		"statement.expectedRecordScaleHex",
+		&request.statement.expected_record_scale_hex,
+		PEG_IN_RECORD_V1_SCALE_BYTES,
+	)?;
+	let expected_record =
+		PegInRuntimeRecordV1::decode_all(&mut &record_bytes[..]).map_err(|_| {
+			NativeFrontierExecutionIdentityRequestError::Scale {
+				field: "statement.expectedRecordScaleHex",
+			}
+		})?;
+
+	ensure_collection(
+		"runtimeStateProofNodesHex",
+		request.runtime_state_proof_nodes_hex.len(),
+		1,
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES,
+	)?;
+	let state_nodes = request
+		.runtime_state_proof_nodes_hex
+		.iter()
+		.map(|node| {
+			parse_byte_hex(
+				"runtimeStateProofNodesHex",
+				node,
+				MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+			)
+		})
+		.collect::<Result<Vec<_>, _>>()?;
+
+	let verified = verify_frontier_execution_identity_deployment_checkpoint::<NativeBlock>(
+		&anchor,
+		trusted_anchor_digest,
+		target_header,
+		&linked_proofs,
+		&checkpoint_tail_headers,
+		&finality_proof,
+		runtime_code,
+		ergo_box_id,
+		&expected_record,
+		&state_nodes,
+	)?;
+	let requested_header = &verified.finalized_state.requested_header;
+	let state = &verified.finalized_state.state;
+	let block = &state.current_block;
+	let record = &state.record;
+	let request_digest = BlakeTwo256::hash(raw_request);
+	let authority_set_hash = derive_grandpa_authority_set_hash(&verified.authenticated_authorities);
+
+	let verification = NativeFrontierExecutionIdentityVerification {
+		schema: VERIFICATION_SCHEMA.to_owned(),
+		status:
+			"NATIVE_PEG_IN_FRONTIER_EXECUTION_IDENTITY_VERIFIED_RELATIVE_TO_REVIEWED_TRUST_ROOT"
+				.to_owned(),
+		request_digest_hex: format_hash(request_digest),
+		trust_anchor_digest_hex: format_hash(verified.trust_anchor_digest),
+		target: VerifiedTargetOutput {
+			native_block_hash_hex: format_hash(requested_header.hash()),
+			native_height: u64::from(*requested_header.number()).to_string(),
+			state_root_hex: format_hash(*requested_header.state_root()),
+		},
+		authority: VerifiedAuthorityOutput {
+			finality_signing_set_id: verified.authenticated_set_id.to_string(),
+			finality_signing_authority_list_scale_hex: format_bytes(

+		assert!(matches!(
+			verify_request_bytes(&serde_json::to_vec(&request).unwrap(), &anchor),
+			Err(NativePegInStateRequestError::MembershipProfileForbidden)
+		));
+
+		let mut request = deterministic_non_membership_fixture_request();
+		request.statement.expected_profile_scale_hex = None;
+		assert!(matches!(
+			verify_request_bytes(&serde_json::to_vec(&request).unwrap(), &anchor),
+			Err(NativePegInStateRequestError::NonMembershipProfileRequired)
+		));
+	}
+}

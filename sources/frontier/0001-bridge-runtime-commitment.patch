+	fn assert_v4_expiry_rejects_pending_mutation(
+		mutate: impl FnOnce(&mut PendingPooledReserveMintReservationV4),
+	) {
+		runtime_ext().execute_with(|| {
+			let fixture = install_pooled_reserve_mint_reservation_fixture();
+			assert_ok!(Pallet::<Runtime>::reserve_pooled_reserve_mint_v4(
+				RuntimeOrigin::signed(H160::repeat_byte(0x72).into()),
+				fixture.statement_bytes,
+				fixture.source_proof,
+			));
+			let mut pending =
+				PendingPooledReserveMintReservationsV4::<Runtime>::get(fixture.mint_identity)
+					.expect("reservation is pending before corruption");
+			mutate(&mut pending);
+			PendingPooledReserveMintReservationsV4::<Runtime>::insert(
+				fixture.mint_identity,
+				&pending,
+			);
+			let attempted_height =
+				fixture.current_height + u64::from(fixture.profile.max_pending_blocks) + 1;
+			System::set_block_number(attempted_height as u32);
+
+			assert_noop!(
+				Pallet::<Runtime>::expire_pooled_reserve_mint_reservation_v4(
+					RuntimeOrigin::signed(H160::repeat_byte(0x73).into()),
+					fixture.mint_identity,
+				),
+				Error::<Runtime>::InvalidPooledReserveMintReservationState,
+			);
+			assert_eq!(
+				PendingPooledReserveMintReservationsV4::<Runtime>::get(fixture.mint_identity),
+				Some(pending)
+			);
+			assert_eq!(
+				PendingPooledReserveMintReservationKeysV4::<Runtime>::get().to_vec(),
+				vec![fixture.mint_identity]
+			);
+			assert!(InvalidatedPooledReserveMintReservationsV4::<Runtime>::get(
+				fixture.mint_identity
+			)
+			.is_none());
+		});
+	}

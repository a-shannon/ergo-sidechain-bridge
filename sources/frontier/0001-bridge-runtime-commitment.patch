+) -> PendingPooledReserveMintReservationV4 {
+	PendingPooledReserveMintReservationV4 {
+		format_version: 4,
+		profile_id,
+		statement_bytes: statement.to_vec(),
+		statement_id,
+		mint_identity,
+		source_statement_bytes_digest: H256::from(blake2_256(statement)),
+		source_proof_system_id: profile.source_proof_system_id,
+		source_proof_profile_id: profile.source_proof_profile_id,
+		source_proof_issued_at_native_height: 920,
+		source_proof_request_digest: H256::repeat_byte(0x40),
+		source_proof_result_id: H256::repeat_byte(0x41),
+		source_proof_digest: H256::repeat_byte(0x42),
+		reserved_at_native_height: 924,
+		expires_at_native_height: 1_024,
+	}
+}
+
+fn statement_request(
+	statement: &[u8],
+	statement_id: H256,
+	mint_identity: H256,
+	keys: &PooledReserveMintReservationStateStorageKeysV4,
+) -> PooledReserveMintReservationStateStatementRequestV4 {
+	PooledReserveMintReservationStateStatementRequestV4 {
+		schema: STATEMENT_SCHEMA.to_owned(),
+		statement_hex: format_bytes(statement),
+		statement_id_hex: format_hash(statement_id),
+		reservation_key_hex: format_hash(mint_identity),
+		bridge_runtime_code_sha256_hex: format_hash(H256::from(sha2_256(RUNTIME_CODE))),
+		bridge_runtime_code_bytes: RUNTIME_CODE.len().to_string(),
+		current_profile_storage_key_hex: format_bytes(&keys.current_profile),
+		enforcement_storage_key_hex: format_bytes(&keys.enforcement),
+		pending_keys_storage_key_hex: format_bytes(&keys.pending_keys),
+		pending_reservation_storage_key_hex: format_bytes(&keys.pending_reservation),
+		consumed_reservation_storage_key_hex: format_bytes(&keys.consumed_reservation),
+		invalidated_reservation_storage_key_hex: format_bytes(&keys.invalidated_reservation),
+	}
+}
+
+fn anchor_hash() -> H256 {
+	H256::repeat_byte(0x10)
+}
+
+fn authority_fixture() -> (Vec<ed25519::Pair>, AuthorityList) {
+	let pairs = (1u8..=3)
+		.map(|seed| ed25519::Pair::from_seed(&[seed; 32]))
+		.collect::<Vec<_>>();
+	let authorities = pairs
+		.iter()
+		.map(|pair| (pair.public().into(), 1u64))
+		.collect();
+	(pairs, authorities)
+}
+
+fn signed_finality_proof(header: &NativeHeader, pairs: &[ed25519::Pair]) -> Vec<u8> {
+	let precommit = Precommit {
+		target_hash: header.hash(),
+		target_number: *header.number(),
+	};
+	let message = sp_consensus_grandpa::Message::<NativeHeader>::Precommit(precommit.clone());
+	let payload = sp_consensus_grandpa::localized_payload(ROUND, SET_ID, &message);
+	let precommits = pairs
+		.iter()
+		.map(|pair| SignedPrecommit {
+			precommit: precommit.clone(),
+			signature: pair.sign(&payload).into(),
+			id: pair.public().into(),
+		})
+		.collect();
+	let justification: GrandpaJustification<NativeBlock> =
+		sp_consensus_grandpa::GrandpaJustification::<NativeHeader> {
+			round: ROUND,
+			commit: Commit {
+				target_hash: header.hash(),
+				target_number: *header.number(),
+				precommits,
+			},
+			votes_ancestries: Vec::new(),
+		}
+		.into();
+	FinalityProof::<NativeHeader> {
+		block: header.hash(),
+		justification: justification.encode(),
+		unknown_headers: Vec::new(),
+	}
+	.encode()
+}
+
+fn derive_mint_identity(
+	lineage_profile_id: H256,
+	source_lock_box_id: H256,
+	deposit_commitment: H256,
+) -> H256 {
+	let mut preimage = Vec::new();
+	preimage.extend_from_slice(MINT_ID_DOMAIN);
+	preimage.extend_from_slice(lineage_profile_id.as_bytes());
+	preimage.extend_from_slice(source_lock_box_id.as_bytes());
+	preimage.extend_from_slice(deposit_commitment.as_bytes());
+	H256::from(blake2_256(&preimage))
+}
+
+fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+	let mut preimage = Vec::new();
+	preimage.extend_from_slice(domain);
+	preimage.extend_from_slice(bytes);
+	H256::from(blake2_256(&preimage))
+}

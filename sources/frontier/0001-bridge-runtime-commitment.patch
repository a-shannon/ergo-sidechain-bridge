+fn verify_ergo_autolykos_v2_relay_runtime_witness_with_profile_v1(
+	witness_bytes: &[u8],
+	expected_spv_profile_id: H256,
+) -> Result<VerifiedErgoAutolykosV2RelayRuntimeWitnessV1, &'static str> {
+	if witness_bytes.len() < ENVELOPE_HEADER_BYTES_V1
+		|| witness_bytes.len() > ERGO_AUTOLYKOS_V2_RELAY_RUNTIME_WITNESS_MAX_BYTES_V1
+	{
+		return Err("Ergo relay runtime witness length is outside its bound");
+	}
+	let mut envelope = CursorV1::new(witness_bytes);
+	if envelope.take(8)? != MAGIC_V1 {
+		return Err("Ergo relay runtime witness magic is unsupported");
+	}
+	if envelope.u8()? != ERGO_AUTOLYKOS_V2_RELAY_RUNTIME_WITNESS_FORMAT_V1 {
+		return Err("Ergo relay runtime witness format is unsupported");
+	}
+	if envelope.u8()? != 0 {
+		return Err("Ergo relay runtime witness flags are unsupported");
+	}
+	if envelope.u16()? as usize != SECTION_COUNT_V1 {
+		return Err("Ergo relay runtime witness section count is unsupported");
+	}
+	if envelope.u32()? as usize != witness_bytes.len() {
+		return Err("Ergo relay runtime witness total length is inconsistent");
+	}
+	if H256::from(envelope.array::<32>()?) != ergo_autolykos_v2_relay_runtime_witness_family_id_v1()
+	{
+		return Err("Ergo relay runtime witness format-family ID is unsupported");
+	}
+	let mut section_lengths = [0usize; SECTION_COUNT_V1];
+	let mut payload_length = 0usize;
+	for (index, length) in section_lengths.iter_mut().enumerate() {
+		if envelope.u8()? as usize != index + 1 {
+			return Err("Ergo relay runtime witness section order is unsupported");
+		}
+		if envelope.u8()? != 0 {
+			return Err("Ergo relay runtime witness section flags are unsupported");
+		}
+		*length = envelope.u32()? as usize;
+		payload_length = payload_length
+			.checked_add(*length)
+			.ok_or("Ergo relay runtime witness section lengths overflow")?;
+	}
+	if payload_length != witness_bytes.len() - ENVELOPE_HEADER_BYTES_V1 {
+		return Err("Ergo relay runtime witness section lengths are inconsistent");
+	}
+	let profile_bytes = envelope.take(section_lengths[0])?;
+	let checkpoint_bytes = envelope.take(section_lengths[1])?;
+	let branches_bytes = envelope.take(section_lengths[2])?;
+	let target_bytes = envelope.take(section_lengths[3])?;
+	envelope.end("Ergo relay runtime witness contains trailing bytes")?;
+
+	let profile = parse_profile_v1(profile_bytes, expected_spv_profile_id)?;
+	let target = parse_single_header_section_v1(target_bytes)?;
+	let checkpoint = parse_checkpoint_v1(checkpoint_bytes, &profile)?;
+	let mut autolykos_m = Vec::with_capacity(1024 * 8);
+	for index in 0u64..1024 {
+		autolykos_m.extend_from_slice(&index.to_be_bytes());
+	}
+	let branches =
+		verify_branches_v1(branches_bytes, &profile, &checkpoint, &target, &autolykos_m)?;
+	let current = branches
+		.first()
+		.ok_or("Ergo relay runtime witness has no current branch")?;
+	let confirmations = current
+		.target_confirmations
+		.ok_or("Ergo relay runtime target is absent from the current branch")?;
+	if confirmations < profile.required_confirmations as u32 {
+		return Err("Ergo relay runtime target is below required depth");
+	}
+	let known_branches_digest = known_branches_digest_v1(&branches)?;
+	let target_length = u32::try_from(target.canonical.len())
+		.map_err(|_| "Ergo relay runtime target header length exceeds UInt32")?;
+
+	Ok(VerifiedErgoAutolykosV2RelayRuntimeWitnessV1 {
+		witness_id: derive_ergo_autolykos_v2_relay_runtime_witness_id_v1(witness_bytes)?,
+		spv_profile_id: profile.spv_profile_id,
+		source_network_id: profile.source_network_id,
+		checkpoint_header_id: checkpoint.header.header_id,
+		checkpoint_height: checkpoint.header.height,
+		known_branches_digest,
+		known_branch_count: branches
+			.len()
+			.try_into()
+			.map_err(|_| "Ergo relay runtime branch count exceeds UInt16")?,
+		selected_tip_header_id: current.identity.tip_header_id,
+		selected_tip_height: current.identity.tip_height,
+		selected_cumulative_work: current.identity.cumulative_work,
+		target_header_id: target.header_id,
+		target_height: target.height,
+		target_block_version: target.version,
+		target_state_root: target.state_root,
+		target_transactions_root: target.transactions_root,
+		target_canonical_header_sha256: H256::from(sha2_256(target.canonical)),
+		target_canonical_header_length: target_length,
+		confirmations,
+		required_confirmations: profile.required_confirmations as u32,
+	})
+}
+
+fn parse_profile_v1(
+	bytes: &[u8],
+	expected_spv_profile_id: H256,
+) -> Result<RelayProfileV1, &'static str> {
+	if bytes.len() != PROFILE_SECTION_BYTES_V1 {
+		return Err("Ergo relay runtime profile section length is invalid");
+	}
+	let mut cursor = CursorV1::new(bytes);
+	let spv_profile_id = H256::from(cursor.array::<32>()?);
+	if spv_profile_id != expected_spv_profile_id {
+		return Err("Ergo relay runtime witness SPV profile is not statically registered");
+	}
+	let profile = RelayProfileV1 {
+		spv_profile_id,
+		source_network_id: H256::from(cursor.array::<32>()?),
+		checkpoint_header_id: H256::from(cursor.array::<32>()?),
+		checkpoint_context_digest: H256::from(cursor.array::<32>()?),
+		checkpoint_cumulative_work: cursor.u256()?,
+		expected_header_version: cursor.u8()?,
+		activation_height: cursor.u32()?,
+		epoch_length: cursor.u32()?,
+		use_last_epochs: cursor.u32()?,
+		desired_block_interval_ms: cursor.u64()?,
+		initial_difficulty: cursor.u256()?,
+		required_confirmations: cursor.u16()?,
+		maximum_headers: cursor.u16()?,
+		maximum_future_drift_ms: cursor.u64()?,
+	};
+	cursor.end("Ergo relay runtime profile section contains trailing bytes")?;
+	validate_profile_v1(&profile)?;
+	if compute_spv_profile_id_v1(&profile)? != profile.spv_profile_id {
+		return Err("Ergo relay runtime witness SPV profile ID is inconsistent");
+	}
+	Ok(profile)
+}
+
+fn validate_profile_v1(profile: &RelayProfileV1) -> Result<(), &'static str> {
+	if profile.checkpoint_cumulative_work.is_zero() {
+		return Err("Ergo relay checkpoint cumulative work must be positive");
+	}
+	if !(2..=4).contains(&profile.expected_header_version) {
+		return Err("Ergo relay expected header version is unsupported");
+	}
+	if profile.activation_height == 0 || profile.activation_height > MAX_I32_V1 {
+		return Err("Ergo relay EIP-37 activation height is invalid");
+	}
+	if profile.epoch_length <= 1 || profile.use_last_epochs <= 1 {
+		return Err("Ergo relay EIP-37 epoch profile is invalid");
+	}
+	if profile.use_last_epochs as usize + 1 > MAX_DIFFICULTY_CONTEXT_HEADERS_V1 {
+		return Err("Ergo relay EIP-37 context profile exceeds its bound");
+	}
+	if profile.epoch_length >= MAX_I32_V1 / profile.use_last_epochs {
+		return Err("Ergo relay EIP-37 epoch history exceeds Int32");
+	}
+	if profile.desired_block_interval_ms == 0 || profile.initial_difficulty.is_zero() {
+		return Err("Ergo relay EIP-37 interval and initial difficulty must be positive");
+	}
+	if profile.required_confirmations == 0
+		|| profile.maximum_headers < profile.required_confirmations
+		|| profile.maximum_headers as usize > MAX_HEADERS_PER_BRANCH_V1
+	{
+		return Err("Ergo relay SPV header and depth bounds are invalid");
+	}
+	Ok(())
+}
+
+fn compute_spv_profile_id_v1(profile: &RelayProfileV1) -> Result<H256, &'static str> {
+	let mut body = Vec::with_capacity(PROFILE_DOMAIN_V1.len() + 193);
+	body.extend_from_slice(PROFILE_DOMAIN_V1);
+	body.extend_from_slice(profile.source_network_id.as_bytes());
+	body.extend_from_slice(profile.checkpoint_header_id.as_bytes());
+	body.extend_from_slice(profile.checkpoint_context_digest.as_bytes());
+	body.extend_from_slice(&profile.checkpoint_cumulative_work.to_big_endian());
+	body.push(profile.expected_header_version);
+	body.extend_from_slice(&profile.activation_height.to_be_bytes());
+	body.extend_from_slice(&profile.epoch_length.to_be_bytes());
+	body.extend_from_slice(&profile.use_last_epochs.to_be_bytes());
+	body.extend_from_slice(&profile.desired_block_interval_ms.to_be_bytes());
+	body.extend_from_slice(&profile.initial_difficulty.to_big_endian());
+	body.extend_from_slice(&(profile.required_confirmations as u32).to_be_bytes());
+	body.extend_from_slice(&(profile.maximum_headers as u32).to_be_bytes());
+	body.extend_from_slice(&profile.maximum_future_drift_ms.to_be_bytes());
+	Ok(H256::from(blake2_256(&body)))
+}
+
+fn parse_checkpoint_v1<'a>(
+	bytes: &'a [u8],
+	profile: &RelayProfileV1,
+) -> Result<CheckpointV1<'a>, &'static str> {
+	let mut cursor = CursorV1::new(bytes);
+	let source_network_id = H256::from(cursor.array::<32>()?);
+	if source_network_id != profile.source_network_id {
+		return Err("Ergo relay checkpoint source network does not match its profile");
+	}
+	let header = cursor.header()?;
+	let count = cursor.u16()? as usize;
+	if count > MAX_DIFFICULTY_CONTEXT_HEADERS_V1 {
+		return Err("Ergo relay difficulty context exceeds its bound");
+	}
+	let mut difficulty_context = Vec::with_capacity(count);
+	let mut previous_height = None;
+	for _ in 0..count {
+		let entry = DifficultyHeaderV1 {
+			height: cursor.u32()?,
+			timestamp: cursor.u64()?,
+			n_bits: cursor.u32()?,
+		};
+		if entry.timestamp > MAX_I64_V1 {
+			return Err("Ergo relay difficulty-context timestamp exceeds Int64");
+		}
+		if previous_height.is_some_and(|height| entry.height <= height) {
+			return Err("Ergo relay difficulty-context heights are not strictly increasing");
+		}
+		positive_compact_difficulty_v1(entry.n_bits)?;
+		previous_height = Some(entry.height);
+		difficulty_context.push(entry);
+	}
+	cursor.end("Ergo relay checkpoint section contains trailing bytes")?;
+	if header.header_id != profile.checkpoint_header_id {
+		return Err("Ergo relay checkpoint header does not match its profile");
+	}
+	if header.version != profile.expected_header_version {
+		return Err("Ergo relay checkpoint version does not match its profile");
+	}
+	if header
+		.height
+		.checked_add(1)
+		.ok_or("Ergo relay checkpoint height overflows")?
+		< profile.activation_height
+	{
+		return Err("Ergo relay checkpoint predates the supported EIP-37 profile");
+	}
+	if compute_difficulty_context_digest_v1(&difficulty_context)?
+		!= profile.checkpoint_context_digest
+	{
+		return Err("Ergo relay checkpoint difficulty-context digest mismatch");
+	}
+	validate_checkpoint_context_heights_v1(profile, &header, &difficulty_context)?;
+	Ok(CheckpointV1 {
+		header,
+		difficulty_context,
+	})
+}
+
+fn parse_single_header_section_v1(bytes: &[u8]) -> Result<HeaderV1<'_>, &'static str> {
+	let mut cursor = CursorV1::new(bytes);
+	let header = cursor.header()?;
+	cursor.end("Ergo relay target section contains trailing bytes")?;
+	Ok(header)
+}
+
+fn parse_header_v1(bytes: &[u8]) -> Result<HeaderV1<'_>, &'static str> {
+	if bytes.is_empty() || bytes.len() > MAX_CANONICAL_HEADER_BYTES_V1 {
+		return Err("canonical Ergo header length is outside the runtime bound");
+	}
+	let mut cursor = CursorV1::new(bytes);
+	let version = cursor.u8()?;
+	if !(2..=4).contains(&version) {
+		return Err("canonical Ergo header version is unsupported");
+	}
+	let parent_id = H256::from(cursor.array::<32>()?);
+	let _ad_proofs_root = cursor.array::<32>()?;
+	let transactions_root = H256::from(cursor.array::<32>()?);
+	let state_root = cursor.array::<33>()?;
+	let timestamp = cursor.unsigned_vlq(MAX_I64_V1)?;
+	let _extension_hash = cursor.array::<32>()?;
+	let n_bits = cursor.u32()?;
+	let height = cursor.unsigned_vlq(MAX_I32_V1 as u64)? as u32;
+	let _votes = cursor.array::<3>()?;
+	if cursor.u8()? != 0 {
+		return Err("canonical Ergo header unparsed bytes are unsupported");
+	}
+	let without_pow_length = cursor.position();
+	let public_key = cursor.array::<33>()?;
+	PublicKey::parse_compressed(&public_key)
+		.map_err(|_| "canonical Ergo header public key is invalid")?;
+	let nonce = cursor.array::<8>()?;
+	cursor.end("canonical Ergo header contains trailing bytes")?;
+	Ok(HeaderV1 {
+		canonical: bytes,
+		without_pow: &bytes[..without_pow_length],
+		header_id: H256::from(blake2_256(bytes)),
+		version,
+		parent_id,
+		transactions_root,
+		state_root,
+		timestamp,
+		n_bits,
+		height,
+		nonce,
+	})
+}
+
+struct CursorV1<'a> {
+	bytes: &'a [u8],
+	offset: usize,
+}
+
+impl<'a> CursorV1<'a> {
+	fn new(bytes: &'a [u8]) -> Self {
+		Self { bytes, offset: 0 }
+	}
+
+	fn position(&self) -> usize {
+		self.offset
+	}
+
+	fn take(&mut self, length: usize) -> Result<&'a [u8], &'static str> {
+		let end = self
+			.offset
+			.checked_add(length)
+			.ok_or("binary cursor offset overflow")?;
+		if end > self.bytes.len() {
+			return Err("binary field exceeds its section boundary");
+		}
+		let result = &self.bytes[self.offset..end];
+		self.offset = end;
+		Ok(result)
+	}
+
+	fn array<const N: usize>(&mut self) -> Result<[u8; N], &'static str> {
+		self.take(N)?
+			.try_into()
+			.map_err(|_| "binary field has an invalid fixed width")
+	}
+
+	fn u8(&mut self) -> Result<u8, &'static str> {
+		Ok(self.take(1)?[0])
+	}
+
+	fn u16(&mut self) -> Result<u16, &'static str> {
+		Ok(u16::from_be_bytes(self.array()?))
+	}
+
+	fn u32(&mut self) -> Result<u32, &'static str> {
+		Ok(u32::from_be_bytes(self.array()?))
+	}
+
+	fn u64(&mut self) -> Result<u64, &'static str> {
+		Ok(u64::from_be_bytes(self.array()?))
+	}
+
+	fn u256(&mut self) -> Result<U256, &'static str> {
+		Ok(U256::from_big_endian(self.take(32)?))
+	}
+
+	fn unsigned_vlq(&mut self, maximum: u64) -> Result<u64, &'static str> {
+		let mut result = 0u64;
+		let mut shift = 0u32;
+		let mut count = 0usize;
+		loop {
+			let byte = self.u8()?;
+			let payload = (byte & 0x7f) as u64;
+			let shifted = payload
+				.checked_shl(shift)
+				.ok_or("canonical Ergo header unsigned VLQ is too long")?;
+			result = result
+				.checked_add(shifted)
+				.ok_or("canonical Ergo header unsigned VLQ overflows")?;
+			count += 1;
+			if result > maximum {
+				return Err("canonical Ergo header unsigned VLQ exceeds its range");
+			}
+			if byte & 0x80 == 0 {
+				if count > 1 && payload == 0 {
+					return Err("canonical Ergo header uses a non-canonical unsigned VLQ");
+				}
+				return Ok(result);
+			}
+			shift = shift
+				.checked_add(7)
+				.ok_or("canonical Ergo header unsigned VLQ is too long")?;
+			if shift > 63 {
+				return Err("canonical Ergo header unsigned VLQ is too long");
+			}
+		}
+	}
+
+	fn header(&mut self) -> Result<HeaderV1<'a>, &'static str> {
+		let length = self.u16()? as usize;
+		if length == 0 || length > MAX_CANONICAL_HEADER_BYTES_V1 {
+			return Err("canonical Ergo header length is outside the runtime bound");
+		}
+		parse_header_v1(self.take(length)?)
+	}
+
+	fn end(&self, error: &'static str) -> Result<(), &'static str> {
+		if self.offset == self.bytes.len() {
+			Ok(())
+		} else {
+			Err(error)
+		}
+	}
+}
+
+fn verify_branches_v1(
+	bytes: &[u8],
+	profile: &RelayProfileV1,
+	checkpoint: &CheckpointV1<'_>,
+	target: &HeaderV1<'_>,
+	autolykos_m: &[u8],
+) -> Result<Vec<BranchResultV1>, &'static str> {
+	let mut cursor = CursorV1::new(bytes);
+	let branch_count = cursor.u8()? as usize;
+	if branch_count == 0 || branch_count > MAX_BRANCHES_V1 {
+		return Err("Ergo relay runtime branch count is invalid");
+	}
+	let mut total_headers = 0usize;
+	let mut branches = Vec::with_capacity(branch_count);
+	let mut seen_tips = Vec::<H256>::with_capacity(branch_count);
+	let mut current_work = None;
+	let mut previous_competing_tip = None;
+	for branch_index in 0..branch_count {
+		let role_value = cursor.u8()?;
+		if (branch_index == 0 && role_value != 0) || (branch_index > 0 && role_value != 1) {
+			return Err("Ergo relay runtime branch roles are unsupported");
+		}
+		let observed_at_timestamp = cursor.u64()?;
+		if observed_at_timestamp > MAX_I64_V1 {
+			return Err("Ergo relay runtime observation timestamp exceeds Int64");
+		}
+		let header_count = cursor.u16()? as usize;
+		if header_count == 0
+			|| header_count > profile.maximum_headers as usize
+			|| header_count > MAX_HEADERS_PER_BRANCH_V1
+		{
+			return Err("Ergo relay runtime branch header count is invalid");
+		}
+		total_headers = total_headers
+			.checked_add(header_count)
+			.ok_or("Ergo relay runtime total header count overflows")?;
+		if total_headers > MAX_TOTAL_HEADERS_V1 {
+			return Err("Ergo relay runtime total header count exceeds its bound");
+		}
+		let result = verify_branch_v1(
+			&mut cursor,
+			header_count,
+			if role_value == 0 {
+				"current"
+			} else {
+				"competing"
+			},
+			observed_at_timestamp,
+			profile,
+			checkpoint,
+			target,
+			autolykos_m,
+		)?;
+		if seen_tips.contains(&result.identity.tip_header_id) {
+			return Err("Ergo relay runtime witness contains a duplicate branch tip");
+		}
+		if branch_index == 0 {
+			current_work = Some(result.identity.cumulative_work);
+		} else {
+			if previous_competing_tip
+				.is_some_and(|tip: H256| result.identity.tip_header_id.as_bytes() <= tip.as_bytes())
+			{
+				return Err("Ergo relay runtime competing branches are not ordered by tip ID");
+			}
+			if result.identity.cumulative_work
+				> current_work.ok_or("Ergo relay runtime current branch is missing")?
+			{
+				return Err("Ergo relay runtime current branch is not greatest-work");
+			}
+			previous_competing_tip = Some(result.identity.tip_header_id);
+		}
+		seen_tips.push(result.identity.tip_header_id);
+		branches.push(result);
+	}
+	cursor.end("Ergo relay runtime branches section contains trailing bytes")?;
+	Ok(branches)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn verify_branch_v1<'a>(
+	cursor: &mut CursorV1<'a>,
+	header_count: usize,
+	role: &'static str,
+	observed_at_timestamp: u64,
+	profile: &RelayProfileV1,
+	checkpoint: &CheckpointV1<'_>,
+	target: &HeaderV1<'_>,
+	autolykos_m: &[u8],
+) -> Result<BranchResultV1, &'static str> {
+	let mut difficulty_history = checkpoint.difficulty_context.clone();
+	difficulty_history.push(DifficultyHeaderV1 {
+		height: checkpoint.header.height,
+		timestamp: checkpoint.header.timestamp,
+		n_bits: checkpoint.header.n_bits,
+	});
+	let mut parent_id = checkpoint.header.header_id;
+	let mut parent = DifficultyHeaderV1 {
+		height: checkpoint.header.height,
+		timestamp: checkpoint.header.timestamp,
+		n_bits: checkpoint.header.n_bits,
+	};
+	let mut cumulative_work = profile.checkpoint_cumulative_work;
+	let mut seen_headers = Vec::<H256>::with_capacity(header_count + 1);
+	seen_headers.push(checkpoint.header.header_id);
+	let mut target_index = None;
+	let mut tip_header_id = checkpoint.header.header_id;
+	let mut tip_height = checkpoint.header.height;
+	let mut scratch = Vec::with_capacity(8_256);
+
+	for index in 0..header_count {
+		let candidate = cursor.header()?;
+		if candidate.version != profile.expected_header_version {
+			return Err("Ergo relay runtime suffix header version does not match its profile");
+		}
+		if candidate.timestamp > observed_at_timestamp
+			&& candidate.timestamp - observed_at_timestamp > profile.maximum_future_drift_ms
+		{
+			return Err("Ergo relay runtime suffix header exceeds the future timestamp limit");
+		}
+		let expected_difficulty =
+			expected_eip37_difficulty_v1(parent, &difficulty_history, profile)?;
+		let difficulty = admit_autolykos_v2_header_v1(
+			&candidate,
+			parent_id,
+			parent,
+			expected_difficulty,
+			autolykos_m,
+			&mut scratch,
+		)?;
+		if seen_headers.contains(&candidate.header_id) {
+			return Err("Ergo relay runtime suffix contains a duplicate header identity");
+		}
+		seen_headers.push(candidate.header_id);
+		cumulative_work = cumulative_work
+			.checked_add(difficulty)
+			.ok_or("Ergo relay runtime cumulative work exceeds UInt256")?;
+		if candidate.header_id == target.header_id {
+			if candidate.canonical != target.canonical {
+				return Err(
+					"Ergo relay runtime target bytes differ from the selected branch header",
+				);
+			}
+			target_index = Some(index);
+		}
+		difficulty_history.push(DifficultyHeaderV1 {
+			height: candidate.height,
+			timestamp: candidate.timestamp,
+			n_bits: candidate.n_bits,
+		});
+		parent_id = candidate.header_id;
+		parent = DifficultyHeaderV1 {
+			height: candidate.height,
+			timestamp: candidate.timestamp,
+			n_bits: candidate.n_bits,
+		};
+		tip_header_id = candidate.header_id;
+		tip_height = candidate.height;
+	}
+	let target_confirmations = target_index.map(|index| (header_count - index) as u32);
+	Ok(BranchResultV1 {
+		identity: BranchIdentityV1 {
+			role,
+			tip_header_id,
+			tip_height,
+			cumulative_work,
+		},
+		target_confirmations,
+	})
+}
+
+fn admit_autolykos_v2_header_v1(
+	header: &HeaderV1<'_>,
+	expected_parent_id: H256,
+	parent: DifficultyHeaderV1,
+	expected_difficulty: U256,
+	autolykos_m: &[u8],
+	scratch: &mut Vec<u8>,
+) -> Result<U256, &'static str> {
+	if header.parent_id != expected_parent_id {
+		return Err("Ergo relay runtime suffix header does not extend its parent");
+	}
+	if header.height
+		!= parent
+			.height
+			.checked_add(1)
+			.ok_or("Ergo relay parent height overflows")?
+	{
+		return Err("Ergo relay runtime suffix height is not parent height plus one");
+	}
+	if header.timestamp <= parent.timestamp {
+		return Err("Ergo relay runtime suffix timestamp does not advance");
+	}
+	let expected_n_bits = encode_compact_difficulty_v1(expected_difficulty)?;
+	if header.n_bits != expected_n_bits {
+		return Err("Ergo relay runtime suffix header does not bind expected difficulty");
+	}
+	let difficulty = positive_compact_difficulty_v1(header.n_bits)?;
+	let target = secp256k1_order_v1()
+		.checked_div(difficulty)
+		.ok_or("Ergo relay runtime Autolykos difficulty is invalid")?;
+	let hit = calculate_autolykos_v2_hit_v1(header, autolykos_m, scratch)?;
+	if hit >= target {
+		return Err("Ergo relay runtime Autolykos proof of work misses its target");
+	}
+	Ok(difficulty)
+}
+
+fn calculate_autolykos_v2_hit_v1(
+	header: &HeaderV1<'_>,
+	autolykos_m: &[u8],
+	scratch: &mut Vec<u8>,
+) -> Result<U256, &'static str> {
+	let message = blake2_256(header.without_pow);
+	scratch.clear();
+	scratch.extend_from_slice(&message);
+	scratch.extend_from_slice(&header.nonce);
+	let pre_index_digest = blake2_256(scratch);
+	let pre_index = u64::from_be_bytes(
+		pre_index_digest[24..32]
+			.try_into()
+			.map_err(|_| "Ergo relay runtime pre-index digest is malformed")?,
+	);
+	let table_size = autolykos_v2_table_size_v1(header.height)?;
+	let index = (pre_index % table_size as u64) as u32;
+	let height_bytes = header.height.to_be_bytes();
+
+	scratch.clear();
+	scratch.extend_from_slice(&index.to_be_bytes());
+	scratch.extend_from_slice(&height_bytes);
+	scratch.extend_from_slice(autolykos_m);
+	let f_digest = blake2_256(scratch);
+	let f = &f_digest[1..];
+
+	scratch.clear();
+	scratch.extend_from_slice(f);
+	scratch.extend_from_slice(&message);
+	scratch.extend_from_slice(&header.nonce);
+	let index_digest = blake2_256(scratch);
+	let mut extended_index_digest = [0u8; 35];
+	extended_index_digest[..32].copy_from_slice(&index_digest);
+	extended_index_digest[32..].copy_from_slice(&index_digest[..3]);
+
+	let mut sum = U256::zero();
+	for offset in 0..AUTOLYKOS_K_V2 {
+		let raw_index = u32::from_be_bytes(
+			extended_index_digest[offset..offset + 4]
+				.try_into()
+				.map_err(|_| "Ergo relay runtime element index is malformed")?,
+		);
+		let element_index = (raw_index as u64 % table_size as u64) as u32;
+		scratch.clear();
+		scratch.extend_from_slice(&element_index.to_be_bytes());
+		scratch.extend_from_slice(&height_bytes);
+		scratch.extend_from_slice(autolykos_m);
+		let element_digest = blake2_256(scratch);
+		let element = U256::from_big_endian(&element_digest[1..]);
+		sum = sum
+			.checked_add(element)
+			.ok_or("Ergo relay runtime Autolykos element sum exceeds UInt256")?;
+	}
+	Ok(U256::from_big_endian(&blake2_256(&sum.to_big_endian())))
+}
+
+fn autolykos_v2_table_size_v1(height: u32) -> Result<u32, &'static str> {
+	if height > MAX_I32_V1 {
+		return Err("Ergo relay runtime Autolykos height exceeds Int32");
+	}
+	let bounded_height = height.min(AUTOLYKOS_N_MAX_HEIGHT_V2);
+	if bounded_height < AUTOLYKOS_N_INCREASE_START_V2 {
+		return Ok(AUTOLYKOS_N_BASE_V2 as u32);
+	}
+	let iterations =
+		((bounded_height - AUTOLYKOS_N_INCREASE_START_V2) / AUTOLYKOS_N_INCREASE_PERIOD_V2) + 1;
+	let mut table_size = AUTOLYKOS_N_BASE_V2;
+	for _ in 0..iterations {
+		table_size = (table_size / 100)
+			.checked_mul(105)
+			.ok_or("Ergo relay runtime Autolykos table size overflows")?;
+	}
+	table_size
+		.try_into()
+		.map_err(|_| "Ergo relay runtime Autolykos table size exceeds UInt32")
+}
+
+fn secp256k1_order_v1() -> U256 {
+	U256::from_big_endian(&SECP256K1_ORDER_BYTES)
+}
+
+fn compute_difficulty_context_digest_v1(
+	context: &[DifficultyHeaderV1],
+) -> Result<H256, &'static str> {
+	let count: u16 = context
+		.len()
+		.try_into()
+		.map_err(|_| "Ergo relay difficulty context exceeds UInt16")?;
+	let mut body = Vec::with_capacity(CONTEXT_DOMAIN_V1.len() + 2 + context.len() * 16);
+	body.extend_from_slice(CONTEXT_DOMAIN_V1);
+	body.extend_from_slice(&count.to_be_bytes());
+	let mut previous_height = None;
+	for header in context {
+		if previous_height.is_some_and(|height| header.height <= height) {
+			return Err("Ergo relay difficulty-context heights are not strictly increasing");
+		}
+		if header.timestamp > MAX_I64_V1 {
+			return Err("Ergo relay difficulty-context timestamp exceeds Int64");
+		}
+		positive_compact_difficulty_v1(header.n_bits)?;
+		body.extend_from_slice(&header.height.to_be_bytes());
+		body.extend_from_slice(&header.timestamp.to_be_bytes());
+		body.extend_from_slice(&header.n_bits.to_be_bytes());
+		previous_height = Some(header.height);
+	}
+	Ok(H256::from(blake2_256(&body)))
+}
+
+fn validate_checkpoint_context_heights_v1(
+	profile: &RelayProfileV1,
+	checkpoint: &HeaderV1<'_>,
+	context: &[DifficultyHeaderV1],
+) -> Result<(), &'static str> {
+	let next_recalculation_height = if checkpoint.height % profile.epoch_length == 0 {
+		checkpoint
+			.height
+			.checked_add(1)
+			.ok_or("Ergo relay checkpoint recalculation height overflows")?
+	} else {
+		let epoch = checkpoint.height / profile.epoch_length;
+		epoch
+			.checked_add(1)
+			.and_then(|value| value.checked_mul(profile.epoch_length))
+			.and_then(|value| value.checked_add(1))
+			.ok_or("Ergo relay checkpoint recalculation height overflows")?
+	};
+	let required = required_eip37_context_heights_v1(next_recalculation_height, profile)?
+		.into_iter()
+		.filter(|height| *height < checkpoint.height)
+		.collect::<Vec<_>>();
+	if context.len() != required.len()
+		|| context
+			.iter()
+			.zip(required.iter())
+			.any(|(actual, expected)| actual.height != *expected)
+	{
+		return Err("Ergo relay checkpoint difficulty-context heights are incomplete");
+	}
+	Ok(())
+}
+
+fn required_eip37_context_heights_v1(
+	next_height: u32,
+	profile: &RelayProfileV1,
+) -> Result<Vec<u32>, &'static str> {
+	if next_height == 0 {
+		return Err("Ergo relay next header height must be positive");
+	}
+	let parent_height = next_height - 1;
+	if parent_height % profile.epoch_length != 0 {
+		return Ok(vec![parent_height]);
+	}
+	let mut heights = Vec::with_capacity(profile.use_last_epochs as usize + 1);
+	for index in (0..=profile.use_last_epochs).rev() {
+		let offset = index
+			.checked_mul(profile.epoch_length)
+			.ok_or("Ergo relay EIP-37 context height overflows")?;
+		if offset <= parent_height {
+			heights.push(parent_height - offset);
+		}
+	}
+	Ok(heights)
+}
+
+fn expected_eip37_difficulty_v1(
+	parent: DifficultyHeaderV1,
+	context: &[DifficultyHeaderV1],
+	profile: &RelayProfileV1,
+) -> Result<U256, &'static str> {
+	let next_height = parent
+		.height
+		.checked_add(1)
+		.ok_or("Ergo relay EIP-37 next height overflows")?;
+	if next_height < profile.activation_height {
+		return Err("Ergo relay EIP-37 profile is not active");
+	}
+	if parent.height % profile.epoch_length != 0 {
+		return positive_compact_difficulty_v1(parent.n_bits);
+	}
+	let expected_heights = required_eip37_context_heights_v1(next_height, profile)?;
+	let mut headers = Vec::with_capacity(expected_heights.len());
+	for expected_height in expected_heights {
+		let mut matches = context
+			.iter()
+			.filter(|header| header.height == expected_height);
+		let found = *matches
+			.next()
+			.ok_or("Ergo relay EIP-37 context header is missing")?;
+		if matches.next().is_some() {
+			return Err("Ergo relay EIP-37 context height is duplicated");
+		}
+		headers.push(found);
+	}
+	if headers.last().map(|header| header.height) != Some(parent.height) {
+		return Err("Ergo relay EIP-37 context does not terminate at the parent");
+	}
+	calculate_eip37_difficulty_v1(&headers, profile)
+}
+
+fn calculate_eip37_difficulty_v1(
+	headers: &[DifficultyHeaderV1],
+	profile: &RelayProfileV1,
+) -> Result<U256, &'static str> {
+	if headers.len() < 2 {
+		return Err("Ergo relay EIP-37 recalculation requires at least two headers");
+	}
+	let last_difficulty = positive_compact_difficulty_v1(
+		headers
+			.last()
+			.ok_or("Ergo relay EIP-37 context is empty")?
+			.n_bits,
+	)?;
+	let predictive = calculate_predictive_difficulty_v1(headers, profile)?;
+	let limited_predictive = if predictive > last_difficulty {
+		minimum_u256_wide_v1(predictive, multiply_ratio_v1(last_difficulty, 3, 2)?)?
+	} else {
+		predictive.max(last_difficulty / U256::from(2u8))
+	};
+	let classic = calculate_bitcoin_difficulty_v1(headers, profile)?;
+	let average = narrow_u512_v1(
+		U512::from(classic)
+			.checked_add(U512::from(limited_predictive))
+			.ok_or("Ergo relay EIP-37 average overflows")?
+			/ U512::from(2u8),
+	)?;
+	let bounded = if average > last_difficulty {
+		minimum_u256_wide_v1(average, multiply_ratio_v1(last_difficulty, 3, 2)?)?
+	} else {
+		average.max(last_difficulty / U256::from(2u8))
+	};
+	normalize_difficulty_v1(bounded)
+}
+
+fn calculate_predictive_difficulty_v1(
+	headers: &[DifficultyHeaderV1],
+	profile: &RelayProfileV1,
+) -> Result<U256, &'static str> {
+	let first = headers
+		.first()
+		.ok_or("Ergo relay predictive context is empty")?;
+	let last = headers
+		.last()
+		.ok_or("Ergo relay predictive context is empty")?;
+	let uncompressed = if headers.len() == 1 || first.timestamp >= last.timestamp {
+		positive_compact_difficulty_v1(first.n_bits)?
+	} else {
+		let mut data = Vec::with_capacity(headers.len() - 1);
+		for pair in headers.windows(2) {
+			let start = pair[0];
+			let end = pair[1];
+			if end.height.checked_sub(start.height) != Some(profile.epoch_length) {
+				return Err("Ergo relay EIP-37 context heights do not match the epoch length");
+			}
+			let elapsed = end
+				.timestamp
+				.checked_sub(start.timestamp)
+				.ok_or("Ergo relay EIP-37 context timestamps do not increase")?;
+			if elapsed == 0 {
+				return Err("Ergo relay EIP-37 context timestamps do not increase");
+			}
+			let difficulty = multiply_divide_u256_v1(
+				positive_compact_difficulty_v1(end.n_bits)?,
+				profile.desired_block_interval_ms,
+				profile.epoch_length as u64,
+				elapsed,
+			)?;
+			data.push((end.height, difficulty));
+		}
+		let interpolated = interpolate_difficulty_v1(&data, profile.epoch_length)?;
+		if interpolated.negative || interpolated.magnitude < U512::one() {
+			profile.initial_difficulty
+		} else {
+			narrow_u512_v1(interpolated.magnitude)?
+		}
+	};
+	normalize_difficulty_v1(uncompressed)
+}
+
+fn interpolate_difficulty_v1(
+	data: &[(u32, U256)],
+	epoch_length: u32,
+) -> Result<SignedWideV1, &'static str> {
+	if data.is_empty() {
+		return Err("Ergo relay difficulty interpolation has no points");
+	}
+	if data.len() == 1 {
+		return Ok(SignedWideV1::positive(U512::from(data[0].1)));
+	}
+	let size = U512::from(data.len() as u64);
+	let mut xy_sum = U512::zero();
+	let mut x_squared_sum = U512::zero();
+	let mut y_sum = U512::zero();
+	let mut x_sum = U512::zero();
+	let mut maximum_height = 0u32;
+	for (height, difficulty) in data {
+		let x = U512::from(*height);
+		let y = U512::from(*difficulty);
+		xy_sum = checked_add_wide_v1(xy_sum, checked_mul_wide_v1(x, y)?)?;
+		x_squared_sum = checked_add_wide_v1(x_squared_sum, checked_mul_wide_v1(x, x)?)?;
+		y_sum = checked_add_wide_v1(y_sum, y)?;
+		x_sum = checked_add_wide_v1(x_sum, x)?;
+		maximum_height = maximum_height.max(*height);
+	}
+	let denominator = checked_sub_wide_v1(
+		checked_mul_wide_v1(x_squared_sum, size)?,
+		checked_mul_wide_v1(x_sum, x_sum)?,
+	)?;
+	if denominator.is_zero() {
+		return Err("Ergo relay difficulty interpolation heights are degenerate");
+	}
+	let slope_numerator = SignedWideV1::positive(checked_mul_wide_v1(xy_sum, size)?)
+		.sub(SignedWideV1::positive(checked_mul_wide_v1(x_sum, y_sum)?))?;
+	let slope = slope_numerator
+		.mul_unsigned(U512::from(EIP37_PRECISION_V1))?
+		.div_unsigned(denominator)?;
+	let intercept =
+		SignedWideV1::positive(checked_mul_wide_v1(y_sum, U512::from(EIP37_PRECISION_V1))?)
+			.sub(slope.mul_unsigned(x_sum)?)?
+			.div_unsigned(size)?
+			.div_unsigned(U512::from(EIP37_PRECISION_V1))?;
+	let point = maximum_height
+		.checked_add(epoch_length)
+		.ok_or("Ergo relay difficulty interpolation height overflows")?;
+	intercept.add(
+		slope
+			.mul_unsigned(U512::from(point))?
+			.div_unsigned(U512::from(EIP37_PRECISION_V1))?,
+	)
+}
+
+fn calculate_bitcoin_difficulty_v1(
+	headers: &[DifficultyHeaderV1],
+	profile: &RelayProfileV1,
+) -> Result<U256, &'static str> {
+	let start = headers
+		.get(
+			headers
+				.len()
+				.checked_sub(2)
+				.ok_or("Ergo relay EIP-37 context is too short")?,
+		)
+		.ok_or("Ergo relay EIP-37 context is too short")?;
+	let end = headers.last().ok_or("Ergo relay EIP-37 context is empty")?;
+	let elapsed = end
+		.timestamp
+		.checked_sub(start.timestamp)
+		.ok_or("Ergo relay Bitcoin-style timestamps do not increase")?;
+	if elapsed == 0 {
+		return Err("Ergo relay Bitcoin-style timestamps do not increase");
+	}
+	multiply_divide_u256_v1(
+		positive_compact_difficulty_v1(end.n_bits)?,
+		profile.desired_block_interval_ms,
+		profile.epoch_length as u64,
+		elapsed,
+	)
+}
+
+fn multiply_divide_u256_v1(
+	value: U256,
+	first: u64,
+	second: u64,
+	divisor: u64,
+) -> Result<U256, &'static str> {
+	if divisor == 0 {
+		return Err("Ergo relay wide division by zero");
+	}
+	let wide = checked_mul_wide_v1(U512::from(value), U512::from(first))?;
+	let wide = checked_mul_wide_v1(wide, U512::from(second))?;
+	narrow_u512_v1(wide / U512::from(divisor))
+}
+
+fn multiply_ratio_v1(value: U256, numerator: u8, denominator: u8) -> Result<U512, &'static str> {
+	if denominator == 0 {
+		return Err("Ergo relay ratio denominator is zero");
+	}
+	Ok(checked_mul_wide_v1(U512::from(value), U512::from(numerator))? / U512::from(denominator))
+}
+
+fn minimum_u256_wide_v1(value: U256, bound: U512) -> Result<U256, &'static str> {
+	if U512::from(value) < bound {
+		Ok(value)
+	} else {
+		narrow_u512_v1(bound)
+	}
+}
+
+fn normalize_difficulty_v1(difficulty: U256) -> Result<U256, &'static str> {
+	positive_compact_difficulty_v1(encode_compact_difficulty_v1(difficulty)?)
+}
+
+fn positive_compact_difficulty_v1(n_bits: u32) -> Result<U256, &'static str> {
+	if n_bits & 0x0080_0000 != 0 {
+		return Err("Ergo relay compact difficulty must be positive");
+	}
+	let size = n_bits >> 24;
+	let mantissa = n_bits & 0x007f_ffff;
+	let value = if size <= 3 {
+		U256::from(mantissa >> (8 * (3 - size)))
+	} else if mantissa == 0 {
+		U256::zero()
+	} else {
+		let shift = 8usize
+			.checked_mul((size - 3) as usize)
+			.ok_or("Ergo relay compact difficulty shift overflows")?;
+		let mantissa_bits = 32usize - mantissa.leading_zeros() as usize;
+		if shift
+			.checked_add(mantissa_bits)
+			.map_or(true, |bits| bits > 256)
+		{
+			return Err("Ergo relay compact difficulty exceeds UInt256");
+		}
+		U256::from(mantissa) << shift
+	};
+	if value.is_zero() {
+		return Err("Ergo relay compact difficulty must be positive");
+	}
+	Ok(value)
+}
+
+fn encode_compact_difficulty_v1(difficulty: U256) -> Result<u32, &'static str> {
+	if difficulty.is_zero() {
+		return Ok(0);
+	}
+	let mut size = ((difficulty.bits() + 7) / 8) as u32;
+	let mut compact = if size <= 3 {
+		difficulty.low_u32() << (8 * (3 - size))
+	} else {
+		(difficulty >> (8usize * (size as usize - 3))).low_u32()
+	};
+	if compact & 0x0080_0000 != 0 {
+		compact >>= 8;
+		size = size
+			.checked_add(1)
+			.ok_or("Ergo relay compact difficulty size overflows")?;
+	}
+	if size > 0xff {
+		return Err("Ergo relay difficulty cannot be encoded as compact nBits");
+	}
+	Ok(compact | (size << 24))
+}
+
+fn known_branches_digest_v1(branches: &[BranchResultV1]) -> Result<H256, &'static str> {
+	let mut canonical = String::from("[");
+	for (index, branch) in branches.iter().enumerate() {
+		if index > 0 {
+			canonical.push(',');
+		}
+		write!(
+			canonical,
+			"{{\"cumulativeWork\":\"{}\",\"role\":\"{}\",\"tipHeaderIdHex\":\"{}\",\"tipHeight\":{}}}",
+			branch.identity.cumulative_work,
+			branch.identity.role,
+			hex_lower_v1(branch.identity.tip_header_id.as_bytes()),
+			branch.identity.tip_height,
+		)
+		.map_err(|_| "Ergo relay known-branches canonical JSON failed")?;
+	}
+	canonical.push(']');
+	Ok(H256::from(sha2_256(canonical.as_bytes())))
+}
+
+fn hex_lower_v1(bytes: &[u8]) -> String {
+	const HEX: &[u8; 16] = b"0123456789abcdef";
+	let mut output = String::with_capacity(bytes.len() * 2);
+	for byte in bytes {
+		output.push(HEX[(byte >> 4) as usize] as char);
+		output.push(HEX[(byte & 0x0f) as usize] as char);
+	}
+	output
+}
+
+fn checked_add_wide_v1(left: U512, right: U512) -> Result<U512, &'static str> {
+	left.checked_add(right)
+		.ok_or("Ergo relay UInt512 addition overflows")
+}
+
+fn checked_sub_wide_v1(left: U512, right: U512) -> Result<U512, &'static str> {
+	left.checked_sub(right)
+		.ok_or("Ergo relay UInt512 subtraction underflows")
+}
+
+fn checked_mul_wide_v1(left: U512, right: U512) -> Result<U512, &'static str> {
+	left.checked_mul(right)
+		.ok_or("Ergo relay UInt512 multiplication overflows")
+}
+
+fn narrow_u512_v1(value: U512) -> Result<U256, &'static str> {
+	U256::try_from(value).map_err(|_| "Ergo relay value exceeds UInt256")
+}
+
+#[derive(Clone, Copy)]
+struct SignedWideV1 {
+	negative: bool,
+	magnitude: U512,
+}
+
+impl SignedWideV1 {
+	fn positive(magnitude: U512) -> Self {
+		Self {
+			negative: false,
+			magnitude,
+		}
+	}
+
+	fn normalized(negative: bool, magnitude: U512) -> Self {
+		Self {
+			negative: negative && !magnitude.is_zero(),
+			magnitude,
+		}
+	}
+
+	fn add(self, other: Self) -> Result<Self, &'static str> {
+		if self.negative == other.negative {
+			return Ok(Self::normalized(
+				self.negative,
+				checked_add_wide_v1(self.magnitude, other.magnitude)?,
+			));
+		}
+		match self.magnitude.cmp(&other.magnitude) {
+			Ordering::Greater => Ok(Self::normalized(
+				self.negative,
+				checked_sub_wide_v1(self.magnitude, other.magnitude)?,
+			)),
+			Ordering::Less => Ok(Self::normalized(
+				other.negative,
+				checked_sub_wide_v1(other.magnitude, self.magnitude)?,
+			)),
+			Ordering::Equal => Ok(Self::positive(U512::zero())),
+		}
+	}
+
+	fn sub(self, other: Self) -> Result<Self, &'static str> {
+		self.add(Self::normalized(!other.negative, other.magnitude))
+	}
+
+	fn mul_unsigned(self, value: U512) -> Result<Self, &'static str> {
+		Ok(Self::normalized(
+			self.negative,
+			checked_mul_wide_v1(self.magnitude, value)?,
+		))
+	}
+
+	fn div_unsigned(self, value: U512) -> Result<Self, &'static str> {
+		if value.is_zero() {
+			return Err("Ergo relay signed wide division by zero");
+		}
+		Ok(Self::normalized(self.negative, self.magnitude / value))
+	}
+}

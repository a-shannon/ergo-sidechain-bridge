+use std::{
+	io::Write,
+	process::{Command, Output, Stdio},
+};
+
+use bridge_checkpoint_verifier::{
+	fixture::deterministic_fixture_request,
+	rpc_codec::{
+		RpcFinalityInspectionRequest, RpcFinalityInspectionResult, RpcWarpInspectionRequest,
+		RpcWarpInspectionResult, FINALITY_INSPECTION_REQUEST_SCHEMA,
+		FINALITY_INSPECTION_RESULT_SCHEMA, WARP_INSPECTION_REQUEST_SCHEMA,
+		WARP_INSPECTION_RESULT_SCHEMA,
+	},
+};
+
+#[test]
+fn exposes_bounded_structural_codec_modes_without_verification_claims() {
+	let fixture = deterministic_fixture_request();
+	let warp_request = serde_json::to_vec(&RpcWarpInspectionRequest {
+		schema: WARP_INSPECTION_REQUEST_SCHEMA.to_owned(),
+		proof_scale_hex: fixture.linked_grandpa_proofs[0].proof_scale_hex.clone(),
+		finality_horizon_number: "1026".to_owned(),
+	})
+	.unwrap();
+	let warp = run_codec("--inspect-warp-proof", &warp_request);
+	assert!(warp.status.success());
+	assert!(warp.stderr.is_empty());
+	let warp: RpcWarpInspectionResult = serde_json::from_slice(&warp.stdout).unwrap();
+	assert_eq!(warp.schema, WARP_INSPECTION_RESULT_SCHEMA);
+	assert!(!warp.source_complete);
+	assert_eq!(warp.selected_fragment_count, 1);
+	assert_eq!(
+		warp.selected_proof_scale_hex.as_deref(),
+		Some(fixture.linked_grandpa_proofs[0].proof_scale_hex.as_str())
+	);
+	assert!(!warp.cryptographically_verified);
+
+	let finality_request = serde_json::to_vec(&RpcFinalityInspectionRequest {
+		schema: FINALITY_INSPECTION_REQUEST_SCHEMA.to_owned(),
+		proof_scale_hex: fixture.finality_proof_scale_hex,
+	})
+	.unwrap();
+	let finality = run_codec("--inspect-finality-proof", &finality_request);
+	assert!(finality.status.success());
+	assert!(finality.stderr.is_empty());
+	let finality: RpcFinalityInspectionResult = serde_json::from_slice(&finality.stdout).unwrap();
+	assert_eq!(finality.schema, FINALITY_INSPECTION_RESULT_SCHEMA);
+	assert_ne!(finality.horizon_hash_hex, warp.source_target_hash_hex);
+	assert!(!finality.cryptographically_verified);
+
+	let unknown_mode = run_codec("--unknown", b"{}");
+	assert!(!unknown_mode.status.success());
+	assert!(unknown_mode.stdout.is_empty());
+}
+
+fn run_codec(mode: &str, request: &[u8]) -> Output {
+	let mut child = Command::new(env!("CARGO_BIN_EXE_bridge-rpc-proof-codec"))
+		.arg(mode)
+		.stdin(Stdio::piped())
+		.stdout(Stdio::piped())
+		.stderr(Stdio::piped())
+		.spawn()
+		.unwrap();
+	child.stdin.as_mut().unwrap().write_all(request).unwrap();
+	child.wait_with_output().unwrap()
+}

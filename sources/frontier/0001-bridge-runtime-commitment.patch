+			let pending_keys: BoundedVec<H256, T::MaxPegInsPerBlock> = pending_keys
+				.try_into()
+				.map_err(|_| Error::<T>::CausalPegInAdmissionIndexFull)?;
+			let pending = PendingCausalPegInAdmissionV2 {
+				profile_id: runtime_profile.profile_id,
+				source_intent_bytes,
+				statement_bytes,
+				admission_id: validated.admission_id,
+				admitted_at_native_height: current_height,
+				proof_system_id: validated.profile.proof_system_id,
+				proof_profile_id: validated.profile.proof_profile_id,
+			};
+			let receipt = CausalPegInAdmissionReceiptV1 {
+				format_version: 1,
+				profile_id: runtime_profile.profile_id,
+				admission_id: validated.admission_id,
+				source_proof_request_digest: verified_source_proof.request_digest,
+				source_proof_result_id: verified_source_proof.result_id,
+				source_proof_digest: verified_source_proof.proof_digest,
+				verifier_executable_sha256: verified_source_proof.verifier_executable_sha256,
+				verifier_profile_id: verified_source_proof.verifier_profile_id,
+				admitted_at_native_height: current_height,
+				expires_at_native_height: verified_source_proof.expires_at_native_height,

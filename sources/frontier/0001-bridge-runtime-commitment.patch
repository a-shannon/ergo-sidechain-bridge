+		.runtime_api()
+		.account_code_at(parent.best_hash, token_address)
+		.expect("token runtime code query succeeds");
+	let causal_profile = causal_runtime_profile(
+		sidechain_id,
+		bridge_address,
+		token_address,
+		4,
+		&bridge_runtime_code,
+		&token_runtime_code,
+	);
+	let nonce = client
+		.runtime_api()
+		.account_basic(parent.best_hash, owner)
+		.expect("owner account query succeeds")
+		.nonce
+		.low_u32();
+	let activate_v1 = RuntimeCall::Sudo(pallet_sudo::Call::sudo {
+		call: Box::new(RuntimeCall::BridgeCommitment(
+			BridgeCommitmentCall::set_bridge_address {
+				address: Some(bridge_address),
+			},
+		)),
+	});
+	let inject_fixture_profile = RuntimeCall::Sudo(pallet_sudo::Call::sudo {
+		call: Box::new(RuntimeCall::System(SystemCall::set_storage {
+			items: vec![
+				(
+					CurrentCausalPegInProfileV2::<Runtime>::hashed_key().to_vec(),
+					causal_profile.encode(),
+				),
+				(
+					CausalPegInEnforcementActivatedV2::<Runtime>::hashed_key().to_vec(),
+					true.encode(),
+				),
+			],
+		})),
+	});
+	let expire_fixture_admission =
+		RuntimeCall::BridgeCommitment(BridgeCommitmentCall::expire_causal_peg_in {
+			record_key: H256::repeat_byte(0x91),
+		});
+	let raw_injection_extrinsics = vec![
+		timestamp_extrinsic(24_000),
+		signed_sudo_extrinsic(&client, &signer, nonce, activate_v1),
+		signed_sudo_extrinsic(&client, &signer, nonce + 1, inject_fixture_profile),
+		signed_sudo_extrinsic(&client, &signer, nonce + 2, expire_fixture_admission),
+	];
+	let overlay_header = Header::new(
+		parent.best_number + 1,
+		Default::default(),
+		Default::default(),
+		parent.best_hash,
+		Digest::default(),
+	);
+	let mut overlay_api = client.runtime_api();
+	overlay_api.set_call_context(CallContext::Onchain);
+	overlay_api
+		.initialize_block(parent.best_hash, &overlay_header)
+		.expect("raw-injection overlay initializes from the accepted parent");
+	for extrinsic in raw_injection_extrinsics.iter().take(3).cloned() {
+		overlay_api
+			.apply_extrinsic(parent.best_hash, extrinsic)
+			.expect("raw-injection overlay extrinsic executes")
+			.expect("raw-injection overlay extrinsic is valid")
+			.expect("raw-injection setup dispatch succeeds");
+	}
+	let expiry_dispatch = overlay_api
+		.apply_extrinsic(parent.best_hash, raw_injection_extrinsics[3].clone())
+		.expect("fixture-expiry overlay extrinsic executes")
+		.expect("fixture-expiry overlay extrinsic is valid");
+	assert_eq!(
+		expiry_dispatch,
+		Err(
+			BridgeCommitmentError::<Runtime>::CausalPegInSourceProofProfileActivationBlocked.into()
+		),
+	);
+	drop(overlay_api);
+
+	let mut raw_injection_builder = BlockBuilderBuilder::new(client.as_ref())
+		.on_parent_block(parent.best_hash)
+		.with_parent_block_number(parent.best_number)
+		.build()
+		.expect("raw-injection candidate starts from the accepted parent");
+	for extrinsic in raw_injection_extrinsics {
+		raw_injection_builder
+			.push(extrinsic)
+			.expect("raw-injection candidate extrinsic executes before finalization");
+	}
+	let rejection = match raw_injection_builder.build() {
+		Ok(_) => panic!("raw storage must not make the fixture source profile executable"),
+		Err(error) => error.to_string(),
+	};
+	assert!(
+		rejection.contains("Execution aborted") || rejection.contains("wasm trap"),
+		"unexpected raw-profile rejection: {rejection}",
+	);
+	assert_eq!(client.usage_info().chain.best_hash, parent.best_hash);
+	assert!(storage_at(
+		&client,
+		parent.best_hash,
+		&StorageKey(CurrentCausalPegInProfileV2::<Runtime>::hashed_key().to_vec()),
+	)
+	.is_none());
+	assert!(storage_at(
+		&client,
+		parent.best_hash,
+		&StorageKey(CausalPegInEnforcementActivatedV2::<Runtime>::hashed_key().to_vec()),
+	)
+	.is_none());
+}

+#[cfg(test)]
+mod tests {
+	use core::str::FromStr;
+
+	use scale_codec::Encode;
+	use sp_core::{blake2_128, twox_128, H256};
+
+	use super::{bridge_commitment, Runtime, WeightPerGas};
+	#[test]
+	fn configured_base_extrinsic_weight_is_evm_compatible() {
+		let min_ethereum_transaction_weight = WeightPerGas::get() * 21_000;
+		let base_extrinsic = <Runtime as frame_system::Config>::BlockWeights::get()
+			.get(frame_support::dispatch::DispatchClass::Normal)
+			.base_extrinsic;
+		assert!(base_extrinsic.ref_time() <= min_ethereum_transaction_weight.ref_time());
+	}
+
+	#[test]
+	fn bridge_commitment_storage_wire_format_is_stable() {
+		assert_eq!(
+			bridge_commitment::CurrentPegInProfile::<Runtime>::hashed_key(),
+			[
+				0xaf, 0x86, 0xfe, 0xf4, 0x21, 0x6a, 0xc2, 0xbc, 0xd1, 0xc5, 0x92, 0xb2, 0x04, 0x01,
+				0x1a, 0xd0, 0xd4, 0xe9, 0xff, 0xac, 0x40, 0x24, 0x6e, 0x76, 0xbb, 0x00, 0xb9, 0x03,
+				0x13, 0x73, 0xd2, 0xc3,
+			],
+		);
+		let peg_in_map_prefix =
+			[twox_128(b"BridgeCommitment"), twox_128(b"ProcessedPegIns")].concat();
+		assert_eq!(
+			peg_in_map_prefix,
+			[
+				0xaf, 0x86, 0xfe, 0xf4, 0x21, 0x6a, 0xc2, 0xbc, 0xd1, 0xc5, 0x92, 0xb2, 0x04, 0x01,
+				0x1a, 0xd0, 0xe6, 0x83, 0xc5, 0x28, 0xc6, 0xfc, 0x80, 0x06, 0x64, 0x5f, 0xa5, 0x98,
+				0x91, 0x73, 0xf2, 0xe0,
+			],
+		);
+		let record_key =
+			H256::from_str("25415f2ff5a859bd5e6464c2dff89261d20106ed1024e5846b2997029fca937c")
+				.expect("valid peg-in runtime record key");
+		let mut expected_record_storage_key = peg_in_map_prefix;
+		expected_record_storage_key.extend_from_slice(&blake2_128(record_key.as_bytes()));
+		expected_record_storage_key.extend_from_slice(record_key.as_bytes());
+		assert_eq!(
+			bridge_commitment::ProcessedPegIns::<Runtime>::hashed_key_for(record_key),
+			expected_record_storage_key,
+		);
+		assert_eq!(
+			bridge_commitment::CurrentCommitment::<Runtime>::hashed_key(),
+			[
+				0xaf, 0x86, 0xfe, 0xf4, 0x21, 0x6a, 0xc2, 0xbc, 0xd1, 0xc5, 0x92, 0xb2, 0x04, 0x01,
+				0x1a, 0xd0, 0x0d, 0x2d, 0x4f, 0xb8, 0x25, 0xaf, 0x1f, 0xcd, 0x4c, 0x2b, 0xe9, 0xf9,
+				0x55, 0xa7, 0x80, 0xc5,
+			],
+		);
+		let encoded = bridge_commitment::BridgeEventCommitment {
+			format_version: 1,
+			sidechain_id: H256::repeat_byte(0x11),
+			sidechain_height: 1_024,
+			execution_block_hash: H256::repeat_byte(0x22),
+			bridge_event_root: H256::repeat_byte(0x33),
+			burn_leaf_count: 3,
+		}
+		.encode();
+		assert_eq!(encoded.len(), 109);
+	}
+}

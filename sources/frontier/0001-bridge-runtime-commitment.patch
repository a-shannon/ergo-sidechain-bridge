+						padded_address_word(H160::repeat_byte(0x33))
+							.as_bytes()
+							.to_vec(),
+					)
+				}
+				"token-owner-padding" => {
+					values.token_owner = Some(
+						padded_address_word(H160::repeat_byte(0x22))
+							.as_bytes()
+							.to_vec(),
+					)
+				}
+				"token-owner" => {
+					values.token_owner =
+						Some(address_word(H160::repeat_byte(0x23)).as_bytes().to_vec())
+				}
+				"replay" => values.replay = Some(H256::zero().as_bytes().to_vec()),
+				"malformed" => values.total_supply = Some(vec![0; 31]),

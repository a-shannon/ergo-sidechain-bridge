+fn assert_ergo_autolykos_committed_vault_runtime_statement_matches_v2(
+	statement_bytes: &[u8],
+	relay_witness_bytes: &[u8],
+	transaction_witness_bytes: &[u8],
+) -> Result<ParsedErgoAutolykosCommittedVaultRuntimeStatementV2, &'static str> {
+	let parsed = parse_ergo_autolykos_committed_vault_runtime_statement_v2(statement_bytes)?;
+	let expected = compose_ergo_autolykos_committed_vault_runtime_statement_v2(
+		relay_witness_bytes,
+		transaction_witness_bytes,
+	)?;
+	if expected != statement_bytes {
+		return Err("runtime-derived statement V2 does not match the exact runtime witnesses");
+	}
+	Ok(parsed)
+}

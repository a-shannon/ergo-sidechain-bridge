+//! Strict offline verification for finalized Peg-In Runtime Identity V2.
+//!
+//! This request and result family is separate from both the burn-only checkpoint and Peg-In Runtime
+//! State V1 contracts. It authenticates exact raw `:code` bytes together with one historical
+//! processed-deposit membership, or one active profile plus current non-membership, under one state
+//! root. It performs no RPC, build-attestation verification, signing, transaction construction, or
+//! mint authorization.
+
+use bridge_finality_proof::{
+	MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS, MAX_AUTHORITY_TRANSITION_PROOF_BYTES,

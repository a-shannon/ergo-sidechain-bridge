+use std::{
+	io::Write,
+	process::{Command, Output, Stdio},
+};
+
+use bridge_checkpoint_verifier::{
+	peg_in_frontier_execution_identity_v1::NativeFrontierExecutionIdentityVerification,
+	peg_in_frontier_execution_identity_v1_fixture::{
+		deterministic_fixture_request, deterministic_trusted_anchor_digest_hex,
+	},
+	peg_in_runtime_identity_v2_fixture::deterministic_membership_fixture_request,
+};
+
+#[test]
+fn verifies_v1_and_rejects_the_runtime_identity_v2_family() {
+	let request = serde_json::to_vec(&deterministic_fixture_request()).unwrap();
+	let trusted_digest = deterministic_trusted_anchor_digest_hex();
+
+	let accepted = run_verifier(&["--trusted-anchor-digest", &trusted_digest], &request);
+	assert!(accepted.status.success());
+	assert!(accepted.stderr.is_empty());
+	let verified: NativeFrontierExecutionIdentityVerification =
+		serde_json::from_slice(&accepted.stdout).unwrap();
+	assert!(
+		verified
+			.boundary
+			.execution_block_hash_mapped_to_native_state
+	);
+	assert!(verified.boundary.record_transaction_bound_exactly_once);
+	assert!(!verified.boundary.receipt_inclusion_verified);
+	assert!(!verified.boundary.mint_authorized);
+
+	let v2_request = serde_json::to_vec(&deterministic_membership_fixture_request()).unwrap();
+	let v2_through_execution_identity =
+		run_verifier(&["--trusted-anchor-digest", &trusted_digest], &v2_request);
+	assert!(!v2_through_execution_identity.status.success());
+	assert!(v2_through_execution_identity.stdout.is_empty());
+}
+
+fn run_verifier(arguments: &[&str], request: &[u8]) -> Output {

+	fn peg_in_proof_for(
+		profile: &peg_in::PegInRuntimeProfileV1,
+		record: Option<&peg_in::PegInRuntimeRecordV1>,
+		ergo_box_id: H256,
+	) -> (H256, Vec<Vec<u8>>) {
+		let record_key =
+			peg_in::derive_processed_peg_in_storage_key_v1(profile.sidechain_id, ergo_box_id);
+		let mut state = BTreeMap::new();
+		state.insert(
+			peg_in::CURRENT_PEG_IN_PROFILE_STORAGE_KEY.to_vec(),
+			profile.encode(),
+		);
+		if let Some(record) = record {
+			state.insert(record_key.to_vec(), record.encode());
+		}
+		let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+		let root = *backend.root();
+		let proof = prove_read(backend, [record_key.as_slice()]).unwrap();
+		(root, proof.into_iter_nodes().collect())
+	}
+
+	fn authority_fixture() -> (Vec<ed25519::Pair>, AuthorityList) {
+		let pairs = (1u8..=3)
+			.map(|seed| ed25519::Pair::from_seed(&[seed; 32]))
+			.collect::<Vec<_>>();
+		let authorities = pairs
+			.iter()
+			.map(|pair| (pair.public().into(), 1u64))
+			.collect();
+		(pairs, authorities)
+	}
+
+	fn finality_proof_for_set(
+		header: &TestHeader,
+		pairs: &[ed25519::Pair],
+		set_id: SetId,
+	) -> Vec<u8> {
+		let precommit = Precommit {
+			target_hash: header.hash(),
+			target_number: *header.number(),
+		};
+		let message = sp_consensus_grandpa::Message::<TestHeader>::Precommit(precommit.clone());
+		let payload = sp_consensus_grandpa::localized_payload(ROUND, set_id, &message);
+		let precommits = pairs
+			.iter()
+			.map(|pair| SignedPrecommit {
+				precommit: precommit.clone(),
+				signature: pair.sign(&payload).into(),
+				id: pair.public().into(),
+			})
+			.collect();
+		let justification: GrandpaJustification<TestBlock> =
+			sp_consensus_grandpa::GrandpaJustification::<TestHeader> {
+				round: ROUND,
+				commit: Commit {
+					target_hash: header.hash(),
+					target_number: *header.number(),
+					precommits,
+				},
+				votes_ancestries: Vec::new(),
+			}
+			.into();
+		let proof: FinalityProof<TestHeader> = FinalityProof {
+			block: header.hash(),
+			justification: justification.encode(),
+			unknown_headers: Vec::new(),
+		};
+		proof.encode()
+	}
+
+	fn finality_proof(header: &TestHeader, pairs: &[ed25519::Pair]) -> Vec<u8> {
+		finality_proof_for_set(header, pairs, SET_ID)
+	}
+
+	fn descendant_finality_proof_for_set(
+		requested: &TestHeader,
+		target: &TestHeader,
+		unknown_headers: Vec<TestHeader>,
+		pairs: &[ed25519::Pair],
+		set_id: SetId,
+	) -> Vec<u8> {
+		let precommit = Precommit {
+			target_hash: target.hash(),
+			target_number: *target.number(),
+		};
+		let message = sp_consensus_grandpa::Message::<TestHeader>::Precommit(precommit.clone());
+		let payload = sp_consensus_grandpa::localized_payload(ROUND, set_id, &message);
+		let precommits = pairs
+			.iter()
+			.map(|pair| SignedPrecommit {
+				precommit: precommit.clone(),
+				signature: pair.sign(&payload).into(),
+				id: pair.public().into(),
+			})
+			.collect();
+		let justification: GrandpaJustification<TestBlock> =
+			sp_consensus_grandpa::GrandpaJustification::<TestHeader> {
+				round: ROUND,
+				commit: Commit {
+					target_hash: target.hash(),
+					target_number: *target.number(),
+					precommits,
+				},
+				votes_ancestries: Vec::new(),
+			}
+			.into();
+		let proof: FinalityProof<TestHeader> = FinalityProof {
+			block: target.hash(),
+			justification: justification.encode(),
+			unknown_headers,
+		};
+		assert!(target.number() > requested.number());
+		proof.encode()
+	}
+
+	fn descendant_finality_proof(
+		requested: &TestHeader,
+		target: &TestHeader,
+		unknown_headers: Vec<TestHeader>,
+		pairs: &[ed25519::Pair],
+	) -> Vec<u8> {
+		descendant_finality_proof_for_set(requested, target, unknown_headers, pairs, SET_ID)
+	}
+
+	fn scheduled_change_header(
+		number: u32,
+		state_root: H256,
+		parent_hash: H256,
+		next_authorities: AuthorityList,
+		delay: u32,
+	) -> TestHeader {
+		let change = sp_consensus_grandpa::ConsensusLog::ScheduledChange(
+			sp_consensus_grandpa::ScheduledChange {
+				delay,
+				next_authorities,
+			},
+		);
+		TestHeader::new(
+			number,
+			H256::repeat_byte((number & 0xff) as u8),
+			state_root,
+			parent_hash,
+			Digest {
+				logs: vec![DigestItem::Consensus(
+					sp_consensus_grandpa::GRANDPA_ENGINE_ID,
+					change.encode(),
+				)],
+			},
+		)
+	}

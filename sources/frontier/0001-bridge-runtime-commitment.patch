+	#[test]
+	fn federated_pooled_reserve_profile_and_proof_are_domain_separated_and_fail_closed() {
+		type Verifier = FederatedPooledReserveMintReservationSourceProofV1<
+			ReferenceFederatedPooledReserveSourceProofProfileV1,
+		>;
+
+		let activation_height = 2_000u64;
+		let profile = fixture_runtime_profile_v4(activation_height);
+		let statement_bytes = fixture_statement_bytes_v4();
+		let validated =
+			validate_pooled_reserve_mint_reservation_statement_v4(&statement_bytes).unwrap();
+		let proof = fixture_source_proof_v4(
+			&profile,
+			&statement_bytes,
+			activation_height,
+			activation_height + 32,
+		);
+		let verified = Verifier::verify(
+			&profile,
+			&validated,
+			&statement_bytes,
+			activation_height,
+			&proof,
+		)
+		.unwrap();
+		assert_eq!(verified.proof_system_id, Verifier::proof_system_id());
+		assert_eq!(verified.proof_profile_id, Verifier::proof_profile_id());
+		assert_ne!(Verifier::proof_system_id(), rejected_fixture_source_proof_system_id_v4());
+		assert_ne!(Verifier::proof_profile_id(), rejected_fixture_source_proof_profile_id_v4());
+
+		let decoded = FederatedPooledReserveSourceProofEnvelopeV1::decode_all(
+			&mut &proof.proof_bytes[..],
+		)
+		.unwrap();
+		let result_id =
+			derive_federated_pooled_reserve_source_proof_result_id_v1(&decoded.result).unwrap();
+		let attestation_digest =
+			derive_federated_pooled_reserve_source_proof_attestation_digest_v1(result_id);
+		let outsider = ed25519::Pair::from_seed(&[0x77; 32]);
+		let mut faults = Vec::new();
+
+		let mut insufficient = decoded.clone();
+		insufficient.signatures.pop();
+		faults.push(insufficient);
+
+		let mut duplicate = decoded.clone();
+		duplicate.signatures[1] = duplicate.signatures[0].clone();
+		faults.push(duplicate);
+
+		let mut unordered = decoded.clone();
+		let first_signature = unordered.signatures[0].clone();
+		unordered.signatures[0] = unordered.signatures[1].clone();
+		unordered.signatures[1] = first_signature;
+		faults.push(unordered);
+
+		let mut unknown = decoded.clone();
+		unknown.signatures[1] = FederatedSourceProofSignatureV1 {
+			signer_public_key: outsider.public().0,
+			signature: outsider.sign(attestation_digest.as_bytes()).0,
+		};
+		faults.push(unknown);
+
+		let mut wrong_epoch = decoded.clone();
+		wrong_epoch.result.federation_epoch += 1;
+		faults.push(wrong_epoch);
+
+		let mut wrong_key_set = decoded;
+		wrong_key_set.result.source_attestation_key_set_digest = H256::repeat_byte(0x91);
+		faults.push(wrong_key_set);
+
+		for inner in faults {
+			let mut changed = proof.clone();
+			changed.proof_bytes = inner.encode().try_into().unwrap();
+			assert!(Verifier::verify(
+				&profile,
+				&validated,
+				&statement_bytes,
+				activation_height,
+				&changed,
+			)
+			.is_err());
+		}
+
+		let mut trailing = proof.clone();
+		let mut trailing_bytes = trailing.proof_bytes.to_vec();
+		trailing_bytes.push(0);
+		trailing.proof_bytes = trailing_bytes.try_into().unwrap();
+		assert!(Verifier::verify(
+			&profile,
+			&validated,
+			&statement_bytes,
+			activation_height,
+			&trailing,
+		)
+		.is_err());
+		assert!(Verifier::verify(
+			&profile,
+			&validated,
+			&statement_bytes,
+			activation_height + 32,
+			&proof,
+		)
+		.is_err());
+	}

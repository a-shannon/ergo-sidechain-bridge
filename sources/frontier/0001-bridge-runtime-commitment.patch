+fn abi_call(signature: &[u8], words: &[H256]) -> Vec<u8> {
+	let mut input = Vec::with_capacity(4 + words.len() * 32);
+	input.extend_from_slice(&keccak_256(signature)[..4]);
+	for word in words {
+		input.extend_from_slice(word.as_bytes());
+	}
+	input
+}

+const LEGACY_MINT_QUARANTINE_INVALID_TRANSACTION_CODE: u8 = 181;
+const LEGACY_MINT_QUARANTINE_MAX_STORAGE_READS: u64 = 8;
+// FRAME's MaxEncodedLen proof estimator charges 495 bytes of trie overhead for
+// a fixed StorageValue key, in addition to its maximum encoded value. The pool
+// path reads two H160 values, two V1 profiles, both stronger profile slots, and
+// two sticky booleans before it can reject an invalid coexistence state.
+const LEGACY_MINT_QUARANTINE_STORAGE_VALUE_PROOF_OVERHEAD_BYTES: u64 = 495;
+const LEGACY_MINT_QUARANTINE_H160_MAX_ENCODED_BYTES: u64 = 20;
+const LEGACY_MINT_QUARANTINE_V1_PROFILE_MAX_ENCODED_BYTES: u64 = 69;
+const LEGACY_MINT_QUARANTINE_CAUSAL_PROFILE_MAX_ENCODED_BYTES: u64 = 419;
+const LEGACY_MINT_QUARANTINE_POOLED_PROFILE_MAX_ENCODED_BYTES: u64 = 349;
+const LEGACY_MINT_QUARANTINE_BOOL_MAX_ENCODED_BYTES: u64 = 1;
+const LEGACY_MINT_QUARANTINE_MAX_PROOF_BYTES: u64 = LEGACY_MINT_QUARANTINE_MAX_STORAGE_READS
+	* LEGACY_MINT_QUARANTINE_STORAGE_VALUE_PROOF_OVERHEAD_BYTES
+	+ 2 * LEGACY_MINT_QUARANTINE_H160_MAX_ENCODED_BYTES
+	+ 2 * LEGACY_MINT_QUARANTINE_V1_PROFILE_MAX_ENCODED_BYTES
+	+ LEGACY_MINT_QUARANTINE_CAUSAL_PROFILE_MAX_ENCODED_BYTES
+	+ LEGACY_MINT_QUARANTINE_POOLED_PROFILE_MAX_ENCODED_BYTES
+	+ 2 * LEGACY_MINT_QUARANTINE_BOOL_MAX_ENCODED_BYTES;
+
+pub struct BridgeEthereumTransactionFilter;
+
+impl pallet_ethereum::EthereumTransactionFilter for BridgeEthereumTransactionFilter {
+	fn weight(transaction: &EthereumTransaction) -> Weight {
+		if !bridge_commitment::direct_legacy_mint_transaction_requires_policy(transaction) {
+			return Weight::zero();
+		}
+		<Runtime as frame_system::Config>::DbWeight::get()
+			.reads(LEGACY_MINT_QUARANTINE_MAX_STORAGE_READS)
+			.saturating_add(Weight::from_parts(
+				0,
+				LEGACY_MINT_QUARANTINE_MAX_PROOF_BYTES,
+			))
+	}
+
+	fn validate(
+		transaction: &EthereumTransaction,
+		context: pallet_ethereum::TransactionValidationContext,
+	) -> Result<(), TransactionValidityError> {
+		let use_parent_profile_snapshot = matches!(
+			context,
+			pallet_ethereum::TransactionValidationContext::InBlock
+		);
+		bridge_commitment::ensure_direct_legacy_mint_transaction_allowed::<Runtime>(
+			transaction,
+			use_parent_profile_snapshot,
+		)
+		.map_err(|_| {
+			InvalidTransaction::Custom(LEGACY_MINT_QUARANTINE_INVALID_TRANSACTION_CODE).into()
+		})
+	}
+}

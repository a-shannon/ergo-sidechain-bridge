+fn pooled_reserve_statement_v4(
+	sidechain_id: H256,
+	bridge_address: H160,
+	token_address: H160,
+	recipient: H160,
+	amount: u64,
+) -> PooledReserveMintReservationStatementBytesV4 {
+	const SOURCE_INTENT_DOMAIN_V2: &[u8] = b"E2S_PEG_IN_SOURCE_INTENT_V2";
+
+	let mut statement =
+		hex::decode(include_str!("tests/res/bridge-atomicity/PooledReserveStatementV4.hex").trim())
+			.expect("pinned pooled-reserve V4 statement seed");
+	statement[66..98].copy_from_slice(sidechain_id.as_bytes());
+	statement[98..118].copy_from_slice(bridge_address.as_bytes());
+	statement[118..138].copy_from_slice(token_address.as_bytes());
+	statement[234..242].copy_from_slice(&amount.to_be_bytes());
+	statement[242..262].copy_from_slice(recipient.as_bytes());
+
+	let source_intent_id = causal_domain_hash(SOURCE_INTENT_DOMAIN_V2, &statement[33..262]);
+	statement[262..294].copy_from_slice(source_intent_id.as_bytes());
+	let lineage_profile_id = H256::from_slice(&statement[1..33]);
+	let source_lock_box_id = H256::from_slice(&statement[326..358]);
+	let deposit_commitment = H256::from_slice(&statement[390..422]);
+	let mint_identity = derive_pooled_reserve_mint_identity_v4(
+		lineage_profile_id,
+		source_lock_box_id,
+		deposit_commitment,
+	);
+	statement[294..326].copy_from_slice(mint_identity.as_bytes());
+
+	let statement: PooledReserveMintReservationStatementBytesV4 = statement
+		.try_into()
+		.expect("bridge-atomicity V4 statement retains its exact bound");
+	let validated = validate_pooled_reserve_mint_reservation_statement_v4(&statement)
+		.expect("bridge-atomicity V4 statement is canonical");
+	assert_eq!(validated.statement.mint_identity, mint_identity);
+	assert_eq!(validated.statement.source_intent.sidechain_id, sidechain_id);
+	assert_eq!(
+		validated.statement.source_intent.bridge_address,
+		bridge_address
+	);
+	assert_eq!(
+		validated.statement.source_intent.token_address,
+		token_address
+	);
+	assert_eq!(validated.statement.source_intent.recipient, recipient);
+	assert_eq!(validated.statement.source_intent.amount, amount);
+	statement
+}

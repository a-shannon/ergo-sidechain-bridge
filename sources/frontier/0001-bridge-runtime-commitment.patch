+			mint_recipient_address_hex: format_bytes(transition.mint.recipient.as_bytes()),
+			mint_amount: transition.mint.amount.to_string(),
+			parent_proof_node_count: transition.parent.proof_node_count,
+			parent_proof_bytes: transition.parent.proof_bytes,
+			post_proof_node_count: transition.post_proof_node_count,
+			post_proof_bytes: transition.post_proof_bytes,
+			verified: true,
+		},

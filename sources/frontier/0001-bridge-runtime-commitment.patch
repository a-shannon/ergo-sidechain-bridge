+	fn replace_target_log(fixture: &mut Fixture, log: Log) {
+		let data = receipt_data_mut(&mut fixture.receipts[1]);
+		data.logs = vec![log];
+		data.logs_bloom = logs_bloom(&data.logs);
+		fixture.statuses[1].logs = data.logs.clone();
+		fixture.statuses[1].logs_bloom = data.logs_bloom;
+		rebind_block(fixture);
+	}
+
+	fn build_execution_and_event_proof(
+		fixture: &Fixture,
+		receipts_value: Option<Vec<u8>>,
+		statuses_value: Option<Vec<u8>>,
+	) -> (VerifiedFrontierExecutionIdentityV1, Vec<Vec<u8>>) {
+		let current_block_key = derive_ethereum_current_block_storage_key();
+		let receipts_key = derive_ethereum_current_receipts_storage_key();
+		let statuses_key = derive_ethereum_current_transaction_statuses_storage_key();
+		let record_key = derive_processed_peg_in_storage_key_v1(SIDECHAIN_ID, ERGO_BOX_ID);
+		let mut state = BTreeMap::new();
+		state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), RUNTIME_CODE.to_vec());
+		state.insert(current_block_key.to_vec(), fixture.block.encode());
+		if let Some(value) = receipts_value {
+			state.insert(receipts_key.to_vec(), value);
+		}
+		if let Some(value) = statuses_value {
+			state.insert(statuses_key.to_vec(), value);
+		}
+		state.insert(record_key.to_vec(), fixture.record.encode());
+		let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+		let state_root = *backend.root();
+		let proof = prove_read(
+			backend,
+			[
+				RUNTIME_CODE_STORAGE_KEY.as_slice(),
+				current_block_key.as_slice(),
+				receipts_key.as_slice(),
+				statuses_key.as_slice(),
+				record_key.as_slice(),
+			],
+		)
+		.expect("deterministic state must produce the exact five-key proof");
+		let proof_nodes = proof.into_iter_nodes().collect::<Vec<_>>();
+		let execution = verify_frontier_execution_identity_v1(
+			state_root,
+			NATIVE_HEIGHT,
+			SIDECHAIN_ID,
+			ERGO_BOX_ID,
+			RuntimeCodeExpectationV2 {
+				artifact_sha256: sha2_256(RUNTIME_CODE),
+				artifact_size_bytes: RUNTIME_CODE.len(),
+			},
+			&fixture.record,
+			&proof_nodes,
+		)
+		.expect("receipt/status fixtures must preserve the prerequisite execution identity");
+		(execution, proof_nodes)
+	}
+
+	fn verify_fixture_with_values(
+		fixture: &Fixture,
+		receipts_value: Option<Vec<u8>>,
+		statuses_value: Option<Vec<u8>>,
+	) -> Result<VerifiedFrontierPegInEventV1, FrontierPegInEventProofError> {
+		let (execution, proof_nodes) =
+			build_execution_and_event_proof(fixture, receipts_value, statuses_value);
+		verify_frontier_peg_in_event_v1(&execution, &proof_nodes)
+	}

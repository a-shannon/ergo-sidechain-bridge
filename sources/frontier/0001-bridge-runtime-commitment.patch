index 0000000000000000000000000000000000000000..6c5ec45b50c5253424f918a5b4dad3ea543246a0
--- /dev/null
+++ b/bridge/state-proof/src/lib.rs
@@ -0,0 +1,2471 @@
+//! Finalized runtime-state verification for the bridge commitment produced by Frontier.
+//!
+//! The verifier composes two independent statements: the requested native header is finalized
+//! under an explicitly supplied GRANDPA authority set, and the exact bridge commitment exists in
+//! that header's state trie. Authority-root authentication, Ergo anchoring, and Gate 5 acceptance
+//! remain separate responsibilities.
+
+#![warn(missing_docs)]
+
+/// Separate finalized-state profile for Peg-In Runtime State V1.
+pub mod peg_in;
+/// Parent/child causal admission consumption proof profile.
+pub mod peg_in_causal_mint_transition_v2;
+/// Receipt-authenticated parent/child causal admission consumption proof profile.
+pub mod peg_in_causal_mint_transition_v3;
+/// Separate finalized-state profile for deciding Frontier peg-in contract code and storage.
+pub mod peg_in_frontier_contract_state_v1;
+/// Separate finalized-state profile for one successful Frontier `PegIn` event.
+pub mod peg_in_frontier_event_v1;
+/// Separate finalized-state profile for the native-to-Frontier block identity.
+pub mod peg_in_frontier_execution_identity_v1;
+/// Direct-parent to event-block Frontier peg-in mint-transition proof profile.
+pub mod peg_in_frontier_mint_transition_v1;
+pub mod peg_in_runtime_identity_v2;
+/// Authenticated V4 pooled-reserve mint-reservation state under one native state root.
+pub mod pooled_reserve_mint_reservation_state_v4;
+
+use bridge_finality_proof::{
+	verify_grandpa_finality_proof, verify_linked_grandpa_authority_transition_proof,
+	BridgeAuthorityTransitionError, BridgeFinalityProofError, VerifiedGrandpaFinalityProof,
+	MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+};
+use sc_consensus_grandpa::{find_forced_change, find_scheduled_change};
+use scale_codec::{Decode, DecodeAll, Encode};
+use sp_consensus_grandpa::{AuthorityList, SetId};
+use sp_core::H256;
+use sp_runtime::traits::{
+	BlakeTwo256, Block as BlockT, CheckedAdd, Hash as HashT, Header as HeaderT, NumberFor, One,
+	Zero,
+};
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+/// Stable top-trie key for `BridgeCommitment::CurrentCommitment`.
+pub const BRIDGE_COMMITMENT_STORAGE_KEY: [u8; 32] = [
+	0xaf, 0x86, 0xfe, 0xf4, 0x21, 0x6a, 0xc2, 0xbc, 0xd1, 0xc5, 0x92, 0xb2, 0x04, 0x01, 0x1a, 0xd0,
+	0x0d, 0x2d, 0x4f, 0xb8, 0x25, 0xaf, 0x1f, 0xcd, 0x4c, 0x2b, 0xe9, 0xf9, 0x55, 0xa7, 0x80, 0xc5,
+];
+/// Exact SCALE size of the V1 runtime bridge commitment.
+pub const BRIDGE_EVENT_COMMITMENT_V1_SCALE_BYTES: usize = 109;
+/// Maximum burns committed by one block in the pinned runtime.
+pub const MAX_BRIDGE_BURNS_PER_BLOCK: u32 = 256;
+/// Maximum raw trie nodes accepted for one exact-key proof.
+pub const MAX_BRIDGE_COMMITMENT_PROOF_NODES: usize = 256;
+/// Maximum aggregate raw trie-node bytes accepted for one exact-key proof.
+pub const MAX_BRIDGE_COMMITMENT_PROOF_BYTES: usize = 256 * 1024;
+/// Maximum individual trie-node size accepted for one exact-key proof.
+pub const MAX_BRIDGE_COMMITMENT_PROOF_NODE_BYTES: usize = 64 * 1024;
+/// Maximum linked GRANDPA proof chunks accepted for one deployment checkpoint.
+pub const MAX_LINKED_GRANDPA_PROOF_CHUNKS: usize = 16;
+/// Maximum aggregate encoded linked GRANDPA proof bytes accepted for one checkpoint.
+pub const MAX_LINKED_GRANDPA_PROOF_BYTES: usize = 16 * 1024 * 1024;
+/// Domain separator for a reviewed deployment GRANDPA trust anchor.
+pub const GRANDPA_TRUST_ANCHOR_DOMAIN: &[u8] = b"E2S_GRANDPA_TRUST_ANCHOR_V1";
+const GRANDPA_AUTHORITY_SET_DOMAIN: &[u8] = b"E2S_GRANDPA_AUTHORITY_SET_V1";
+
+/// Canonical SCALE value stored by `BridgeCommitment::CurrentCommitment`.
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+pub struct BridgeEventCommitmentV1 {
+	/// Commitment format version. V1 is the only accepted value.
+	pub format_version: u8,
+	/// Sidechain identity, currently the native genesis block hash.
+	pub sidechain_id: H256,
+	/// Native sidechain block height that produced this commitment.
+	pub sidechain_height: u64,
+	/// Frontier execution block hash whose successful logs were committed.
+	pub execution_block_hash: H256,
+	/// Blake2b bridge-event root over the canonical burn leaves.
+	pub bridge_event_root: H256,
+	/// Number of burn leaves committed by this root.
+	pub burn_leaf_count: u32,
+}
+
+/// A reason the exact bridge-commitment storage proof was rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum BridgeStateProofError {
+	/// No trie nodes were supplied.
+	#[error("bridge commitment storage proof is empty")]
+	EmptyProof,
+	/// The proof contains more nodes than the bridge policy permits.
+	#[error("bridge commitment storage proof contains too many nodes: {actual} > {max}")]
+	TooManyNodes {
+		/// Supplied node count.
+		actual: usize,
+		/// Configured maximum node count.
+		max: usize,
+	},
+	/// One trie node exceeds the per-node byte limit.
+	#[error("bridge commitment storage proof node {index} exceeds {max} bytes: {actual}")]
+	NodeTooLarge {
+		/// Zero-based node index.
+		index: usize,
+		/// Supplied node size.
+		actual: usize,
+		/// Configured maximum node size.
+		max: usize,
+	},
+	/// The aggregate trie proof exceeds the byte limit.
+	#[error("bridge commitment storage proof exceeds {max} bytes: {actual}")]
+	ProofTooLarge {
+		/// Supplied aggregate node bytes.
+		actual: usize,
+		/// Configured maximum aggregate bytes.
+		max: usize,
+	},
+	/// The raw proof repeats an encoded trie node.
+	#[error("bridge commitment storage proof contains duplicate nodes")]
+	DuplicateNodes,
+	/// The supplied nodes do not reconstruct a valid read under the authenticated state root.
+	#[error("bridge commitment storage proof is invalid for the authenticated state root")]
+	InvalidProof,
+	/// The exact bridge commitment key is absent at this state root.
+	#[error("bridge commitment is absent from the authenticated state")]
+	CommitmentMissing,
+	/// The stored value is not the exact fixed-width V1 SCALE shape.
+	#[error("bridge commitment SCALE value must be exactly {expected} bytes, got {actual}")]
+	CommitmentLength {
+		/// Supplied storage value length.
+		actual: usize,
+		/// Required V1 length.
+		expected: usize,
+	},
+	/// The fixed-width storage value could not be decoded canonically.
+	#[error("bridge commitment SCALE value is malformed")]
+	CommitmentDecode,
+	/// Only V1 runtime commitments are accepted by this verifier.
+	#[error("unsupported bridge commitment format version: {0}")]
+	UnsupportedFormat(u8),
+	/// A stored commitment must contain at least one and at most 256 burns.
+	#[error("bridge commitment burn count is outside the supported range: {0}")]
+	InvalidBurnCount(u32),
+	/// The proved runtime commitment belongs to another sidechain domain.
+	#[error("bridge commitment sidechain identity does not match the trusted domain")]
+	SidechainIdMismatch,
+	/// The stored native height differs from the authenticated header number.
+	#[error("bridge commitment height does not match the authenticated header")]
+	HeightMismatch,
+	/// Native consensus and Frontier execution hashes must remain independent identities.
+	#[error("bridge execution block hash aliases the native consensus block hash")]
+	ExecutionHashAliasesConsensus,
+}
+
+/// A finalized-state verification failure, preserving the owning layer.
+#[derive(Debug, Error)]
+pub enum FinalizedBridgeStateProofError {
+	/// GRANDPA signatures, ancestry, or exact target binding failed.
+	#[error(transparent)]
+	Finality(#[from] BridgeFinalityProofError),
+	/// Runtime-state inclusion or commitment-domain binding failed.
+	#[error(transparent)]
+	State(#[from] BridgeStateProofError),
+}
+
+/// An exact bridge commitment decoded from an authenticated native state root.
+#[derive(Debug)]
+pub struct VerifiedBridgeCommitmentState {
+	/// State root used for trie verification.
+	pub state_root: H256,
+	/// Exact fixed storage key queried by the verifier.
+	pub storage_key: [u8; 32],
+	/// Typed V1 commitment recovered from the authenticated trie.
+	pub commitment: BridgeEventCommitmentV1,
+	/// Number of bounded raw trie nodes consumed as proof material.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes accepted by the verifier.
+	pub proof_bytes: usize,
+}
+
+/// A bridge commitment whose native header is finalized under the supplied GRANDPA set.
+#[derive(Debug)]
+pub struct VerifiedFinalizedBridgeCommitmentState<Block: BlockT> {
+	/// Full requested header whose hash, number, ancestry, and state root were checked.
+	pub requested_header: Block::Header,
+	/// Native GRANDPA proof ending at an authenticated finalized target.
+	pub finality: VerifiedGrandpaFinalityProof<Block>,
+	/// Exact runtime commitment recovered from the requested header's state root.
+	pub state: VerifiedBridgeCommitmentState,
+}
+
+/// Public deployment checkpoint and GRANDPA set accepted independently of the proof-serving node.
+///
+/// The reviewed profile must choose a checkpoint without a scheduled or forced GRANDPA change.
+/// Its configured set therefore signs that checkpoint and remains active for descendants until
+/// the first handoff proved by this verifier. Consistency of these public root fields is an
+/// external review decision authenticated by `expected_trust_anchor_digest`.
+#[derive(Clone, Debug)]
+pub struct GrandpaDeploymentTrustAnchor<Block: BlockT<Hash = H256>> {
+	/// Sidechain domain, normally the native genesis block hash.
+	pub sidechain_id: H256,
+	/// Reviewed finalized checkpoint hash from which linked authority proofs must descend.
+	pub checkpoint_hash: H256,
+	/// Reviewed finalized checkpoint number.
+	pub checkpoint_number: NumberFor<Block>,
+	/// GRANDPA set identifier that signs this non-transition checkpoint and its descendants.
+	pub set_id: SetId,
+	/// Canonical authority list for the same non-transition checkpoint profile.
+	pub authorities: AuthorityList,
+}
+
+/// One bounded compact GRANDPA proof plus every contiguous header omitted by that compact proof.
+#[derive(Clone, Debug)]
+pub struct LinkedGrandpaAuthorityProofChunk<Block: BlockT> {
+	/// Exact contiguous descendants after the preceding authenticated checkpoint.
+	pub ancestry_headers: Vec<Block::Header>,
+	/// Canonical SCALE compact warp-proof bytes for signed handoff fragments.
+	pub encoded_proof: Vec<u8>,
+}
+
+/// A deployment-level checkpoint verification failure.
+#[derive(Debug, Error)]
+pub enum DeploymentCheckpointError {
+	/// The public trust-anchor fields do not match the independently reviewed digest.
+	#[error("GRANDPA deployment trust-anchor digest mismatch")]
+	TrustAnchorDigestMismatch,
+	/// The generic checkpoint number cannot be represented by the fixed V1 uint64 anchor format.
+	#[error("GRANDPA deployment trust-anchor number does not fit uint64")]
+	TrustAnchorNumberOverflow,
+	/// Too many linked proof chunks were supplied.
+	#[error("too many linked GRANDPA proof chunks: {actual} > {max}")]
+	TooManyLinkedProofChunks {
+		/// Supplied chunk count.
+		actual: usize,
+		/// Configured maximum chunk count.
+		max: usize,
+	},
+	/// Aggregate encoded linked proof bytes exceed the checkpoint policy.
+	#[error("linked GRANDPA proof bytes exceed {max}: {actual}")]
+	LinkedProofBytesTooLarge {
+		/// Supplied aggregate bytes.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// One linked authority-proof chunk failed verification.
+	#[error("linked GRANDPA proof chunk {chunk} failed: {source}")]
+	LinkedProof {
+		/// Zero-based chunk position.
+		chunk: usize,
+		/// Native linked-proof failure.
+		#[source]
+		source: BridgeAuthorityTransitionError,
+	},
+	/// A complete chunk cannot be followed by another chunk.
+	#[error("linked GRANDPA proof chunk {chunk} completed before the final chunk")]
+	CompletionBeforeFinalChunk {
+		/// Zero-based chunk position.
+		chunk: usize,
+	},
+	/// The checkpoint tail after the final linked handoff exceeds the shared bridge header bound.
+	#[error("checkpoint tail contains too many headers: {actual} > {max}")]
+	TooManyFinalityAncestryHeaders {
+		/// Supplied header count.
+		actual: usize,
+		/// Configured maximum header count.
+		max: usize,
+	},
+	/// One checkpoint-tail header did not increment the preceding height exactly once.
+	#[error("checkpoint-tail header {header} is not the next block number")]
+	FinalityAncestryNumberMismatch {
+		/// Zero-based header index.
+		header: usize,
+	},
+	/// One checkpoint-tail header was not a child of the preceding authenticated hash.
+	#[error("checkpoint-tail header {header} is not hash-linked")]
+	FinalityAncestryParentMismatch {
+		/// Zero-based header index.
+		header: usize,
+	},
+	/// Forced authority changes are never accepted on the checkpoint tail.
+	#[error("checkpoint-tail header {header} contains a forced authority change")]
+	FinalityAncestryForcedChange {
+		/// Zero-based header index.
+		header: usize,
+	},
+	/// An outgoing scheduled handoff may occur only at the signed finality horizon.
+	#[error("target-set finality ancestry header {header} changes authorities before the horizon")]
+	FinalityAncestryEarlyScheduledChange {
+		/// Zero-based header index.
+		header: usize,
+	},
+	/// The bridge profile accepts only zero-delay outgoing handoffs at the terminal horizon.
+	#[error("target-set finality horizon contains a delayed authority change")]
+	FinalityAncestryDelayedTerminalChange,
+	/// Exact target finality or runtime-state verification failed.
+	#[error(transparent)]
+	FinalizedState(#[from] FinalizedBridgeStateProofError),
+	/// The checkpoint chain does not contain the exact requested header.
+	#[error("checkpoint ancestry does not contain the exact requested header")]
+	RequestedHeaderNotInCheckpointAncestry,
+	/// The checkpoint suffix and GRANDPA proof contain different ancestry lengths.
+	#[error(
+		"checkpoint ancestry after the requested header has {actual} headers; GRANDPA proof has {expected}"
+	)]
+	FinalityProofAncestryLengthMismatch {
+		/// Checkpoint suffix length.
+		actual: usize,
+		/// GRANDPA `unknown_headers` length.
+		expected: usize,
+	},
+	/// One checkpoint suffix header differs byte-for-byte from the GRANDPA proof ancestry.
+	#[error("checkpoint ancestry header {header} differs from the GRANDPA finality proof")]
+	FinalityProofAncestryMismatch {
+		/// Zero-based position after the requested header.
+		header: usize,
+	},
+	/// The checkpoint tail and target finality proof must end at one exact horizon header.
+	#[error("checkpoint tail does not end at the GRANDPA finality horizon")]
+	FinalityHorizonMismatch,
+}

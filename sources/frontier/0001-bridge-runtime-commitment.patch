+/// Build the deterministic five-key request shared by both composed proof layers.
+pub fn deterministic_fixture_request() -> NativeFrontierPegInEventRequest {
+	let first_transaction = transaction(1);
+	let target_transaction = transaction(2);
+	let first_logs = vec![Log {
+		address: H160::repeat_byte(0x77),
+		topics: vec![H256::repeat_byte(0x88)],
+		data: vec![1, 2, 3],
+	}];
+	let target_logs = vec![peg_in_log(
+		H160::repeat_byte(0x55),
+		2_000_000,
+		H256::repeat_byte(0x44),
+	)];
+	let receipts = vec![
+		receipt(1, 21_000, first_logs.clone()),
+		receipt(1, 42_000, target_logs.clone()),
+	];
+	let statuses = vec![
+		status(&first_transaction, 0, first_logs),
+		status(&target_transaction, 1, target_logs),
+	];
+	let receipts_root =
+		ethereum::util::ordered_trie_root(receipts.iter().map(EnvelopedEncodable::encode));
+	let mut block_bloom = Bloom::default();
+	for receipt in &receipts {
+		let logs = match receipt {
+			ReceiptV3::Legacy(data) | ReceiptV3::EIP2930(data) | ReceiptV3::EIP1559(data) => {
+				&data.logs
+			}
+		};
+		accrue_logs(logs, &mut block_bloom);
+	}
+	let block = BlockV2::new(
+		PartialHeader {
+			parent_hash: H256::repeat_byte(0x10),
+			beneficiary: H160::repeat_byte(0x20),
+			state_root: H256::repeat_byte(0x30),
+			receipts_root,
+			logs_bloom: block_bloom,
+			difficulty: U256::zero(),
+			number: u64::from(TARGET_NUMBER).into(),
+			gas_limit: 30_000_000u64.into(),
+			gas_used: 42_000u64.into(),
+			timestamp: 1_700_000_000,
+			extra_data: Vec::new(),
+			mix_hash: H256::repeat_byte(0x40),
+			nonce: Default::default(),
+		},
+		vec![first_transaction, target_transaction.clone()],
+		Vec::new(),
+	);
+	let record = PegInRuntimeRecordV1 {
+		format_version: 1,
+		sidechain_id: H256::repeat_byte(0x11),
+		bridge_address: H160::repeat_byte(0x22),
+		profile_revision: 2,
+		profile_activation_height: 700,
+		ergo_box_id: H256::repeat_byte(0x44),
+		recipient: H160::repeat_byte(0x55),
+		amount: 2_000_000,
+		sidechain_height: u64::from(TARGET_NUMBER),
+		execution_block_hash: block.header.hash(),
+		transaction_hash: target_transaction.hash(),
+		event_index: 1,
+	};
+
+	let current_block_key = derive_ethereum_current_block_storage_key();
+	let receipts_key = derive_ethereum_current_receipts_storage_key();
+	let statuses_key = derive_ethereum_current_transaction_statuses_storage_key();
+	let record_key =
+		derive_processed_peg_in_storage_key_v1(record.sidechain_id, record.ergo_box_id);
+	let mut state = BTreeMap::new();
+	state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), RUNTIME_CODE.to_vec());
+	state.insert(current_block_key.to_vec(), block.encode());
+	state.insert(receipts_key.to_vec(), receipts.encode());
+	state.insert(statuses_key.to_vec(), statuses.encode());
+	state.insert(record_key.to_vec(), record.encode());
+	let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+	let state_root = *backend.root();
+	let proof = prove_read(
+		backend,
+		[
+			RUNTIME_CODE_STORAGE_KEY.as_slice(),
+			current_block_key.as_slice(),
+			receipts_key.as_slice(),
+			statuses_key.as_slice(),
+			record_key.as_slice(),
+		],
+	)
+	.expect("deterministic state must produce the exact five-key proof");
+	let proof_nodes = proof.into_iter_nodes().collect::<Vec<_>>();
+	let target = NativeHeader::new(
+		TARGET_NUMBER,
+		H256::repeat_byte(0x90),
+		state_root,
+		anchor_hash(),
+		Digest::default(),
+	);
+	let (pairs, authorities) = authority_fixture();
+	let finality_proof = signed_finality_proof(&target, &pairs);
+
+	NativeFrontierPegInEventRequest {
+		schema: REQUEST_SCHEMA.to_owned(),
+		execution_identity_request: NativeFrontierExecutionIdentityRequest {
+			schema: EXECUTION_REQUEST_SCHEMA.to_owned(),
+			trust_anchor: TrustAnchorRequest {
+				sidechain_id_hex: format_hash(record.sidechain_id),
+				checkpoint_hash_hex: format_hash(anchor_hash()),
+				checkpoint_number: u64::from(ANCHOR_NUMBER).to_string(),
+				grandpa_set_id: SET_ID.to_string(),
+				authority_list_scale_hex: format_bytes(&authorities.encode()),
+			},
+			target_native_block_hash_hex: format_hash(target.hash()),
+			target_header_scale_hex: format_bytes(&target.encode()),
+			linked_grandpa_proofs: Vec::<LinkedGrandpaProofRequest>::new(),
+			checkpoint_tail_headers_scale_hex: vec![format_bytes(&target.encode())],
+			finality_proof_scale_hex: format_bytes(&finality_proof),
+			statement: FrontierExecutionIdentityStatementRequest {
+				schema: EXECUTION_STATEMENT_SCHEMA.to_owned(),
+				runtime_code: RuntimeCodeStatementRequest {
+					storage_key_hex: format_bytes(&RUNTIME_CODE_STORAGE_KEY),
+					artifact_sha256_hex: format_bytes(&sha2_256(RUNTIME_CODE)),
+					artifact_size_bytes: RUNTIME_CODE.len().to_string(),
+					build_attestation_id: BUILD_ATTESTATION_ID.to_owned(),
+					build_attestation_sha256_hex: format_bytes(&BUILD_ATTESTATION_SHA256),
+				},
+				current_block_storage_key_hex: format_bytes(&current_block_key),
+				ergo_box_id_hex: format_hash(record.ergo_box_id),
+				expected_record_scale_hex: format_bytes(&record.encode()),
+			},
+			runtime_state_proof_nodes_hex: proof_nodes
+				.iter()
+				.map(|node| format_bytes(node))
+				.collect(),
+		},
+		statement: FrontierPegInEventStatementRequest {
+			schema: STATEMENT_SCHEMA.to_owned(),
+			current_receipts_storage_key_hex: format_bytes(&receipts_key),
+			current_transaction_statuses_storage_key_hex: format_bytes(&statuses_key),
+		},
+	}
+}
+
+/// Build the fixture wrapper and exact digest-bound expected result.
+pub fn deterministic_fixture_vector() -> FrontierPegInEventFixtureVector {
+	let trusted_anchor_digest_hex = deterministic_trusted_anchor_digest_hex();
+	let request = deterministic_fixture_request();
+	let expected = verify_request_bytes(
+		&serde_json::to_vec(&request).expect("fixture request must serialize canonically"),
+		&trusted_anchor_digest_hex,
+	)
+	.expect("deterministic Frontier event request must verify");
+	FrontierPegInEventFixtureVector {
+		schema: FIXTURE_VECTOR_SCHEMA.to_owned(),
+		trusted_anchor_digest_hex,
+		request,
+		expected,
+	}
+}
+
+fn transaction(seed: u8) -> TransactionV2 {
+	TransactionV2::Legacy(LegacyTransaction {
+		nonce: u64::from(seed).into(),
+		gas_price: 1_000_000_000u64.into(),
+		gas_limit: 100_000u64.into(),
+		action: TransactionAction::Call(H160::repeat_byte(0x22)),
+		value: U256::zero(),
+		input: vec![seed; 4],
+		signature: TransactionSignature::new(
+			27,
+			H256::repeat_byte(seed.max(1)),
+			H256::repeat_byte(seed.saturating_add(1).max(1)),
+		)
+		.expect("deterministic transaction signature must be canonical"),
+	})
+}
+
+fn peg_in_log(recipient: H160, amount: u64, ergo_box_id: H256) -> Log {
+	let mut recipient_topic = [0u8; 32];
+	recipient_topic[12..].copy_from_slice(recipient.as_bytes());
+	let mut data = vec![0u8; 64];
+	data[24..32].copy_from_slice(&amount.to_be_bytes());
+	data[32..].copy_from_slice(ergo_box_id.as_bytes());
+	Log {
+		address: H160::repeat_byte(0x22),
+		topics: vec![
+			H256::from(keccak_256(PEG_IN_EVENT_SIGNATURE)),
+			H256::from(recipient_topic),
+		],
+		data,
+	}
+}
+
+fn receipt(status_code: u8, used_gas: u64, logs: Vec<Log>) -> ReceiptV3 {
+	ReceiptV3::Legacy(EIP658ReceiptData {
+		status_code,
+		used_gas: used_gas.into(),
+		logs_bloom: logs_bloom(&logs),
+		logs,
+	})
+}
+
+fn status(transaction: &TransactionV2, index: u32, logs: Vec<Log>) -> TransactionStatus {
+	TransactionStatus {
+		transaction_hash: transaction.hash(),
+		transaction_index: index,
+		from: H160::repeat_byte(0x10),
+		to: Some(H160::repeat_byte(0x22)),
+		contract_address: None,
+		logs_bloom: logs_bloom(&logs),
+		logs,
+	}
+}
+
+fn logs_bloom(logs: &[Log]) -> Bloom {
+	let mut bloom = Bloom::default();
+	accrue_logs(logs, &mut bloom);
+	bloom
+}
+
+fn accrue_logs(logs: &[Log], bloom: &mut Bloom) {
+	for log in logs {
+		bloom.accrue(BloomInput::Raw(log.address.as_bytes()));
+		for topic in &log.topics {
+			bloom.accrue(BloomInput::Raw(topic.as_bytes()));
+		}
+	}
+}

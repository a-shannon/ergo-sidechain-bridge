+fn signed_legacy_transaction(
+	secret: H256,
+	nonce: u64,
+	action: TransactionAction,
+	input: Vec<u8>,
+) -> Transaction {
+	let message = LegacyTransactionMessage {
+		nonce: U256::from(nonce),
+		gas_price: U256::from(TEST_GAS_PRICE),
+		gas_limit: U256::from(TEST_GAS_LIMIT),
+		action,
+		value: U256::zero(),
+		input: input.clone(),
+		chain_id: Some(TEST_CHAIN_ID),
+	};
+	let signing_message = libsecp256k1::Message::parse(message.hash().as_fixed_bytes());
+	let secret_key = libsecp256k1::SecretKey::parse_slice(secret.as_bytes())
+		.expect("valid deterministic EVM test key");
+	let (signature, recovery_id) = libsecp256k1::sign(&signing_message, &secret_key);
+	let signature = signature.serialize();
+	let signature = TransactionSignature::new(
+		recovery_id.serialize() as u64 % 2 + TEST_CHAIN_ID * 2 + 35,
+		H256::from_slice(&signature[..32]),
+		H256::from_slice(&signature[32..]),
+	)
+	.expect("valid deterministic EVM transaction signature");
+	Transaction::Legacy(LegacyTransaction {
+		nonce: message.nonce,
+		gas_price: message.gas_price,
+		gas_limit: message.gas_limit,
+		action: message.action,
+		value: message.value,
+		input,
+		signature,
+	})
+}

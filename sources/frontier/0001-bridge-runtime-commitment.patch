+	)?;
+	let target_header = NativeHeader::decode_all(&mut &target_header_bytes[..]).map_err(|_| {
+		NativeFrontierExecutionIdentityRequestError::Scale {
+			field: "targetHeaderScaleHex",
+		}
+	})?;
+	if target_header.hash() != expected_target_hash {
+		return Err(NativeFrontierExecutionIdentityRequestError::TargetHashMismatch);
+	}
+
+	ensure_collection(
+		"linkedGrandpaProofs",
+		request.linked_grandpa_proofs.len(),
+		0,
+		MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+	)?;
+	let linked_proofs = request
+		.linked_grandpa_proofs
+		.iter()
+		.map(|chunk| {
+			ensure_collection(
+				"linkedGrandpaProofs.ancestryHeadersScaleHex",
+				chunk.ancestry_headers_scale_hex.len(),

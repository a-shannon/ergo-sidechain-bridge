+			MAX_PEG_IN_STATE_PROOF_BYTES / MAX_PEG_IN_STATE_PROOF_NODE_BYTES
+		];
+		assert_eq!(
+			validate_proof_bounds(&exact_aggregate).unwrap(),
+			MAX_PEG_IN_STATE_PROOF_BYTES
+		);
+		let mut oversized_aggregate = exact_aggregate;
+		oversized_aggregate.push(vec![0]);
+		assert_eq!(
+			validate_proof_bounds(&oversized_aggregate).unwrap_err(),
+			PegInStateProofError::ProofTooLarge {
+				actual: MAX_PEG_IN_STATE_PROOF_BYTES + 1,
+				max: MAX_PEG_IN_STATE_PROOF_BYTES,
+			}
+		);
+	}
+

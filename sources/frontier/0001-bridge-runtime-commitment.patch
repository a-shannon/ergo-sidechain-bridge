+				MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES + 1
+			]]),
+			Err(FrontierExecutionIdentityProofError::NodeTooLarge {
+				index: 0,
+				actual: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES + 1,
+				max: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+			})
+		);
+		assert_eq!(
+			validate_proof_bounds(&[
+				vec![0; MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES],
+				vec![
+					1;
+					MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES
+						- MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES
+						+ 1
+				],
+			]),
+			Err(FrontierExecutionIdentityProofError::ProofTooLarge {
+				actual: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES + 1,
+				max: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES,
+			})
+		);
+		assert_eq!(
+			validate_proof_bounds(&[
+				vec![0; MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES],
+				vec![
+					1;
+					MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES
+						- MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES
+				],
+			]),
+			Ok(MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_BYTES)
+		);
+	}
+}
diff --git a/bridge/state-proof/src/peg_in_frontier_mint_transition_v1.rs b/bridge/state-proof/src/peg_in_frontier_mint_transition_v1.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5901da3a316ce0bce5d69c900b5cd7f40930b8c7
--- /dev/null
+++ b/bridge/state-proof/src/peg_in_frontier_mint_transition_v1.rs
@@ -0,0 +1,482 @@
+//! Authenticated direct-parent to successful peg-in mint transition.
+//!
+//! This profile composes the unchanged finalized event-block contract-state verifier with one
+//! direct-parent state proof. It proves first appearance of the native processed record, the
+//! Solidity replay transition, unchanged reviewed code/configuration/owners, one exact paired
+//! ERC-20 mint log, and exact supply plus recipient-balance deltas. It remains a local proof core:
+//! committed-vault eligibility, verifier execution authority, daemon admission, Gate 5 closure,
+//! and release readiness remain separate.
+
+use scale_codec::{DecodeAll, Encode};
+use sp_core::{hashing::sha2_256, H160, H256, U256};
+use sp_runtime::traits::BlakeTwo256;
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+use crate::{
+	peg_in::derive_processed_peg_in_storage_key_v1,
+	peg_in_frontier_contract_state_v1::{
+		derive_evm_account_code_storage_key, derive_evm_account_storage_key,
+		derive_processed_peg_in_mapping_slot, verify_frontier_peg_in_contract_state_v1,
+		FrontierPegInContractStateProofError, FrontierRuntimeCodeExpectationV1,
+		VerifiedFrontierPegInContractStateV1, MAX_FRONTIER_EVM_RUNTIME_CODE_BYTES,
+	},
+	peg_in_frontier_event_v1::{
+		verify_frontier_token_mint_v1, FrontierPegInEventProofError, VerifiedFrontierPegInEventV1,
+		VerifiedFrontierTokenMintV1,
+	},
+	peg_in_frontier_execution_identity_v1::{
+		validate_proof_bounds, FrontierExecutionIdentityProofError,
+		VerifiedFrontierExecutionIdentityV1,
+	},
+	peg_in_runtime_identity_v2::RUNTIME_CODE_STORAGE_KEY,
+};
+
+const BRIDGE_OWNER_SLOT: u64 = 0;
+const BRIDGE_CONFIGURATION_SLOT: u64 = 3;
+const TOKEN_BALANCES_MAPPING_SLOT: u64 = 0;
+const TOKEN_TOTAL_SUPPLY_SLOT: u64 = 2;
+const TOKEN_OWNER_SLOT: u64 = 5;
+
+/// Maximum exact native runtime code bytes accepted in the parent proof.
+pub const MAX_FRONTIER_PARENT_RUNTIME_CODE_BYTES: usize = 16 * 1024 * 1024;
+
+/// Authenticated state before the exact peg-in execution block.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedFrontierPegInParentStateV1 {
+	/// Direct-parent native state root.
+	pub state_root: H256,
+	/// Exact native runtime-code SHA-256.
+	pub runtime_code_sha256: [u8; 32],
+	/// Exact native runtime-code byte length.
+	pub runtime_code_bytes: usize,
+	/// Exact native processed-record key proved absent.
+	pub native_processed_record_storage_key: Vec<u8>,
+	/// Exact bridge runtime-code SHA-256.
+	pub bridge_runtime_code_sha256: [u8; 32],
+	/// Exact bridge runtime-code byte length.
+	pub bridge_runtime_code_bytes: usize,
+	/// Exact token runtime-code SHA-256.
+	pub token_runtime_code_sha256: [u8; 32],
+	/// Exact token runtime-code byte length.
+	pub token_runtime_code_bytes: usize,
+	/// Authenticated bridge owner.
+	pub bridge_owner: H160,
+	/// Authenticated bridge token configuration.
+	pub configured_token: H160,
+	/// Authenticated bridge pause flag.
+	pub paused: bool,
+	/// Authenticated Solidity replay marker, required false.
+	pub processed_peg_in: bool,
+	/// Authenticated token total supply before the event block.
+	pub token_total_supply: U256,
+	/// Authenticated token owner before the event block.
+	pub token_owner: H160,
+	/// Authenticated recipient balance before the event block.
+	pub recipient_balance: U256,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+}
+
+/// Exact direct-parent to event-block mint transition.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedFrontierPegInMintTransitionV1 {
+	/// Authenticated direct-parent state.
+	pub parent: VerifiedFrontierPegInParentStateV1,
+	/// Authenticated event-block contract state from the unchanged T20B profile.
+	pub post: VerifiedFrontierPegInContractStateV1,
+	/// Exact recipient-balance Solidity mapping slot.
+	pub recipient_balance_slot: H256,
+	/// Exact recipient-balance top-trie key.
+	pub recipient_balance_storage_key: Vec<u8>,
+	/// Authenticated recipient balance after the event block.
+	pub post_recipient_balance: U256,
+	/// Exact total-supply increase.
+	pub token_total_supply_delta: U256,
+	/// Exact recipient-balance increase.
+	pub recipient_balance_delta: U256,
+	/// Exact paired mint log from the authenticated successful receipt.
+	pub mint: VerifiedFrontierTokenMintV1,
+	/// Number of bounded post-state trie nodes consumed.
+	pub post_proof_node_count: usize,
+	/// Aggregate bounded post-state trie-node bytes consumed.
+	pub post_proof_bytes: usize,
+}
+
+/// A reason an authenticated direct-parent mint transition was rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum FrontierPegInMintTransitionProofError {
+	/// Shared proof bounds failed.
+	#[error(transparent)]
+	ProofBounds(#[from] FrontierExecutionIdentityProofError),
+	/// Unchanged event-block contract-state verification failed.
+	#[error(transparent)]
+	PostState(#[from] FrontierPegInContractStateProofError),
+	/// Authenticated receipt mint semantics failed.
+	#[error(transparent)]
+	MintLog(#[from] FrontierPegInEventProofError),
+	/// Parent proof does not reconstruct every exact requested key.
+	#[error("Frontier parent-state proof is invalid for the authenticated parent root")]
+	InvalidParentProof,
+	/// Post proof does not reconstruct the exact recipient-balance key.
+	#[error("Frontier post-state proof does not authenticate the recipient balance")]
+	InvalidPostBalanceProof,
+	/// One required authenticated parent member is absent.
+	#[error("authenticated parent {field} is absent")]
+	MissingParentValue {
+		/// Stable identity of the missing member.
+		field: &'static str,
+	},
+	/// Native runtime code differs from its exact expectation.
+	#[error("authenticated parent native runtime code differs from the exact expectation")]
+	ParentRuntimeCodeMismatch,
+	/// One EVM runtime-code member is malformed or differs from its exact expectation.
+	#[error("authenticated parent {field} runtime code differs from the exact expectation")]
+	ParentContractCodeMismatch {
+		/// Stable bridge or token code identity.
+		field: &'static str,
+	},
+	/// One authenticated EVM storage word is malformed.
+	#[error("authenticated {field} is not an exact H256 storage word")]
+	MalformedStorage {
+		/// Stable state field identity.
+		field: &'static str,
+	},
+	/// One address word has nonzero high padding.
+	#[error("authenticated {field} address has nonzero high padding")]
+	AddressPadding {
+		/// Stable address field identity.
+		field: &'static str,
+	},
+	/// Packed bridge configuration is malformed.
+	#[error("authenticated parent bridge configuration is malformed")]
+	ParentConfiguration,
+	/// The native processed record already exists in the direct parent.
+	#[error("native processed peg-in record already exists in the direct parent")]
+	ParentNativeRecordPresent,
+	/// Solidity replay was already set or noncanonical in the direct parent.
+	#[error("Solidity processedPegIns marker is not false in the direct parent")]
+	ParentReplayNotFalse,
+	/// Bridge or token code/configuration/ownership changed across the event block.
+	#[error("authenticated bridge/token identity changed across the peg-in event block")]
+	ContractIdentityChanged,
+	/// The bridge is paused in one of the authenticated states.
+	#[error("authenticated bridge must remain unpaused across the peg-in event block")]
+	BridgePaused,
+	/// Token ownership is not the exact bridge in the direct parent.
+	#[error("authenticated parent token owner differs from the bridge")]
+	ParentTokenOwnerMismatch,
+	/// Total supply decreased or increased by another amount.
+	#[error("authenticated token total-supply delta differs from the peg-in amount")]
+	SupplyDeltaMismatch,
+	/// Recipient balance decreased or increased by another amount.
+	#[error("authenticated recipient-balance delta differs from the peg-in amount")]
+	RecipientBalanceDeltaMismatch,
+}
+
+/// Derive the Solidity mapping slot for `_balances[recipient]` at base slot zero.
+pub fn derive_token_balance_mapping_slot(recipient: H160) -> H256 {
+	let mut encoded = [0u8; 64];
+	encoded[12..32].copy_from_slice(recipient.as_bytes());
+	encoded[63] = TOKEN_BALANCES_MAPPING_SLOT as u8;
+	H256::from(sp_core::hashing::keccak_256(&encoded))
+}
+
+/// Verify one exact direct-parent to event-block mint transition.
+#[allow(clippy::too_many_arguments)]
+pub fn verify_frontier_peg_in_mint_transition_v1(
+	execution: &VerifiedFrontierExecutionIdentityV1,
+	event: &VerifiedFrontierPegInEventV1,
+	post_proof_nodes: &[Vec<u8>],
+	parent_state_root: H256,
+	parent_proof_nodes: &[Vec<u8>],
+	bridge_address: H160,
+	token_address: H160,
+	runtime_code: FrontierRuntimeCodeExpectationV1,
+	bridge_code: FrontierRuntimeCodeExpectationV1,
+	token_code: FrontierRuntimeCodeExpectationV1,
+) -> Result<VerifiedFrontierPegInMintTransitionV1, FrontierPegInMintTransitionProofError> {
+	let post = verify_frontier_peg_in_contract_state_v1(
+		event,
+		post_proof_nodes,
+		bridge_address,
+		token_address,
+		bridge_code,
+		token_code,
+	)?;
+	let mint = verify_frontier_token_mint_v1(execution, post_proof_nodes, event, token_address)?;
+	let parent = verify_parent_state(
+		execution,
+		event,
+		parent_state_root,
+		parent_proof_nodes,
+		bridge_address,
+		token_address,
+		runtime_code,
+		bridge_code,
+		token_code,
+	)?;
+	if parent.bridge_runtime_code_sha256 != post.bridge_runtime_code_sha256
+		|| parent.bridge_runtime_code_bytes != post.bridge_runtime_code_bytes
+		|| parent.token_runtime_code_sha256 != post.token_runtime_code_sha256
+		|| parent.token_runtime_code_bytes != post.token_runtime_code_bytes
+		|| parent.bridge_owner != post.bridge_owner
+		|| parent.configured_token != post.configured_token
+		|| parent.paused != post.paused
+		|| parent.token_owner != post.token_owner
+	{
+		return Err(FrontierPegInMintTransitionProofError::ContractIdentityChanged);
+	}
+	if parent.paused || post.paused {
+		return Err(FrontierPegInMintTransitionProofError::BridgePaused);
+	}
+
+	let post_proof_bytes = validate_proof_bounds(post_proof_nodes)?;
+	let recipient_balance_slot = derive_token_balance_mapping_slot(event.recipient);
+	let recipient_balance_key =
+		derive_evm_account_storage_key(token_address, recipient_balance_slot);
+	let proof = StorageProof::new_with_duplicate_nodes_check(post_proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let values = read_proof_check::<BlakeTwo256, _>(
+		event.state_root,
+		proof,
+		[recipient_balance_key.as_slice()],
+	)
+	.map_err(|_| FrontierPegInMintTransitionProofError::InvalidPostBalanceProof)?;
+	let post_recipient_balance = U256::from_big_endian(
+		storage_word_or_zero(&values, &recipient_balance_key, "post recipient balance")?.as_bytes(),
+	);
+	let amount = U256::from(event.amount);
+	let supply_delta = post
+		.token_total_supply
+		.checked_sub(parent.token_total_supply)
+		.ok_or(FrontierPegInMintTransitionProofError::SupplyDeltaMismatch)?;
+	if supply_delta != amount {
+		return Err(FrontierPegInMintTransitionProofError::SupplyDeltaMismatch);
+	}
+	let balance_delta = post_recipient_balance
+		.checked_sub(parent.recipient_balance)
+		.ok_or(FrontierPegInMintTransitionProofError::RecipientBalanceDeltaMismatch)?;
+	if balance_delta != amount {
+		return Err(FrontierPegInMintTransitionProofError::RecipientBalanceDeltaMismatch);
+	}
+
+	Ok(VerifiedFrontierPegInMintTransitionV1 {
+		parent,
+		post,
+		recipient_balance_slot,
+		recipient_balance_storage_key: recipient_balance_key,
+		post_recipient_balance,
+		token_total_supply_delta: supply_delta,
+		recipient_balance_delta: balance_delta,
+		mint,
+		post_proof_node_count: post_proof_nodes.len(),
+		post_proof_bytes,
+	})
+}
+
+#[allow(clippy::too_many_arguments)]
+fn verify_parent_state(
+	execution: &VerifiedFrontierExecutionIdentityV1,
+	event: &VerifiedFrontierPegInEventV1,
+	state_root: H256,
+	proof_nodes: &[Vec<u8>],
+	bridge_address: H160,
+	token_address: H160,
+	runtime_code: FrontierRuntimeCodeExpectationV1,
+	bridge_code: FrontierRuntimeCodeExpectationV1,
+	token_code: FrontierRuntimeCodeExpectationV1,
+) -> Result<VerifiedFrontierPegInParentStateV1, FrontierPegInMintTransitionProofError> {
+	let proof_bytes = validate_proof_bounds(proof_nodes)?;
+	let native_record_key =
+		derive_processed_peg_in_storage_key_v1(execution.record.sidechain_id, event.ergo_box_id)
+			.to_vec();
+	let bridge_code_key = derive_evm_account_code_storage_key(bridge_address);
+	let token_code_key = derive_evm_account_code_storage_key(token_address);
+	let bridge_owner_key =
+		derive_evm_account_storage_key(bridge_address, H256::from_low_u64_be(BRIDGE_OWNER_SLOT));
+	let bridge_configuration_key = derive_evm_account_storage_key(
+		bridge_address,
+		H256::from_low_u64_be(BRIDGE_CONFIGURATION_SLOT),
+	);
+	let processed_key = derive_evm_account_storage_key(
+		bridge_address,
+		derive_processed_peg_in_mapping_slot(event.ergo_box_id),
+	);
+	let supply_key = derive_evm_account_storage_key(
+		token_address,
+		H256::from_low_u64_be(TOKEN_TOTAL_SUPPLY_SLOT),
+	);
+	let token_owner_key =
+		derive_evm_account_storage_key(token_address, H256::from_low_u64_be(TOKEN_OWNER_SLOT));
+	let balance_key = derive_evm_account_storage_key(
+		token_address,
+		derive_token_balance_mapping_slot(event.recipient),
+	);
+	let keys = [
+		RUNTIME_CODE_STORAGE_KEY.to_vec(),
+		native_record_key.clone(),
+		bridge_code_key,
+		token_code_key,
+		bridge_owner_key,
+		bridge_configuration_key,
+		processed_key,
+		supply_key,
+		token_owner_key,
+		balance_key,
+	];
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let values =
+		read_proof_check::<BlakeTwo256, _>(state_root, proof, keys.iter().map(Vec::as_slice))
+			.map_err(|_| FrontierPegInMintTransitionProofError::InvalidParentProof)?;
+	if values
+		.get(&native_record_key)
+		.ok_or(FrontierPegInMintTransitionProofError::InvalidParentProof)?
+		.is_some()
+	{
+		return Err(FrontierPegInMintTransitionProofError::ParentNativeRecordPresent);
+	}
+
+	let raw_runtime = required(&values, &keys[0], "native runtime code")?;
+	if raw_runtime.is_empty()
+		|| raw_runtime.len() > MAX_FRONTIER_PARENT_RUNTIME_CODE_BYTES
+		|| raw_runtime.len() != runtime_code.bytes
+		|| sha2_256(raw_runtime) != runtime_code.sha256
+	{
+		return Err(FrontierPegInMintTransitionProofError::ParentRuntimeCodeMismatch);
+	}
+	let bridge_runtime = decode_contract_code(
+		required(&values, &keys[2], "bridge runtime code")?,
+		"bridge",
+		bridge_code,
+	)?;
+	let token_runtime = decode_contract_code(
+		required(&values, &keys[3], "token runtime code")?,
+		"token",
+		token_code,
+	)?;
+	let bridge_owner = decode_address_word(
+		storage_word_or_zero(&values, &keys[4], "parent bridge owner")?,
+		"parent bridge owner",
+	)?;
+	let configuration = decode_storage_word(
+		required(&values, &keys[5], "bridge configuration")?,
+		"parent bridge configuration",
+	)?;
+	let (configured_token, paused) = decode_configuration(configuration)?;
+	if configured_token != token_address {
+		return Err(FrontierPegInMintTransitionProofError::ContractIdentityChanged);
+	}
+	let replay = storage_word_or_zero(&values, &keys[6], "parent processedPegIns")?;
+	if replay != H256::zero() {
+		return Err(FrontierPegInMintTransitionProofError::ParentReplayNotFalse);
+	}
+	let supply = U256::from_big_endian(
+		storage_word_or_zero(&values, &keys[7], "parent total supply")?.as_bytes(),
+	);
+	let token_owner = decode_address_word(
+		decode_storage_word(
+			required(&values, &keys[8], "token owner")?,
+			"parent token owner",
+		)?,
+		"parent token owner",
+	)?;
+	if token_owner != bridge_address {
+		return Err(FrontierPegInMintTransitionProofError::ParentTokenOwnerMismatch);
+	}
+	let recipient_balance = U256::from_big_endian(
+		storage_word_or_zero(&values, &keys[9], "parent recipient balance")?.as_bytes(),
+	);
+
+	Ok(VerifiedFrontierPegInParentStateV1 {
+		state_root,
+		runtime_code_sha256: sha2_256(raw_runtime),
+		runtime_code_bytes: raw_runtime.len(),
+		native_processed_record_storage_key: native_record_key,
+		bridge_runtime_code_sha256: sha2_256(&bridge_runtime),
+		bridge_runtime_code_bytes: bridge_runtime.len(),
+		token_runtime_code_sha256: sha2_256(&token_runtime),
+		token_runtime_code_bytes: token_runtime.len(),
+		bridge_owner,
+		configured_token,
+		paused,
+		processed_peg_in: false,
+		token_total_supply: supply,
+		token_owner,
+		recipient_balance,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+fn required<'a>(
+	values: &'a std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+	field: &'static str,
+) -> Result<&'a [u8], FrontierPegInMintTransitionProofError> {
+	values
+		.get(key)
+		.and_then(|value| value.as_deref())
+		.ok_or(FrontierPegInMintTransitionProofError::MissingParentValue { field })
+}
+
+fn decode_contract_code(
+	raw: &[u8],
+	field: &'static str,
+	expected: FrontierRuntimeCodeExpectationV1,
+) -> Result<Vec<u8>, FrontierPegInMintTransitionProofError> {
+	let code = Vec::<u8>::decode_all(&mut &raw[..])
+		.map_err(|_| FrontierPegInMintTransitionProofError::ParentContractCodeMismatch { field })?;
+	if code.encode().as_slice() != raw
+		|| code.is_empty()
+		|| code.len() > MAX_FRONTIER_EVM_RUNTIME_CODE_BYTES
+		|| code.len() != expected.bytes
+		|| sha2_256(&code) != expected.sha256
+	{
+		return Err(FrontierPegInMintTransitionProofError::ParentContractCodeMismatch { field });
+	}
+	Ok(code)
+}
+
+fn decode_storage_word(
+	raw: &[u8],
+	field: &'static str,
+) -> Result<H256, FrontierPegInMintTransitionProofError> {
+	if raw.len() != 32 {
+		return Err(FrontierPegInMintTransitionProofError::MalformedStorage { field });
+	}
+	Ok(H256::from_slice(raw))
+}
+
+fn storage_word_or_zero(
+	values: &std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+	field: &'static str,
+) -> Result<H256, FrontierPegInMintTransitionProofError> {
+	match values.get(key) {
+		Some(Some(raw)) => decode_storage_word(raw, field),
+		Some(None) => Ok(H256::zero()),
+		None => Err(FrontierPegInMintTransitionProofError::MissingParentValue { field }),
+	}
+}
+
+fn decode_address_word(
+	word: H256,
+	field: &'static str,
+) -> Result<H160, FrontierPegInMintTransitionProofError> {
+	if word.as_bytes()[..12].iter().any(|byte| *byte != 0) {
+		return Err(FrontierPegInMintTransitionProofError::AddressPadding { field });
+	}
+	Ok(H160::from_slice(&word.as_bytes()[12..]))
+}
+
+fn decode_configuration(word: H256) -> Result<(H160, bool), FrontierPegInMintTransitionProofError> {
+	let bytes = word.as_bytes();
+	if bytes[..11].iter().any(|byte| *byte != 0) || bytes[11] > 1 {
+		return Err(FrontierPegInMintTransitionProofError::ParentConfiguration);
+	}
+	Ok((H160::from_slice(&bytes[12..]), bytes[11] == 1))
+}
diff --git a/bridge/state-proof/src/peg_in_runtime_identity_v2.rs b/bridge/state-proof/src/peg_in_runtime_identity_v2.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7181d4846ce2313d6fd8f7bdc99f856c53f493e2
--- /dev/null
+++ b/bridge/state-proof/src/peg_in_runtime_identity_v2.rs
@@ -0,0 +1,947 @@
+//! Finalized-state proof profile for Peg-In Runtime Identity V2.
+//!
+//! V2 preserves the Peg-In Runtime State V1 profile and record semantics while adding the exact
+//! Substrate `:code` value to the same state proof. The result proves only that the target state
+//! root contains runtime bytes with the statement-bound digest and size. A separate reviewed build
+//! attestation must establish that those expected bytes are an approved runtime artifact.
+
+use bridge_finality_proof::{
+	verify_grandpa_finality_proof, BridgeFinalityProofError, VerifiedGrandpaFinalityProof,
+};
+use scale_codec::DecodeAll;
+use sp_consensus_grandpa::{AuthorityList, SetId};

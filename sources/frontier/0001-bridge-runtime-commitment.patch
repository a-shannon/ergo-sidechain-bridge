@@ -0,0 +1,751 @@
+//! Strict offline verification for finalized peg-in Frontier execution identity V1.
+//!
+//! This profile authenticates exact raw runtime bytes, `Ethereum::CurrentBlock`, and one exact
+//! processed-deposit record under one finalized native state root. It proves that the record's
+//! execution block and transaction identities are present in that authenticated Frontier block.
+//! It does not prove receipt inclusion, transaction success, deposit-event semantics, EVM code or
+//! storage, build provenance, historical mint absence, or mint authority.
+
+use bridge_finality_proof::{
+	MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS, MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+	MAX_FINALITY_PROOF_BYTES,
+};
+use bridge_state_proof::{
+	derive_grandpa_authority_set_hash,
+	peg_in::{PegInRuntimeRecordV1, PEG_IN_RECORD_V1_SCALE_BYTES},
+	peg_in_frontier_execution_identity_v1::{
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES,
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+	},
+	peg_in_runtime_identity_v2::{
+		RuntimeCodeExpectationV2, MAX_RUNTIME_CODE_BYTES, RUNTIME_CODE_STORAGE_KEY,
+	},
+	verify_frontier_execution_identity_deployment_checkpoint,
+	FrontierExecutionIdentityDeploymentCheckpointError, GrandpaDeploymentTrustAnchor,
+	LinkedGrandpaAuthorityProofChunk, MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+};
+use scale_codec::{DecodeAll, Encode};
+use serde::{Deserialize, Serialize};
+use sp_consensus_grandpa::AuthorityList;
+use sp_runtime::traits::{BlakeTwo256, Hash as _, Header as _};
+use thiserror::Error;
+
+use crate::{
+	ensure_collection, format_bytes, format_hash, parse_byte_hex, parse_decimal_u64, parse_hash,
+	peg_in_runtime_identity_v2::{RuntimeCodeStatementRequest, VerifiedPegInRecordOutput},
+	LinkedGrandpaProofRequest, NativeBlock, NativeCheckpointRequestError, NativeHeader,
+	TrustAnchorRequest, VerifiedAuthorityOutput, VerifiedFinalityOutput, VerifiedTargetOutput,
+	MAX_AUTHORITY_LIST_BYTES, MAX_NATIVE_HEADER_BYTES, MAX_REQUEST_BYTES,
+};
+
+/// Stable request schema for finalized peg-in Frontier execution identity V1.
+pub const REQUEST_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-frontier-execution-identity-request.v1";
+/// Stable statement schema for the exact runtime, block, and processed record.
+pub const STATEMENT_SCHEMA: &str = "e2s.peg-in-frontier-execution-identity-statement.v1";
+/// Stable successful result schema for finalized peg-in Frontier execution identity V1.
+pub const VERIFICATION_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-frontier-execution-identity-verification.v1";
+/// Maximum portable build-attestation identifier bytes.
+pub const MAX_BUILD_ATTESTATION_ID_BYTES: usize = 128;
+
+/// Versioned statement bound into the native request digest.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct FrontierExecutionIdentityStatementRequest {
+	/// Exact statement schema.
+	pub schema: String,
+	/// Exact expected runtime code plus a non-authoritative build-attestation identity.
+	pub runtime_code: RuntimeCodeStatementRequest,
+	/// Exact top-trie key for `Ethereum::CurrentBlock`.
+	pub current_block_storage_key_hex: String,
+	/// Canonical nonzero Ergo deposit box identity.
+	pub ergo_box_id_hex: String,
+	/// Canonical fixed-width V1 processed-record SCALE bytes.
+	pub expected_record_scale_hex: String,
+}
+
+/// Complete finalized peg-in Frontier execution identity request.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFrontierExecutionIdentityRequest {
+	/// Exact request schema.
+	pub schema: String,
+	/// Public deployment trust root.
+	pub trust_anchor: TrustAnchorRequest,
+	/// Expected hash of the requested native block.
+	pub target_native_block_hash_hex: String,
+	/// Canonical SCALE requested native header.
+	pub target_header_scale_hex: String,
+	/// Hash-linked authority-transition proofs from the public trust root.
+	pub linked_grandpa_proofs: Vec<LinkedGrandpaProofRequest>,
+	/// Contiguous headers after the last linked handoff through the finality horizon.
+	pub checkpoint_tail_headers_scale_hex: Vec<String>,
+	/// Canonical SCALE `grandpa_proveFinality` response for the target.
+	pub finality_proof_scale_hex: String,
+	/// Exact runtime, Frontier block, and processed-record statement.
+	pub statement: FrontierExecutionIdentityStatementRequest,
+	/// One raw trie proof covering `:code`, `Ethereum::CurrentBlock`, and the processed record.
+	pub runtime_state_proof_nodes_hex: Vec<String>,
+}
+
+/// Verified exact-key native runtime state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedFrontierRuntimeStateOutput {
+	/// Exact raw Substrate `:code` key.
+	pub runtime_code_storage_key_hex: String,
+	/// SHA-256 of the authenticated raw runtime Wasm.
+	pub runtime_code_sha256_hex: String,
+	/// Exact authenticated raw runtime Wasm byte length.
+	pub runtime_code_size_bytes: String,
+	/// Statement-bound identity of the separately reviewed build attestation.
+	pub build_attestation_id: String,
+	/// Statement-bound SHA-256 of the separately reviewed build-attestation bytes.
+	pub build_attestation_sha256_hex: String,
+	/// Exact `Ethereum::CurrentBlock` top-trie key.
+	pub current_block_storage_key_hex: String,
+	/// SHA-256 of the authenticated canonical `CurrentBlock` SCALE bytes.
+	pub current_block_scale_sha256_hex: String,
+	/// Exact authenticated `CurrentBlock` SCALE byte length.
+	pub current_block_scale_bytes: String,
+	/// Exact internally derived `ProcessedPegIns` storage key.
+	pub record_storage_key_hex: String,
+	/// Canonical authenticated processed-record SCALE bytes.
+	pub record_storage_value_scale_hex: String,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+	/// Confirms all three exact reads were verified against the target native state root.
+	pub verified: bool,
+}
+
+/// Frontier execution block identity authenticated under native state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedFrontierExecutionOutput {
+	/// Keccak/RLP Frontier block hash recomputed from the authenticated header.
+	pub execution_block_hash_hex: String,
+	/// Frontier block number as an exact decimal string.
+	pub execution_height: String,
+	/// EVM state root carried by the Frontier header, distinct from the native state root.
+	pub evm_state_root_hex: String,
+	/// Recomputed transaction trie root.
+	pub transaction_root_hex: String,
+	/// Recomputed ommer-list hash.
+	pub ommers_hash_hex: String,
+	/// Number of authenticated transactions.
+	pub transaction_count: usize,
+	/// Number of authenticated ommers.
+	pub ommer_count: usize,
+	/// Processed-record transaction hash bound to this block.
+	pub record_transaction_hash_hex: String,
+	/// Zero-based position of the processed-record transaction.
+	pub record_transaction_index: usize,
+}
+
+/// Explicit non-authorizing claim boundary for one execution-identity result.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerificationBoundaryOutput {
+	/// Native sidechain finality is verified relative to the reviewed trust root.
+	pub sidechain_finality_verified: bool,
+	/// Exact raw runtime code was authenticated under the target root.
+	pub runtime_code_state_proof_verified: bool,
+	/// Exact `Ethereum::CurrentBlock` was authenticated under the target root.
+	pub current_block_state_proof_verified: bool,
+	/// Exact processed-record membership was authenticated under the target root.
+	pub processed_record_state_proof_verified: bool,
+	/// The Frontier block hash was recomputed and matched to the native record.
+	pub execution_block_hash_mapped_to_native_state: bool,
+	/// The transaction root was recomputed from the authenticated block body.
+	pub transaction_root_recomputed: bool,
+	/// The ommers hash was recomputed from the authenticated ommer list.
+	pub ommers_hash_recomputed: bool,
+	/// The record transaction was found exactly once in the authenticated block.
+	pub record_transaction_bound_exactly_once: bool,
+	/// Receipt inclusion remains a separate proof obligation.
+	pub receipt_inclusion_verified: bool,
+	/// Transaction success/status remains a separate proof obligation.
+	pub transaction_status_verified: bool,
+	/// Deposit-event semantics remain a separate receipt/log proof obligation.
+	pub deposit_event_semantics_verified: bool,
+	/// EVM account-code state remains a separate proof obligation.
+	pub evm_code_state_verified: bool,
+	/// EVM contract-storage state remains a separate proof obligation.
+	pub evm_storage_state_verified: bool,
+	/// The separately supplied build-attestation identity is not authenticated here.
+	pub runtime_build_attestation_verified: bool,
+	/// Runtime identity remains false until proved bytes match a reviewed build attestation.
+	pub runtime_code_identity_verified: bool,
+	/// The preceding Ergo deposit-to-vault transition remains a separate obligation.
+	pub committed_vault_transition_verified: bool,
+	/// One current membership does not prove absence of a prior mint.
+	pub historical_mint_absence_verified: bool,
+	/// This verifier never authorizes mint selection or hold release.
+	pub mint_authorized: bool,
+	/// This offline verifier cannot mutate transactions or chain state.
+	pub transaction_mutation_enabled: bool,
+	/// This proof alone does not close Gate 5.
+	pub gate5_closed: bool,
+	/// This proof alone does not establish production readiness.
+	pub production_readiness_verified: bool,
+}
+
+/// Successful finalized peg-in Frontier execution identity report.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFrontierExecutionIdentityVerification {
+	/// Exact successful output schema.
+	pub schema: String,
+	/// Stable verification status.
+	pub status: String,
+	/// Blake2b-256 digest of the exact request bytes consumed by the process.
+	pub request_digest_hex: String,
+	/// Recomputed public trust-anchor digest.
+	pub trust_anchor_digest_hex: String,
+	/// Requested native target identity.
+	pub target: VerifiedTargetOutput,
+	/// Authenticated authority-transition result.
+	pub authority: VerifiedAuthorityOutput,
+	/// Exact GRANDPA finality horizon.
+	pub finality: VerifiedFinalityOutput,
+	/// Exact three-key runtime-state result.
+	pub runtime_state: VerifiedFrontierRuntimeStateOutput,
+	/// Typed historical processed record.
+	pub record: VerifiedPegInRecordOutput,
+	/// Frontier execution identity mapped to native state.
+	pub execution: VerifiedFrontierExecutionOutput,
+	/// Non-negotiable claim boundary.
+	pub boundary: VerificationBoundaryOutput,
+}
+
+/// Verified V1 report plus typed state retained only for a composed local verifier.
+pub(crate) struct NativeFrontierExecutionIdentityVerificationContext {
+	/// Public V1 verification report.
+	pub verification: NativeFrontierExecutionIdentityVerification,
+	/// Typed execution identity used by the composed verifier in the same process.
+	pub execution_state:
+		bridge_state_proof::peg_in_frontier_execution_identity_v1::VerifiedFrontierExecutionIdentityV1,
+	/// Exact bounded trie nodes supplied by the request.
+	pub state_nodes: Vec<Vec<u8>>,
+}
+
+/// A strict request or finalized execution-identity verification failure.
+#[derive(Debug, Error)]
+pub enum NativeFrontierExecutionIdentityRequestError {
+	/// Shared strict request parsing or bound validation failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// Request schema did not match the V1 execution-identity contract.
+	#[error("unsupported finalized peg-in Frontier execution identity request schema")]
+	Schema,
+	/// Statement schema did not match the V1 execution-identity statement.
+	#[error("unsupported peg-in Frontier execution identity statement schema")]
+	StatementSchema,
+	/// The statement did not use the exact raw Substrate `:code` key.
+	#[error("runtime code storage key must be exactly 0x3a636f6465")]
+	RuntimeCodeStorageKey,
+	/// The statement did not use the exact `Ethereum::CurrentBlock` key.
+	#[error("current block storage key differs from Ethereum::CurrentBlock")]
+	CurrentBlockStorageKey,
+	/// The expected runtime size exceeds the V2 runtime-code profile or this host.
+	#[error("invalid runtime code size")]
+	RuntimeCodeSize,
+	/// The portable build-attestation identity is malformed or unbounded.
+	#[error("invalid runtime build attestation ID")]
+	BuildAttestationId,
+	/// The build-attestation digest must be nonzero.
+	#[error("runtime build attestation SHA-256 digest is zero")]
+	ZeroBuildAttestationDigest,
+	/// One fixed-width SCALE statement value had the wrong length.
+	#[error(
+		"invalid fixed-width SCALE value for {field}: expected {expected} bytes, got {actual}"
+	)]
+	ScaleLength {
+		/// Stable field label.
+		field: &'static str,
+		/// Required exact bytes.
+		expected: usize,
+		/// Supplied bytes.
+		actual: usize,
+	},
+	/// One fixed-width SCALE statement value was malformed.
+	#[error("failed to decode canonical SCALE value for {field}")]
+	Scale {
+		/// Stable field label.
+		field: &'static str,
+	},
+	/// The supplied target hash did not equal the decoded header hash.
+	#[error("target native block hash does not match the decoded target header")]
+	TargetHashMismatch,
+	/// Finality, transition, runtime, block, or record verification failed.
+	#[error(transparent)]
+	Checkpoint(#[from] FrontierExecutionIdentityDeploymentCheckpointError),
+}
+
+/// Verify one exact bounded execution-identity request entirely offline.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<NativeFrontierExecutionIdentityVerification, NativeFrontierExecutionIdentityRequestError>
+{
+	Ok(verify_request_bytes_with_context(raw_request, trusted_anchor_digest_hex)?.verification)
+}
+
+/// Verify V1 while retaining typed state for a composed, same-process proof profile.
+pub(crate) fn verify_request_bytes_with_context(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<
+	NativeFrontierExecutionIdentityVerificationContext,
+	NativeFrontierExecutionIdentityRequestError,
+> {
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(NativeCheckpointRequestError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_REQUEST_BYTES,
+		}
+		.into());
+	}
+	let request: NativeFrontierExecutionIdentityRequest =
+		serde_json::from_slice(raw_request).map_err(NativeCheckpointRequestError::Json)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativeFrontierExecutionIdentityRequestError::Schema);
+	}
+	if request.statement.schema != STATEMENT_SCHEMA {
+		return Err(NativeFrontierExecutionIdentityRequestError::StatementSchema);
+	}
+	let trusted_anchor_digest = parse_hash("trustedAnchorDigestHex", trusted_anchor_digest_hex)?;
+	let runtime_code_storage_key = parse_byte_hex(
+		"statement.runtimeCode.storageKeyHex",
+		&request.statement.runtime_code.storage_key_hex,
+		RUNTIME_CODE_STORAGE_KEY.len(),
+	)?;
+	if runtime_code_storage_key != RUNTIME_CODE_STORAGE_KEY {
+		return Err(NativeFrontierExecutionIdentityRequestError::RuntimeCodeStorageKey);
+	}
+	let current_block_storage_key =
+		bridge_state_proof::peg_in_frontier_execution_identity_v1::derive_ethereum_current_block_storage_key();
+	let supplied_current_block_key = parse_byte_hex(
+		"statement.currentBlockStorageKeyHex",
+		&request.statement.current_block_storage_key_hex,
+		current_block_storage_key.len(),
+	)?;
+	if supplied_current_block_key != current_block_storage_key {
+		return Err(NativeFrontierExecutionIdentityRequestError::CurrentBlockStorageKey);
+	}
+	let runtime_code_sha256 = parse_hash(
+		"statement.runtimeCode.artifactSha256Hex",
+		&request.statement.runtime_code.artifact_sha256_hex,
+	)?;
+	let runtime_code_size_u64 = parse_decimal_u64(
+		"statement.runtimeCode.artifactSizeBytes",
+		&request.statement.runtime_code.artifact_size_bytes,
+	)?;
+	let runtime_code_size_bytes: usize = runtime_code_size_u64
+		.try_into()
+		.map_err(|_| NativeFrontierExecutionIdentityRequestError::RuntimeCodeSize)?;
+	if runtime_code_size_bytes == 0 || runtime_code_size_bytes > MAX_RUNTIME_CODE_BYTES {
+		return Err(NativeFrontierExecutionIdentityRequestError::RuntimeCodeSize);
+	}
+	validate_build_attestation_id(&request.statement.runtime_code.build_attestation_id)?;
+	let build_attestation_sha256 = parse_hash(
+		"statement.runtimeCode.buildAttestationSha256Hex",
+		&request.statement.runtime_code.build_attestation_sha256_hex,
+	)?;
+	if build_attestation_sha256 == Default::default() {
+		return Err(NativeFrontierExecutionIdentityRequestError::ZeroBuildAttestationDigest);
+	}
+	let runtime_code = RuntimeCodeExpectationV2 {
+		artifact_sha256: runtime_code_sha256.to_fixed_bytes(),
+		artifact_size_bytes: runtime_code_size_bytes,
+	};
+
+	let sidechain_id = parse_hash(
+		"trustAnchor.sidechainIdHex",
+		&request.trust_anchor.sidechain_id_hex,
+	)?;
+	let checkpoint_hash = parse_hash(
+		"trustAnchor.checkpointHashHex",
+		&request.trust_anchor.checkpoint_hash_hex,
+	)?;
+	let checkpoint_number_u64 = parse_decimal_u64(
+		"trustAnchor.checkpointNumber",
+		&request.trust_anchor.checkpoint_number,
+	)?;
+	let checkpoint_number =
+		checkpoint_number_u64
+			.try_into()
+			.map_err(|_| NativeCheckpointRequestError::Decimal {
+				field: "trustAnchor.checkpointNumber",
+			})?;
+	let grandpa_set_id = parse_decimal_u64(
+		"trustAnchor.grandpaSetId",
+		&request.trust_anchor.grandpa_set_id,
+	)?;
+	let authority_bytes = parse_byte_hex(
+		"trustAnchor.authorityListScaleHex",
+		&request.trust_anchor.authority_list_scale_hex,
+		MAX_AUTHORITY_LIST_BYTES,
+	)?;
+	let authorities = AuthorityList::decode_all(&mut &authority_bytes[..]).map_err(|_| {
+		NativeCheckpointRequestError::Scale {
+			field: "trustAnchor.authorityListScaleHex",
+		}
+	})?;
+	let anchor = GrandpaDeploymentTrustAnchor::<NativeBlock> {
+		sidechain_id,
+		checkpoint_hash,
+		checkpoint_number,
+		set_id: grandpa_set_id,
+		authorities,

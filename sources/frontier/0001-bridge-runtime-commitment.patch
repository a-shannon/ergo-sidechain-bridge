+
+	#[test]
+	fn rejects_each_post_successor_failure_independently() {
+		for mutation in [
+			FixtureMutation::PostPendingRetained,
+			FixtureMutation::PostConsumedMissing,
+			FixtureMutation::PostConsumedWrong,
+			FixtureMutation::PostProfileChanged,
+			FixtureMutation::PostPendingKeyRetained,
+		] {
+			assert!(
+				verify(&deterministic_fixture_request_with_mutation(mutation)).is_err(),
+				"mutation {mutation:?} must fail closed"
+			);
+		}
+	}
+
+	#[test]
+	fn preserves_every_non_target_pending_entry_across_the_transition() {
+		let request = deterministic_fixture_request_with_mutation(
+			FixtureMutation::AdditionalPendingUnchanged,
+		);
+		let verified = verify(&request).expect("unchanged additional pending entry must verify");
+		assert_eq!(verified.causal_transition.parent_pending_key_count, 2);
+		assert_eq!(verified.causal_transition.post_pending_key_count, 1);
+
+		for mutation in [
+			FixtureMutation::ParentAdditionalPendingMissing,
+			FixtureMutation::PostAdditionalPendingMissing,
+			FixtureMutation::PostAdditionalPendingChanged,
+		] {
+			assert!(
+				verify(&deterministic_fixture_request_with_mutation(mutation)).is_err(),
+				"mutation {mutation:?} must fail closed"
+			);
+		}
+	}
+
+	#[test]
+	fn rejects_outer_schema_storage_key_and_trust_root_drift() {
+		let mut request = deterministic_fixture_request();
+		request.schema.push_str("-changed");
+		assert!(matches!(
+			verify(&request).unwrap_err(),
+			NativeFinalizedPegInCausalMintTransitionRequestErrorV2::Schema
+		));
+
+		let mut request = deterministic_fixture_request();
+		request.statement.pending_admission_storage_key_hex =
+			format_bytes(H256::repeat_byte(0x99).as_bytes());
+		assert!(matches!(
+			verify(&request).unwrap_err(),
+			NativeFinalizedPegInCausalMintTransitionRequestErrorV2::StorageKey { .. }
+		));
+
+		let request = deterministic_fixture_request();
+		let wrong_anchor = format_hash(H256::repeat_byte(0xfe));
+		assert!(
+			verify_request_bytes(&serde_json::to_vec(&request).unwrap(), &wrong_anchor,).is_err()
+		);
+	}
+}
diff --git a/bridge/checkpoint-verifier/src/peg_in_causal_mint_transition_v2_fixture.rs b/bridge/checkpoint-verifier/src/peg_in_causal_mint_transition_v2_fixture.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ba38ed9e5b963922bc18531729304a94c2ee0f49
--- /dev/null
+++ b/bridge/checkpoint-verifier/src/peg_in_causal_mint_transition_v2_fixture.rs
@@ -0,0 +1,513 @@
+//! Reproducible finalized causal peg-in mint-transition fixture.
+
+use std::collections::BTreeMap;
+
+use bridge_state_proof::{
+	peg_in::derive_peg_in_record_key_v1,
+	peg_in_causal_mint_transition_v2::{
+		derive_bridge_storage_map_key_v2, derive_bridge_storage_value_key_v2,
+	},
+};
+use scale_codec::{Decode, Encode};
+use serde::Serialize;
+use sp_core::{hashing::blake2_256, hashing::sha2_256, H256};
+
+use crate::{
+	format_bytes,
+	peg_in_causal_mint_transition_v2::{
+		verify_request_bytes, CausalPegInMintTransitionStatementRequestV2,
+		NativeFinalizedPegInCausalMintTransitionRequestV2,
+		NativeFinalizedPegInCausalMintTransitionVerificationV2, REQUEST_SCHEMA, STATEMENT_SCHEMA,
+	},
+	peg_in_frontier_execution_identity_v1_fixture::deterministic_trusted_anchor_digest_hex,
+	peg_in_frontier_mint_transition_v1_fixture::{
+		deterministic_fixture_request_with_state_extensions, MintTransitionFixtureContext,
+		MintTransitionFixtureStateExtension,
+	},
+};
+
+const CURRENT_PEG_IN_PROFILE: &[u8] = b"CurrentPegInProfile";
+const CURRENT_CAUSAL_PROFILE: &[u8] = b"CurrentCausalPegInProfileV2";
+const CAUSAL_ENFORCEMENT: &[u8] = b"CausalPegInEnforcementActivatedV2";
+const PENDING_KEYS: &[u8] = b"PendingCausalPegInKeys";
+const PENDING_ADMISSIONS: &[u8] = b"PendingCausalPegInsV2";
+const PROCESSED_PEG_INS: &[u8] = b"ProcessedPegIns";
+const CONSUMED_ADMISSIONS: &[u8] = b"ConsumedCausalPegInsV3";
+const PROFILE_DOMAIN: &[u8] = b"E2S_PEG_IN_CAUSAL_PROFILE_V2";
+const SOURCE_INTENT_DOMAIN: &[u8] = b"E2S_PEG_IN_SOURCE_INTENT_V2";
+const ADMISSION_DOMAIN: &[u8] = b"E2S_PEG_IN_CAUSAL_ADMISSION_V2";
+
+/// Stable schema for the deterministic T20E-D vector wrapper.
+pub const FIXTURE_VECTOR_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-causal-mint-transition.vector.v2";
+
+/// One deterministic request and its exact successful native result.
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct CausalPegInMintTransitionFixtureVectorV2 {
+	/// Exact fixture wrapper schema.
+	pub schema: String,
+	/// Independently supplied trust-anchor digest.
+	pub trusted_anchor_digest_hex: String,
+	/// Strict composed causal transition request.
+	pub request: NativeFinalizedPegInCausalMintTransitionRequestV2,
+	/// Expected result for canonical compact request bytes.
+	pub expected: NativeFinalizedPegInCausalMintTransitionVerificationV2,
+}
+
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+struct CausalRuntimeProfileScaleV2 {
+	profile_bytes: Vec<u8>,
+	profile_id: H256,
+	bridge_runtime_code_sha256: H256,
+	bridge_runtime_code_bytes: u32,
+	token_runtime_code_sha256: H256,
+	token_runtime_code_bytes: u32,
+}
+
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+struct PendingAdmissionScaleV2 {
+	profile_id: H256,
+	source_intent_bytes: Vec<u8>,
+	statement_bytes: Vec<u8>,
+	admission_id: H256,
+	admitted_at_native_height: u64,
+	proof_system_id: H256,
+	proof_profile_id: H256,
+}
+
+struct CausalFixtureValues {
+	record_key: H256,
+	runtime_profile_v1_scale: Vec<u8>,
+	causal_profile_scale: Vec<u8>,
+	pending_scale: Vec<u8>,
+	consumed_v3: Vec<u8>,
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum FixtureMutation {
+	ParentPendingMissing,
+	ParentReplayPresent,
+	ParentConsumedPresent,
+	PostPendingRetained,
+	PostConsumedMissing,
+	PostConsumedWrong,
+	PostProfileChanged,
+	PostPendingKeyRetained,
+	DuplicateParentPendingKey,
+	ParentEnforcementInactive,
+	AdditionalPendingUnchanged,
+	ParentAdditionalPendingMissing,
+	PostAdditionalPendingMissing,
+	PostAdditionalPendingChanged,
+}
+
+/// Build the deterministic finalized causal transition request.
+pub fn deterministic_fixture_request() -> NativeFinalizedPegInCausalMintTransitionRequestV2 {
+	build_fixture_request(None)
+}
+
+#[cfg(test)]
+pub(crate) fn deterministic_fixture_request_with_mutation(
+	mutation: FixtureMutation,
+) -> NativeFinalizedPegInCausalMintTransitionRequestV2 {
+	build_fixture_request(Some(mutation))
+}
+
+fn build_fixture_request(
+	mutation: Option<FixtureMutation>,
+) -> NativeFinalizedPegInCausalMintTransitionRequestV2 {
+	let mint_transition_request = deterministic_fixture_request_with_state_extensions(
+		|context| parent_extension(context, mutation),
+		|context, parent_hash, parent_height| {
+			post_extension(context, parent_hash, parent_height, mutation)
+		},
+	);
+	let record = &mint_transition_request
+		.contract_state_request
+		.event_request
+		.execution_identity_request
+		.statement;
+	let record_scale = hex::decode(
+		record
+			.expected_record_scale_hex
+			.strip_prefix("0x")
+			.expect("fixture record SCALE must be prefixed"),
+	)
+	.expect("fixture record SCALE must be hexadecimal");
+	let record = bridge_state_proof::peg_in::PegInRuntimeRecordV1::decode(&mut &record_scale[..])
+		.expect("fixture record SCALE must decode");
+	let record_key = derive_peg_in_record_key_v1(record.sidechain_id, record.ergo_box_id);
+	NativeFinalizedPegInCausalMintTransitionRequestV2 {
+		schema: REQUEST_SCHEMA.to_owned(),
+		mint_transition_request,
+		statement: statement(record_key),
+	}
+}
+
+/// Build the deterministic wrapper and exact digest-bound expected result.
+pub fn deterministic_fixture_vector() -> CausalPegInMintTransitionFixtureVectorV2 {
+	let trusted_anchor_digest_hex = deterministic_trusted_anchor_digest_hex();
+	let request = deterministic_fixture_request();
+	let expected = verify_request_bytes(
+		&serde_json::to_vec(&request).expect("fixture request must serialize canonically"),
+		&trusted_anchor_digest_hex,
+	)
+	.expect("deterministic causal mint-transition request must verify");
+	CausalPegInMintTransitionFixtureVectorV2 {
+		schema: FIXTURE_VECTOR_SCHEMA.to_owned(),
+		trusted_anchor_digest_hex,
+		request,
+		expected,
+	}
+}
+
+fn parent_extension(
+	context: &MintTransitionFixtureContext<'_>,
+	mutation: Option<FixtureMutation>,
+) -> MintTransitionFixtureStateExtension {
+	let values = causal_values(context, H256::repeat_byte(0x01), 0);
+	let mut entries = common_entries(&values);
+	if mutation == Some(FixtureMutation::ParentEnforcementInactive) {
+		entries.insert(
+			derive_bridge_storage_value_key_v2(CAUSAL_ENFORCEMENT),
+			false.encode(),
+		);
+	}
+	let include_additional = has_additional_pending(mutation);
+	let additional_key = H256::repeat_byte(0x5a);
+	let pending_keys = if mutation == Some(FixtureMutation::DuplicateParentPendingKey) {
+		vec![values.record_key, values.record_key]
+	} else if include_additional {
+		vec![values.record_key, additional_key]
+	} else {
+		vec![values.record_key]
+	};
+	entries.insert(
+		derive_bridge_storage_value_key_v2(PENDING_KEYS),
+		pending_keys.encode(),
+	);
+	if mutation != Some(FixtureMutation::ParentPendingMissing) {
+		entries.insert(
+			derive_bridge_storage_map_key_v2(PENDING_ADMISSIONS, values.record_key),
+			values.pending_scale,
+		);
+	}
+	if include_additional && mutation != Some(FixtureMutation::ParentAdditionalPendingMissing) {
+		entries.insert(
+			derive_bridge_storage_map_key_v2(PENDING_ADMISSIONS, additional_key),
+			additional_pending_value(),
+		);
+	}
+	if mutation == Some(FixtureMutation::ParentReplayPresent) {
+		entries.insert(
+			derive_bridge_storage_map_key_v2(PROCESSED_PEG_INS, values.record_key),
+			context.record.encode(),
+		);
+	}
+	if mutation == Some(FixtureMutation::ParentConsumedPresent) {
+		entries.insert(
+			derive_bridge_storage_map_key_v2(CONSUMED_ADMISSIONS, values.record_key),
+			values.consumed_v3.encode(),
+		);
+	}
+	MintTransitionFixtureStateExtension {
+		entries,
+		proof_keys: proof_keys(values.record_key, include_additional),
+	}
+}
+
+fn post_extension(
+	context: &MintTransitionFixtureContext<'_>,
+	parent_hash: H256,
+	parent_height: u64,
+	mutation: Option<FixtureMutation>,
+) -> MintTransitionFixtureStateExtension {
+	let values = causal_values(context, parent_hash, parent_height);
+	let mut entries = common_entries(&values);
+	if mutation == Some(FixtureMutation::PostProfileChanged) {
+		let mut changed = values.causal_profile_scale.clone();
+		let last = changed
+			.last_mut()
+			.expect("causal profile SCALE fixture must not be empty");
+		*last ^= 1;
+		entries.insert(
+			derive_bridge_storage_value_key_v2(CURRENT_CAUSAL_PROFILE),
+			changed,
+		);
+	}
+	let include_additional = has_additional_pending(mutation);
+	let additional_key = H256::repeat_byte(0x5a);
+	let pending_keys = if mutation == Some(FixtureMutation::PostPendingKeyRetained) {
+		vec![values.record_key]
+	} else if include_additional {
+		vec![additional_key]
+	} else {
+		Vec::<H256>::new()
+	};
+	entries.insert(
+		derive_bridge_storage_value_key_v2(PENDING_KEYS),
+		pending_keys.encode(),
+	);
+	if mutation == Some(FixtureMutation::PostPendingRetained) {
+		entries.insert(
+			derive_bridge_storage_map_key_v2(PENDING_ADMISSIONS, values.record_key),
+			values.pending_scale,
+		);
+	}
+	if include_additional && mutation != Some(FixtureMutation::PostAdditionalPendingMissing) {
+		let mut value = additional_pending_value();
+		if mutation == Some(FixtureMutation::PostAdditionalPendingChanged) {
+			value[0] ^= 1;
+		}
+		entries.insert(
+			derive_bridge_storage_map_key_v2(PENDING_ADMISSIONS, additional_key),
+			value,
+		);
+	}
+	if mutation != Some(FixtureMutation::PostConsumedMissing) {
+		let mut consumed = values.consumed_v3;
+		if mutation == Some(FixtureMutation::PostConsumedWrong) {
+			let last = consumed
+				.last_mut()
+				.expect("consumed V3 fixture must not be empty");
+			*last ^= 1;
+		}
+		entries.insert(
+			derive_bridge_storage_map_key_v2(CONSUMED_ADMISSIONS, values.record_key),
+			consumed.encode(),
+		);
+	}
+	MintTransitionFixtureStateExtension {
+		entries,
+		proof_keys: proof_keys(values.record_key, include_additional),
+	}
+}
+
+fn common_entries(values: &CausalFixtureValues) -> BTreeMap<Vec<u8>, Vec<u8>> {
+	BTreeMap::from([
+		(
+			derive_bridge_storage_value_key_v2(CURRENT_PEG_IN_PROFILE),
+			values.runtime_profile_v1_scale.clone(),
+		),
+		(
+			derive_bridge_storage_value_key_v2(CURRENT_CAUSAL_PROFILE),
+			values.causal_profile_scale.clone(),
+		),
+		(
+			derive_bridge_storage_value_key_v2(CAUSAL_ENFORCEMENT),
+			true.encode(),
+		),
+	])
+}
+
+fn proof_keys(record_key: H256, include_additional: bool) -> Vec<Vec<u8>> {
+	let mut keys = vec![
+		derive_bridge_storage_value_key_v2(CURRENT_PEG_IN_PROFILE),
+		derive_bridge_storage_value_key_v2(CURRENT_CAUSAL_PROFILE),
+		derive_bridge_storage_value_key_v2(CAUSAL_ENFORCEMENT),
+		derive_bridge_storage_value_key_v2(PENDING_KEYS),
+		derive_bridge_storage_map_key_v2(PENDING_ADMISSIONS, record_key),
+		derive_bridge_storage_map_key_v2(CONSUMED_ADMISSIONS, record_key),
+	];
+	if include_additional {
+		keys.push(derive_bridge_storage_map_key_v2(
+			PENDING_ADMISSIONS,
+			H256::repeat_byte(0x5a),
+		));
+	}
+	keys
+}
+
+fn has_additional_pending(mutation: Option<FixtureMutation>) -> bool {
+	mutation == Some(FixtureMutation::AdditionalPendingUnchanged)
+		|| mutation == Some(FixtureMutation::ParentAdditionalPendingMissing)
+		|| mutation == Some(FixtureMutation::PostAdditionalPendingMissing)
+		|| mutation == Some(FixtureMutation::PostAdditionalPendingChanged)
+}
+
+fn additional_pending_value() -> Vec<u8> {
+	vec![0x10, 0x20, 0x30, 0x40]
+}
+
+fn causal_values(
+	context: &MintTransitionFixtureContext<'_>,
+	parent_hash: H256,
+	parent_height: u64,
+) -> CausalFixtureValues {
+	let record = context.record;
+	let record_key = derive_peg_in_record_key_v1(record.sidechain_id, record.ergo_box_id);
+	let runtime_profile_v1 = bridge_state_proof::peg_in::PegInRuntimeProfileV1 {
+		format_version: 1,
+		sidechain_id: record.sidechain_id,
+		bridge_address: record.bridge_address,
+		profile_revision: record.profile_revision,
+		activation_height: record.profile_activation_height,
+	};
+	let profile_bytes = profile_bytes(record.sidechain_id, record.bridge_address);
+	let profile_id = domain_hash(PROFILE_DOMAIN, &profile_bytes);
+	let source_intent_bytes = source_intent_bytes(context, profile_id);
+	let source_intent_id = domain_hash(SOURCE_INTENT_DOMAIN, &source_intent_bytes);
+	let statement_bytes = admission_statement_bytes(context, source_intent_id, record_key);
+	let admission_id = domain_hash(ADMISSION_DOMAIN, &statement_bytes);
+	let causal_profile = CausalRuntimeProfileScaleV2 {
+		profile_bytes,
+		profile_id,
+		bridge_runtime_code_sha256: H256::from(sha2_256(context.bridge_runtime_code)),
+		bridge_runtime_code_bytes: u32::try_from(context.bridge_runtime_code.len())
+			.expect("fixture bridge code length must fit u32"),
+		token_runtime_code_sha256: H256::from(sha2_256(context.token_runtime_code)),
+		token_runtime_code_bytes: u32::try_from(context.token_runtime_code.len())
+			.expect("fixture token code length must fit u32"),
+	};
+	let pending = PendingAdmissionScaleV2 {
+		profile_id,
+		source_intent_bytes,
+		statement_bytes,
+		admission_id,
+		admitted_at_native_height: 1_020,
+		proof_system_id: H256::repeat_byte(0x77),
+		proof_profile_id: H256::repeat_byte(0x88),
+	};
+	let consumed_v3 = consumed_bytes(
+		context,
+		admission_id,
+		source_intent_id,
+		record_key,
+		parent_hash,
+		parent_height
+			.checked_add(1)
+			.unwrap_or(record.sidechain_height),
+	);
+	CausalFixtureValues {
+		record_key,
+		runtime_profile_v1_scale: runtime_profile_v1.encode(),
+		causal_profile_scale: causal_profile.encode(),
+		pending_scale: pending.encode(),
+		consumed_v3,
+	}
+}
+
+fn profile_bytes(sidechain_id: H256, bridge_address: sp_core::H160) -> Vec<u8> {
+	let mut bytes = vec![2];
+	bytes.extend_from_slice(H256::repeat_byte(0xaa).as_bytes());
+	bytes.extend_from_slice(sidechain_id.as_bytes());
+	bytes.extend_from_slice(bridge_address.as_bytes());
+	bytes.extend_from_slice(sp_core::H160::repeat_byte(0x21).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xbb).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xcc).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xdd).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xee).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0x77).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0x88).as_bytes());
+	bytes.extend_from_slice(&3u64.to_be_bytes());
+	bytes.extend_from_slice(&1_000u64.to_be_bytes());
+	assert_eq!(bytes.len(), 313);
+	bytes
+}
+
+fn source_intent_bytes(context: &MintTransitionFixtureContext<'_>, profile_id: H256) -> Vec<u8> {
+	let record = context.record;
+	let mut bytes = vec![2];
+	bytes.extend_from_slice(H256::repeat_byte(0xaa).as_bytes());
+	bytes.extend_from_slice(record.sidechain_id.as_bytes());
+	bytes.extend_from_slice(record.bridge_address.as_bytes());
+	bytes.extend_from_slice(sp_core::H160::repeat_byte(0x21).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xbb).as_bytes());
+	bytes.extend_from_slice(profile_id.as_bytes());
+	bytes.extend_from_slice(H256::zero().as_bytes());
+	bytes.extend_from_slice(&record.amount.to_be_bytes());
+	bytes.extend_from_slice(record.recipient.as_bytes());
+	assert_eq!(bytes.len(), 229);
+	bytes
+}
+
+fn admission_statement_bytes(
+	context: &MintTransitionFixtureContext<'_>,
+	source_intent_id: H256,
+	record_key: H256,
+) -> Vec<u8> {
+	let record = context.record;
+	let mut bytes = vec![2];
+	bytes.extend_from_slice(source_intent_id.as_bytes());
+	bytes.extend_from_slice(record_key.as_bytes());
+	bytes.extend_from_slice(record.ergo_box_id.as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0x99).as_bytes());
+	bytes.extend_from_slice(&0u32.to_be_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xcc).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xa1).as_bytes());
+	bytes.extend_from_slice(&1u32.to_be_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xb1).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xdd).as_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xc1).as_bytes());
+	bytes.extend_from_slice(&1_010u64.to_be_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xc2).as_bytes());
+	bytes.extend_from_slice(&1_020u64.to_be_bytes());
+	bytes.extend_from_slice(H256::repeat_byte(0xee).as_bytes());
+	bytes.extend_from_slice(&10u32.to_be_bytes());
+	assert_eq!(bytes.len(), 381);
+	bytes
+}
+
+fn consumed_bytes(
+	context: &MintTransitionFixtureContext<'_>,
+	admission_id: H256,
+	source_intent_id: H256,
+	record_key: H256,
+	parent_hash: H256,
+	child_height: u64,
+) -> Vec<u8> {
+	let record = context.record;
+	let mut bytes = vec![3];
+	bytes.extend_from_slice(admission_id.as_bytes());
+	bytes.extend_from_slice(source_intent_id.as_bytes());
+	bytes.extend_from_slice(record_key.as_bytes());
+	bytes.extend_from_slice(parent_hash.as_bytes());
+	bytes.extend_from_slice(&child_height.to_be_bytes());
+	bytes.extend_from_slice(record.execution_block_hash.as_bytes());
+	bytes.extend_from_slice(&record.sidechain_height.to_be_bytes());
+	bytes.extend_from_slice(record.transaction_hash.as_bytes());
+	bytes.extend_from_slice(&1u32.to_be_bytes());
+	bytes.extend_from_slice(&record.event_index.to_be_bytes());
+	bytes.extend_from_slice(H256::from(blake2_256(&record.encode())).as_bytes());
+	assert_eq!(bytes.len(), 249);
+	bytes
+}
+
+fn statement(record_key: H256) -> CausalPegInMintTransitionStatementRequestV2 {
+	CausalPegInMintTransitionStatementRequestV2 {
+		schema: STATEMENT_SCHEMA.to_owned(),
+		record_key_hex: format_bytes(record_key.as_bytes()),
+		current_peg_in_profile_storage_key_hex: format_bytes(&derive_bridge_storage_value_key_v2(
+			CURRENT_PEG_IN_PROFILE,
+		)),
+		current_causal_profile_storage_key_hex: format_bytes(&derive_bridge_storage_value_key_v2(
+			CURRENT_CAUSAL_PROFILE,
+		)),
+		causal_enforcement_storage_key_hex: format_bytes(&derive_bridge_storage_value_key_v2(
+			CAUSAL_ENFORCEMENT,
+		)),
+		pending_keys_storage_key_hex: format_bytes(&derive_bridge_storage_value_key_v2(
+			PENDING_KEYS,
+		)),
+		pending_admission_storage_key_hex: format_bytes(&derive_bridge_storage_map_key_v2(
+			PENDING_ADMISSIONS,
+			record_key,
+		)),
+		processed_record_storage_key_hex: format_bytes(&derive_bridge_storage_map_key_v2(
+			PROCESSED_PEG_INS,
+			record_key,
+		)),
+		consumed_admission_storage_key_hex: format_bytes(&derive_bridge_storage_map_key_v2(
+			CONSUMED_ADMISSIONS,
+			record_key,
+		)),
+	}
+}
+
+fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+	let mut preimage = Vec::with_capacity(domain.len() + bytes.len());
+	preimage.extend_from_slice(domain);
+	preimage.extend_from_slice(bytes);
+	H256::from(blake2_256(&preimage))
+}

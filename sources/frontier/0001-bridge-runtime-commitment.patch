+	fn self_consistent_transaction_root_drift_witness() -> Vec<u8> {
+		let mut bytes = transaction_witness();
+		let ranges = transaction_witness_section_ranges(&bytes);
+		let transaction_start = ranges[1].0;
+		let proof_length_offset = transaction_start + 42;
+		let proof_offset = proof_length_offset + 4;
+		assert_eq!(&bytes[proof_length_offset..proof_offset], &[0, 0, 0, 0]);
+		bytes[proof_length_offset..proof_offset].copy_from_slice(&1u32.to_be_bytes());
+		bytes.insert(proof_offset, 0xaa);
+		bytes[56..60].copy_from_slice(&((ranges[1].1 - ranges[1].0 + 1) as u32).to_be_bytes());
+		let total_length = bytes.len() as u32;
+		bytes[12..16].copy_from_slice(&total_length.to_be_bytes());
+
+		let proof_digest = blake2_256(&[0xaa]);
+		let mut witness_leaf_preimage = Vec::with_capacity(32);
+		witness_leaf_preimage.push(0);
+		witness_leaf_preimage.extend_from_slice(&proof_digest[1..]);
+		let witness_leaf = blake2_256(&witness_leaf_preimage);
+		let updated_ranges = transaction_witness_section_ranges(&bytes);
+		assert_eq!(bytes[updated_ranges[2].0], 1);
+		bytes[updated_ranges[2].0 + 1..updated_ranges[2].0 + 33].copy_from_slice(&witness_leaf);
+		bytes
+	}

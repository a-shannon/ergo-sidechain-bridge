+/// Verify the exact bridge commitment key against one authenticated native state root.
+pub fn verify_bridge_commitment_state(
+	state_root: H256,
+	proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedBridgeCommitmentState, BridgeStateProofError> {
+	if proof_nodes.is_empty() {
+		return Err(BridgeStateProofError::EmptyProof);
+	}
+	if proof_nodes.len() > MAX_BRIDGE_COMMITMENT_PROOF_NODES {
+		return Err(BridgeStateProofError::TooManyNodes {
+			actual: proof_nodes.len(),
+			max: MAX_BRIDGE_COMMITMENT_PROOF_NODES,
+		});
+	}
+
+	let mut proof_bytes = 0usize;
+	for (index, node) in proof_nodes.iter().enumerate() {
+		if node.len() > MAX_BRIDGE_COMMITMENT_PROOF_NODE_BYTES {
+			return Err(BridgeStateProofError::NodeTooLarge {
+				index,
+				actual: node.len(),
+				max: MAX_BRIDGE_COMMITMENT_PROOF_NODE_BYTES,
+			});
+		}
+		proof_bytes =
+			proof_bytes
+				.checked_add(node.len())
+				.ok_or(BridgeStateProofError::ProofTooLarge {
+					actual: usize::MAX,
+					max: MAX_BRIDGE_COMMITMENT_PROOF_BYTES,
+				})?;
+		if proof_bytes > MAX_BRIDGE_COMMITMENT_PROOF_BYTES {
+			return Err(BridgeStateProofError::ProofTooLarge {
+				actual: proof_bytes,
+				max: MAX_BRIDGE_COMMITMENT_PROOF_BYTES,
+			});
+		}
+	}
+
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| BridgeStateProofError::DuplicateNodes)?;
+	let values = read_proof_check::<BlakeTwo256, _>(
+		state_root,
+		proof,
+		[BRIDGE_COMMITMENT_STORAGE_KEY.as_slice()],
+	)
+	.map_err(|_| BridgeStateProofError::InvalidProof)?;
+	let raw = values
+		.get(BRIDGE_COMMITMENT_STORAGE_KEY.as_slice())
+		.and_then(|value| value.as_ref())
+		.ok_or(BridgeStateProofError::CommitmentMissing)?;
+	if raw.len() != BRIDGE_EVENT_COMMITMENT_V1_SCALE_BYTES {
+		return Err(BridgeStateProofError::CommitmentLength {
+			actual: raw.len(),
+			expected: BRIDGE_EVENT_COMMITMENT_V1_SCALE_BYTES,
+		});
+	}
+	let commitment = BridgeEventCommitmentV1::decode_all(&mut &raw[..])
+		.map_err(|_| BridgeStateProofError::CommitmentDecode)?;
+	if commitment.format_version != 1 {
+		return Err(BridgeStateProofError::UnsupportedFormat(
+			commitment.format_version,
+		));
+	}
+	if !(1..=MAX_BRIDGE_BURNS_PER_BLOCK).contains(&commitment.burn_leaf_count) {
+		return Err(BridgeStateProofError::InvalidBurnCount(
+			commitment.burn_leaf_count,
+		));
+	}
+
+	Ok(VerifiedBridgeCommitmentState {
+		state_root,
+		storage_key: BRIDGE_COMMITMENT_STORAGE_KEY,
+		commitment,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+/// Verify one full requested header, its GRANDPA finality, and its exact bridge state value.
+///
+/// `expected_sidechain_id` is an independently trusted domain identifier, normally the native
+/// genesis hash. The supplied authority set and set ID must already be authenticated through the
+/// bridge authority-transition path. This function does not authenticate an Ergo `0x0401` anchor,
+/// prove on-chain acceptance, or close Gate 5.
+pub fn verify_finalized_bridge_commitment_state<Block>(
+	requested_header: Block::Header,
+	expected_sidechain_id: H256,
+	expected_set_id: SetId,
+	expected_authorities: &AuthorityList,
+	encoded_finality_proof: &[u8],
+	storage_proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedFinalizedBridgeCommitmentState<Block>, FinalizedBridgeStateProofError>
+where
+	Block: BlockT<Hash = H256>,
+	NumberFor<Block>: sc_consensus_grandpa::BlockNumberOps + CheckedAdd + Copy + TryInto<u64>,
+{
+	let requested_hash = requested_header.hash();
+	let requested_number = *requested_header.number();
+	let finality = verify_grandpa_finality_proof::<Block>(
+		requested_hash,
+		requested_number,
+		expected_set_id,
+		expected_authorities,
+		encoded_finality_proof,
+	)?;
+	let state =
+		verify_bridge_commitment_state(*requested_header.state_root(), storage_proof_nodes)?;
+	let requested_height = requested_number
+		.try_into()
+		.map_err(|_| BridgeStateProofError::HeightMismatch)?;
+	validate_commitment_domain(
+		&state.commitment,
+		expected_sidechain_id,
+		requested_height,
+		requested_hash,
+	)?;
+
+	Ok(VerifiedFinalizedBridgeCommitmentState {
+		requested_header,
+		finality,
+		state,
+	})
+}
+
+/// Verify generic native finality from one independently reviewed GRANDPA trust anchor.
+///
+/// This function verifies the same trust-anchor digest, linked authority transitions, contiguous
+/// checkpoint ancestry, and exact target finality used by the bridge commitment profiles. It does
+/// not read `LatestBridgeEventCommitment` or any other runtime storage key.
+pub fn verify_deployment_finality_checkpoint<Block>(
+	anchor: &GrandpaDeploymentTrustAnchor<Block>,
+	expected_trust_anchor_digest: H256,
+	requested_header: Block::Header,
+	linked_proofs: &[LinkedGrandpaAuthorityProofChunk<Block>],
+	checkpoint_tail_headers: &[Block::Header],
+	encoded_finality_proof: &[u8],
+) -> Result<VerifiedDeploymentFinalityCheckpoint<Block>, DeploymentFinalityCheckpointError>
+where
+	Block: BlockT<Hash = H256>,
+	NumberFor<Block>:
+		sc_consensus_grandpa::BlockNumberOps + Zero + CheckedAdd + Copy + TryInto<u64>,
+{
+	let checkpoint_number = anchor
+		.checkpoint_number
+		.try_into()
+		.map_err(|_| DeploymentCheckpointError::TrustAnchorNumberOverflow)?;
+	let trust_anchor_digest = derive_grandpa_trust_anchor_digest(
+		anchor.sidechain_id,
+		anchor.checkpoint_hash,
+		checkpoint_number,
+		anchor.set_id,
+		&anchor.authorities,
+	);
+	if trust_anchor_digest != expected_trust_anchor_digest {
+		return Err(DeploymentCheckpointError::TrustAnchorDigestMismatch.into());
+	}
+	if linked_proofs.len() > MAX_LINKED_GRANDPA_PROOF_CHUNKS {
+		return Err(DeploymentCheckpointError::TooManyLinkedProofChunks {
+			actual: linked_proofs.len(),
+			max: MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+		}
+		.into());
+	}
+
+	let mut proof_bytes = 0usize;
+	let mut current_hash = anchor.checkpoint_hash;
+	let mut current_number = anchor.checkpoint_number;
+	let mut current_set_id = anchor.set_id;
+	let mut current_authorities = anchor.authorities.clone();
+	let mut transition_count = 0usize;
+
+	for (chunk, linked) in linked_proofs.iter().enumerate() {
+		proof_bytes = proof_bytes.checked_add(linked.encoded_proof.len()).ok_or(
+			DeploymentCheckpointError::LinkedProofBytesTooLarge {
+				actual: usize::MAX,
+				max: MAX_LINKED_GRANDPA_PROOF_BYTES,
+			},
+		)?;
+		if proof_bytes > MAX_LINKED_GRANDPA_PROOF_BYTES {
+			return Err(DeploymentCheckpointError::LinkedProofBytesTooLarge {
+				actual: proof_bytes,
+				max: MAX_LINKED_GRANDPA_PROOF_BYTES,
+			}
+			.into());
+		}
+		let verified = verify_linked_grandpa_authority_transition_proof::<Block>(
+			current_set_id,
+			&current_authorities,
+			current_hash,
+			current_number,
+			&linked.ancestry_headers,
+			&linked.encoded_proof,
+		)
+		.map_err(|source| DeploymentCheckpointError::LinkedProof { chunk, source })?;
+		let is_final = chunk == linked_proofs.len() - 1;
+		if verified.complete && !is_final {
+			return Err(DeploymentCheckpointError::CompletionBeforeFinalChunk { chunk }.into());
+		}
+
+		transition_count = transition_count
+			.checked_add(verified.transition_count)
+			.expect("proof chunk and fragment limits prevent usize overflow; qed");
+		current_hash = verified.target_hash;
+		current_number = verified.target_number;
+		current_set_id = verified.current_set_id;
+		current_authorities = verified.current_authorities;
+	}
+
+	let requested_hash = requested_header.hash();
+	let requested_number = *requested_header.number();
+	let finality = verify_grandpa_finality_proof::<Block>(
+		requested_hash,
+		requested_number,
+		current_set_id,
+		&current_authorities,
+		encoded_finality_proof,
+	)?;
+	verify_requested_header_and_finality_ancestry::<Block>(
+		anchor,
+		&requested_header,
+		linked_proofs,
+		checkpoint_tail_headers,
+		&finality.proof.unknown_headers,
+	)?;
+	verify_checkpoint_tail::<Block>(
+		current_hash,
+		current_number,
+		checkpoint_tail_headers,
+		finality.target_hash,
+		finality.target_number,
+	)?;
+
+	Ok(VerifiedDeploymentFinalityCheckpoint {
+		trust_anchor_digest,
+		transition_count,
+		authenticated_set_id: current_set_id,
+		authenticated_authorities: current_authorities,
+		finality_horizon_hash: finality.target_hash,
+		finality_horizon_number: finality.target_number,
+		requested_header,
+		finality,
+	})
+}
+
+/// Verify a burn-bearing checkpoint from one independently reviewed GRANDPA trust anchor.
+///
+/// Each compact authority proof is augmented with the exact contiguous headers omitted by the
+/// warp format. The proof path authenticates only handoffs entering the target's authority set.
+/// A final checkpoint tail then joins the last handoff to the GRANDPA finality horizon without
+/// admitting an unproved intermediate authority change. Concatenating every linked ancestry and
+/// this tail yields one chain from the reviewed anchor through the requested header to the
+/// horizon. Its suffix after the requested header must equal the finality proof's
+/// `unknown_headers` byte-for-byte. This keeps historical targets provable after later rotations
+/// without letting the acquisition codec choose an authority set. The target commitment is
+/// recovered from its authenticated state root.
+pub fn verify_deployment_checkpoint<Block>(
+	anchor: &GrandpaDeploymentTrustAnchor<Block>,
+	expected_trust_anchor_digest: H256,
+	requested_header: Block::Header,
+	linked_proofs: &[LinkedGrandpaAuthorityProofChunk<Block>],
+	checkpoint_tail_headers: &[Block::Header],
+	encoded_finality_proof: &[u8],
+	storage_proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedDeploymentCheckpoint<Block>, DeploymentCheckpointError>
+where
+	Block: BlockT<Hash = H256>,
+	NumberFor<Block>:
+		sc_consensus_grandpa::BlockNumberOps + Zero + CheckedAdd + Copy + TryInto<u64>,
+{
+	let checkpoint_number = anchor
+		.checkpoint_number
+		.try_into()
+		.map_err(|_| DeploymentCheckpointError::TrustAnchorNumberOverflow)?;
+	let trust_anchor_digest = derive_grandpa_trust_anchor_digest(
+		anchor.sidechain_id,
+		anchor.checkpoint_hash,
+		checkpoint_number,
+		anchor.set_id,
+		&anchor.authorities,
+	);
+	if trust_anchor_digest != expected_trust_anchor_digest {
+		return Err(DeploymentCheckpointError::TrustAnchorDigestMismatch);
+	}
+	if linked_proofs.len() > MAX_LINKED_GRANDPA_PROOF_CHUNKS {
+		return Err(DeploymentCheckpointError::TooManyLinkedProofChunks {
+			actual: linked_proofs.len(),
+			max: MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+		});
+	}
+
+	let mut proof_bytes = 0usize;
+	let mut current_hash = anchor.checkpoint_hash;
+	let mut current_number = anchor.checkpoint_number;
+	let mut current_set_id = anchor.set_id;
+	let mut current_authorities = anchor.authorities.clone();
+	let mut transition_count = 0usize;
+
+	for (chunk, linked) in linked_proofs.iter().enumerate() {
+		proof_bytes = proof_bytes.checked_add(linked.encoded_proof.len()).ok_or(
+			DeploymentCheckpointError::LinkedProofBytesTooLarge {
+				actual: usize::MAX,
+				max: MAX_LINKED_GRANDPA_PROOF_BYTES,
+			},
+		)?;
+		if proof_bytes > MAX_LINKED_GRANDPA_PROOF_BYTES {
+			return Err(DeploymentCheckpointError::LinkedProofBytesTooLarge {
+				actual: proof_bytes,
+				max: MAX_LINKED_GRANDPA_PROOF_BYTES,
+			});
+		}
+		let verified = verify_linked_grandpa_authority_transition_proof::<Block>(
+			current_set_id,
+			&current_authorities,
+			current_hash,
+			current_number,
+			&linked.ancestry_headers,
+			&linked.encoded_proof,
+		)
+		.map_err(|source| DeploymentCheckpointError::LinkedProof { chunk, source })?;
+		let is_final = chunk == linked_proofs.len() - 1;
+		if verified.complete && !is_final {
+			return Err(DeploymentCheckpointError::CompletionBeforeFinalChunk { chunk });
+		}
+
+		transition_count = transition_count
+			.checked_add(verified.transition_count)
+			.expect("proof chunk and fragment limits prevent usize overflow; qed");
+		current_hash = verified.target_hash;
+		current_number = verified.target_number;
+		current_set_id = verified.current_set_id;
+		current_authorities = verified.current_authorities;
+	}
+
+	let finalized_state = verify_finalized_bridge_commitment_state::<Block>(
+		requested_header,
+		anchor.sidechain_id,
+		current_set_id,
+		&current_authorities,
+		encoded_finality_proof,
+		storage_proof_nodes,
+	)?;
+	verify_requested_header_and_finality_ancestry::<Block>(
+		anchor,
+		&finalized_state.requested_header,
+		linked_proofs,
+		checkpoint_tail_headers,
+		&finalized_state.finality.proof.unknown_headers,
+	)?;
+	verify_checkpoint_tail::<Block>(
+		current_hash,
+		current_number,
+		checkpoint_tail_headers,
+		finalized_state.finality.target_hash,
+		finalized_state.finality.target_number,
+	)?;
+	let finality_horizon_hash = finalized_state.finality.target_hash;
+	let finality_horizon_number = finalized_state.finality.target_number;
+
+	Ok(VerifiedDeploymentCheckpoint {
+		trust_anchor_digest,
+		transition_count,
+		authenticated_set_id: current_set_id,
+		authenticated_authorities: current_authorities,
+		finality_horizon_hash,
+		finality_horizon_number,
+		finalized_state,
+	})
+}

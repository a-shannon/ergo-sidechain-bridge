+	pub trusted_anchor_digest_hex: String,
+	/// Real trie membership case.
+	pub membership: PegInStateFixtureCase,
+	/// Real trie non-membership case under a separate finalized target.
+	pub non_membership: PegInStateFixtureCase,
+}
+
+/// Return the deterministic current profile used by both cases.
+pub fn deterministic_profile() -> PegInRuntimeProfileV1 {
+	PegInRuntimeProfileV1 {
+		format_version: 1,
+		sidechain_id: H256::repeat_byte(0x11),
+		bridge_address: H160::repeat_byte(0x22),
+		profile_revision: 4,
+		activation_height: 900,
+	}
+}
+
+/// Return the deterministic historical membership record.
+pub fn deterministic_record() -> PegInRuntimeRecordV1 {
+	PegInRuntimeRecordV1 {
+		format_version: 1,
+		sidechain_id: H256::repeat_byte(0x11),
+		bridge_address: H160::repeat_byte(0x33),
+		profile_revision: 2,
+		profile_activation_height: 700,
+		ergo_box_id: H256::repeat_byte(0x44),
+		recipient: H160::repeat_byte(0x55),
+		amount: 2_000_000,
+		sidechain_height: 800,
+		execution_block_hash: H256::repeat_byte(0x66),
+		transaction_hash: H256::repeat_byte(0x77),
+		event_index: 9,
+	}
+}
+
+/// Return the independently supplied deterministic trust-root digest.
+pub fn deterministic_trusted_anchor_digest_hex() -> String {
+	let (_, authorities) = authority_fixture();
+	format_hash(derive_grandpa_trust_anchor_digest(
+		deterministic_profile().sidechain_id,
+		anchor_hash(),
+		u64::from(ANCHOR_NUMBER),
+		SET_ID,
+		&authorities,
+	))
+}
+
+/// Build the deterministic real membership request.
+pub fn deterministic_membership_fixture_request() -> NativePegInStateRequest {
+	let profile = deterministic_profile();
+	let record = deterministic_record();
+	request_for(
+		&profile,
+		record.ergo_box_id,
+		Some(&record),
+		PegInRecordExpectationRequest::Membership {
+			expected_record_scale_hex: format_bytes(&record.encode()),
+		},
+		0x90,
+	)
+}
+
+/// Build the deterministic real non-membership request.
+pub fn deterministic_non_membership_fixture_request() -> NativePegInStateRequest {
+	let profile = deterministic_profile();
+	request_for(
+		&profile,
+		H256::repeat_byte(0x88),
+		None,
+		PegInRecordExpectationRequest::NonMembership,
+		0x91,
+	)
+}
+
+/// Build the checked-in fixture wrapper and digest-bound expected results.
+pub fn deterministic_fixture_vector() -> PegInStateFixtureVector {
+	let trusted_anchor_digest_hex = deterministic_trusted_anchor_digest_hex();
+	let membership_request = deterministic_membership_fixture_request();
+	let non_membership_request = deterministic_non_membership_fixture_request();
+	let membership_expected = verify_request_bytes(
+		&serde_json::to_vec(&membership_request)
+			.expect("membership request must serialize canonically"),
+		&trusted_anchor_digest_hex,
+	)
+	.expect("deterministic membership request must verify");
+	let non_membership_expected = verify_request_bytes(
+		&serde_json::to_vec(&non_membership_request)
+			.expect("non-membership request must serialize canonically"),
+		&trusted_anchor_digest_hex,
+	)
+	.expect("deterministic non-membership request must verify");
+	PegInStateFixtureVector {
+		schema: FIXTURE_VECTOR_SCHEMA.to_owned(),
+		trusted_anchor_digest_hex,
+		membership: PegInStateFixtureCase {
+			request: membership_request,
+			expected: membership_expected,
+		},
+		non_membership: PegInStateFixtureCase {
+			request: non_membership_request,
+			expected: non_membership_expected,
+		},
+	}
+}
+
+fn request_for(
+	profile: &PegInRuntimeProfileV1,
+	ergo_box_id: H256,
+	record: Option<&PegInRuntimeRecordV1>,
+	record_expectation: PegInRecordExpectationRequest,
+	extrinsics_root_byte: u8,
+) -> NativePegInStateRequest {
+	let record_key = derive_processed_peg_in_storage_key_v1(profile.sidechain_id, ergo_box_id);
+	let requires_current_profile = matches!(
+		&record_expectation,
+		PegInRecordExpectationRequest::NonMembership
+	);
+	let mut state = BTreeMap::new();
+	state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), RUNTIME_CODE.to_vec());
+	if requires_current_profile {
+		state.insert(
+			CURRENT_PEG_IN_PROFILE_STORAGE_KEY.to_vec(),
+			profile.encode(),
+		);
+	}
+	if let Some(record) = record {
+		state.insert(record_key.to_vec(), record.encode());
+	}
+	let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+	let state_root = *backend.root();
+	let requested_keys = if requires_current_profile {
+		vec![
+			RUNTIME_CODE_STORAGE_KEY.as_slice(),
+			CURRENT_PEG_IN_PROFILE_STORAGE_KEY.as_slice(),
+			record_key.as_slice(),
+		]
+	} else {
+		vec![RUNTIME_CODE_STORAGE_KEY.as_slice(), record_key.as_slice()]
+	};
+	let proof = prove_read(backend, requested_keys)
+		.expect("deterministic state must produce the statement-specific proof");
+	let proof_nodes = proof.into_iter_nodes().collect::<Vec<_>>();
+	let target = NativeHeader::new(
+		ANCHOR_NUMBER + 1,
+		H256::repeat_byte(extrinsics_root_byte),
+		state_root,
+		anchor_hash(),
+		Digest::default(),
+	);
+	let (pairs, authorities) = authority_fixture();
+	let finality_proof = signed_finality_proof(&target, &pairs);
+
+	NativePegInStateRequest {
+		schema: REQUEST_SCHEMA.to_owned(),
+		trust_anchor: TrustAnchorRequest {
+			sidechain_id_hex: format_hash(profile.sidechain_id),
+			checkpoint_hash_hex: format_hash(anchor_hash()),
+			checkpoint_number: u64::from(ANCHOR_NUMBER).to_string(),
+			grandpa_set_id: SET_ID.to_string(),
+			authority_list_scale_hex: format_bytes(&authorities.encode()),
+		},
+		target_native_block_hash_hex: format_hash(target.hash()),
+		target_header_scale_hex: format_bytes(&target.encode()),
+		linked_grandpa_proofs: Vec::<LinkedGrandpaProofRequest>::new(),
+		checkpoint_tail_headers_scale_hex: vec![format_bytes(&target.encode())],
+		finality_proof_scale_hex: format_bytes(&finality_proof),
+		statement: PegInStateStatementRequest {
+			schema: STATEMENT_SCHEMA.to_owned(),
+			runtime_code: RuntimeCodeStatementRequest {
+				storage_key_hex: format_bytes(&RUNTIME_CODE_STORAGE_KEY),
+				artifact_sha256_hex: format_bytes(&sha2_256(RUNTIME_CODE)),
+				artifact_size_bytes: RUNTIME_CODE.len().to_string(),
+				build_attestation_id: BUILD_ATTESTATION_ID.to_owned(),
+				build_attestation_sha256_hex: format_bytes(&BUILD_ATTESTATION_SHA256),
+			},
+			ergo_box_id_hex: format_hash(ergo_box_id),
+			expected_profile_scale_hex: requires_current_profile
+				.then(|| format_bytes(&profile.encode())),
+			record: record_expectation,
+		},
+		runtime_state_proof_nodes_hex: proof_nodes.iter().map(|node| format_bytes(node)).collect(),
+	}
+}
+
+fn anchor_hash() -> H256 {
+	H256::repeat_byte(0x10)
+}
+
+fn authority_fixture() -> (Vec<ed25519::Pair>, AuthorityList) {
+	let pairs = (1u8..=3)
+		.map(|seed| ed25519::Pair::from_seed(&[seed; 32]))
+		.collect::<Vec<_>>();
+	let authorities = pairs
+		.iter()
+		.map(|pair| (pair.public().into(), 1u64))
+		.collect();
+	(pairs, authorities)
+}
+
+fn signed_finality_proof(header: &NativeHeader, pairs: &[ed25519::Pair]) -> Vec<u8> {
+	let precommit = Precommit {
+		target_hash: header.hash(),
+		target_number: *header.number(),
+	};
+	let message = sp_consensus_grandpa::Message::<NativeHeader>::Precommit(precommit.clone());
+	let payload = sp_consensus_grandpa::localized_payload(ROUND, SET_ID, &message);
+	let precommits = pairs
+		.iter()
+		.map(|pair| SignedPrecommit {
+			precommit: precommit.clone(),
+			signature: pair.sign(&payload).into(),
+			id: pair.public().into(),
+		})
+		.collect();
+	let justification: GrandpaJustification<NativeBlock> =
+		sp_consensus_grandpa::GrandpaJustification::<NativeHeader> {
+			round: ROUND,
+			commit: Commit {
+				target_hash: header.hash(),
+				target_number: *header.number(),
+				precommits,
+			},
+			votes_ancestries: Vec::new(),
+		}
+		.into();
+	FinalityProof::<NativeHeader> {
+		block: header.hash(),
+		justification: justification.encode(),
+		unknown_headers: Vec::new(),
+	}
+	.encode()
+}

+			TARGET_HEIGHT,
+			&fixture.statement,
+			fixture.statement_id,
+			fixture.mint_identity,
+			H256::from(sha2_256(RUNTIME_CODE)),
+			RUNTIME_CODE.len(),
+			&fixture.keys,
+			proof,
+		)
+	}
+}

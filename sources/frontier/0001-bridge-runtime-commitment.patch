+	#[derive(Clone, Copy)]
+	enum Envelope {
+		Legacy,
+		Eip2930,
+		Eip1559,
+	}
+
+	fn transaction(seed: u8) -> TransactionV2 {
+		TransactionV2::Legacy(LegacyTransaction {
+			nonce: u64::from(seed).into(),
+			gas_price: 1_000_000_000u64.into(),
+			gas_limit: 100_000u64.into(),
+			action: TransactionAction::Call(H160::repeat_byte(0x22)),
+			value: U256::zero(),
+			input: vec![seed; 4],
+			signature: TransactionSignature::new(
+				27,
+				H256::repeat_byte(seed.max(1)),
+				H256::repeat_byte(seed.saturating_add(1).max(1)),
+			)
+			.expect("deterministic transaction signature must be canonical"),
+		})
+	}
+
+	fn typed_transaction(seed: u8, envelope: Envelope) -> TransactionV2 {
+		match envelope {
+			Envelope::Legacy => transaction(seed),
+			Envelope::Eip2930 => TransactionV2::EIP2930(EIP2930Transaction {
+				chain_id: 1337,
+				nonce: u64::from(seed).into(),
+				gas_price: 1_000_000_000u64.into(),
+				gas_limit: 100_000u64.into(),
+				action: TransactionAction::Call(H160::repeat_byte(0x22)),
+				value: U256::zero(),
+				input: vec![seed; 4],
+				access_list: Vec::new(),
+				odd_y_parity: false,
+				r: H256::repeat_byte(seed.max(1)),
+				s: H256::repeat_byte(seed.saturating_add(1).max(1)),
+			}),
+			Envelope::Eip1559 => TransactionV2::EIP1559(EIP1559Transaction {
+				chain_id: 1337,
+				nonce: u64::from(seed).into(),
+				max_priority_fee_per_gas: 1_000_000u64.into(),
+				max_fee_per_gas: 1_000_000_000u64.into(),
+				gas_limit: 100_000u64.into(),
+				action: TransactionAction::Call(H160::repeat_byte(0x22)),
+				value: U256::zero(),
+				input: vec![seed; 4],
+				access_list: Vec::new(),
+				odd_y_parity: false,
+				r: H256::repeat_byte(seed.max(1)),
+				s: H256::repeat_byte(seed.saturating_add(1).max(1)),
+			}),
+		}
+	}
+
+	fn unrelated_log() -> Log {
+		Log {
+			address: H160::repeat_byte(0x77),
+			topics: vec![H256::repeat_byte(0x88)],
+			data: vec![1, 2, 3],
+		}
+	}
+
+	fn peg_in_log(recipient: H160, amount: u64, ergo_box_id: H256) -> Log {
+		let mut recipient_topic = [0u8; 32];
+		recipient_topic[12..].copy_from_slice(recipient.as_bytes());
+		let mut data = vec![0u8; 64];
+		data[24..32].copy_from_slice(&amount.to_be_bytes());
+		data[32..].copy_from_slice(ergo_box_id.as_bytes());
+		Log {
+			address: H160::repeat_byte(0x22),
+			topics: vec![peg_in_topic(), H256::from(recipient_topic)],
+			data,
+		}
+	}
+
+	fn receipt(status_code: u8, used_gas: u64, logs: Vec<Log>) -> ReceiptV3 {
+		typed_receipt(Envelope::Legacy, status_code, used_gas, logs)
+	}
+
+	fn typed_receipt(
+		envelope: Envelope,
+		status_code: u8,
+		used_gas: u64,
+		logs: Vec<Log>,
+	) -> ReceiptV3 {
+		let data = EIP658ReceiptData {
+			status_code,
+			used_gas: used_gas.into(),
+			logs_bloom: logs_bloom(&logs),
+			logs,
+		};
+		match envelope {
+			Envelope::Legacy => ReceiptV3::Legacy(data),
+			Envelope::Eip2930 => ReceiptV3::EIP2930(data),
+			Envelope::Eip1559 => ReceiptV3::EIP1559(data),
+		}
+	}
+
+	fn receipt_data_mut(receipt: &mut ReceiptV3) -> &mut EIP658ReceiptData {
+		match receipt {
+			ReceiptV3::Legacy(data) | ReceiptV3::EIP2930(data) | ReceiptV3::EIP1559(data) => data,
+		}
+	}
+
+	fn status(transaction: &TransactionV2, index: u32, logs: Vec<Log>) -> TransactionStatus {
+		TransactionStatus {
+			transaction_hash: transaction.hash(),
+			transaction_index: index,
+			from: H160::repeat_byte(0x10),
+			to: Some(H160::repeat_byte(0x22)),
+			contract_address: None,
+			logs_bloom: logs_bloom(&logs),
+			logs,
+		}
+	}
+
+	fn fixture() -> Fixture {

+		let request = deterministic_fixture_request();
+		let anchor = deterministic_trusted_anchor_digest_hex();
+		let raw_request = serde_json::to_vec(&request).unwrap();
+		let verified = verify_request_bytes(&raw_request, &anchor).unwrap();
+
+		assert_eq!(deterministic_fixture_vector().expected, verified);
+		assert_eq!(verified.receipt_state.receipt_count, 2);

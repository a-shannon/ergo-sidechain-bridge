+const STATEMENT_PROFILE_DOMAIN_V2: &[u8] =
+	b"E2S_PEG_IN_ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_DERIVED_STATEMENT_PROFILE_V2";
+const BRANCH_POLICY_DOMAIN_V2: &[u8] = b"E2S_PEG_IN_ERGO_AUTOLYKOS_EIP37_SUPPLIED_BRANCH_POLICY_V2";
+const VERIFIER_PROFILE_DOMAIN_V2: &[u8] =
+	b"E2S_PEG_IN_ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_DERIVED_VERIFIER_V2";
+const STATEMENT_ID_DOMAIN_V2: &[u8] =
+	b"E2S_PEG_IN_ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_DERIVED_STATEMENT_ID_V2";
+const SUPPLIED_BRANCHES_DOMAIN_V2: &[u8] = b"E2S_PEG_IN_ERGO_AUTOLYKOS_SUPPLIED_BRANCHES_V2";

+		|| profile.lineage_profile_id == H256::zero()
+		|| profile.source_network_id == H256::zero()
+		|| profile.sidechain_id == H256::zero()
+		|| profile.bridge_address == H160::zero()
+		|| profile.token_address == H160::zero()
+		|| profile.bridge_address == profile.token_address
+		|| profile.bridge_runtime_code_sha256 == H256::zero()
+		|| profile.bridge_runtime_code_bytes == 0
+		|| profile.token_runtime_code_sha256 == H256::zero()
+		|| profile.token_runtime_code_bytes == 0
+		|| profile.settlement_profile_id == H256::zero()
+		|| profile.ergo_deposit_finality_policy_id == H256::zero()
+		|| profile.source_proof_system_id == H256::zero()
+		|| profile.source_proof_profile_id == H256::zero()
+		|| profile.max_pending_blocks == 0
+	{
+		return Err("pooled-reserve mint-reservation profile contains a zero or aliased field");
+	}
+	Ok(domain_hash(
+		RESERVATION_PROFILE_ID_DOMAIN_V4,
+		&profile.encode(),

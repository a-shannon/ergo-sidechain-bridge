+/// A strict outer request or composed event-verification failure.
+#[derive(Debug, Error)]
+pub enum NativeFrontierPegInEventRequestError {
+	/// Shared request byte, JSON, or hex parsing failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// Outer request schema did not match the V1 event contract.
+	#[error("unsupported finalized peg-in Frontier event request schema")]
+	Schema,
+	/// Receipt/status statement schema did not match V1.
+	#[error("unsupported peg-in Frontier event statement schema")]
+	StatementSchema,
+	/// The supplied receipt key is not `Ethereum::CurrentReceipts`.
+	#[error("current receipts storage key differs from Ethereum::CurrentReceipts")]
+	CurrentReceiptsStorageKey,
+	/// The supplied status key is not `Ethereum::CurrentTransactionStatuses`.
+	#[error("current transaction statuses storage key differs from Ethereum::CurrentTransactionStatuses")]
+	CurrentTransactionStatusesStorageKey,
+	/// Canonical serialization of the nested V1 request failed.
+	#[error("failed to serialize nested execution-identity request")]
+	NestedRequestSerialization(#[source] serde_json::Error),
+	/// The unchanged V1 execution-identity verifier rejected the nested request.
+	#[error(transparent)]
+	ExecutionIdentity(#[from] NativeFrontierExecutionIdentityRequestError),
+	/// Authenticated receipt, status, root, success, or event semantics failed.
+	#[error(transparent)]
+	Event(#[from] FrontierPegInEventProofError),
+}
+
+/// Verify one exact composed request entirely offline and without side effects.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<NativeFrontierPegInEventVerification, NativeFrontierPegInEventRequestError> {
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(NativeCheckpointRequestError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_REQUEST_BYTES,
+		}
+		.into());
+	}
+	let request: NativeFrontierPegInEventRequest =
+		serde_json::from_slice(raw_request).map_err(NativeCheckpointRequestError::Json)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativeFrontierPegInEventRequestError::Schema);
+	}
+	if request.statement.schema != STATEMENT_SCHEMA {
+		return Err(NativeFrontierPegInEventRequestError::StatementSchema);
+	}
+	let receipts_key = derive_ethereum_current_receipts_storage_key();
+	let supplied_receipts_key = parse_byte_hex(
+		"statement.currentReceiptsStorageKeyHex",
+		&request.statement.current_receipts_storage_key_hex,
+		receipts_key.len(),
+	)?;
+	if supplied_receipts_key != receipts_key {
+		return Err(NativeFrontierPegInEventRequestError::CurrentReceiptsStorageKey);
+	}
+	let statuses_key = derive_ethereum_current_transaction_statuses_storage_key();
+	let supplied_statuses_key = parse_byte_hex(
+		"statement.currentTransactionStatusesStorageKeyHex",
+		&request
+			.statement
+			.current_transaction_statuses_storage_key_hex,
+		statuses_key.len(),
+	)?;
+	if supplied_statuses_key != statuses_key {
+		return Err(NativeFrontierPegInEventRequestError::CurrentTransactionStatusesStorageKey);
+	}
+
+	let nested_request_bytes = serde_json::to_vec(&request.execution_identity_request)
+		.map_err(NativeFrontierPegInEventRequestError::NestedRequestSerialization)?;
+	let context =
+		verify_request_bytes_with_context(&nested_request_bytes, trusted_anchor_digest_hex)?;
+	let event = verify_frontier_peg_in_event_v1(&context.execution_state, &context.state_nodes)?;
+	let execution_identity = EmbeddedFrontierExecutionIdentityOutput::from(context.verification);
+	let trust_anchor_digest_hex = execution_identity.trust_anchor_digest_hex.clone();
+
+	Ok(NativeFrontierPegInEventVerification {
+		schema: VERIFICATION_SCHEMA.to_owned(),
+		status: VERIFICATION_STATUS.to_owned(),
+		request_digest_hex: format_hash(BlakeTwo256::hash(raw_request)),
+		trust_anchor_digest_hex,
+		execution_identity,
+		receipt_state: VerifiedFrontierReceiptStateOutput {
+			current_receipts_storage_key_hex: format_bytes(&event.current_receipts_storage_key),
+			current_receipts_scale_sha256_hex: format_bytes(&event.current_receipts_scale_sha256),
+			current_receipts_scale_bytes: event.current_receipts_scale_bytes.to_string(),
+			current_transaction_statuses_storage_key_hex: format_bytes(
+				&event.current_transaction_statuses_storage_key,
+			),
+			current_transaction_statuses_scale_sha256_hex: format_bytes(
+				&event.current_transaction_statuses_scale_sha256,
+			),
+			current_transaction_statuses_scale_bytes: event
+				.current_transaction_statuses_scale_bytes
+				.to_string(),
+			receipts_root_hex: format_hash(event.receipts_root),
+			receipt_count: event.receipt_count,
+			transaction_status_count: event.transaction_status_count,
+			proof_node_count: event.proof_node_count,
+			proof_bytes: event.proof_bytes,
+			verified: true,
+		},
+		event: VerifiedFrontierPegInEventOutput {
+			transaction_hash_hex: format_hash(event.transaction_hash),
+			transaction_index: event.transaction_index,
+			transaction_log_index: event.transaction_log_index,
+			global_event_index: event.global_event_index,
+			receipt_type: event.receipt_type.to_owned(),
+			receipt_status_code: 1,
+			bridge_address_hex: format_bytes(event.bridge_address.as_bytes()),
+			event_signature_topic_hex: format_hash(event.event_signature_topic),
+			recipient_hex: format_bytes(event.recipient.as_bytes()),
+			amount_nano_erg: event.amount.to_string(),
+			ergo_box_id_hex: format_hash(event.ergo_box_id),
+		},
+		boundary: VerificationBoundaryOutput {
+			sidechain_finality_verified: true,
+			execution_identity_verified: true,
+			receipt_state_proof_verified: true,
+			receipts_root_recomputed: true,
+			transaction_status_verified: true,
+			successful_receipt_verified: true,
+			deposit_event_semantics_verified: true,
+			evm_code_state_verified: false,
+			evm_storage_state_verified: false,
+			runtime_build_attestation_verified: false,
+			runtime_code_identity_verified: false,
+			committed_vault_transition_verified: false,
+			historical_mint_absence_verified: false,
+			mint_authorized: false,
+			transaction_mutation_enabled: false,
+			gate5_closed: false,
+			production_readiness_verified: false,
+		},
+	})
+}

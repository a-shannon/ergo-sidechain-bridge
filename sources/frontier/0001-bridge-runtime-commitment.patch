+}
+
+pub fn ergo_autolykos_committed_vault_runtime_proof_system_id_v2() -> H256 {
+	H256::from(blake2_256(PROOF_SYSTEM_DOMAIN_V2))
+}
+
+pub fn ergo_autolykos_committed_vault_runtime_statement_profile_id_v2() -> H256 {
+	H256::from(blake2_256(STATEMENT_PROFILE_DOMAIN_V2))
+}
+
+pub fn ergo_autolykos_supplied_branch_policy_id_v2() -> H256 {
+	H256::from(blake2_256(BRANCH_POLICY_DOMAIN_V2))
+}
+
+pub fn ergo_autolykos_committed_vault_runtime_verifier_profile_id_v2() -> H256 {
+	H256::from(blake2_256(VERIFIER_PROFILE_DOMAIN_V2))
+}
+
+pub fn derive_ergo_autolykos_committed_vault_runtime_statement_id_v2(
+	statement_bytes: &[u8],
+) -> Result<H256, &'static str> {
+	if statement_bytes.len() != ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_STATEMENT_BYTES_V2 {
+		return Err("runtime-derived statement V2 length is invalid");
+	}
+	let mut bytes = Vec::with_capacity(STATEMENT_ID_DOMAIN_V2.len() + statement_bytes.len());
+	bytes.extend_from_slice(STATEMENT_ID_DOMAIN_V2);
+	bytes.extend_from_slice(statement_bytes);
+	Ok(H256::from(blake2_256(&bytes)))
+}
+
+fn parse_ergo_autolykos_committed_vault_runtime_statement_v2(
+	statement: &[u8],
+) -> Result<ParsedErgoAutolykosCommittedVaultRuntimeStatementV2, &'static str> {
+	if statement.len() != ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_STATEMENT_BYTES_V2 {
+		return Err("runtime-derived statement V2 length is invalid");
+	}
+	if statement[0] != ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_STATEMENT_FORMAT_V2 {
+		return Err("runtime-derived statement V2 format is unsupported");
+	}
+	for (offset, expected) in [
+		(
+			PROOF_SYSTEM_OFFSET,
+			ergo_autolykos_committed_vault_runtime_proof_system_id_v2(),
+		),
+		(
+			STATEMENT_PROFILE_OFFSET,
+			ergo_autolykos_committed_vault_runtime_statement_profile_id_v2(),
+		),
+		(
+			BRANCH_POLICY_OFFSET,
+			ergo_autolykos_supplied_branch_policy_id_v2(),
+		),
+		(
+			VERIFIER_PROFILE_OFFSET,
+			ergo_autolykos_committed_vault_runtime_verifier_profile_id_v2(),
+		),
+		(
+			RELAY_FAMILY_OFFSET,
+			ergo_autolykos_v2_relay_runtime_witness_family_id_v1(),
+		),
+		(
+			TRANSACTION_FAMILY_OFFSET,
+			ergo_scorex_transaction_runtime_witness_family_id_v1(),
+		),
+		(
+			ROUTE_PROFILE_OFFSET,
+			ergo_committed_vault_route_profile_id_v1(),
+		),
+		(ASSET_PROFILE_OFFSET, ergo_native_erg_asset_profile_id_v1()),
+	] {
+		if h256_at(statement, offset) != expected {
+			return Err("runtime-derived statement V2 contains an unsupported static identity");
+		}
+	}
+	let branch_count = u16_at(statement, SUPPLIED_BRANCH_COUNT_OFFSET);
+	let checkpoint_height = u32_at(statement, CHECKPOINT_HEIGHT_OFFSET);
+	let target_height = u32_at(statement, TARGET_HEIGHT_OFFSET);
+	let selected_tip_height = u32_at(statement, SELECTED_TIP_HEIGHT_OFFSET);
+	let confirmations = u32_at(statement, CONFIRMATIONS_OFFSET);
+	let required_confirmations = u32_at(statement, REQUIRED_CONFIRMATIONS_OFFSET);
+	let transaction_index = u32_at(statement, TRANSACTION_INDEX_OFFSET);
+	let transaction_count = u32_at(statement, TRANSACTION_COUNT_OFFSET);
+	if branch_count == 0 || branch_count > MAX_BRANCHES_V2 {
+		return Err("runtime-derived statement V2 branch count is unsupported");
+	}
+	if checkpoint_height >= target_height || target_height > selected_tip_height {
+		return Err("runtime-derived statement V2 height ordering is invalid");
+	}
+	if !(2..=4).contains(&statement[TARGET_BLOCK_VERSION_OFFSET]) {
+		return Err("runtime-derived statement V2 block version is unsupported");
+	}
+	if required_confirmations == 0 || confirmations < required_confirmations {
+		return Err("runtime-derived statement V2 confirmation policy is unsatisfied");
+	}
+	if transaction_count == 0 || transaction_index >= transaction_count {
+		return Err("runtime-derived statement V2 transaction position is invalid");
+	}
+	let signed_length = u32_at(statement, SIGNED_TRANSACTION_LENGTH_OFFSET);
+	let source_length = u32_at(statement, SOURCE_BOX_LENGTH_OFFSET);
+	let header_length = u32_at(statement, TARGET_HEADER_LENGTH_OFFSET);
+	if signed_length == 0
+		|| signed_length > MAX_SIGNED_TRANSACTION_BYTES_V2
+		|| source_length == 0
+		|| source_length > MAX_SOURCE_BOX_BYTES_V2
+		|| header_length == 0
+		|| header_length > MAX_CANONICAL_HEADER_BYTES_V2
+	{
+		return Err("runtime-derived statement V2 byte length is outside its bound");
+	}
+	if u32_at(statement, SOURCE_INPUT_INDEX_OFFSET) >= 2
+		|| statement[SOURCE_REFERENCE_COUNT_OFFSET] != 1
+		|| u32_at(statement, VAULT_OUTPUT_INDEX_OFFSET) != 0
+		|| u16_at(statement, AUTHORITY_FLAGS_OFFSET) != 0
+	{
+		return Err("runtime-derived statement V2 transition or authority shape is unsupported");
+	}
+	let amount_nano_erg = u64_at(statement, AMOUNT_OFFSET);
+	if amount_nano_erg == 0 || amount_nano_erg > ERGO_LONG_MAX_V2 {
+		return Err("runtime-derived statement V2 amount is outside the positive Ergo Long range");
+	}
+	let mut recipient_h160 = [0u8; 20];
+	recipient_h160.copy_from_slice(&statement[RECIPIENT_OFFSET..RECIPIENT_OFFSET + 20]);
+	Ok(ParsedErgoAutolykosCommittedVaultRuntimeStatementV2 {
+		statement_id: derive_ergo_autolykos_committed_vault_runtime_statement_id_v2(statement)?,
+		relay_witness_id: h256_at(statement, RELAY_WITNESS_OFFSET),
+		transaction_witness_id: h256_at(statement, TRANSACTION_WITNESS_OFFSET),
+		target_header_id: h256_at(statement, TARGET_HEADER_OFFSET),
+		target_transactions_root: h256_at(statement, TARGET_TRANSACTIONS_ROOT_OFFSET),
+		transaction_id: h256_at(statement, TRANSACTION_ID_OFFSET),
+		source_box_id: h256_at(statement, SOURCE_BOX_ID_OFFSET),
+		vault_box_id: h256_at(statement, VAULT_BOX_ID_OFFSET),
+		amount_nano_erg,
+		recipient_h160,
+	})
+}
+
+pub fn compose_ergo_autolykos_committed_vault_runtime_statement_v2(
+	relay_witness_bytes: &[u8],
+	transaction_witness_bytes: &[u8],
+) -> Result<Vec<u8>, &'static str> {
+	let relay = verify_ergo_autolykos_v2_relay_runtime_witness_for_runtime_statement_v2(
+		relay_witness_bytes,
+	)?;
+	let transaction = verify_ergo_scorex_transaction_runtime_witness_v1::<
+		InitialErgoNativeCompatibilityParserProfileV1,
+	>(transaction_witness_bytes)?;
+	if relay.target_transactions_root != transaction.target_transactions_root {
+		return Err(
+			"relay and transaction runtime witnesses disagree on the target transactions root",
+		);
+	}
+	if relay.target_block_version != transaction.block_version {
+		return Err("relay and transaction runtime witnesses disagree on the target block version");
+	}
+	let mut statement =
+		Vec::with_capacity(ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_STATEMENT_BYTES_V2);
+	statement.push(ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_STATEMENT_FORMAT_V2);
+	for value in [
+		ergo_autolykos_committed_vault_runtime_proof_system_id_v2(),
+		ergo_autolykos_committed_vault_runtime_statement_profile_id_v2(),
+		ergo_autolykos_supplied_branch_policy_id_v2(),
+		ergo_autolykos_committed_vault_runtime_verifier_profile_id_v2(),
+		ergo_autolykos_v2_relay_runtime_witness_family_id_v1(),
+		relay.witness_id,
+		ergo_scorex_transaction_runtime_witness_family_id_v1(),
+		transaction.parser_profile_id,
+		transaction.witness_id,
+		relay.spv_profile_id,
+		relay.source_network_id,
+		relay.checkpoint_header_id,
+	] {
+		statement.extend_from_slice(value.as_bytes());
+	}
+	statement.extend_from_slice(&relay.checkpoint_height.to_be_bytes());
+	statement
+		.extend_from_slice(derive_supplied_branches_digest_v2(relay_witness_bytes)?.as_bytes());
+	statement.extend_from_slice(&relay.known_branch_count.to_be_bytes());
+	statement.extend_from_slice(relay.selected_tip_header_id.as_bytes());
+	statement.extend_from_slice(&relay.selected_tip_height.to_be_bytes());
+	statement.extend_from_slice(&relay.selected_cumulative_work.to_big_endian());
+	statement.extend_from_slice(relay.target_header_id.as_bytes());
+	statement.extend_from_slice(&relay.target_height.to_be_bytes());
+	statement.push(relay.target_block_version);
+	statement.extend_from_slice(relay.target_transactions_root.as_bytes());
+	statement.extend_from_slice(relay.target_canonical_header_sha256.as_bytes());
+	statement.extend_from_slice(&relay.target_canonical_header_length.to_be_bytes());
+	statement.extend_from_slice(&relay.confirmations.to_be_bytes());
+	statement.extend_from_slice(&relay.required_confirmations.to_be_bytes());
+	statement.extend_from_slice(&transaction.transaction_index.to_be_bytes());
+	statement.extend_from_slice(&transaction.transaction_count.to_be_bytes());
+	statement.extend_from_slice(transaction.transaction_id.as_bytes());
+	statement.extend_from_slice(transaction.signed_transaction_sha256.as_bytes());
+	statement.extend_from_slice(&transaction.signed_transaction_length.to_be_bytes());
+	statement.extend_from_slice(&transaction.transaction_witness_leaf_id);
+	statement.extend_from_slice(transaction.route_profile_id.as_bytes());
+	statement.extend_from_slice(transaction.asset_profile_id.as_bytes());
+	statement.extend_from_slice(transaction.source_box_id.as_bytes());
+	statement.extend_from_slice(&transaction.source_box_length.to_be_bytes());
+	statement.extend_from_slice(&transaction.source_input_index.to_be_bytes());
+	statement.push(transaction.source_reference_count);
+	statement.extend_from_slice(&transaction.amount_nano_erg.to_be_bytes());
+	statement.extend_from_slice(transaction.source_lock_ergo_tree_sha256.as_bytes());
+	statement.extend_from_slice(&transaction.recipient_h160);
+	statement.extend_from_slice(transaction.depositor_ergo_tree_sha256.as_bytes());
+	statement.extend_from_slice(transaction.vault_box_id.as_bytes());
+	statement.extend_from_slice(&transaction.vault_output_index.to_be_bytes());
+	statement.extend_from_slice(transaction.vault_ergo_tree_sha256.as_bytes());
+	statement.extend_from_slice(&0u16.to_be_bytes());
+	if statement.len() != ERGO_AUTOLYKOS_COMMITTED_VAULT_RUNTIME_STATEMENT_BYTES_V2 {
+		return Err("runtime-derived statement V2 composition length drifted");
+	}
+	parse_ergo_autolykos_committed_vault_runtime_statement_v2(&statement)?;
+	Ok(statement)
+}

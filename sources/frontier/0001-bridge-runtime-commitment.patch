+pub fn validate_ergo_autolykos_committed_vault_statement_v1(
+	statement: &[u8],
+) -> Result<ValidatedErgoAutolykosCommittedVaultSourceProofStatementV1, &'static str> {
+	if statement.len() != ERGO_AUTOLYKOS_COMMITTED_VAULT_SOURCE_PROOF_STATEMENT_BYTES_V1 {
+		return Err("Ergo Autolykos committed-vault statement length is invalid");
+	}
+	if statement[0] != ERGO_AUTOLYKOS_COMMITTED_VAULT_SOURCE_PROOF_FORMAT_V1 {
+		return Err("Ergo Autolykos committed-vault statement version is unsupported");
+	}
+	for (offset, expected, label) in [
+		(
+			PROOF_SYSTEM_OFFSET,
+			ergo_autolykos_committed_vault_proof_system_id_v1(),
+			"proof system",
+		),
+		(
+			PROOF_PROFILE_OFFSET,
+			ergo_autolykos_committed_vault_proof_profile_id_v1(),
+			"proof profile",
+		),
+		(
+			FINALITY_POLICY_OFFSET,
+			ergo_autolykos_committed_vault_finality_policy_id_v1(),
+			"finality policy",
+		),
+		(
+			VERIFIER_PROFILE_OFFSET,
+			ergo_autolykos_committed_vault_verifier_profile_id_v1(),
+			"verifier profile",
+		),
+		(
+			ROUTE_PROFILE_OFFSET,
+			ergo_committed_vault_route_profile_id_v1(),
+			"route profile",
+		),
+		(
+			ASSET_PROFILE_OFFSET,
+			ergo_native_erg_asset_profile_id_v1(),
+			"asset profile",
+		),
+	] {
+		if h256_at(statement, offset) != expected {
+			return Err(match label {
+				"proof system" => "Ergo Autolykos committed-vault proof-system ID is unsupported",
+				"proof profile" => "Ergo Autolykos committed-vault proof-profile ID is unsupported",
+				"finality policy" => {
+					"Ergo Autolykos committed-vault finality-policy ID is unsupported"
+				}
+				"verifier profile" => {
+					"Ergo Autolykos committed-vault verifier-profile ID is unsupported"
+				}
+				"route profile" => "Ergo Autolykos committed-vault route-profile ID is unsupported",
+				_ => "Ergo Autolykos committed-vault asset-profile ID is unsupported",
+			});
+		}
+	}
+	for offset in [
+		SOURCE_CANDIDATE_OFFSET,
+		COMMITTED_CANDIDATE_OFFSET,
+		SPV_PROFILE_OFFSET,
+		SOURCE_NETWORK_OFFSET,
+		CHECKPOINT_HEADER_OFFSET,
+		KNOWN_BRANCHES_DIGEST_OFFSET,
+		SELECTED_TIP_OFFSET,
+		SELECTED_CUMULATIVE_WORK_OFFSET,
+		TARGET_HEADER_OFFSET,
+		TARGET_TRANSACTIONS_ROOT_OFFSET,
+		TARGET_HEADER_SHA256_OFFSET,
+		WP01C_DIGEST_OFFSET,
+		TRANSACTION_ID_OFFSET,
+		TRANSACTION_SIGMA_DIGEST_OFFSET,
+		SOURCE_LOCK_SHA256_OFFSET,
+		VAULT_SHA256_OFFSET,
+		COMMITTED_TRANSACTION_ID_OFFSET,
+		COMMITTED_TRANSACTION_SIGMA_DIGEST_OFFSET,
+		TRANSACTION_SEMANTICS_DIGEST_OFFSET,
+		SOURCE_BOX_ID_OFFSET,
+		SOURCE_BOX_CONTENT_DIGEST_OFFSET,
+		VAULT_BOX_ID_OFFSET,
+		CURRENT_STATE_OBSERVATION_DIGEST_OFFSET,
+		DEPOSITOR_TREE_SHA256_OFFSET,
+	] {
+		if is_zero(&statement[offset..offset + 32]) {
+			return Err("Ergo Autolykos committed-vault statement contains a zero identity");
+		}
+	}
+
+	let checkpoint_height = u32_at(statement, CHECKPOINT_HEIGHT_OFFSET);
+	let selected_tip_height = u32_at(statement, SELECTED_TIP_HEIGHT_OFFSET);
+	let target_height = u32_at(statement, TARGET_HEIGHT_OFFSET);
+	if checkpoint_height >= target_height || target_height > selected_tip_height {
+		return Err("Ergo Autolykos committed-vault statement header heights are invalid");
+	}
+	let known_branch_count = u16_at(statement, KNOWN_BRANCH_COUNT_OFFSET);
+	if known_branch_count == 0 || known_branch_count > MAX_KNOWN_BRANCHES_V1 {
+		return Err("Ergo Autolykos committed-vault known-branch count is invalid");
+	}
+	let block_version = statement[TARGET_BLOCK_VERSION_OFFSET];
+	if !(2..=4).contains(&block_version) {
+		return Err("Ergo Autolykos committed-vault target block version is unsupported");
+	}
+	let target_header_length = u32_at(statement, TARGET_HEADER_LENGTH_OFFSET);
+	if target_header_length == 0 || target_header_length > MAX_CANONICAL_HEADER_BYTES_V1 {
+		return Err("Ergo Autolykos committed-vault canonical header length is invalid");
+	}
+	let confirmations = u32_at(statement, CONFIRMATIONS_OFFSET);
+	let required_confirmations = u32_at(statement, REQUIRED_CONFIRMATIONS_OFFSET);
+	if required_confirmations == 0 || confirmations < required_confirmations {
+		return Err("Ergo Autolykos committed-vault confirmation policy is unsatisfied");
+	}
+	let transaction_index = u32_at(statement, TRANSACTION_INDEX_OFFSET);
+	let transaction_count = u32_at(statement, TRANSACTION_COUNT_OFFSET);
+	if transaction_count == 0 || transaction_index >= transaction_count {
+		return Err("Ergo Autolykos committed-vault transaction position is invalid");
+	}
+	if statement[TRANSACTION_ID_OFFSET..TRANSACTION_ID_OFFSET + 32]
+		!= statement[COMMITTED_TRANSACTION_ID_OFFSET..COMMITTED_TRANSACTION_ID_OFFSET + 32]
+		|| statement[TRANSACTION_SIGMA_DIGEST_OFFSET..TRANSACTION_SIGMA_DIGEST_OFFSET + 32]
+			!= statement[COMMITTED_TRANSACTION_SIGMA_DIGEST_OFFSET
+				..COMMITTED_TRANSACTION_SIGMA_DIGEST_OFFSET + 32]
+	{
+		return Err("Ergo Autolykos committed-vault transaction identities disagree");
+	}
+	let _source_input_index = u32_at(statement, SOURCE_INPUT_INDEX_OFFSET);
+	if statement[SOURCE_INPUT_COUNT_OFFSET] != 1
+		|| u32_at(statement, VAULT_OUTPUT_INDEX_OFFSET) != 0
+	{
+		return Err("Ergo Autolykos committed-vault transition shape is unsupported");
+	}
+	if !is_zero(&statement[ASSET_ID_OFFSET..ASSET_ID_OFFSET + 32]) {
+		return Err("Ergo Autolykos committed-vault statement supports only native ERG");
+	}
+	let amount_nano_erg = u64_at(statement, AMOUNT_OFFSET);
+	if amount_nano_erg == 0 || amount_nano_erg > ERGO_LONG_MAX {
+		return Err(
+			"Ergo Autolykos committed-vault amount is outside the positive Ergo Long range",
+		);
+	}
+	let mut recipient_h160 = [0u8; 20];
+	recipient_h160.copy_from_slice(&statement[RECIPIENT_OFFSET..RECIPIENT_OFFSET + 20]);
+
+	Ok(ValidatedErgoAutolykosCommittedVaultSourceProofStatementV1 {
+		statement_id: derive_ergo_autolykos_committed_vault_statement_id_v1(statement)?,
+		source_consensus_candidate_digest: h256_at(statement, SOURCE_CANDIDATE_OFFSET),
+		committed_vault_candidate_digest: h256_at(statement, COMMITTED_CANDIDATE_OFFSET),
+		spv_profile_id: h256_at(statement, SPV_PROFILE_OFFSET),
+		source_network_id: h256_at(statement, SOURCE_NETWORK_OFFSET),
+		checkpoint_header_id: h256_at(statement, CHECKPOINT_HEADER_OFFSET),
+		checkpoint_height,
+		known_branches_digest: h256_at(statement, KNOWN_BRANCHES_DIGEST_OFFSET),
+		known_branch_count,
+		selected_tip_header_id: h256_at(statement, SELECTED_TIP_OFFSET),
+		selected_tip_height,
+		selected_cumulative_work: statement
+			[SELECTED_CUMULATIVE_WORK_OFFSET..SELECTED_CUMULATIVE_WORK_OFFSET + 32]
+			.try_into()
+			.expect("bounded statement slice"),
+		target_header_id: h256_at(statement, TARGET_HEADER_OFFSET),
+		target_height,
+		target_block_version: block_version,
+		target_transactions_root: h256_at(statement, TARGET_TRANSACTIONS_ROOT_OFFSET),
+		target_canonical_header_sha256: h256_at(statement, TARGET_HEADER_SHA256_OFFSET),
+		target_canonical_header_length: target_header_length,
+		confirmations,
+		required_confirmations,
+		transaction_id: h256_at(statement, TRANSACTION_ID_OFFSET),
+		source_box_id: h256_at(statement, SOURCE_BOX_ID_OFFSET),
+		vault_box_id: h256_at(statement, VAULT_BOX_ID_OFFSET),
+		amount_nano_erg,
+		recipient_h160,
+	})
+}

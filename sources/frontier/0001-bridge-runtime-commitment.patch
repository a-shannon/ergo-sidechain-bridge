+pub fn derive_federated_pooled_reserve_source_proof_profile_id_v1(
+	profile: &FederatedPooledReserveSourceProofProfileV1,
+) -> Result<H256, &'static str> {
+	let key_set_digest = derive_federated_pooled_reserve_source_key_set_digest_v1(profile)?;
+	let mut encoded = Vec::with_capacity(1 + 8 + 32 + 2 + 8 + 32);
+	encoded.push(profile.format_version);
+	encoded.extend_from_slice(&profile.federation_epoch.to_be_bytes());
+	encoded.extend_from_slice(key_set_digest.as_bytes());
+	encoded.extend_from_slice(&profile.threshold.to_be_bytes());
+	encoded.extend_from_slice(&profile.max_validity_blocks.to_be_bytes());
+	encoded.extend_from_slice(profile.verifier_profile_id.as_bytes());
+	Ok(domain_hash(FEDERATED_PROOF_PROFILE_DOMAIN_V1, &encoded))
+}

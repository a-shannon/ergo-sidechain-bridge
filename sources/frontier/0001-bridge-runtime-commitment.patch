+pub use pallet::*;
+
+impl<T: Config> Pallet<T> {
+	fn activate_causal_peg_in_profile(
+		profile: Option<CausalPegInRuntimeProfileV2>,
+	) -> DispatchResult {
+		ensure!(
+			!pooled_reserve_mint_reservation_mode_active::<T>(),
+			Error::<T>::PooledReserveMintReservationLegacyPegInModeConflict
+		);
+		if profile.is_some() {
+			ensure_causal_peg_in_source_proof_profile_execution_allowed::<T>()
+				.map_err(|_| Error::<T>::CausalPegInSourceProofProfileActivationBlocked)?;
+		}
+		ensure!(
+			!CausalPegInEnforcementActivatedV2::<T>::get()
+				&& CurrentCausalPegInProfileV2::<T>::get().is_none(),
+			Error::<T>::CausalPegInProfileFrozen
+		);
+		match profile {
+			Some(profile) => {
+				let source_proof_profile = T::CausalPegInSourceProofProfile::profile();
+				validate_federated_source_proof_profile_v1(&source_proof_profile)
+					.map_err(|_| Error::<T>::InvalidCausalPegInProfile)?;
+				let source_proof_profile_id =
+					derive_federated_source_proof_profile_id_v1(&source_proof_profile)
+						.map_err(|_| Error::<T>::InvalidCausalPegInProfile)?;
+				let decoded = decode_admission_profile_v2(&profile.profile_bytes)
+					.map_err(|_| Error::<T>::InvalidCausalPegInProfile)?;
+				let profile_id = derive_profile_id_v2(&profile.profile_bytes)
+					.map_err(|_| Error::<T>::InvalidCausalPegInProfile)?;
+				ensure!(
+					profile_id == profile.profile_id,
+					Error::<T>::InvalidCausalPegInProfile
+				);
+				ensure!(
+					decoded.proof_system_id == federated_source_proof_system_id_v1()
+						&& decoded.proof_profile_id == source_proof_profile_id
+						&& decoded.finality_policy_id == source_proof_profile.finality_policy_id,
+					Error::<T>::InvalidCausalPegInProfile
+				);
+				let current_height =
+					frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+				let runtime_profile =
+					CurrentPegInProfile::<T>::get().ok_or(Error::<T>::InvalidCausalPegInProfile)?;
+				ensure!(
+					decoded.activation_height == current_height
+						&& decoded.sidechain_id == runtime_profile.sidechain_id
+						&& decoded.bridge_address == runtime_profile.bridge_address
+						&& runtime_profile.activation_height <= current_height
+						&& validate_runtime_code_expectation::<T>(
+							decoded.bridge_address,
+							profile.bridge_runtime_code_sha256,
+							profile.bridge_runtime_code_bytes,
+						) && validate_runtime_code_expectation::<T>(
+						decoded.token_address,
+						profile.token_runtime_code_sha256,
+						profile.token_runtime_code_bytes,
+					),
+					Error::<T>::InvalidCausalPegInProfile
+				);
+				ensure!(
+					PendingCausalPegInKeys::<T>::get().is_empty()
+						&& PendingCausalPegInsV2::<T>::iter_keys().next().is_none()
+						&& CausalPegInAdmissionReceiptsV1::<T>::iter_keys()
+							.next()
+							.is_none(),
+					Error::<T>::CausalPegInProfileHasPendingAdmissions
+				);
+				CurrentCausalPegInProfileV2::<T>::put(&profile);
+				CausalPegInEnforcementActivatedV2::<T>::put(true);
+				pallet_sudo::Pallet::<T>::remove_key(frame_system::RawOrigin::Root.into())
+					.map_err(|error| error.error)?;
+				Self::deposit_event(Event::CausalPegInProfileActivated {
+					profile_id: profile.profile_id,
+					bridge_address: decoded.bridge_address,
+					token_address: decoded.token_address,
+					activation_height: decoded.activation_height,
+				});
+			}
+			None => {}
+		}
+		Ok(())
+	}
+
+	fn activate_pooled_reserve_mint_reservation_profile(
+		profile: PooledReserveMintReservationRuntimeProfileV4,
+	) -> DispatchResult {
+		ensure_pooled_reserve_mint_reservation_profile_execution_allowed::<T>()
+			.map_err(|_| Error::<T>::PooledReserveMintReservationProfileActivationBlocked)?;
+		ensure!(
+			!PooledReserveMintReservationEnforcementActivatedV4::<T>::get()
+				&& CurrentPooledReserveMintReservationProfileV4::<T>::get().is_none(),
+			Error::<T>::PooledReserveMintReservationProfileFrozen
+		);
+		ensure!(
+			!CausalPegInEnforcementActivatedV2::<T>::get()
+				&& CurrentCausalPegInProfileV2::<T>::get().is_none()
+				&& PendingCausalPegInKeys::<T>::get().is_empty()
+				&& PendingCausalPegInsV2::<T>::iter_keys().next().is_none()
+				&& CausalPegInAdmissionReceiptsV1::<T>::iter_keys()
+					.next()
+					.is_none(),
+			Error::<T>::PooledReserveMintReservationLegacyPegInModeConflict
+		);
+		let current_height = frame_system::Pallet::<T>::block_number().saturated_into::<u64>();
+		let profile_id = validate_pooled_reserve_mint_reservation_runtime_profile_v4::<T>(
+			&profile,
+			current_height,
+		)
+		.map_err(|_| Error::<T>::InvalidPooledReserveMintReservationProfile)?;
+		ensure!(
+			profile.activation_height == current_height
+				&& BridgeAddress::<T>::get() == Some(profile.bridge_address)
+				&& validate_runtime_code_expectation::<T>(
+					profile.bridge_address,
+					profile.bridge_runtime_code_sha256,
+					profile.bridge_runtime_code_bytes,
+				) && validate_runtime_code_expectation::<T>(
+				profile.token_address,
+				profile.token_runtime_code_sha256,
+				profile.token_runtime_code_bytes,
+			),
+			Error::<T>::InvalidPooledReserveMintReservationProfile
+		);
+		ensure!(
+			PendingPooledReserveMintReservationKeysV4::<T>::get().is_empty()
+				&& PendingPooledReserveMintReservationsV4::<T>::iter_keys()
+					.next()
+					.is_none() && ConsumedPooledReserveMintReservationsV4::<T>::iter_keys()
+				.next()
+				.is_none() && InvalidatedPooledReserveMintReservationsV4::<T>::iter_keys()
+				.next()
+				.is_none(),
+			Error::<T>::PooledReserveMintReservationProfileFrozen
+		);
+
+		pallet_sudo::Pallet::<T>::remove_key(frame_system::RawOrigin::Root.into())
+			.map_err(|error| error.error)?;
+		CurrentPooledReserveMintReservationProfileV4::<T>::put(&profile);
+		PooledReserveMintReservationEnforcementActivatedV4::<T>::put(true);
+		Self::deposit_event(Event::PooledReserveMintReservationProfileActivatedV4 {
+			profile_id,
+			lineage_profile_id: profile.lineage_profile_id,
+			activation_height: profile.activation_height,
+			proof_system_id: profile.source_proof_system_id,
+			proof_profile_id: profile.source_proof_profile_id,
+		});
+		Ok(())
+	}

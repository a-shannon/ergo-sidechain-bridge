+fn statement() -> Vec<u8> {
+	let lineage = H256::repeat_byte(0x10);
+	let source_lock_box_id = H256::repeat_byte(0x20);
+	let deposit_commitment = H256::repeat_byte(0x21);
+	let mint_identity = derive_mint_identity(lineage, source_lock_box_id, deposit_commitment);
+	let mut statement = vec![0u8; 603];
+	statement[0] = 4;
+	statement[1..33].copy_from_slice(lineage.as_bytes());
+	let source_intent = &mut statement[33..262];
+	source_intent[0] = 2;
+	source_intent[1..33].fill(0x11);
+	source_intent[33..65].fill(0x12);
+	source_intent[65..85].fill(0x13);
+	source_intent[85..105].fill(0x14);
+	source_intent[105..137].fill(0x15);
+	source_intent[137..169].copy_from_slice(lineage.as_bytes());
+	source_intent[169..201].fill(0);
+	source_intent[201..209].copy_from_slice(&1_000_000u64.to_be_bytes());
+	source_intent[209..229].fill(0x16);
+	let source_intent_id = domain_hash(SOURCE_INTENT_ID_DOMAIN, source_intent);
+	statement[262..294].copy_from_slice(source_intent_id.as_bytes());
+	statement[294..326].copy_from_slice(mint_identity.as_bytes());
+	statement[326..358].copy_from_slice(source_lock_box_id.as_bytes());
+	statement[358..390].fill(0x22);
+	statement[390..422].copy_from_slice(deposit_commitment.as_bytes());
+	statement[422..454].fill(0x23);
+	statement[454..487].fill(0x24);
+	statement[487..495].copy_from_slice(&2_000_000u64.to_be_bytes());
+	statement[495..527].fill(0x25);
+	statement[527..559].fill(0x26);
+	statement[559..563].copy_from_slice(&1_000u32.to_be_bytes());
+	statement[563..595].fill(0x27);
+	statement[595..599].copy_from_slice(&1_010u32.to_be_bytes());
+	statement[599..603].copy_from_slice(&10u32.to_be_bytes());
+	statement
+}
+
+fn pending(
+	statement: &[u8],
+	statement_id: H256,
+	mint_identity: H256,
+	profile: &PooledReserveMintReservationRuntimeProfileV4,

+		assert_eq!(record.recipient, recipient);
+		assert_eq!(record.amount, 2_000_000);
+		assert_eq!(record.sidechain_height, 1_024);
+		assert_eq!(record.execution_block_hash, execution_block_hash);
+		assert_eq!(record.transaction_hash, H256::repeat_byte(0x31));

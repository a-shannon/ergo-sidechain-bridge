+/// Build the unchanged T20C request over a larger authenticated state surface.
+pub(crate) fn deterministic_fixture_request_with_state_extensions<Parent, Post>(
+	parent_extension: Parent,
+	post_extension: Post,
+) -> NativeFrontierPegInMintTransitionRequest
+where
+	Parent: FnOnce(&MintTransitionFixtureContext<'_>) -> MintTransitionFixtureStateExtension,
+	Post:
+		FnOnce(&MintTransitionFixtureContext<'_>, H256, u64) -> MintTransitionFixtureStateExtension,
+{
+	build_fixture_request_with_state_extensions(
+		FixtureMutationForBuild::None,
+		parent_extension,
+		post_extension,
+	)
+}
+
+#[cfg(test)]
+pub(crate) fn deterministic_fixture_request_with_mutation(
+	mutation: FixtureMutation,
+) -> NativeFrontierPegInMintTransitionRequest {
+	if matches!(
+		mutation,
+		FixtureMutation::ParentHeightChanged | FixtureMutation::ParentStateRootChanged
+	) {
+		let mut request = build_fixture_request(FixtureMutationForBuild::None);
+		let parent_header_bytes = hex::decode(
+			request
+				.parent_header_scale_hex
+				.strip_prefix("0x")
+				.expect("fixture parent header must be 0x-prefixed"),
+		)
+		.expect("fixture parent header must be hex");
+		let parent_header = NativeHeader::decode_all(&mut &parent_header_bytes[..])
+			.expect("fixture parent header must decode canonically");
+		let changed_header = NativeHeader::new(
+			if mutation == FixtureMutation::ParentHeightChanged {
+				TARGET_NUMBER - 1
+			} else {
+				TARGET_NUMBER
+			},
+			*parent_header.extrinsics_root(),
+			if mutation == FixtureMutation::ParentStateRootChanged {
+				H256::repeat_byte(0x81)
+			} else {
+				*parent_header.state_root()
+			},
+			*parent_header.parent_hash(),
+			parent_header.digest().clone(),
+		);
+		request.parent_header_scale_hex = format_bytes(&changed_header.encode());
+		return request;
+	}
+	build_fixture_request(match mutation {
+		FixtureMutation::None => FixtureMutationForBuild::None,
+		FixtureMutation::ParentNativeRecordPresent => {
+			FixtureMutationForBuild::ParentNativeRecordPresent
+		}
+		FixtureMutation::ParentReplayTrue => FixtureMutationForBuild::ParentReplayTrue,
+		FixtureMutation::ParentHeightChanged | FixtureMutation::ParentStateRootChanged => {
+			unreachable!("header-only mutations return before fixture construction")
+		}
+		FixtureMutation::ParentRuntimeCodeChanged => {
+			FixtureMutationForBuild::ParentRuntimeCodeChanged
+		}
+		FixtureMutation::ParentBridgeCodeChanged => {
+			FixtureMutationForBuild::ParentBridgeCodeChanged
+		}
+		FixtureMutation::ParentTokenCodeChanged => FixtureMutationForBuild::ParentTokenCodeChanged,
+		FixtureMutation::ParentBridgeOwnerChanged => {
+			FixtureMutationForBuild::ParentBridgeOwnerChanged
+		}
+		FixtureMutation::ParentConfiguredTokenChanged => {
+			FixtureMutationForBuild::ParentConfiguredTokenChanged
+		}
+		FixtureMutation::ParentTokenOwnerChanged => {
+			FixtureMutationForBuild::ParentTokenOwnerChanged
+		}
+		FixtureMutation::ParentPaused => FixtureMutationForBuild::ParentPaused,
+		FixtureMutation::PostPaused => FixtureMutationForBuild::PostPaused,
+		FixtureMutation::BridgePaused => FixtureMutationForBuild::BridgePaused,
+		FixtureMutation::SupplyDeltaWrong => FixtureMutationForBuild::SupplyDeltaWrong,
+		FixtureMutation::SupplyUnderflow => FixtureMutationForBuild::SupplyUnderflow,
+		FixtureMutation::RecipientBalanceDeltaWrong => {
+			FixtureMutationForBuild::RecipientBalanceDeltaWrong
+		}
+		FixtureMutation::RecipientBalanceUnderflow => {
+			FixtureMutationForBuild::RecipientBalanceUnderflow
+		}
+		FixtureMutation::MissingMintLog => FixtureMutationForBuild::MissingMintLog,
+		FixtureMutation::WrongMintAmount => FixtureMutationForBuild::WrongMintAmount,
+		FixtureMutation::MintAfterPegIn => FixtureMutationForBuild::MintAfterPegIn,
+		FixtureMutation::AdditionalMint => FixtureMutationForBuild::AdditionalMint,
+		FixtureMutation::AdditionalBurn => FixtureMutationForBuild::AdditionalBurn,
+		FixtureMutation::AdditionalRecipientTransfer => {
+			FixtureMutationForBuild::AdditionalRecipientTransfer
+		}
+	})
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum FixtureMutationForBuild {
+	None,
+	ParentNativeRecordPresent,
+	ParentReplayTrue,
+	ParentRuntimeCodeChanged,
+	ParentBridgeCodeChanged,
+	ParentTokenCodeChanged,
+	ParentBridgeOwnerChanged,
+	ParentConfiguredTokenChanged,
+	ParentTokenOwnerChanged,
+	ParentPaused,
+	PostPaused,
+	BridgePaused,
+	SupplyDeltaWrong,
+	SupplyUnderflow,
+	RecipientBalanceDeltaWrong,
+	RecipientBalanceUnderflow,
+	MissingMintLog,
+	WrongMintAmount,
+	MintAfterPegIn,
+	AdditionalMint,
+	AdditionalBurn,
+	AdditionalRecipientTransfer,
+}
+
+fn build_fixture_request(
+	mutation: FixtureMutationForBuild,
+) -> NativeFrontierPegInMintTransitionRequest {
+	build_fixture_request_with_state_extensions(
+		mutation,
+		|_| MintTransitionFixtureStateExtension::default(),
+		|_, _, _| MintTransitionFixtureStateExtension::default(),
+	)
+}
+
+fn build_fixture_request_with_state_extensions<Parent, Post>(
+	mutation: FixtureMutationForBuild,
+	parent_extension: Parent,
+	post_extension: Post,
+) -> NativeFrontierPegInMintTransitionRequest
+where
+	Parent: FnOnce(&MintTransitionFixtureContext<'_>) -> MintTransitionFixtureStateExtension,
+	Post:
+		FnOnce(&MintTransitionFixtureContext<'_>, H256, u64) -> MintTransitionFixtureStateExtension,
+{
+	let bridge = H160::repeat_byte(0x22);
+	let token = H160::repeat_byte(0x21);
+	let bridge_runtime_code = bridge_runtime_code();
+	let token_runtime_code = token_runtime_code();
+	let bridge_owner = H160::repeat_byte(0x33);
+	let recipient = H160::repeat_byte(0x55);
+	let ergo_box_id = H256::repeat_byte(0x44);
+	let first_transaction = transaction(1);
+	let target_transaction = transaction(2);
+	let first_logs = vec![Log {
+		address: H160::repeat_byte(0x77),
+		topics: vec![H256::repeat_byte(0x88)],
+		data: vec![1, 2, 3],
+	}];
+	let mint_log = if mutation != FixtureMutationForBuild::MissingMintLog {
+		let mint_amount = if mutation == FixtureMutationForBuild::WrongMintAmount {
+			AMOUNT + 1
+		} else {
+			AMOUNT
+		};
+		Some(transfer_log(
+			token,
+			H160::zero(),
+			recipient,
+			U256::from(mint_amount),
+		))
+	} else {
+		None
+	};
+	let peg_in = peg_in_log(bridge, recipient, AMOUNT, ergo_box_id);
+	let mut target_logs = Vec::new();
+	if mutation == FixtureMutationForBuild::MintAfterPegIn {
+		target_logs.push(peg_in);
+		target_logs.push(mint_log.expect("mint-after-event fixture retains the exact mint"));
+	} else {
+		if let Some(mint_log) = mint_log {
+			target_logs.push(mint_log);
+		}
+		target_logs.push(peg_in);
+	}
+	if mutation == FixtureMutationForBuild::AdditionalMint {
+		target_logs.push(transfer_log(
+			token,
+			H160::zero(),
+			H160::repeat_byte(0x67),
+			U256::one(),
+		));
+	}
+	if mutation == FixtureMutationForBuild::AdditionalBurn {
+		target_logs.push(transfer_log(
+			token,
+			H160::repeat_byte(0x68),
+			H160::zero(),
+			U256::one(),
+		));
+	}
+	if mutation == FixtureMutationForBuild::AdditionalRecipientTransfer {
+		target_logs.push(transfer_log(
+			token,
+			H160::repeat_byte(0x66),
+			recipient,
+			U256::one(),
+		));
+	}
+	let receipts = vec![
+		receipt(1, 21_000, first_logs.clone()),
+		receipt(1, 42_000, target_logs.clone()),
+	];
+	let statuses = vec![
+		status(&first_transaction, 0, first_logs),
+		status(&target_transaction, 1, target_logs),
+	];
+	let receipts_root =
+		ethereum::util::ordered_trie_root(receipts.iter().map(EnvelopedEncodable::encode));
+	let mut block_bloom = Bloom::default();
+	for receipt in &receipts {
+		let (_, logs, _) = receipt_fields(receipt);
+		accrue_logs(logs, &mut block_bloom);
+	}
+	let block = BlockV2::new(
+		PartialHeader {
+			parent_hash: H256::repeat_byte(0x10),
+			beneficiary: H160::repeat_byte(0x20),
+			state_root: H256::repeat_byte(0x30),
+			receipts_root,
+			logs_bloom: block_bloom,
+			difficulty: U256::zero(),
+			number: u64::from(EVENT_NUMBER).into(),
+			gas_limit: 30_000_000u64.into(),
+			gas_used: 42_000u64.into(),
+			timestamp: 1_700_000_000,
+			extra_data: Vec::new(),
+			mix_hash: H256::repeat_byte(0x40),
+			nonce: Default::default(),
+		},
+		vec![first_transaction, target_transaction.clone()],
+		Vec::new(),
+	);
+	let record = PegInRuntimeRecordV1 {
+		format_version: 1,
+		sidechain_id: H256::repeat_byte(0x11),
+		bridge_address: bridge,
+		profile_revision: 2,
+		profile_activation_height: 700,
+		ergo_box_id,
+		recipient,
+		amount: AMOUNT,
+		sidechain_height: u64::from(EVENT_NUMBER),
+		execution_block_hash: block.header.hash(),
+		transaction_hash: target_transaction.hash(),
+		event_index: if matches!(
+			mutation,
+			FixtureMutationForBuild::MissingMintLog | FixtureMutationForBuild::MintAfterPegIn
+		) {
+			1
+		} else {
+			2
+		},
+	};
+	let extension_context = MintTransitionFixtureContext {
+		record: &record,
+		bridge_runtime_code: &bridge_runtime_code,
+		token_runtime_code: &token_runtime_code,
+	};
+
+	let current_block_key = derive_ethereum_current_block_storage_key();
+	let receipts_key = derive_ethereum_current_receipts_storage_key();
+	let statuses_key = derive_ethereum_current_transaction_statuses_storage_key();
+	let record_key =
+		derive_processed_peg_in_storage_key_v1(record.sidechain_id, record.ergo_box_id);
+	let bridge_code_key = derive_evm_account_code_storage_key(bridge);
+	let token_code_key = derive_evm_account_code_storage_key(token);
+	let bridge_owner_key = derive_evm_account_storage_key(bridge, H256::from_low_u64_be(0));
+	let bridge_configuration_key = derive_evm_account_storage_key(bridge, H256::from_low_u64_be(3));
+	let processed_peg_in_key =
+		derive_evm_account_storage_key(bridge, derive_processed_peg_in_mapping_slot(ergo_box_id));
+	let token_total_supply_key = derive_evm_account_storage_key(token, H256::from_low_u64_be(2));
+	let token_owner_key = derive_evm_account_storage_key(token, H256::from_low_u64_be(5));
+	let recipient_balance_key =
+		derive_evm_account_storage_key(token, derive_token_balance_mapping_slot(recipient));
+
+	let mut parent_state = BTreeMap::new();
+	let parent_runtime_code = if mutation == FixtureMutationForBuild::ParentRuntimeCodeChanged {
+		let mut changed = RUNTIME_CODE.to_vec();
+		changed.push(0xff);
+		changed
+	} else {
+		RUNTIME_CODE.to_vec()
+	};
+	parent_state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), parent_runtime_code);
+	let parent_bridge_runtime_code = if mutation == FixtureMutationForBuild::ParentBridgeCodeChanged
+	{
+		let mut changed = bridge_runtime_code.clone();
+		changed[0] ^= 1;
+		changed
+	} else {
+		bridge_runtime_code.clone()
+	};
+	parent_state.insert(bridge_code_key.clone(), parent_bridge_runtime_code.encode());
+	let parent_token_runtime_code = if mutation == FixtureMutationForBuild::ParentTokenCodeChanged {
+		let mut changed = token_runtime_code.clone();
+		changed[0] ^= 1;
+		changed
+	} else {
+		token_runtime_code.clone()
+	};
+	parent_state.insert(token_code_key.clone(), parent_token_runtime_code.encode());
+	let parent_bridge_owner = if mutation == FixtureMutationForBuild::ParentBridgeOwnerChanged {
+		H160::repeat_byte(0x34)
+	} else {
+		bridge_owner
+	};
+	parent_state.insert(
+		bridge_owner_key.clone(),
+		address_word(parent_bridge_owner).as_bytes().to_vec(),
+	);
+	let parent_configured_token =
+		if mutation == FixtureMutationForBuild::ParentConfiguredTokenChanged {
+			H160::repeat_byte(0x23)
+		} else {
+			token
+		};
+	let parent_paused = mutation == FixtureMutationForBuild::ParentPaused
+		|| mutation == FixtureMutationForBuild::BridgePaused;
+	parent_state.insert(
+		bridge_configuration_key.clone(),
+		configuration_word(parent_configured_token, parent_paused)
+			.as_bytes()
+			.to_vec(),
+	);
+	let parent_token_owner = if mutation == FixtureMutationForBuild::ParentTokenOwnerChanged {
+		H160::repeat_byte(0x35)
+	} else {
+		bridge
+	};
+	parent_state.insert(
+		token_owner_key.clone(),
+		address_word(parent_token_owner).as_bytes().to_vec(),
+	);
+	if mutation == FixtureMutationForBuild::ParentNativeRecordPresent {
+		parent_state.insert(record_key.to_vec(), record.encode());
+	}
+	if mutation == FixtureMutationForBuild::ParentReplayTrue {
+		parent_state.insert(
+			processed_peg_in_key.clone(),
+			H256::from_low_u64_be(1).as_bytes().to_vec(),
+		);
+	}
+	if mutation == FixtureMutationForBuild::SupplyUnderflow {
+		parent_state.insert(
+			token_total_supply_key.clone(),
+			H256::from(U256::from(AMOUNT + 1).to_big_endian())
+				.as_bytes()
+				.to_vec(),
+		);
+	}
+	if mutation == FixtureMutationForBuild::RecipientBalanceUnderflow {
+		parent_state.insert(
+			recipient_balance_key.clone(),
+			H256::from(U256::from(AMOUNT + 1).to_big_endian())
+				.as_bytes()
+				.to_vec(),
+		);
+	}
+	let parent_extension = parent_extension(&extension_context);
+	for (key, value) in parent_extension.entries {
+		assert!(
+			parent_state.insert(key, value).is_none(),
+			"composed parent fixture must not replace a T20C storage member"
+		);
+	}
+	let parent_backend = InMemoryBackend::<BlakeTwo256>::from((parent_state, StateVersion::V1));
+	let parent_state_root = *parent_backend.root();
+	let mut parent_proof_keys = vec![
+		RUNTIME_CODE_STORAGE_KEY.to_vec(),
+		record_key.to_vec(),
+		bridge_code_key.clone(),
+		token_code_key.clone(),
+		bridge_owner_key.clone(),
+		bridge_configuration_key.clone(),
+		processed_peg_in_key.clone(),
+		token_total_supply_key.clone(),
+		token_owner_key.clone(),
+		recipient_balance_key.clone(),
+	];
+	parent_proof_keys.extend(parent_extension.proof_keys);
+	let parent_proof = prove_read(parent_backend, parent_proof_keys.iter().map(Vec::as_slice))
+		.expect("deterministic parent state must prove the exact composed key surface");
+	let parent_proof_nodes = parent_proof.into_iter_nodes().collect::<Vec<_>>();
+	let parent = NativeHeader::new(
+		TARGET_NUMBER,
+		H256::repeat_byte(0x8f),
+		parent_state_root,
+		anchor_hash(),
+		Digest::default(),
+	);
+	let post_extension = post_extension(
+		&extension_context,
+		parent.hash(),
+		u64::from(*parent.number()),
+	);
+
+	let mut post_state = BTreeMap::new();
+	post_state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), RUNTIME_CODE.to_vec());
+	post_state.insert(current_block_key.to_vec(), block.encode());
+	post_state.insert(receipts_key.to_vec(), receipts.encode());
+	post_state.insert(statuses_key.to_vec(), statuses.encode());
+	post_state.insert(record_key.to_vec(), record.encode());
+	post_state.insert(
+		bridge_code_key.clone(),
+		bridge_runtime_code.clone().encode(),
+	);
+	post_state.insert(token_code_key.clone(), token_runtime_code.clone().encode());
+	post_state.insert(
+		bridge_owner_key.clone(),
+		address_word(bridge_owner).as_bytes().to_vec(),
+	);
+	let post_paused = mutation == FixtureMutationForBuild::PostPaused
+		|| mutation == FixtureMutationForBuild::BridgePaused;
+	post_state.insert(
+		bridge_configuration_key.clone(),
+		configuration_word(token, post_paused).as_bytes().to_vec(),
+	);
+	post_state.insert(
+		processed_peg_in_key.clone(),
+		H256::from_low_u64_be(1).as_bytes().to_vec(),
+	);
+	let supply_amount = if mutation == FixtureMutationForBuild::SupplyDeltaWrong {
+		AMOUNT + 1
+	} else {
+		AMOUNT
+	};
+	let balance_amount = if mutation == FixtureMutationForBuild::RecipientBalanceDeltaWrong {
+		AMOUNT + 1
+	} else {
+		AMOUNT
+	};
+	let supply_word = H256::from(U256::from(supply_amount).to_big_endian());
+	let balance_word = H256::from(U256::from(balance_amount).to_big_endian());
+	post_state.insert(
+		token_total_supply_key.clone(),
+		supply_word.as_bytes().to_vec(),
+	);
+	post_state.insert(
+		token_owner_key.clone(),
+		address_word(bridge).as_bytes().to_vec(),
+	);
+	post_state.insert(
+		recipient_balance_key.clone(),
+		balance_word.as_bytes().to_vec(),
+	);
+	for (key, value) in post_extension.entries {
+		assert!(
+			post_state.insert(key, value).is_none(),
+			"composed post fixture must not replace a T20C storage member"
+		);
+	}
+	let post_backend = InMemoryBackend::<BlakeTwo256>::from((post_state, StateVersion::V1));
+	let post_state_root = *post_backend.root();
+	let mut post_proof_keys = vec![
+		RUNTIME_CODE_STORAGE_KEY.to_vec(),
+		current_block_key.to_vec(),
+		receipts_key.to_vec(),
+		statuses_key.to_vec(),
+		record_key.to_vec(),
+		bridge_code_key.clone(),
+		token_code_key.clone(),
+		bridge_owner_key.clone(),
+		bridge_configuration_key.clone(),
+		processed_peg_in_key.clone(),
+		token_total_supply_key.clone(),
+		token_owner_key.clone(),
+		recipient_balance_key.clone(),
+	];
+	post_proof_keys.extend(post_extension.proof_keys);
+	let post_proof = prove_read(post_backend, post_proof_keys.iter().map(Vec::as_slice))
+		.expect("deterministic post state must prove the exact composed key surface");
+	let post_proof_nodes = post_proof.into_iter_nodes().collect::<Vec<_>>();
+	let target = NativeHeader::new(
+		EVENT_NUMBER,
+		H256::repeat_byte(0x90),
+		post_state_root,
+		parent.hash(),
+		Digest::default(),
+	);
+	let (pairs, authorities) = authority_fixture();
+	let finality_proof = signed_finality_proof(&target, &pairs);
+	let contract_state_request = NativeFrontierPegInContractStateRequest {
+		schema: CONTRACT_STATE_REQUEST_SCHEMA.to_owned(),
+		event_request: NativeFrontierPegInEventRequest {
+			schema: EVENT_REQUEST_SCHEMA.to_owned(),
+			execution_identity_request: NativeFrontierExecutionIdentityRequest {
+				schema: EXECUTION_REQUEST_SCHEMA.to_owned(),
+				trust_anchor: TrustAnchorRequest {
+					sidechain_id_hex: format_hash(record.sidechain_id),
+					checkpoint_hash_hex: format_hash(anchor_hash()),
+					checkpoint_number: u64::from(ANCHOR_NUMBER).to_string(),
+					grandpa_set_id: SET_ID.to_string(),
+					authority_list_scale_hex: format_bytes(&authorities.encode()),
+				},
+				target_native_block_hash_hex: format_hash(target.hash()),
+				target_header_scale_hex: format_bytes(&target.encode()),
+				linked_grandpa_proofs: Vec::<LinkedGrandpaProofRequest>::new(),
+				checkpoint_tail_headers_scale_hex: vec![
+					format_bytes(&parent.encode()),
+					format_bytes(&target.encode()),
+				],
+				finality_proof_scale_hex: format_bytes(&finality_proof),
+				statement: FrontierExecutionIdentityStatementRequest {
+					schema: EXECUTION_STATEMENT_SCHEMA.to_owned(),
+					runtime_code: RuntimeCodeStatementRequest {
+						storage_key_hex: format_bytes(&RUNTIME_CODE_STORAGE_KEY),
+						artifact_sha256_hex: format_bytes(&sha2_256(RUNTIME_CODE)),
+						artifact_size_bytes: RUNTIME_CODE.len().to_string(),
+						build_attestation_id: BUILD_ATTESTATION_ID.to_owned(),
+						build_attestation_sha256_hex: format_bytes(&BUILD_ATTESTATION_SHA256),
+					},
+					current_block_storage_key_hex: format_bytes(&current_block_key),
+					ergo_box_id_hex: format_hash(record.ergo_box_id),
+					expected_record_scale_hex: format_bytes(&record.encode()),
+				},
+				runtime_state_proof_nodes_hex: post_proof_nodes
+					.iter()
+					.map(|node| format_bytes(node))
+					.collect(),
+			},
+			statement: FrontierPegInEventStatementRequest {
+				schema: EVENT_STATEMENT_SCHEMA.to_owned(),
+				current_receipts_storage_key_hex: format_bytes(&receipts_key),
+				current_transaction_statuses_storage_key_hex: format_bytes(&statuses_key),
+			},
+		},
+		statement: FrontierPegInContractStateStatementRequest {
+			schema: CONTRACT_STATE_STATEMENT_SCHEMA.to_owned(),
+			bridge_address_hex: format_bytes(bridge.as_bytes()),
+			token_address_hex: format_bytes(token.as_bytes()),
+			bridge_account_code_storage_key_hex: format_bytes(&bridge_code_key),
+			token_account_code_storage_key_hex: format_bytes(&token_code_key),
+			bridge_owner_storage_key_hex: format_bytes(&bridge_owner_key),
+			bridge_configuration_storage_key_hex: format_bytes(&bridge_configuration_key),
+			processed_peg_in_storage_key_hex: format_bytes(&processed_peg_in_key),
+			token_total_supply_storage_key_hex: format_bytes(&token_total_supply_key),
+			token_owner_storage_key_hex: format_bytes(&token_owner_key),
+			bridge_runtime_code_sha256_hex: format_bytes(&sha2_256(&bridge_runtime_code)),
+			bridge_runtime_code_bytes: bridge_runtime_code.len().to_string(),
+			token_runtime_code_sha256_hex: format_bytes(&sha2_256(&token_runtime_code)),
+			token_runtime_code_bytes: token_runtime_code.len().to_string(),
+		},
+	};
+
+	NativeFrontierPegInMintTransitionRequest {
+		schema: REQUEST_SCHEMA.to_owned(),
+		contract_state_request,
+		parent_native_block_hash_hex: format_hash(parent.hash()),
+		parent_header_scale_hex: format_bytes(&parent.encode()),
+		parent_state_proof_nodes_hex: parent_proof_nodes
+			.iter()
+			.map(|node| format_bytes(node))
+			.collect(),
+		statement: FrontierPegInMintTransitionStatementRequest {
+			schema: STATEMENT_SCHEMA.to_owned(),
+			parent_native_processed_record_storage_key_hex: format_bytes(&record_key),
+			recipient_balance_storage_key_hex: format_bytes(&recipient_balance_key),
+		},
+	}
+}
+
+/// Build the deterministic wrapper and exact digest-bound expected result.
+pub fn deterministic_fixture_vector() -> FrontierPegInMintTransitionFixtureVector {
+	let trusted_anchor_digest_hex = deterministic_trusted_anchor_digest_hex();
+	let request = deterministic_fixture_request();
+	let expected = verify_request_bytes(
+		&serde_json::to_vec(&request).expect("fixture request must serialize canonically"),
+		&trusted_anchor_digest_hex,
+	)
+	.expect("deterministic Frontier mint-transition request must verify");
+	FrontierPegInMintTransitionFixtureVector {
+		schema: FIXTURE_VECTOR_SCHEMA.to_owned(),
+		trusted_anchor_digest_hex,
+		request,
+		expected,
+	}
+}
+
+fn transaction(seed: u8) -> TransactionV2 {
+	TransactionV2::Legacy(LegacyTransaction {
+		nonce: u64::from(seed).into(),
+		gas_price: 1_000_000_000u64.into(),
+		gas_limit: 100_000u64.into(),
+		action: TransactionAction::Call(H160::repeat_byte(0x22)),
+		value: U256::zero(),
+		input: vec![seed; 4],
+		signature: TransactionSignature::new(
+			27,
+			H256::repeat_byte(seed.max(1)),
+			H256::repeat_byte(seed.saturating_add(1).max(1)),
+		)
+		.expect("deterministic transaction signature must be canonical"),
+	})
+}
+
+fn transfer_log(token: H160, from: H160, to: H160, amount: U256) -> Log {
+	Log {
+		address: token,
+		topics: vec![
+			H256::from(keccak_256(TRANSFER_EVENT_SIGNATURE)),
+			address_word(from),
+			address_word(to),
+		],
+		data: amount.to_big_endian().to_vec(),
+	}
+}
+
+fn peg_in_log(bridge: H160, recipient: H160, amount: u64, ergo_box_id: H256) -> Log {
+	let mut recipient_topic = [0u8; 32];
+	recipient_topic[12..].copy_from_slice(recipient.as_bytes());
+	let mut data = vec![0u8; 64];
+	data[24..32].copy_from_slice(&amount.to_be_bytes());
+	data[32..].copy_from_slice(ergo_box_id.as_bytes());
+	Log {
+		address: bridge,
+		topics: vec![
+			H256::from(keccak_256(PEG_IN_EVENT_SIGNATURE)),
+			H256::from(recipient_topic),
+		],
+		data,
+	}
+}
+
+fn receipt(status_code: u8, used_gas: u64, logs: Vec<Log>) -> ReceiptV3 {
+	ReceiptV3::Legacy(EIP658ReceiptData {
+		status_code,
+		used_gas: used_gas.into(),
+		logs_bloom: logs_bloom(&logs),
+		logs,
+	})
+}
+
+fn status(transaction: &TransactionV2, index: u32, logs: Vec<Log>) -> TransactionStatus {
+	TransactionStatus {
+		transaction_hash: transaction.hash(),
+		transaction_index: index,
+		from: H160::repeat_byte(0x10),
+		to: Some(H160::repeat_byte(0x22)),
+		contract_address: None,
+		logs_bloom: logs_bloom(&logs),
+		logs,
+	}
+}
+
+fn receipt_fields(receipt: &ReceiptV3) -> (u8, &Vec<Log>, &'static str) {
+	match receipt {
+		ReceiptV3::Legacy(data) => (data.status_code, &data.logs, "legacy"),
+		ReceiptV3::EIP2930(data) => (data.status_code, &data.logs, "eip2930"),
+		ReceiptV3::EIP1559(data) => (data.status_code, &data.logs, "eip1559"),
+	}
+}
+
+fn logs_bloom(logs: &[Log]) -> Bloom {
+	let mut bloom = Bloom::default();
+	accrue_logs(logs, &mut bloom);
+	bloom
+}
+
+fn accrue_logs(logs: &[Log], bloom: &mut Bloom) {
+	for log in logs {
+		bloom.accrue(BloomInput::Raw(log.address.as_bytes()));
+		for topic in &log.topics {
+			bloom.accrue(BloomInput::Raw(topic.as_bytes()));
+		}
+	}
+}
+
+fn address_word(address: H160) -> H256 {
+	let mut bytes = [0u8; 32];
+	bytes[12..].copy_from_slice(address.as_bytes());
+	H256::from(bytes)
+}
+
+fn configuration_word(token: H160, paused: bool) -> H256 {
+	let mut bytes = [0u8; 32];
+	bytes[11] = u8::from(paused);
+	bytes[12..].copy_from_slice(token.as_bytes());
+	H256::from(bytes)
+}
+
+fn bridge_runtime_code() -> Vec<u8> {
+	hex::decode(
+		include_str!(
+			"../../../template/node/src/tests/res/bridge-atomicity/ErgoBridge.runtime.bin"
+		)
+		.trim(),
+	)
+	.expect("pinned ErgoBridge runtime bytecode must be lowercase hex")
+}
+
+fn token_runtime_code() -> Vec<u8> {
+	hex::decode(
+		include_str!("../../../template/node/src/tests/res/bridge-atomicity/SERG.runtime.bin")
+			.trim(),
+	)
+	.expect("pinned SERG runtime bytecode must be lowercase hex")
+}

+		assert!(!verified.boundary.evm_storage_state_verified);
+		assert!(!verified.boundary.runtime_code_identity_verified);
+		assert!(!verified.boundary.committed_vault_transition_verified);
+		assert!(!verified.boundary.historical_mint_absence_verified);
+		assert!(!verified.boundary.mint_authorized);
+		assert!(!verified.boundary.gate5_closed);
+		assert!(!verified.boundary.production_readiness_verified);

+
+pub fn derive_ergo_autolykos_committed_vault_utxo_runtime_statement_id_v3(
+	statement_bytes: &[u8],
+) -> Result<H256, &'static str> {
+	if statement_bytes.len()
+		!= ERGO_AUTOLYKOS_COMMITTED_VAULT_UTXO_RUNTIME_STATEMENT_BYTES_V3
+	{
+		return Err("UTXO runtime-derived statement V3 length is invalid");
+	}
+	let mut bytes = Vec::with_capacity(STATEMENT_ID_DOMAIN_V3.len() + statement_bytes.len());
+	bytes.extend_from_slice(STATEMENT_ID_DOMAIN_V3);
+	bytes.extend_from_slice(statement_bytes);
+	Ok(H256::from(blake2_256(&bytes)))
+}
+
+pub fn compose_ergo_autolykos_committed_vault_utxo_runtime_statement_v3(
+	relay_witness_bytes: &[u8],
+	transaction_witness_bytes: &[u8],
+	utxo_witness_bytes: &[u8],
+) -> Result<Vec<u8>, &'static str> {
+	let relay = verify_ergo_autolykos_v2_relay_runtime_witness_for_runtime_statement_v2(
+		relay_witness_bytes,
+	)?;
+	let transaction = verify_ergo_scorex_transaction_runtime_witness_v1::<
+		InitialErgoNativeCompatibilityParserProfileV1,
+	>(transaction_witness_bytes)?;
+	let utxo = verify_ergo_utxo_state_runtime_witness_v1(utxo_witness_bytes)?;
+	let base_statement_v2 = compose_ergo_autolykos_committed_vault_runtime_statement_v2(
+		relay_witness_bytes,
+		transaction_witness_bytes,
+	)?;
+
+	if relay.target_state_root != utxo.state_root {
+		return Err("UTXO witness state root does not match the selected target header");
+	}
+	if transaction.vault_box_id != utxo.vault_box_id {
+		return Err("UTXO witness vault key does not match the transaction witness");
+	}
+	if transaction.source_box_id != utxo.refundable_source_box_id {
+		return Err("UTXO witness source key does not match the transaction witness");
+	}
+	if transaction.vault_box_bytes != utxo.expected_vault_box {
+		return Err("UTXO witness vault value does not match the transaction witness");
+	}
+
+	let mut statement =
+		Vec::with_capacity(ERGO_AUTOLYKOS_COMMITTED_VAULT_UTXO_RUNTIME_STATEMENT_BYTES_V3);
+	statement.push(ERGO_AUTOLYKOS_COMMITTED_VAULT_UTXO_RUNTIME_STATEMENT_FORMAT_V3);
+	for value in [
+		ergo_autolykos_committed_vault_utxo_runtime_proof_system_id_v3(),
+		ergo_autolykos_committed_vault_utxo_runtime_statement_profile_id_v3(),
+		ergo_autolykos_supplied_branch_policy_id_v2(),
+		ergo_autolykos_committed_vault_utxo_runtime_verifier_profile_id_v3(),
+		ergo_autolykos_v2_relay_runtime_witness_family_id_v1(),
+		relay.witness_id,
+		ergo_scorex_transaction_runtime_witness_family_id_v1(),
+		transaction.witness_id,
+		derive_ergo_autolykos_committed_vault_runtime_statement_id_v2(&base_statement_v2)?,
+		ergo_utxo_state_runtime_witness_family_id_v1(),
+		utxo.witness_id,
+		ergo_utxo_state_runtime_verifier_profile_id_v1(),
+		relay.target_header_id,
+	] {
+		statement.extend_from_slice(value.as_bytes());
+	}
+	statement.extend_from_slice(&utxo.state_root);
+	statement.extend_from_slice(utxo.vault_box_id.as_bytes());
+	statement.extend_from_slice(utxo.refundable_source_box_id.as_bytes());
+	statement.extend_from_slice(utxo.expected_vault_box_sha256.as_bytes());
+	statement.extend_from_slice(&(utxo.expected_vault_box.len() as u32).to_be_bytes());
+	statement.extend_from_slice(utxo.proof_sha256.as_bytes());
+	statement.extend_from_slice(&(utxo.proof.len() as u32).to_be_bytes());
+	statement.extend_from_slice(&0u16.to_be_bytes());
+	if statement.len()
+		!= ERGO_AUTOLYKOS_COMMITTED_VAULT_UTXO_RUNTIME_STATEMENT_BYTES_V3
+	{
+		return Err("UTXO runtime-derived statement V3 composition length drifted");
+	}
+	parse_ergo_autolykos_committed_vault_utxo_runtime_statement_v3(&statement)?;
+	Ok(statement)
+}
+
+fn parse_ergo_autolykos_committed_vault_utxo_runtime_statement_v3(
+	statement: &[u8],
+) -> Result<ParsedErgoAutolykosCommittedVaultUtxoRuntimeStatementV3, &'static str> {
+	if statement.len()
+		!= ERGO_AUTOLYKOS_COMMITTED_VAULT_UTXO_RUNTIME_STATEMENT_BYTES_V3
+	{
+		return Err("UTXO runtime-derived statement V3 length is invalid");
+	}
+	if statement[0] != ERGO_AUTOLYKOS_COMMITTED_VAULT_UTXO_RUNTIME_STATEMENT_FORMAT_V3 {
+		return Err("UTXO runtime-derived statement V3 format is unsupported");
+	}
+	for (offset, expected) in [
+		(
+			PROOF_SYSTEM_OFFSET,
+			ergo_autolykos_committed_vault_utxo_runtime_proof_system_id_v3(),
+		),
+		(
+			STATEMENT_PROFILE_OFFSET,
+			ergo_autolykos_committed_vault_utxo_runtime_statement_profile_id_v3(),
+		),
+		(BRANCH_POLICY_OFFSET, ergo_autolykos_supplied_branch_policy_id_v2()),
+		(
+			VERIFIER_PROFILE_OFFSET,
+			ergo_autolykos_committed_vault_utxo_runtime_verifier_profile_id_v3(),
+		),
+		(RELAY_FAMILY_OFFSET, ergo_autolykos_v2_relay_runtime_witness_family_id_v1()),
+		(
+			TRANSACTION_FAMILY_OFFSET,
+			ergo_scorex_transaction_runtime_witness_family_id_v1(),
+		),
+		(UTXO_FAMILY_OFFSET, ergo_utxo_state_runtime_witness_family_id_v1()),
+		(
+			UTXO_VERIFIER_OFFSET,
+			ergo_utxo_state_runtime_verifier_profile_id_v1(),
+		),
+	] {
+		if h256_at(statement, offset) != expected {
+			return Err("UTXO runtime-derived statement V3 contains an unsupported static identity");
+		}
+	}
+	let expected_vault_box_length = u32_at(statement, EXPECTED_VAULT_BOX_LENGTH_OFFSET);
+	let proof_length = u32_at(statement, PROOF_LENGTH_OFFSET);
+	if expected_vault_box_length == 0
+		|| expected_vault_box_length > MAX_VALUE_BYTES_V3
+		|| proof_length == 0
+		|| proof_length > MAX_PROOF_BYTES_V3
+	{
+		return Err("UTXO runtime-derived statement V3 byte length is outside its bound");
+	}
+	if u16_at(statement, AUTHORITY_FLAGS_OFFSET) != 0 {
+		return Err("UTXO runtime-derived statement V3 authority flags must be zero");
+	}
+	let mut target_state_root = [0u8; STATE_ROOT_BYTES_V3];
+	target_state_root.copy_from_slice(
+		&statement[TARGET_STATE_ROOT_OFFSET..TARGET_STATE_ROOT_OFFSET + STATE_ROOT_BYTES_V3],
+	);
+	Ok(ParsedErgoAutolykosCommittedVaultUtxoRuntimeStatementV3 {
+		statement_id: derive_ergo_autolykos_committed_vault_utxo_runtime_statement_id_v3(
+			statement,
+		)?,
+		relay_witness_id: h256_at(statement, RELAY_WITNESS_OFFSET),
+		transaction_witness_id: h256_at(statement, TRANSACTION_WITNESS_OFFSET),
+		base_statement_v2_id: h256_at(statement, BASE_STATEMENT_V2_OFFSET),
+		utxo_witness_id: h256_at(statement, UTXO_WITNESS_OFFSET),
+		target_header_id: h256_at(statement, TARGET_HEADER_OFFSET),
+		target_state_root,
+		vault_box_id: h256_at(statement, VAULT_BOX_ID_OFFSET),
+		refundable_source_box_id: h256_at(statement, REFUNDABLE_SOURCE_BOX_ID_OFFSET),
+		expected_vault_box_sha256: h256_at(statement, EXPECTED_VAULT_BOX_SHA256_OFFSET),
+		expected_vault_box_length,
+		proof_sha256: h256_at(statement, PROOF_SHA256_OFFSET),
+		proof_length,
+	})
+}
+
+fn assert_ergo_autolykos_committed_vault_utxo_runtime_statement_matches_v3(
+	statement_bytes: &[u8],
+	relay_witness_bytes: &[u8],
+	transaction_witness_bytes: &[u8],
+	utxo_witness_bytes: &[u8],
+) -> Result<ParsedErgoAutolykosCommittedVaultUtxoRuntimeStatementV3, &'static str> {
+	let parsed =
+		parse_ergo_autolykos_committed_vault_utxo_runtime_statement_v3(statement_bytes)?;
+	let expected = compose_ergo_autolykos_committed_vault_utxo_runtime_statement_v3(
+		relay_witness_bytes,
+		transaction_witness_bytes,
+		utxo_witness_bytes,
+	)?;
+	if expected != statement_bytes {
+		return Err("UTXO runtime-derived statement V3 does not match the exact runtime witnesses");
+	}
+	Ok(parsed)
+}

+use thiserror::Error;
+
+use crate::{
+	ensure_collection, format_bytes, format_hash, parse_byte_hex, parse_decimal_u64, parse_hash,
+	LinkedGrandpaProofRequest, NativeBlock, NativeCheckpointRequestError, NativeHeader,
+	TrustAnchorRequest, VerifiedAuthorityOutput, VerifiedFinalityOutput, VerifiedTargetOutput,
+	MAX_AUTHORITY_LIST_BYTES, MAX_NATIVE_HEADER_BYTES, MAX_REQUEST_BYTES,
+};
+
+/// Stable request schema for the finalized peg-in runtime-identity profile.
+pub const REQUEST_SCHEMA: &str = "e2s.native-finalized-peg-in-runtime-identity-request.v2";
+/// Stable statement schema for exact runtime code plus branch-specific processed-deposit state.
+pub const STATEMENT_SCHEMA: &str = "e2s.peg-in-runtime-identity-statement.v2";
+/// Stable successful result schema for the finalized peg-in runtime-identity profile.
+pub const VERIFICATION_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-runtime-identity-verification.v2";
+/// Maximum portable build-attestation identifier bytes.
+pub const MAX_BUILD_ATTESTATION_ID_BYTES: usize = 128;
+
+/// Exact expected state of one derived processed-deposit key.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(
+	tag = "outcome",
+	rename_all = "camelCase",
+	rename_all_fields = "camelCase",
+	deny_unknown_fields
+)]
+pub enum PegInRecordExpectationRequest {
+	/// Require the exact expected V1 record to be present.
+	Membership {
+		/// Canonical fixed-width V1 record SCALE bytes.
+		expected_record_scale_hex: String,
+	},
+	/// Require the exact derived key to be absent at the target state root.
+	NonMembership,
+}
+
+/// Statement-bound expected runtime artifact and future build-attestation identity.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RuntimeCodeStatementRequest {
+	/// Exact raw Substrate `:code` storage key.
+	pub storage_key_hex: String,
+	/// SHA-256 of the exact expected raw runtime Wasm.
+	pub artifact_sha256_hex: String,
+	/// Exact expected raw runtime Wasm byte length as a canonical decimal string.
+	pub artifact_size_bytes: String,
+	/// Portable identity of the separately reviewed runtime-build attestation.
+	pub build_attestation_id: String,
+	/// SHA-256 of the exact separately reviewed runtime-build attestation bytes.
+	pub build_attestation_sha256_hex: String,
+}
+
+/// Versioned runtime-identity and peg-in statement bound into the native request digest.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PegInStateStatementRequest {
+	/// Exact statement schema.
+	pub schema: String,
+	/// Exact expected runtime code plus a non-authoritative build-attestation identity.
+	pub runtime_code: RuntimeCodeStatementRequest,

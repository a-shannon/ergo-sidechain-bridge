+			let runtime_profile = CurrentCausalPegInProfileV2::<T>::get()
+				.ok_or(Error::<T>::InvalidCausalPegInProfile)?;
+			ensure!(
+				!InvalidatedCausalPegInsV1::<T>::contains_key(invalidation.record_key),
+				Error::<T>::CausalPegInAdmissionPermanentlyInvalidated
+			);
+			let pending = PendingCausalPegInsV2::<T>::get(invalidation.record_key)
+				.ok_or(Error::<T>::CausalPegInAdmissionMissing)?;
+			let receipt = CausalPegInAdmissionReceiptsV1::<T>::get(invalidation.record_key)
+				.ok_or(Error::<T>::CausalPegInAdmissionMissing)?;
+			ensure!(
+				invalidation.profile_id == runtime_profile.profile_id
+					&& invalidation.admission_id == pending.admission_id
+					&& invalidation.source_proof_result_id == receipt.source_proof_result_id
+					&& invalidation.issued_at_native_height >= receipt.admitted_at_native_height,
+				Error::<T>::InvalidCausalPegInSourceProof

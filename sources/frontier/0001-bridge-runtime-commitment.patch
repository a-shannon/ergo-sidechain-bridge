+pub fn derive_expired_pooled_reserve_mint_reservation_invalidation_id_v4(
+	pending: &PendingPooledReserveMintReservationV4,
+	invalidated_at_native_height: u64,
+) -> Result<H256, &'static str> {
+	if pending.format_version != POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4
+		|| pending.profile_id == H256::zero()
+		|| pending.statement_id == H256::zero()
+		|| pending.mint_identity == H256::zero()
+		|| pending.source_proof_result_id == H256::zero()
+		|| pending.expires_at_native_height <= pending.reserved_at_native_height
+		|| invalidated_at_native_height < pending.expires_at_native_height
+	{
+		return Err("pooled-reserve mint-reservation expiry identity is invalid");
+	}
+	let mut preimage =
+		Vec::with_capacity(RESERVATION_INVALIDATION_ID_DOMAIN_V4.len() + 1 + 32 * 4 + 8 * 3 + 1);
+	preimage.extend_from_slice(RESERVATION_INVALIDATION_ID_DOMAIN_V4);
+	preimage.push(pending.format_version);
+	preimage.extend_from_slice(pending.profile_id.as_bytes());
+	preimage.extend_from_slice(pending.statement_id.as_bytes());
+	preimage.extend_from_slice(pending.mint_identity.as_bytes());
+	preimage.extend_from_slice(pending.source_proof_result_id.as_bytes());
+	preimage.extend_from_slice(&pending.reserved_at_native_height.to_be_bytes());
+	preimage.extend_from_slice(&pending.expires_at_native_height.to_be_bytes());
+	preimage.extend_from_slice(&invalidated_at_native_height.to_be_bytes());
+	preimage.push(POOLED_RESERVE_MINT_RESERVATION_INVALIDATION_REASON_EXPIRED_V4);
+	Ok(H256::from(blake2_256(&preimage)))
+}

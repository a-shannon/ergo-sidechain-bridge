+	pub statement: CausalPegInMintTransitionStatementRequestV3,
+}
+
+/// Exact parent/child header binding shared with T20C.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedCausalHeaderBindingV3 {
+	/// Actual direct-parent native hash.
+	pub parent_native_block_hash_hex: String,
+	/// Actual direct-parent native height.

+	/// Hash-linked authority-transition proofs from the public trust root.
+	pub linked_grandpa_proofs: Vec<LinkedGrandpaProofRequest>,
+	/// Contiguous headers after the last linked handoff through the finality horizon.
+	pub checkpoint_tail_headers_scale_hex: Vec<String>,
+	/// Canonical SCALE `grandpa_proveFinality` response for the target.
+	pub finality_proof_scale_hex: String,
+	/// Peg-In Runtime Identity V2 statement.
+	pub statement: PegInStateStatementRequest,
+	/// One raw trie proof covering the exact keys required by the statement branch.
+	pub runtime_state_proof_nodes_hex: Vec<String>,
+}
+
+/// Verified exact runtime code, profile, and processed-record trie state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedPegInRuntimeStateOutput {
+	/// Exact raw Substrate `:code` key.
+	pub runtime_code_storage_key_hex: String,
+	/// SHA-256 of the authenticated raw runtime Wasm.
+	pub runtime_code_sha256_hex: String,
+	/// Exact authenticated raw runtime Wasm byte length.
+	pub runtime_code_size_bytes: String,
+	/// Statement-bound identity of the separately reviewed build attestation.
+	pub build_attestation_id: String,
+	/// Statement-bound SHA-256 of the separately reviewed build attestation bytes.
+	pub build_attestation_sha256_hex: String,
+	/// Fixed `CurrentPegInProfile` storage key for non-membership, or `null` for membership.
+	pub profile_storage_key_hex: Option<String>,
+	/// Canonical authenticated profile SCALE value for non-membership, or `null` for membership.
+	pub profile_storage_value_scale_hex: Option<String>,
+	/// Exact internally derived `ProcessedPegIns` storage key.
+	pub record_storage_key_hex: String,
+	/// Canonical authenticated record SCALE value, or `null` for proved absence.
+	pub record_storage_value_scale_hex: Option<String>,
+	/// `MEMBERSHIP` or `NON_MEMBERSHIP` as required by the request statement.
+	pub outcome: String,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+	/// Confirms the exact statement-specific key reads were verified against the target state root.
+	pub verified: bool,
+}
+
+/// Typed current profile recovered from authenticated runtime state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedPegInProfileOutput {
+	/// Profile format version.
+	pub format_version: u8,
+	/// Native sidechain identity.
+	pub sidechain_id_hex: String,
+	/// Configured EVM bridge contract.
+	pub bridge_address_hex: String,
+	/// Monotonic profile generation as an exact decimal string.
+	pub profile_revision: String,
+	/// Native activation height as an exact decimal string.
+	pub activation_height: String,
+}
+
+/// Typed historical processed-deposit record recovered from authenticated runtime state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedPegInRecordOutput {
+	/// Record format version.
+	pub format_version: u8,
+	/// Native sidechain identity.
+	pub sidechain_id_hex: String,
+	/// Historical bridge contract.
+	pub bridge_address_hex: String,
+	/// Historical profile generation as an exact decimal string.
+	pub profile_revision: String,
+	/// Historical profile activation height as an exact decimal string.
+	pub profile_activation_height: String,
+	/// Canonical Ergo deposit box identity.
+	pub ergo_box_id_hex: String,
+	/// Sidechain recipient.
+	pub recipient_hex: String,
+	/// Raw nanoERG amount as an exact decimal string.
+	pub amount_nano_erg: String,
+	/// Native persistence height as an exact decimal string.
+	pub sidechain_height: String,
+	/// Frontier execution block containing the accepted event.
+	pub execution_block_hash_hex: String,
+	/// Frontier transaction containing the accepted event.
+	pub transaction_hash_hex: String,
+	/// Canonical global event index.
+	pub event_index: u32,
+}
+
+/// Explicit non-authorizing claim boundary for one peg-in state result.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerificationBoundaryOutput {
+	/// Native sidechain finality is verified relative to the reviewed trust root.
+	pub sidechain_finality_verified: bool,
+	/// The exact statement-specific runtime-state key set is authenticated under the target root.
+	pub statement_runtime_state_verified: bool,
+	/// The exact statement-bound raw `:code` value is authenticated under the same target root.
+	pub runtime_code_state_proof_verified: bool,
+	/// This verifier does not authenticate the separately supplied build-attestation identity.
+	pub runtime_build_attestation_verified: bool,
+	/// Current absence does not establish absence of a legacy mint before profile activation.
+	pub historical_mint_absence_verified: bool,
+	/// Runtime identity remains false until the proved bytes match a reviewed build attestation.
+	pub runtime_code_identity_verified: bool,
+	/// The preceding Ergo deposit-to-vault transition remains a separate obligation.
+	pub committed_vault_transition_verified: bool,
+	/// This verifier never authorizes mint selection or hold release.
+	pub mint_authorized: bool,
+	/// This offline verifier cannot mutate transactions or chain state.
+	pub transaction_mutation_enabled: bool,
+	/// This proof alone does not close Gate 5.
+	pub gate5_closed: bool,
+}
+
+/// Successful finalized Peg-In Runtime Identity V2 verification report.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativePegInStateVerification {
+	/// Exact successful output schema.
+	pub schema: String,
+	/// Stable verification status.
+	pub status: String,
+	/// Blake2b-256 digest of the exact request bytes consumed by the process.
+	pub request_digest_hex: String,
+	/// Recomputed public trust-anchor digest.
+	pub trust_anchor_digest_hex: String,
+	/// Requested target identity.
+	pub target: VerifiedTargetOutput,
+	/// Authenticated authority-transition result.
+	pub authority: VerifiedAuthorityOutput,
+	/// Exact GRANDPA finality horizon.
+	pub finality: VerifiedFinalityOutput,
+	/// Exact runtime code, profile, and processed-record trie state.
+	pub runtime_state: VerifiedPegInRuntimeStateOutput,
+	/// Typed current profile for non-membership, or `null` for membership.
+	pub profile: Option<VerifiedPegInProfileOutput>,
+	/// Typed historical record for membership, or `null` for current non-membership.
+	pub record: Option<VerifiedPegInRecordOutput>,
+	/// Non-negotiable claim boundary.
+	pub boundary: VerificationBoundaryOutput,
+}
+
+/// A strict request or finalized peg-in state verification failure.
+#[derive(Debug, Error)]
+pub enum NativePegInStateRequestError {
+	/// Shared strict request parsing or bound validation failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// Request schema did not match the separate V2 contract.
+	#[error("unsupported finalized peg-in runtime identity request schema")]
+	Schema,
+	/// Statement schema did not match Peg-In Runtime Identity V2.
+	#[error("unsupported peg-in runtime identity statement schema")]
+	StatementSchema,
+	/// The statement did not use the exact raw Substrate `:code` key.
+	#[error("runtime code storage key must be exactly 0x3a636f6465")]
+	RuntimeCodeStorageKey,
+	/// The expected runtime size exceeds the V2 profile or this host.
+	#[error("invalid runtime code size")]
+	RuntimeCodeSize,
+	/// The portable build-attestation identity is malformed or unbounded.
+	#[error("invalid runtime build attestation ID")]
+	BuildAttestationId,
+	/// The build-attestation digest must be nonzero.
+	#[error("runtime build attestation SHA-256 digest is zero")]
+	ZeroBuildAttestationDigest,
+	/// Membership is self-contained and must not be coupled to a current profile.
+	#[error("membership statement must not include expectedProfileScaleHex")]
+	MembershipProfileForbidden,
+	/// Current non-membership must be scoped to one exact active profile.
+	#[error("non-membership statement requires expectedProfileScaleHex")]
+	NonMembershipProfileRequired,
+	/// One fixed-width SCALE statement value had the wrong length.
+	#[error(
+		"invalid fixed-width SCALE value for {field}: expected {expected} bytes, got {actual}"
+	)]
+	ScaleLength {
+		/// Stable field label.
+		field: &'static str,
+		/// Required exact bytes.
+		expected: usize,
+		/// Supplied bytes.
+		actual: usize,
+	},
+	/// One fixed-width SCALE statement value was malformed.
+	#[error("failed to decode canonical SCALE value for {field}")]
+	Scale {
+		/// Stable field label.
+		field: &'static str,
+	},
+	/// The supplied target hash did not equal the decoded header hash.
+	#[error("target native block hash does not match the decoded target header")]
+	TargetHashMismatch,
+	/// Finality, transition, or Peg-In Runtime Identity V2 verification failed.
+	#[error(transparent)]
+	Checkpoint(#[from] PegInRuntimeIdentityDeploymentCheckpointError),
+}
+
+/// Verify one exact bounded Peg-In Runtime Identity V2 request entirely offline.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<NativePegInStateVerification, NativePegInStateRequestError> {
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(NativeCheckpointRequestError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_REQUEST_BYTES,
+		}
+		.into());
+	}
+	let raw_request_value: serde_json::Value =
+		serde_json::from_slice(raw_request).map_err(NativeCheckpointRequestError::Json)?;
+	let profile_field_present = raw_request_value
+		.get("statement")
+		.and_then(serde_json::Value::as_object)
+		.is_some_and(|statement| statement.contains_key("expectedProfileScaleHex"));
+	let request: NativePegInStateRequest =
+		serde_json::from_value(raw_request_value).map_err(NativeCheckpointRequestError::Json)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativePegInStateRequestError::Schema);
+	}
+	if request.statement.schema != STATEMENT_SCHEMA {
+		return Err(NativePegInStateRequestError::StatementSchema);
+	}
+	let trusted_anchor_digest = parse_hash("trustedAnchorDigestHex", trusted_anchor_digest_hex)?;
+	let runtime_code_storage_key = parse_byte_hex(
+		"statement.runtimeCode.storageKeyHex",
+		&request.statement.runtime_code.storage_key_hex,
+		RUNTIME_CODE_STORAGE_KEY.len(),
+	)?;
+	if runtime_code_storage_key != RUNTIME_CODE_STORAGE_KEY {
+		return Err(NativePegInStateRequestError::RuntimeCodeStorageKey);
+	}
+	let runtime_code_sha256 = parse_hash(
+		"statement.runtimeCode.artifactSha256Hex",
+		&request.statement.runtime_code.artifact_sha256_hex,
+	)?;
+	let runtime_code_size_u64 = parse_decimal_u64(
+		"statement.runtimeCode.artifactSizeBytes",
+		&request.statement.runtime_code.artifact_size_bytes,
+	)?;
+	let runtime_code_size_bytes: usize = runtime_code_size_u64
+		.try_into()
+		.map_err(|_| NativePegInStateRequestError::RuntimeCodeSize)?;
+	if runtime_code_size_bytes == 0 || runtime_code_size_bytes > MAX_RUNTIME_CODE_BYTES {
+		return Err(NativePegInStateRequestError::RuntimeCodeSize);
+	}
+	validate_build_attestation_id(&request.statement.runtime_code.build_attestation_id)?;
+	let build_attestation_sha256 = parse_hash(
+		"statement.runtimeCode.buildAttestationSha256Hex",
+		&request.statement.runtime_code.build_attestation_sha256_hex,
+	)?;
+	if build_attestation_sha256 == Default::default() {
+		return Err(NativePegInStateRequestError::ZeroBuildAttestationDigest);
+	}
+	let runtime_code = RuntimeCodeExpectationV2 {
+		artifact_sha256: runtime_code_sha256.to_fixed_bytes(),
+		artifact_size_bytes: runtime_code_size_bytes,
+	};
+
+	let sidechain_id = parse_hash(
+		"trustAnchor.sidechainIdHex",
+		&request.trust_anchor.sidechain_id_hex,
+	)?;
+	let checkpoint_hash = parse_hash(
+		"trustAnchor.checkpointHashHex",
+		&request.trust_anchor.checkpoint_hash_hex,
+	)?;
+	let checkpoint_number_u64 = parse_decimal_u64(
+		"trustAnchor.checkpointNumber",
+		&request.trust_anchor.checkpoint_number,
+	)?;
+	let checkpoint_number =
+		checkpoint_number_u64
+			.try_into()
+			.map_err(|_| NativeCheckpointRequestError::Decimal {
+				field: "trustAnchor.checkpointNumber",
+			})?;
+	let grandpa_set_id = parse_decimal_u64(
+		"trustAnchor.grandpaSetId",
+		&request.trust_anchor.grandpa_set_id,
+	)?;
+	let authority_bytes = parse_byte_hex(
+		"trustAnchor.authorityListScaleHex",
+		&request.trust_anchor.authority_list_scale_hex,
+		MAX_AUTHORITY_LIST_BYTES,
+	)?;
+	let authorities = AuthorityList::decode_all(&mut &authority_bytes[..]).map_err(|_| {
+		NativeCheckpointRequestError::Scale {
+			field: "trustAnchor.authorityListScaleHex",
+		}
+	})?;
+	let anchor = GrandpaDeploymentTrustAnchor::<NativeBlock> {
+		sidechain_id,
+		checkpoint_hash,
+		checkpoint_number,
+		set_id: grandpa_set_id,
+		authorities,
+	};
+
+	let expected_target_hash = parse_hash(
+		"targetNativeBlockHashHex",
+		&request.target_native_block_hash_hex,
+	)?;
+	let target_header_bytes = parse_byte_hex(
+		"targetHeaderScaleHex",
+		&request.target_header_scale_hex,
+		MAX_NATIVE_HEADER_BYTES,
+	)?;
+	let target_header = NativeHeader::decode_all(&mut &target_header_bytes[..]).map_err(|_| {
+		NativePegInStateRequestError::Scale {
+			field: "targetHeaderScaleHex",
+		}
+	})?;
+	if target_header.hash() != expected_target_hash {
+		return Err(NativePegInStateRequestError::TargetHashMismatch);
+	}
+
+	ensure_collection(
+		"linkedGrandpaProofs",
+		request.linked_grandpa_proofs.len(),
+		0,
+		MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+	)?;
+	let linked_proofs = request
+		.linked_grandpa_proofs
+		.iter()
+		.map(|chunk| {
+			ensure_collection(
+				"linkedGrandpaProofs.ancestryHeadersScaleHex",
+				chunk.ancestry_headers_scale_hex.len(),
+				1,
+				MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+			)?;
+			let ancestry_headers = chunk
+				.ancestry_headers_scale_hex
+				.iter()
+				.map(|encoded| {
+					let bytes = parse_byte_hex(
+						"linkedGrandpaProofs.ancestryHeadersScaleHex",
+						encoded,
+						MAX_NATIVE_HEADER_BYTES,
+					)?;
+					NativeHeader::decode_all(&mut &bytes[..]).map_err(|_| {
+						NativeCheckpointRequestError::Scale {
+							field: "linkedGrandpaProofs.ancestryHeadersScaleHex",
+						}
+					})
+				})
+				.collect::<Result<Vec<_>, _>>()?;
+			let encoded_proof = parse_byte_hex(
+				"linkedGrandpaProofs.proofScaleHex",
+				&chunk.proof_scale_hex,
+				MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+			)?;
+			Ok(LinkedGrandpaAuthorityProofChunk {
+				ancestry_headers,
+				encoded_proof,
+			})
+		})
+		.collect::<Result<Vec<_>, NativeCheckpointRequestError>>()?;
+
+	ensure_collection(
+		"checkpointTailHeadersScaleHex",
+		request.checkpoint_tail_headers_scale_hex.len(),
+		0,
+		MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+	)?;
+	let checkpoint_tail_headers = request
+		.checkpoint_tail_headers_scale_hex
+		.iter()
+		.map(|encoded| {
+			let bytes = parse_byte_hex(
+				"checkpointTailHeadersScaleHex",
+				encoded,
+				MAX_NATIVE_HEADER_BYTES,
+			)?;
+			NativeHeader::decode_all(&mut &bytes[..]).map_err(|_| {
+				NativeCheckpointRequestError::Scale {
+					field: "checkpointTailHeadersScaleHex",
+				}
+			})
+		})
+		.collect::<Result<Vec<_>, _>>()?;
+
+	let finality_proof = parse_byte_hex(
+		"finalityProofScaleHex",
+		&request.finality_proof_scale_hex,
+		MAX_FINALITY_PROOF_BYTES,
+	)?;
+	let ergo_box_id = parse_hash("statement.ergoBoxIdHex", &request.statement.ergo_box_id_hex)?;
+	let expected_profile = request
+		.statement
+		.expected_profile_scale_hex
+		.as_ref()
+		.map(|encoded| {
+			let bytes = exact_scale_bytes(
+				"statement.expectedProfileScaleHex",
+				encoded,
+				PEG_IN_PROFILE_V1_SCALE_BYTES,
+			)?;
+			PegInRuntimeProfileV1::decode_all(&mut &bytes[..]).map_err(|_| {
+				NativePegInStateRequestError::Scale {
+					field: "statement.expectedProfileScaleHex",
+				}
+			})
+		})
+		.transpose()?;
+	let expected_record = match &request.statement.record {
+		PegInRecordExpectationRequest::Membership {
+			expected_record_scale_hex,
+		} => {
+			if profile_field_present {
+				return Err(NativePegInStateRequestError::MembershipProfileForbidden);
+			}
+			let bytes = exact_scale_bytes(
+				"statement.record.expectedRecordScaleHex",
+				expected_record_scale_hex,
+				PEG_IN_RECORD_V1_SCALE_BYTES,
+			)?;
+			Some(
+				PegInRuntimeRecordV1::decode_all(&mut &bytes[..]).map_err(|_| {
+					NativePegInStateRequestError::Scale {
+						field: "statement.record.expectedRecordScaleHex",
+					}
+				})?,
+			)
+		}
+		PegInRecordExpectationRequest::NonMembership => {
+			if !profile_field_present || expected_profile.is_none() {
+				return Err(NativePegInStateRequestError::NonMembershipProfileRequired);
+			}
+			None
+		}
+	};
+	let expectation = match (&expected_record, &expected_profile) {
+		(Some(record), None) => PegInRuntimeStateExpectationV1::Member(record),
+		(None, Some(profile)) => PegInRuntimeStateExpectationV1::NonMember(profile),
+		_ => unreachable!("statement branch checks establish one exact expectation; qed"),
+	};
+
+	ensure_collection(
+		"runtimeStateProofNodesHex",
+		request.runtime_state_proof_nodes_hex.len(),
+		1,
+		MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODES,
+	)?;
+	let state_nodes = request
+		.runtime_state_proof_nodes_hex
+		.iter()
+		.map(|node| {
+			parse_byte_hex(
+				"runtimeStateProofNodesHex",
+				node,
+				MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODE_BYTES,
+			)
+		})
+		.collect::<Result<Vec<_>, _>>()?;
+
+	let verified = verify_peg_in_runtime_identity_deployment_checkpoint::<NativeBlock>(
+		&anchor,
+		trusted_anchor_digest,
+		target_header,
+		&linked_proofs,
+		&checkpoint_tail_headers,
+		&finality_proof,
+		ergo_box_id,
+		runtime_code,
+		expectation,
+		&state_nodes,
+	)?;
+	let requested_header = &verified.finalized_state.requested_header;
+	let state = &verified.finalized_state.state;
+	let request_digest = BlakeTwo256::hash(raw_request);
+	let authority_set_hash = derive_grandpa_authority_set_hash(&verified.authenticated_authorities);
+	let (outcome, record_scale, record_output) = match &state.record_state {
+		PegInRecordStateV1::Member(record) => (
+			"MEMBERSHIP".to_owned(),
+			Some(format_bytes(&record.encode())),
+			Some(record_output(record)),
+		),
+		PegInRecordStateV1::Absent => ("NON_MEMBERSHIP".to_owned(), None, None),
+	};
+
+	Ok(NativePegInStateVerification {
+		schema: VERIFICATION_SCHEMA.to_owned(),
+		status: "NATIVE_PEG_IN_RUNTIME_IDENTITY_STATE_VERIFIED_RELATIVE_TO_REVIEWED_TRUST_ROOT"
+			.to_owned(),
+		request_digest_hex: format_hash(request_digest),
+		trust_anchor_digest_hex: format_hash(verified.trust_anchor_digest),
+		target: VerifiedTargetOutput {
+			native_block_hash_hex: format_hash(requested_header.hash()),
+			native_height: u64::from(*requested_header.number()).to_string(),
+			state_root_hex: format_hash(*requested_header.state_root()),
+		},
+		authority: VerifiedAuthorityOutput {
+			finality_signing_set_id: verified.authenticated_set_id.to_string(),
+			finality_signing_authority_list_scale_hex: format_bytes(
+				&verified.authenticated_authorities.encode(),
+			),
+			finality_signing_authority_set_hash_hex: format_hash(authority_set_hash),
+			transition_count: verified.transition_count,
+			linked_ancestry_verified: true,
+		},
+		finality: VerifiedFinalityOutput {
+			horizon_hash_hex: format_hash(verified.finality_horizon_hash),
+			horizon_height: u64::from(verified.finality_horizon_number).to_string(),
+			canonical_justification_scale_hex: format_bytes(
+				&verified.finalized_state.finality.justification.encode(),
+			),
+			verified: true,
+		},
+		runtime_state: VerifiedPegInRuntimeStateOutput {
+			runtime_code_storage_key_hex: format_bytes(&state.runtime_code_storage_key),
+			runtime_code_sha256_hex: format_bytes(&state.runtime_code_sha256),
+			runtime_code_size_bytes: state.runtime_code_size_bytes.to_string(),
+			build_attestation_id: request.statement.runtime_code.build_attestation_id.clone(),
+			build_attestation_sha256_hex: format_hash(build_attestation_sha256),
+			profile_storage_key_hex: state
+				.profile_storage_key
+				.as_ref()
+				.map(|key| format_bytes(key)),
+			profile_storage_value_scale_hex: state
+				.profile
+				.as_ref()
+				.map(|profile| format_bytes(&profile.encode())),
+			record_storage_key_hex: format_bytes(&state.record_storage_key),
+			record_storage_value_scale_hex: record_scale,
+			outcome,
+			proof_node_count: state.proof_node_count,
+			proof_bytes: state.proof_bytes,
+			verified: true,
+		},
+		profile: state.profile.as_ref().map(profile_output),
+		record: record_output,
+		boundary: VerificationBoundaryOutput {
+			sidechain_finality_verified: true,
+			statement_runtime_state_verified: true,
+			runtime_code_state_proof_verified: true,
+			runtime_build_attestation_verified: false,
+			historical_mint_absence_verified: false,
+			runtime_code_identity_verified: false,
+			committed_vault_transition_verified: false,
+			mint_authorized: false,
+			transaction_mutation_enabled: false,
+			gate5_closed: false,
+		},
+	})
+}
+
+fn validate_build_attestation_id(value: &str) -> Result<(), NativePegInStateRequestError> {
+	let bytes = value.as_bytes();
+	if bytes.is_empty() || bytes.len() > MAX_BUILD_ATTESTATION_ID_BYTES {
+		return Err(NativePegInStateRequestError::BuildAttestationId);
+	}
+	let mut previous_was_separator = false;
+	for (index, byte) in bytes.iter().enumerate() {
+		let alphanumeric = byte.is_ascii_lowercase() || byte.is_ascii_digit();
+		let separator = b"._-".contains(byte);
+		if !alphanumeric
+			&& (!separator || index == 0 || index == bytes.len() - 1 || previous_was_separator)
+		{
+			return Err(NativePegInStateRequestError::BuildAttestationId);
+		}
+		previous_was_separator = separator;
+	}
+	Ok(())
+}
+
+fn exact_scale_bytes(
+	field: &'static str,
+	value: &str,
+	expected: usize,
+) -> Result<Vec<u8>, NativePegInStateRequestError> {
+	let bytes = parse_byte_hex(field, value, expected)?;
+	if bytes.len() != expected {
+		return Err(NativePegInStateRequestError::ScaleLength {
+			field,
+			expected,
+			actual: bytes.len(),
+		});
+	}
+	Ok(bytes)
+}
+
+fn profile_output(profile: &PegInRuntimeProfileV1) -> VerifiedPegInProfileOutput {
+	VerifiedPegInProfileOutput {
+		format_version: profile.format_version,
+		sidechain_id_hex: format_hash(profile.sidechain_id),
+		bridge_address_hex: format_bytes(profile.bridge_address.as_bytes()),
+		profile_revision: profile.profile_revision.to_string(),
+		activation_height: profile.activation_height.to_string(),
+	}
+}
+
+fn record_output(record: &PegInRuntimeRecordV1) -> VerifiedPegInRecordOutput {
+	VerifiedPegInRecordOutput {
+		format_version: record.format_version,
+		sidechain_id_hex: format_hash(record.sidechain_id),
+		bridge_address_hex: format_bytes(record.bridge_address.as_bytes()),
+		profile_revision: record.profile_revision.to_string(),
+		profile_activation_height: record.profile_activation_height.to_string(),
+		ergo_box_id_hex: format_hash(record.ergo_box_id),
+		recipient_hex: format_bytes(record.recipient.as_bytes()),
+		amount_nano_erg: record.amount.to_string(),
+		sidechain_height: record.sidechain_height.to_string(),
+		execution_block_hash_hex: format_hash(record.execution_block_hash),
+		transaction_hash_hex: format_hash(record.transaction_hash),
+		event_index: record.event_index,
+	}
+}

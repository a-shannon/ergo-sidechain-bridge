+	fn set_target_envelope(fixture: &mut Fixture, envelope: Envelope) {
+		let logs = receipt_fields(&fixture.receipts[1]).1.clone();
+		let target_transaction = typed_transaction(2, envelope);
+		fixture.block.transactions[1] = target_transaction.clone();
+		fixture.receipts[1] = typed_receipt(envelope, 1, 42_000, logs.clone());

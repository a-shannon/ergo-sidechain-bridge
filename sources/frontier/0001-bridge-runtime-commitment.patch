+//! Authenticated Frontier EVM code and deciding peg-in contract storage.
+//!
+//! This outer profile consumes the exact proof nodes already used by the finalized successful
+//! `PegIn` event profile. It adds exact `EVM::AccountCodes` and `EVM::AccountStorages` reads under
+//! the same native state root. Build provenance, historical absence, committed-vault eligibility,
+//! mint authority, daemon admission, Gate 5 closure, and release readiness remain separate.
+
+use scale_codec::{DecodeAll, Encode};
+use sp_core::{hashing::blake2_128, keccak_256, sha2_256, twox_128, H160, H256, U256};
+use sp_runtime::traits::BlakeTwo256;
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+use crate::{
+	peg_in_frontier_event_v1::VerifiedFrontierPegInEventV1,
+	peg_in_frontier_execution_identity_v1::{
+		validate_proof_bounds, FrontierExecutionIdentityProofError,
+	},
+};
+
+const EVM_PALLET_PREFIX: &[u8] = b"EVM";
+const ACCOUNT_CODES_STORAGE_PREFIX: &[u8] = b"AccountCodes";
+const ACCOUNT_STORAGES_STORAGE_PREFIX: &[u8] = b"AccountStorages";
+const BRIDGE_OWNER_SLOT: u64 = 0;
+const BRIDGE_CONFIGURATION_SLOT: u64 = 3;
+const PROCESSED_PEG_INS_MAPPING_SLOT: u64 = 4;
+const TOKEN_TOTAL_SUPPLY_SLOT: u64 = 2;
+const TOKEN_OWNER_SLOT: u64 = 5;
+
+/// Maximum decoded EVM runtime code accepted for either deciding contract.
+pub const MAX_FRONTIER_EVM_RUNTIME_CODE_BYTES: usize = 1024 * 1024;
+
+/// Exact expected identity of one authenticated `EVM::AccountCodes` value.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct FrontierRuntimeCodeExpectationV1 {
+	/// SHA-256 of the exact decoded runtime code bytes.
+	pub sha256: [u8; 32],
+	/// Exact decoded runtime code byte length.
+	pub bytes: usize,
+}
+
+/// Authenticated deciding EVM code and storage state for one successful peg-in.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct VerifiedFrontierPegInContractStateV1 {
+	/// Native state root shared with the nested event verification.
+	pub state_root: H256,
+	/// Exact bridge contract address.
+	pub bridge_address: H160,
+	/// Exact token contract address.
+	pub token_address: H160,
+	/// Exact bridge `EVM::AccountCodes` top-trie key.
+	pub bridge_account_code_storage_key: Vec<u8>,
+	/// Exact token `EVM::AccountCodes` top-trie key.
+	pub token_account_code_storage_key: Vec<u8>,
+	/// SHA-256 of authenticated decoded bridge runtime code.
+	pub bridge_runtime_code_sha256: [u8; 32],
+	/// Authenticated decoded bridge runtime code byte length.
+	pub bridge_runtime_code_bytes: usize,
+	/// SHA-256 of authenticated decoded token runtime code.
+	pub token_runtime_code_sha256: [u8; 32],
+	/// Authenticated decoded token runtime code byte length.
+	pub token_runtime_code_bytes: usize,
+	/// Exact bridge owner slot top-trie key.
+	pub bridge_owner_storage_key: Vec<u8>,
+	/// Exact bridge packed configuration slot top-trie key.
+	pub bridge_configuration_storage_key: Vec<u8>,
+	/// Exact `processedPegIns[ergoBoxId]` top-trie key.
+	pub processed_peg_in_storage_key: Vec<u8>,
+	/// Exact token total-supply slot top-trie key.
+	pub token_total_supply_storage_key: Vec<u8>,
+	/// Exact token owner slot top-trie key.
+	pub token_owner_storage_key: Vec<u8>,
+	/// Authenticated bridge owner; zero is allowed by this profile.
+	pub bridge_owner: H160,
+	/// Authenticated bridge token configuration.
+	pub configured_token: H160,
+	/// Authenticated bridge pause flag.
+	pub paused: bool,
+	/// Authenticated replay marker for the event's exact Ergo box ID.
+	pub processed_peg_in: bool,
+	/// Authenticated token total supply.
+	pub token_total_supply: U256,
+	/// Authenticated token owner, required to equal the bridge.
+	pub token_owner: H160,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+}
+
+/// A reason deciding Frontier contract code or storage was rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum FrontierPegInContractStateProofError {
+	/// Shared proof bounds failed.
+	#[error(transparent)]
+	ProofBounds(#[from] FrontierExecutionIdentityProofError),
+	/// Supplied bridge differs from the authenticated event emitter.
+	#[error("contract-state bridge differs from the authenticated PegIn event emitter")]
+	EventBridgeMismatch,
+	/// Bridge and token addresses must be distinct and nonzero.
+	#[error("bridge and token addresses must be nonzero and distinct")]
+	InvalidContractAddresses,
+	/// The supplied nodes do not reconstruct all seven exact reads under the event state root.
+	#[error("Frontier contract-state proof is invalid for the authenticated state root")]
+	InvalidProof,
+	/// One required state member is absent.
+	#[error("authenticated {field} is absent")]
+	MissingValue {
+		/// Stable identity of the missing state member.
+		field: &'static str,
+	},
+	/// One account-code value is not canonical SCALE `Vec<u8>`.
+	#[error("authenticated {field} is not canonical SCALE runtime code")]
+	MalformedCode {
+		/// Stable identity of the malformed account-code member.
+		field: &'static str,
+	},
+	/// One decoded account-code value is empty.
+	#[error("authenticated {field} runtime code is empty")]
+	EmptyCode {
+		/// Stable identity of the empty account-code member.
+		field: &'static str,
+	},
+	/// One decoded account-code value exceeds the profile limit.
+	#[error("authenticated {field} runtime code exceeds {max} bytes: {actual}")]
+	CodeTooLarge {
+		/// Stable identity of the oversized account-code member.
+		field: &'static str,
+		/// Exact decoded runtime-code byte count.
+		actual: usize,
+		/// Maximum accepted decoded runtime-code bytes.
+		max: usize,
+	},
+	/// One account-code value differs from its statement byte length.
+	#[error("authenticated {field} runtime code byte length differs from the statement")]
+	CodeLengthMismatch {
+		/// Stable identity of the account-code member.
+		field: &'static str,
+	},
+	/// One account-code value differs from its statement SHA-256.
+	#[error("authenticated {field} runtime code SHA-256 differs from the statement")]
+	CodeDigestMismatch {
+		/// Stable identity of the account-code member.
+		field: &'static str,
+	},
+	/// One storage value is not an exact canonical H256 word.
+	#[error("authenticated {field} is not an exact canonical H256 storage word")]
+	MalformedStorage {
+		/// Stable identity of the malformed storage member.
+		field: &'static str,
+	},
+	/// An address word has nonzero high padding.
+	#[error("authenticated {field} address has nonzero high padding")]
+	AddressPadding {
+		/// Stable identity of the malformed address word.
+		field: &'static str,
+	},
+	/// Packed bridge configuration has nonzero unused high bytes.
+	#[error("authenticated bridge configuration has nonzero unused padding")]
+	ConfigurationPadding,
+	/// Packed bridge pause byte is outside the canonical bool domain.
+	#[error("authenticated bridge pause flag is outside zero or one")]
+	PauseBoolean,
+	/// Bridge configuration names a different token.
+	#[error("authenticated bridge configuration token differs from the statement token")]
+	ConfiguredTokenMismatch,
+	/// Token owner is not the exact bridge address.
+	#[error("authenticated token owner differs from the bridge address")]
+	TokenOwnerMismatch,
+	/// Replay marker is not exactly the canonical H256 value one.
+	#[error("authenticated processedPegIns marker is not exactly one")]
+	ProcessedPegInMismatch,
+}
+
+/// Derive the exact `EVM::AccountCodes[address]` top-trie key.
+pub fn derive_evm_account_code_storage_key(address: H160) -> Vec<u8> {
+	let mut key = storage_prefix(ACCOUNT_CODES_STORAGE_PREFIX);
+	append_blake2_128_concat(&mut key, address.as_bytes());
+	key
+}
+
+/// Derive the exact `EVM::AccountStorages[address][slot]` top-trie key.
+pub fn derive_evm_account_storage_key(address: H160, slot: H256) -> Vec<u8> {
+	let mut key = storage_prefix(ACCOUNT_STORAGES_STORAGE_PREFIX);
+	append_blake2_128_concat(&mut key, address.as_bytes());
+	append_blake2_128_concat(&mut key, slot.as_bytes());
+	key
+}
+
+/// Derive the exact Solidity mapping slot for `processedPegIns[ergoBoxId]` at base slot four.
+pub fn derive_processed_peg_in_mapping_slot(ergo_box_id: H256) -> H256 {
+	let mut encoded = [0u8; 64];
+	encoded[..32].copy_from_slice(ergo_box_id.as_bytes());
+	encoded[63] = PROCESSED_PEG_INS_MAPPING_SLOT as u8;
+	H256::from(keccak_256(&encoded))
+}
+
+/// Verify seven exact EVM code/storage reads under the same root and proof as the event.
+pub fn verify_frontier_peg_in_contract_state_v1(
+	event: &VerifiedFrontierPegInEventV1,
+	proof_nodes: &[Vec<u8>],
+	bridge_address: H160,
+	token_address: H160,
+	bridge_code: FrontierRuntimeCodeExpectationV1,
+	token_code: FrontierRuntimeCodeExpectationV1,
+) -> Result<VerifiedFrontierPegInContractStateV1, FrontierPegInContractStateProofError> {
+	let proof_bytes = validate_proof_bounds(proof_nodes)?;
+	if bridge_address != event.bridge_address {
+		return Err(FrontierPegInContractStateProofError::EventBridgeMismatch);
+	}
+	if bridge_address == H160::zero()
+		|| token_address == H160::zero()
+		|| bridge_address == token_address
+	{
+		return Err(FrontierPegInContractStateProofError::InvalidContractAddresses);
+	}
+
+	let bridge_code_key = derive_evm_account_code_storage_key(bridge_address);
+	let token_code_key = derive_evm_account_code_storage_key(token_address);
+	let bridge_owner_key =
+		derive_evm_account_storage_key(bridge_address, H256::from_low_u64_be(BRIDGE_OWNER_SLOT));
+	let bridge_configuration_key = derive_evm_account_storage_key(
+		bridge_address,
+		H256::from_low_u64_be(BRIDGE_CONFIGURATION_SLOT),
+	);
+	let processed_peg_in_key = derive_evm_account_storage_key(
+		bridge_address,
+		derive_processed_peg_in_mapping_slot(event.ergo_box_id),
+	);
+	let token_total_supply_key = derive_evm_account_storage_key(
+		token_address,
+		H256::from_low_u64_be(TOKEN_TOTAL_SUPPLY_SLOT),
+	);
+	let token_owner_key =
+		derive_evm_account_storage_key(token_address, H256::from_low_u64_be(TOKEN_OWNER_SLOT));
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let keys = [
+		bridge_code_key.as_slice(),
+		token_code_key.as_slice(),
+		bridge_owner_key.as_slice(),
+		bridge_configuration_key.as_slice(),
+		processed_peg_in_key.as_slice(),
+		token_total_supply_key.as_slice(),
+		token_owner_key.as_slice(),
+	];
+	let values = read_proof_check::<BlakeTwo256, _>(event.state_root, proof, keys)
+		.map_err(|_| FrontierPegInContractStateProofError::InvalidProof)?;
+
+	let bridge_runtime_code = decode_runtime_code(
+		required(&values, &bridge_code_key, "EVM::AccountCodes[bridge]")?,
+		"EVM::AccountCodes[bridge]",
+		bridge_code,
+	)?;
+	let token_runtime_code = decode_runtime_code(
+		required(&values, &token_code_key, "EVM::AccountCodes[token]")?,
+		"EVM::AccountCodes[token]",
+		token_code,
+	)?;
+	let bridge_owner = decode_address_word(
+		storage_word_or_zero(
+			&values,
+			&bridge_owner_key,
+			"EVM::AccountStorages[bridge][owner]",
+		)?,
+		"EVM::AccountStorages[bridge][owner]",
+	)?;
+	let configuration = decode_storage_word(
+		required(
+			&values,
+			&bridge_configuration_key,
+			"EVM::AccountStorages[bridge][configuration]",
+		)?,
+		"EVM::AccountStorages[bridge][configuration]",
+	)?;
+	let (configured_token, paused) = decode_bridge_configuration(configuration)?;
+	if configured_token != token_address {
+		return Err(FrontierPegInContractStateProofError::ConfiguredTokenMismatch);
+	}
+	let processed_peg_in = decode_storage_word(
+		required(
+			&values,
+			&processed_peg_in_key,
+			"EVM::AccountStorages[bridge][processedPegIns]",
+		)?,
+		"EVM::AccountStorages[bridge][processedPegIns]",
+	)?;
+	if processed_peg_in != H256::from_low_u64_be(1) {
+		return Err(FrontierPegInContractStateProofError::ProcessedPegInMismatch);
+	}
+	let token_total_supply_word = storage_word_or_zero(
+		&values,
+		&token_total_supply_key,
+		"EVM::AccountStorages[token][totalSupply]",
+	)?;
+	let token_owner = decode_address_word(
+		decode_storage_word(
+			required(
+				&values,
+				&token_owner_key,
+				"EVM::AccountStorages[token][owner]",
+			)?,
+			"EVM::AccountStorages[token][owner]",
+		)?,
+		"EVM::AccountStorages[token][owner]",
+	)?;
+	if token_owner != bridge_address {
+		return Err(FrontierPegInContractStateProofError::TokenOwnerMismatch);
+	}
+
+	Ok(VerifiedFrontierPegInContractStateV1 {
+		state_root: event.state_root,
+		bridge_address,
+		token_address,
+		bridge_account_code_storage_key: bridge_code_key,
+		token_account_code_storage_key: token_code_key,
+		bridge_runtime_code_sha256: sha2_256(&bridge_runtime_code),
+		bridge_runtime_code_bytes: bridge_runtime_code.len(),
+		token_runtime_code_sha256: sha2_256(&token_runtime_code),
+		token_runtime_code_bytes: token_runtime_code.len(),
+		bridge_owner_storage_key: bridge_owner_key,
+		bridge_configuration_storage_key: bridge_configuration_key,
+		processed_peg_in_storage_key: processed_peg_in_key,
+		token_total_supply_storage_key: token_total_supply_key,
+		token_owner_storage_key: token_owner_key,
+		bridge_owner,
+		configured_token,
+		paused,
+		processed_peg_in: true,
+		token_total_supply: U256::from_big_endian(token_total_supply_word.as_bytes()),
+		token_owner,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+fn storage_prefix(storage: &[u8]) -> Vec<u8> {
+	let mut key = Vec::with_capacity(32);
+	key.extend_from_slice(&twox_128(EVM_PALLET_PREFIX));
+	key.extend_from_slice(&twox_128(storage));
+	key
+}
+
+fn append_blake2_128_concat(key: &mut Vec<u8>, encoded: &[u8]) {
+	key.extend_from_slice(&blake2_128(encoded));
+	key.extend_from_slice(encoded);
+}
+
+fn required<'a>(
+	values: &'a std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+	field: &'static str,
+) -> Result<&'a [u8], FrontierPegInContractStateProofError> {
+	values
+		.get(key)
+		.and_then(|value| value.as_deref())
+		.ok_or(FrontierPegInContractStateProofError::MissingValue { field })
+}
+
+fn decode_runtime_code(
+	raw: &[u8],
+	field: &'static str,
+	expected: FrontierRuntimeCodeExpectationV1,
+) -> Result<Vec<u8>, FrontierPegInContractStateProofError> {
+	let code = Vec::<u8>::decode_all(&mut &raw[..])
+		.map_err(|_| FrontierPegInContractStateProofError::MalformedCode { field })?;
+	if code.encode().as_slice() != raw {
+		return Err(FrontierPegInContractStateProofError::MalformedCode { field });
+	}
+	if code.is_empty() {
+		return Err(FrontierPegInContractStateProofError::EmptyCode { field });
+	}
+	if code.len() > MAX_FRONTIER_EVM_RUNTIME_CODE_BYTES {
+		return Err(FrontierPegInContractStateProofError::CodeTooLarge {
+			field,
+			actual: code.len(),
+			max: MAX_FRONTIER_EVM_RUNTIME_CODE_BYTES,
+		});
+	}
+	if code.len() != expected.bytes {
+		return Err(FrontierPegInContractStateProofError::CodeLengthMismatch { field });
+	}
+	if sha2_256(&code) != expected.sha256 {
+		return Err(FrontierPegInContractStateProofError::CodeDigestMismatch { field });
+	}
+	Ok(code)
+}
+
+fn decode_storage_word(
+	raw: &[u8],
+	field: &'static str,
+) -> Result<H256, FrontierPegInContractStateProofError> {
+	if raw.len() != 32 {
+		return Err(FrontierPegInContractStateProofError::MalformedStorage { field });
+	}
+	Ok(H256::from_slice(raw))
+}
+
+fn storage_word_or_zero(
+	values: &std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+	field: &'static str,
+) -> Result<H256, FrontierPegInContractStateProofError> {
+	match values.get(key) {
+		Some(Some(raw)) => decode_storage_word(raw, field),
+		Some(None) => Ok(H256::zero()),
+		None => Err(FrontierPegInContractStateProofError::MissingValue { field }),
+	}
+}
+
+fn decode_address_word(
+	word: H256,
+	field: &'static str,
+) -> Result<H160, FrontierPegInContractStateProofError> {
+	if word.as_bytes()[..12].iter().any(|byte| *byte != 0) {
+		return Err(FrontierPegInContractStateProofError::AddressPadding { field });
+	}
+	Ok(H160::from_slice(&word.as_bytes()[12..]))
+}
+
+fn decode_bridge_configuration(
+	word: H256,
+) -> Result<(H160, bool), FrontierPegInContractStateProofError> {
+	let bytes = word.as_bytes();
+	if bytes[..11].iter().any(|byte| *byte != 0) {
+		return Err(FrontierPegInContractStateProofError::ConfigurationPadding);
+	}
+	let paused = match bytes[11] {
+		0 => false,
+		1 => true,
+		_ => return Err(FrontierPegInContractStateProofError::PauseBoolean),
+	};
+	Ok((H160::from_slice(&bytes[12..]), paused))
+}

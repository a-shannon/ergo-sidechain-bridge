+/// A finalized peg-in state verification failure, preserving the owning layer.
+#[derive(Debug, Error)]
+pub enum FinalizedPegInStateProofError {
+	/// GRANDPA signatures, ancestry, or exact target binding failed.
+	#[error(transparent)]
+	Finality(#[from] BridgeFinalityProofError),
+	/// Peg-in profile or processed-record state verification failed.
+	#[error(transparent)]
+	State(#[from] PegInStateProofError),
+}
+
+/// Exact Peg-In Runtime State V1 values decoded from an authenticated native state root.
+#[derive(Debug)]
+pub struct VerifiedPegInRuntimeStateV1 {
+	/// State root used for trie verification.
+	pub state_root: H256,
+	/// Exact fixed profile key queried for non-membership, or `None` for membership.
+	pub profile_storage_key: Option<[u8; 32]>,
+	/// Exact derived processed-record key queried by the verifier.
+	pub record_storage_key: [u8; PROCESSED_PEG_IN_STORAGE_KEY_BYTES],
+	/// Current active V1 profile recovered for non-membership, or `None` for membership.
+	pub profile: Option<PegInRuntimeProfileV1>,
+	/// Exact member or authenticated current absence requested by the statement.
+	pub record_state: PegInRecordStateV1,
+	/// Number of bounded raw trie nodes consumed as proof material.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes accepted by the verifier.
+	pub proof_bytes: usize,
+}
+
+/// Peg-in runtime state whose native header is finalized under the supplied GRANDPA set.
+#[derive(Debug)]
+pub struct VerifiedFinalizedPegInRuntimeStateV1<Block: BlockT> {
+	/// Full requested header whose hash, number, ancestry, and state root were checked.
+	pub requested_header: Block::Header,
+	/// Native GRANDPA proof ending at an authenticated finalized target.
+	pub finality: VerifiedGrandpaFinalityProof<Block>,
+	/// Exact profile and processed-record state recovered from the requested header state root.
+	pub state: VerifiedPegInRuntimeStateV1,
+}
+
+/// Derive the permanent V1 processed-deposit key from chain and Ergo deposit identities.
+pub fn derive_peg_in_record_key_v1(sidechain_id: H256, ergo_box_id: H256) -> H256 {
+	let mut preimage = PEG_IN_RECORD_KEY_DOMAIN.to_vec();
+	preimage.extend(sidechain_id.as_bytes());
+	preimage.extend(ergo_box_id.as_bytes());
+	BlakeTwo256::hash(&preimage)
+}
+
+/// Derive the exact `Blake2_128Concat` trie key for one V1 processed-deposit identity.
+pub fn derive_processed_peg_in_storage_key_v1(
+	sidechain_id: H256,
+	ergo_box_id: H256,
+) -> [u8; PROCESSED_PEG_IN_STORAGE_KEY_BYTES] {
+	let record_key = derive_peg_in_record_key_v1(sidechain_id, ergo_box_id);
+	let mut storage_key = [0u8; PROCESSED_PEG_IN_STORAGE_KEY_BYTES];
+	storage_key[..32].copy_from_slice(&PROCESSED_PEG_INS_STORAGE_PREFIX);
+	storage_key[32..48].copy_from_slice(&blake2_128(record_key.as_bytes()));
+	storage_key[48..].copy_from_slice(record_key.as_bytes());
+	storage_key
+}
+
+/// Verify exact historical membership or exact current-profile non-membership.
+///
+/// Membership queries only the permanent record key, so a recorded deposit remains provable after
+/// profile rotation or emergency disable. Non-membership queries both the exact active profile and
+/// the derived record key. Current absence is not evidence that no legacy mint occurred before the
+/// authenticated profile was activated.
+pub fn verify_peg_in_runtime_state_v1(
+	state_root: H256,
+	expected_sidechain_id: H256,
+	expected_ergo_box_id: H256,
+	authenticated_header_height: u64,
+	expectation: PegInRuntimeStateExpectationV1<'_>,
+	proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedPegInRuntimeStateV1, PegInStateProofError> {
+	if expected_ergo_box_id == H256::zero() {
+		return Err(PegInStateProofError::ZeroErgoBoxId);
+	}
+	match expectation {
+		PegInRuntimeStateExpectationV1::Member(record) => validate_record(
+			record,
+			expected_sidechain_id,
+			expected_ergo_box_id,
+			authenticated_header_height,
+		)?,
+		PegInRuntimeStateExpectationV1::NonMember(profile) => {
+			validate_profile(profile, expected_sidechain_id, authenticated_header_height)?
+		}
+	}
+	let proof_bytes = validate_proof_bounds(proof_nodes)?;
+	let record_storage_key =
+		derive_processed_peg_in_storage_key_v1(expected_sidechain_id, expected_ergo_box_id);
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| PegInStateProofError::DuplicateNodes)?;
+	let requested_keys = match expectation {
+		PegInRuntimeStateExpectationV1::Member(_) => vec![record_storage_key.as_slice()],
+		PegInRuntimeStateExpectationV1::NonMember(_) => vec![
+			CURRENT_PEG_IN_PROFILE_STORAGE_KEY.as_slice(),
+			record_storage_key.as_slice(),
+		],
+	};
+	let values = read_proof_check::<BlakeTwo256, _>(state_root, proof, requested_keys)
+		.map_err(|_| PegInStateProofError::InvalidProof)?;
+
+	let profile = match expectation {
+		PegInRuntimeStateExpectationV1::Member(_) => None,
+		PegInRuntimeStateExpectationV1::NonMember(expected_profile) => {
+			let raw_profile = values
+				.get(CURRENT_PEG_IN_PROFILE_STORAGE_KEY.as_slice())
+				.and_then(|value| value.as_ref())
+				.ok_or(PegInStateProofError::ProfileMissing)?;
+			if raw_profile.len() != PEG_IN_PROFILE_V1_SCALE_BYTES {
+				return Err(PegInStateProofError::ProfileLength {
+					actual: raw_profile.len(),
+					expected: PEG_IN_PROFILE_V1_SCALE_BYTES,
+				});
+			}
+			let profile = PegInRuntimeProfileV1::decode_all(&mut &raw_profile[..])
+				.map_err(|_| PegInStateProofError::ProfileDecode)?;
+			validate_profile(&profile, expected_sidechain_id, authenticated_header_height)?;
+			if &profile != expected_profile {
+				return Err(PegInStateProofError::ProfileMismatch);
+			}
+			Some(profile)
+		}
+	};
+
+	let raw_record = values
+		.get(record_storage_key.as_slice())
+		.ok_or(PegInStateProofError::InvalidProof)?;
+	let record_state = match (expectation, raw_record.as_ref()) {
+		(PegInRuntimeStateExpectationV1::Member(_), None) => {
+			return Err(PegInStateProofError::RecordMissing)
+		}
+		(PegInRuntimeStateExpectationV1::NonMember(_), Some(_)) => {
+			return Err(PegInStateProofError::UnexpectedRecord)
+		}
+		(PegInRuntimeStateExpectationV1::NonMember(_), None) => PegInRecordStateV1::Absent,
+		(PegInRuntimeStateExpectationV1::Member(expected), Some(raw)) => {
+			if raw.len() != PEG_IN_RECORD_V1_SCALE_BYTES {
+				return Err(PegInStateProofError::RecordLength {
+					actual: raw.len(),
+					expected: PEG_IN_RECORD_V1_SCALE_BYTES,
+				});
+			}
+			let record = PegInRuntimeRecordV1::decode_all(&mut &raw[..])
+				.map_err(|_| PegInStateProofError::RecordDecode)?;
+			validate_record(
+				&record,
+				expected_sidechain_id,
+				expected_ergo_box_id,
+				authenticated_header_height,
+			)?;
+			if &record != expected {
+				return Err(PegInStateProofError::RecordMismatch);
+			}
+			PegInRecordStateV1::Member(record)
+		}
+	};
+
+	Ok(VerifiedPegInRuntimeStateV1 {
+		state_root,
+		profile_storage_key: profile.as_ref().map(|_| CURRENT_PEG_IN_PROFILE_STORAGE_KEY),
+		record_storage_key,
+		profile,
+		record_state,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+/// Verify one requested header, its GRANDPA finality, and Peg-In Runtime State V1.
+pub fn verify_finalized_peg_in_runtime_state_v1<Block>(
+	requested_header: Block::Header,
+	expected_sidechain_id: H256,
+	expected_set_id: SetId,
+	expected_authorities: &AuthorityList,
+	encoded_finality_proof: &[u8],
+	expected_ergo_box_id: H256,
+	expectation: PegInRuntimeStateExpectationV1<'_>,
+	storage_proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedFinalizedPegInRuntimeStateV1<Block>, FinalizedPegInStateProofError>
+where
+	Block: BlockT<Hash = H256>,
+	sp_runtime::traits::NumberFor<Block>:
+		sc_consensus_grandpa::BlockNumberOps + CheckedAdd + Copy + TryInto<u64>,
+{
+	let requested_hash = requested_header.hash();
+	let requested_number = *requested_header.number();
+	let finality = verify_grandpa_finality_proof::<Block>(
+		requested_hash,
+		requested_number,
+		expected_set_id,
+		expected_authorities,
+		encoded_finality_proof,
+	)?;
+	let requested_height = requested_number
+		.try_into()
+		.map_err(|_| PegInStateProofError::RecordAfterAuthenticatedHeader)?;
+	let state = verify_peg_in_runtime_state_v1(
+		*requested_header.state_root(),
+		expected_sidechain_id,
+		expected_ergo_box_id,
+		requested_height,
+		expectation,
+		storage_proof_nodes,
+	)?;
+
+	Ok(VerifiedFinalizedPegInRuntimeStateV1 {
+		requested_header,
+		finality,
+		state,
+	})
+}
+
+pub(crate) fn validate_profile(
+	profile: &PegInRuntimeProfileV1,
+	expected_sidechain_id: H256,
+	authenticated_header_height: u64,
+) -> Result<(), PegInStateProofError> {
+	if profile.format_version != 1 {
+		return Err(PegInStateProofError::UnsupportedProfileFormat(
+			profile.format_version,
+		));
+	}
+	if profile.sidechain_id != expected_sidechain_id {
+		return Err(PegInStateProofError::ProfileSidechainMismatch);
+	}
+	if profile.bridge_address == H160::zero() {
+		return Err(PegInStateProofError::ZeroProfileBridgeAddress);
+	}
+	if profile.profile_revision == 0 {
+		return Err(PegInStateProofError::ZeroProfileRevision);
+	}
+	if profile.activation_height >= authenticated_header_height {
+		return Err(PegInStateProofError::ProfileNotActive);
+	}
+	Ok(())
+}
+
+pub(crate) fn validate_record(
+	record: &PegInRuntimeRecordV1,
+	expected_sidechain_id: H256,
+	expected_ergo_box_id: H256,
+	authenticated_header_height: u64,
+) -> Result<(), PegInStateProofError> {
+	if record.format_version != 1 {
+		return Err(PegInStateProofError::UnsupportedRecordFormat(
+			record.format_version,
+		));
+	}
+	if record.sidechain_id != expected_sidechain_id {
+		return Err(PegInStateProofError::RecordSidechainMismatch);
+	}
+	if record.ergo_box_id != expected_ergo_box_id {
+		return Err(PegInStateProofError::RecordErgoBoxMismatch);
+	}
+	if record.bridge_address == H160::zero() {
+		return Err(PegInStateProofError::ZeroRecordBridgeAddress);
+	}
+	if record.profile_revision == 0 {
+		return Err(PegInStateProofError::ZeroRecordProfileRevision);
+	}
+	if record.sidechain_height <= record.profile_activation_height {
+		return Err(PegInStateProofError::RecordBeforeProfileActivation);
+	}
+	if record.sidechain_height > authenticated_header_height {
+		return Err(PegInStateProofError::RecordAfterAuthenticatedHeader);
+	}
+	if record.recipient == H160::zero() {
+		return Err(PegInStateProofError::ZeroRecordRecipient);
+	}
+	if record.amount == 0 {
+		return Err(PegInStateProofError::ZeroRecordAmount);
+	}
+	if record.amount > i64::MAX as u64 {
+		return Err(PegInStateProofError::RecordAmountExceedsErgoLong);
+	}
+	if record.execution_block_hash == H256::zero() {
+		return Err(PegInStateProofError::ZeroExecutionBlockHash);
+	}
+	if record.transaction_hash == H256::zero() {
+		return Err(PegInStateProofError::ZeroTransactionHash);
+	}
+	Ok(())
+}
+
+fn validate_proof_bounds(proof_nodes: &[Vec<u8>]) -> Result<usize, PegInStateProofError> {
+	if proof_nodes.is_empty() {
+		return Err(PegInStateProofError::EmptyProof);
+	}
+	if proof_nodes.len() > MAX_PEG_IN_STATE_PROOF_NODES {
+		return Err(PegInStateProofError::TooManyNodes {
+			actual: proof_nodes.len(),
+			max: MAX_PEG_IN_STATE_PROOF_NODES,
+		});
+	}
+	let mut proof_bytes = 0usize;
+	for (index, node) in proof_nodes.iter().enumerate() {
+		if node.len() > MAX_PEG_IN_STATE_PROOF_NODE_BYTES {
+			return Err(PegInStateProofError::NodeTooLarge {
+				index,
+				actual: node.len(),
+				max: MAX_PEG_IN_STATE_PROOF_NODE_BYTES,
+			});
+		}
+		proof_bytes =
+			proof_bytes
+				.checked_add(node.len())
+				.ok_or(PegInStateProofError::ProofTooLarge {
+					actual: usize::MAX,
+					max: MAX_PEG_IN_STATE_PROOF_BYTES,
+				})?;
+		if proof_bytes > MAX_PEG_IN_STATE_PROOF_BYTES {
+			return Err(PegInStateProofError::ProofTooLarge {
+				actual: proof_bytes,
+				max: MAX_PEG_IN_STATE_PROOF_BYTES,
+			});
+		}
+	}
+	Ok(proof_bytes)
+}

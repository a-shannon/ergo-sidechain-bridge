+				current_height,
+				&invalidation,
+			)
+			.map_err(|_| Error::<T>::InvalidCausalPegInSourceProof)?;
+			remove_pending_admission::<T>(invalidation.record_key)
+				.map_err(|_| Error::<T>::InvalidPendingCausalPegInAdmission)?;
+			InvalidatedCausalPegInsV1::<T>::insert(
+				invalidation.record_key,
+				CausalPegInInvalidationTombstoneV1 {
+					format_version: 1,
+					profile_id: invalidation.profile_id,
+					admission_id: invalidation.admission_id,
+					source_proof_result_id: invalidation.source_proof_result_id,
+					reason: invalidation.reason,
+					invalidation_id: verified.invalidation_id,
+					proof_digest: verified.proof_digest,
+					invalidated_at_native_height: current_height,
+				},
+			);
+			Self::deposit_event(Event::CausalPegInAdmissionInvalidated {
+				record_key: invalidation.record_key,
+				admission_id: invalidation.admission_id,
+				source_proof_result_id: invalidation.source_proof_result_id,
+				reason: invalidation.reason,

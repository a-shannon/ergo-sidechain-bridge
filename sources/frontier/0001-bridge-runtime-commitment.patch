+			.push(extrinsic)
+			.expect("valid bridge setup extrinsic");
+	}
+	let block = builder.build().expect("valid bridge setup block").block;
+	let hash = block.hash();
+	let (header, body) = block.deconstruct();
+	let mut params = BlockImportParams::new(BlockOrigin::File, header);
+	params.body = Some(body);
+	params.state_action = StateAction::Execute;
+	params.fork_choice = Some(ForkChoiceStrategy::Custom(true));
+	let importer = fc_consensus::FrontierBlockImport::new(client.clone(), client.clone());
+	let result =
+		block_on(importer.import_block(params)).expect("bridge setup block import succeeds");
+	assert!(matches!(result, ImportResult::Imported(_)));
+	hash
+}

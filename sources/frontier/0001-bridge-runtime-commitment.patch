@@ -0,0 +1,166 @@
+use std::{io::Write, process::Command};
+
+use bridge_checkpoint_verifier::{
+	peg_in_causal_source_proof_result_v1::{
+		PegInCausalSourceProofResultProducerOutputV1, RESULT_STATUS,
+	},
+	peg_in_causal_source_proof_result_v1_fixture::{
+		deterministic_fixture_request, deterministic_fixture_vector,
+	},
+};
+use serde_json::Value;
+
+fn run_producer(request: &Value) -> std::process::Output {
+	let mut child = Command::new(env!(
+		"CARGO_BIN_EXE_bridge-peg-in-causal-source-proof-result-v1-producer"
+	))
+	.stdin(std::process::Stdio::piped())
+	.stdout(std::process::Stdio::piped())
+	.stderr(std::process::Stdio::piped())
+	.spawn()
+	.unwrap();
+	child
+		.stdin
+		.take()
+		.unwrap()
+		.write_all(&serde_json::to_vec(request).unwrap())
+		.unwrap();
+	child.wait_with_output().unwrap()
+}
+
+fn mutate_hex_byte(value: &mut Value, field: &str, byte_index: usize, replacement: u8) {
+	let current = value[field].as_str().unwrap();
+	let mut bytes = hex::decode(&current[2..]).unwrap();
+	bytes[byte_index] = replacement;
+	value[field] = Value::String(format!("0x{}", hex::encode(bytes)));
+}
+
+#[test]
+fn cli_emits_the_exact_non_authorizing_result() {
+	let vector = deterministic_fixture_vector();
+	let request = serde_json::to_value(&vector.request).unwrap();
+	let output = run_producer(&request);
+	assert!(
+		output.status.success(),
+		"{}",
+		String::from_utf8_lossy(&output.stderr)
+	);
+	let actual: PegInCausalSourceProofResultProducerOutputV1 =
+		serde_json::from_slice(&output.stdout).unwrap();
+	assert_eq!(actual, vector.expected);
+	assert_eq!(actual.status, RESULT_STATUS);
+	assert!(actual.boundary.admission_bindings_validated);
+	assert!(actual.boundary.canonical_objects_hashed);
+	assert!(!actual.boundary.source_canonicality_verified);
+	assert!(!actual.boundary.source_proof_execution_authenticated);
+	assert!(!actual.boundary.signatures_produced);
+	assert!(!actual.boundary.signing_authorized);
+	assert!(!actual.boundary.runtime_admission_written);
+	assert!(!actual.boundary.lifecycle_advanced);
+	assert!(!actual.boundary.mint_authorized);
+	assert!(!actual.boundary.reconciliation_hold_release_authorized);
+	assert!(!actual.boundary.submission_authorized);
+	assert!(!actual.boundary.broadcast_authorized);
+	assert!(!actual.boundary.gate5_closed);
+	assert!(!actual.boundary.production_ready);
+	let output_text = String::from_utf8(output.stdout).unwrap();
+	for forbidden in ["privateKey", "secret", "signatureHex", "signerPublicKeyHex"] {
+		assert!(!output_text.contains(forbidden));
+	}
+}
+
+#[test]
+fn cli_rejects_candidate_profile_intent_statement_and_finality_drift() {
+	let baseline = serde_json::to_value(deterministic_fixture_request()).unwrap();
+	let mut mutations = Vec::new();
+
+	let mut candidate = baseline.clone();
+	candidate["candidateIdHex"] = Value::String(format!("0x{}", "42".repeat(32)));
+	mutations.push(candidate);
+
+	let mut profile = baseline.clone();
+	mutate_hex_byte(&mut profile, "admissionProfileCanonicalHex", 233, 0x37);
+	mutations.push(profile);
+
+	let mut intent = baseline.clone();
+	mutate_hex_byte(&mut intent, "sourceIntentCanonicalHex", 169, 0x01);
+	mutations.push(intent);
+
+	let mut statement = baseline.clone();
+	mutate_hex_byte(&mut statement, "statementCanonicalHex", 33, 0x00);
+	mutations.push(statement);
+
+	let mut finality = baseline;
+	mutate_hex_byte(&mut finality, "statementCanonicalHex", 345, 0x26);
+	mutations.push(finality);
+
+	let mut checkpoint_depth = serde_json::to_value(deterministic_fixture_request()).unwrap();
+	for (offset, byte) in [0x00, 0x00, 0x00, 0x00, 0x00, 0x07, 0xa1, 0x28]
+		.into_iter()
+		.enumerate()
+	{
+		mutate_hex_byte(
+			&mut checkpoint_depth,
+			"statementCanonicalHex",
+			337 + offset,
+			byte,
+		);
+	}
+	mutations.push(checkpoint_depth);
+
+	for request in mutations {
+		assert!(!run_producer(&request).status.success());
+	}
+}
+
+#[test]
+fn cli_rejects_invalid_heights_object_bounds_unknown_fields_and_arguments() {
+	let baseline = serde_json::to_value(deterministic_fixture_request()).unwrap();
+
+	for (issue, expiry) in [("1017", "1017"), ("1018", "1017"), ("1001", "1066")] {
+		let mut request = baseline.clone();
+		request["issuedAtNativeHeight"] = Value::String(issue.to_owned());
+		request["expiresAtNativeHeight"] = Value::String(expiry.to_owned());
+		assert!(!run_producer(&request).status.success());
+	}
+
+	let mut empty_object = baseline.clone();
+	empty_object["sourceBoxCanonicalHex"] = Value::String("0x".to_owned());
+	assert!(!run_producer(&empty_object).status.success());
+
+	let mut larger_valid_proof = baseline.clone();
+	larger_valid_proof["finalityProofCanonicalHex"] =
+		Value::String(format!("0x{}", "ab".repeat(4097)));
+	assert!(run_producer(&larger_valid_proof).status.success());
+
+	let mut oversized_object = baseline.clone();
+	oversized_object["finalityProofCanonicalHex"] =
+		Value::String(format!("0x{}", "ab".repeat(65537)));
+	assert!(!run_producer(&oversized_object).status.success());
+
+	let mut unknown = baseline;
+	unknown["verified"] = Value::Bool(true);
+	assert!(!run_producer(&unknown).status.success());
+
+	let output = Command::new(env!(
+		"CARGO_BIN_EXE_bridge-peg-in-causal-source-proof-result-v1-producer"
+	))
+	.arg("--sign")
+	.output()
+	.unwrap();
+	assert!(!output.status.success());
+}
+
+#[test]
+fn fixture_generator_emits_compact_exact_json() {
+	let output = Command::new(env!(
+		"CARGO_BIN_EXE_generate-peg-in-causal-source-proof-result-v1-fixture"
+	))
+	.output()
+	.unwrap();
+	assert!(output.status.success());
+	assert!(!output.stdout.contains(&b'\n'));
+	let actual: Value = serde_json::from_slice(&output.stdout).unwrap();
+	let expected = serde_json::to_value(deterministic_fixture_vector()).unwrap();
+	assert_eq!(actual, expected);
+}

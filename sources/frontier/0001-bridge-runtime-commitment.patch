index 0000000000000000000000000000000000000000..782578691603ef2334a3e8e4118cf102228a7ff5
--- /dev/null
+++ b/bridge/checkpoint-verifier/src/peg_in_frontier_contract_state_v1.rs
@@ -0,0 +1,734 @@
+//! Strict composed verification for finalized Frontier peg-in contract code and storage.
+//!
+//! The outer request embeds the unchanged finalized event request and reuses its exact proof
+//! nodes. Seven additional `EVM` pallet reads authenticate the deciding bridge/token code and
+//! storage under the same native state root. The trust root is still caller supplied, and this
+//! offline verifier cannot establish build provenance, historical absence, vault eligibility,
+//! mint admission, daemon authority, Gate 5 closure, or release readiness.
+
+use bridge_state_proof::{
+	peg_in_frontier_contract_state_v1::{
+		derive_evm_account_code_storage_key, derive_evm_account_storage_key,
+		derive_processed_peg_in_mapping_slot, verify_frontier_peg_in_contract_state_v1,
+		FrontierPegInContractStateProofError, FrontierRuntimeCodeExpectationV1,
+		MAX_FRONTIER_EVM_RUNTIME_CODE_BYTES,
+	},
+	peg_in_frontier_event_v1::verify_frontier_peg_in_event_v1,
+};
+use serde::{Deserialize, Serialize};
+use sp_core::{H160, H256};
+use sp_runtime::traits::{BlakeTwo256, Hash as _};
+use thiserror::Error;
+
+use crate::{
+	format_bytes, format_hash, parse_byte_hex, parse_decimal_u64, parse_hash,
+	peg_in_frontier_event_v1::{
+		verify_request_bytes as verify_event_request_bytes, NativeFrontierPegInEventRequest,
+		NativeFrontierPegInEventRequestError, NativeFrontierPegInEventVerification,
+		VerificationBoundaryOutput as EventVerificationBoundaryOutput,
+		VerifiedFrontierPegInEventOutput, VerifiedFrontierReceiptStateOutput,
+	},
+	peg_in_frontier_execution_identity_v1::{
+		verify_request_bytes_with_context, NativeFrontierExecutionIdentityRequestError,
+	},
+	NativeCheckpointRequestError, MAX_REQUEST_BYTES,
+};
+
+/// Stable request schema for finalized peg-in Frontier contract state.
+pub const REQUEST_SCHEMA: &str = "e2s.native-finalized-peg-in-frontier-contract-state-request.v1";
+/// Stable statement schema for exact Frontier contract state identities.
+pub const STATEMENT_SCHEMA: &str = "e2s.peg-in-frontier-contract-state-statement.v1";
+/// Stable successful verification schema.
+pub const VERIFICATION_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-frontier-contract-state-verification.v1";
+/// Stable successful verification status with its explicit trust-root limitation.
+pub const VERIFICATION_STATUS: &str =
+	"NATIVE_PEG_IN_FRONTIER_CONTRACT_STATE_VERIFIED_RELATIVE_TO_SUPPLIED_TRUST_ROOT_DIGEST";
+
+/// Exact contract addresses, keys, and expected runtime-code identities bound by the request.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct FrontierPegInContractStateStatementRequest {
+	/// Exact statement schema.
+	pub schema: String,
+	/// Exact bridge H160.
+	pub bridge_address_hex: String,
+	/// Exact token H160.
+	pub token_address_hex: String,
+	/// Exact bridge `EVM::AccountCodes` top-trie key.
+	pub bridge_account_code_storage_key_hex: String,
+	/// Exact token `EVM::AccountCodes` top-trie key.
+	pub token_account_code_storage_key_hex: String,
+	/// Exact bridge owner slot top-trie key.
+	pub bridge_owner_storage_key_hex: String,
+	/// Exact bridge packed configuration slot top-trie key.
+	pub bridge_configuration_storage_key_hex: String,
+	/// Exact `processedPegIns[ergoBoxId]` top-trie key.
+	pub processed_peg_in_storage_key_hex: String,
+	/// Exact token total-supply slot top-trie key.
+	pub token_total_supply_storage_key_hex: String,
+	/// Exact token owner slot top-trie key.
+	pub token_owner_storage_key_hex: String,
+	/// SHA-256 of exact decoded bridge runtime code.
+	pub bridge_runtime_code_sha256_hex: String,
+	/// Exact decoded bridge runtime-code byte count as a canonical decimal string.
+	pub bridge_runtime_code_bytes: String,
+	/// SHA-256 of exact decoded token runtime code.
+	pub token_runtime_code_sha256_hex: String,
+	/// Exact decoded token runtime-code byte count as a canonical decimal string.
+	pub token_runtime_code_bytes: String,
+}

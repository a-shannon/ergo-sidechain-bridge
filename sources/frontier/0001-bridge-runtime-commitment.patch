+pub fn derive_federated_source_proof_profile_id_v1(
+	profile: &FederatedSourceProofProfileV1,
+) -> Result<H256, &'static str> {
+	validate_federated_source_proof_profile_v1(profile)?;
+	let mut encoded =
+		Vec::with_capacity(1 + 2 + 2 + 8 + 32 + 4 + 32 + profile.signer_public_keys.len() * 32);
+	encoded.push(profile.format_version);
+	encoded.extend_from_slice(&profile.threshold.to_be_bytes());
+	encoded.extend_from_slice(&(profile.signer_public_keys.len() as u16).to_be_bytes());
+	encoded.extend_from_slice(&profile.max_validity_blocks.to_be_bytes());
+	encoded.extend_from_slice(profile.finality_policy_id.as_bytes());
+	encoded.extend_from_slice(&profile.required_confirmations.to_be_bytes());
+	encoded.extend_from_slice(profile.verifier_profile_id.as_bytes());
+	for signer in &profile.signer_public_keys {
+		encoded.extend_from_slice(signer);
+	}
+	Ok(domain_hash(SOURCE_PROOF_PROFILE_DOMAIN_V1, &encoded))
+}
+
+pub fn validate_federated_source_proof_profile_v1(
+	profile: &FederatedSourceProofProfileV1,
+) -> Result<(), &'static str> {
+	if profile.format_version != FEDERATED_SOURCE_PROOF_FORMAT_VERSION_V1
+		|| profile.threshold < 2
+		|| usize::from(profile.threshold) > profile.signer_public_keys.len()
+		|| profile.max_validity_blocks == 0
+		|| profile.max_validity_blocks > 1_024
+		|| profile.finality_policy_id == H256::zero()
+		|| profile.required_confirmations == 0
+		|| profile.verifier_profile_id == H256::zero()
+	{
+		return Err("federated source-proof profile is invalid");
+	}
+	let mut previous: Option<[u8; 32]> = None;
+	for signer in &profile.signer_public_keys {
+		if *signer == [0u8; 32] || previous.map(|value| value >= *signer).unwrap_or(false) {
+			return Err("federated source-proof signer keys are not canonical");
+		}
+		previous = Some(*signer);
+	}
+	Ok(())
+}
+
+pub fn derive_federated_source_proof_request_digest_v1(
+	validated: &ValidatedAdmissionV2,
+	source_intent_bytes: &[u8],
+	statement_bytes: &[u8],
+) -> H256 {
+	let mut bytes = Vec::with_capacity(32 + source_intent_bytes.len() + statement_bytes.len());
+	bytes.extend_from_slice(validated.profile_id.as_bytes());
+	bytes.extend_from_slice(source_intent_bytes);
+	bytes.extend_from_slice(statement_bytes);
+	domain_hash(SOURCE_PROOF_REQUEST_DOMAIN_V1, &bytes)
+}
+
+pub fn derive_federated_source_proof_result_id_v1(
+	result: &FederatedSourceProofResultV1,
+) -> Result<H256, &'static str> {
+	validate_source_proof_result_shape(result)?;
+	let mut encoded = Vec::with_capacity(1 + 9 * 32 + 16);
+	encoded.push(result.format_version);
+	for value in [
+		result.request_digest,
+		result.source_box_canonical_blake2b256,
+		result.commitment_transaction_canonical_blake2b256,
+		result.vault_successor_canonical_blake2b256,
+		result.inclusion_proof_blake2b256,
+		result.checkpoint_ancestry_blake2b256,
+		result.finality_proof_blake2b256,
+		result.verifier_executable_sha256,
+		result.verifier_profile_id,
+	] {
+		encoded.extend_from_slice(value.as_bytes());
+	}
+	encoded.extend_from_slice(&result.issued_at_native_height.to_be_bytes());
+	encoded.extend_from_slice(&result.expires_at_native_height.to_be_bytes());
+	Ok(domain_hash(SOURCE_PROOF_RESULT_DOMAIN_V1, &encoded))
+}
+
+pub fn derive_federated_source_proof_attestation_digest_v1(result_id: H256) -> H256 {
+	domain_hash(SOURCE_PROOF_ATTESTATION_DOMAIN_V1, result_id.as_bytes())
+}
+
+pub fn validate_federated_source_proof_v1(
+	profile: &FederatedSourceProofProfileV1,
+	validated: &ValidatedAdmissionV2,
+	source_intent_bytes: &[u8],
+	statement_bytes: &[u8],
+	current_native_height: u64,
+	envelope: &FederatedSourceProofEnvelopeV1,
+) -> Result<ValidatedFederatedSourceProofV1, &'static str> {
+	let profile_id = derive_federated_source_proof_profile_id_v1(profile)?;
+	if validated.profile.proof_system_id != federated_source_proof_system_id_v1()
+		|| validated.profile.proof_profile_id != profile_id
+		|| validated.profile.finality_policy_id != profile.finality_policy_id
+		|| validated.statement.required_confirmations != profile.required_confirmations
+	{
+		return Err("causal admission does not select the static federated source-proof profile");
+	}
+	let request_digest = derive_federated_source_proof_request_digest_v1(
+		validated,
+		source_intent_bytes,
+		statement_bytes,
+	);
+	if envelope.result.request_digest != request_digest
+		|| envelope.result.verifier_profile_id != profile.verifier_profile_id
+	{
+		return Err(
+			"federated source-proof result does not bind the exact request and verifier profile",
+		);
+	}
+	validate_validity_window(
+		envelope.result.issued_at_native_height,
+		envelope.result.expires_at_native_height,
+		current_native_height,
+		profile.max_validity_blocks,
+	)?;
+	let result_id = derive_federated_source_proof_result_id_v1(&envelope.result)?;
+	let attestation_digest = derive_federated_source_proof_attestation_digest_v1(result_id);
+	let signature_set_digest = validate_federated_threshold_signatures_v1(
+		&profile.signer_public_keys,
+		profile.threshold,
+		&envelope.signatures,
+		attestation_digest,
+		SOURCE_PROOF_SIGNATURE_SET_DOMAIN_V1,
+	)?;
+	let mut proof_preimage = Vec::with_capacity(64);
+	proof_preimage.extend_from_slice(result_id.as_bytes());
+	proof_preimage.extend_from_slice(signature_set_digest.as_bytes());
+	let proof_digest = domain_hash(SOURCE_PROOF_ENVELOPE_DOMAIN_V1, &proof_preimage);
+	Ok(ValidatedFederatedSourceProofV1 {
+		request_digest,
+		result_id,
+		proof_digest,
+		verifier_executable_sha256: envelope.result.verifier_executable_sha256,
+		verifier_profile_id: envelope.result.verifier_profile_id,
+		expires_at_native_height: envelope.result.expires_at_native_height,
+	})
+}
+
+pub fn derive_federated_source_invalidation_id_v1(
+	invalidation: &FederatedSourceInvalidationV1,
+) -> Result<H256, &'static str> {
+	if invalidation.format_version != FEDERATED_SOURCE_PROOF_FORMAT_VERSION_V1
+		|| invalidation.reason == CausalSourceInvalidationReasonV1::Expired
+		|| [
+			invalidation.profile_id,
+			invalidation.record_key,
+			invalidation.admission_id,
+			invalidation.source_proof_result_id,
+			invalidation.evidence_digest,
+			invalidation.observed_checkpoint_block_id,
+		]
+		.iter()
+		.any(|value| *value == H256::zero())
+	{
+		return Err("federated source invalidation is malformed");
+	}
+	let mut encoded = Vec::with_capacity(1 + 6 * 32 + 1 + 24);
+	encoded.push(invalidation.format_version);
+	encoded.extend_from_slice(invalidation.profile_id.as_bytes());
+	encoded.extend_from_slice(invalidation.record_key.as_bytes());
+	encoded.extend_from_slice(invalidation.admission_id.as_bytes());
+	encoded.extend_from_slice(invalidation.source_proof_result_id.as_bytes());
+	encoded.push(match invalidation.reason {
+		CausalSourceInvalidationReasonV1::StaleCheckpoint => 1,
+		CausalSourceInvalidationReasonV1::SourceReorg => 2,
+		CausalSourceInvalidationReasonV1::ConflictingSourceViews => 3,
+		CausalSourceInvalidationReasonV1::Expired => 4,
+	});
+	encoded.extend_from_slice(invalidation.evidence_digest.as_bytes());
+	encoded.extend_from_slice(invalidation.observed_checkpoint_block_id.as_bytes());
+	encoded.extend_from_slice(&invalidation.observed_checkpoint_height.to_be_bytes());
+	encoded.extend_from_slice(&invalidation.issued_at_native_height.to_be_bytes());
+	encoded.extend_from_slice(&invalidation.expires_at_native_height.to_be_bytes());
+	Ok(domain_hash(SOURCE_INVALIDATION_DOMAIN_V1, &encoded))
+}
+
+pub fn derive_federated_source_invalidation_attestation_digest_v1(invalidation_id: H256) -> H256 {
+	domain_hash(
+		SOURCE_INVALIDATION_ATTESTATION_DOMAIN_V1,
+		invalidation_id.as_bytes(),
+	)
+}
+
+pub fn validate_federated_source_invalidation_v1(
+	profile: &FederatedSourceProofProfileV1,
+	current_native_height: u64,
+	invalidation: &FederatedSourceInvalidationV1,
+) -> Result<ValidatedFederatedSourceInvalidationV1, &'static str> {
+	validate_federated_source_proof_profile_v1(profile)?;
+	validate_validity_window(
+		invalidation.issued_at_native_height,
+		invalidation.expires_at_native_height,
+		current_native_height,
+		profile.max_validity_blocks,
+	)?;
+	let invalidation_id = derive_federated_source_invalidation_id_v1(invalidation)?;
+	let attestation_digest =
+		derive_federated_source_invalidation_attestation_digest_v1(invalidation_id);
+	let signature_set_digest = validate_federated_threshold_signatures_v1(
+		&profile.signer_public_keys,
+		profile.threshold,
+		&invalidation.signatures,
+		attestation_digest,
+		SOURCE_INVALIDATION_SIGNATURE_SET_DOMAIN_V1,
+	)?;
+	let mut proof_preimage = Vec::with_capacity(64);
+	proof_preimage.extend_from_slice(invalidation_id.as_bytes());
+	proof_preimage.extend_from_slice(signature_set_digest.as_bytes());
+	let proof_digest = domain_hash(SOURCE_INVALIDATION_ENVELOPE_DOMAIN_V1, &proof_preimage);
+	Ok(ValidatedFederatedSourceInvalidationV1 {
+		invalidation_id,
+		proof_digest,
+	})
+}
+
+fn validate_source_proof_result_shape(
+	result: &FederatedSourceProofResultV1,
+) -> Result<(), &'static str> {
+	if result.format_version != FEDERATED_SOURCE_PROOF_FORMAT_VERSION_V1
+		|| [
+			result.request_digest,
+			result.source_box_canonical_blake2b256,
+			result.commitment_transaction_canonical_blake2b256,
+			result.vault_successor_canonical_blake2b256,
+			result.inclusion_proof_blake2b256,
+			result.checkpoint_ancestry_blake2b256,
+			result.finality_proof_blake2b256,
+			result.verifier_executable_sha256,
+			result.verifier_profile_id,
+		]
+		.iter()
+		.any(|value| *value == H256::zero())
+	{
+		return Err("federated source-proof result is malformed");
+	}
+	Ok(())
+}
+
+fn validate_validity_window(
+	issued_at_native_height: u64,
+	expires_at_native_height: u64,
+	current_native_height: u64,
+	max_validity_blocks: u64,
+) -> Result<(), &'static str> {
+	let validity_blocks = expires_at_native_height
+		.checked_sub(issued_at_native_height)
+		.ok_or("federated source-proof validity window is inverted")?;
+	if issued_at_native_height > current_native_height
+		|| current_native_height >= expires_at_native_height
+		|| validity_blocks > max_validity_blocks
+	{
+		return Err("federated source proof is stale or outside its bounded validity window");
+	}
+	Ok(())
+}
+
+pub fn validate_federated_threshold_signatures_v1(
+	signer_public_keys: &FederatedSourceProofSignerKeysV1,
+	threshold: u16,
+	signatures: &FederatedSourceProofSignaturesV1,
+	attestation_digest: H256,
+	proof_domain: &[u8],
+) -> Result<H256, &'static str> {
+	if threshold < 2
+		|| usize::from(threshold) > signer_public_keys.len()
+		|| proof_domain.is_empty()
+	{
+		return Err("federated threshold-signature policy is invalid");
+	}
+	let mut previous_key: Option<[u8; 32]> = None;
+	for signer in signer_public_keys {
+		if *signer == [0u8; 32]
+			|| previous_key
+				.map(|value| value >= *signer)
+				.unwrap_or(false)
+		{
+			return Err("federated threshold-signature keys are not canonical");
+		}
+		previous_key = Some(*signer);
+	}
+	if signatures.len() != usize::from(threshold) {
+		return Err("federated source proof does not contain the exact threshold signature set");
+	}
+	let mut previous: Option<[u8; 32]> = None;
+	let mut proof_bytes = Vec::with_capacity(signatures.len() * 96);
+	for item in signatures {
+		if previous
+			.map(|value| value >= item.signer_public_key)
+			.unwrap_or(false)
+			|| signer_public_keys.binary_search(&item.signer_public_key).is_err()
+		{
+			return Err("federated source-proof signatures are not canonical or registered");
+		}
+		let public = ed25519::Public::from_raw(item.signer_public_key);
+		let signature = ed25519::Signature::from_raw(item.signature);
+		if !sp_io::crypto::ed25519_verify(&signature, attestation_digest.as_bytes(), &public) {
+			return Err("federated source-proof signature is invalid");
+		}
+		previous = Some(item.signer_public_key);
+		proof_bytes.extend_from_slice(&item.signer_public_key);
+		proof_bytes.extend_from_slice(&item.signature);
+	}
+	Ok(domain_hash(proof_domain, &proof_bytes))
+}
+
+fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+	let mut preimage = Vec::with_capacity(domain.len() + bytes.len());
+	preimage.extend_from_slice(domain);
+	preimage.extend_from_slice(bytes);
+	H256::from(blake2_256(&preimage))
+}

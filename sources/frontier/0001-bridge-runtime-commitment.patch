+
+	#[test]
+	fn rejects_outer_schema_and_exact_receipt_status_key_drift() {
+		let anchor = deterministic_trusted_anchor_digest_hex();
+		let mut request = deterministic_fixture_request();
+		request.schema = "e2s.native-finalized-peg-in-frontier-event-request.v2".to_owned();
+		assert!(matches!(
+			verify_request_bytes(&serde_json::to_vec(&request).unwrap(), &anchor),
+			Err(NativeFrontierPegInEventRequestError::Schema)
+		));
+
+		let mut request = deterministic_fixture_request();
+		request.statement.schema = "e2s.peg-in-frontier-event-statement.v2".to_owned();
+		assert!(matches!(
+			verify_request_bytes(&serde_json::to_vec(&request).unwrap(), &anchor),
+			Err(NativeFrontierPegInEventRequestError::StatementSchema)
+		));
+
+		let mut request = deterministic_fixture_request();
+		request.statement.current_receipts_storage_key_hex = format_hash([0x99; 32].into());
+		assert!(matches!(
+			verify_request_bytes(&serde_json::to_vec(&request).unwrap(), &anchor),
+			Err(NativeFrontierPegInEventRequestError::CurrentReceiptsStorageKey)
+		));
+
+		let mut request = deterministic_fixture_request();
+		request
+			.statement
+			.current_transaction_statuses_storage_key_hex = format_hash([0x88; 32].into());
+		assert!(matches!(
+			verify_request_bytes(&serde_json::to_vec(&request).unwrap(), &anchor),
+			Err(NativeFrontierPegInEventRequestError::CurrentTransactionStatusesStorageKey)
+		));
+	}
+}

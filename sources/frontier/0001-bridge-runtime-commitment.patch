+fn assert_relay_runtime_witness_matches_statement_v1(
+	statement: &ValidatedErgoAutolykosCommittedVaultSourceProofStatementV1,
+	relay: &VerifiedErgoAutolykosV2RelayRuntimeWitnessV1,
+) -> Result<(), &'static str> {
+	if statement.spv_profile_id != relay.spv_profile_id
+		|| statement.source_network_id != relay.source_network_id
+		|| statement.checkpoint_header_id != relay.checkpoint_header_id
+		|| statement.checkpoint_height != relay.checkpoint_height
+		|| statement.known_branches_digest != relay.known_branches_digest
+		|| statement.known_branch_count != relay.known_branch_count
+		|| statement.selected_tip_header_id != relay.selected_tip_header_id
+		|| statement.selected_tip_height != relay.selected_tip_height
+		|| statement.selected_cumulative_work != relay.selected_cumulative_work.to_big_endian()
+		|| statement.target_header_id != relay.target_header_id
+		|| statement.target_height != relay.target_height
+		|| statement.target_block_version != relay.target_block_version
+		|| statement.target_transactions_root != relay.target_transactions_root
+		|| statement.target_canonical_header_sha256 != relay.target_canonical_header_sha256
+		|| statement.target_canonical_header_length != relay.target_canonical_header_length
+		|| statement.confirmations != relay.confirmations
+		|| statement.required_confirmations != relay.required_confirmations
+	{
+		return Err("Ergo relay runtime witness does not match the committed-vault statement");
+	}
+	Ok(())
+}

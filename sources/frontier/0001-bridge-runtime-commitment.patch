+	fn transaction_witness_section_ranges(bytes: &[u8]) -> [(usize, usize); 4] {
+		assert!(bytes.len() >= 72);
+		let mut ranges = [(0usize, 0usize); 4];
+		let mut start = 72usize;
+		for (index, range) in ranges.iter_mut().enumerate() {
+			let length_offset = 50 + index * 6;
+			let length =
+				u32::from_be_bytes(bytes[length_offset..length_offset + 4].try_into().unwrap())
+					as usize;
+			*range = (start, start + length);
+			start += length;
+		}
+		assert_eq!(start, bytes.len());
+		ranges
+	}

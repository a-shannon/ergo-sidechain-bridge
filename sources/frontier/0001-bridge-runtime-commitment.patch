+/// A reason the authenticated causal transition was rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum CausalPegInMintTransitionProofError {
+	/// Shared trie-proof bounds failed.
+	#[error(transparent)]
+	ProofBounds(#[from] FrontierExecutionIdentityProofError),
+	/// One proof does not reconstruct every exact requested key.
+	#[error("causal peg-in {state} proof is invalid for the authenticated state root")]
+	InvalidProof {
+		/// Parent or post state identity.
+		state: &'static str,
+	},
+	/// A required storage value is absent.
+	#[error("authenticated causal peg-in {field} is absent")]
+	MissingValue {
+		/// Stable field identity.
+		field: &'static str,
+	},
+	/// A SCALE value is malformed or noncanonical.
+	#[error("authenticated causal peg-in {field} SCALE value is malformed")]
+	MalformedScale {
+		/// Stable field identity.
+		field: &'static str,
+	},
+	/// A fixed-width causal wire value is malformed.
+	#[error("authenticated causal peg-in {field} wire value is malformed")]
+	MalformedWire {
+		/// Stable field identity.
+		field: &'static str,
+	},
+	/// The sticky causal migration flag is absent or false.
+	#[error("causal peg-in enforcement is not active in both states")]
+	EnforcementInactive,
+	/// Parent and child profiles differ.
+	#[error("causal peg-in runtime profile changed across the mint block")]
+	ProfileChanged,
+	/// The pending key collection is invalid or was not reduced exactly once.
+	#[error("causal peg-in pending-key transition is not one exact ordered deletion")]
+	PendingKeyTransition,
+	/// The direct parent does not contain one exact pending admission.
+	#[error("causal peg-in direct parent does not contain the exact pending admission")]
+	ParentPendingMismatch,
+	/// The parent receipt is absent, stale, or not bound to the exact pending admission.
+	#[error("causal peg-in direct parent does not contain the exact source-proof receipt")]
+	ParentReceiptMismatch,
+	/// Replay or consumed state already exists in the parent.
+	#[error("causal peg-in replay state already exists in the direct parent")]
+	ParentReplayPresent,
+	/// A threshold invalidation tombstone already exists in the parent.
+	#[error("causal peg-in invalidation tombstone exists in the direct parent")]
+	ParentInvalidationTombstonePresent,
+	/// The child retained pending state.
+	#[error("causal peg-in child retained the consumed pending admission")]
+	PostPendingPresent,
+	/// The child retained source-proof receipt state after consumption.
+	#[error("causal peg-in child retained the consumed source-proof receipt")]
+	PostReceiptPresent,
+	/// A threshold invalidation tombstone appeared in the mint child.
+	#[error("causal peg-in invalidation tombstone exists in the mint child")]
+	PostInvalidationTombstonePresent,
+	/// The child record key/value is not the exact V1 successor.
+	#[error("causal peg-in child processed record is not the exact successor")]
+	PostRecordMismatch,
+	/// The child V3 key/value is not the exact consumed successor.
+	#[error("causal peg-in child consumed admission is not the exact successor")]
+	PostConsumedMismatch,
+	/// One non-target pending entry disappeared or changed across the transition.
+	#[error("causal peg-in non-target pending admission changed across the transition")]
+	RemainingPendingChanged,
+	/// One non-target admission receipt disappeared or changed across the transition.
+	#[error("causal peg-in non-target source-proof receipt changed across the transition")]
+	RemainingReceiptChanged,
+	/// The supplied execution binding is not one consecutive parent/child pair.
+	#[error("causal peg-in execution binding is not one consecutive native parent/child pair")]
+	NonConsecutiveBinding,
+}

+		let receipts = vec![
+			receipt(1, vec![wrong_address.clone(), accepted.clone()]),
+			receipt(0, vec![reverted.clone()]),
+		];
+		let statuses = vec![
+			status(H256::repeat_byte(0x31), 0, vec![wrong_address, accepted]),
+			status(H256::repeat_byte(0x32), 1, vec![reverted]),
+		];
+		let profile = peg_in_profile(bridge_address, 7, 1_000);
+
+		let records = collect_peg_in_records(

+/// Derive the fixed-width V1 digest for a public GRANDPA deployment trust anchor.
+pub fn derive_grandpa_trust_anchor_digest(
+	sidechain_id: H256,
+	checkpoint_hash: H256,
+	checkpoint_number: u64,
+	set_id: SetId,
+	authorities: &AuthorityList,
+) -> H256 {
+	let authority_hash = derive_grandpa_authority_set_hash(authorities);
+
+	let mut preimage = GRANDPA_TRUST_ANCHOR_DOMAIN.to_vec();
+	preimage.extend(sidechain_id.as_bytes());
+	preimage.extend(checkpoint_hash.as_bytes());
+	preimage.extend(checkpoint_number.to_be_bytes());
+	preimage.extend(set_id.to_be_bytes());
+	preimage.extend(authority_hash.as_bytes());
+	BlakeTwo256::hash(&preimage)
+}
+
+/// Derive the canonical bridge-domain digest of one SCALE-encoded GRANDPA authority list.
+pub fn derive_grandpa_authority_set_hash(authorities: &AuthorityList) -> H256 {
+	let mut preimage = GRANDPA_AUTHORITY_SET_DOMAIN.to_vec();
+	preimage.extend(authorities.encode());
+	BlakeTwo256::hash(&preimage)
+}

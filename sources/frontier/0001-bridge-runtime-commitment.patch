+fn derive_supplied_branches_digest_v2(relay_bytes: &[u8]) -> Result<H256, &'static str> {
+	if relay_bytes.len() < RELAY_ENVELOPE_HEADER_BYTES_V1 {
+		return Err("relay witness is truncated before branch digest derivation");
+	}
+	let profile_length = u32_at(relay_bytes, 50) as usize;
+	let checkpoint_length = u32_at(relay_bytes, 56) as usize;
+	let branches_length = u32_at(relay_bytes, 62) as usize;
+	let start = RELAY_ENVELOPE_HEADER_BYTES_V1
+		.checked_add(profile_length)
+		.and_then(|value| value.checked_add(checkpoint_length))
+		.ok_or("relay branch section offset overflows")?;
+	let end = start
+		.checked_add(branches_length)
+		.ok_or("relay branch section length overflows")?;
+	if end > relay_bytes.len() {
+		return Err("relay branch section exceeds the verified witness boundary");
+	}
+	let mut bytes = Vec::with_capacity(SUPPLIED_BRANCHES_DOMAIN_V2.len() + branches_length);
+	bytes.extend_from_slice(SUPPLIED_BRANCHES_DOMAIN_V2);
+	bytes.extend_from_slice(&relay_bytes[start..end]);
+	Ok(H256::from(blake2_256(&bytes)))
+}
+
+fn h256_at(bytes: &[u8], offset: usize) -> H256 {
+	H256::from_slice(&bytes[offset..offset + 32])
+}
+
+fn u16_at(bytes: &[u8], offset: usize) -> u16 {
+	u16::from_be_bytes(
+		bytes[offset..offset + 2]
+			.try_into()
+			.expect("bounded V2 slice"),
+	)
+}
+
+fn u32_at(bytes: &[u8], offset: usize) -> u32 {
+	u32::from_be_bytes(
+		bytes[offset..offset + 4]
+			.try_into()
+			.expect("bounded V2 slice"),
+	)
+}
+
+fn u64_at(bytes: &[u8], offset: usize) -> u64 {
+	u64::from_be_bytes(
+		bytes[offset..offset + 8]
+			.try_into()
+			.expect("bounded V2 slice"),
+	)
+}

+//! Strict offline verification for finalized Peg-In Runtime State V1.
+//!
+//! This request and result family is intentionally separate from the burn-only checkpoint V2
+//! contract. It authenticates one exact historical processed-deposit membership, or one active
+//! profile plus current non-membership. It performs no RPC, signing, transaction construction, or
+//! mint authorization.
+
+use bridge_finality_proof::{
+	MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS, MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+	MAX_FINALITY_PROOF_BYTES,
+};
+use bridge_state_proof::{
+	derive_grandpa_authority_set_hash,
+	peg_in::{
+		PegInRecordStateV1, PegInRuntimeProfileV1, PegInRuntimeRecordV1,
+		PegInRuntimeStateExpectationV1, MAX_PEG_IN_STATE_PROOF_NODES,
+		MAX_PEG_IN_STATE_PROOF_NODE_BYTES, PEG_IN_PROFILE_V1_SCALE_BYTES,
+		PEG_IN_RECORD_V1_SCALE_BYTES,
+	},
+	verify_peg_in_deployment_checkpoint, GrandpaDeploymentTrustAnchor,
+	LinkedGrandpaAuthorityProofChunk, PegInDeploymentCheckpointError,
+	MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+};
+use scale_codec::{DecodeAll, Encode};
+use serde::{Deserialize, Serialize};
+use sp_consensus_grandpa::AuthorityList;
+use sp_runtime::traits::{BlakeTwo256, Hash as _, Header as _};
+use thiserror::Error;
+
+use crate::{
+	ensure_collection, format_bytes, format_hash, parse_byte_hex, parse_decimal_u64, parse_hash,
+	LinkedGrandpaProofRequest, NativeBlock, NativeCheckpointRequestError, NativeHeader,
+	TrustAnchorRequest, VerifiedAuthorityOutput, VerifiedFinalityOutput, VerifiedTargetOutput,
+	MAX_AUTHORITY_LIST_BYTES, MAX_NATIVE_HEADER_BYTES, MAX_REQUEST_BYTES,
+};
+
+/// Stable request schema for the separate finalized peg-in state profile.
+pub const REQUEST_SCHEMA: &str = "e2s.native-finalized-peg-in-state-request.v1";
+/// Stable statement schema for branch-specific processed-deposit state.
+pub const STATEMENT_SCHEMA: &str = "e2s.peg-in-runtime-state-statement.v1";
+/// Stable successful result schema for the separate finalized peg-in state profile.
+pub const VERIFICATION_SCHEMA: &str = "e2s.native-finalized-peg-in-state-verification.v1";
+
+/// Exact expected state of one derived processed-deposit key.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(
+	tag = "outcome",
+	rename_all = "camelCase",
+	rename_all_fields = "camelCase",
+	deny_unknown_fields
+)]
+pub enum PegInRecordExpectationRequest {
+	/// Require the exact expected V1 record to be present.
+	Membership {
+		/// Canonical fixed-width V1 record SCALE bytes.
+		expected_record_scale_hex: String,
+	},
+	/// Require the exact derived key to be absent at the target state root.
+	NonMembership,
+}
+
+/// Versioned peg-in statement bound into the native request digest.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PegInStateStatementRequest {
+	/// Exact statement schema.
+	pub schema: String,
+	/// Canonical nonzero Ergo deposit box identity.
+	pub ergo_box_id_hex: String,
+	/// Exact expected current profile SCALE bytes, required only for non-membership.
+	#[serde(skip_serializing_if = "Option::is_none")]
+	pub expected_profile_scale_hex: Option<String>,
+	/// Exact membership or current non-membership requirement.
+	pub record: PegInRecordExpectationRequest,
+}
+
+/// Complete finalized Peg-In Runtime State V1 verification request.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativePegInStateRequest {
+	/// Exact request schema.
+	pub schema: String,
+	/// Public deployment trust root.
+	pub trust_anchor: TrustAnchorRequest,
+	/// Expected hash of the requested native block.
+	pub target_native_block_hash_hex: String,
+	/// Canonical SCALE requested native header.
+	pub target_header_scale_hex: String,
+	/// Hash-linked authority-transition proofs from the public trust root.
+	pub linked_grandpa_proofs: Vec<LinkedGrandpaProofRequest>,
+	/// Contiguous headers after the last linked handoff through the finality horizon.
+	pub checkpoint_tail_headers_scale_hex: Vec<String>,
+	/// Canonical SCALE `grandpa_proveFinality` response for the target.
+	pub finality_proof_scale_hex: String,
+	/// Peg-In Runtime State V1 statement.
+	pub statement: PegInStateStatementRequest,
+	/// One raw trie proof covering the exact keys required by the statement branch.
+	pub runtime_state_proof_nodes_hex: Vec<String>,
+}
+
+/// Verified exact profile plus processed-record trie state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedPegInRuntimeStateOutput {
+	/// Fixed `CurrentPegInProfile` storage key for non-membership, or `null` for membership.
+	pub profile_storage_key_hex: Option<String>,
+	/// Canonical authenticated profile SCALE value for non-membership, or `null` for membership.
+	pub profile_storage_value_scale_hex: Option<String>,
+	/// Exact internally derived `ProcessedPegIns` storage key.
+	pub record_storage_key_hex: String,
+	/// Canonical authenticated record SCALE value, or `null` for proved absence.
+	pub record_storage_value_scale_hex: Option<String>,
+	/// `MEMBERSHIP` or `NON_MEMBERSHIP` as required by the request statement.
+	pub outcome: String,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+	/// Confirms the exact statement-specific key reads were verified against the target state root.
+	pub verified: bool,
+}
+
+/// Typed current profile recovered from authenticated runtime state.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]

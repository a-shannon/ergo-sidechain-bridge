@@ -0,0 +1,61 @@
+//! Standard-input entrypoint for strict read-only RPC proof normalization.
+
+use std::{
+	env,
+	io::{self, Read},
+	process::ExitCode,
+};
+
+use bridge_checkpoint_verifier::{
+	rpc_codec::{
+		encode_rpc_headers_request_bytes, inspect_rpc_finality_proof_request_bytes,
+		inspect_rpc_warp_proof_request_bytes,
+	},
+	MAX_REQUEST_BYTES,
+};
+
+fn main() -> ExitCode {
+	match run() {
+		Ok(()) => ExitCode::SUCCESS,
+		Err(error) => {
+			eprintln!("bridge RPC proof codec failed: {error}");
+			ExitCode::from(2)
+		}
+	}
+}
+
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+	let mut arguments = env::args();
+	let _program = arguments.next();
+	let mode = arguments.next().ok_or(
+		"expected one of --encode-headers, --inspect-warp-proof, or --inspect-finality-proof",
+	)?;
+	if arguments.next().is_some() {
+		return Err("expected exactly one RPC codec mode".into());
+	}
+
+	let mut request = Vec::new();
+	io::stdin()
+		.take((MAX_REQUEST_BYTES + 1) as u64)
+		.read_to_end(&mut request)?;
+	let stdout = io::stdout();
+	let mut output = stdout.lock();
+	match mode.as_str() {
+		"--encode-headers" => {
+			serde_json::to_writer(&mut output, &encode_rpc_headers_request_bytes(&request)?)?
+		}
+		"--inspect-warp-proof" => serde_json::to_writer(
+			&mut output,
+			&inspect_rpc_warp_proof_request_bytes(&request)?,
+		)?,
+		"--inspect-finality-proof" => serde_json::to_writer(
+			&mut output,
+			&inspect_rpc_finality_proof_request_bytes(&request)?,
+		)?,
+		_ => return Err(
+			"expected one of --encode-headers, --inspect-warp-proof, or --inspect-finality-proof"
+				.into(),
+		),
+	}
+	Ok(())
+}

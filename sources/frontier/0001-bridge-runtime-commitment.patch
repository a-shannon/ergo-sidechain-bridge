@@ -0,0 +1,1079 @@
+//! Finalized-state proof profile for Peg-In Runtime State V1.
+//!
+//! This module is deliberately separate from the burn-only bridge commitment verifier. It proves
+//! exact membership of one historical processed-deposit key, or one exact active profile plus
+//! current non-membership of that key. The result authenticates runtime state only; it does not
+//! authorize a mint.
+
+use bridge_finality_proof::{
+	verify_grandpa_finality_proof, BridgeFinalityProofError, VerifiedGrandpaFinalityProof,
+};
+use scale_codec::{Decode, DecodeAll, Encode};
+use sp_consensus_grandpa::{AuthorityList, SetId};
+use sp_core::{blake2_128, H160, H256};
+use sp_runtime::traits::{
+	BlakeTwo256, Block as BlockT, CheckedAdd, Hash as HashT, Header as HeaderT,
+};
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+/// Stable top-trie key for `BridgeCommitment::CurrentPegInProfile`.
+pub const CURRENT_PEG_IN_PROFILE_STORAGE_KEY: [u8; 32] = [
+	0xaf, 0x86, 0xfe, 0xf4, 0x21, 0x6a, 0xc2, 0xbc, 0xd1, 0xc5, 0x92, 0xb2, 0x04, 0x01, 0x1a, 0xd0,
+	0xd4, 0xe9, 0xff, 0xac, 0x40, 0x24, 0x6e, 0x76, 0xbb, 0x00, 0xb9, 0x03, 0x13, 0x73, 0xd2, 0xc3,
+];
+/// Stable pallet/storage prefix for `BridgeCommitment::ProcessedPegIns`.
+pub const PROCESSED_PEG_INS_STORAGE_PREFIX: [u8; 32] = [
+	0xaf, 0x86, 0xfe, 0xf4, 0x21, 0x6a, 0xc2, 0xbc, 0xd1, 0xc5, 0x92, 0xb2, 0x04, 0x01, 0x1a, 0xd0,
+	0xe6, 0x83, 0xc5, 0x28, 0xc6, 0xfc, 0x80, 0x06, 0x64, 0x5f, 0xa5, 0x98, 0x91, 0x73, 0xf2, 0xe0,
+];
+/// Domain used by the runtime to derive one permanent processed-deposit identity.
+pub const PEG_IN_RECORD_KEY_DOMAIN: &[u8] = b"E2S_PEG_IN_RECORD_KEY_V1";
+/// Exact SCALE size of Peg-In Runtime Profile V1.
+pub const PEG_IN_PROFILE_V1_SCALE_BYTES: usize = 69;
+/// Exact SCALE size of Peg-In Runtime Record V1.
+pub const PEG_IN_RECORD_V1_SCALE_BYTES: usize = 205;
+/// Exact complete trie-key size for one `Blake2_128Concat` processed-deposit entry.
+pub const PROCESSED_PEG_IN_STORAGE_KEY_BYTES: usize = 80;
+/// Maximum raw trie nodes accepted for the two-key profile proof.
+pub const MAX_PEG_IN_STATE_PROOF_NODES: usize = 256;
+/// Maximum aggregate raw trie-node bytes accepted for the two-key profile proof.
+pub const MAX_PEG_IN_STATE_PROOF_BYTES: usize = 256 * 1024;
+/// Maximum individual trie-node size accepted for the two-key profile proof.
+pub const MAX_PEG_IN_STATE_PROOF_NODE_BYTES: usize = 64 * 1024;
+
+/// Canonical SCALE value stored by `BridgeCommitment::CurrentPegInProfile`.
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+pub struct PegInRuntimeProfileV1 {
+	/// Profile format version. V1 is the only accepted value.
+	pub format_version: u8,
+	/// Native sidechain identity, normally its genesis hash.
+	pub sidechain_id: H256,
+	/// Configured EVM bridge contract.
+	pub bridge_address: H160,
+	/// Monotonic root-configuration generation.
+	pub profile_revision: u64,
+	/// Native block in which this generation was activated.
+	pub activation_height: u64,
+}
+
+/// Canonical SCALE value stored by `BridgeCommitment::ProcessedPegIns`.
+#[derive(Clone, Debug, Decode, Encode, Eq, PartialEq)]
+pub struct PegInRuntimeRecordV1 {
+	/// Record format version. V1 is the only accepted value.
+	pub format_version: u8,
+	/// Native sidechain identity.
+	pub sidechain_id: H256,
+	/// Bridge contract that emitted the accepted event.
+	pub bridge_address: H160,
+	/// Profile generation active for the accepted event.
+	pub profile_revision: u64,
+	/// Activation height of that historical generation.
+	pub profile_activation_height: u64,
+	/// Canonical Ergo deposit box identity.
+	pub ergo_box_id: H256,
+	/// Sidechain mint recipient.
+	pub recipient: H160,
+	/// Raw nanoERG amount.
+	pub amount: u64,
+	/// Native height that persisted this record.
+	pub sidechain_height: u64,
+	/// Frontier execution block containing the event.
+	pub execution_block_hash: H256,
+	/// Frontier transaction containing the event.
+	pub transaction_hash: H256,
+	/// Canonical global event index in the Frontier block.
+	pub event_index: u32,
+}
+
+/// Authenticated state of the exact processed-deposit key requested by the statement.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum PegInRecordStateV1 {
+	/// The exact expected V1 record is present.
+	Member(PegInRuntimeRecordV1),
+	/// The exact derived key is absent at the authenticated state root.
+	Absent,
+}
+
+/// Exact state predicate requested for one processed-deposit key.
+///
+/// Historical membership is self-contained in the permanent record and remains provable after
+/// the current profile is disabled or rotated. Current non-membership is meaningful only relative
+/// to one exact active profile, so that branch authenticates both keys in the same state proof.
+#[derive(Clone, Copy, Debug)]
+pub enum PegInRuntimeStateExpectationV1<'a> {
+	/// Require one exact historical V1 record.
+	Member(&'a PegInRuntimeRecordV1),
+	/// Require the derived record key to be absent under one exact active V1 profile.
+	NonMember(&'a PegInRuntimeProfileV1),
+}
+
+/// A reason the Peg-In Runtime State V1 proof was rejected.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum PegInStateProofError {
+	/// No trie nodes were supplied.
+	#[error("peg-in runtime state proof is empty")]
+	EmptyProof,
+	/// The proof contains more nodes than the profile permits.
+	#[error("peg-in runtime state proof contains too many nodes: {actual} > {max}")]
+	TooManyNodes {
+		/// Supplied node count.
+		actual: usize,
+		/// Configured maximum node count.
+		max: usize,
+	},
+	/// One trie node exceeds the per-node byte limit.
+	#[error("peg-in runtime state proof node {index} exceeds {max} bytes: {actual}")]
+	NodeTooLarge {
+		/// Zero-based node index.
+		index: usize,
+		/// Supplied node size.
+		actual: usize,
+		/// Configured maximum node size.
+		max: usize,
+	},
+	/// The aggregate trie proof exceeds the byte limit.
+	#[error("peg-in runtime state proof exceeds {max} bytes: {actual}")]
+	ProofTooLarge {
+		/// Supplied aggregate node bytes.
+		actual: usize,
+		/// Configured maximum bytes.
+		max: usize,
+	},
+	/// The raw proof repeats an encoded trie node.
+	#[error("peg-in runtime state proof contains duplicate nodes")]
+	DuplicateNodes,
+	/// The supplied nodes do not reconstruct both requested reads under the state root.
+	#[error("peg-in runtime state proof is invalid for the authenticated state root")]
+	InvalidProof,
+	/// The active profile key is absent.
+	#[error("current peg-in profile is absent from authenticated runtime state")]
+	ProfileMissing,
+	/// The profile storage value has the wrong fixed width.
+	#[error("peg-in runtime profile SCALE value must be exactly {expected} bytes, got {actual}")]
+	ProfileLength {
+		/// Supplied storage value length.
+		actual: usize,
+		/// Required V1 length.
+		expected: usize,
+	},
+	/// The profile storage value is not canonical V1 SCALE.
+	#[error("peg-in runtime profile SCALE value is malformed")]
+	ProfileDecode,
+	/// The authenticated profile differs from the exact statement value.
+	#[error("authenticated peg-in runtime profile differs from the expected statement")]
+	ProfileMismatch,
+	/// Only profile V1 is accepted.
+	#[error("unsupported peg-in runtime profile format version: {0}")]
+	UnsupportedProfileFormat(u8),
+	/// The profile belongs to another sidechain.
+	#[error("peg-in runtime profile sidechain identity does not match the trusted domain")]
+	ProfileSidechainMismatch,
+	/// The configured bridge address is zero.
+	#[error("peg-in runtime profile bridge address is zero")]
+	ZeroProfileBridgeAddress,
+	/// A revision must be positive.
+	#[error("peg-in runtime profile revision is zero")]
+	ZeroProfileRevision,
+	/// The profile cannot be activated at or after the proved header.
+	#[error("peg-in runtime profile is not active before the authenticated header")]
+	ProfileNotActive,
+	/// The derived record-key preimage contains a zero deposit identity.
+	#[error("peg-in runtime statement Ergo box ID is zero")]
+	ZeroErgoBoxId,
+	/// A membership statement proved absence.
+	#[error("processed peg-in record is absent from authenticated runtime state")]
+	RecordMissing,
+	/// A non-membership statement proved a value.
+	#[error("processed peg-in record is present but the statement requires non-membership")]
+	UnexpectedRecord,
+	/// The record storage value has the wrong fixed width.
+	#[error("peg-in runtime record SCALE value must be exactly {expected} bytes, got {actual}")]
+	RecordLength {
+		/// Supplied storage value length.
+		actual: usize,
+		/// Required V1 length.
+		expected: usize,
+	},
+	/// The record storage value is not canonical V1 SCALE.
+	#[error("peg-in runtime record SCALE value is malformed")]
+	RecordDecode,
+	/// The authenticated record differs from the exact membership statement.
+	#[error("authenticated peg-in runtime record differs from the expected statement")]
+	RecordMismatch,
+	/// Only record V1 is accepted.
+	#[error("unsupported peg-in runtime record format version: {0}")]
+	UnsupportedRecordFormat(u8),
+	/// The record belongs to another sidechain.
+	#[error("peg-in runtime record sidechain identity does not match the trusted domain")]
+	RecordSidechainMismatch,
+	/// The record is stored under a different deposit identity.
+	#[error("peg-in runtime record Ergo box ID does not match the derived storage key")]
+	RecordErgoBoxMismatch,
+	/// The historical record contains a zero bridge address.
+	#[error("peg-in runtime record bridge address is zero")]
+	ZeroRecordBridgeAddress,
+	/// The historical record contains a zero profile revision.
+	#[error("peg-in runtime record profile revision is zero")]
+	ZeroRecordProfileRevision,
+	/// The record did not follow its historical profile activation.
+	#[error("peg-in runtime record does not follow its profile activation block")]
+	RecordBeforeProfileActivation,
+	/// The record claims a height after the authenticated header.
+	#[error("peg-in runtime record height exceeds the authenticated header")]
+	RecordAfterAuthenticatedHeader,
+	/// The record recipient is zero.
+	#[error("peg-in runtime record recipient is zero")]
+	ZeroRecordRecipient,
+	/// The record amount is zero.
+	#[error("peg-in runtime record amount is zero")]
+	ZeroRecordAmount,
+	/// The ERG-lane record amount cannot be represented by an Ergo Long.
+	#[error("peg-in runtime record amount exceeds the positive Ergo Long range")]
+	RecordAmountExceedsErgoLong,
+	/// The record execution block hash is zero.
+	#[error("peg-in runtime record execution block hash is zero")]
+	ZeroExecutionBlockHash,
+	/// The record transaction hash is zero.
+	#[error("peg-in runtime record transaction hash is zero")]
+	ZeroTransactionHash,
+}

+			);
+			let runtime_profile = CurrentPooledReserveMintReservationProfileV4::<T>::get()
+				.ok_or(Error::<T>::InvalidPooledReserveMintReservationProfile)?;
+			let profile_id = validate_pooled_reserve_mint_reservation_runtime_profile_v4::<T>(
+				&runtime_profile,
+				current_height,
+			)
+			.map_err(|_| Error::<T>::InvalidPooledReserveMintReservationProfile)?;
+			let mut pending_keys = validated_pooled_reserve_mint_reservation_index_v4::<T>()?;
+			let pending = PendingPooledReserveMintReservationsV4::<T>::get(mint_identity);
+			let consumed =
+				ConsumedPooledReserveMintReservationsV4::<T>::contains_key(mint_identity);
+			let invalidated =
+				InvalidatedPooledReserveMintReservationsV4::<T>::contains_key(mint_identity);
+			ensure!(
+				!(pending.is_some() && (consumed || invalidated)) && !(consumed && invalidated),
+				Error::<T>::InvalidPooledReserveMintReservationState
+			);
+			ensure!(
+				!invalidated,
+				Error::<T>::PooledReserveMintReservationPermanentlyInvalidated
+			);
+			ensure!(
+				!consumed,
+				Error::<T>::PooledReserveMintReservationAlreadyExists
+			);
+			let pending = pending.ok_or(Error::<T>::PooledReserveMintReservationMissing)?;
+			validate_pending_pooled_reserve_mint_reservation_v4::<T>(
+				&runtime_profile,
+				profile_id,
+				&pending,
+				current_height,
+			)?;
+			let verified =
+				T::PooledReserveMintReservationSourceProofVerifier::verify_invalidation(
+					&runtime_profile,
+					&pending,
+					current_height,
+					&invalidation,
+				)
+				.map_err(|_| Error::<T>::InvalidPooledReserveMintReservationInvalidation)?;
+			ensure!(
+				verified.runtime_profile_id == profile_id
+					&& verified.statement_id == pending.statement_id
+					&& verified.mint_identity == mint_identity
+					&& verified.source_proof_result_id == pending.source_proof_result_id
+					&& verified.reason_code
+						!= POOLED_RESERVE_MINT_RESERVATION_INVALIDATION_REASON_EXPIRED_V4
+					&& verified.invalidation_id != H256::zero()
+					&& verified.proof_digest != H256::zero()
+					&& verified.issued_at_native_height <= current_height
+					&& verified.expires_at_native_height > current_height,
+				Error::<T>::InvalidPooledReserveMintReservationInvalidation
+			);
+			let removal_index = pending_keys
+				.binary_search(&mint_identity)
+				.map_err(|_| Error::<T>::InvalidPooledReserveMintReservationIndex)?;
+			pending_keys.remove(removal_index);
+			let pending_keys: BoundedVec<H256, T::MaxPegInsPerBlock> = pending_keys
+				.try_into()
+				.map_err(|_| Error::<T>::InvalidPooledReserveMintReservationIndex)?;
+			let tombstone = InvalidatedPooledReserveMintReservationV4 {
+				format_version: POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4,
+				profile_id,
+				statement_id: pending.statement_id,
+				mint_identity,
+				invalidated_at_native_height: current_height,
+				reason_code: verified.reason_code,
+				invalidation_id: verified.invalidation_id,
+			};
+
+			PendingPooledReserveMintReservationsV4::<T>::remove(mint_identity);
+			PendingPooledReserveMintReservationKeysV4::<T>::put(pending_keys);
+			InvalidatedPooledReserveMintReservationsV4::<T>::insert(mint_identity, &tombstone);
+			Self::deposit_event(Event::PooledReserveMintReservationInvalidatedV4 {
+				mint_identity,
+				statement_id: tombstone.statement_id,
+				profile_id,
+				source_proof_result_id: pending.source_proof_result_id,
+				invalidated_at_native_height: current_height,
+				reason_code: tombstone.reason_code,
+				invalidation_id: tombstone.invalidation_id,
+			});
+			Ok(())
+		}
+	}
+}

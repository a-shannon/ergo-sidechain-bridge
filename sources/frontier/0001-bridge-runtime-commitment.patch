+//! Authenticated causal admission consumption across one native parent/child pair.
+//!
+//! This profile proves the runtime-side half of a causal peg-in transition under the same
+//! consecutive state roots used by the Frontier mint-transition verifier. It authenticates one
+//! pending V2 admission plus its authenticated source-proof receipt in the direct parent, absence
+//! of the permanent invalidation tombstone in both states, exact deletion of the live admission,
+//! and exact creation of the permanent V1 replay record plus consumed V3 record in the child. The
+//! receipt authenticates provenance selected by the explicitly federated runtime profile; it does
+//! not turn that compatibility profile into trustless Ergo consensus.
+
+use scale_codec::{Decode, DecodeAll, Encode};
+use sp_core::{blake2_128, hashing::blake2_256, twox_128, H160, H256};
+use sp_runtime::traits::BlakeTwo256;
+use sp_state_machine::{read_proof_check, StorageProof};
+use thiserror::Error;
+
+use crate::{
+	peg_in::{

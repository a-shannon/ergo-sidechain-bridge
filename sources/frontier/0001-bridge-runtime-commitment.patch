+fn domain_hash(domain: &[u8], body: &[u8]) -> H256 {
+	let mut bytes = Vec::with_capacity(domain.len() + body.len());
+	bytes.extend_from_slice(domain);
+	bytes.extend_from_slice(body);
+	H256::from(blake2_256(&bytes))
+}
+
+fn h256_at(bytes: &[u8], offset: usize) -> H256 {
+	H256::from_slice(&bytes[offset..offset + 32])
+}
+
+fn is_zero(bytes: &[u8]) -> bool {
+	bytes.iter().all(|value| *value == 0)
+}
+
+fn u16_at(bytes: &[u8], offset: usize) -> u16 {
+	u16::from_be_bytes(
+		bytes[offset..offset + 2]
+			.try_into()
+			.expect("bounded statement slice"),
+	)
+}
+
+fn u32_at(bytes: &[u8], offset: usize) -> u32 {
+	u32::from_be_bytes(
+		bytes[offset..offset + 4]
+			.try_into()
+			.expect("bounded statement slice"),
+	)
+}
+
+fn u64_at(bytes: &[u8], offset: usize) -> u64 {
+	u64::from_be_bytes(
+		bytes[offset..offset + 8]
+			.try_into()
+			.expect("bounded statement slice"),
+	)
+}

+		.unwrap();
+		assert_eq!(finality.horizon_hash_hex, warp.source_target_hash_hex);
+		assert_eq!(finality.horizon_number, warp.source_target_number);
+		assert_eq!(finality.unknown_header_count, 2);
+		assert!(!finality.cryptographically_verified);

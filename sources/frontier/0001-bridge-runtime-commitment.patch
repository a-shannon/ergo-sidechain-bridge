+fn verify_checkpoint_tail<Block>(
+	start_hash: H256,
+	start_number: NumberFor<Block>,
+	headers: &[Block::Header],
+	expected_horizon_hash: H256,
+	expected_horizon_number: NumberFor<Block>,
+) -> Result<(), DeploymentCheckpointError>
+where
+	Block: BlockT<Hash = H256>,
+	NumberFor<Block>: CheckedAdd + Copy + Zero,
+{
+	if headers.len() > MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS {
+		return Err(DeploymentCheckpointError::TooManyFinalityAncestryHeaders {
+			actual: headers.len(),
+			max: MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+		});
+	}
+
+	let mut current_hash = start_hash;
+	let mut current_number = start_number;
+	for (header, item) in headers.iter().enumerate() {
+		let expected_number = current_number
+			.checked_add(&One::one())
+			.ok_or(DeploymentCheckpointError::FinalityAncestryNumberMismatch { header })?;
+		if *item.number() != expected_number {
+			return Err(DeploymentCheckpointError::FinalityAncestryNumberMismatch { header });
+		}
+		if *item.parent_hash() != current_hash {
+			return Err(DeploymentCheckpointError::FinalityAncestryParentMismatch { header });
+		}
+		if find_forced_change::<Block>(item).is_some() {
+			return Err(DeploymentCheckpointError::FinalityAncestryForcedChange { header });
+		}
+		if let Some(change) = find_scheduled_change::<Block>(item) {
+			let is_horizon = item.hash() == expected_horizon_hash
+				&& *item.number() == expected_horizon_number
+				&& header == headers.len() - 1;
+			if !is_horizon {
+				return Err(
+					DeploymentCheckpointError::FinalityAncestryEarlyScheduledChange { header },
+				);
+			}
+			if !change.delay.is_zero() {
+				return Err(DeploymentCheckpointError::FinalityAncestryDelayedTerminalChange);
+			}
+		}
+		current_hash = item.hash();
+		current_number = expected_number;
+	}
+
+	if current_hash != expected_horizon_hash || current_number != expected_horizon_number {
+		return Err(DeploymentCheckpointError::FinalityHorizonMismatch);
+	}
+	Ok(())
+}
+
+fn verify_requested_header_and_finality_ancestry<Block>(
+	anchor: &GrandpaDeploymentTrustAnchor<Block>,
+	requested_header: &Block::Header,
+	linked_proofs: &[LinkedGrandpaAuthorityProofChunk<Block>],
+	checkpoint_tail_headers: &[Block::Header],
+	finality_unknown_headers: &[Block::Header],
+) -> Result<(), DeploymentCheckpointError>
+where
+	Block: BlockT<Hash = H256>,
+	NumberFor<Block>: Copy + PartialEq,
+{
+	let requested_hash = requested_header.hash();
+	let requested_number = *requested_header.number();
+	let mut checkpoint_headers = Vec::new();
+	for linked in linked_proofs {
+		checkpoint_headers.extend(linked.ancestry_headers.iter());
+	}
+	checkpoint_headers.extend(checkpoint_tail_headers.iter());
+
+	let finality_suffix = if requested_number == anchor.checkpoint_number
+		&& requested_hash == anchor.checkpoint_hash
+	{
+		checkpoint_headers.as_slice()
+	} else {
+		let Some(target_index) = checkpoint_headers.iter().position(|header| {
+			*header.number() == requested_number
+				&& header.hash() == requested_hash
+				&& header.encode() == requested_header.encode()
+		}) else {
+			return Err(DeploymentCheckpointError::RequestedHeaderNotInCheckpointAncestry);
+		};
+		&checkpoint_headers[target_index + 1..]
+	};
+
+	if finality_suffix.len() != finality_unknown_headers.len() {
+		return Err(
+			DeploymentCheckpointError::FinalityProofAncestryLengthMismatch {
+				actual: finality_suffix.len(),
+				expected: finality_unknown_headers.len(),
+			},
+		);
+	}
+	for (header, (checkpoint, finality)) in finality_suffix
+		.iter()
+		.zip(finality_unknown_headers.iter())
+		.enumerate()
+	{
+		if checkpoint.encode() != finality.encode() {
+			return Err(DeploymentCheckpointError::FinalityProofAncestryMismatch { header });
+		}
+	}
+
+	Ok(())
+}
+
+fn validate_commitment_domain(
+	commitment: &BridgeEventCommitmentV1,
+	expected_sidechain_id: H256,
+	expected_height: u64,
+	requested_hash: H256,
+) -> Result<(), BridgeStateProofError> {
+	if commitment.sidechain_id != expected_sidechain_id {
+		return Err(BridgeStateProofError::SidechainIdMismatch);
+	}
+	if commitment.sidechain_height != expected_height {
+		return Err(BridgeStateProofError::HeightMismatch);
+	}
+	if commitment.execution_block_hash == requested_hash {
+		return Err(BridgeStateProofError::ExecutionHashAliasesConsensus);
+	}
+	Ok(())
+}

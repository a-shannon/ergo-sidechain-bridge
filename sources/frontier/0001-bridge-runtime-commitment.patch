+pub fn validate_federated_pooled_reserve_source_proof_profile_v1(
+	profile: &FederatedPooledReserveSourceProofProfileV1,
+) -> Result<(), &'static str> {
+	if profile.format_version != FEDERATED_POOLED_RESERVE_SOURCE_PROOF_FORMAT_VERSION_V1
+		|| profile.federation_epoch == 0
+		|| profile.threshold < 2
+		|| usize::from(profile.threshold) > profile.signer_public_keys.len()
+		|| profile.max_validity_blocks == 0
+		|| profile.max_validity_blocks > 1_024
+		|| profile.verifier_profile_id == H256::zero()
+	{
+		return Err("federated pooled-reserve source-proof profile is invalid");
+	}
+	let mut previous: Option<[u8; 32]> = None;
+	for signer in &profile.signer_public_keys {
+		if *signer == [0u8; 32] || previous.map(|value| value >= *signer).unwrap_or(false) {
+			return Err("federated pooled-reserve source-proof keys are not canonical");
+		}
+		previous = Some(*signer);
+	}
+	Ok(())
+}

+/// Build the deterministic real three-key state-proof request.
+pub fn deterministic_fixture_request() -> NativeFrontierExecutionIdentityRequest {
+	let transaction = deterministic_transaction();
+	let block = block_with_transactions(vec![transaction]);
+	let record = deterministic_record();
+	let current_block_key = derive_ethereum_current_block_storage_key();
+	let record_key =
+		derive_processed_peg_in_storage_key_v1(record.sidechain_id, record.ergo_box_id);
+
+	let mut state = BTreeMap::new();
+	state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), RUNTIME_CODE.to_vec());
+	state.insert(current_block_key.to_vec(), block.encode());
+	state.insert(record_key.to_vec(), record.encode());
+	let backend = InMemoryBackend::<BlakeTwo256>::from((state, StateVersion::V1));
+	let state_root = *backend.root();
+	let proof = prove_read(
+		backend,
+		vec![
+			RUNTIME_CODE_STORAGE_KEY.as_slice(),
+			current_block_key.as_slice(),
+			record_key.as_slice(),
+		],
+	)
+	.expect("deterministic state must produce the exact three-key proof");
+	let proof_nodes = proof.into_iter_nodes().collect::<Vec<_>>();
+	let target = NativeHeader::new(
+		TARGET_NUMBER,
+		H256::repeat_byte(0x90),
+		state_root,
+		anchor_hash(),
+		Digest::default(),
+	);
+	let (pairs, authorities) = authority_fixture();
+	let finality_proof = signed_finality_proof(&target, &pairs);
+
+	NativeFrontierExecutionIdentityRequest {
+		schema: REQUEST_SCHEMA.to_owned(),
+		trust_anchor: TrustAnchorRequest {
+			sidechain_id_hex: format_hash(record.sidechain_id),
+			checkpoint_hash_hex: format_hash(anchor_hash()),
+			checkpoint_number: u64::from(ANCHOR_NUMBER).to_string(),
+			grandpa_set_id: SET_ID.to_string(),
+			authority_list_scale_hex: format_bytes(&authorities.encode()),
+		},
+		target_native_block_hash_hex: format_hash(target.hash()),
+		target_header_scale_hex: format_bytes(&target.encode()),
+		linked_grandpa_proofs: Vec::<LinkedGrandpaProofRequest>::new(),
+		checkpoint_tail_headers_scale_hex: vec![format_bytes(&target.encode())],
+		finality_proof_scale_hex: format_bytes(&finality_proof),
+		statement: FrontierExecutionIdentityStatementRequest {
+			schema: STATEMENT_SCHEMA.to_owned(),
+			runtime_code: RuntimeCodeStatementRequest {
+				storage_key_hex: format_bytes(&RUNTIME_CODE_STORAGE_KEY),
+				artifact_sha256_hex: format_bytes(&sha2_256(RUNTIME_CODE)),
+				artifact_size_bytes: RUNTIME_CODE.len().to_string(),
+				build_attestation_id: BUILD_ATTESTATION_ID.to_owned(),
+				build_attestation_sha256_hex: format_bytes(&BUILD_ATTESTATION_SHA256),
+			},
+			current_block_storage_key_hex: format_bytes(&current_block_key),
+			ergo_box_id_hex: format_hash(record.ergo_box_id),
+			expected_record_scale_hex: format_bytes(&record.encode()),
+		},
+		runtime_state_proof_nodes_hex: proof_nodes.iter().map(|node| format_bytes(node)).collect(),
+	}
+}
+
+/// Build the fixture wrapper and digest-bound expected result.
+pub fn deterministic_fixture_vector() -> FrontierExecutionIdentityFixtureVector {
+	let trusted_anchor_digest_hex = deterministic_trusted_anchor_digest_hex();
+	let request = deterministic_fixture_request();
+	let expected = verify_request_bytes(
+		&serde_json::to_vec(&request).expect("fixture request must serialize canonically"),
+		&trusted_anchor_digest_hex,
+	)
+	.expect("deterministic execution-identity request must verify");
+	FrontierExecutionIdentityFixtureVector {
+		schema: FIXTURE_VECTOR_SCHEMA.to_owned(),
+		trusted_anchor_digest_hex,
+		request,
+		expected,
+	}
+}
+
+fn deterministic_transaction() -> TransactionV2 {
+	TransactionV2::Legacy(LegacyTransaction {
+		nonce: 1u64.into(),
+		gas_price: 1_000_000_000u64.into(),
+		gas_limit: 100_000u64.into(),
+		action: TransactionAction::Call(H160::repeat_byte(0x22)),
+		value: U256::zero(),
+		input: vec![1, 2, 3, 4],
+		signature: TransactionSignature::new(27, H256::repeat_byte(1), H256::repeat_byte(2))
+			.expect("deterministic transaction signature must be canonical"),
+	})
+}
+
+fn block_with_transactions(transactions: Vec<TransactionV2>) -> BlockV2 {
+	BlockV2::new(
+		PartialHeader {
+			parent_hash: H256::repeat_byte(0x10),
+			beneficiary: H160::repeat_byte(0x20),
+			state_root: H256::repeat_byte(0x30),
+			receipts_root: ethereum::util::ordered_trie_root(Vec::<Vec<u8>>::new()),
+			logs_bloom: Default::default(),
+			difficulty: U256::zero(),
+			number: u64::from(TARGET_NUMBER).into(),
+			gas_limit: 30_000_000u64.into(),
+			gas_used: U256::zero(),
+			timestamp: 1_700_000_000,
+			extra_data: Vec::new(),
+			mix_hash: H256::repeat_byte(0x40),
+			nonce: Default::default(),
+		},
+		transactions,
+		Vec::new(),
+	)
+}
+
+pub(crate) fn anchor_hash() -> H256 {
+	H256::repeat_byte(0x10)
+}
+
+pub(crate) fn authority_fixture() -> (Vec<ed25519::Pair>, AuthorityList) {
+	let pairs = (1u8..=3)
+		.map(|seed| ed25519::Pair::from_seed(&[seed; 32]))
+		.collect::<Vec<_>>();
+	let authorities = pairs
+		.iter()
+		.map(|pair| (pair.public().into(), 1u64))
+		.collect();
+	(pairs, authorities)
+}
+
+pub(crate) fn signed_finality_proof(header: &NativeHeader, pairs: &[ed25519::Pair]) -> Vec<u8> {
+	let precommit = Precommit {
+		target_hash: header.hash(),
+		target_number: *header.number(),
+	};
+	let message = sp_consensus_grandpa::Message::<NativeHeader>::Precommit(precommit.clone());
+	let payload = sp_consensus_grandpa::localized_payload(ROUND, SET_ID, &message);
+	let precommits = pairs
+		.iter()
+		.map(|pair| SignedPrecommit {
+			precommit: precommit.clone(),
+			signature: pair.sign(&payload).into(),
+			id: pair.public().into(),
+		})
+		.collect();
+	let justification: GrandpaJustification<NativeBlock> =
+		sp_consensus_grandpa::GrandpaJustification::<NativeHeader> {
+			round: ROUND,
+			commit: Commit {
+				target_hash: header.hash(),
+				target_number: *header.number(),
+				precommits,
+			},
+			votes_ancestries: Vec::new(),
+		}
+		.into();
+	FinalityProof::<NativeHeader> {
+		block: header.hash(),
+		justification: justification.encode(),
+		unknown_headers: Vec::new(),
+	}
+	.encode()
+}

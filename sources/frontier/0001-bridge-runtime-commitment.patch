+/// Derive one top-level `StorageValue` key for the pinned bridge pallet.
+pub fn derive_bridge_storage_value_key_v2(storage_name: &[u8]) -> Vec<u8> {
+	let mut key = Vec::with_capacity(32);
+	key.extend_from_slice(&twox_128(PALLET_NAME));
+	key.extend_from_slice(&twox_128(storage_name));
+	key
+}
+
+/// Derive one `Blake2_128Concat` H256 map key for the pinned bridge pallet.
+pub fn derive_bridge_storage_map_key_v2(storage_name: &[u8], map_key: H256) -> Vec<u8> {
+	let mut key = derive_bridge_storage_value_key_v2(storage_name);
+	key.extend_from_slice(&blake2_128(map_key.as_bytes()));
+	key.extend_from_slice(map_key.as_bytes());
+	key
+}
+
+/// Verify exact parent pending/receipt state and exact child V1/V3 successor state.
+pub fn verify_causal_peg_in_mint_transition_v3(
+	parent_state_root: H256,
+	post_state_root: H256,
+	record_key: H256,
+	parent_proof_nodes: &[Vec<u8>],
+	post_proof_nodes: &[Vec<u8>],
+	binding: &CausalMintExecutionBindingV3,
+) -> Result<VerifiedCausalPegInMintTransitionV3, CausalPegInMintTransitionProofError> {
+	validate_consecutive_binding(binding)?;
+	let parent_proof_bytes = validate_proof_bounds(parent_proof_nodes)?;
+	let post_proof_bytes = validate_proof_bounds(post_proof_nodes)?;
+	let keys = storage_keys(record_key);
+	let parent = read_state("parent", parent_state_root, parent_proof_nodes, &keys)?;
+	let post = read_state("post", post_state_root, post_proof_nodes, &keys)?;
+
+	let parent_v1_raw = required(&parent, &keys.current_v1_profile, "parent V1 profile")?;
+	let post_v1_raw = required(&post, &keys.current_v1_profile, "post V1 profile")?;
+	let parent_v1 = decode_canonical::<PegInRuntimeProfileV1>(parent_v1_raw, "parent V1 profile")?;
+	let post_v1 = decode_canonical::<PegInRuntimeProfileV1>(post_v1_raw, "post V1 profile")?;
+	validate_profile(
+		&parent_v1,
+		parent_v1.sidechain_id,
+		binding.native_parent_height,
+	)
+	.map_err(|_| CausalPegInMintTransitionProofError::ProfileChanged)?;
+	validate_profile(&post_v1, post_v1.sidechain_id, binding.native_child_height)
+		.map_err(|_| CausalPegInMintTransitionProofError::ProfileChanged)?;
+	if parent_v1_raw != post_v1_raw || parent_v1 != post_v1 {
+		return Err(CausalPegInMintTransitionProofError::ProfileChanged);
+	}
+
+	let parent_causal_raw = required(
+		&parent,
+		&keys.current_causal_profile,
+		"parent causal profile",
+	)?;
+	let post_causal_raw = required(&post, &keys.current_causal_profile, "post causal profile")?;
+	let parent_causal = decode_canonical::<CausalRuntimeProfileScaleV2>(
+		parent_causal_raw,
+		"parent causal profile",
+	)?;
+	let post_causal =
+		decode_canonical::<CausalRuntimeProfileScaleV2>(post_causal_raw, "post causal profile")?;
+	if parent_causal_raw != post_causal_raw || parent_causal != post_causal {
+		return Err(CausalPegInMintTransitionProofError::ProfileChanged);
+	}
+	if decode_bool(required(&parent, &keys.enforcement, "parent enforcement")?)? != true
+		|| decode_bool(required(&post, &keys.enforcement, "post enforcement")?)? != true
+	{
+		return Err(CausalPegInMintTransitionProofError::EnforcementInactive);
+	}
+
+	let parent_keys = decode_pending_keys(required(
+		&parent,
+		&keys.pending_keys,
+		"parent pending keys",
+	)?)?;
+	let post_keys = decode_pending_keys(required(&post, &keys.pending_keys, "post pending keys")?)?;
+	let expected_post_keys = remove_exact_key(&parent_keys, record_key)?;
+	if post_keys != expected_post_keys {
+		return Err(CausalPegInMintTransitionProofError::PendingKeyTransition);
+	}
+	let parent_pending_entries = read_pending_entries(
+		"parent",
+		parent_state_root,
+		parent_proof_nodes,
+		&parent_keys,
+	)?;
+	let post_pending_entries =
+		read_pending_entries("post", post_state_root, post_proof_nodes, &post_keys)?;
+	for key in &post_keys {
+		if parent_pending_entries.get(key) != post_pending_entries.get(key) {
+			return Err(CausalPegInMintTransitionProofError::RemainingPendingChanged);
+		}
+	}
+	let parent_receipt_entries = read_indexed_entries(
+		"parent",
+		parent_state_root,
+		parent_proof_nodes,
+		ADMISSION_RECEIPTS,
+		&post_keys,
+		true,
+	)?;
+	let post_receipt_entries = read_indexed_entries(
+		"post",
+		post_state_root,
+		post_proof_nodes,
+		ADMISSION_RECEIPTS,
+		&post_keys,
+		true,
+	)?;
+	for key in &post_keys {
+		if parent_receipt_entries.get(key) != post_receipt_entries.get(key) {
+			return Err(CausalPegInMintTransitionProofError::RemainingReceiptChanged);
+		}
+	}
+
+	let pending_raw = required(&parent, &keys.pending_admission, "parent pending admission")?;
+	let pending =
+		decode_canonical::<PendingAdmissionScaleV2>(pending_raw, "parent pending admission")?;
+	let validated = validate_pending(
+		&parent_causal,
+		&pending,
+		record_key,
+		binding.native_parent_height,
+	)?;
+	let receipt_raw = required(&parent, &keys.admission_receipt, "parent admission receipt")
+		.map_err(|_| CausalPegInMintTransitionProofError::ParentReceiptMismatch)?;
+	let receipt =
+		decode_canonical::<AdmissionReceiptScaleV1>(receipt_raw, "parent admission receipt")?;
+	validate_receipt(&pending, &validated, &receipt, binding.native_child_height)?;
+	if validated.sidechain_id != parent_v1.sidechain_id
+		|| validated.bridge_address != parent_v1.bridge_address
+	{
+		return Err(CausalPegInMintTransitionProofError::ParentPendingMismatch);
+	}
+	if present(&parent, &keys.processed_record)? || present(&parent, &keys.consumed_admission)? {
+		return Err(CausalPegInMintTransitionProofError::ParentReplayPresent);
+	}
+	if present(&parent, &keys.invalidation_tombstone)? {
+		return Err(CausalPegInMintTransitionProofError::ParentInvalidationTombstonePresent);
+	}
+	if present(&post, &keys.pending_admission)? {
+		return Err(CausalPegInMintTransitionProofError::PostPendingPresent);
+	}
+	if present(&post, &keys.admission_receipt)? {
+		return Err(CausalPegInMintTransitionProofError::PostReceiptPresent);
+	}
+	if present(&post, &keys.invalidation_tombstone)? {
+		return Err(CausalPegInMintTransitionProofError::PostInvalidationTombstonePresent);
+	}
+
+	let post_record_raw = required(&post, &keys.processed_record, "post processed record")?;
+	let post_record =
+		decode_canonical::<PegInRuntimeRecordV1>(post_record_raw, "post processed record")?;
+	validate_record(
+		&post_record,
+		validated.sidechain_id,
+		validated.source_box_id,
+		binding.native_child_height,
+	)
+	.map_err(|_| CausalPegInMintTransitionProofError::PostRecordMismatch)?;
+	if derive_peg_in_record_key_v1(post_record.sidechain_id, post_record.ergo_box_id) != record_key
+		|| post_record.bridge_address != validated.bridge_address
+		|| post_record.recipient != validated.recipient
+		|| post_record.amount != validated.amount
+		|| post_record.sidechain_height != binding.execution_height
+		|| post_record.execution_block_hash != binding.execution_block_hash
+		|| post_record.transaction_hash != binding.transaction_hash
+		|| post_record.event_index != binding.event_index
+	{
+		return Err(CausalPegInMintTransitionProofError::PostRecordMismatch);
+	}
+
+	let consumed_scale = required(&post, &keys.consumed_admission, "post consumed admission")?;
+	let consumed_bytes = decode_canonical::<Vec<u8>>(consumed_scale, "post consumed admission")?;
+	let consumed = decode_consumed(&consumed_bytes)?;
+	if consumed.admission_id != validated.admission_id
+		|| consumed.source_intent_id != validated.source_intent_id
+		|| consumed.legacy_mint_identity != record_key
+		|| consumed.native_parent_block_hash != binding.native_parent_block_hash
+		|| consumed.native_mint_height != binding.native_child_height
+		|| consumed.execution_block_hash != binding.execution_block_hash
+		|| consumed.execution_height != binding.execution_height
+		|| consumed.transaction_hash != binding.transaction_hash
+		|| consumed.transaction_index != binding.transaction_index
+		|| consumed.event_index != binding.event_index
+		|| consumed.processed_record_blake2b256 != H256::from(blake2_256(post_record_raw))
+	{
+		return Err(CausalPegInMintTransitionProofError::PostConsumedMismatch);
+	}
+
+	Ok(VerifiedCausalPegInMintTransitionV3 {
+		record_key,
+		runtime_profile_v1: parent_v1,
+		causal_profile_id: validated.profile_id,
+		source_intent_id: validated.source_intent_id,
+		admission_id: validated.admission_id,
+		proof_system_id: validated.proof_system_id,
+		proof_profile_id: validated.proof_profile_id,
+		source_proof_request_digest: receipt.source_proof_request_digest,
+		source_proof_result_id: receipt.source_proof_result_id,
+		source_proof_digest: receipt.source_proof_digest,
+		verifier_executable_sha256: receipt.verifier_executable_sha256,
+		verifier_profile_id: receipt.verifier_profile_id,
+		admission_expires_at_native_height: receipt.expires_at_native_height,
+		admission_receipt_scale: receipt_raw.to_vec(),
+		processed_record: post_record,
+		consumed_admission_v3: consumed_bytes,
+		parent_pending_key_count: parent_keys.len(),
+		post_pending_key_count: post_keys.len(),
+		parent_proof_node_count: parent_proof_nodes.len(),
+		parent_proof_bytes,
+		post_proof_node_count: post_proof_nodes.len(),
+		post_proof_bytes,
+	})
+}
+
+struct StorageKeys {
+	current_v1_profile: Vec<u8>,
+	current_causal_profile: Vec<u8>,
+	enforcement: Vec<u8>,
+	pending_keys: Vec<u8>,
+	pending_admission: Vec<u8>,
+	admission_receipt: Vec<u8>,
+	invalidation_tombstone: Vec<u8>,
+	processed_record: Vec<u8>,
+	consumed_admission: Vec<u8>,
+}
+
+fn storage_keys(record_key: H256) -> StorageKeys {
+	StorageKeys {
+		current_v1_profile: derive_bridge_storage_value_key_v2(CURRENT_PEG_IN_PROFILE),
+		current_causal_profile: derive_bridge_storage_value_key_v2(CURRENT_CAUSAL_PROFILE),
+		enforcement: derive_bridge_storage_value_key_v2(CAUSAL_ENFORCEMENT),
+		pending_keys: derive_bridge_storage_value_key_v2(PENDING_KEYS),
+		pending_admission: derive_bridge_storage_map_key_v2(PENDING_ADMISSIONS, record_key),
+		admission_receipt: derive_bridge_storage_map_key_v2(ADMISSION_RECEIPTS, record_key),
+		invalidation_tombstone: derive_bridge_storage_map_key_v2(
+			INVALIDATED_ADMISSIONS,
+			record_key,
+		),
+		processed_record: derive_bridge_storage_map_key_v2(PROCESSED_PEG_INS, record_key),
+		consumed_admission: derive_bridge_storage_map_key_v2(CONSUMED_ADMISSIONS, record_key),
+	}
+}
+
+fn validate_consecutive_binding(
+	binding: &CausalMintExecutionBindingV3,
+) -> Result<(), CausalPegInMintTransitionProofError> {
+	if binding.native_parent_height.checked_add(1) != Some(binding.native_child_height) {
+		return Err(CausalPegInMintTransitionProofError::NonConsecutiveBinding);
+	}
+	Ok(())
+}
+
+fn read_state(
+	state: &'static str,
+	root: H256,
+	proof_nodes: &[Vec<u8>],
+	keys: &StorageKeys,
+) -> Result<std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>, CausalPegInMintTransitionProofError>
+{
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let requested = [
+		keys.current_v1_profile.as_slice(),
+		keys.current_causal_profile.as_slice(),
+		keys.enforcement.as_slice(),
+		keys.pending_keys.as_slice(),
+		keys.pending_admission.as_slice(),
+		keys.admission_receipt.as_slice(),
+		keys.invalidation_tombstone.as_slice(),
+		keys.processed_record.as_slice(),
+		keys.consumed_admission.as_slice(),
+	];
+	read_proof_check::<BlakeTwo256, _>(root, proof, requested)
+		.map_err(|_| CausalPegInMintTransitionProofError::InvalidProof { state })
+}
+
+fn read_pending_entries(
+	state: &'static str,
+	root: H256,
+	proof_nodes: &[Vec<u8>],
+	record_keys: &[H256],
+) -> Result<std::collections::HashMap<H256, Vec<u8>>, CausalPegInMintTransitionProofError> {
+	read_indexed_entries(
+		state,
+		root,
+		proof_nodes,
+		PENDING_ADMISSIONS,
+		record_keys,
+		false,
+	)
+}
+
+fn read_indexed_entries(
+	state: &'static str,
+	root: H256,
+	proof_nodes: &[Vec<u8>],
+	storage_name: &[u8],
+	record_keys: &[H256],
+	missing_is_receipt: bool,
+) -> Result<std::collections::HashMap<H256, Vec<u8>>, CausalPegInMintTransitionProofError> {
+	if record_keys.is_empty() {
+		return Ok(std::collections::HashMap::new());
+	}
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| FrontierExecutionIdentityProofError::DuplicateNodes)?;
+	let storage_keys = record_keys
+		.iter()
+		.map(|record_key| derive_bridge_storage_map_key_v2(storage_name, *record_key))
+		.collect::<Vec<_>>();
+	let values =
+		read_proof_check::<BlakeTwo256, _>(root, proof, storage_keys.iter().map(Vec::as_slice))
+			.map_err(|_| CausalPegInMintTransitionProofError::InvalidProof { state })?;
+	let mut entries = std::collections::HashMap::with_capacity(record_keys.len());
+	for (record_key, storage_key) in record_keys.iter().zip(storage_keys.iter()) {
+		let value =
+			values
+				.get(storage_key)
+				.and_then(Option::as_ref)
+				.ok_or(if missing_is_receipt {
+					CausalPegInMintTransitionProofError::RemainingReceiptChanged
+				} else {
+					CausalPegInMintTransitionProofError::RemainingPendingChanged
+				})?;
+		entries.insert(*record_key, value.clone());
+	}
+	Ok(entries)
+}
+
+fn required<'a>(
+	values: &'a std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+	field: &'static str,
+) -> Result<&'a [u8], CausalPegInMintTransitionProofError> {
+	values
+		.get(key)
+		.and_then(Option::as_deref)
+		.ok_or(CausalPegInMintTransitionProofError::MissingValue { field })
+}
+
+fn present(
+	values: &std::collections::HashMap<Vec<u8>, Option<Vec<u8>>>,
+	key: &[u8],
+) -> Result<bool, CausalPegInMintTransitionProofError> {
+	values
+		.get(key)
+		.map(Option::is_some)
+		.ok_or(CausalPegInMintTransitionProofError::InvalidProof { state: "state" })
+}
+
+fn decode_canonical<T: DecodeAll + Encode>(
+	raw: &[u8],
+	field: &'static str,
+) -> Result<T, CausalPegInMintTransitionProofError> {
+	let decoded = T::decode_all(&mut &raw[..])
+		.map_err(|_| CausalPegInMintTransitionProofError::MalformedScale { field })?;
+	if decoded.encode().as_slice() != raw {
+		return Err(CausalPegInMintTransitionProofError::MalformedScale { field });
+	}
+	Ok(decoded)
+}
+
+fn decode_bool(raw: &[u8]) -> Result<bool, CausalPegInMintTransitionProofError> {
+	decode_canonical::<bool>(raw, "enforcement flag")
+}
+
+fn decode_pending_keys(raw: &[u8]) -> Result<Vec<H256>, CausalPegInMintTransitionProofError> {
+	let keys = decode_canonical::<Vec<H256>>(raw, "pending keys")?;
+	if keys.len() > MAX_PENDING_KEYS {
+		return Err(CausalPegInMintTransitionProofError::PendingKeyTransition);
+	}
+	for (index, key) in keys.iter().enumerate() {
+		if *key == H256::zero() || (index > 0 && keys[index - 1] >= *key) {
+			return Err(CausalPegInMintTransitionProofError::PendingKeyTransition);
+		}
+	}
+	Ok(keys)
+}
+
+fn validate_receipt(
+	pending: &PendingAdmissionScaleV2,
+	validated: &ValidatedCausalAdmissionV2,
+	receipt: &AdmissionReceiptScaleV1,
+	native_child_height: u64,
+) -> Result<(), CausalPegInMintTransitionProofError> {
+	let mut request_preimage = Vec::with_capacity(
+		validated.profile_id.as_bytes().len()
+			+ pending.source_intent_bytes.len()
+			+ pending.statement_bytes.len(),
+	);
+	request_preimage.extend_from_slice(validated.profile_id.as_bytes());
+	request_preimage.extend_from_slice(&pending.source_intent_bytes);
+	request_preimage.extend_from_slice(&pending.statement_bytes);
+	let request_digest = domain_hash(SOURCE_PROOF_REQUEST_DOMAIN, &request_preimage);
+	if receipt.format_version != 1
+		|| receipt.profile_id != validated.profile_id
+		|| receipt.admission_id != validated.admission_id
+		|| receipt.source_proof_request_digest != request_digest
+		|| receipt.source_proof_result_id == H256::zero()
+		|| receipt.source_proof_digest == H256::zero()
+		|| receipt.verifier_executable_sha256 == H256::zero()
+		|| receipt.verifier_profile_id != static_source_verifier_profile_id_v1()
+		|| receipt.admitted_at_native_height != pending.admitted_at_native_height
+		|| receipt.expires_at_native_height <= native_child_height
+	{
+		return Err(CausalPegInMintTransitionProofError::ParentReceiptMismatch);
+	}
+	Ok(())
+}
+
+fn remove_exact_key(
+	parent: &[H256],
+	record_key: H256,
+) -> Result<Vec<H256>, CausalPegInMintTransitionProofError> {
+	let mut found = false;
+	let mut post = Vec::with_capacity(parent.len().saturating_sub(1));
+	for key in parent {
+		if *key == record_key {
+			if found {
+				return Err(CausalPegInMintTransitionProofError::PendingKeyTransition);
+			}
+			found = true;
+		} else {
+			post.push(*key);
+		}
+	}
+	if !found {
+		return Err(CausalPegInMintTransitionProofError::PendingKeyTransition);
+	}
+	Ok(post)
+}
+
+fn validate_pending(
+	profile: &CausalRuntimeProfileScaleV2,
+	pending: &PendingAdmissionScaleV2,
+	record_key: H256,
+	parent_height: u64,
+) -> Result<ValidatedCausalAdmissionV2, CausalPegInMintTransitionProofError> {
+	if profile.profile_bytes.len() != PROFILE_BYTES
+		|| profile.profile_bytes[0] != PROFILE_FORMAT_VERSION
+		|| pending.source_intent_bytes.len() != SOURCE_INTENT_BYTES
+		|| pending.source_intent_bytes[0] != PROFILE_FORMAT_VERSION
+		|| pending.statement_bytes.len() != ADMISSION_STATEMENT_BYTES
+		|| pending.statement_bytes[0] != PROFILE_FORMAT_VERSION
+	{
+		return Err(CausalPegInMintTransitionProofError::MalformedWire {
+			field: "profile, intent, or admission",
+		});
+	}
+	let profile_id = domain_hash(PROFILE_DOMAIN, &profile.profile_bytes);
+	let source_intent_id = domain_hash(SOURCE_INTENT_DOMAIN, &pending.source_intent_bytes);
+	let admission_id = domain_hash(ADMISSION_DOMAIN, &pending.statement_bytes);
+	let sidechain_id = h256(&profile.profile_bytes, 33);
+	let bridge_address = h160(&profile.profile_bytes, 65);
+	let token_address = h160(&profile.profile_bytes, 85);
+	let profile_activation_height = u64_be(&profile.profile_bytes, 305);
+	let proof_system_id = h256(&profile.profile_bytes, 233);
+	let proof_profile_id = h256(&profile.profile_bytes, 265);
+	let finality_policy_id = h256(&profile.profile_bytes, 201);
+	let legacy_mint_identity = h256(&pending.statement_bytes, 33);
+	let source_box_id = h256(&pending.statement_bytes, 65);
+	let recipient = h160(&pending.source_intent_bytes, 209);
+	let amount = u64_be(&pending.source_intent_bytes, 201);
+	let inclusion_height = u64_be(&pending.statement_bytes, 297);
+	let checkpoint_height = u64_be(&pending.statement_bytes, 337);
+	let required_confirmations = u32_be(&pending.statement_bytes, 377);
+	let observed_confirmations = checkpoint_height
+		.checked_sub(inclusion_height)
+		.and_then(|delta| delta.checked_add(1));
+	if profile.profile_id != profile_id
+		|| pending.profile_id != profile_id
+		|| pending.admission_id != admission_id
+		|| pending.proof_system_id != proof_system_id
+		|| pending.proof_profile_id != proof_profile_id
+		|| proof_system_id != static_source_proof_system_id_v1()
+		|| proof_profile_id != static_source_proof_profile_id_v1()
+		|| finality_policy_id != static_source_finality_policy_id_v1()
+		|| h256(&pending.source_intent_bytes, 1) != h256(&profile.profile_bytes, 1)
+		|| h256(&pending.source_intent_bytes, 33) != sidechain_id
+		|| h160(&pending.source_intent_bytes, 65) != bridge_address
+		|| h160(&pending.source_intent_bytes, 85) != token_address
+		|| h256(&pending.source_intent_bytes, 105) != h256(&profile.profile_bytes, 105)
+		|| h256(&pending.source_intent_bytes, 137) != profile_id
+		|| h256(&pending.source_intent_bytes, 169) != H256::zero()
+		|| amount == 0
+		|| amount > i64::MAX as u64
+		|| recipient == H160::zero()
+		|| h256(&pending.statement_bytes, 1) != source_intent_id
+		|| legacy_mint_identity != record_key
+		|| derive_peg_in_record_key_v1(sidechain_id, source_box_id) != record_key
+		|| h256(&pending.statement_bytes, 133) != h256(&profile.profile_bytes, 137)
+		|| h256(&pending.statement_bytes, 233) != h256(&profile.profile_bytes, 169)
+		|| h256(&pending.statement_bytes, 345) != h256(&profile.profile_bytes, 201)
+		|| required_confirmations != SOURCE_REQUIRED_CONFIRMATIONS
+		|| observed_confirmations
+			.map(|value| value < u64::from(required_confirmations))
+			.unwrap_or(true)
+		|| pending.admitted_at_native_height < profile_activation_height
+		|| pending.admitted_at_native_height > parent_height
+	{
+		return Err(CausalPegInMintTransitionProofError::ParentPendingMismatch);
+	}
+	Ok(ValidatedCausalAdmissionV2 {
+		profile_id,
+		source_intent_id,
+		admission_id,
+		legacy_mint_identity,
+		source_box_id,
+		sidechain_id,
+		bridge_address,
+		token_address,
+		recipient,
+		amount,
+		profile_activation_height,
+		proof_system_id,
+		proof_profile_id,
+	})
+}
+
+fn decode_consumed(
+	bytes: &[u8],
+) -> Result<ConsumedAdmissionFieldsV3, CausalPegInMintTransitionProofError> {
+	if bytes.len() != CONSUMED_BYTES || bytes[0] != CONSUMED_FORMAT_VERSION {
+		return Err(CausalPegInMintTransitionProofError::MalformedWire {
+			field: "consumed admission V3",
+		});
+	}
+	let fields = ConsumedAdmissionFieldsV3 {
+		admission_id: h256(bytes, 1),
+		source_intent_id: h256(bytes, 33),
+		legacy_mint_identity: h256(bytes, 65),
+		native_parent_block_hash: h256(bytes, 97),
+		native_mint_height: u64_be(bytes, 129),
+		execution_block_hash: h256(bytes, 137),
+		execution_height: u64_be(bytes, 169),
+		transaction_hash: h256(bytes, 177),
+		transaction_index: u32_be(bytes, 209),
+		event_index: u32_be(bytes, 213),
+		processed_record_blake2b256: h256(bytes, 217),
+	};
+	if [
+		fields.admission_id,
+		fields.source_intent_id,
+		fields.legacy_mint_identity,
+		fields.native_parent_block_hash,
+		fields.execution_block_hash,
+		fields.transaction_hash,
+		fields.processed_record_blake2b256,
+	]
+	.iter()
+	.any(|value| *value == H256::zero())
+	{
+		return Err(CausalPegInMintTransitionProofError::MalformedWire {
+			field: "consumed admission V3",
+		});
+	}
+	Ok(fields)
+}
+
+fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+	let mut preimage = Vec::with_capacity(domain.len() + bytes.len());
+	preimage.extend_from_slice(domain);
+	preimage.extend_from_slice(bytes);
+	H256::from(blake2_256(&preimage))
+}
+
+fn static_source_proof_system_id_v1() -> H256 {
+	H256::from(blake2_256(SOURCE_PROOF_SYSTEM_DOMAIN))
+}
+
+fn static_source_finality_policy_id_v1() -> H256 {
+	H256::from(blake2_256(SOURCE_FINALITY_POLICY_DOMAIN))
+}
+
+fn static_source_verifier_profile_id_v1() -> H256 {
+	H256::from(blake2_256(SOURCE_VERIFIER_PROFILE_DOMAIN))
+}
+
+fn static_source_proof_profile_id_v1() -> H256 {
+	H256::from([
+		0x65, 0xca, 0x46, 0x32, 0xab, 0xc4, 0xdb, 0x51, 0x25, 0x5e, 0x42, 0xe8, 0x3a, 0x9a, 0xee,
+		0x8a, 0x72, 0xb1, 0x9d, 0x41, 0x92, 0x1d, 0x45, 0x82, 0x4c, 0xe8, 0x47, 0xcd, 0x69, 0x6e,
+		0x95, 0x37,
+	])
+}
+
+fn h160(bytes: &[u8], offset: usize) -> H160 {
+	H160::from_slice(&bytes[offset..offset + 20])
+}
+
+fn h256(bytes: &[u8], offset: usize) -> H256 {
+	H256::from_slice(&bytes[offset..offset + 32])
+}
+
+fn u32_be(bytes: &[u8], offset: usize) -> u32 {
+	u32::from_be_bytes(
+		bytes[offset..offset + 4]
+			.try_into()
+			.expect("fixed checked wire"),
+	)
+}
+
+fn u64_be(bytes: &[u8], offset: usize) -> u64 {
+	u64::from_be_bytes(
+		bytes[offset..offset + 8]
+			.try_into()
+			.expect("fixed checked wire"),
+	)
+}

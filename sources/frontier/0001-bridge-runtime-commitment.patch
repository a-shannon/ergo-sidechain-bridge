+/// A finalized runtime-identity verification failure, preserving the owning layer.
+#[derive(Debug, Error)]
+pub enum FinalizedPegInRuntimeIdentityProofError {
+	/// GRANDPA signatures, ancestry, or exact target binding failed.
+	#[error(transparent)]
+	Finality(#[from] BridgeFinalityProofError),
+	/// Runtime-code, profile, or processed-record state verification failed.
+	#[error(transparent)]
+	State(#[from] PegInRuntimeIdentityProofError),
+}
+
+/// Exact V2 values decoded from one authenticated native state root.
+#[derive(Debug)]
+pub struct VerifiedPegInRuntimeIdentityV2 {
+	/// State root used for trie verification.
+	pub state_root: H256,
+	/// Exact raw runtime-code key queried by the verifier.
+	pub runtime_code_storage_key: [u8; 5],
+	/// SHA-256 of the exact raw runtime Wasm recovered from the proof.
+	pub runtime_code_sha256: [u8; 32],
+	/// Exact raw runtime Wasm byte length recovered from the proof.
+	pub runtime_code_size_bytes: usize,
+	/// Exact fixed profile key queried for non-membership, or `None` for membership.
+	pub profile_storage_key: Option<[u8; 32]>,
+	/// Exact derived processed-record key queried by the verifier.
+	pub record_storage_key: [u8; PROCESSED_PEG_IN_STORAGE_KEY_BYTES],
+	/// Current active V1 profile recovered for non-membership, or `None` for membership.
+	pub profile: Option<PegInRuntimeProfileV1>,
+	/// Exact member or authenticated current absence requested by the statement.
+	pub record_state: PegInRecordStateV1,
+	/// Number of bounded raw trie nodes consumed as proof material.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes accepted by the verifier.
+	pub proof_bytes: usize,
+}
+
+/// V2 runtime identity whose native header is finalized under the supplied GRANDPA set.
+#[derive(Debug)]
+pub struct VerifiedFinalizedPegInRuntimeIdentityV2<Block: BlockT> {
+	/// Full requested header whose hash, number, ancestry, and state root were checked.
+	pub requested_header: Block::Header,
+	/// Native GRANDPA proof ending at an authenticated finalized target.
+	pub finality: VerifiedGrandpaFinalityProof<Block>,
+	/// Exact runtime code plus profile and processed-record state from the requested state root.
+	pub state: VerifiedPegInRuntimeIdentityV2,
+}
+
+/// Verify one statement-bound runtime artifact and V1 peg-in predicate in one trie proof.
+pub fn verify_peg_in_runtime_identity_v2(
+	state_root: H256,
+	expected_sidechain_id: H256,
+	expected_ergo_box_id: H256,
+	authenticated_header_height: u64,
+	runtime_code: RuntimeCodeExpectationV2,
+	expectation: PegInRuntimeStateExpectationV1<'_>,
+	proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedPegInRuntimeIdentityV2, PegInRuntimeIdentityProofError> {
+	if runtime_code.artifact_sha256 == [0u8; 32] {
+		return Err(PegInRuntimeIdentityProofError::ZeroRuntimeCodeDigest);
+	}
+	if runtime_code.artifact_size_bytes == 0 {
+		return Err(PegInRuntimeIdentityProofError::ZeroRuntimeCodeSize);
+	}
+	if runtime_code.artifact_size_bytes > MAX_RUNTIME_CODE_BYTES {
+		return Err(
+			PegInRuntimeIdentityProofError::ExpectedRuntimeCodeTooLarge {
+				actual: runtime_code.artifact_size_bytes,
+				max: MAX_RUNTIME_CODE_BYTES,
+			},
+		);
+	}
+	if expected_ergo_box_id == H256::zero() {
+		return Err(PegInStateProofError::ZeroErgoBoxId.into());
+	}
+	match expectation {
+		PegInRuntimeStateExpectationV1::Member(record) => validate_record(
+			record,
+			expected_sidechain_id,
+			expected_ergo_box_id,
+			authenticated_header_height,
+		)?,
+		PegInRuntimeStateExpectationV1::NonMember(profile) => {
+			validate_profile(profile, expected_sidechain_id, authenticated_header_height)?
+		}
+	}
+
+	let proof_bytes = validate_proof_bounds(proof_nodes)?;
+	let record_storage_key =
+		derive_processed_peg_in_storage_key_v1(expected_sidechain_id, expected_ergo_box_id);
+	let proof = StorageProof::new_with_duplicate_nodes_check(proof_nodes.iter().cloned())
+		.map_err(|_| PegInRuntimeIdentityProofError::DuplicateNodes)?;
+	let requested_keys = match expectation {
+		PegInRuntimeStateExpectationV1::Member(_) => vec![
+			RUNTIME_CODE_STORAGE_KEY.as_slice(),
+			record_storage_key.as_slice(),
+		],
+		PegInRuntimeStateExpectationV1::NonMember(_) => vec![
+			RUNTIME_CODE_STORAGE_KEY.as_slice(),
+			CURRENT_PEG_IN_PROFILE_STORAGE_KEY.as_slice(),
+			record_storage_key.as_slice(),
+		],
+	};
+	let values = read_proof_check::<BlakeTwo256, _>(state_root, proof, requested_keys)
+		.map_err(|_| PegInRuntimeIdentityProofError::InvalidProof)?;
+
+	let raw_runtime_code = values
+		.get(RUNTIME_CODE_STORAGE_KEY.as_slice())
+		.and_then(|value| value.as_ref())
+		.ok_or(PegInRuntimeIdentityProofError::RuntimeCodeMissing)?;
+	if raw_runtime_code.is_empty() {
+		return Err(PegInRuntimeIdentityProofError::RuntimeCodeEmpty);
+	}
+	if raw_runtime_code.len() > MAX_RUNTIME_CODE_BYTES {
+		return Err(PegInRuntimeIdentityProofError::RuntimeCodeTooLarge {
+			actual: raw_runtime_code.len(),
+			max: MAX_RUNTIME_CODE_BYTES,
+		});
+	}
+	if raw_runtime_code.len() != runtime_code.artifact_size_bytes {
+		return Err(PegInRuntimeIdentityProofError::RuntimeCodeSizeMismatch);
+	}
+	let runtime_code_sha256 = sha2_256(raw_runtime_code);
+	if runtime_code_sha256 != runtime_code.artifact_sha256 {
+		return Err(PegInRuntimeIdentityProofError::RuntimeCodeDigestMismatch);
+	}
+
+	let profile = match expectation {
+		PegInRuntimeStateExpectationV1::Member(_) => None,
+		PegInRuntimeStateExpectationV1::NonMember(expected_profile) => {
+			let raw_profile = values
+				.get(CURRENT_PEG_IN_PROFILE_STORAGE_KEY.as_slice())
+				.and_then(|value| value.as_ref())
+				.ok_or(PegInRuntimeIdentityProofError::ProfileMissing)?;
+			if raw_profile.len() != PEG_IN_PROFILE_V1_SCALE_BYTES {
+				return Err(PegInRuntimeIdentityProofError::ProfileLength {
+					actual: raw_profile.len(),
+					expected: PEG_IN_PROFILE_V1_SCALE_BYTES,
+				});
+			}
+			let profile = PegInRuntimeProfileV1::decode_all(&mut &raw_profile[..])
+				.map_err(|_| PegInRuntimeIdentityProofError::ProfileDecode)?;
+			validate_profile(&profile, expected_sidechain_id, authenticated_header_height)?;
+			if &profile != expected_profile {
+				return Err(PegInRuntimeIdentityProofError::ProfileMismatch);
+			}
+			Some(profile)
+		}
+	};
+
+	let raw_record = values
+		.get(record_storage_key.as_slice())
+		.ok_or(PegInRuntimeIdentityProofError::InvalidProof)?;
+	let record_state = match (expectation, raw_record.as_ref()) {
+		(PegInRuntimeStateExpectationV1::Member(_), None) => {
+			return Err(PegInRuntimeIdentityProofError::RecordMissing)
+		}
+		(PegInRuntimeStateExpectationV1::NonMember(_), Some(_)) => {
+			return Err(PegInRuntimeIdentityProofError::UnexpectedRecord)
+		}
+		(PegInRuntimeStateExpectationV1::NonMember(_), None) => PegInRecordStateV1::Absent,
+		(PegInRuntimeStateExpectationV1::Member(expected), Some(raw)) => {
+			if raw.len() != PEG_IN_RECORD_V1_SCALE_BYTES {
+				return Err(PegInRuntimeIdentityProofError::RecordLength {
+					actual: raw.len(),
+					expected: PEG_IN_RECORD_V1_SCALE_BYTES,
+				});
+			}
+			let record = PegInRuntimeRecordV1::decode_all(&mut &raw[..])
+				.map_err(|_| PegInRuntimeIdentityProofError::RecordDecode)?;
+			validate_record(
+				&record,
+				expected_sidechain_id,
+				expected_ergo_box_id,
+				authenticated_header_height,
+			)?;
+			if &record != expected {
+				return Err(PegInRuntimeIdentityProofError::RecordMismatch);
+			}
+			PegInRecordStateV1::Member(record)
+		}
+	};
+
+	Ok(VerifiedPegInRuntimeIdentityV2 {
+		state_root,
+		runtime_code_storage_key: RUNTIME_CODE_STORAGE_KEY,
+		runtime_code_sha256,
+		runtime_code_size_bytes: raw_runtime_code.len(),
+		profile_storage_key: profile.as_ref().map(|_| CURRENT_PEG_IN_PROFILE_STORAGE_KEY),
+		record_storage_key,
+		profile,
+		record_state,
+		proof_node_count: proof_nodes.len(),
+		proof_bytes,
+	})
+}
+
+/// Verify one requested header, GRANDPA finality, runtime code, and V1 peg-in predicate.
+pub fn verify_finalized_peg_in_runtime_identity_v2<Block>(
+	requested_header: Block::Header,
+	expected_sidechain_id: H256,
+	expected_set_id: SetId,
+	expected_authorities: &AuthorityList,
+	encoded_finality_proof: &[u8],
+	expected_ergo_box_id: H256,
+	runtime_code: RuntimeCodeExpectationV2,
+	expectation: PegInRuntimeStateExpectationV1<'_>,
+	storage_proof_nodes: &[Vec<u8>],
+) -> Result<VerifiedFinalizedPegInRuntimeIdentityV2<Block>, FinalizedPegInRuntimeIdentityProofError>
+where
+	Block: BlockT<Hash = H256>,
+	sp_runtime::traits::NumberFor<Block>:
+		sc_consensus_grandpa::BlockNumberOps + CheckedAdd + Copy + TryInto<u64>,
+{
+	let requested_hash = requested_header.hash();
+	let requested_number = *requested_header.number();
+	let finality = verify_grandpa_finality_proof::<Block>(
+		requested_hash,
+		requested_number,
+		expected_set_id,
+		expected_authorities,
+		encoded_finality_proof,
+	)?;
+	let requested_height = requested_number.try_into().map_err(|_| {
+		PegInRuntimeIdentityProofError::PegInState(
+			PegInStateProofError::RecordAfterAuthenticatedHeader,
+		)
+	})?;
+	let state = verify_peg_in_runtime_identity_v2(
+		*requested_header.state_root(),
+		expected_sidechain_id,
+		expected_ergo_box_id,
+		requested_height,
+		runtime_code,
+		expectation,
+		storage_proof_nodes,
+	)?;
+
+	Ok(VerifiedFinalizedPegInRuntimeIdentityV2 {
+		requested_header,
+		finality,
+		state,
+	})
+}
+
+fn validate_proof_bounds(proof_nodes: &[Vec<u8>]) -> Result<usize, PegInRuntimeIdentityProofError> {
+	if proof_nodes.is_empty() {
+		return Err(PegInRuntimeIdentityProofError::EmptyProof);
+	}
+	if proof_nodes.len() > MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODES {
+		return Err(PegInRuntimeIdentityProofError::TooManyNodes {
+			actual: proof_nodes.len(),
+			max: MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODES,
+		});
+	}
+	let mut proof_bytes = 0usize;
+	for (index, node) in proof_nodes.iter().enumerate() {
+		if node.len() > MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODE_BYTES {
+			return Err(PegInRuntimeIdentityProofError::NodeTooLarge {
+				index,
+				actual: node.len(),
+				max: MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_NODE_BYTES,
+			});
+		}
+		proof_bytes = proof_bytes.checked_add(node.len()).ok_or(
+			PegInRuntimeIdentityProofError::ProofTooLarge {
+				actual: usize::MAX,
+				max: MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_BYTES,
+			},
+		)?;
+		if proof_bytes > MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_BYTES {
+			return Err(PegInRuntimeIdentityProofError::ProofTooLarge {
+				actual: proof_bytes,
+				max: MAX_PEG_IN_RUNTIME_IDENTITY_PROOF_BYTES,
+			});
+		}
+	}
+	Ok(proof_bytes)
+}

+
+	#[test]
+	fn rejects_address_padding_owner_mismatch_replay_and_malformed_storage() {
+		let cases = [
+			(
+				"bridge-owner-padding",
+				FrontierPegInContractStateProofError::AddressPadding {
+					field: "EVM::AccountStorages[bridge][owner]",
+				},
+			),
+			(
+				"token-owner-padding",
+				FrontierPegInContractStateProofError::AddressPadding {
+					field: "EVM::AccountStorages[token][owner]",
+				},
+			),
+			(
+				"token-owner",
+				FrontierPegInContractStateProofError::TokenOwnerMismatch,
+			),
+			(
+				"replay",
+				FrontierPegInContractStateProofError::ProcessedPegInMismatch,
+			),
+			(
+				"malformed",
+				FrontierPegInContractStateProofError::MalformedStorage {
+					field: "EVM::AccountStorages[token][totalSupply]",
+				},
+			),
+		];
+		for (case, expected) in cases {

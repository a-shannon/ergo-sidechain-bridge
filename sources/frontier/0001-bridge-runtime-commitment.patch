+	fn state_for(
+		fixture: &Fixture,
+		pending_keys: Vec<H256>,
+		pending: Option<PendingPooledReserveMintReservationV4>,
+		consumed: Option<ConsumedPooledReserveMintReservationV4>,
+		invalidated: Option<InvalidatedPooledReserveMintReservationV4>,
+	) -> BTreeMap<Vec<u8>, Vec<u8>> {
+		let mut state = BTreeMap::new();
+		state.insert(RUNTIME_CODE_STORAGE_KEY.to_vec(), RUNTIME_CODE.to_vec());
+		state.insert(
+			fixture.keys.current_profile.clone(),
+			fixture.profile.encode(),
+		);
+		state.insert(fixture.keys.enforcement.clone(), true.encode());
+		state.insert(fixture.keys.pending_keys.clone(), pending_keys.encode());
+		if let Some(value) = pending {
+			state.insert(fixture.keys.pending_reservation.clone(), value.encode());
+		}
+		if let Some(value) = consumed {
+			state.insert(fixture.keys.consumed_reservation.clone(), value.encode());
+		}

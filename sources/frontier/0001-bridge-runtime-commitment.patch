+		.expect("terminal V4 consumed record decodes");
+	let current_block = client
+		.runtime_api()
+		.current_block(after_corrected.best_hash)
+		.expect("current Ethereum block query succeeds")
+		.expect("corrected V4 sibling stores one Ethereum block");
+	assert_eq!(
+		consumed,
+		ConsumedPooledReserveMintReservationV4 {
+			format_version: POOLED_RESERVE_MINT_RESERVATION_FORMAT_VERSION_V4,
+			profile_id,
+			statement_id: validated.statement_id,
+			mint_identity,
+			consumed_at_native_height: u64::from(after_corrected.best_number),
+			execution_block_hash: current_block.header.hash(),
+			transaction_hash: reserved_transaction_hash,
+			event_index: 1,
+		},
+	);
+	assert!(storage_at(&client, after_corrected.best_hash, &invalidated_key).is_none());
+	assert!(storage_at(&client, after_corrected.best_hash, &parent_profile_key).is_none());
+	assert!(storage_at(&client, after_corrected.best_hash, &parent_keys_key).is_none());
+	assert!(storage_at(&client, after_corrected.best_hash, &parent_snapshot_key).is_none());
+	assert_eq!(
+		client
+			.runtime_api()
+			.account_basic(after_corrected.best_hash, owner)
+			.expect("owner account query succeeds")
+			.nonce,
+		account_before.nonce + U256::one(),
+	);
+}

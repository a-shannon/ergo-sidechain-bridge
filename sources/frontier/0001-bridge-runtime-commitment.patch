+
+fn parse_parent_nodes(values: &[String]) -> Result<Vec<Vec<u8>>, NativeCheckpointRequestError> {
+	if values.is_empty() || values.len() > MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES {
+		return Err(NativeCheckpointRequestError::Collection {
+			field: "parentStateProofNodesHex",
+			actual: values.len(),
+			min: 1,
+			max: MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES,
+		});
+	}
+	values
+		.iter()
+		.map(|value| {
+			parse_byte_hex(
+				"parentStateProofNodesHex",
+				value,
+				MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+			)
+		})
+		.collect()
+}
+
+fn parse_address(field: &'static str, value: &str) -> Result<H160, NativeCheckpointRequestError> {
+	let bytes = parse_byte_hex(field, value, 20)?;
+	Ok(H160::from_slice(&bytes))
+}
+
+fn parse_code_expectation(
+	field: &'static str,
+	digest_hex: &str,
+	bytes: &str,
+) -> Result<FrontierRuntimeCodeExpectationV1, NativeCheckpointRequestError> {
+	let digest = parse_byte_hex(field, digest_hex, 32)?;
+	let bytes = parse_decimal_u64(field, bytes)?;
+	let bytes =
+		usize::try_from(bytes).map_err(|_| NativeCheckpointRequestError::Decimal { field })?;
+	let mut sha256 = [0u8; 32];
+	sha256.copy_from_slice(&digest);
+	Ok(FrontierRuntimeCodeExpectationV1 { sha256, bytes })
+}
+
+fn validate_key(
+	field: &'static str,
+	value: &str,
+	expected: &[u8],
+) -> Result<(), NativeFrontierPegInMintTransitionRequestError> {
+	let parsed = parse_byte_hex(field, value, expected.len())?;
+	if parsed != expected {
+		return Err(NativeFrontierPegInMintTransitionRequestError::StorageKey { field });
+	}
+	Ok(())
+}

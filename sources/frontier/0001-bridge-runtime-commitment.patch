@@ -0,0 +1,562 @@
+//! Finalized V4 pooled-reserve mint-reservation state verification.
+//!
+//! The request carries the generic GRANDPA finality envelope directly. Seven V4 state reads,
+//! including `:code`, are then verified under that exact finalized target state root. No bridge
+//! event commitment is required and the result never authorizes funds movement.
+
+use bridge_finality_proof::{
+	MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS, MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+	MAX_FINALITY_PROOF_BYTES,
+};
+use bridge_state_proof::{
+	derive_grandpa_authority_set_hash,
+	pooled_reserve_mint_reservation_state_v4::{
+		verify_pooled_reserve_mint_reservation_state_v4,
+		PooledReserveMintReservationStateProofErrorV4,
+		PooledReserveMintReservationStateStorageKeysV4, PooledReserveMintReservationStateV4,
+		MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODES,
+		MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODE_BYTES,
+	},
+	verify_deployment_finality_checkpoint, DeploymentFinalityCheckpointError,
+	GrandpaDeploymentTrustAnchor, LinkedGrandpaAuthorityProofChunk,
+	MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+};
+use scale_codec::{DecodeAll, Encode};
+use serde::{Deserialize, Serialize};
+use sp_consensus_grandpa::AuthorityList;
+use sp_runtime::traits::{BlakeTwo256, Hash as _, Header as _};
+use thiserror::Error;
+
+use crate::{
+	ensure_collection, format_bytes, format_hash, parse_byte_hex, parse_decimal_u64, parse_hash,
+	LinkedGrandpaProofRequest, NativeBlock, NativeCheckpointRequestError, NativeHeader,
+	TrustAnchorRequest, VerifiedAuthorityOutput, VerifiedFinalityOutput, VerifiedTargetOutput,
+	MAX_AUTHORITY_LIST_BYTES, MAX_NATIVE_HEADER_BYTES, MAX_REQUEST_BYTES,
+};
+
+/// Stable outer request schema.
+pub const REQUEST_SCHEMA: &str =
+	"e2s.native-finalized-pooled-reserve-mint-reservation-state-request.v4";
+/// Stable exact statement schema.
+pub const STATEMENT_SCHEMA: &str = "e2s.pooled-reserve-mint-reservation-state-statement.v4";
+/// Stable successful verification schema.
+pub const VERIFICATION_SCHEMA: &str =
+	"e2s.native-finalized-pooled-reserve-mint-reservation-state-verification.v4";
+/// Successful status, deliberately separate from reservation lifecycle classification.
+pub const VERIFIED_STATUS: &str = "VERIFIED_RELATIVE_TO_SUPPLIED_TRUST_ROOT_DIGEST";
+
+/// Complete direct-finality request for one V4 reservation lifecycle classification.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFinalizedPooledReserveMintReservationStateRequestV4 {
+	/// Exact outer schema.
+	pub schema: String,
+	/// Public deployment trust root.
+	pub trust_anchor: TrustAnchorRequest,
+	/// Expected target native block hash.
+	pub target_native_block_hash_hex: String,
+	/// Canonical SCALE target header.
+	pub target_header_scale_hex: String,
+	/// Hash-linked authority transitions from the trust root.
+	pub linked_grandpa_proofs: Vec<LinkedGrandpaProofRequest>,
+	/// Contiguous headers through the finality horizon.
+	pub checkpoint_tail_headers_scale_hex: Vec<String>,
+	/// Canonical SCALE GRANDPA finality proof for the target.
+	pub finality_proof_scale_hex: String,
+	/// Exact V4 statement, runtime identity, and deterministic storage keys.
+	pub statement: PooledReserveMintReservationStateStatementRequestV4,
+	/// One proof for exactly `:code` plus the six V4 storage keys.
+	pub reservation_state_proof_nodes_hex: Vec<String>,
+}
+
+/// Exact statement identity, runtime identity, and deterministic storage-key expectations.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PooledReserveMintReservationStateStatementRequestV4 {
+	/// Exact statement schema.
+	pub schema: String,
+	/// Exact 603-byte V4 reservation statement.
+	pub statement_hex: String,
+	/// Expected domain-separated statement identity.
+	pub statement_id_hex: String,
+	/// Expected permanent reservation/mint identity.
+	pub reservation_key_hex: String,
+	/// Expected SHA-256 of runtime code authenticated by this same proof.
+	pub bridge_runtime_code_sha256_hex: String,
+	/// Expected exact runtime code byte length.
+	pub bridge_runtime_code_bytes: String,
+	/// Expected deterministic active-profile storage key.
+	pub current_profile_storage_key_hex: String,
+	/// Expected deterministic sticky-enforcement storage key.
+	pub enforcement_storage_key_hex: String,
+	/// Expected deterministic ordered pending-index storage key.
+	pub pending_keys_storage_key_hex: String,
+	/// Expected deterministic target pending map key.
+	pub pending_reservation_storage_key_hex: String,
+	/// Expected deterministic target consumed map key.
+	pub consumed_reservation_storage_key_hex: String,
+	/// Expected deterministic target invalidated map key.
+	pub invalidated_reservation_storage_key_hex: String,
+}
+
+/// Authenticated target and proof metrics for one lifecycle classification.
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedPooledReserveMintReservationStateOutputV4 {
+	/// Lifecycle classification: `absent`, `pending`, `consumed`, or `invalidated`.
+	pub status: String,
+	/// Exact statement identity.
+	pub statement_id_hex: String,
+	/// Exact reservation/mint identity.
+	pub reservation_key_hex: String,
+	/// Active profile identity.
+	pub profile_id_hex: String,
+	/// Canonical active profile SCALE bytes.
+	pub profile_scale_hex: String,
+	/// Strictly ascending pending index size.
+	pub pending_key_count: usize,
+	/// Whether the target occurs in the pending index.
+	pub pending_index_contains_target: bool,
+	/// Canonical lifecycle record SCALE bytes, absent only for `absent`.
+	pub lifecycle_record_scale_hex: Option<String>,
+	/// Exact runtime-code SHA-256.
+	pub bridge_runtime_code_sha256_hex: String,
+	/// Exact runtime-code byte length.
+	pub bridge_runtime_code_bytes: String,
+	/// Confirms runtime code was authenticated in this same trie proof.
+	pub runtime_code_state_proof_verified: bool,
+	/// Number of bounded raw trie nodes consumed.
+	pub proof_node_count: usize,
+	/// Aggregate raw trie-node bytes consumed.
+	pub proof_bytes: usize,
+	/// Confirms all seven reads were evaluated under the target state root.
+	pub seven_key_state_proof_verified: bool,
+	/// Classification is explicitly non-authorizing, including `absent`.
+	pub non_authorizing: bool,
+}
+
+/// Explicit claim and capability boundary for the offline V4 verifier.
+#[derive(Clone, Debug, Deserialize, Serialize, Eq, PartialEq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PooledReserveMintReservationVerificationBoundaryV4 {
+	/// No lifecycle classification authorizes mint.
+	pub mint_authorized: bool,
+	/// The verifier has no signing capability.
+	pub signing_enabled: bool,
+	/// The verifier has no submission capability.
+	pub submission_enabled: bool,
+	/// The verifier has no broadcast capability.
+	pub broadcast_enabled: bool,
+	/// The verifier has no runtime mutation capability.
+	pub runtime_mutation_enabled: bool,
+	/// Runtime-code membership is not independent build or deployment provenance.
+	pub independent_runtime_build_provenance_verified: bool,
+	/// This result alone does not close Gate 5.
+	pub gate5_closed: bool,
+	/// This result alone does not establish trustless bridge operation.
+	pub trustless_operation_verified: bool,
+	/// This result alone does not establish production readiness.
+	pub production_readiness_claimed: bool,
+}
+
+/// Complete non-authorizing V4 verification report.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFinalizedPooledReserveMintReservationStateVerificationV4 {
+	/// Exact successful output schema.
+	pub schema: String,
+	/// Verification status relative to the separately supplied trust-root digest.
+	pub status: String,
+	/// Blake2b-256 digest of the exact outer request bytes.
+	pub request_digest_hex: String,
+	/// Recomputed trust-root digest.
+	pub trust_anchor_digest_hex: String,
+	/// Authenticated target identity and state root.
+	pub target: VerifiedTargetOutput,
+	/// Authenticated GRANDPA authority path.
+	pub authority: VerifiedAuthorityOutput,
+	/// Exact finality horizon.
+	pub finality: VerifiedFinalityOutput,
+	/// Authenticated V4 target lifecycle classification.
+	pub reservation_state: VerifiedPooledReserveMintReservationStateOutputV4,
+	/// Non-negotiable capability and claim boundary.
+	pub boundary: PooledReserveMintReservationVerificationBoundaryV4,
+}
+
+/// Strict outer request or composed proof rejection.
+#[derive(Debug, Error)]
+pub enum NativeFinalizedPooledReserveMintReservationStateRequestErrorV4 {
+	/// Input exceeded the process-level bound.
+	#[error("native finalized pooled-reserve V4 request exceeds {max} bytes: {actual}")]
+	RequestTooLarge {
+		/// Received bytes.
+		actual: usize,
+		/// Maximum bytes.
+		max: usize,
+	},
+	/// Input was not strict JSON.
+	#[error("failed to decode strict native finalized pooled-reserve V4 request JSON: {0}")]
+	Json(#[from] serde_json::Error),
+	/// Outer request schema mismatch.
+	#[error("unsupported native finalized pooled-reserve V4 request schema")]
+	Schema,
+	/// Statement schema mismatch.
+	#[error("unsupported pooled-reserve V4 state statement schema")]
+	StatementSchema,
+	/// Strict common field parsing failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// Generic trust-root, authority-transition, ancestry, or finality verification failed.
+	#[error(transparent)]
+	Finality(#[from] DeploymentFinalityCheckpointError),
+	/// Seven-key V4 state verification failed.
+	#[error(transparent)]
+	State(#[from] PooledReserveMintReservationStateProofErrorV4),
+}
+
+/// Verify one strict direct-finality request entirely offline.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<
+	NativeFinalizedPooledReserveMintReservationStateVerificationV4,
+	NativeFinalizedPooledReserveMintReservationStateRequestErrorV4,
+> {
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(
+			NativeFinalizedPooledReserveMintReservationStateRequestErrorV4::RequestTooLarge {
+				actual: raw_request.len(),
+				max: MAX_REQUEST_BYTES,
+			},
+		);
+	}
+	let request: NativeFinalizedPooledReserveMintReservationStateRequestV4 =
+		serde_json::from_slice(raw_request)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativeFinalizedPooledReserveMintReservationStateRequestErrorV4::Schema);
+	}
+	if request.statement.schema != STATEMENT_SCHEMA {
+		return Err(
+			NativeFinalizedPooledReserveMintReservationStateRequestErrorV4::StatementSchema,
+		);
+	}
+
+	let trusted_anchor_digest = parse_hash("trustedAnchorDigestHex", trusted_anchor_digest_hex)?;
+	let sidechain_id = parse_hash(
+		"trustAnchor.sidechainIdHex",
+		&request.trust_anchor.sidechain_id_hex,
+	)?;
+	let checkpoint_hash = parse_hash(
+		"trustAnchor.checkpointHashHex",
+		&request.trust_anchor.checkpoint_hash_hex,
+	)?;
+	let checkpoint_number_u64 = parse_decimal_u64(
+		"trustAnchor.checkpointNumber",
+		&request.trust_anchor.checkpoint_number,
+	)?;
+	let checkpoint_number =
+		checkpoint_number_u64
+			.try_into()
+			.map_err(|_| NativeCheckpointRequestError::Decimal {
+				field: "trustAnchor.checkpointNumber",
+			})?;
+	let grandpa_set_id = parse_decimal_u64(
+		"trustAnchor.grandpaSetId",
+		&request.trust_anchor.grandpa_set_id,
+	)?;
+	let authority_bytes = parse_byte_hex(
+		"trustAnchor.authorityListScaleHex",
+		&request.trust_anchor.authority_list_scale_hex,
+		MAX_AUTHORITY_LIST_BYTES,
+	)?;
+	let authorities = AuthorityList::decode_all(&mut &authority_bytes[..]).map_err(|_| {
+		NativeCheckpointRequestError::Scale {
+			field: "trustAnchor.authorityListScaleHex",
+		}
+	})?;
+	let anchor = GrandpaDeploymentTrustAnchor::<NativeBlock> {
+		sidechain_id,
+		checkpoint_hash,
+		checkpoint_number,
+		set_id: grandpa_set_id,
+		authorities,
+	};
+
+	let expected_target_hash = parse_hash(
+		"targetNativeBlockHashHex",
+		&request.target_native_block_hash_hex,
+	)?;
+	let target_header_bytes = parse_byte_hex(
+		"targetHeaderScaleHex",
+		&request.target_header_scale_hex,
+		MAX_NATIVE_HEADER_BYTES,
+	)?;
+	let target_header = NativeHeader::decode_all(&mut &target_header_bytes[..]).map_err(|_| {
+		NativeCheckpointRequestError::Scale {
+			field: "targetHeaderScaleHex",
+		}
+	})?;
+	if target_header.hash() != expected_target_hash {
+		return Err(NativeCheckpointRequestError::TargetHashMismatch.into());
+	}
+
+	ensure_collection(
+		"linkedGrandpaProofs",
+		request.linked_grandpa_proofs.len(),
+		0,
+		MAX_LINKED_GRANDPA_PROOF_CHUNKS,
+	)?;
+	let linked_proofs = request
+		.linked_grandpa_proofs
+		.iter()
+		.map(|chunk| {
+			ensure_collection(
+				"linkedGrandpaProofs.ancestryHeadersScaleHex",
+				chunk.ancestry_headers_scale_hex.len(),
+				1,
+				MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+			)?;
+			let ancestry_headers = chunk
+				.ancestry_headers_scale_hex
+				.iter()
+				.map(|encoded| {
+					let bytes = parse_byte_hex(
+						"linkedGrandpaProofs.ancestryHeadersScaleHex",
+						encoded,
+						MAX_NATIVE_HEADER_BYTES,
+					)?;
+					NativeHeader::decode_all(&mut &bytes[..]).map_err(|_| {
+						NativeCheckpointRequestError::Scale {
+							field: "linkedGrandpaProofs.ancestryHeadersScaleHex",
+						}
+					})
+				})
+				.collect::<Result<Vec<_>, _>>()?;
+			let encoded_proof = parse_byte_hex(
+				"linkedGrandpaProofs.proofScaleHex",
+				&chunk.proof_scale_hex,
+				MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+			)?;
+			Ok(LinkedGrandpaAuthorityProofChunk {
+				ancestry_headers,
+				encoded_proof,
+			})
+		})
+		.collect::<Result<Vec<_>, NativeCheckpointRequestError>>()?;
+	ensure_collection(
+		"checkpointTailHeadersScaleHex",
+		request.checkpoint_tail_headers_scale_hex.len(),
+		0,
+		MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+	)?;
+	let checkpoint_tail_headers = request
+		.checkpoint_tail_headers_scale_hex
+		.iter()
+		.map(|encoded| {
+			let bytes = parse_byte_hex(
+				"checkpointTailHeadersScaleHex",
+				encoded,
+				MAX_NATIVE_HEADER_BYTES,
+			)?;
+			NativeHeader::decode_all(&mut &bytes[..]).map_err(|_| {
+				NativeCheckpointRequestError::Scale {
+					field: "checkpointTailHeadersScaleHex",
+				}
+			})
+		})
+		.collect::<Result<Vec<_>, _>>()?;
+	let finality_proof = parse_byte_hex(
+		"finalityProofScaleHex",
+		&request.finality_proof_scale_hex,
+		MAX_FINALITY_PROOF_BYTES,
+	)?;
+
+	let statement_bytes = parse_byte_hex(
+		"statement.statementHex",
+		&request.statement.statement_hex,
+		603,
+	)?;
+	let statement_id = parse_hash(
+		"statement.statementIdHex",
+		&request.statement.statement_id_hex,
+	)?;
+	let reservation_key = parse_hash(
+		"statement.reservationKeyHex",
+		&request.statement.reservation_key_hex,
+	)?;
+	let runtime_code_sha256 = parse_hash(
+		"statement.bridgeRuntimeCodeSha256Hex",
+		&request.statement.bridge_runtime_code_sha256_hex,
+	)?;
+	let runtime_code_bytes_u64 = parse_decimal_u64(
+		"statement.bridgeRuntimeCodeBytes",
+		&request.statement.bridge_runtime_code_bytes,
+	)?;
+	let runtime_code_bytes = usize::try_from(runtime_code_bytes_u64).map_err(|_| {
+		NativeCheckpointRequestError::Decimal {
+			field: "statement.bridgeRuntimeCodeBytes",
+		}
+	})?;
+	if runtime_code_bytes == 0 {
+		return Err(NativeCheckpointRequestError::Decimal {
+			field: "statement.bridgeRuntimeCodeBytes",
+		}
+		.into());
+	}
+	let storage_keys = parse_storage_keys(&request.statement)?;
+	ensure_collection(
+		"reservationStateProofNodesHex",
+		request.reservation_state_proof_nodes_hex.len(),
+		1,
+		MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODES,
+	)?;
+	let proof_nodes = request
+		.reservation_state_proof_nodes_hex
+		.iter()
+		.map(|node| {
+			parse_byte_hex(
+				"reservationStateProofNodesHex",
+				node,
+				MAX_POOLED_RESERVE_MINT_RESERVATION_STATE_PROOF_NODE_BYTES,
+			)
+		})
+		.collect::<Result<Vec<_>, NativeCheckpointRequestError>>()?;
+
+	let finalized = verify_deployment_finality_checkpoint::<NativeBlock>(
+		&anchor,
+		trusted_anchor_digest,
+		target_header,
+		&linked_proofs,
+		&checkpoint_tail_headers,
+		&finality_proof,
+	)?;
+	let requested_header = &finalized.requested_header;
+	let target_native_height = u64::from(*requested_header.number());
+	let verified = verify_pooled_reserve_mint_reservation_state_v4(
+		*requested_header.state_root(),
+		target_native_height,
+		&statement_bytes,
+		statement_id,
+		reservation_key,
+		runtime_code_sha256,
+		runtime_code_bytes,
+		&storage_keys,
+		&proof_nodes,
+	)?;
+	if verified.profile.sidechain_id != sidechain_id {
+		return Err(PooledReserveMintReservationStateProofErrorV4::ProfileMismatch.into());
+	}
+	let pending_index_contains_target = verified
+		.pending_keys
+		.binary_search(&reservation_key)
+		.is_ok();
+	let authority_set_hash =
+		derive_grandpa_authority_set_hash(&finalized.authenticated_authorities);
+
+	Ok(
+		NativeFinalizedPooledReserveMintReservationStateVerificationV4 {
+			schema: VERIFICATION_SCHEMA.to_owned(),
+			status: VERIFIED_STATUS.to_owned(),
+			request_digest_hex: format_hash(BlakeTwo256::hash(raw_request)),
+			trust_anchor_digest_hex: format_hash(finalized.trust_anchor_digest),
+			target: VerifiedTargetOutput {
+				native_block_hash_hex: format_hash(requested_header.hash()),
+				native_height: target_native_height.to_string(),
+				state_root_hex: format_hash(*requested_header.state_root()),
+			},
+			authority: VerifiedAuthorityOutput {
+				finality_signing_set_id: finalized.authenticated_set_id.to_string(),
+				finality_signing_authority_list_scale_hex: format_bytes(
+					&finalized.authenticated_authorities.encode(),
+				),
+				finality_signing_authority_set_hash_hex: format_hash(authority_set_hash),
+				transition_count: finalized.transition_count,
+				linked_ancestry_verified: true,
+			},
+			finality: VerifiedFinalityOutput {
+				horizon_hash_hex: format_hash(finalized.finality_horizon_hash),
+				horizon_height: u64::from(finalized.finality_horizon_number).to_string(),
+				canonical_justification_scale_hex: format_bytes(
+					&finalized.finality.justification.encode(),
+				),
+				verified: true,
+			},
+			reservation_state: VerifiedPooledReserveMintReservationStateOutputV4 {
+				status: verified.reservation_state.status().to_owned(),
+				statement_id_hex: format_hash(verified.statement.statement_id),
+				reservation_key_hex: format_hash(verified.statement.mint_identity),
+				profile_id_hex: format_hash(verified.profile_id),
+				profile_scale_hex: format_bytes(&verified.profile.encode()),
+				pending_key_count: verified.pending_keys.len(),
+				pending_index_contains_target,
+				lifecycle_record_scale_hex: lifecycle_record_scale_hex(&verified.reservation_state),
+				bridge_runtime_code_sha256_hex: format_hash(verified.runtime_code_sha256),
+				bridge_runtime_code_bytes: verified.runtime_code_bytes.to_string(),
+				runtime_code_state_proof_verified: true,
+				proof_node_count: verified.proof_node_count,
+				proof_bytes: verified.proof_bytes,
+				seven_key_state_proof_verified: true,
+				non_authorizing: true,
+			},
+			boundary: PooledReserveMintReservationVerificationBoundaryV4 {
+				mint_authorized: false,
+				signing_enabled: false,
+				submission_enabled: false,
+				broadcast_enabled: false,
+				runtime_mutation_enabled: false,
+				independent_runtime_build_provenance_verified: false,
+				gate5_closed: false,
+				trustless_operation_verified: false,
+				production_readiness_claimed: false,
+			},
+		},
+	)
+}
+
+fn parse_storage_keys(
+	statement: &PooledReserveMintReservationStateStatementRequestV4,
+) -> Result<PooledReserveMintReservationStateStorageKeysV4, NativeCheckpointRequestError> {
+	Ok(PooledReserveMintReservationStateStorageKeysV4 {
+		current_profile: parse_byte_hex(
+			"statement.currentProfileStorageKeyHex",
+			&statement.current_profile_storage_key_hex,
+			80,
+		)?,
+		enforcement: parse_byte_hex(
+			"statement.enforcementStorageKeyHex",
+			&statement.enforcement_storage_key_hex,
+			80,
+		)?,
+		pending_keys: parse_byte_hex(
+			"statement.pendingKeysStorageKeyHex",
+			&statement.pending_keys_storage_key_hex,
+			80,
+		)?,
+		pending_reservation: parse_byte_hex(
+			"statement.pendingReservationStorageKeyHex",
+			&statement.pending_reservation_storage_key_hex,
+			80,
+		)?,
+		consumed_reservation: parse_byte_hex(
+			"statement.consumedReservationStorageKeyHex",
+			&statement.consumed_reservation_storage_key_hex,
+			80,
+		)?,
+		invalidated_reservation: parse_byte_hex(
+			"statement.invalidatedReservationStorageKeyHex",
+			&statement.invalidated_reservation_storage_key_hex,
+			80,
+		)?,
+	})
+}
+
+fn lifecycle_record_scale_hex(state: &PooledReserveMintReservationStateV4) -> Option<String> {
+	match state {
+		PooledReserveMintReservationStateV4::Absent => None,
+		PooledReserveMintReservationStateV4::Pending(value) => Some(format_bytes(&value.encode())),
+		PooledReserveMintReservationStateV4::Consumed(value) => Some(format_bytes(&value.encode())),
+		PooledReserveMintReservationStateV4::Invalidated(value) => {
+			Some(format_bytes(&value.encode()))
+		}
+	}
+}

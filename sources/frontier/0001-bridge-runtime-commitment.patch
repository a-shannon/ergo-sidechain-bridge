+//! Strict composed verification for one finalized causal peg-in mint transition.
+//!
+//! The request preserves the unchanged T20C Frontier transition and reuses its parent/child trie
+//! proofs to authenticate the causal runtime state in the same roots. The resulting report binds
+//! pending V2 admission consumption to the actual finalized child header. It does not establish
+//! source-chain vault eligibility, executable provenance, mint authority, or Gate 5 closure.
+
+use bridge_state_proof::{
+	peg_in_causal_mint_transition_v2::{
+		derive_bridge_storage_map_key_v2, derive_bridge_storage_value_key_v2,
+		verify_causal_peg_in_mint_transition_v2, CausalMintExecutionBindingV2,
+		CausalPegInMintTransitionProofError,
+	},
+	peg_in_frontier_execution_identity_v1::{
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES,
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+	},
+};
+use scale_codec::Encode;
+use serde::{Deserialize, Serialize};
+use sp_core::H256;
+use sp_runtime::traits::{BlakeTwo256, Hash as _};
+use thiserror::Error;
+
+use crate::{
+	ensure_collection, format_bytes, format_hash, parse_byte_hex, parse_decimal_u64, parse_hash,
+	peg_in_frontier_mint_transition_v1::{
+		verify_request_bytes as verify_mint_transition_request_bytes,
+		NativeFrontierPegInMintTransitionRequest, NativeFrontierPegInMintTransitionRequestError,
+		NativeFrontierPegInMintTransitionVerification,
+	},
+	NativeCheckpointRequestError,
+};
+
+const CURRENT_PEG_IN_PROFILE: &[u8] = b"CurrentPegInProfile";
+const CURRENT_CAUSAL_PROFILE: &[u8] = b"CurrentCausalPegInProfileV2";
+const CAUSAL_ENFORCEMENT: &[u8] = b"CausalPegInEnforcementActivatedV2";
+const PENDING_KEYS: &[u8] = b"PendingCausalPegInKeys";
+const PENDING_ADMISSIONS: &[u8] = b"PendingCausalPegInsV2";
+const PROCESSED_PEG_INS: &[u8] = b"ProcessedPegIns";
+const CONSUMED_ADMISSIONS: &[u8] = b"ConsumedCausalPegInsV3";
+
+/// Maximum exact JSON bytes accepted by this composed profile.
+pub const MAX_CAUSAL_MINT_TRANSITION_REQUEST_BYTES: usize = 64 * 1024 * 1024;
+/// Stable outer request schema.
+pub const REQUEST_SCHEMA: &str = "e2s.native-finalized-peg-in-causal-mint-transition-request.v2";
+/// Stable exact-key statement schema.
+pub const STATEMENT_SCHEMA: &str = "e2s.peg-in-causal-mint-transition-statement.v2";
+/// Stable successful report schema.
+pub const VERIFICATION_SCHEMA: &str =
+	"e2s.native-finalized-peg-in-causal-mint-transition-verification.v2";
+/// Stable status preserving the supplied-trust-root boundary.
+pub const VERIFICATION_STATUS: &str =
+	"NATIVE_PEG_IN_CAUSAL_MINT_TRANSITION_VERIFIED_RELATIVE_TO_SUPPLIED_TRUST_ROOT_DIGEST";
+
+/// Exact native storage surface required by the causal transition.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct CausalPegInMintTransitionStatementRequestV2 {
+	/// Exact statement schema.
+	pub schema: String,
+	/// Permanent V1 replay identity used as each map key.
+	pub record_key_hex: String,
+	/// `CurrentPegInProfile` top-trie key.
+	pub current_peg_in_profile_storage_key_hex: String,
+	/// `CurrentCausalPegInProfileV2` top-trie key.
+	pub current_causal_profile_storage_key_hex: String,
+	/// Sticky causal-enforcement top-trie key.
+	pub causal_enforcement_storage_key_hex: String,
+	/// Ordered pending-key list top-trie key.
+	pub pending_keys_storage_key_hex: String,
+	/// Exact pending-admission map key.
+	pub pending_admission_storage_key_hex: String,
+	/// Exact permanent V1 processed-record map key.
+	pub processed_record_storage_key_hex: String,
+	/// Exact consumed V3 map key.
+	pub consumed_admission_storage_key_hex: String,
+}
+
+/// One unchanged T20C request plus the exact causal key statement.
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFinalizedPegInCausalMintTransitionRequestV2 {
+	/// Exact outer request schema.
+	pub schema: String,
+	/// Unchanged finalized Frontier mint-transition request.
+	pub mint_transition_request: NativeFrontierPegInMintTransitionRequest,
+	/// Exact derived causal key statement.
+	pub statement: CausalPegInMintTransitionStatementRequestV2,
+}
+
+/// Exact parent/child header binding shared with T20C.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedCausalHeaderBindingV2 {
+	/// Actual direct-parent native hash.
+	pub parent_native_block_hash_hex: String,
+	/// Actual direct-parent native height.
+	pub parent_native_height: String,
+	/// Authenticated direct-parent state root.
+	pub parent_state_root_hex: String,
+	/// Actual finalized child native hash.
+	pub child_native_block_hash_hex: String,
+	/// Actual finalized child native height.
+	pub child_native_height: String,
+	/// Authenticated child state root.
+	pub child_state_root_hex: String,
+	/// Confirms exact hash linkage and consecutive heights.
+	pub direct_parent_child_verified: bool,
+}
+
+/// Exact authenticated causal successor values.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerifiedCausalStateTransitionV2 {
+	/// Permanent replay identity shared across pending, V1, and V3 maps.
+	pub record_key_hex: String,
+	/// Active causal admission profile identity.
+	pub causal_profile_id_hex: String,
+	/// Authenticated source-intent identity.
+	pub source_intent_id_hex: String,
+	/// Authenticated admission identity.
+	pub admission_id_hex: String,
+	/// Authenticated proof-system identity.
+	pub proof_system_id_hex: String,
+	/// Authenticated proof-profile identity.
+	pub proof_profile_id_hex: String,
+	/// Canonical post-state V1 record SCALE bytes.
+	pub processed_record_scale_hex: String,
+	/// Fixed-width post-state consumed V3 bytes without SCALE vector prefix.
+	pub consumed_admission_v3_hex: String,
+	/// Parent pending-key count.
+	pub parent_pending_key_count: usize,
+	/// Child pending-key count.
+	pub post_pending_key_count: usize,
+	/// Parent proof node count.
+	pub parent_proof_node_count: usize,
+	/// Parent proof bytes.
+	pub parent_proof_bytes: usize,
+	/// Child proof node count.
+	pub post_proof_node_count: usize,
+	/// Child proof bytes.
+	pub post_proof_bytes: usize,
+	/// Confirms the exact pending-to-V1/V3 transition succeeded.
+	pub verified: bool,
+}
+
+/// Explicit non-authorizing boundary for T20E-D proof-core output.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct VerificationBoundaryOutputV2 {
+	/// GRANDPA finality succeeded relative to the supplied trust root.
+	pub sidechain_finality_verified: bool,
+	/// Actual consecutive parent/child headers were bound.
+	pub direct_parent_child_verified: bool,
+	/// Both exact causal state proofs were verified.
+	pub causal_pre_post_state_verified: bool,
+	/// Pending deletion plus V1/V3 creation was verified.
+	pub exact_causal_successor_verified: bool,
+	/// The source committed-vault proof is not established here.
+	pub committed_vault_transition_verified: bool,
+	/// Executable verifier provenance is not established here.
+	pub native_verifier_execution_authenticated: bool,
+	/// This report cannot authorize mint admission.
+	pub mint_authorized: bool,
+	/// This report cannot authorize daemon admission.
+	pub daemon_admission_authorized: bool,
+	/// This report cannot mutate transactions or state.
+	pub transaction_mutation_enabled: bool,
+	/// This report does not close Gate 5.
+	pub gate5_closed: bool,
+	/// This report does not establish production readiness.
+	pub production_readiness_verified: bool,
+}
+
+/// Successful finalized causal transition verification.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct NativeFinalizedPegInCausalMintTransitionVerificationV2 {
+	/// Exact successful report schema.
+	pub schema: String,
+	/// Stable supplied-trust-root status.
+	pub status: String,
+	/// Blake2b-256 digest of exact outer request bytes.
+	pub request_digest_hex: String,
+	/// Exact inherited trust-anchor digest.
+	pub trust_anchor_digest_hex: String,
+	/// Unchanged nested T20C result.
+	pub mint_transition_verification: NativeFrontierPegInMintTransitionVerification,
+	/// Exact parent and actual finalized child binding.
+	pub header_binding: VerifiedCausalHeaderBindingV2,
+	/// Exact causal state successor.
+	pub causal_transition: VerifiedCausalStateTransitionV2,
+	/// Non-negotiable claim boundary.
+	pub boundary: VerificationBoundaryOutputV2,
+}
+
+/// A strict outer request or composed causal transition failure.
+#[derive(Debug, Error)]
+pub enum NativeFinalizedPegInCausalMintTransitionRequestErrorV2 {
+	/// Shared JSON, hex, decimal, or collection parsing failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// Outer request schema did not match V2.
+	#[error("unsupported finalized causal peg-in mint-transition request schema")]
+	Schema,
+	/// Statement schema did not match V2.
+	#[error("unsupported causal peg-in mint-transition statement schema")]
+	StatementSchema,
+	/// Nested T20C verification failed.
+	#[error(transparent)]
+	MintTransition(#[from] NativeFrontierPegInMintTransitionRequestError),
+	/// Canonical nested request serialization failed.
+	#[error("failed to serialize nested Frontier mint-transition request")]
+	NestedRequestSerialization(#[source] serde_json::Error),
+	/// One derived storage key differs from the canonical key.
+	#[error("causal peg-in statement {field} differs from the canonical storage key")]
+	StorageKey {
+		/// Stable field identity.
+		field: &'static str,
+	},
+	/// One authenticated numeric field cannot fit its exact target type.
+	#[error("causal peg-in authenticated {field} exceeds its exact target type")]
+	Numeric {
+		/// Stable field identity.
+		field: &'static str,
+	},
+	/// The exact causal state proof failed.
+	#[error(transparent)]
+	CausalState(#[from] CausalPegInMintTransitionProofError),
+}
+
+/// Verify one exact composed causal transition entirely offline and without side effects.
+pub fn verify_request_bytes(
+	raw_request: &[u8],
+	trusted_anchor_digest_hex: &str,
+) -> Result<
+	NativeFinalizedPegInCausalMintTransitionVerificationV2,
+	NativeFinalizedPegInCausalMintTransitionRequestErrorV2,
+> {
+	if raw_request.len() > MAX_CAUSAL_MINT_TRANSITION_REQUEST_BYTES {
+		return Err(NativeCheckpointRequestError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_CAUSAL_MINT_TRANSITION_REQUEST_BYTES,
+		}
+		.into());
+	}
+	let request: NativeFinalizedPegInCausalMintTransitionRequestV2 =
+		serde_json::from_slice(raw_request).map_err(NativeCheckpointRequestError::Json)?;
+	if request.schema != REQUEST_SCHEMA {
+		return Err(NativeFinalizedPegInCausalMintTransitionRequestErrorV2::Schema);
+	}
+	if request.statement.schema != STATEMENT_SCHEMA {
+		return Err(NativeFinalizedPegInCausalMintTransitionRequestErrorV2::StatementSchema);
+	}
+	let nested_bytes = serde_json::to_vec(&request.mint_transition_request).map_err(
+		NativeFinalizedPegInCausalMintTransitionRequestErrorV2::NestedRequestSerialization,
+	)?;
+	let nested = verify_mint_transition_request_bytes(&nested_bytes, trusted_anchor_digest_hex)?;
+	let record_key = parse_hash("statement.recordKeyHex", &request.statement.record_key_hex)?;
+	validate_statement_keys(&request.statement, record_key)?;
+
+	let parent_nodes = parse_nodes(
+		"mintTransitionRequest.parentStateProofNodesHex",
+		&request.mint_transition_request.parent_state_proof_nodes_hex,
+	)?;
+	let post_nodes = parse_nodes(
+		"mintTransitionRequest.contractStateRequest.eventRequest.executionIdentityRequest.runtimeStateProofNodesHex",
+		&request
+			.mint_transition_request
+			.contract_state_request
+			.event_request
+			.execution_identity_request
+			.runtime_state_proof_nodes_hex,
+	)?;
+	let execution_identity = &nested
+		.contract_state_verification
+		.event_verification
+		.execution_identity;
+	let event = &nested.contract_state_verification.event_verification.event;
+	let parent_height = parse_decimal_u64(
+		"nested.parentLink.parentNativeHeight",
+		&nested.parent_link.parent_native_height,
+	)?;
+	let child_height = parse_decimal_u64(
+		"nested.parentLink.eventNativeHeight",
+		&nested.parent_link.event_native_height,
+	)?;
+	let execution_height = parse_decimal_u64(
+		"nested.execution.executionHeight",
+		&execution_identity.execution.execution_height,
+	)?;
+	let transaction_index = u32::try_from(event.transaction_index).map_err(|_| {
+		NativeFinalizedPegInCausalMintTransitionRequestErrorV2::Numeric {
+			field: "event transaction index",
+		}
+	})?;
+	let binding = CausalMintExecutionBindingV2 {
+		native_parent_block_hash: parse_hash(
+			"nested.parentLink.parentNativeBlockHashHex",
+			&nested.parent_link.parent_native_block_hash_hex,
+		)?,
+		native_parent_height: parent_height,
+		native_child_height: child_height,
+		execution_block_hash: parse_hash(
+			"nested.execution.executionBlockHashHex",
+			&execution_identity.execution.execution_block_hash_hex,
+		)?,
+		execution_height,
+		transaction_hash: parse_hash(
+			"nested.event.transactionHashHex",
+			&event.transaction_hash_hex,
+		)?,
+		transaction_index,
+		event_index: event.global_event_index,
+	};
+	let parent_root = parse_hash(
+		"nested.parentLink.parentStateRootHex",
+		&nested.parent_link.parent_state_root_hex,
+	)?;
+	let child_root = parse_hash(
+		"nested.contractState.stateRootHex",
+		&nested
+			.contract_state_verification
+			.contract_state
+			.state_root_hex,
+	)?;
+	let causal = verify_causal_peg_in_mint_transition_v2(
+		parent_root,
+		child_root,
+		record_key,
+		&parent_nodes,
+		&post_nodes,
+		&binding,
+	)?;
+	let nested_record_scale = parse_byte_hex(
+		"nested.execution.runtimeState.recordStorageValueScaleHex",
+		&execution_identity
+			.runtime_state
+			.record_storage_value_scale_hex,
+		4096,
+	)?;
+	if causal.processed_record.encode() != nested_record_scale {
+		return Err(CausalPegInMintTransitionProofError::PostRecordMismatch.into());
+	}
+	let trust_anchor_digest_hex = nested.trust_anchor_digest_hex.clone();
+
+	Ok(NativeFinalizedPegInCausalMintTransitionVerificationV2 {
+		schema: VERIFICATION_SCHEMA.to_owned(),
+		status: VERIFICATION_STATUS.to_owned(),
+		request_digest_hex: format_hash(BlakeTwo256::hash(raw_request)),
+		trust_anchor_digest_hex,
+		header_binding: VerifiedCausalHeaderBindingV2 {
+			parent_native_block_hash_hex: format_hash(binding.native_parent_block_hash),
+			parent_native_height: binding.native_parent_height.to_string(),
+			parent_state_root_hex: format_hash(parent_root),
+			child_native_block_hash_hex: nested.parent_link.event_native_block_hash_hex.clone(),
+			child_native_height: binding.native_child_height.to_string(),
+			child_state_root_hex: format_hash(child_root),
+			direct_parent_child_verified: true,
+		},
+		causal_transition: VerifiedCausalStateTransitionV2 {
+			record_key_hex: format_hash(causal.record_key),
+			causal_profile_id_hex: format_hash(causal.causal_profile_id),
+			source_intent_id_hex: format_hash(causal.source_intent_id),
+			admission_id_hex: format_hash(causal.admission_id),
+			proof_system_id_hex: format_hash(causal.proof_system_id),
+			proof_profile_id_hex: format_hash(causal.proof_profile_id),
+			processed_record_scale_hex: format_bytes(&causal.processed_record.encode()),
+			consumed_admission_v3_hex: format_bytes(&causal.consumed_admission_v3),
+			parent_pending_key_count: causal.parent_pending_key_count,
+			post_pending_key_count: causal.post_pending_key_count,
+			parent_proof_node_count: causal.parent_proof_node_count,
+			parent_proof_bytes: causal.parent_proof_bytes,
+			post_proof_node_count: causal.post_proof_node_count,
+			post_proof_bytes: causal.post_proof_bytes,
+			verified: true,
+		},
+		mint_transition_verification: nested,
+		boundary: VerificationBoundaryOutputV2 {
+			sidechain_finality_verified: true,
+			direct_parent_child_verified: true,
+			causal_pre_post_state_verified: true,
+			exact_causal_successor_verified: true,
+			committed_vault_transition_verified: false,
+			native_verifier_execution_authenticated: false,
+			mint_authorized: false,
+			daemon_admission_authorized: false,
+			transaction_mutation_enabled: false,
+			gate5_closed: false,
+			production_readiness_verified: false,
+		},
+	})
+}
+
+fn validate_statement_keys(
+	statement: &CausalPegInMintTransitionStatementRequestV2,
+	record_key: H256,
+) -> Result<(), NativeFinalizedPegInCausalMintTransitionRequestErrorV2> {
+	let expected = [
+		(
+			"currentPegInProfileStorageKeyHex",
+			&statement.current_peg_in_profile_storage_key_hex,
+			derive_bridge_storage_value_key_v2(CURRENT_PEG_IN_PROFILE),
+		),
+		(
+			"currentCausalProfileStorageKeyHex",
+			&statement.current_causal_profile_storage_key_hex,
+			derive_bridge_storage_value_key_v2(CURRENT_CAUSAL_PROFILE),
+		),
+		(
+			"causalEnforcementStorageKeyHex",
+			&statement.causal_enforcement_storage_key_hex,
+			derive_bridge_storage_value_key_v2(CAUSAL_ENFORCEMENT),
+		),
+		(
+			"pendingKeysStorageKeyHex",
+			&statement.pending_keys_storage_key_hex,
+			derive_bridge_storage_value_key_v2(PENDING_KEYS),
+		),
+		(
+			"pendingAdmissionStorageKeyHex",
+			&statement.pending_admission_storage_key_hex,
+			derive_bridge_storage_map_key_v2(PENDING_ADMISSIONS, record_key),
+		),
+		(
+			"processedRecordStorageKeyHex",
+			&statement.processed_record_storage_key_hex,
+			derive_bridge_storage_map_key_v2(PROCESSED_PEG_INS, record_key),
+		),
+		(
+			"consumedAdmissionStorageKeyHex",
+			&statement.consumed_admission_storage_key_hex,
+			derive_bridge_storage_map_key_v2(CONSUMED_ADMISSIONS, record_key),
+		),
+	];
+	for (field, supplied, canonical) in expected {
+		let parsed = parse_byte_hex(field, supplied, canonical.len())?;
+		if parsed != canonical {
+			return Err(
+				NativeFinalizedPegInCausalMintTransitionRequestErrorV2::StorageKey { field },
+			);
+		}
+	}
+	Ok(())
+}
+
+fn parse_nodes(
+	field: &'static str,
+	values: &[String],
+) -> Result<Vec<Vec<u8>>, NativeCheckpointRequestError> {
+	ensure_collection(
+		field,
+		values.len(),
+		1,
+		MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODES,
+	)?;
+	values
+		.iter()
+		.map(|value| {
+			parse_byte_hex(
+				field,
+				value,
+				MAX_FRONTIER_EXECUTION_IDENTITY_PROOF_NODE_BYTES,
+			)
+		})
+		.collect()
+}
+
+#[cfg(test)]
+mod tests {
+	use super::*;
+	use crate::peg_in_causal_mint_transition_v2_fixture::{
+		deterministic_fixture_request, deterministic_fixture_request_with_mutation, FixtureMutation,
+	};
+	use crate::peg_in_frontier_execution_identity_v1_fixture::deterministic_trusted_anchor_digest_hex;

+			VAULT_SHA256_OFFSET,
+			TRANSACTION_SEMANTICS_DIGEST_OFFSET,
+			SOURCE_BOX_ID_OFFSET,
+			SOURCE_BOX_CONTENT_DIGEST_OFFSET,
+			VAULT_BOX_ID_OFFSET,
+			CURRENT_STATE_OBSERVATION_DIGEST_OFFSET,

+	pub target_transactions_root: H256,
+	pub source_box_id: H256,
+	pub source_box_length: u32,
+	pub source_input_index: u32,
+	pub source_reference_count: u8,
+	pub amount_nano_erg: u64,
+	pub source_lock_ergo_tree_sha256: H256,
+	pub recipient_h160: [u8; 20],
+	pub depositor_ergo_tree_sha256: H256,
+	pub vault_box_id: H256,
+	pub vault_box_bytes: Vec<u8>,
+	pub vault_output_index: u32,
+	pub vault_ergo_tree_sha256: H256,
+}
+
+struct ParsedProfileV1<'a> {
+	parser_profile_id: H256,
+	route_profile_id: H256,
+	asset_profile_id: H256,
+	source_lock_ergo_tree: &'a [u8],
+	vault_ergo_tree: &'a [u8],
+	change_ergo_tree: &'a [u8],
+}
+
+struct InputV1<'a> {
+	box_id: H256,
+	proof: &'a [u8],
+	context_extension: &'a [u8],
+}
+
+struct OutputV1<'a> {
+	value_nano_erg: u64,
+	ergo_tree: &'a [u8],
+	creation_height: u32,
+	registers: Vec<&'a [u8]>,
+}
+
+struct TransactionV1<'a> {
+	block_version: u8,
+	transaction_index: u32,
+	transaction_count: u32,
+	inputs: Vec<InputV1<'a>>,
+	outputs: Vec<OutputV1<'a>>,
+}
+
+struct SourceSemanticsV1<'a> {
+	box_id: H256,
+	value_nano_erg: u64,
+	recipient_h160: [u8; 20],
+	depositor_ergo_tree: &'a [u8],
+}
+
+pub fn ergo_scorex_transaction_runtime_witness_family_id_v1() -> H256 {
+	H256::from(blake2_256(FAMILY_DOMAIN_V1))
+}
+
+pub fn ergo_scorex_transaction_runtime_parser_profile_id_v1<
+	P: ErgoScorexTransactionRuntimeParserProfileV1,
+>() -> H256 {
+	let mut bytes = Vec::new();
+	bytes.extend_from_slice(PARSER_PROFILE_DOMAIN_V1);
+	bytes.extend_from_slice(P::route_profile_id().as_bytes());
+	bytes.extend_from_slice(P::asset_profile_id().as_bytes());
+	push_u16_bytes(&mut bytes, P::source_lock_ergo_tree());
+	push_u16_bytes(&mut bytes, P::vault_ergo_tree());
+	push_u16_bytes(&mut bytes, P::change_ergo_tree());
+	H256::from(blake2_256(&bytes))
+}
+
+pub fn derive_ergo_scorex_transaction_runtime_witness_id_v1(
+	witness_bytes: &[u8],
+) -> Result<H256, &'static str> {
+	if witness_bytes.len() < ENVELOPE_HEADER_BYTES_V1
+		|| witness_bytes.len() > ERGO_SCOREX_TRANSACTION_RUNTIME_WITNESS_MAX_BYTES_V1
+	{
+		return Err("Ergo Scorex transaction witness length is outside its bound");
+	}
+	let mut bytes = Vec::with_capacity(WITNESS_ID_DOMAIN_V1.len() + witness_bytes.len());
+	bytes.extend_from_slice(WITNESS_ID_DOMAIN_V1);
+	bytes.extend_from_slice(witness_bytes);
+	Ok(H256::from(blake2_256(&bytes)))
+}
+
+pub fn verify_ergo_scorex_transaction_runtime_witness_v1<
+	P: ErgoScorexTransactionRuntimeParserProfileV1,
+>(
+	witness_bytes: &[u8],
+) -> Result<VerifiedErgoScorexTransactionRuntimeWitnessV1, &'static str> {
+	if witness_bytes.len() < ENVELOPE_HEADER_BYTES_V1
+		|| witness_bytes.len() > ERGO_SCOREX_TRANSACTION_RUNTIME_WITNESS_MAX_BYTES_V1
+	{
+		return Err("Ergo Scorex transaction witness length is outside its bound");
+	}
+	let mut envelope = CursorV1::new(witness_bytes);
+	if envelope.take(8)? != MAGIC_V1 {
+		return Err("Ergo Scorex transaction witness magic is unsupported");
+	}
+	if envelope.u8()? != ERGO_SCOREX_TRANSACTION_RUNTIME_WITNESS_FORMAT_V1 {
+		return Err("Ergo Scorex transaction witness format is unsupported");
+	}
+	if envelope.u8()? != 0 {
+		return Err("Ergo Scorex transaction witness flags are unsupported");
+	}
+	if envelope.u16()? as usize != SECTION_COUNT_V1 {
+		return Err("Ergo Scorex transaction witness section count is unsupported");
+	}
+	if envelope.u32()? as usize != witness_bytes.len() {
+		return Err("Ergo Scorex transaction witness total length is inconsistent");
+	}
+	if H256::from(envelope.array::<32>()?) != ergo_scorex_transaction_runtime_witness_family_id_v1()
+	{
+		return Err("Ergo Scorex transaction witness format-family ID is unsupported");
+	}
+	let mut section_lengths = [0usize; SECTION_COUNT_V1];
+	let mut payload_length = 0usize;
+	for (index, length) in section_lengths.iter_mut().enumerate() {
+		if envelope.u8()? as usize != index + 1 || envelope.u8()? != 0 {
+			return Err("Ergo Scorex transaction witness section directory is unsupported");
+		}
+		*length = envelope.u32()? as usize;
+		payload_length = payload_length
+			.checked_add(*length)
+			.ok_or("Ergo Scorex transaction witness section lengths overflow")?;
+	}
+	if payload_length != witness_bytes.len() - ENVELOPE_HEADER_BYTES_V1 {
+		return Err("Ergo Scorex transaction witness section lengths are inconsistent");
+	}
+	let profile = parse_profile_v1::<P>(envelope.take(section_lengths[0])?)?;
+	let transaction = parse_transaction_v1(envelope.take(section_lengths[1])?, &profile)?;
+	let (transaction_siblings, witness_siblings) =
+		parse_inclusion_v1(envelope.take(section_lengths[2])?)?;
+	let source_box = envelope.take(section_lengths[3])?;
+	envelope.end("Ergo Scorex transaction witness contains trailing bytes")?;
+	verify_semantics_v1::<P>(
+		witness_bytes,
+		profile,
+		transaction,
+		transaction_siblings,
+		witness_siblings,
+		source_box,
+	)
+}
+
+fn parse_profile_v1<P: ErgoScorexTransactionRuntimeParserProfileV1>(
+	bytes: &[u8],
+) -> Result<ParsedProfileV1<'_>, &'static str> {
+	let mut cursor = CursorV1::new(bytes);
+	let supplied_parser_profile_id = H256::from(cursor.array::<32>()?);
+	let route_profile_id = H256::from(cursor.array::<32>()?);
+	let asset_profile_id = H256::from(cursor.array::<32>()?);
+	let source_lock_ergo_tree = cursor.byte_string_u16(MAX_TREE_BYTES_V1)?;
+	let vault_ergo_tree = cursor.byte_string_u16(MAX_TREE_BYTES_V1)?;
+	let change_ergo_tree = cursor.byte_string_u16(MAX_TREE_BYTES_V1)?;
+	cursor.end("Ergo Scorex transaction profile contains trailing bytes")?;
+	if source_lock_ergo_tree.is_empty() || vault_ergo_tree.is_empty() || change_ergo_tree.is_empty()
+	{
+		return Err("Ergo Scorex transaction profile contains an empty ErgoTree");
+	}
+	let expected_parser_profile_id = ergo_scorex_transaction_runtime_parser_profile_id_v1::<P>();
+	if supplied_parser_profile_id != expected_parser_profile_id
+		|| route_profile_id != P::route_profile_id()
+		|| asset_profile_id != P::asset_profile_id()
+		|| source_lock_ergo_tree != P::source_lock_ergo_tree()
+		|| vault_ergo_tree != P::vault_ergo_tree()
+		|| change_ergo_tree != P::change_ergo_tree()
+	{
+		return Err("Ergo Scorex transaction parser profile is not statically registered");
+	}
+	Ok(ParsedProfileV1 {
+		parser_profile_id: supplied_parser_profile_id,
+		route_profile_id,
+		asset_profile_id,
+		source_lock_ergo_tree,
+		vault_ergo_tree,
+		change_ergo_tree,
+	})
+}
+
+fn parse_transaction_v1<'a>(
+	bytes: &'a [u8],
+	profile: &ParsedProfileV1<'_>,
+) -> Result<TransactionV1<'a>, &'static str> {
+	let mut cursor = CursorV1::new(bytes);
+	let block_version = cursor.u8()?;
+	let transaction_index = cursor.u32()?;
+	let transaction_count = cursor.u32()?;
+	if cursor.u8()? as usize != EXACT_INPUTS_V1 {
+		return Err("Ergo Scorex transaction must contain exactly two inputs");
+	}
+	let mut inputs = Vec::with_capacity(EXACT_INPUTS_V1);
+	let mut total_proof_bytes = 0usize;
+	for _ in 0..EXACT_INPUTS_V1 {
+		let box_id = H256::from(cursor.array::<32>()?);
+		let proof = cursor.byte_string_u32(MAX_PROOF_BYTES_V1)?;
+		total_proof_bytes = total_proof_bytes
+			.checked_add(proof.len())
+			.ok_or("Ergo Scorex proof lengths overflow")?;
+		if total_proof_bytes > MAX_PROOF_BYTES_V1 {
+			return Err("Ergo Scorex proof payloads exceed 64 KiB");
+		}
+		let context_extension = cursor.byte_string_u16(1)?;
+		if context_extension != [0] {
+			return Err("Ergo Scorex transaction supports only empty context extensions");
+		}
+		inputs.push(InputV1 {
+			box_id,
+			proof,
+			context_extension,
+		});
+	}
+	if cursor.u8()? != 0 || cursor.u8()? != 0 {
+		return Err("Ergo Scorex transaction data inputs or token table are unsupported");
+	}
+	if cursor.u8()? as usize != EXACT_OUTPUTS_V1 {
+		return Err("Ergo Scorex transaction must contain exactly two outputs");
+	}
+	let expected_trees = [profile.vault_ergo_tree, profile.change_ergo_tree];
+	let mut outputs = Vec::with_capacity(EXACT_OUTPUTS_V1);
+	for (index, expected_tree) in expected_trees.into_iter().enumerate() {
+		let value_nano_erg = cursor.u64()?;
+		if value_nano_erg == 0 || value_nano_erg > ERGO_LONG_MAX_V1 {
+			return Err("Ergo Scorex output value is outside the positive Ergo Long range");
+		}
+		let ergo_tree = cursor.byte_string_u16(MAX_TREE_BYTES_V1)?;
+		if ergo_tree != expected_tree {
+			return Err("Ergo Scorex output uses an unregistered ErgoTree");
+		}
+		let creation_height = cursor.u32()?;
+		if cursor.u8()? != 0 {
+			return Err("Ergo Scorex output tokens are unsupported");
+		}
+		let register_count = cursor.u8()? as usize;
+		if register_count != if index == 0 { 4 } else { 0 } {
+			return Err("Ergo Scorex output register count is unsupported");
+		}
+		let mut registers = Vec::with_capacity(register_count);
+		for _ in 0..register_count {
+			registers.push(cursor.byte_string_u16(MAX_REGISTER_BYTES_V1)?);
+		}
+		outputs.push(OutputV1 {
+			value_nano_erg,
+			ergo_tree,
+			creation_height,
+			registers,
+		});
+	}
+	cursor.end("Ergo Scorex transaction section contains trailing bytes")?;
+	Ok(TransactionV1 {
+		block_version,
+		transaction_index,
+		transaction_count,
+		inputs,
+		outputs,
+	})
+}
+
+fn parse_inclusion_v1(bytes: &[u8]) -> Result<(Vec<H256>, Vec<H256>), &'static str> {
+	let mut cursor = CursorV1::new(bytes);
+	let transaction_count = cursor.u8()? as usize;
+	if transaction_count > MAX_MERKLE_SIBLINGS_V1 {
+		return Err("Ergo Scorex transaction-ID Merkle path exceeds its bound");
+	}
+	let mut transaction_siblings = Vec::with_capacity(transaction_count);
+	for _ in 0..transaction_count {
+		transaction_siblings.push(H256::from(cursor.array::<32>()?));
+	}
+	let witness_count = cursor.u8()? as usize;
+	if witness_count > MAX_MERKLE_SIBLINGS_V1 {
+		return Err("Ergo Scorex witness-ID Merkle path exceeds its bound");
+	}
+	let mut witness_siblings = Vec::with_capacity(witness_count);
+	for _ in 0..witness_count {
+		witness_siblings.push(H256::from(cursor.array::<32>()?));
+	}
+	cursor.end("Ergo Scorex inclusion section contains trailing bytes")?;
+	Ok((transaction_siblings, witness_siblings))
+}
+
+fn verify_semantics_v1<P: ErgoScorexTransactionRuntimeParserProfileV1>(
+	witness_bytes: &[u8],
+	profile: ParsedProfileV1<'_>,
+	transaction: TransactionV1<'_>,
+	transaction_siblings: Vec<H256>,
+	witness_siblings: Vec<H256>,
+	source_box: &[u8],
+) -> Result<VerifiedErgoScorexTransactionRuntimeWitnessV1, &'static str> {
+	if !(2..=4).contains(&transaction.block_version) {
+		return Err("Ergo Scorex transaction block version is unsupported");
+	}
+	if transaction.transaction_count == 0
+		|| transaction.transaction_count > MAX_TRANSACTION_COUNT_V1
+		|| transaction.transaction_index >= transaction.transaction_count
+	{
+		return Err("Ergo Scorex transaction position is invalid");
+	}
+	let source = parse_source_box_v1(source_box, &profile)?;
+	let mut source_reference_count = 0u8;
+	let mut source_input_index = 0u32;
+	for (index, input) in transaction.inputs.iter().enumerate() {
+		if input.box_id == source.box_id {
+			source_reference_count = source_reference_count.saturating_add(1);
+			source_input_index = index as u32;
+		}
+	}
+	if source_reference_count != 1 || transaction.inputs[0].box_id == transaction.inputs[1].box_id {
+		return Err("Ergo Scorex refundable source input binding is invalid");
+	}
+	let vault_output = &transaction.outputs[0];
+	let change_output = &transaction.outputs[1];
+	if vault_output.value_nano_erg != source.value_nano_erg || !change_output.registers.is_empty() {
+		return Err("Ergo Scorex committed-vault transition shape is invalid");
+	}
+	parse_vault_registers_v1(&vault_output.registers, &source)?;
+
+	let signed_transaction = serialize_transaction_v1(&transaction, false)?;
+	let bytes_to_sign = serialize_transaction_v1(&transaction, true)?;
+	if signed_transaction.is_empty() || signed_transaction.len() > MAX_PROOF_BYTES_V1 {
+		return Err("Ergo Scorex signed transaction exceeds its bound");
+	}
+	let transaction_id = H256::from(blake2_256(&bytes_to_sign));
+	let mut proof_payloads = Vec::new();
+	for input in &transaction.inputs {
+		proof_payloads.extend_from_slice(input.proof);
+	}
+	let proof_digest = blake2_256(&proof_payloads);
+	let mut transaction_witness_leaf_id = [0u8; 31];
+	transaction_witness_leaf_id.copy_from_slice(&proof_digest[1..]);
+	let leaf_count = transaction
+		.transaction_count
+		.checked_mul(2)
+		.ok_or("Ergo Scorex transaction leaf count overflows")?;
+	let transaction_root = verify_scorex_merkle_path_v1(
+		transaction_id.as_bytes(),
+		transaction.transaction_index,
+		leaf_count,
+		&transaction_siblings,
+	)?;
+	let witness_root = verify_scorex_merkle_path_v1(
+		&transaction_witness_leaf_id,
+		transaction.transaction_count + transaction.transaction_index,
+		leaf_count,
+		&witness_siblings,
+	)?;
+	if transaction_root != witness_root {
+		return Err("Ergo Scorex transaction and witness Merkle paths disagree");
+	}
+	let serialized_vault = serialize_output_v1(vault_output)?;
+	let mut vault_box_preimage = Vec::with_capacity(serialized_vault.len() + 33);
+	vault_box_preimage.extend_from_slice(&serialized_vault);
+	vault_box_preimage.extend_from_slice(transaction_id.as_bytes());
+	push_unsigned_vlq(&mut vault_box_preimage, 0);
+
+	Ok(VerifiedErgoScorexTransactionRuntimeWitnessV1 {
+		witness_id: derive_ergo_scorex_transaction_runtime_witness_id_v1(witness_bytes)?,
+		parser_profile_id: profile.parser_profile_id,
+		route_profile_id: profile.route_profile_id,
+		asset_profile_id: profile.asset_profile_id,
+		block_version: transaction.block_version,
+		transaction_index: transaction.transaction_index,
+		transaction_count: transaction.transaction_count,
+		transaction_id,
+		signed_transaction_sha256: H256::from(sha2_256(&signed_transaction)),
+		signed_transaction_length: signed_transaction.len() as u32,
+		transaction_witness_leaf_id,
+		target_transactions_root: transaction_root,
+		source_box_id: source.box_id,
+		source_box_length: source_box.len() as u32,
+		source_input_index,
+		source_reference_count,
+		amount_nano_erg: source.value_nano_erg,
+		source_lock_ergo_tree_sha256: H256::from(sha2_256(P::source_lock_ergo_tree())),
+		recipient_h160: source.recipient_h160,
+		depositor_ergo_tree_sha256: H256::from(sha2_256(source.depositor_ergo_tree)),
+		vault_box_id: H256::from(blake2_256(&vault_box_preimage)),
+		vault_box_bytes: vault_box_preimage,
+		vault_output_index: 0,
+		vault_ergo_tree_sha256: H256::from(sha2_256(P::vault_ergo_tree())),
+	})
+}
+
+fn parse_source_box_v1<'a>(
+	bytes: &'a [u8],
+	profile: &ParsedProfileV1<'_>,
+) -> Result<SourceSemanticsV1<'a>, &'static str> {
+	if bytes.is_empty() || bytes.len() > MAX_BOX_BYTES_V1 {
+		return Err("Ergo Scorex refundable source box length is outside its bound");
+	}
+	let mut cursor = ScorexCursorV1::new(bytes);
+	let value_nano_erg = cursor.vlq(64)?;
+	if value_nano_erg == 0 || value_nano_erg > ERGO_LONG_MAX_V1 {
+		return Err("Ergo Scorex refundable source value is invalid");
+	}
+	if cursor.take(profile.source_lock_ergo_tree.len())? != profile.source_lock_ergo_tree {
+		return Err("Ergo Scorex refundable source ErgoTree is not registered");
+	}
+	cursor.vlq(32)?;
+	if cursor.u8()? != 0 || cursor.u8()? != 4 {
+		return Err("Ergo Scorex refundable source tokens or registers are unsupported");
+	}
+	let recipient = cursor.coll_byte(20, 20)?;
+	let registered_amount = cursor.positive_long()?;
+	if registered_amount != value_nano_erg {
+		return Err("Ergo Scorex refundable source amount register disagrees");
+	}
+	let signer = cursor.coll_byte(33, 33)?;
+	let signer_array: [u8; 33] = signer.try_into().map_err(|_| "invalid signer length")?;
+	PublicKey::parse_compressed(&signer_array)
+		.map_err(|_| "Ergo Scorex refundable source signer is invalid")?;
+	let depositor_ergo_tree = cursor.coll_byte(1, MAX_TREE_BYTES_V1)?;
+	cursor.take(32)?;
+	cursor.vlq(16)?;
+	cursor.end("Ergo Scorex refundable source box contains trailing bytes")?;
+	let mut recipient_h160 = [0u8; 20];
+	recipient_h160.copy_from_slice(recipient);
+	Ok(SourceSemanticsV1 {
+		box_id: H256::from(blake2_256(bytes)),
+		value_nano_erg,
+		recipient_h160,
+		depositor_ergo_tree,
+	})
+}
+
+fn parse_vault_registers_v1(
+	registers: &[&[u8]],
+	source: &SourceSemanticsV1<'_>,
+) -> Result<(), &'static str> {
+	if registers.len() != 4 {
+		return Err("Ergo Scorex vault must contain exactly R4-R7");
+	}
+	if parse_standalone_coll_byte_v1(registers[0], 32, 32)? != source.box_id.as_bytes()
+		|| parse_standalone_coll_byte_v1(registers[1], 20, 20)? != source.recipient_h160
+		|| parse_standalone_long_v1(registers[2])? != source.value_nano_erg
+		|| parse_standalone_coll_byte_v1(registers[3], 1, MAX_TREE_BYTES_V1)?
+			!= source.depositor_ergo_tree
+	{
+		return Err("Ergo Scorex vault registers do not bind the refundable source");
+	}
+	Ok(())
+}
+
+fn parse_standalone_coll_byte_v1(
+	bytes: &[u8],
+	minimum: usize,
+	maximum: usize,
+) -> Result<&[u8], &'static str> {
+	let mut cursor = ScorexCursorV1::new(bytes);
+	let value = cursor.coll_byte(minimum, maximum)?;
+	cursor.end("Ergo Scorex Coll[Byte] register contains trailing bytes")?;
+	Ok(value)
+}
+
+fn parse_standalone_long_v1(bytes: &[u8]) -> Result<u64, &'static str> {
+	let mut cursor = ScorexCursorV1::new(bytes);
+	let value = cursor.positive_long()?;
+	cursor.end("Ergo Scorex Long register contains trailing bytes")?;
+	Ok(value)
+}
+
+fn serialize_transaction_v1(
+	transaction: &TransactionV1<'_>,
+	proofless: bool,
+) -> Result<Vec<u8>, &'static str> {
+	let mut bytes = Vec::new();
+	push_unsigned_vlq(&mut bytes, transaction.inputs.len() as u64);
+	for input in &transaction.inputs {
+		bytes.extend_from_slice(input.box_id.as_bytes());
+		let proof = if proofless { &[][..] } else { input.proof };
+		push_unsigned_vlq(&mut bytes, proof.len() as u64);
+		bytes.extend_from_slice(proof);
+		bytes.extend_from_slice(input.context_extension);
+	}
+	push_unsigned_vlq(&mut bytes, 0);
+	push_unsigned_vlq(&mut bytes, 0);
+	push_unsigned_vlq(&mut bytes, transaction.outputs.len() as u64);
+	for output in &transaction.outputs {
+		bytes.extend_from_slice(&serialize_output_v1(output)?);
+	}
+	Ok(bytes)
+}
+
+fn serialize_output_v1(output: &OutputV1<'_>) -> Result<Vec<u8>, &'static str> {
+	let mut bytes = Vec::new();
+	push_unsigned_vlq(&mut bytes, output.value_nano_erg);
+	bytes.extend_from_slice(output.ergo_tree);
+	push_unsigned_vlq(&mut bytes, output.creation_height as u64);
+	bytes.push(0);
+	bytes.push(output.registers.len() as u8);
+	for register in &output.registers {
+		bytes.extend_from_slice(register);
+	}
+	if bytes.len() > MAX_OUTPUT_BYTES_V1 {
+		return Err("Ergo Scorex output body exceeds its bound");
+	}
+	Ok(bytes)
+}
+
+fn verify_scorex_merkle_path_v1(
+	raw_leaf: &[u8],
+	leaf_index: u32,
+	leaf_count: u32,
+	siblings: &[H256],
+) -> Result<H256, &'static str> {
+	if leaf_count == 0 || leaf_index >= leaf_count {
+		return Err("Ergo Scorex Merkle leaf position is invalid");
+	}
+	let mut leaf = Vec::with_capacity(raw_leaf.len() + 1);
+	leaf.push(SCOREX_LEAF_PREFIX);
+	leaf.extend_from_slice(raw_leaf);
+	let mut node = H256::from(blake2_256(&leaf));
+	let mut index = leaf_index;
+	let mut width = leaf_count;
+	let mut sibling_index = 0usize;
+	while width > 1 {
+		let sibling_position = index ^ 1;
+		let mut branch = Vec::with_capacity(65);
+		branch.push(SCOREX_INTERNAL_PREFIX);
+		if sibling_position < width {
+			let sibling = siblings
+				.get(sibling_index)
+				.ok_or("Ergo Scorex Merkle path is truncated")?;
+			sibling_index += 1;
+			if index % 2 == 0 {
+				branch.extend_from_slice(node.as_bytes());
+				branch.extend_from_slice(sibling.as_bytes());
+			} else {
+				branch.extend_from_slice(sibling.as_bytes());
+				branch.extend_from_slice(node.as_bytes());
+			}
+		} else {
+			branch.extend_from_slice(node.as_bytes());
+		}
+		node = H256::from(blake2_256(&branch));
+		index /= 2;
+		width = (width + 1) / 2;
+	}
+	if sibling_index != siblings.len() {
+		return Err("Ergo Scorex Merkle path contains unused siblings");
+	}
+	Ok(node)
+}
+
+fn push_u16_bytes(target: &mut Vec<u8>, value: &[u8]) {
+	target.extend_from_slice(&(value.len() as u16).to_be_bytes());
+	target.extend_from_slice(value);
+}
+
+fn push_unsigned_vlq(target: &mut Vec<u8>, mut value: u64) {
+	loop {
+		let mut byte = (value & 0x7f) as u8;
+		value >>= 7;
+		if value != 0 {
+			byte |= 0x80;
+		}
+		target.push(byte);
+		if value == 0 {
+			break;
+		}
+	}
+}
+
+struct CursorV1<'a> {
+	source: &'a [u8],
+	offset: usize,
+}
+
+impl<'a> CursorV1<'a> {
+	fn new(source: &'a [u8]) -> Self {
+		Self { source, offset: 0 }
+	}
+
+	fn take(&mut self, length: usize) -> Result<&'a [u8], &'static str> {
+		let end = self
+			.offset
+			.checked_add(length)
+			.ok_or("binary field length overflows")?;
+		if end > self.source.len() {
+			return Err("binary field exceeds its section boundary");
+		}
+		let value = &self.source[self.offset..end];
+		self.offset = end;
+		Ok(value)
+	}
+
+	fn array<const N: usize>(&mut self) -> Result<[u8; N], &'static str> {
+		self.take(N)?
+			.try_into()
+			.map_err(|_| "binary array length is invalid")
+	}
+
+	fn u8(&mut self) -> Result<u8, &'static str> {
+		Ok(self.take(1)?[0])
+	}
+
+	fn u16(&mut self) -> Result<u16, &'static str> {
+		Ok(u16::from_be_bytes(self.array::<2>()?))
+	}
+
+	fn u32(&mut self) -> Result<u32, &'static str> {
+		Ok(u32::from_be_bytes(self.array::<4>()?))
+	}
+
+	fn u64(&mut self) -> Result<u64, &'static str> {
+		Ok(u64::from_be_bytes(self.array::<8>()?))
+	}
+
+	fn byte_string_u16(&mut self, maximum: usize) -> Result<&'a [u8], &'static str> {
+		let length = self.u16()? as usize;
+		if length > maximum {
+			return Err("UInt16 byte string exceeds its bound");
+		}
+		self.take(length)
+	}
+
+	fn byte_string_u32(&mut self, maximum: usize) -> Result<&'a [u8], &'static str> {
+		let length = self.u32()? as usize;
+		if length > maximum {
+			return Err("UInt32 byte string exceeds its bound");
+		}
+		self.take(length)
+	}
+
+	fn end(&self, error: &'static str) -> Result<(), &'static str> {
+		if self.offset != self.source.len() {
+			return Err(error);
+		}
+		Ok(())
+	}
+}
+
+struct ScorexCursorV1<'a> {
+	source: &'a [u8],
+	offset: usize,
+}
+
+impl<'a> ScorexCursorV1<'a> {
+	fn new(source: &'a [u8]) -> Self {
+		Self { source, offset: 0 }
+	}
+
+	fn take(&mut self, length: usize) -> Result<&'a [u8], &'static str> {
+		let end = self
+			.offset
+			.checked_add(length)
+			.ok_or("Scorex field length overflows")?;
+		if end > self.source.len() {
+			return Err("Scorex field exceeds its boundary");
+		}
+		let value = &self.source[self.offset..end];
+		self.offset = end;
+		Ok(value)
+	}
+
+	fn u8(&mut self) -> Result<u8, &'static str> {
+		Ok(self.take(1)?[0])
+	}
+
+	fn vlq(&mut self, bits: u8) -> Result<u64, &'static str> {
+		let start = self.offset;
+		let maximum_bytes = match bits {
+			16 => 3,
+			32 => 5,
+			64 => 10,
+			_ => return Err("unsupported Scorex VLQ width"),
+		};
+		let mut value = 0u64;
+		let mut shift = 0u32;
+		for index in 0..maximum_bytes {
+			let byte = self.u8()?;
+			let payload = (byte & 0x7f) as u64;
+			if shift == 63 && payload > 1 {
+				return Err("Scorex VLQ exceeds UInt64");
+			}
+			if shift >= 64 && payload != 0 {
+				return Err("Scorex VLQ exceeds UInt64");
+			}
+			if shift < 64 {
+				value |= payload.checked_shl(shift).ok_or("Scorex VLQ overflows")?;
+			}
+			if byte & 0x80 == 0 {
+				let maximum = match bits {
+					16 => u16::MAX as u64,
+					32 => u32::MAX as u64,
+					_ => u64::MAX,
+				};
+				if value > maximum {
+					return Err("Scorex VLQ exceeds its integer width");
+				}
+				let mut canonical = Vec::new();
+				push_unsigned_vlq(&mut canonical, value);
+				if canonical.as_slice() != &self.source[start..self.offset] {
+					return Err("Scorex VLQ is not minimally encoded");
+				}
+				return Ok(value);
+			}
+			if index == maximum_bytes - 1 {
+				break;
+			}
+			shift += 7;
+		}
+		Err("Scorex VLQ encoding is invalid")
+	}
+
+	fn coll_byte(&mut self, minimum: usize, maximum: usize) -> Result<&'a [u8], &'static str> {
+		if self.u8()? != 0x0e {
+			return Err("Scorex register is not a Sigma Coll[Byte]");
+		}
+		let length = self.vlq(16)? as usize;
+		if length < minimum || length > maximum {
+			return Err("Scorex Coll[Byte] length is outside its bound");
+		}
+		self.take(length)
+	}
+
+	fn positive_long(&mut self) -> Result<u64, &'static str> {
+		if self.u8()? != 0x05 {
+			return Err("Scorex register is not a Sigma Long");
+		}
+		let encoded = self.vlq(64)?;
+		if encoded & 1 != 0 {
+			return Err("Scorex Long is negative");
+		}
+		let value = encoded >> 1;
+		if value > ERGO_LONG_MAX_V1 {
+			return Err("Scorex Long exceeds the positive Ergo range");
+		}
+		Ok(value)
+	}
+
+	fn end(&self, error: &'static str) -> Result<(), &'static str> {
+		if self.offset != self.source.len() {
+			return Err(error);
+		}
+		Ok(())
+	}
+}

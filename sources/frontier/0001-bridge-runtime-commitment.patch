+use alloc::vec::Vec;
+
+use sp_core::{hashing::blake2_256, H160, H256};
+
+pub const ADMISSION_FORMAT_VERSION_V2: u8 = 2;
+pub const CONSUMED_FORMAT_VERSION_V3: u8 = 3;
+pub const ADMISSION_PROFILE_V2_BYTES: usize = 313;
+pub const SOURCE_INTENT_V2_BYTES: usize = 229;
+pub const ADMISSION_STATEMENT_V2_BYTES: usize = 381;
+pub const CONSUMED_ADMISSION_V3_BYTES: usize = 249;
+
+const ADMISSION_PROFILE_DOMAIN_V2: &[u8] = b"E2S_PEG_IN_CAUSAL_PROFILE_V2";
+const SOURCE_INTENT_DOMAIN_V2: &[u8] = b"E2S_PEG_IN_SOURCE_INTENT_V2";
+const ADMISSION_STATEMENT_DOMAIN_V2: &[u8] = b"E2S_PEG_IN_CAUSAL_ADMISSION_V2";
+const PEG_IN_RECORD_KEY_DOMAIN_V1: &[u8] = b"E2S_PEG_IN_RECORD_KEY_V1";
+
+#[derive(Clone, Eq, PartialEq)]
+pub struct AdmissionProfileV2 {
+	pub source_network_id: H256,
+	pub sidechain_id: H256,
+	pub bridge_address: H160,
+	pub token_address: H160,
+	pub settlement_profile_id: H256,
+	pub source_lock_ergo_tree_hash: H256,
+	pub vault_ergo_tree_hash: H256,
+	pub finality_policy_id: H256,
+	pub proof_system_id: H256,
+	pub proof_profile_id: H256,
+	pub profile_revision: u64,
+	pub activation_height: u64,
+}
+
+#[derive(Clone, Eq, PartialEq)]
+pub struct SourceIntentV2 {
+	pub source_network_id: H256,
+	pub sidechain_id: H256,
+	pub bridge_address: H160,
+	pub token_address: H160,
+	pub settlement_profile_id: H256,
+	pub admission_profile_id: H256,
+	pub source_asset_id: H256,
+	pub amount: u64,
+	pub recipient: H160,
+}
+
+#[derive(Clone, Eq, PartialEq)]
+pub struct AdmissionStatementV2 {
+	pub source_intent_id: H256,
+	pub legacy_mint_identity: H256,
+	pub source_box_id: H256,
+	pub source_creation_transaction_id: H256,
+	pub source_output_index: u32,
+	pub source_lock_ergo_tree_hash: H256,
+	pub commitment_transaction_id: H256,
+	pub vault_output_index: u32,
+	pub vault_box_id: H256,
+	pub vault_ergo_tree_hash: H256,
+	pub commitment_inclusion_block_id: H256,
+	pub commitment_inclusion_height: u64,
+	pub acceptance_checkpoint_block_id: H256,
+	pub acceptance_checkpoint_height: u64,
+	pub finality_policy_id: H256,
+	pub required_confirmations: u32,
+}
+
+#[derive(Clone, Eq, PartialEq)]
+pub struct ValidatedAdmissionV2 {
+	pub profile: AdmissionProfileV2,
+	pub profile_id: H256,
+	pub source_intent: SourceIntentV2,
+	pub source_intent_id: H256,
+	pub statement: AdmissionStatementV2,
+	pub admission_id: H256,
+}
+
+pub struct ConsumedAdmissionV3Fields {
+	pub admission_id: H256,
+	pub source_intent_id: H256,
+	pub legacy_mint_identity: H256,
+	pub native_parent_block_hash: H256,
+	pub native_mint_height: u64,
+	pub execution_block_hash: H256,
+	pub execution_height: u64,
+	pub transaction_hash: H256,
+	pub transaction_index: u32,
+	pub event_index: u32,
+	pub processed_record_blake2b256: H256,
+}
+
+pub fn validate_admission_v2(
+	profile_bytes: &[u8],
+	source_intent_bytes: &[u8],
+	statement_bytes: &[u8],
+) -> Result<ValidatedAdmissionV2, &'static str> {
+	let profile = decode_admission_profile_v2(profile_bytes)?;
+	let profile_id = domain_hash(ADMISSION_PROFILE_DOMAIN_V2, profile_bytes);
+	let source_intent = decode_source_intent_v2(source_intent_bytes)?;
+	if source_intent.source_network_id != profile.source_network_id
+		|| source_intent.sidechain_id != profile.sidechain_id
+		|| source_intent.bridge_address != profile.bridge_address
+		|| source_intent.token_address != profile.token_address
+		|| source_intent.settlement_profile_id != profile.settlement_profile_id
+		|| source_intent.admission_profile_id != profile_id
+	{
+		return Err("source intent does not match the exact causal admission profile");
+	}
+	let source_intent_id = domain_hash(SOURCE_INTENT_DOMAIN_V2, source_intent_bytes);
+	let statement = decode_admission_statement_v2(statement_bytes)?;
+	if statement.source_intent_id != source_intent_id
+		|| statement.source_lock_ergo_tree_hash != profile.source_lock_ergo_tree_hash
+		|| statement.vault_ergo_tree_hash != profile.vault_ergo_tree_hash
+		|| statement.finality_policy_id != profile.finality_policy_id
+	{
+		return Err("causal admission statement does not match its profile and source intent");
+	}
+	if statement.legacy_mint_identity
+		!= derive_legacy_mint_identity(source_intent.sidechain_id, statement.source_box_id)
+	{
+		return Err("causal admission statement does not preserve the V1 mint identity");
+	}
+	let admission_id = domain_hash(ADMISSION_STATEMENT_DOMAIN_V2, statement_bytes);
+	Ok(ValidatedAdmissionV2 {
+		profile,
+		profile_id,
+		source_intent,
+		source_intent_id,
+		statement,
+		admission_id,
+	})
+}
+
+pub fn decode_admission_profile_v2(bytes: &[u8]) -> Result<AdmissionProfileV2, &'static str> {
+	require_wire(
+		bytes,
+		ADMISSION_PROFILE_V2_BYTES,
+		ADMISSION_FORMAT_VERSION_V2,
+	)?;
+	let profile = AdmissionProfileV2 {
+		source_network_id: h256(bytes, 1),
+		sidechain_id: h256(bytes, 33),
+		bridge_address: h160(bytes, 65),
+		token_address: h160(bytes, 85),
+		settlement_profile_id: h256(bytes, 105),
+		source_lock_ergo_tree_hash: h256(bytes, 137),
+		vault_ergo_tree_hash: h256(bytes, 169),
+		finality_policy_id: h256(bytes, 201),
+		proof_system_id: h256(bytes, 233),
+		proof_profile_id: h256(bytes, 265),
+		profile_revision: u64_at(bytes, 297),
+		activation_height: u64_at(bytes, 305),
+	};
+	if profile.source_network_id == H256::zero()
+		|| profile.sidechain_id == H256::zero()
+		|| profile.bridge_address == H160::zero()
+		|| profile.token_address == H160::zero()
+		|| profile.bridge_address == profile.token_address
+		|| profile.settlement_profile_id == H256::zero()
+		|| profile.source_lock_ergo_tree_hash == H256::zero()
+		|| profile.vault_ergo_tree_hash == H256::zero()
+		|| profile.finality_policy_id == H256::zero()
+		|| profile.proof_system_id == H256::zero()
+		|| profile.proof_profile_id == H256::zero()
+		|| profile.profile_revision == 0
+	{
+		return Err("causal admission profile contains a zero or aliased identity");
+	}
+	Ok(profile)
+}
+
+pub fn decode_source_intent_v2(bytes: &[u8]) -> Result<SourceIntentV2, &'static str> {
+	require_wire(bytes, SOURCE_INTENT_V2_BYTES, ADMISSION_FORMAT_VERSION_V2)?;
+	let intent = SourceIntentV2 {
+		source_network_id: h256(bytes, 1),
+		sidechain_id: h256(bytes, 33),
+		bridge_address: h160(bytes, 65),
+		token_address: h160(bytes, 85),
+		settlement_profile_id: h256(bytes, 105),
+		admission_profile_id: h256(bytes, 137),
+		source_asset_id: h256(bytes, 169),
+		amount: u64_at(bytes, 201),
+		recipient: h160(bytes, 209),
+	};
+	if intent.source_network_id == H256::zero()
+		|| intent.sidechain_id == H256::zero()
+		|| intent.bridge_address == H160::zero()
+		|| intent.token_address == H160::zero()
+		|| intent.bridge_address == intent.token_address
+		|| intent.settlement_profile_id == H256::zero()
+		|| intent.admission_profile_id == H256::zero()
+		|| intent.source_asset_id != H256::zero()
+		|| intent.amount == 0
+		|| intent.amount > i64::MAX as u64
+		|| intent.recipient == H160::zero()
+	{
+		return Err("causal source intent contains an unsupported Ergo settlement field");
+	}
+	Ok(intent)
+}
+
+pub fn decode_admission_statement_v2(bytes: &[u8]) -> Result<AdmissionStatementV2, &'static str> {
+	require_wire(
+		bytes,
+		ADMISSION_STATEMENT_V2_BYTES,
+		ADMISSION_FORMAT_VERSION_V2,
+	)?;
+	let statement = AdmissionStatementV2 {
+		source_intent_id: h256(bytes, 1),
+		legacy_mint_identity: h256(bytes, 33),
+		source_box_id: h256(bytes, 65),
+		source_creation_transaction_id: h256(bytes, 97),
+		source_output_index: u32_at(bytes, 129),
+		source_lock_ergo_tree_hash: h256(bytes, 133),
+		commitment_transaction_id: h256(bytes, 165),
+		vault_output_index: u32_at(bytes, 197),
+		vault_box_id: h256(bytes, 201),
+		vault_ergo_tree_hash: h256(bytes, 233),
+		commitment_inclusion_block_id: h256(bytes, 265),
+		commitment_inclusion_height: u64_at(bytes, 297),
+		acceptance_checkpoint_block_id: h256(bytes, 305),
+		acceptance_checkpoint_height: u64_at(bytes, 337),
+		finality_policy_id: h256(bytes, 345),
+		required_confirmations: u32_at(bytes, 377),
+	};
+	if statement.source_intent_id == H256::zero()
+		|| statement.legacy_mint_identity == H256::zero()
+		|| statement.source_box_id == H256::zero()
+		|| statement.source_creation_transaction_id == H256::zero()
+		|| statement.source_lock_ergo_tree_hash == H256::zero()
+		|| statement.commitment_transaction_id == H256::zero()
+		|| statement.vault_box_id == H256::zero()
+		|| statement.vault_ergo_tree_hash == H256::zero()
+		|| statement.commitment_inclusion_block_id == H256::zero()
+		|| statement.acceptance_checkpoint_block_id == H256::zero()
+		|| statement.finality_policy_id == H256::zero()
+		|| statement.required_confirmations == 0
+	{
+		return Err("causal admission statement contains a zero identity or depth");
+	}
+	if statement.source_creation_transaction_id == statement.commitment_transaction_id
+		|| statement.source_box_id == statement.vault_box_id
+	{
+		return Err("causal admission statement aliases source and commitment identity");
+	}
+	let Some(observed_depth) = statement
+		.acceptance_checkpoint_height
+		.checked_sub(statement.commitment_inclusion_height)
+		.and_then(|delta| delta.checked_add(1))
+	else {
+		return Err("causal admission checkpoint precedes commitment inclusion");
+	};
+	if observed_depth < u64::from(statement.required_confirmations) {
+		return Err("causal admission checkpoint does not satisfy required confirmations");
+	}
+	Ok(statement)
+}
+
+pub fn encode_consumed_admission_v3(fields: &ConsumedAdmissionV3Fields) -> [u8; 249] {
+	let mut encoded = [0u8; CONSUMED_ADMISSION_V3_BYTES];
+	encoded[0] = CONSUMED_FORMAT_VERSION_V3;
+	copy_h256(&mut encoded, 1, fields.admission_id);
+	copy_h256(&mut encoded, 33, fields.source_intent_id);
+	copy_h256(&mut encoded, 65, fields.legacy_mint_identity);
+	copy_h256(&mut encoded, 97, fields.native_parent_block_hash);
+	encoded[129..137].copy_from_slice(&fields.native_mint_height.to_be_bytes());
+	copy_h256(&mut encoded, 137, fields.execution_block_hash);
+	encoded[169..177].copy_from_slice(&fields.execution_height.to_be_bytes());
+	copy_h256(&mut encoded, 177, fields.transaction_hash);
+	encoded[209..213].copy_from_slice(&fields.transaction_index.to_be_bytes());
+	encoded[213..217].copy_from_slice(&fields.event_index.to_be_bytes());
+	copy_h256(&mut encoded, 217, fields.processed_record_blake2b256);
+	encoded
+}
+
+pub fn validate_consumed_admission_v3(bytes: &[u8]) -> Result<(), &'static str> {
+	require_wire(
+		bytes,
+		CONSUMED_ADMISSION_V3_BYTES,
+		CONSUMED_FORMAT_VERSION_V3,
+	)?;
+	for offset in [1, 33, 65, 97, 137, 177, 217] {
+		if h256(bytes, offset) == H256::zero() {
+			return Err("consumed admission V3 contains a zero identity");
+		}
+	}
+	Ok(())
+}
+
+pub fn derive_profile_id_v2(bytes: &[u8]) -> Result<H256, &'static str> {
+	decode_admission_profile_v2(bytes)?;
+	Ok(domain_hash(ADMISSION_PROFILE_DOMAIN_V2, bytes))
+}
+
+pub fn derive_source_intent_id_v2(bytes: &[u8]) -> Result<H256, &'static str> {
+	decode_source_intent_v2(bytes)?;
+	Ok(domain_hash(SOURCE_INTENT_DOMAIN_V2, bytes))
+}
+
+pub fn derive_legacy_mint_identity(sidechain_id: H256, source_box_id: H256) -> H256 {
+	let mut preimage = Vec::with_capacity(PEG_IN_RECORD_KEY_DOMAIN_V1.len() + 64);
+	preimage.extend_from_slice(PEG_IN_RECORD_KEY_DOMAIN_V1);
+	preimage.extend_from_slice(sidechain_id.as_bytes());
+	preimage.extend_from_slice(source_box_id.as_bytes());
+	H256::from(blake2_256(&preimage))
+}
+
+fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+	let mut preimage = Vec::with_capacity(domain.len() + bytes.len());
+	preimage.extend_from_slice(domain);
+	preimage.extend_from_slice(bytes);
+	H256::from(blake2_256(&preimage))
+}
+
+fn require_wire(bytes: &[u8], length: usize, version: u8) -> Result<(), &'static str> {
+	if bytes.len() != length {
+		return Err("causal peg-in wire length is not canonical");
+	}
+	if bytes[0] != version {
+		return Err("causal peg-in wire version is unsupported");
+	}
+	Ok(())
+}
+
+fn h160(bytes: &[u8], offset: usize) -> H160 {
+	H160::from_slice(&bytes[offset..offset + 20])
+}
+
+fn h256(bytes: &[u8], offset: usize) -> H256 {
+	H256::from_slice(&bytes[offset..offset + 32])
+}
+
+fn u32_at(bytes: &[u8], offset: usize) -> u32 {
+	u32::from_be_bytes(
+		bytes[offset..offset + 4]
+			.try_into()
+			.expect("fixed checked wire"),
+	)
+}
+
+fn u64_at(bytes: &[u8], offset: usize) -> u64 {
+	u64::from_be_bytes(
+		bytes[offset..offset + 8]
+			.try_into()
+			.expect("fixed checked wire"),
+	)
+}
+
+fn copy_h256(target: &mut [u8], offset: usize, value: H256) {
+	target[offset..offset + 32].copy_from_slice(value.as_bytes());
+}

+		.collect::<Result<Vec<_>, NativeCheckpointRequestError>>()?;
+
+	ensure_collection(
+		"checkpointTailHeadersScaleHex",
+		request.checkpoint_tail_headers_scale_hex.len(),
+		0,
+		MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS,
+	)?;
+	let checkpoint_tail_headers = request
+		.checkpoint_tail_headers_scale_hex
+		.iter()
+		.map(|encoded| {
+			let bytes = parse_byte_hex(
+				"checkpointTailHeadersScaleHex",
+				encoded,
+				MAX_NATIVE_HEADER_BYTES,
+			)?;

+//! Rebuild the deterministic cross-language verifier request fixture.
+
+use std::{env, fs, process::ExitCode};
+
+use bridge_checkpoint_verifier::fixture::deterministic_fixture_vector;
+
+fn main() -> ExitCode {
+	match run() {
+		Ok(()) => ExitCode::SUCCESS,
+		Err(error) => {
+			eprintln!("fixture generation failed: {error}");
+			ExitCode::from(2)
+		}
+	}
+}
+
+fn run() -> Result<(), Box<dyn std::error::Error>> {
+	let mut arguments = env::args_os();
+	let _program = arguments.next();
+	let output = arguments
+		.next()
+		.ok_or("expected exactly one output file argument")?;
+	if arguments.next().is_some() {
+		return Err("expected exactly one output file argument".into());
+	}
+	let mut encoded = serde_json::to_vec_pretty(&deterministic_fixture_vector())?;
+	encoded.push(b'\n');
+	fs::write(output, encoded)?;
+	Ok(())
+}

+//! Strict native codec for read-only Substrate checkpoint RPC material.
+//!
+//! These helpers only normalize acquisition data. Their outputs remain untrusted until consumed
+//! by the full checkpoint verifier.
+
+use bridge_finality_proof::{
+	select_grandpa_authority_transition_prefix, BridgeAuthorityTransitionError,
+	MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS, MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+	MAX_FINALITY_PROOF_BYTES,
+};
+use sc_consensus_grandpa::{FinalityProof, GrandpaJustification};
+use scale_codec::{DecodeAll, Encode};
+use serde::{de::DeserializeOwned, Deserialize, Serialize};
+use sp_core::H256;
+use sp_runtime::traits::Header as _;
+use thiserror::Error;
+
+use crate::{NativeBlock, NativeHeader, MAX_NATIVE_HEADER_BYTES, MAX_REQUEST_BYTES};
+
+/// Schema for a batch of JSON-RPC headers that must be encoded canonically.
+pub const HEADER_ENCODING_REQUEST_SCHEMA: &str = "e2s.substrate-rpc-header-encoding-request.v1";
+/// Schema emitted after canonical header encoding.
+pub const HEADER_ENCODING_RESULT_SCHEMA: &str = "e2s.substrate-rpc-header-encoding-result.v1";
+/// Schema for structural inspection of one canonical warp proof.
+pub const WARP_INSPECTION_REQUEST_SCHEMA: &str = "e2s.substrate-rpc-warp-inspection-request.v2";
+/// Schema emitted after bounded structural warp-proof inspection.
+pub const WARP_INSPECTION_RESULT_SCHEMA: &str = "e2s.substrate-rpc-warp-inspection-result.v2";
+/// Schema for structural inspection of one canonical finality proof.
+pub const FINALITY_INSPECTION_REQUEST_SCHEMA: &str =
+	"e2s.substrate-rpc-finality-inspection-request.v1";
+/// Schema emitted after bounded structural finality-proof inspection.
+pub const FINALITY_INSPECTION_RESULT_SCHEMA: &str =
+	"e2s.substrate-rpc-finality-inspection-result.v1";
+
+/// One exact header returned by `chain_getHeader`, bound to its requested hash.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RpcHeaderObservation {
+	/// Exact hash used to request this header.
+	pub expected_hash_hex: String,
+	/// Strict JSON representation of `Header<u32, BlakeTwo256>`.
+	pub header: NativeHeader,
+}
+
+/// Strict header-encoding request.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RpcHeaderEncodingRequest {
+	/// Exact request schema.
+	pub schema: String,
+	/// Non-empty bounded batch of observed headers.
+	pub headers: Vec<RpcHeaderObservation>,
+}
+
+/// One canonical encoded header and its acquisition metadata.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct EncodedRpcHeader {
+	/// Recomputed native header hash.
+	pub hash_hex: String,
+	/// Header number as an exact decimal string.
+	pub number: String,
+	/// Recomputed parent hash.
+	pub parent_hash_hex: String,
+	/// Header state root.
+	pub state_root_hex: String,
+	/// Canonical SCALE header bytes.
+	pub header_scale_hex: String,
+}
+
+/// Successful canonical header-encoding result.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RpcHeaderEncodingResult {
+	/// Exact result schema.
+	pub schema: String,
+	/// Canonically encoded headers in request order.
+	pub headers: Vec<EncodedRpcHeader>,
+}
+
+/// Strict warp-proof inspection request.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RpcWarpInspectionRequest {
+	/// Exact request schema.
+	pub schema: String,
+	/// Canonical SCALE warp-proof bytes.
+	pub proof_scale_hex: String,
+	/// Exact target-finality horizon used only to select acquisition material before it.
+	pub finality_horizon_number: String,
+}
+
+/// Bounded structural warp-proof metadata.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RpcWarpInspectionResult {
+	/// Exact result schema.
+	pub schema: String,
+	/// Last source header hash before acquisition-only selection.
+	pub source_target_hash_hex: String,
+	/// Last source header number before acquisition-only selection.
+	pub source_target_number: String,
+	/// Last source parent hash before acquisition-only selection.
+	pub source_target_parent_hash_hex: String,
+	/// Canonical SCALE bytes of the last source header.
+	pub source_target_header_scale_hex: String,
+	/// Upstream completion flag encoded in the proof.
+	pub source_complete: bool,
+	/// Number of embedded source fragments.
+	pub source_fragment_count: usize,
+	/// Whether selection stopped before a source fragment at or beyond the horizon.
+	pub stopped_before_horizon: bool,
+	/// Number of selected fragments strictly before the finality horizon.
+	pub selected_fragment_count: usize,
+	/// Canonical partial proof selected for native verification, absent when no handoff is needed.
+	pub selected_proof_scale_hex: Option<String>,
+	/// Last selected transition hash, absent when the anchor set reaches the horizon unchanged.
+	pub selected_target_hash_hex: Option<String>,
+	/// Last selected transition number.
+	pub selected_target_number: Option<String>,
+	/// Parent hash of the last selected transition.
+	pub selected_target_parent_hash_hex: Option<String>,
+	/// Canonical SCALE header bytes of the last selected transition.
+	pub selected_target_header_scale_hex: Option<String>,
+	/// Explicitly states that this inspection is not cryptographic verification.
+	pub cryptographically_verified: bool,
+}
+
+/// Strict target-finality inspection request.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RpcFinalityInspectionRequest {
+	/// Exact request schema.
+	pub schema: String,
+	/// Canonical SCALE `grandpa_proveFinality` envelope.
+	pub proof_scale_hex: String,
+}
+
+/// Bounded structural target-finality metadata.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct RpcFinalityInspectionResult {
+	/// Exact result schema.
+	pub schema: String,
+	/// Signed finality horizon hash declared by the envelope and embedded justification.
+	pub horizon_hash_hex: String,
+	/// Signed finality horizon height as an exact decimal string.
+	pub horizon_number: String,
+	/// Canonical embedded justification bytes, excluding the outer envelope.
+	pub canonical_justification_scale_hex: String,
+	/// Number of unknown headers carried by the outer envelope.
+	pub unknown_header_count: usize,
+	/// Explicitly states that this inspection is not cryptographic verification.
+	pub cryptographically_verified: bool,
+}
+
+/// A strict native RPC-codec failure.
+#[derive(Debug, Error)]
+pub enum RpcProofCodecError {
+	/// Input exceeded the common process request bound.
+	#[error("RPC codec request exceeds {max} bytes: {actual}")]
+	RequestTooLarge {
+		/// Received bytes.
+		actual: usize,
+		/// Configured maximum.
+		max: usize,
+	},
+	/// Input was not the exact requested JSON shape.
+	#[error("failed to decode strict RPC codec request JSON: {0}")]
+	Json(#[from] serde_json::Error),
+	/// The operation-specific schema was not the pinned V1 schema.
+	#[error("unsupported RPC codec request schema")]
+	Schema,
+	/// A header batch was empty or exceeded the bridge ancestry bound.
+	#[error("invalid RPC header batch size: {actual}")]
+	HeaderBatch {
+		/// Received header count.
+		actual: usize,
+	},
+	/// One expected header hash was malformed.
+	#[error("invalid expected RPC header hash at index {index}")]
+	HeaderHash {
+		/// Zero-based header index.
+		index: usize,
+	},
+	/// One observed header did not hash to the requested block hash.
+	#[error("RPC header hash mismatch at index {index}")]
+	HeaderHashMismatch {
+		/// Zero-based header index.
+		index: usize,
+	},
+	/// One observed header exceeded the bridge header size bound.
+	#[error("RPC header at index {index} exceeds {max} bytes: {actual}")]
+	HeaderTooLarge {
+		/// Zero-based header index.
+		index: usize,
+		/// Received bytes.
+		actual: usize,
+		/// Configured maximum.
+		max: usize,
+	},
+	/// One proof hex string was malformed or exceeded its operation bound.
+	#[error("invalid {field} bytes")]
+	ProofHex {
+		/// Stable operation field.
+		field: &'static str,
+	},
+	/// The requested finality horizon was not a canonical uint32 decimal string.
+	#[error("invalid finality horizon number")]
+	FinalityHorizonNumber,
+	/// Structural warp-proof inspection failed.
+	#[error(transparent)]
+	Warp(#[from] BridgeAuthorityTransitionError),
+	/// The finality envelope or embedded justification was not canonical SCALE.
+	#[error("failed to decode canonical GRANDPA finality proof")]
+	FinalityDecode,
+	/// The outer finality envelope and embedded justification disagree on the horizon.
+	#[error("GRANDPA finality envelope and embedded justification target mismatch")]
+	FinalityTargetMismatch,
+}
+
+/// Encode exact JSON-RPC headers into canonical SCALE and recheck their requested hashes.
+pub fn encode_rpc_headers_request_bytes(
+	raw_request: &[u8],
+) -> Result<RpcHeaderEncodingResult, RpcProofCodecError> {
+	let request: RpcHeaderEncodingRequest = decode_json_request(raw_request)?;
+	if request.schema != HEADER_ENCODING_REQUEST_SCHEMA {
+		return Err(RpcProofCodecError::Schema);
+	}
+	if request.headers.is_empty()
+		|| request.headers.len() > MAX_AUTHORITY_TRANSITION_ANCESTRY_HEADERS
+	{
+		return Err(RpcProofCodecError::HeaderBatch {
+			actual: request.headers.len(),
+		});
+	}
+
+	let headers = request
+		.headers
+		.into_iter()
+		.enumerate()
+		.map(|(index, observation)| {
+			let expected = parse_hash(&observation.expected_hash_hex)
+				.ok_or(RpcProofCodecError::HeaderHash { index })?;
+			let actual = observation.header.hash();
+			if actual != expected {
+				return Err(RpcProofCodecError::HeaderHashMismatch { index });
+			}
+			let encoded = observation.header.encode();
+			if encoded.len() > MAX_NATIVE_HEADER_BYTES {
+				return Err(RpcProofCodecError::HeaderTooLarge {
+					index,
+					actual: encoded.len(),
+					max: MAX_NATIVE_HEADER_BYTES,
+				});
+			}
+			Ok(EncodedRpcHeader {
+				hash_hex: format_hash(actual),
+				number: observation.header.number().to_string(),
+				parent_hash_hex: format_hash(*observation.header.parent_hash()),
+				state_root_hex: format_hash(*observation.header.state_root()),
+				header_scale_hex: format_bytes(&encoded),
+			})
+		})
+		.collect::<Result<Vec<_>, RpcProofCodecError>>()?;
+
+	Ok(RpcHeaderEncodingResult {
+		schema: HEADER_ENCODING_RESULT_SCHEMA.to_owned(),
+		headers,
+	})
+}
+
+/// Recover bounded acquisition metadata from one canonical warp proof.
+pub fn inspect_rpc_warp_proof_request_bytes(
+	raw_request: &[u8],
+) -> Result<RpcWarpInspectionResult, RpcProofCodecError> {
+	let request: RpcWarpInspectionRequest = decode_json_request(raw_request)?;
+	if request.schema != WARP_INSPECTION_REQUEST_SCHEMA {
+		return Err(RpcProofCodecError::Schema);
+	}
+	let proof = parse_proof_hex(
+		"warp proof",
+		&request.proof_scale_hex,
+		MAX_AUTHORITY_TRANSITION_PROOF_BYTES,
+	)?;
+	let finality_horizon_number = parse_decimal_u32(&request.finality_horizon_number)
+		.ok_or(RpcProofCodecError::FinalityHorizonNumber)?;
+	let selected =
+		select_grandpa_authority_transition_prefix::<NativeBlock>(&proof, finality_horizon_number)?;
+	let source_target = selected.source_target_header;
+	let selected_target_hash_hex = selected
+		.selected_target_header
+		.as_ref()
+		.map(|header| format_hash(header.hash()));
+	let selected_target_number = selected
+		.selected_target_header
+		.as_ref()
+		.map(|header| header.number().to_string());
+	let selected_target_parent_hash_hex = selected
+		.selected_target_header
+		.as_ref()
+		.map(|header| format_hash(*header.parent_hash()));
+	let selected_target_header_scale_hex = selected
+		.selected_target_header
+		.as_ref()
+		.map(|header| format_bytes(&header.encode()));
+
+	Ok(RpcWarpInspectionResult {
+		schema: WARP_INSPECTION_RESULT_SCHEMA.to_owned(),
+		source_target_hash_hex: format_hash(source_target.hash()),
+		source_target_number: source_target.number().to_string(),
+		source_target_parent_hash_hex: format_hash(*source_target.parent_hash()),
+		source_target_header_scale_hex: format_bytes(&source_target.encode()),
+		source_complete: selected.source_complete,
+		source_fragment_count: selected.source_fragment_count,
+		stopped_before_horizon: selected.stopped_before_horizon,
+		selected_fragment_count: selected.selected_fragment_count,
+		selected_proof_scale_hex: selected.selected_encoded_proof.as_deref().map(format_bytes),
+		selected_target_hash_hex,
+		selected_target_number,
+		selected_target_parent_hash_hex,
+		selected_target_header_scale_hex,
+		cryptographically_verified: false,
+	})
+}
+
+/// Recover bounded acquisition metadata from one canonical `grandpa_proveFinality` envelope.
+pub fn inspect_rpc_finality_proof_request_bytes(
+	raw_request: &[u8],
+) -> Result<RpcFinalityInspectionResult, RpcProofCodecError> {
+	let request: RpcFinalityInspectionRequest = decode_json_request(raw_request)?;
+	if request.schema != FINALITY_INSPECTION_REQUEST_SCHEMA {
+		return Err(RpcProofCodecError::Schema);
+	}
+	let encoded = parse_proof_hex(
+		"finality proof",
+		&request.proof_scale_hex,
+		MAX_FINALITY_PROOF_BYTES,
+	)?;
+	let proof = FinalityProof::<NativeHeader>::decode_all(&mut &encoded[..])
+		.map_err(|_| RpcProofCodecError::FinalityDecode)?;
+	let justification =
+		GrandpaJustification::<NativeBlock>::decode_all(&mut &proof.justification[..])
+			.map_err(|_| RpcProofCodecError::FinalityDecode)?;
+	let (horizon_number, horizon_hash) = justification.target();
+	if proof.block != horizon_hash {
+		return Err(RpcProofCodecError::FinalityTargetMismatch);
+	}
+
+	Ok(RpcFinalityInspectionResult {
+		schema: FINALITY_INSPECTION_RESULT_SCHEMA.to_owned(),
+		horizon_hash_hex: format_hash(horizon_hash),
+		horizon_number: horizon_number.to_string(),
+		canonical_justification_scale_hex: format_bytes(&justification.encode()),
+		unknown_header_count: proof.unknown_headers.len(),
+		cryptographically_verified: false,
+	})
+}
+
+fn decode_json_request<T: DeserializeOwned>(raw_request: &[u8]) -> Result<T, RpcProofCodecError> {
+	if raw_request.len() > MAX_REQUEST_BYTES {
+		return Err(RpcProofCodecError::RequestTooLarge {
+			actual: raw_request.len(),
+			max: MAX_REQUEST_BYTES,
+		});
+	}
+	Ok(serde_json::from_slice(raw_request)?)
+}
+
+fn parse_hash(value: &str) -> Option<H256> {
+	if value.len() != 66 || !value.starts_with("0x") {
+		return None;
+	}
+	let clean = value.strip_prefix("0x")?;
+	if !clean
+		.bytes()
+		.all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+	{
+		return None;
+	}
+	let bytes = hex::decode(clean).ok()?;
+	Some(H256::from_slice(&bytes))
+}
+
+fn parse_decimal_u32(value: &str) -> Option<u32> {
+	if value.is_empty()
+		|| (value.len() > 1 && value.starts_with('0'))
+		|| !value.bytes().all(|byte| byte.is_ascii_digit())
+	{
+		return None;
+	}
+	value.parse().ok()
+}
+
+fn parse_proof_hex(
+	field: &'static str,
+	value: &str,
+	max_bytes: usize,
+) -> Result<Vec<u8>, RpcProofCodecError> {
+	let clean = value
+		.strip_prefix("0x")
+		.ok_or(RpcProofCodecError::ProofHex { field })?;
+	if clean.is_empty()
+		|| clean.len() % 2 != 0
+		|| clean.len() / 2 > max_bytes
+		|| !clean
+			.bytes()
+			.all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+	{
+		return Err(RpcProofCodecError::ProofHex { field });
+	}
+	hex::decode(clean).map_err(|_| RpcProofCodecError::ProofHex { field })
+}
+
+fn format_hash(value: H256) -> String {
+	format_bytes(value.as_bytes())
+}
+
+fn format_bytes(value: &[u8]) -> String {
+	format!("0x{}", hex::encode(value))
+}
+
+#[cfg(test)]
+mod tests {
+	use base64::{engine::general_purpose::STANDARD, Engine as _};
+	use scale_codec::DecodeAll;
+	use serde_json::json;
+	use sp_runtime::traits::Header as _;
+
+	use super::*;
+	use crate::fixture::{deterministic_fixture_request, deterministic_fixture_vector};
+
+	fn source_warp_proof_hex() -> String {
+		let fixture = deterministic_fixture_vector();
+		let encoded = fixture
+			.rpc_fixture
+			.responses
+			.iter()
+			.find(|response| response.method == "bridge_grandpaWarpProof")
+			.and_then(|response| response.result.get("proof"))
+			.and_then(|value| value.as_str())
+			.expect("fixture must contain one source warp proof");
+		format!(
+			"0x{}",
+			hex::encode(
+				STANDARD
+					.decode(encoded)
+					.expect("fixture base64 must decode")
+			)
+		)
+	}
+
+	#[test]
+	fn normalizes_fixture_headers_and_inspects_both_proof_envelopes() {
+		let fixture = deterministic_fixture_request();
+		let target_bytes =
+			hex::decode(fixture.target_header_scale_hex.strip_prefix("0x").unwrap()).unwrap();
+		let target = NativeHeader::decode_all(&mut &target_bytes[..]).unwrap();
+		let header_request = RpcHeaderEncodingRequest {
+			schema: HEADER_ENCODING_REQUEST_SCHEMA.to_owned(),
+			headers: vec![RpcHeaderObservation {
+				expected_hash_hex: fixture.target_native_block_hash_hex.clone(),
+				header: target.clone(),
+			}],
+		};
+		let headers =
+			encode_rpc_headers_request_bytes(&serde_json::to_vec(&header_request).unwrap())
+				.unwrap();
+		assert_eq!(
+			headers.headers[0].hash_hex,
+			fixture.target_native_block_hash_hex
+		);
+		assert_eq!(headers.headers[0].number, target.number().to_string());
+		assert_eq!(
+			headers.headers[0].header_scale_hex,
+			fixture.target_header_scale_hex
+		);
+
+		let warp_request = RpcWarpInspectionRequest {
+			schema: WARP_INSPECTION_REQUEST_SCHEMA.to_owned(),
+			proof_scale_hex: source_warp_proof_hex(),
+			finality_horizon_number: "1026".to_owned(),
+		};
+		let warp =
+			inspect_rpc_warp_proof_request_bytes(&serde_json::to_vec(&warp_request).unwrap())
+				.unwrap();
+		assert!(warp.source_complete);
+		assert_eq!(warp.source_fragment_count, 2);
+		assert_eq!(warp.source_target_number, "1026");
+		assert!(warp.stopped_before_horizon);
+		assert_eq!(warp.selected_fragment_count, 1);
+		assert_eq!(warp.selected_target_number.as_deref(), Some("1025"));
+		assert_eq!(
+			warp.selected_proof_scale_hex.as_deref(),
+			Some(fixture.linked_grandpa_proofs[0].proof_scale_hex.as_str())
+		);
+		assert!(!warp.cryptographically_verified);
+
+		let finality_request = RpcFinalityInspectionRequest {
+			schema: FINALITY_INSPECTION_REQUEST_SCHEMA.to_owned(),
+			proof_scale_hex: fixture.finality_proof_scale_hex,
+		};
+		let finality = inspect_rpc_finality_proof_request_bytes(
+			&serde_json::to_vec(&finality_request).unwrap(),

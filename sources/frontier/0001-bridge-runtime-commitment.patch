+	fn domain_hash(domain: &[u8], bytes: &[u8]) -> H256 {
+		let mut preimage = Vec::with_capacity(domain.len() + bytes.len());
+		preimage.extend_from_slice(domain);
+		preimage.extend_from_slice(bytes);
+		H256::from(blake2_256(&preimage))
+	}
+
+	fn source_proof_pairs() -> Vec<sp_core::ed25519::Pair> {
+		let mut pairs = vec![
+			sp_core::ed25519::Pair::from_seed(&[0x41; 32]),
+			sp_core::ed25519::Pair::from_seed(&[0x42; 32]),
+			sp_core::ed25519::Pair::from_seed(&[0x43; 32]),
+		];
+		pairs.sort_by_key(|pair| pair.public().0);
+		pairs
+	}
+
+	fn source_proof_envelope(
+		validated: &ValidatedAdmissionV2,
+		source_intent_bytes: &[u8],
+		statement_bytes: &[u8],
+		issued_at_native_height: u64,
+	) -> FederatedSourceProofEnvelopeV1 {
+		let profile = StaticErgoFederatedSourceProofProfileV1::profile();
+		let pairs = source_proof_pairs();
+		assert_eq!(
+			profile.signer_public_keys.to_vec(),
+			pairs.iter().map(|pair| pair.public().0).collect::<Vec<_>>()
+		);
+		let result = FederatedSourceProofResultV1 {
+			format_version: 1,
+			request_digest: derive_federated_source_proof_request_digest_v1(
+				validated,
+				source_intent_bytes,
+				statement_bytes,
+			),
+			source_box_canonical_blake2b256: H256::repeat_byte(0x81),
+			commitment_transaction_canonical_blake2b256: H256::repeat_byte(0x82),
+			vault_successor_canonical_blake2b256: H256::repeat_byte(0x83),
+			inclusion_proof_blake2b256: H256::repeat_byte(0x84),
+			checkpoint_ancestry_blake2b256: H256::repeat_byte(0x85),
+			finality_proof_blake2b256: H256::repeat_byte(0x86),
+			verifier_executable_sha256: H256::repeat_byte(0x87),
+			verifier_profile_id: profile.verifier_profile_id,
+			issued_at_native_height,
+			expires_at_native_height: issued_at_native_height + 16,
+		};
+		let result_id = derive_federated_source_proof_result_id_v1(&result).unwrap();
+		let attestation_digest = derive_federated_source_proof_attestation_digest_v1(result_id);
+		let signatures: FederatedSourceProofSignaturesV1 = pairs
+			.iter()
+			.take(usize::from(profile.threshold))
+			.map(|pair| FederatedSourceProofSignatureV1 {
+				signer_public_key: pair.public().0,
+				signature: pair.sign(attestation_digest.as_bytes()).0,
+			})
+			.collect::<Vec<_>>()
+			.try_into()
+			.unwrap();
+		FederatedSourceProofEnvelopeV1 { result, signatures }
+	}

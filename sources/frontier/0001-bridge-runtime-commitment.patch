+//! Strict, non-signing derivation of causal source-proof result fields.
+//!
+//! This module validates the exact V2 causal admission bindings and hashes bounded caller-supplied
+//! source objects. It does not inspect those objects semantically, verify source canonicality,
+//! produce signatures, mutate runtime state, or authorize funds.
+
+use serde::{Deserialize, Serialize};
+use sp_core::{hashing::blake2_256, H160, H256};
+use thiserror::Error;
+
+use crate::{format_hash, parse_byte_hex, parse_decimal_u64, NativeCheckpointRequestError};
+
+/// Stable producer request schema.
+pub const REQUEST_SCHEMA: &str = "e2s.peg-in-causal-source-proof-result-producer-request.v1";
+/// Stable producer result schema.
+pub const RESULT_SCHEMA: &str = "e2s.peg-in-causal-source-proof-result-producer-result.v1";
+/// Stable non-authorizing result status.
+pub const RESULT_STATUS: &str = "SOURCE_PROOF_RESULT_FIELDS_DERIVED_WITHOUT_SOURCE_CANONICALITY";
+/// Maximum exact UTF-8 request bytes accepted on standard input.
+pub const MAX_REQUEST_BYTES: usize = 1024 * 1024;
+/// Maximum bytes accepted for source boxes and vault successors.
+pub const MAX_CANONICAL_SOURCE_OBJECT_BYTES: usize = 4 * 1024;
+/// Maximum bytes accepted for transactions and source-proof material.
+pub const MAX_CANONICAL_SOURCE_PROOF_BYTES: usize = 64 * 1024;
+
+const ADMISSION_PROFILE_BYTES: usize = 313;
+const SOURCE_INTENT_BYTES: usize = 229;
+const ADMISSION_STATEMENT_BYTES: usize = 381;
+const ADMISSION_FORMAT_VERSION: u8 = 2;
+const SOURCE_PROOF_RESULT_FORMAT_VERSION: u8 = 1;
+const REQUIRED_CONFIRMATIONS: u32 = 10;
+const MAX_VALIDITY_BLOCKS: u64 = 64;
+
+const ADMISSION_PROFILE_DOMAIN: &[u8] = b"E2S_PEG_IN_CAUSAL_PROFILE_V2";
+const SOURCE_INTENT_DOMAIN: &[u8] = b"E2S_PEG_IN_SOURCE_INTENT_V2";
+const ADMISSION_DOMAIN: &[u8] = b"E2S_PEG_IN_CAUSAL_ADMISSION_V2";
+const LEGACY_MINT_IDENTITY_DOMAIN: &[u8] = b"E2S_PEG_IN_RECORD_KEY_V1";
+const SOURCE_PROOF_REQUEST_DOMAIN: &[u8] = b"E2S_PEG_IN_ERGO_SOURCE_PROOF_REQUEST_V1";
+
+const FINALITY_POLICY_ID_HEX: &str =
+	"25b6e4d9beac8863882fc8f8c43ced66f2d087b3fba128112014b3fb8fd22ff6";
+const PROOF_SYSTEM_ID_HEX: &str =
+	"36c06f93b9cf9a7f80c59f5bfb8b7790c7f355933cd001fffccc9110f9f95069";
+const PROOF_PROFILE_ID_HEX: &str =
+	"65ca4632abc4db51255e42e83a9aee8a72b19d41921d45824ce847cd696e9537";
+const VERIFIER_PROFILE_ID_HEX: &str =
+	"e1c2db0d496efae61a16d7791456ae44c3927b3b8d0d9f029d8a9fe100e215ea";
+
+/// Exact bounded input accepted by the non-signing result producer.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PegInCausalSourceProofResultProducerRequestV1 {
+	/// Exact request schema.
+	pub schema: String,
+	/// Candidate identity, which must equal the derived admission identity.
+	pub candidate_id_hex: String,
+	/// Canonical 313-byte V2 causal admission profile.
+	pub admission_profile_canonical_hex: String,
+	/// Canonical 229-byte V2 source intent.
+	pub source_intent_canonical_hex: String,
+	/// Canonical 381-byte V2 causal admission statement.
+	pub statement_canonical_hex: String,
+	/// Opaque bounded source box bytes.
+	pub source_box_canonical_hex: String,
+	/// Opaque bounded commitment transaction bytes.
+	pub commitment_transaction_canonical_hex: String,
+	/// Opaque bounded vault successor bytes.
+	pub vault_successor_canonical_hex: String,
+	/// Opaque bounded inclusion proof bytes.
+	pub inclusion_proof_canonical_hex: String,
+	/// Opaque bounded checkpoint ancestry bytes.
+	pub checkpoint_ancestry_canonical_hex: String,
+	/// Opaque bounded finality proof bytes.
+	pub finality_proof_canonical_hex: String,
+	/// Exact SHA-256 identity of the intended verifier executable.
+	pub verifier_executable_sha256_hex: String,
+	/// Native issue height as a canonical uint64 decimal string.
+	pub issued_at_native_height: String,
+	/// Native expiry height as a canonical uint64 decimal string.
+	pub expires_at_native_height: String,
+}
+
+/// Result fields byte-compatible with the current TypeScript V1 shape.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PegInCausalSourceProofResultFieldsV1 {
+	/// Exact result format version.
+	pub format_version: u8,
+	/// Domain-separated digest over profile identity, intent bytes, and statement bytes.
+	pub request_digest_hex: String,
+	/// Blake2b-256 of the opaque source box bytes.
+	pub source_box_canonical_blake2b256_hex: String,
+	/// Blake2b-256 of the opaque commitment transaction bytes.
+	pub commitment_transaction_canonical_blake2b256_hex: String,
+	/// Blake2b-256 of the opaque vault successor bytes.
+	pub vault_successor_canonical_blake2b256_hex: String,
+	/// Blake2b-256 of the opaque inclusion proof bytes.
+	pub inclusion_proof_blake2b256_hex: String,
+	/// Blake2b-256 of the opaque checkpoint ancestry bytes.
+	pub checkpoint_ancestry_blake2b256_hex: String,
+	/// Blake2b-256 of the opaque finality proof bytes.
+	pub finality_proof_blake2b256_hex: String,
+	/// Caller-bound verifier executable identity.
+	pub verifier_executable_sha256_hex: String,
+	/// Static federated compatibility verifier profile identity.
+	pub verifier_profile_id_hex: String,
+	/// Exact native issue height.
+	pub issued_at_native_height: String,
+	/// Exact native expiry height.
+	pub expires_at_native_height: String,
+}
+
+/// Explicit non-authorizing boundary for a successful derivation.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PegInCausalSourceProofResultBoundaryV1 {
+	/// Exact V2 profile, intent, statement, and candidate relationships were validated.
+	pub admission_bindings_validated: bool,
+	/// Each opaque source object was bounded and hashed.
+	pub canonical_objects_hashed: bool,
+	/// Object naming does not establish source canonicality.
+	pub source_canonicality_verified: bool,
+	/// This pure producer does not authenticate its execution environment.
+	pub source_proof_execution_authenticated: bool,
+	/// No source-proof signatures were produced.
+	pub signatures_produced: bool,
+	/// This producer has no signing capability.
+	pub signing_authorized: bool,
+	/// No runtime admission was written.
+	pub runtime_admission_written: bool,
+	/// No local or runtime lifecycle was advanced.
+	pub lifecycle_advanced: bool,
+	/// The result cannot authorize minting.
+	pub mint_authorized: bool,
+	/// The result cannot release a reconciliation hold.
+	pub reconciliation_hold_release_authorized: bool,
+	/// The result cannot authorize submission.
+	pub submission_authorized: bool,
+	/// The result cannot authorize broadcast.
+	pub broadcast_authorized: bool,
+	/// Result-field derivation alone does not close Gate 5.
+	pub gate5_closed: bool,
+	/// Result-field derivation does not establish production readiness.
+	pub production_ready: bool,
+}
+
+/// Successful non-signing result derivation.
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct PegInCausalSourceProofResultProducerOutputV1 {
+	/// Exact result schema.
+	pub schema: String,
+	/// Stable non-authorizing status.
+	pub status: String,
+	/// Exact source-proof request digest independently derived from canonical V2 bytes.
+	pub request_digest_hex: String,
+	/// Exact current source-proof result fields.
+	pub result: PegInCausalSourceProofResultFieldsV1,
+	/// Non-negotiable claim boundary.
+	pub boundary: PegInCausalSourceProofResultBoundaryV1,
+}
+
+/// Strict request or admission-binding failure.
+#[derive(Debug, Error)]
+pub enum PegInCausalSourceProofResultProducerErrorV1 {
+	/// Shared canonical decimal or lowercase-hex parsing failed.
+	#[error(transparent)]
+	Request(#[from] NativeCheckpointRequestError),
+	/// JSON was malformed or contained an unknown field.
+	#[error(transparent)]
+	Json(#[from] serde_json::Error),
+	/// Request exceeded the fixed standard-input bound.
+	#[error("source-proof result producer request exceeds {MAX_REQUEST_BYTES} bytes")]
+	RequestTooLarge,
+	/// Request schema is not the exact supported version.
+	#[error("unsupported source-proof result producer request schema")]
+	Schema,
+	/// A canonical wire field did not have its exact fixed length.
+	#[error("{field} must be exactly {expected} bytes")]
+	FixedLength {
+		/// Rejected field name.
+		field: &'static str,
+		/// Required byte length.
+		expected: usize,
+	},
+	/// A required identity was zero.
+	#[error("{0} must not be zero")]
+	Zero(&'static str),
+	/// Exact V2 admission relationships were not satisfied.
+	#[error("invalid causal admission binding: {0}")]
+	Admission(&'static str),
+	/// The V1 federated compatibility profile was not selected exactly.
+	#[error("invalid federated source-proof profile: {0}")]
+	StaticProfile(&'static str),
+	/// Issue and expiry heights did not form a bounded V1 validity window.
+	#[error("source-proof result validity window is invalid")]
+	ValidityWindow,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct AdmissionProfileV2 {
+	source_network_id: H256,
+	sidechain_id: H256,
+	bridge_address: H160,
+	token_address: H160,
+	settlement_profile_id: H256,
+	source_lock_ergo_tree_hash: H256,
+	vault_ergo_tree_hash: H256,
+	finality_policy_id: H256,
+	proof_system_id: H256,
+	proof_profile_id: H256,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct SourceIntentV2 {
+	source_network_id: H256,
+	sidechain_id: H256,
+	bridge_address: H160,
+	token_address: H160,
+	settlement_profile_id: H256,
+	admission_profile_id: H256,
+	source_asset_id: H256,

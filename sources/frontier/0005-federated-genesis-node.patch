+use std::collections::BTreeMap;
+
+use clap::Parser;
+use sc_cli::SubstrateCli;
+use scale_codec::Encode;
+use sp_core::{hashing::sha2_256, H160, H256, U256};
+use sp_runtime::BuildStorage;
+
+use super::{from_genesis_json, load_spec, MAX_GENESIS_JSON_BYTES};
+use crate::selected_runtime::{
+	bridge_commitment,
+	peg_in_pooled_reserve_reservation::{
+		PooledReserveMintReservationRuntimeProfileV4,
+		PooledReserveMintReservationSourceProofVerifierV4,
+	},
+	Runtime, RuntimeGenesisConfig, VERSION, WASM_BINARY,
+};
+
+type Verifier =
+	<Runtime as bridge_commitment::Config>::PooledReserveMintReservationSourceProofVerifier;
+
+fn short_string(value: &[u8]) -> H256 {
+	let mut word = [0u8; 32];
+	word[..value.len()].copy_from_slice(value);
+	word[31] = (value.len() * 2) as u8;
+	H256::from(word)
+}
+
+fn fixture() -> RuntimeGenesisConfig {
+	let bridge_code =
+		hex::decode(include_str!("../tests/res/bridge-atomicity/ErgoBridge.runtime.bin").trim())
+			.unwrap();
+	let token_code =
+		hex::decode(include_str!("../tests/res/bridge-atomicity/SERG.runtime.bin").trim()).unwrap();
+	let operator = H160::repeat_byte(0x31);
+	let bridge = H160::repeat_byte(0x33);
+	let token = H160::repeat_byte(0x44);
+	let profile = PooledReserveMintReservationRuntimeProfileV4 {
+		format_version: 4,
+		lineage_profile_id: H256::repeat_byte(0x10),
+		source_network_id: H256::repeat_byte(0x11),
+		sidechain_id: H256::repeat_byte(0x22),
+		bridge_address: bridge,
+		token_address: token,
+		bridge_runtime_code_sha256: H256::from(sha2_256(&bridge_code)),
+		bridge_runtime_code_bytes: bridge_code.len() as u32,
+		token_runtime_code_sha256: H256::from(sha2_256(&token_code)),
+		token_runtime_code_bytes: token_code.len() as u32,
+		settlement_profile_id: H256::repeat_byte(0x55),
+		ergo_deposit_finality_policy_id: H256::repeat_byte(0x66),
+		source_proof_system_id: Verifier::proof_system_id(),
+		source_proof_profile_id: Verifier::proof_profile_id(),
+		activation_height: 0,
+		max_pending_blocks: 64,
+	};
+	let mut config = RuntimeGenesisConfig::default();
+	config.manual_seal.enable = true;
+	config.evm.accounts = BTreeMap::from([
+		(
+			bridge,
+			fp_evm::GenesisAccount {
+				nonce: U256::one(),
+				balance: U256::zero(),
+				code: bridge_code,
+				storage: BTreeMap::from([
+					(H256::zero(), H256::from(operator)),
+					(H256::from_low_u64_be(3), H256::from(token)),
+				]),
+			},
+		),
+		(
+			token,
+			fp_evm::GenesisAccount {
+				nonce: U256::one(),
+				balance: U256::zero(),
+				code: token_code,
+				storage: BTreeMap::from([
+					(H256::from_low_u64_be(3), short_string(b"Sidechain ERG")),
+					(H256::from_low_u64_be(4), short_string(b"sERG")),
+					(H256::from_low_u64_be(5), H256::from(bridge)),
+				]),
+			},
+		),
+	]);
+	config.bridge_commitment.legacy_mint_quarantine_address = Some(bridge);
+	config.bridge_commitment.pooled_reserve_mint_genesis_v4 =
+		Some((operator, profile.encode().try_into().unwrap()));
+	config
+}
+
+#[test]
+fn selected_wasm_genesis_matches_native_state_and_cannot_be_replaced() {
+	assert_eq!(VERSION.spec_name, "frontier-template-v4-fed-genesis");
+	let config = fixture();
+	let native = config.build_storage().unwrap();
+	let path = std::env::temp_dir().join(format!(
+		"bridge-fed-genesis-{}-{}.json",
+		std::process::id(),
+		std::time::SystemTime::now()
+			.duration_since(std::time::UNIX_EPOCH)
+			.unwrap()
+			.as_nanos()
+	));
+	let mut file = std::fs::File::create_new(&path).unwrap();
+	struct Cleanup(std::path::PathBuf);
+	impl Drop for Cleanup {
+		fn drop(&mut self) {
+			let _ = std::fs::remove_file(&self.0);
+		}
+	}
+	let _cleanup = Cleanup(path.clone());
+	serde_json::to_writer(&mut file, &config).unwrap();
+	drop(file);
+	let selector = format!("fed-genesis:{}", path.display());
+	let cli = crate::cli::Cli::try_parse_from([
+		"bridge-node",
+		"--chain",
+		&selector,
+		"--sealing",
+		"manual",
+	])
+	.unwrap();
+	let spec = cli.load_spec(&selector).unwrap();
+	assert_eq!(spec.id(), "bridge_federated_v4_genesis");
+	assert!(spec.boot_nodes().is_empty());
+	assert!(spec.telemetry_endpoints().is_none());
+	let mut actual = spec.build_storage().unwrap();
+	assert_eq!(
+		actual.top.remove(sp_core::storage::well_known_keys::CODE),
+		Some(WASM_BINARY.unwrap().to_vec())
+	);
+	assert_eq!(actual.top, native.top);
+	assert_eq!(actual.children_default, native.children_default);
+	let build_cli = crate::cli::Cli::try_parse_from([
+		"bridge-node",
+		"build-spec",
+		"--chain",
+		&selector,
+		"--raw",
+	])
+	.unwrap();
+	let build_spec = build_cli.load_spec(&selector).unwrap();
+	assert_eq!(
+		build_spec.build_storage().unwrap().top,
+		spec.build_storage().unwrap().top
+	);
+	let missing_seal =
+		crate::cli::Cli::try_parse_from(["bridge-node", "--chain", &selector]).unwrap();
+	assert_eq!(
+		missing_seal.load_spec(&selector).err().as_deref(),
+		Some("FED genesis and CLI sealing mode differ")
+	);
+}
+
+#[test]
+fn rejects_non_typed_inputs_and_implicit_or_legacy_selectors() {
+	for selector in [
+		"",
+		"dev",
+		"local",
+		"bridge-lab",
+		"custom.json",
+		"fed-genesis:",
+	] {
+		assert!(
+			load_spec(selector, Some(true)).is_err(),
+			"accepted {selector}"
+		);
+	}
+	for field in ["raw", "runtimeGenesis", "unexpected"] {
+		let mut json = serde_json::to_value(fixture()).unwrap();
+		json[field] = serde_json::json!({"code": "0x00", "top": {}});
+		assert_eq!(
+			from_genesis_json(&serde_json::to_vec(&json).unwrap(), Some(true))
+				.err()
+				.as_deref(),
+			Some("invalid FED RuntimeGenesisConfig JSON")
+		);
+	}
+	let mut json = serde_json::to_value(fixture()).unwrap();
+	json["system"]["code"] = "0x00".into();
+	assert_eq!(
+		from_genesis_json(&serde_json::to_vec(&json).unwrap(), Some(true))
+			.err()
+			.as_deref(),
+		Some("invalid FED RuntimeGenesisConfig JSON")
+	);
+	let mut oversized = serde_json::to_vec(&fixture()).unwrap();
+	oversized.resize(MAX_GENESIS_JSON_BYTES + 1, b' ');
+	assert_eq!(
+		from_genesis_json(&oversized, Some(true)).err().as_deref(),
+		Some("FED typed genesis exceeds the input bound")
+	);
+	assert_eq!(
+		from_genesis_json(&serde_json::to_vec(&fixture()).unwrap(), Some(false))
+			.err()
+			.as_deref(),
+		Some("FED genesis and CLI sealing mode differ")
+	);
+}
+
+#[test]
+fn wasm_rejects_each_invalid_federated_genesis_before_spec_acceptance() {
+	for fault in [
+		"missing-profile",
+		"wrong-proof-profile",
+		"nonzero-activation",
+		"sudo",
+		"quarantine",
+		"code",
+		"owner",
+		"supply",
+	] {
+		let mut config = fixture();
+		let bridge = H160::repeat_byte(0x33);
+		let token = H160::repeat_byte(0x44);
+		match fault {
+			"missing-profile" => config.bridge_commitment.pooled_reserve_mint_genesis_v4 = None,
+			"wrong-proof-profile" | "nonzero-activation" => {
+				use scale_codec::Decode;
+				let bytes = &mut config
+					.bridge_commitment
+					.pooled_reserve_mint_genesis_v4
+					.as_mut()
+					.unwrap()
+					.1;
+				let mut profile =
+					PooledReserveMintReservationRuntimeProfileV4::decode(&mut &bytes[..]).unwrap();
+				if fault == "wrong-proof-profile" {
+					profile.source_proof_profile_id = H256::repeat_byte(0x99);
+				} else {
+					profile.activation_height = 4;
+				}
+				*bytes = profile.encode().try_into().unwrap();
+			}
+			"sudo" => config.sudo.key = Some(H160::repeat_byte(0x31).into()),
+			"quarantine" => config.bridge_commitment.legacy_mint_quarantine_address = None,
+			"code" => config.evm.accounts.get_mut(&bridge).unwrap().code.push(0),
+			"owner" => {
+				config
+					.evm
+					.accounts
+					.get_mut(&bridge)
+					.unwrap()
+					.storage
+					.insert(H256::zero(), H256::repeat_byte(0x77));
+			}
+			"supply" => {
+				config
+					.evm
+					.accounts
+					.get_mut(&token)
+					.unwrap()
+					.storage
+					.insert(H256::from_low_u64_be(2), H256::from_low_u64_be(1));
+			}
+			_ => unreachable!(),
+		}
+		assert_eq!(
+			from_genesis_json(&serde_json::to_vec(&config).unwrap(), Some(true))
+				.err()
+				.as_deref(),
+			Some("selected FED WASM rejected genesis"),
+			"wrong rejection for {fault}"
+		);
+	}
+}

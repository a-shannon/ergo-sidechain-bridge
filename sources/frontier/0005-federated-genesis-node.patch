diff --git a/template/node/src/federated_genesis.rs b/template/node/src/federated_genesis.rs
new file mode 100644
index 0000000000000000000000000000000000000000..df8527ad448dca7535d1bc51943ab7c842459fca
--- /dev/null
+++ b/template/node/src/federated_genesis.rs
@@ -0,0 +1,57 @@
+use std::{fs::File, io::Read};
+
+use sc_chain_spec::{ChainType, Properties};
+use sp_runtime::BuildStorage;
+
+use crate::{
+	chain_spec::ChainSpec,
+	selected_runtime::{RuntimeGenesisConfig, SS58Prefix, WASM_BINARY},
+};
+
+const MAX_GENESIS_JSON_BYTES: usize = 4 * 1024 * 1024;
+
+pub(crate) fn load_spec(selector: &str, manual_seal: Option<bool>) -> Result<ChainSpec, String> {
+	let path = selector
+		.strip_prefix("fed-genesis:")
+		.filter(|path| !path.is_empty())
+		.ok_or("the FED runtime requires `fed-genesis:<typed-genesis.json>`")?;
+	let mut bytes = Vec::new();
+	File::open(path)
+		.map_err(|_| "cannot open FED typed genesis")?
+		.take((MAX_GENESIS_JSON_BYTES + 1) as u64)
+		.read_to_end(&mut bytes)
+		.map_err(|_| "cannot read FED typed genesis")?;
+	from_genesis_json(&bytes, manual_seal)
+}
+
+fn from_genesis_json(bytes: &[u8], manual_seal: Option<bool>) -> Result<ChainSpec, String> {
+	if bytes.len() > MAX_GENESIS_JSON_BYTES {
+		return Err("FED typed genesis exceeds the input bound".into());
+	}
+	// FRAME's typed config rejects unknown fields; raw storage and caller WASM are not inputs.
+	let config: RuntimeGenesisConfig =
+		serde_json::from_slice(bytes).map_err(|_| "invalid FED RuntimeGenesisConfig JSON")?;
+	if manual_seal.is_some_and(|expected| config.manual_seal.enable != expected) {
+		return Err("FED genesis and CLI sealing mode differ".into());
+	}
+	let wasm = WASM_BINARY.ok_or("the selected FED runtime WASM is unavailable")?;
+	let mut properties = Properties::new();
+	properties.insert("tokenDecimals".into(), 18.into());
+	properties.insert("ss58Format".into(), SS58Prefix::get().into());
+	let spec = ChainSpec::builder(wasm, Default::default())
+		.with_name("Bridge Federated V4 Genesis")
+		.with_id("bridge_federated_v4_genesis")
+		.with_chain_type(ChainType::Development)
+		.with_properties(properties)
+		.with_genesis_config(
+			serde_json::to_value(config).map_err(|_| "cannot encode FED typed genesis")?,
+		)
+		.build();
+	// Execute the compiled WASM genesis consumer before returning a usable chain spec.
+	spec.build_storage()
+		.map_err(|_| "selected FED WASM rejected genesis")?;
+	Ok(spec)
+}

+fn abi_call_with_dynamic_bytes(signature: &[u8], first_word: H256, bytes: &[u8]) -> Vec<u8> {
+	let padded_bytes = bytes
+		.len()
+		.checked_add(31)
+		.expect("LAB ABI dynamic bytes length fits usize")
+		/ 32 * 32;
+	let mut input = Vec::with_capacity(4 + 96 + padded_bytes);
+	input.extend_from_slice(&keccak_256(signature)[..4]);
+	input.extend_from_slice(first_word.as_bytes());
+	input.extend_from_slice(H256::from_low_u64_be(64).as_bytes());
+	input.extend_from_slice(H256::from_low_u64_be(bytes.len() as u64).as_bytes());
+	input.extend_from_slice(bytes);
+	input.resize(4 + 96 + padded_bytes, 0);
+	input
+}
+
+fn derive_lab_burn_id(sidechain_id: H256, transaction_hash: H256, event_index: u32) -> H256 {
+	let mut bytes = Vec::with_capacity(BURN_ID_DOMAIN.len() + 32 + 32 + 4);
+	bytes.extend_from_slice(BURN_ID_DOMAIN);
+	bytes.extend_from_slice(sidechain_id.as_bytes());
+	bytes.extend_from_slice(transaction_hash.as_bytes());
+	bytes.extend_from_slice(&event_index.to_be_bytes());
+	H256::from(blake2_256(&bytes))
+}
+
+fn hash_lab_burn_leaf(
+	sidechain_id: H256,
+	execution_block_hash: H256,
+	burn_id: H256,
+	transaction_hash: H256,
+	event_index: u32,
+	recipient_ergo_tree_hash: H256,
+	amount: u64,
+) -> H256 {
+	let mut encoded = Vec::with_capacity(205);
+	encoded.push(1);
+	encoded.extend_from_slice(sidechain_id.as_bytes());
+	encoded.extend_from_slice(execution_block_hash.as_bytes());
+	encoded.extend_from_slice(burn_id.as_bytes());
+	encoded.extend_from_slice(transaction_hash.as_bytes());
+	encoded.extend_from_slice(&event_index.to_be_bytes());
+	encoded.extend_from_slice(recipient_ergo_tree_hash.as_bytes());
+	encoded.extend_from_slice(&amount.to_be_bytes());
+	encoded.extend_from_slice(&[0u8; 32]);
+	let mut preimage = Vec::with_capacity(BURN_LEAF_DOMAIN.len() + encoded.len());
+	preimage.extend_from_slice(BURN_LEAF_DOMAIN);
+	preimage.extend_from_slice(&encoded);
+	H256::from(blake2_256(&preimage))
+}

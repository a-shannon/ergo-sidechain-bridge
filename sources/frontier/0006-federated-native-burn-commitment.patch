+#[test]
+fn native_burn_commitment_ignores_foreign_bridge_even_when_legacy_selects_it() {
+    for legacy in [None, Some(H160::repeat_byte(0x77))] {
+        let (config, profile) = fixture();
+        let mut ext: sp_io::TestExternalities = config.build_storage().unwrap().into();
+        ext.execute_with(|| {
+            bridge_commitment::BridgeAddress::<Runtime>::kill();
+            if let Some(address) = legacy { bridge_commitment::BridgeAddress::<Runtime>::put(address); }
+            native_burn_commitment_parent();
+            let (block, receipts, statuses, _) = native_burn_commitment_block(&profile, H160::repeat_byte(0x77));
+            let events = System::events();
+            assert_ok!(<BridgeCommitment as OnBlockStored>::on_block_stored(&block, &receipts, &statuses));
+            assert!(bridge_commitment::CurrentCommitment::<Runtime>::get().is_none());
+            assert!(bridge_commitment::CurrentLeafHashes::<Runtime>::get().is_empty());
+            assert_eq!(System::events(), events);
+        });
+    }
+}

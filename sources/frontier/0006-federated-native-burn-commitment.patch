+#[test]
+fn native_burn_commitment_rejects_invalid_active_state_without_writes() {
+    for fault in ["missing-profile", "missing-enforcement", "missing-both", "version", "sidechain",
+        "aliased-addresses", "proof-system", "proof-profile", "activation"] {
+        let (config, mut profile) = fixture();
+        let mut ext: sp_io::TestExternalities = config.build_storage().unwrap().into();
+        ext.execute_with(|| {
+            native_burn_commitment_parent();
+            let (block, receipts, statuses, _) = native_burn_commitment_block(&profile, profile.bridge_address);
+            let prior = bridge_commitment::BridgeEventCommitment { format_version: 1, sidechain_id: profile.sidechain_id,
+                sidechain_height: 3, execution_block_hash: H256::repeat_byte(0xb1),
+                bridge_event_root: H256::repeat_byte(0xb2), burn_leaf_count: 1 };
+            bridge_commitment::CurrentCommitment::<Runtime>::put(&prior);
+            let leaves: frame_support::BoundedVec<H256, <Runtime as bridge_commitment::Config>::MaxBurnsPerBlock> =
+                vec![prior.bridge_event_root].try_into().unwrap();
+            bridge_commitment::CurrentLeafHashes::<Runtime>::put(&leaves);
+            System::deposit_event(RuntimeEvent::BridgeCommitment(bridge_commitment::Event::BridgeEventRootStored {
+                format_version: 1, execution_block_hash: prior.execution_block_hash,
+                bridge_event_root: prior.bridge_event_root, burn_leaf_count: 1,
+            }));
+            match fault {
+                "missing-profile" | "missing-both" => CurrentPooledReserveMintReservationProfileV4::<Runtime>::kill(),
+                "missing-enforcement" => PooledReserveMintReservationEnforcementActivatedV4::<Runtime>::kill(),
+                "version" => profile.format_version = 5,
+                "sidechain" => profile.sidechain_id = H256::zero(),
+                "aliased-addresses" => profile.token_address = profile.bridge_address,
+                "proof-system" => profile.source_proof_system_id = H256::repeat_byte(0xb3),
+                "proof-profile" => profile.source_proof_profile_id = H256::repeat_byte(0xb4),
+                "activation" => profile.activation_height = 5,
+                _ => unreachable!(),
+            }
+            if fault == "missing-both" { PooledReserveMintReservationEnforcementActivatedV4::<Runtime>::kill(); }
+            if !fault.starts_with("missing-") { CurrentPooledReserveMintReservationProfileV4::<Runtime>::put(&profile); }
+            let expected = if fault.starts_with("missing-") { "required V4 genesis profile or enforcement is missing" }
+                else if fault.starts_with("proof-") { "pooled-reserve mint-reservation profile selects an unknown source proof" }
+                else if fault == "activation" { "pooled-reserve mint-reservation profile is not active" }
+                else { "pooled-reserve mint-reservation profile contains a zero or aliased field" };
+            let before = sp_io::storage::root(sp_runtime::StateVersion::V1);
+            let events = System::events();
+            assert_eq!(<BridgeCommitment as OnBlockStored>::on_block_stored(&block, &receipts, &statuses), Err(expected), "{fault}");
+            assert_eq!(sp_io::storage::root(sp_runtime::StateVersion::V1), before, "partial write for {fault}");
+            assert_eq!(bridge_commitment::CurrentCommitment::<Runtime>::get(), Some(prior));
+            assert_eq!(bridge_commitment::CurrentLeafHashes::<Runtime>::get(), leaves);
+            assert_eq!(System::events(), events);
+        });
+    }
+}

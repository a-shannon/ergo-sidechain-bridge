+// Callback fixtures use the normal FED library and its real parent-profile snapshot.
+// They exercise commitment production, not EVM transaction execution or source finality.
+fn native_burn_commitment_parent() {
+    frame_system::BlockHash::<Runtime>::insert(0, H256::repeat_byte(0xa1));
+    System::initialize(&4, &H256::repeat_byte(0xa2), &Default::default());
+    assert_ok!(<BridgeCommitment as OnBlockStored>::on_block_started());
+}
+
+fn native_burn_commitment_block(profile: &PooledReserveMintReservationRuntimeProfileV4, emitter: H160)
+    -> (Block, Vec<Receipt>, Vec<TransactionStatus>, Vec<u8>)
+{
+    let recipient = code("0008cd0279be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798");
+    let user = H160::repeat_byte(0x42);
+    let transfer_topic = H256::from(keccak_256(b"Transfer(address,address,uint256)"));
+    let transfer = |to: H160, amount: u64| Log {
+        address: profile.token_address,
+        topics: vec![transfer_topic, H256::from(user), H256::from(to)],
+        data: H256::from_low_u64_be(amount).as_bytes().to_vec(),
+    };
+    let mut data = vec![0u8; 160];
+    data[24..32].copy_from_slice(&10_000_000u64.to_be_bytes());
+    data[63] = 64;
+    data[95] = recipient.len() as u8;
+    data[96..132].copy_from_slice(&recipient);
+    let mut call = keccak_256(b"pegOut(uint256,bytes)")[..4].to_vec();
+    call.extend_from_slice(&data);
+    call[28..36].copy_from_slice(&15_000_000u64.to_be_bytes());
+    let logs = vec![transfer(H160::zero(), 10_000_000), transfer(emitter, 5_000_000), Log {
+        address: emitter,
+        topics: vec![H256::from(keccak_256(b"PegOut(address,uint256,bytes)")), H256::from(user)], data,
+    }];
+    // Legacy TransactionV2 + signature SCALE schema from the pinned Ethereum crate.
+    let encoded = (0u8, U256::from(3), U256::from(1_423_828_125u64), U256::from(5_000_000),
+        TransactionAction::Call(emitter), U256::zero(), call, 8519u64,
+        H256::from_low_u64_be(1), H256::from_low_u64_be(2)).encode();
+    let transaction = Transaction::decode(&mut &encoded[..]).unwrap();
+    assert_eq!(transaction.encode(), encoded);
+    let status = TransactionStatus { transaction_hash: transaction.hash(), transaction_index: 0,
+        from: user, to: Some(emitter), contract_address: None, logs: logs.clone(), logs_bloom: Default::default() };
+    let receipt_bytes = (0u8, 1u8, U256::from(100_000), status.logs_bloom, logs).encode();
+    let receipt = Receipt::decode(&mut &receipt_bytes[..]).unwrap();
+    assert_eq!(receipt.encode(), receipt_bytes);
+    let mut header = pallet_ethereum::CurrentBlock::<Runtime>::get().unwrap().header;
+    header.number = U256::from(4);
+    let block = Block::new(header.into(), vec![transaction], Vec::new());
+    (block, vec![receipt], vec![status], recipient)
+}
+
+fn native_burn_commitment_leaf(sidechain: H256, ethereum_hash: H256, transaction_hash: H256,
+    event_index: u32, recipient: &[u8]) -> H256
+{
+    let mut burn_id = b"E2S_TRUSTLESS_BURN_ID_V1".to_vec();
+    burn_id.extend_from_slice(sidechain.as_bytes());
+    burn_id.extend_from_slice(transaction_hash.as_bytes());
+    burn_id.extend_from_slice(&event_index.to_be_bytes());
+    let mut leaf = vec![1u8];
+    leaf.extend_from_slice(sidechain.as_bytes());
+    leaf.extend_from_slice(ethereum_hash.as_bytes());
+    leaf.extend_from_slice(&blake2_256(&burn_id));
+    leaf.extend_from_slice(transaction_hash.as_bytes());
+    leaf.extend_from_slice(&event_index.to_be_bytes());
+    leaf.extend_from_slice(&blake2_256(recipient));
+    leaf.extend_from_slice(&10_000_000u64.to_be_bytes());
+    leaf.extend_from_slice(&[0u8; 32]);
+    assert_eq!(leaf.len(), 205);
+    let mut preimage = b"E2S_TRUSTLESS_BURN_LEAF_V1".to_vec();
+    preimage.extend_from_slice(&leaf);
+    H256::from(blake2_256(&preimage))
+}

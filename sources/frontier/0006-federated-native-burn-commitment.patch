+#[test]
+fn native_burn_commitment_selects_active_application_without_legacy_identity() {
+    for legacy in [None, Some(H160::repeat_byte(0x33)), Some(H160::repeat_byte(0x77))] {
+        let (config, profile) = fixture();
+        let mut ext: sp_io::TestExternalities = config.build_storage().unwrap().into();
+        ext.execute_with(|| {
+            bridge_commitment::BridgeAddress::<Runtime>::kill();
+            if let Some(address) = legacy { bridge_commitment::BridgeAddress::<Runtime>::put(address); }
+            assert_eq!(bridge_commitment::BridgeAddress::<Runtime>::get(), legacy);
+            native_burn_commitment_parent();
+            let (block, receipts, statuses, recipient) = native_burn_commitment_block(&profile, profile.bridge_address);
+            let ethereum_hash = block.header.hash();
+            let genesis = System::block_hash(0);
+            assert_ne!(profile.sidechain_id, genesis);
+            assert_ne!(ethereum_hash, genesis);
+            assert_ne!(ethereum_hash, profile.sidechain_id);
+            let leaf = native_burn_commitment_leaf(profile.sidechain_id, ethereum_hash, statuses[0].transaction_hash, 2, &recipient);
+            assert_ne!(leaf, native_burn_commitment_leaf(genesis, ethereum_hash, statuses[0].transaction_hash, 2, &recipient));
+            assert_ne!(leaf, native_burn_commitment_leaf(profile.sidechain_id, genesis, statuses[0].transaction_hash, 2, &recipient));
+            assert_ne!(leaf, native_burn_commitment_leaf(profile.sidechain_id, ethereum_hash, statuses[0].transaction_hash, 0, &recipient));
+            let before_events = System::events().len();
+            assert_ok!(<BridgeCommitment as OnBlockStored>::on_block_stored(&block, &receipts, &statuses));
+            let mut expected = vec![1u8];
+            expected.extend_from_slice(profile.sidechain_id.as_bytes());
+            expected.extend_from_slice(&4u64.to_le_bytes());
+            expected.extend_from_slice(ethereum_hash.as_bytes());
+            expected.extend_from_slice(leaf.as_bytes());
+            expected.extend_from_slice(&1u32.to_le_bytes());
+            assert_eq!(expected.len(), 109);
+            assert_eq!(bridge_commitment::CurrentCommitment::<Runtime>::get().expect("active application burn commitment").encode(), expected, "legacy={legacy:?}");
+            let mut expected_leaves = vec![4u8];
+            expected_leaves.extend_from_slice(leaf.as_bytes());
+            assert_eq!(bridge_commitment::CurrentLeafHashes::<Runtime>::get().encode(), expected_leaves);
+            let events = System::events();
+            assert_eq!(events.len(), before_events + 1);
+            assert_eq!(events.last().unwrap().event, RuntimeEvent::BridgeCommitment(bridge_commitment::Event::BridgeEventRootStored {
+                format_version: 1, execution_block_hash: ethereum_hash, bridge_event_root: leaf, burn_leaf_count: 1,
+            }));
+        });
+    }
+}

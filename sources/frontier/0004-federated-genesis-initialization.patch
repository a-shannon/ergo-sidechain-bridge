+	if sp_io::storage::exists(&prefix)
+		|| sp_io::storage::next_key(&prefix).map_or(false, |key| key.starts_with(&prefix))
+	{
+		return Err("V4 greenfield genesis requires an empty bridge storage namespace");
+	}
+	let mut input = profile_bytes;

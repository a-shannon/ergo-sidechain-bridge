+		|| quarantine_address != Some(profile.bridge_address)
+		|| !validate_runtime_code_expectation::<T>(profile.bridge_address,
+			profile.bridge_runtime_code_sha256, profile.bridge_runtime_code_bytes)
+		|| !validate_runtime_code_expectation::<T>(profile.token_address,
+			profile.token_runtime_code_sha256, profile.token_runtime_code_bytes)
+	{

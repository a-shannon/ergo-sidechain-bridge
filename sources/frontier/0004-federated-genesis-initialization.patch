index 0000000..fe26222
--- /dev/null
+++ b/template/runtime-v4-fed-genesis/tests/federated_genesis.rs
@@ -0,0 +1,275 @@
+use std::{collections::BTreeMap, panic::{catch_unwind, AssertUnwindSafe}};
+
+use frame_support::{assert_noop, assert_ok, traits::BuildGenesisConfig};
+use scale_codec::{Decode, Encode};
+use sp_core::{hashing::sha2_256, H160, H256, U256};
+use sp_runtime::{traits::Header as HeaderT, BuildStorage};
+
+use frontier_template_v4_fed_genesis_runtime::{
+    bridge_commitment::{self, CurrentPooledReserveMintReservationProfileV4,
+        PooledReserveMintReservationEnforcementActivatedV4},
+    peg_in_pooled_reserve_reservation::{
+        PooledReserveMintReservationRuntimeProfileV4,
+        PooledReserveMintReservationSourceProofVerifierV4},
+    BridgeCommitment, Executive, Header, Runtime, RuntimeGenesisConfig, RuntimeOrigin, System, Timestamp,
+};
+
+type SourceProofVerifier = <Runtime as bridge_commitment::Config>::PooledReserveMintReservationSourceProofVerifier;
+
+fn code(hex: &str) -> Vec<u8> {
+    let hex = hex.trim();
+    (0..hex.len()).step_by(2).map(|i| u8::from_str_radix(&hex[i..i + 2], 16).unwrap()).collect()
+}
+
+fn short_string(value: &[u8]) -> H256 {
+    let mut word = [0u8; 32];
+    word[..value.len()].copy_from_slice(value);
+    word[31] = (value.len() * 2) as u8;
+    H256::from(word)
+}
+
+fn fixture() -> (RuntimeGenesisConfig, PooledReserveMintReservationRuntimeProfileV4) {
+    let bridge_code = code(include_str!("../../node/src/tests/res/bridge-atomicity/ErgoBridge.runtime.bin"));
+    let token_code = code(include_str!("../../node/src/tests/res/bridge-atomicity/SERG.runtime.bin"));
+    let mut profile = PooledReserveMintReservationRuntimeProfileV4 {
+        format_version: 4,
+        lineage_profile_id: H256::repeat_byte(0x10),
+        source_network_id: H256::repeat_byte(0x11),
+        sidechain_id: H256::repeat_byte(0x22),
+        bridge_address: H160::repeat_byte(0x33),
+        token_address: H160::repeat_byte(0x44),
+        bridge_runtime_code_sha256: H256::zero(), bridge_runtime_code_bytes: 0,
+        token_runtime_code_sha256: H256::zero(), token_runtime_code_bytes: 0,
+        settlement_profile_id: H256::repeat_byte(0x55),
+        ergo_deposit_finality_policy_id: H256::repeat_byte(0x66),
+        source_proof_system_id: H256::zero(), source_proof_profile_id: H256::zero(),
+        activation_height: 0, max_pending_blocks: 64,
+    };
+    profile.bridge_runtime_code_sha256 = H256::from(sha2_256(&bridge_code));
+    profile.bridge_runtime_code_bytes = bridge_code.len() as u32;
+    profile.token_runtime_code_sha256 = H256::from(sha2_256(&token_code));
+    profile.token_runtime_code_bytes = token_code.len() as u32;
+    profile.source_proof_system_id = SourceProofVerifier::proof_system_id();
+    profile.source_proof_profile_id = SourceProofVerifier::proof_profile_id();
+    let operator = H160::repeat_byte(0x31);
+    let mut config = RuntimeGenesisConfig::default();
+    config.manual_seal.enable = true;
+    config.evm.accounts = BTreeMap::from([
+        (profile.bridge_address, fp_evm::GenesisAccount {
+            nonce: U256::one(), balance: U256::zero(), code: bridge_code,
+            storage: BTreeMap::from([
+                (H256::zero(), H256::from(operator)),
+                (H256::from_low_u64_be(3), H256::from(profile.token_address)),
+            ]),
+        }),
+        (profile.token_address, fp_evm::GenesisAccount {
+            nonce: U256::one(), balance: U256::zero(), code: token_code,
+            storage: BTreeMap::from([
+                (H256::from_low_u64_be(3), short_string(b"Sidechain ERG")),
+                (H256::from_low_u64_be(4), short_string(b"sERG")),
+                (H256::from_low_u64_be(5), H256::from(profile.bridge_address)),
+            ]),
+        }),
+    ]);
+    config.bridge_commitment.legacy_mint_quarantine_address = Some(profile.bridge_address);
+    config.bridge_commitment.pooled_reserve_mint_genesis_v4 = Some((operator, profile.encode().try_into().unwrap()));
+    (config, profile)
+}
+
+#[test]
+fn typed_genesis_initializes_after_evm_and_executes_first_block_without_sudo() {
+    let (config, profile) = fixture();
+    let mut ext: sp_io::TestExternalities = config.build_storage().unwrap().into();
+    ext.execute_with(|| {
+        assert_eq!(CurrentPooledReserveMintReservationProfileV4::<Runtime>::get(), Some(profile.clone()));
+        assert!(PooledReserveMintReservationEnforcementActivatedV4::<Runtime>::get());
+        assert!(!sp_io::storage::exists(&frame_support::storage::storage_prefix(b"Sudo", b"Key")));
+        let header = Header::new(1, H256::zero(), H256::zero(), H256::repeat_byte(0x19), Default::default());
+        Executive::initialize_block(&header);
+        assert_ok!(Timestamp::set(RuntimeOrigin::none(), 6_000));
+        let finalized = Executive::finalize_block();
+        assert_eq!(*finalized.number(), 1);
+        assert_eq!(CurrentPooledReserveMintReservationProfileV4::<Runtime>::get(), Some(profile));
+        assert!(bridge_commitment::ConsumedPooledReserveMintReservationsV4::<Runtime>::iter_keys().next().is_none());
+        assert!(bridge_commitment::PendingPooledReserveMintReservationsV4::<Runtime>::iter_keys().next().is_none());
+    });
+}
+
+#[test]
+fn genesis_profile_cannot_be_replaced_by_root_or_initialized_twice() {
+    let (config, profile) = fixture();
+    let mut ext: sp_io::TestExternalities = config.build_storage().unwrap().into();
+    ext.execute_with(|| {
+        assert_noop!(BridgeCommitment::activate_pooled_reserve_mint_reservation_profile_v4(RuntimeOrigin::root(), profile.clone()),
+            bridge_commitment::Error::<Runtime>::PooledReserveMintReservationProfileActivationBlocked);
+        let before = sp_io::storage::root(sp_runtime::StateVersion::V1);
+        assert!(catch_unwind(AssertUnwindSafe(|| config.bridge_commitment.build())).is_err());
+        assert_eq!(sp_io::storage::root(sp_runtime::StateVersion::V1), before);
+        assert_eq!(CurrentPooledReserveMintReservationProfileV4::<Runtime>::get(), Some(profile));
+    });
+}
+
+#[test]
+fn rejects_each_incomplete_or_non_greenfield_genesis_without_returning_storage() {
+    for fault in ["missing-profile", "truncated-profile", "wrong-version", "wrong-proof-system", "wrong-proof-profile",
+        "nonzero-height", "zero-lineage", "zero-domain", "sudo", "quarantine", "missing-bridge", "missing-token",
+        "bridge-code", "token-code", "bridge-owner", "zero-operator", "operator-alias", "operator-token-alias", "token-owner", "wrong-token",
+        "paused", "supply", "balance", "allowance", "replay", "fees", "token-name", "token-symbol"] {
+        let (mut config, mut profile) = fixture();
+        let bridge = profile.bridge_address;
+        let token = profile.token_address;
+        match fault {
+            "missing-profile" => config.bridge_commitment.pooled_reserve_mint_genesis_v4 = None,
+            "truncated-profile" => { config.bridge_commitment.pooled_reserve_mint_genesis_v4.as_mut().unwrap().1.pop(); },
+            "wrong-version" => profile.format_version = 5,
+            "wrong-proof-system" => profile.source_proof_system_id = H256::repeat_byte(0x81),
+            "wrong-proof-profile" => profile.source_proof_profile_id = H256::repeat_byte(0x82),
+            "nonzero-height" => profile.activation_height = 1,
+            "zero-lineage" => profile.lineage_profile_id = H256::zero(),
+            "zero-domain" => profile.sidechain_id = H256::zero(),
+            "sudo" => config.sudo.key = Some(H160::repeat_byte(0x77).into()),
+            "quarantine" => config.bridge_commitment.legacy_mint_quarantine_address = Some(token),
+            "missing-bridge" => { config.evm.accounts.remove(&bridge); },
+            "missing-token" => { config.evm.accounts.remove(&token); },
+            "bridge-code" => config.evm.accounts.get_mut(&bridge).unwrap().code[0] ^= 1,
+            "token-code" => config.evm.accounts.get_mut(&token).unwrap().code[0] ^= 1,
+            "zero-operator" | "operator-alias" | "operator-token-alias" => {
+                let bad = match fault { "zero-operator" => H160::zero(), "operator-alias" => bridge, _ => token };
+                config.bridge_commitment.pooled_reserve_mint_genesis_v4.as_mut().unwrap().0 = bad;
+                config.evm.accounts.get_mut(&bridge).unwrap().storage.insert(H256::zero(), H256::from(bad));
+            },
+            "bridge-owner" => { config.evm.accounts.get_mut(&bridge).unwrap().storage.insert(H256::zero(), H256::from(H160::repeat_byte(0x78))); },
+            "token-owner" => { config.evm.accounts.get_mut(&token).unwrap().storage.insert(H256::from_low_u64_be(5), H256::from(token)); },
+            "wrong-token" => { config.evm.accounts.get_mut(&bridge).unwrap().storage.insert(H256::from_low_u64_be(3), H256::from(bridge)); },
+            "paused" => {
+                let value = config.evm.accounts.get_mut(&bridge).unwrap().storage.get_mut(&H256::from_low_u64_be(3)).unwrap();
+                value.0[11] = 1;
+            },
+            "supply" => { config.evm.accounts.get_mut(&token).unwrap().storage.insert(H256::from_low_u64_be(2), H256::from_low_u64_be(1)); },
+            "balance" | "allowance" => { config.evm.accounts.get_mut(&token).unwrap().storage.insert(H256::repeat_byte(if fault == "balance" { 0x88 } else { 0x89 }), H256::from_low_u64_be(1)); },
+            "replay" => { config.evm.accounts.get_mut(&bridge).unwrap().storage.insert(H256::repeat_byte(0x90), H256::from_low_u64_be(1)); },
+            "fees" => { config.evm.accounts.get_mut(&bridge).unwrap().storage.insert(H256::from_low_u64_be(5), H256::from_low_u64_be(1)); },
+            "token-name" | "token-symbol" => { config.evm.accounts.get_mut(&token).unwrap().storage.insert(H256::from_low_u64_be(if fault == "token-name" { 3 } else { 4 }), H256::zero()); },
+            _ => unreachable!(),
+        }
+        if ["wrong-version", "wrong-proof-system", "wrong-proof-profile", "nonzero-height", "zero-lineage", "zero-domain"].contains(&fault) {
+            config.bridge_commitment.pooled_reserve_mint_genesis_v4.as_mut().unwrap().1 = profile.encode().try_into().unwrap();
+        }
+        let reason = match fault {
+            "missing-profile" => "V4 typed genesis is required only",
+            "truncated-profile" => "V4 genesis profile must decode exactly",
+            "wrong-version" | "zero-lineage" | "zero-domain" => "profile contains a zero or aliased field",
+            "wrong-proof-system" | "wrong-proof-profile" => "profile selects an unknown source proof",
+            "nonzero-height" => "profile is not active",
+            "sudo" => "height zero and absent Sudo authority",
+            "quarantine" | "missing-bridge" | "missing-token" | "bridge-code" | "token-code" |
+                "zero-operator" | "operator-alias" | "operator-token-alias" => "operator, quarantine and application code must match",
+            _ => "exact fresh bridge and token constructor storage",
+        };
+        let failure = catch_unwind(AssertUnwindSafe(|| config.build_storage())).expect_err(fault);
+        let message = failure.downcast_ref::<String>().map(String::as_str)
+            .or_else(|| failure.downcast_ref::<&str>().copied()).unwrap_or("");
+        assert!(message.contains(reason), "{fault} rejected for the wrong reason: {message}");
+    }
+}
+
+#[test]
+fn rejects_existing_bridge_namespace_and_nonzero_system_height_without_writes() {
+    for fault in ["legacy-profile", "v4-profile", "replay", "unknown-key", "height"] {
+        let (config, profile) = fixture();
+        let mut storage = frame_system::GenesisConfig::<Runtime>::default().build_storage().unwrap();
+        config.evm.assimilate_storage(&mut storage).unwrap();
+        let mut ext: sp_io::TestExternalities = storage.into();
+        ext.execute_with(|| {
+            if fault == "height" {
+                System::set_block_number(1);
+            } else {

+//! Non-publishable bridge V4 runtime with required federated genesis.
+
+#![cfg_attr(not(feature = "std"), no_std)]
+#![recursion_limit = "256"]
+#![allow(clippy::new_without_default, clippy::or_fun_call)]
+#![cfg_attr(feature = "runtime-benchmarks", warn(unused_crate_dependencies))]
+
+mod compiled_profile {
+	include!(concat!(
+		env!("OUT_DIR"),
+		"/federated_source_proof_profile.rs"
+	));
+}
+
+pub struct FederatedGenesisPooledReserveSourceProofProfileV1;
+
+impl crate::peg_in_pooled_reserve_reservation::FederatedPooledReserveSourceProofProfileProviderV1
+	for FederatedGenesisPooledReserveSourceProofProfileV1
+{
+	fn profile(
+	) -> crate::peg_in_pooled_reserve_reservation::FederatedPooledReserveSourceProofProfileV1 {
+		let signer_public_keys = compiled_profile::SIGNER_PUBLIC_KEYS
+			.to_vec()
+			.try_into()
+			.expect("the build script enforces the V1 signer bound");
+		crate::peg_in_pooled_reserve_reservation::FederatedPooledReserveSourceProofProfileV1 {
+			format_version: compiled_profile::FORMAT_VERSION,
+			federation_epoch: compiled_profile::FEDERATION_EPOCH,
+			threshold: compiled_profile::THRESHOLD,
+			signer_public_keys,
+			max_validity_blocks: compiled_profile::MAX_VALIDITY_BLOCKS,
+			verifier_profile_id: sp_core::H256::from(compiled_profile::VERIFIER_PROFILE_ID),
+		}
+	}
+}
+
+mod runtime_configuration {
+	pub type ErgoAutolykosCommittedVaultSourceProofConsumer =
+		crate::peg_in_ergo_autolykos_committed_vault::RejectedErgoAutolykosCommittedVaultSourceProofConsumerV1;
+	pub type ErgoAutolykosCommittedVaultRuntimeStatementConsumer =
+		crate::peg_in_ergo_autolykos_committed_vault_runtime_statement::RejectedErgoAutolykosCommittedVaultRuntimeStatementConsumerV2;
+	pub type ErgoAutolykosCommittedVaultUtxoRuntimeStatementConsumer =
+		crate::peg_in_ergo_autolykos_committed_vault_utxo_runtime_statement::RejectedErgoAutolykosCommittedVaultUtxoRuntimeStatementConsumerV3;
+	pub type ErgoAutolykosCommittedVaultUtxoRuntimeStatementActivationAllowed =
+		frame_support::traits::ConstBool<false>;
+	pub type SourceProofVerifier =
+		crate::peg_in_pooled_reserve_reservation::FederatedPooledReserveMintReservationSourceProofV1<
+			crate::FederatedGenesisPooledReserveSourceProofProfileV1,
+		>;
+	pub type ProfileActivationAllowed = frame_support::traits::ConstBool<false>;
+	pub type ProfileExecutionAllowed = frame_support::traits::ConstBool<true>;
+	pub type ProfileGenesisRequired = frame_support::traits::ConstBool<true>;
+	pub type LegacyPegInMintExecutionAllowed = frame_support::traits::ConstBool<false>;
+}
+
+include!("../../runtime/src/runtime_body.rs");
+
+#[sp_version::runtime_version]
+pub const VERSION: RuntimeVersion = RuntimeVersion {
+	spec_name: Cow::Borrowed("frontier-template-v4-fed-genesis"),
+	impl_name: Cow::Borrowed("frontier-template-v4-fed-genesis"),
+	authoring_version: 1,
+	spec_version: 1,
+	impl_version: 1,
+	apis: RUNTIME_API_VERSIONS,
+	transaction_version: 1,
+	system_version: 1,
+};

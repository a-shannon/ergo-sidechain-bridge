diff --git a/src/test/scala/org/ergoplatform/mining/CandidateGeneratorSpec.scala b/src/test/scala/org/ergoplatform/mining/CandidateGeneratorSpec.scala
index 1c394b281..6de21f113 100644
--- a/src/test/scala/org/ergoplatform/mining/CandidateGeneratorSpec.scala
+++ b/src/test/scala/org/ergoplatform/mining/CandidateGeneratorSpec.scala
@@ -58,0 +59,25 @@ class CandidateGeneratorSpec extends AnyFlatSpec with Matchers with ErgoTestHelp
+  it should "parse configured sidechain extension fields" in {
+    val valueHex = "ab" * 32
+    val candidate = CandidateGenerator.parseSidechainExtensionFields(s"0401:$valueHex")
+
+    candidate.fields.length shouldBe 1
+    Base16.encode(candidate.fields.head._1) shouldBe "0401"
+    Base16.encode(candidate.fields.head._2) shouldBe valueHex
+  }
+
+  it should "reject extension fields outside the sidechain key space" in {
+    val valueHex = "ab" * 32
+
+    intercept[IllegalArgumentException] {
+      CandidateGenerator.parseSidechainExtensionFields(s"0301:$valueHex")
+    }.getMessage should include("0x04 key space")
+  }
+
+  it should "reject duplicate configured sidechain extension fields" in {
+    val valueHex = "ab" * 32
+
+    intercept[IllegalArgumentException] {
+      CandidateGenerator.parseSidechainExtensionFields(s"0401:$valueHex,0401:$valueHex")
+    }.getMessage should include("duplicate keys")
+  }
+

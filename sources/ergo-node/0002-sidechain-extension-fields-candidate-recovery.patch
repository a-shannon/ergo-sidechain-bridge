+      RawHeader("X-Ergo-Owned-Mining-Parent", parent.headerId),
+      RawHeader("X-Ergo-Owned-Mining-Parent-Height", parent.height.toString))
+    Post(prefix + "/" + path).withHeaders((common ++ binding): _*)
+  }

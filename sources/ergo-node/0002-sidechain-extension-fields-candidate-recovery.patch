+package org.ergoplatform.mining
+
+import org.ergoplatform.modifiers.history.header.Header
+
+import java.nio.charset.StandardCharsets
+import java.security.MessageDigest
+import scala.util.Try
+
+/** Optional process-lifetime gate for the owned synthetic miner's submissions.
+  * Actor replacement must reuse processControl; this gate does not stop a node,
+  * attest indexed state, authenticate a chain, or resume a paused submission.
+  */
+object OwnedMiningSubmissionV1 {
+  val OwnerNonceSha256Env = "ERGO_SIDECHAIN_OWNED_MINING_NONCE_SHA256"
+  val MaximumBlockHeightEnv = "ERGO_SIDECHAIN_MAXIMUM_MINING_BLOCK_HEIGHT"
+  // Canonical request/receipt identity; its value is public, never an owner nonce.
+  val OperationIdField = "operationId"
+
+  def validOperationId(value: String): Boolean = isLowerHex(value)
+
+  final case class Watermark(headerId: String, height: Int)
+  final case class PauseReceipt(operationId: String,
+                                watermark: Option[Watermark],
+                                maximumBlockHeight: Option[Int])
+
+  lazy val processControl: Option[Control] = fromEnvironment(sys.env)
+
+  def fromEnvironment(environment: collection.Map[String, String]): Option[Control] = {
+    val owner = environment.get(OwnerNonceSha256Env)
+    val maximum = environment.get(MaximumBlockHeightEnv)
+    if (owner.isEmpty && maximum.isEmpty) None
+    else {
+      val ownerDigest = owner.filter(isLowerHex).getOrElse(invalidConfiguration())
+      val maximumHeight = maximum.map { value =>
+        if (value == null || !value.matches("(?:0|[1-9][0-9]*)")) invalidConfiguration()
+        Try(value.toInt).toOption.filter(_ >= 0).getOrElse(invalidConfiguration())
+      }
+      val digestBytes = ownerDigest.grouped(2).map(Integer.parseInt(_, 16).toByte).toArray
+      Some(new Control(digestBytes, maximumHeight))
+    }
+  }
+
+  private def invalidConfiguration(): Nothing =
+    throw new IllegalArgumentException("owned mining submission configuration is invalid")
+
+  private def isLowerHex(value: String): Boolean =
+    value != null && value.matches("[0-9a-f]{64}")
+
+  final class Control private[OwnedMiningSubmissionV1](ownerDigest: Array[Byte],
+                                                       val maximumBlockHeight: Option[Int]) {
+    private var pausedOperation: Option[String] = None
+    private var pendingHeader: Option[Watermark] = None
+    private var latestAppliedWatermark: Option[Watermark] = None
+    private var permanentFailure = false
+
+    def authenticate(ownerNonce: String): Boolean = {
+      isLowerHex(ownerNonce) && MessageDigest.isEqual(
+        MessageDigest.getInstance("SHA-256").digest(ownerNonce.getBytes(StandardCharsets.UTF_8)),
+        ownerDigest
+      )
+    }
+
+    def submissionsClosed: Boolean = synchronized {
+      pausedOperation.nonEmpty || permanentFailure
+    }
+
+    /** Reserve the identity before the caller sends its header and sections. */
+    def admitSubmission(header: Header): Either[String, Unit] = synchronized {
+      if (permanentFailure || pausedOperation.nonEmpty || pendingHeader.nonEmpty) {
+        Left("owned mining submission is closed or pending")
+      } else {
+        identity(header) match {
+          case Some(value) if maximumBlockHeight.forall(value.height <= _)
+            && latestAppliedWatermark.forall(_.height < value.height) =>
+            pendingHeader = Some(value)
+            Right(())
+          case _ => Left("owned mining submission header is outside its policy")
+        }
+      }
+    }
+
+    /** FullBlockApplied resolves only the exact registered local header. */
+    def observeApplied(header: Header): Unit = synchronized {
+      identity(header) match {
+        case None => permanentFailure = true
+        case Some(applied) =>
+          pendingHeader match {
+            case Some(pending) if applied == pending =>
+              latestAppliedWatermark = Some(applied)
+              pendingHeader = None
+            case Some(pending) if applied.height >= pending.height =>
+              permanentFailure = true
+            case _ =>
+              if (latestAppliedWatermark.exists(value =>
+                applied.height == value.height && applied.headerId != value.headerId)) {
+                permanentFailure = true
+              }
+          }
+      }
+    }
+
+    def observeRejected(modifierId: String): Unit = synchronized {
+      if (pendingHeader.exists(_.headerId == modifierId)) permanentFailure = true
+    }
+
+    /** A valid request closes submissions once; pending completion is not a receipt. */
+    def pause(ownerNonce: String, operationId: String): Either[String, Option[PauseReceipt]] = synchronized {
+      if (!validOperationId(operationId) || !authenticate(ownerNonce)) {
+        Left("owned mining pause authentication or identity is invalid")
+      } else if (permanentFailure || pausedOperation.nonEmpty) {
+        Left("owned mining pause is failed or already requested")
+      } else {
+        pausedOperation = Some(operationId)
+        completion
+      }
+    }
+
+    def pauseCompletion: Either[String, Option[PauseReceipt]] = synchronized {
+      completion
+    }
+
+    private def completion: Either[String, Option[PauseReceipt]] = {
+      if (permanentFailure) Left("owned mining submission failed permanently")
+      else pausedOperation match {
+        case None => Left("owned mining pause was not requested")
+        case Some(_) if pendingHeader.nonEmpty => Right(None)
+        case Some(operationId) =>
+          Right(Some(PauseReceipt(operationId, latestAppliedWatermark, maximumBlockHeight)))
+      }
+    }
+
+    private def identity(header: Header): Option[Watermark] = {
+      if (header == null || header.height < 1) None
+      else Try(header.id).toOption.filter(isLowerHex).map(id => Watermark(id, header.height))
+    }
+  }
+}
diff --git a/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionActorSpec.scala b/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionActorSpec.scala
new file mode 100644
index 0000000000000000000000000000000000000000..ec14bb083df3922067f14cea4033b0bd5c9cf4e9
--- /dev/null
+++ b/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionActorSpec.scala
@@ -0,0 +1,175 @@
+package org.ergoplatform.mining
+
+import akka.actor.{Actor, ActorRef, ActorSystem, Props}
+import akka.pattern.{StatusReply, ask}
+import akka.testkit.{TestKit, TestProbe}
+import akka.util.Timeout
+import org.ergoplatform.mining.CandidateGenerator.{Candidate, GenerateCandidate, PauseOwnedSubmissionV1}
+import org.ergoplatform.modifiers.ErgoFullBlock
+import org.ergoplatform.network.ErgoNodeViewSynchronizerMessages.{FullBlockApplied, SemanticallyFailedModification}
+import org.ergoplatform.nodeView.{ErgoNodeViewRef, ErgoReadersHolderRef, LocallyGeneratedModifier}
+import org.ergoplatform.nodeView.ErgoReadersHolder.{GetReaders, Readers}
+import org.ergoplatform.nodeView.state.StateType
+import org.ergoplatform.settings.ErgoSettings
+import org.ergoplatform.utils.ErgoTestHelpers
+import org.scalatest.flatspec.AnyFlatSpec
+import org.scalatest.matchers.should.Matchers
+
+import java.nio.charset.StandardCharsets
+import java.nio.file.Files
+import java.security.MessageDigest
+import scala.concurrent.duration._
+
+/** Real actors and a fresh NodeView; only forwarding the submitted sections is held. */
+class OwnedMiningSubmissionActorSpec extends AnyFlatSpec with Matchers with ErgoTestHelpers {
+  import org.ergoplatform.utils.ErgoNodeTestConstants._
+  import org.ergoplatform.utils.ErgoCoreTestConstants._
+  import OwnedMiningSubmissionV1._
+
+  implicit private val timeout: Timeout = defaultTimeout
+  private val nonce = "ab" * 32
+  private val operation = "cd" * 32
+  private val digest = MessageDigest.getInstance("SHA-256")
+    .digest(nonce.getBytes(StandardCharsets.UTF_8)).map(byte => f"${byte & 0xff}%02x").mkString
+
+  private case object ReleaseSubmission
+  private final class HeldForwarder(destination: ActorRef, observed: ActorRef) extends Actor {
+    private var held = Vector.empty[LocallyGeneratedModifier]
+    override def receive: Receive = {
+      case modifier: LocallyGeneratedModifier =>
+        held :+= modifier
+        observed ! modifier
+      case ReleaseSubmission =>
+        held.foreach(destination ! _)
+        held = Vector.empty
+    }
+  }
+
+  private final class Fixture(val system: ActorSystem, val generator: ActorRef, val readers: ActorRef,
+                              val forwarder: ActorRef, val submissions: TestProbe, val applied: TestProbe,
+                              val control: Control, val nodeSettings: ErgoSettings) {
+    def candidate(): Candidate = {
+      val reply = TestProbe()(system)
+      generator.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), reply.ref)
+      reply.expectMsgPF(3.seconds) { case StatusReply.Success(value: Candidate) => value }
+    }
+    def solve(candidate: Candidate): ErgoFullBlock =
+      nodeSettings.chainSettings.powScheme.proveCandidate(candidate.candidateBlock, defaultMinerSecret.w, 0, 1000).get
+    def submit(block: ErgoFullBlock): Unit = {
+      val reply = TestProbe()(system)
+      generator.tell(block.header.powSolution, reply.ref)
+      reply.expectMsg(2.seconds, StatusReply.success(()))
+      val sections = Vector(block.header) ++ block.mandatoryBlockSections
+      sections.foreach(section => submissions.expectMsgPF(2.seconds) {
+        case LocallyGeneratedModifier(observed) => observed.id shouldBe section.id
+      })
+    }
+  }
+
+  private def withFixture(maximum: Option[Int] = None)(run: Fixture => Unit): Unit = {
+    implicit val system: ActorSystem = ActorSystem()
+    try {
+      val control = fromEnvironment(Map(OwnerNonceSha256Env -> digest) ++ maximum.map(value => MaximumBlockHeightEnv -> value.toString)).get
+      val nodeSettings = settings.copy(
+        directory = Files.createTempDirectory("owned-mining-actor-").toString,
+        nodeSettings = settings.nodeSettings.copy(mining = true, stateType = StateType.Utxo,
+          internalMinerPollingInterval = 1.second, offlineGeneration = true, verifyTransactions = true),
+        chainSettings = settings.chainSettings.copy(blockInterval = 1.second,
+          powScheme = new AutolykosPowScheme(settings.chainSettings.powScheme.k, settings.chainSettings.powScheme.n))
+      )
+      val node = ErgoNodeViewRef(nodeSettings)
+      val readers = ErgoReadersHolderRef(node)
+      val submissions = TestProbe()
+      val applied = TestProbe()
+      system.eventStream.subscribe(applied.ref, classOf[FullBlockApplied])
+      val forwarder = system.actorOf(Props(new HeldForwarder(node, submissions.ref)))
+      val generator = CandidateGenerator(defaultMinerSecret.publicImage, readers, forwarder, nodeSettings, Some(control))
+      run(new Fixture(system, generator, readers, forwarder, submissions, applied, control, nodeSettings))
+    } finally TestKit.shutdownActorSystem(system)
+  }
+
+  it should "drain owned mining before acknowledgement and reject late cached solutions across actor replacement" in {
+    withFixture() { fixture =>
+      val previous = fixture.solve(fixture.candidate())
+      val current = fixture.solve(fixture.candidate())
+      fixture.submit(current)
+      val pause = TestProbe()(fixture.system)
+      fixture.generator.tell(PauseOwnedSubmissionV1(nonce, operation), pause.ref)
+      pause.expectNoMessage(200.millis)
+      val late = TestProbe()(fixture.system)
+      fixture.generator.tell(previous.header.powSolution, late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.generator.tell(current.header.powSolution, late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.generator.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.submissions.expectNoMessage(200.millis)
+      await((fixture.readers ? GetReaders).mapTo[Readers]).h.bestFullBlockOpt shouldBe None
+      fixture.forwarder ! ReleaseSubmission
+      fixture.applied.expectMsgPF(2.seconds) { case FullBlockApplied(header) => header.id shouldBe current.id }
+      pause.expectMsgPF(2.seconds) { case StatusReply.Success(receipt: PauseReceipt) =>
+        receipt shouldBe PauseReceipt(operation, Some(Watermark(current.id, current.header.height)), None)
+      }
+      val terminated = TestProbe()(fixture.system)
+      terminated.watch(fixture.generator)
+      fixture.system.stop(fixture.generator)
+      terminated.expectTerminated(fixture.generator, 2.seconds)
+      val replacement = CandidateGenerator(defaultMinerSecret.publicImage, fixture.readers, fixture.forwarder,
+        fixture.nodeSettings, Some(fixture.control))(fixture.system)
+      replacement.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), late.ref)
+      late.expectMsgPF(3.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      replacement.tell(current.header.powSolution, late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.submissions.expectNoMessage(200.millis)
+    }
+  }
+
+  it should "retain an owned mining failure on semantic rejection of a pending submission" in {
+    withFixture() { fixture =>
+      val block = fixture.solve(fixture.candidate())
+      fixture.submit(block)
+      val pause = TestProbe()(fixture.system)
+      fixture.generator.tell(PauseOwnedSubmissionV1(nonce, operation), pause.ref)
+      pause.expectNoMessage(200.millis)
+      fixture.generator ! SemanticallyFailedModification(ErgoFullBlock.modifierTypeId, block.id, new Exception("synthetic rejection"))
+      pause.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.control.submissionsClosed shouldBe true
+      fixture.control.pauseCompletion.isLeft shouldBe true
+      fixture.submissions.expectNoMessage(200.millis)
+    }
+  }
+
+  it should "refuse owned mining above the immutable completed block ceiling before sending any section" in {
+    withFixture(Some(0)) { fixture =>
+      val block = fixture.solve(fixture.candidate())
+      val reply = TestProbe()(fixture.system)
+      fixture.generator.tell(block.header.powSolution, reply.ref)
+      reply.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.submissions.expectNoMessage(200.millis)
+    }
+  }
+
+  it should "admit owned mining at the immutable completed block ceiling" in {
+    withFixture(Some(1)) { fixture =>
+      val block = fixture.solve(fixture.candidate())
+      block.header.height shouldBe 1
+      fixture.submit(block)
+    }
+  }
+
+  it should "refuse a valid previous-candidate solution above the immutable completed block ceiling" in {
+    withFixture(Some(0)) { fixture =>
+      val previous = fixture.solve(fixture.candidate())
+      val current = fixture.candidate()
+      previous.header.version shouldBe 1
+      fixture.nodeSettings.chainSettings.powScheme.validate(previous.header).isSuccess shouldBe true
+      val mismatchedCurrent = CandidateGenerator.completeBlock(current.candidateBlock, previous.header.powSolution)
+      fixture.nodeSettings.chainSettings.powScheme.validate(mismatchedCurrent.header).isFailure shouldBe true
+      val reply = TestProbe()(fixture.system)
+      fixture.generator.tell(previous.header.powSolution, reply.ref)
+      reply.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.submissions.expectNoMessage(200.millis)
+      fixture.control.submissionsClosed shouldBe false
+    }
+  }
+}
diff --git a/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionV1Spec.scala b/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionV1Spec.scala

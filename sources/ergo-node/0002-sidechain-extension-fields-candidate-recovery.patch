--- /dev/null
+++ b/src/main/scala/org/ergoplatform/mining/OwnedMiningSubmissionV1.scala
@@ -0,0 +1,285 @@
+package org.ergoplatform.mining
+
+import org.ergoplatform.modifiers.history.header.Header
+
+import java.nio.charset.StandardCharsets
+import java.security.MessageDigest
+import scala.util.Try
+
+/** Optional process-lifetime gate for the owned synthetic miner's submissions.
+  * Actor replacement must reuse processControl; this gate does not stop a node,
+  * attest indexed state, authenticate a chain, or resume a paused submission.
+  */
+object OwnedMiningSubmissionV1 {
+  val OwnerNonceSha256Env = "ERGO_SIDECHAIN_OWNED_MINING_NONCE_SHA256"
+  val MaximumBlockHeightEnv = "ERGO_SIDECHAIN_MAXIMUM_MINING_BLOCK_HEIGHT"
+  val TransactionPermitEnv = "ERGO_SIDECHAIN_OWNED_TRANSACTION_PERMIT"
+  val TransactionConfirmations = 10
+  // The indexed API counts successors after the inclusion block, not inclusion itself.
+  val TransactionApplications = TransactionConfirmations + 1
+  // Canonical request/receipt identity; its value is public, never an owner nonce.
+  val OperationIdField = "operationId"
+
+  def validOperationId(value: String): Boolean = isLowerHex(value)
+
+  final case class Watermark(headerId: String, height: Int)
+  final case class PauseReceipt(operationId: String,
+                                watermark: Option[Watermark],
+                                maximumBlockHeight: Option[Int])
+  final case class HoldReceipt(operationId: String, watermark: Watermark)
+  final case class TransactionPermitStatus(operationId: String,
+                                           transactionId: String,
+                                           initialParent: Watermark,
+                                           completed: Boolean,
+                                           finalWatermark: Option[Watermark])
+  private final case class Permit(transactionId: String, parent: Watermark, applied: Int)
+
+  lazy val processControl: Option[Control] = fromEnvironment(sys.env)
+
+  def fromEnvironment(environment: collection.Map[String, String]): Option[Control] = {
+    val owner = environment.get(OwnerNonceSha256Env)
+    val maximum = environment.get(MaximumBlockHeightEnv)
+    val permit = environment.get(TransactionPermitEnv)
+    if (owner.isEmpty && maximum.isEmpty && permit.isEmpty) None
+    else {
+      val ownerDigest = owner.filter(isLowerHex).getOrElse(invalidConfiguration())
+      val maximumHeight = maximum.map { value =>
+        if (value == null || !value.matches("(?:0|[1-9][0-9]*)")) invalidConfiguration()
+        Try(value.toInt).toOption.filter(_ >= 0).getOrElse(invalidConfiguration())
+      }
+      val digestBytes = ownerDigest.grouped(2).map(Integer.parseInt(_, 16).toByte).toArray
+      if (permit.exists(_ != "1")) invalidConfiguration()
+      Some(new Control(digestBytes, maximumHeight, permit.nonEmpty))
+    }
+  }
+
+  private def invalidConfiguration(): Nothing =
+    throw new IllegalArgumentException("owned mining submission configuration is invalid")
+
+  private def isLowerHex(value: String): Boolean =
+    value != null && value.matches("[0-9a-f]{64}")
+
+  final class Control private[OwnedMiningSubmissionV1](ownerDigest: Array[Byte],
+                                                       val maximumBlockHeight: Option[Int],
+                                                       val transactionPermitsEnabled: Boolean) {
+    private var pausedOperation: Option[String] = None
+    private var pendingHeader: Option[Watermark] = None
+    private var latestAppliedWatermark: Option[Watermark] = None
+    private var permanentFailure = false
+    private var holdOperation: Option[String] = None
+    private var heldParent: Option[Watermark] = None
+    private var permit: Option[Permit] = None
+    private var operationIds = Set.empty[String]
+    private var heldReadersJoined = false
+    private var currentPermitStatus: Option[TransactionPermitStatus] = None
+
+    private def claimOperation(ownerNonce: String, operationId: String): Boolean = {
+      if (!transactionPermitsEnabled || !authenticate(ownerNonce) || !validOperationId(operationId)) false
+      else if (permanentFailure || pausedOperation.nonEmpty) false
+      else if (operationIds.contains(operationId) || operationIds.size >= 64) {
+        permanentFailure = true
+        false
+      } else {
+        operationIds += operationId
+        true
+      }
+    }
+
+    /** Close first, before the actor consults possibly skewed history/state readers. */
+    def hold(ownerNonce: String, operationId: String): Either[String, Unit] = synchronized {
+      if (!claimOperation(ownerNonce, operationId)) Left("owned transaction hold refused")
+      else if (holdOperation.nonEmpty) {
+        permanentFailure = true
+        Left("owned transaction hold state differs")
+      } else {
+        holdOperation = Some(operationId)
+        heldParent = latestAppliedWatermark
+        heldReadersJoined = false
+        Right(())
+      }
+    }
+
+    /** Reader lag waits; a conflicting/advanced parent cannot establish a hold. */
+    def observeReaders(historyParent: Option[Header], stateParent: Option[Header]): Unit = synchronized {
+      if (holdOperation.nonEmpty && permit.isEmpty && !permanentFailure && pausedOperation.isEmpty) {
+        val history = historyParent.flatMap(identity)
+        val state = stateParent.flatMap(identity)
+        val expected = pendingHeader.orElse(heldParent)
+        val conflict = expected.exists(parent => Seq(history, state).flatten.exists(value =>
+          value.height > parent.height || (value.height == parent.height && value != parent)))
+        heldReadersJoined = false
+        if (conflict) permanentFailure = true
+        else if (pendingHeader.isEmpty && history.nonEmpty && history == state &&
+          expected.forall(history.contains)) {
+          heldParent = history
+          heldReadersJoined = true
+        }
+      }
+    }
+
+    def holdCompletion: Either[String, Option[HoldReceipt]] = synchronized {
+      if (permanentFailure || pausedOperation.nonEmpty || holdOperation.isEmpty) Left("owned transaction hold unavailable")
+      else if (pendingHeader.nonEmpty || permit.nonEmpty || !heldReadersJoined) Right(None)
+      else Right(Some(HoldReceipt(holdOperation.get, heldParent.get)))
+    }
+
+    def arm(ownerNonce: String, operationId: String, parent: Watermark,
+            transactionId: String, currentParent: => Option[Watermark]): Either[String, Unit] = synchronized {
+      if (!claimOperation(ownerNonce, operationId)) Left("owned transaction permit refused")
+      else if (holdOperation.isEmpty || permit.nonEmpty || pendingHeader.nonEmpty ||
+        !heldReadersJoined || !heldParent.contains(parent) || !isLowerHex(transactionId) ||
+        parent.height > Int.MaxValue - TransactionApplications ||
+        maximumBlockHeight.exists(_ < parent.height + TransactionApplications) ||
+        !currentParent.contains(parent)) {
+        permanentFailure = true
+        Left("owned transaction permit binding differs")
+      } else {
+        heldReadersJoined = false
+        permit = Some(Permit(transactionId, parent, 0))
+        currentPermitStatus = Some(TransactionPermitStatus(operationId, transactionId, parent,
+          completed = false, finalWatermark = None))
+        Right(())
+      }
+    }
+
+    /** Repeatable observation of the current arm, never an operation claim or mining effect. */
+    def transactionPermitStatus(ownerNonce: String, operationId: String, transactionId: String,
+                                initialParent: Watermark,
+                                readers: => (Option[Header], Option[Header])): Either[String, TransactionPermitStatus] = synchronized {
+      if (!transactionPermitsEnabled || !authenticate(ownerNonce) || !validOperationId(operationId) ||
+        !isLowerHex(transactionId) || !currentPermitStatus.exists(status =>
+          status.operationId == operationId && status.transactionId == transactionId &&
+            status.initialParent == initialParent)) Left("owned transaction status binding differs")
+      else if (permanentFailure || pausedOperation.nonEmpty) Left("owned transaction status unavailable")
+      else {
+        val status = currentPermitStatus.get
+        val pending = status.copy(completed = false, finalWatermark = None)
+        // Reader notifications may precede the exact final FullBlockApplied in
+        // this mailbox. They cannot substitute for consuming that application.
+        if (!status.completed || pendingHeader.nonEmpty) Right(pending)
+        else {
+          val joined = Try {
+            val (history, state) = readers
+            observeReaders(history, state)
+            heldReadersJoined && heldParent == status.finalWatermark
+          }
+          if (joined.isFailure) permanentFailure = true
+          if (permanentFailure) Left("owned transaction status readers differ")
+          else if (joined.get) Right(status)
+          else Right(pending)
+        }
+      }
+    }
+
+    def requiredPermitTransaction: Option[String] = synchronized {
+      permit.filter(_.applied == 0).map(_.transactionId)
+    }
+
+    def authenticate(ownerNonce: String): Boolean = {
+      isLowerHex(ownerNonce) && MessageDigest.isEqual(
+        MessageDigest.getInstance("SHA-256").digest(ownerNonce.getBytes(StandardCharsets.UTF_8)),
+        ownerDigest
+      )
+    }
+
+    def submissionsClosed: Boolean = synchronized {
+      pausedOperation.nonEmpty || permanentFailure ||
+        (holdOperation.nonEmpty && (permit.isEmpty || pendingHeader.nonEmpty))
+    }
+
+    /** Reserve the identity before the caller sends its header and sections. */
+    def admitSubmission(header: Header, transactionIds: Seq[String] = Seq.empty): Either[String, Unit] = synchronized {
+      if (submissionsClosed || pendingHeader.nonEmpty) {
+        Left("owned mining submission is closed or pending")
+      } else {
+        identity(header) match {
+          case Some(value) if maximumBlockHeight.forall(value.height <= _)
+            && latestAppliedWatermark.forall(_.height < value.height)
+            && permit.forall(p => value.height == p.parent.height + 1 && header.parentId == p.parent.headerId &&
+              (p.applied > 0 || transactionIds.contains(p.transactionId))) =>
+            pendingHeader = Some(value)
+            Right(())
+          case _ => Left("owned mining submission header is outside its policy")
+        }
+      }
+    }
+
+    /** FullBlockApplied resolves only the exact registered local header. */
+    def observeApplied(header: Header): Unit = synchronized {
+      identity(header) match {
+        case None => permanentFailure = true
+        case Some(applied) =>
+          pendingHeader match {
+            case Some(pending) if applied == pending =>
+              if (maximumBlockHeight.exists(applied.height > _)) permanentFailure = true
+              latestAppliedWatermark = Some(applied)
+              pendingHeader = None
+              if (holdOperation.nonEmpty) {
+                heldParent = Some(applied)
+                heldReadersJoined = false
+              }
+              permit = permit.flatMap { p =>
+                if (applied.height != p.parent.height + 1 || header.parentId != p.parent.headerId) {
+                  permanentFailure = true
+                  None
+                } else if (p.applied + 1 == TransactionApplications) {
+                  currentPermitStatus match {
+                    case Some(status) if applied.height == status.initialParent.height + TransactionApplications =>
+                      currentPermitStatus = Some(status.copy(completed = true, finalWatermark = Some(applied)))
+                    case _ => permanentFailure = true
+                  }
+                  None
+                }
+                else Some(p.copy(parent = applied, applied = p.applied + 1))
+              }
+            case Some(pending) if applied.height >= pending.height =>
+              permanentFailure = true
+            case _ =>
+              if (holdOperation.nonEmpty && heldParent.exists(value =>
+                applied.height > value.height || (applied.height == value.height && applied != value))) {
+                permanentFailure = true
+              }
+              if (latestAppliedWatermark.exists(value =>
+                applied.height == value.height && applied.headerId != value.headerId)) {
+                permanentFailure = true
+              }
+          }
+      }
+    }
+
+    def observeRejected(modifierId: String): Unit = synchronized {
+      if (pendingHeader.exists(_.headerId == modifierId)) permanentFailure = true
+    }
+
+    /** A valid request closes submissions once; pending completion is not a receipt. */
+    def pause(ownerNonce: String, operationId: String): Either[String, Option[PauseReceipt]] = synchronized {
+      if (!validOperationId(operationId) || !authenticate(ownerNonce)) {
+        Left("owned mining pause authentication or identity is invalid")
+      } else if (permanentFailure || pausedOperation.nonEmpty) {
+        Left("owned mining pause is failed or already requested")
+      } else {
+        pausedOperation = Some(operationId)
+        completion
+      }
+    }
+
+    def pauseCompletion: Either[String, Option[PauseReceipt]] = synchronized {
+      completion
+    }
+
+    private def completion: Either[String, Option[PauseReceipt]] = {
+      if (permanentFailure) Left("owned mining submission failed permanently")
+      else pausedOperation match {
+        case None => Left("owned mining pause was not requested")
+        case Some(_) if pendingHeader.nonEmpty => Right(None)
+        case Some(operationId) =>
+          Right(Some(PauseReceipt(operationId, latestAppliedWatermark, maximumBlockHeight)))
+      }
+    }
+
+    private def identity(header: Header): Option[Watermark] = {
+      if (header == null || header.height < 1) None
+      else Try(header.id).toOption.filter(isLowerHex).map(id => Watermark(id, header.height))
+    }
+  }
+}

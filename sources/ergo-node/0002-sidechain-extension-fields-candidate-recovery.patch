+        GetOwnedTransactionPermitStatusV1(nonce, "ef" * 32, "34" * 32, parent),
+        GetOwnedTransactionPermitStatusV1(nonce, "ef" * 32, transaction, parent.copy(height = parent.height + 1))
+      ).foreach { request =>
+        fixture.generator.tell(request, reply.ref)
+        reply.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+        reads.get() shouldBe before
+      }
+      fixture.status(parent, transaction).completed shouldBe true
+      reads.get() shouldBe before + 1
+      fixture.submissions.expectNoMessage(200.millis)
+    }
+  }
+
+  Seq("status pause", "status rejection").foreach { fault =>
+    it should s"retain $fault refusal across replacement with a pending submission" in {
+      withFixture(permits = true) { fixture =>
+        val anchor = fixture.solve(fixture.candidate())
+        fixture.submit(anchor)
+        fixture.applySubmitted(anchor)
+        val first = fixture.solve(fixture.candidate())
+        val parent = fixture.hold().watermark
+        val transaction = first.transactions.head.id
+        fixture.arm(parent, transaction)
+        fixture.submit(first)
+        fixture.replaceActor()
+        fixture.status(parent, transaction).completed shouldBe false
+        val reply = TestProbe()(fixture.system)
+        if (fault == "status pause") fixture.generator.tell(PauseOwnedSubmissionV1(nonce, "34" * 32), reply.ref)
+        else fixture.generator ! SemanticallyFailedModification(ErgoFullBlock.modifierTypeId,
+          first.id, new Exception("synthetic rejection"))
+        fixture.barrier()
+        fixture.generator.tell(GetOwnedTransactionPermitStatusV1(nonce, "ef" * 32, transaction, parent), reply.ref)
+        reply.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+        fixture.control.submissionsClosed shouldBe true
+        fixture.submissions.expectNoMessage(200.millis)
+      }
+    }
+  }
+
+  Seq("rejection", "competing parent", "terminal pause", "replay").foreach { failure =>
+    it should s"keep $failure closed through the real permit actor" in {
+      withFixture(permits = true) { fixture =>
+        val anchor = fixture.solve(fixture.candidate())
+        fixture.submit(anchor)
+        fixture.applySubmitted(anchor)
+        val first = fixture.solve(fixture.candidate())
+        val receipt = fixture.hold()
+        fixture.arm(receipt.watermark, first.transactions.head.id)
+        fixture.submit(first)
+        val reply = TestProbe()(fixture.system)
+        failure match {
+          case "rejection" => fixture.generator.tell(SemanticallyFailedModification(
+            ErgoFullBlock.modifierTypeId, first.id, new Exception("synthetic rejection")), fixture.submissions.ref)
+          case "competing parent" => fixture.generator.tell(
+            FullBlockApplied(first.header.copy(timestamp = first.header.timestamp + 1)), fixture.submissions.ref)
+          case "terminal pause" => fixture.generator.tell(PauseOwnedSubmissionV1(nonce, "34" * 32), reply.ref)
+          case "replay" =>
+            fixture.generator.tell(ArmOwnedTransactionV1(nonce, "ef" * 32, receipt.watermark, first.transactions.head.id), reply.ref)
+            reply.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+          case _ => fail("unknown fixture")
+        }
+        // Mailbox barrier follows the fault; no extra submitted section may escape.
+        fixture.generator.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), fixture.submissions.ref)
+        fixture.submissions.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+        fixture.generator.tell(first.header.powSolution, fixture.submissions.ref)
+        fixture.submissions.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+        fixture.submissions.expectNoMessage(200.millis)
+        if (failure == "terminal pause") {
+          fixture.applySubmitted(first)
+          reply.expectMsgPF(2.seconds) { case StatusReply.Success(value: PauseReceipt) =>
+            value.watermark shouldBe Some(Watermark(first.id, first.header.height))
+          }
+          fixture.control.submissionsClosed shouldBe true
+          fixture.generator.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), fixture.submissions.ref)
+          fixture.submissions.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+          fixture.submissions.expectNoMessage(200.millis)
+        }
+      }
+    }
+  }
+}
diff --git a/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionV1Spec.scala b/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionV1Spec.scala
new file mode 100644
index 0000000000000000000000000000000000000000..801652f2da58bd53f9a49d64c4aeb8518db8dabf
--- /dev/null
+++ b/src/test/scala/org/ergoplatform/mining/OwnedMiningSubmissionV1Spec.scala
@@ -0,0 +1,664 @@
+package org.ergoplatform.mining
+
+import org.ergoplatform.modifiers.history.header.Header
+import org.scalatest.flatspec.AnyFlatSpec
+import org.scalatest.matchers.should.Matchers
+import scorex.crypto.authds.ADDigest
+import scorex.crypto.hash.Digest32
+import scorex.util.bytesToId
+
+import java.nio.charset.StandardCharsets
+import java.security.MessageDigest
+import java.util.concurrent.{Callable, CountDownLatch, Executors, TimeUnit}
+
+/** Pure control transitions with serialized Header identities, not actor or node evidence. */
+class OwnedMiningSubmissionV1Spec extends AnyFlatSpec with Matchers {
+  import OwnedMiningSubmissionV1._
+
+  private val nonce = "ab" * 32
+  private val operation = "cd" * 32
+  private val digest = MessageDigest.getInstance("SHA-256")
+    .digest(nonce.getBytes(StandardCharsets.UTF_8)).map(byte => f"${byte & 0xff}%02x").mkString
+
+  private def control(maximum: Option[String] = None): Control =
+    fromEnvironment(Map(OwnerNonceSha256Env -> digest) ++ maximum.map(MaximumBlockHeightEnv -> _)).get
+
+  private val transactionId = "12" * 32
+  private val permitOperation = "ef" * 32
+  private def permitControl(maximum: Option[String] = None): Control =
+    fromEnvironment(Map(OwnerNonceSha256Env -> digest, TransactionPermitEnv -> "1") ++
+      maximum.map(MaximumBlockHeightEnv -> _)).get
+
+  private def held(owned: Control, parent: Header): Watermark = {
+    val watermark = Watermark(parent.id, parent.height)
+    owned.hold(nonce, operation) shouldBe Right(())
+    owned.observeReaders(Some(parent), Some(parent))
+    owned.holdCompletion shouldBe Right(Some(HoldReceipt(operation, watermark)))
+    owned.submissionsClosed shouldBe true
+    watermark
+  }
+
+  // Existing permit-policy cases supply an explicitly joined reader parent.
+  // Ordering and skew are exercised separately with the five-argument API.
+  private implicit class JoinedReaderRequest(owned: Control) {
+    def arm(owner: String, id: String, parent: Watermark, transaction: String): Either[String, Unit] =
+      owned.arm(owner, id, parent, transaction, Some(parent))
+  }
+
+  private def applyPermit(owned: Control, initial: Header, count: Int = TransactionApplications): Header = {
+    var parent = initial
+    for (_ <- 0 until count) {
+      val next = header(parent.height + 1).copy(parentId = parent.id)
+      owned.admitSubmission(next, Seq(transactionId)) shouldBe Right(())
+      owned.observeApplied(next)
+      parent = next
+    }
+    parent
+  }
+
+  // These headers exercise only identity/height binding; they are not accepted PoW blocks.
+  private def header(height: Int, timestamp: Long = 1L): Header = Header(
+    version = 2.toByte,
+    parentId = bytesToId(Array.fill(32)(0.toByte)),
+    ADProofsRoot = Digest32 @@ Array.fill(32)(0.toByte),
+    stateRoot = ADDigest @@ Array.fill(33)(0.toByte),
+    transactionsRoot = Digest32 @@ Array.fill(32)(0.toByte),
+    timestamp = timestamp,
+    nBits = 0L,
+    height = height,
+    extensionRoot = Digest32 @@ Array.fill(32)(0.toByte),
+    powSolution = AutolykosSolution(AutolykosSolution.pkForV2, AutolykosSolution.wForV2,
+      Array.fill(8)(0.toByte), AutolykosSolution.dForV2),
+    votes = Array.fill(3)(0.toByte),
+    unparsedBytes = Array.emptyByteArray
+  )
+
+  it should "leave omitted owned controls unchanged for legacy environments" in {
+    fromEnvironment(Map.empty) shouldBe None
+    fromEnvironment(Map("PATH" -> "unused", "ERGO_SIDECHAIN_EXTENSION_FIELDS" -> "unused")) shouldBe None
+  }
+
+  it should "require owner opt-in for a height limit" in {
+    val error = intercept[IllegalArgumentException] {
+      fromEnvironment(Map(MaximumBlockHeightEnv -> "10"))
+    }
+    error.getMessage shouldBe "owned mining submission configuration is invalid"
+  }
+
+  Seq("", "a" * 63, "A" * 64, "g" * 64, " " + digest).zipWithIndex.foreach { case (invalid, index) =>
+    it should s"reject malformed owner digest $index without exposing it" in {
+      val error = intercept[IllegalArgumentException] {
+        fromEnvironment(Map(OwnerNonceSha256Env -> invalid))
+      }
+      error.getMessage shouldBe "owned mining submission configuration is invalid"
+    }
+  }
+
+  Seq("", "01", "+1", "-1", "1.0", " 1", "2147483648").zipWithIndex.foreach { case (invalid, index) =>
+    it should s"reject malformed height limit $index" in {
+      intercept[IllegalArgumentException] {
+        control(Some(invalid))
+      }.getMessage shouldBe "owned mining submission configuration is invalid"
+    }
+  }
+
+  it should "accept canonical zero and maximum Int policy without wrapping" in {
+    control(Some("0")).maximumBlockHeight shouldBe Some(0)
+    control(Some(Int.MaxValue.toString)).maximumBlockHeight shouldBe Some(Int.MaxValue)
+    control().maximumBlockHeight shouldBe None
+  }
+
+  it should "authenticate only the exact canonical nonce" in {
+    val owned = control()
+    owned.authenticate(nonce) shouldBe true
+    Seq(null, "", nonce.toUpperCase, "aa" * 32, nonce + "00").foreach(value =>
+      owned.authenticate(value) shouldBe false)
+    owned.submissionsClosed shouldBe false
+  }
+
+  it should "expose the canonical public operation identity field and validator" in {
+    OperationIdField shouldBe "operationId"
+    validOperationId(operation) shouldBe true
+  }
+
+  Seq(null, "", "c" * 63, operation.toUpperCase, "g" * 64, " " + operation, operation + "00")
+    .zipWithIndex.foreach { case (invalid, index) =>
+      it should s"reject malformed operation identity $index before pause effects" in {
+        val owned = control()
+        validOperationId(invalid) shouldBe false
+        owned.pause(nonce, invalid).isLeft shouldBe true
+        owned.submissionsClosed shouldBe false
+        owned.admitSubmission(header(1)) shouldBe Right(())
+      }
+    }
+
+  it should "reject unauthorized or malformed pause requests before latching" in {
+    val owned = control()
+    owned.pause("aa" * 32, operation).isLeft shouldBe true
+    owned.pause(nonce, operation.toUpperCase).isLeft shouldBe true
+    owned.pause(nonce, null).isLeft shouldBe true
+    owned.submissionsClosed shouldBe false
+    owned.admitSubmission(header(1)) shouldBe Right(())
+  }
+
+  it should "return an immutable receipt for an empty pending slot and never resume" in {
+    val owned = control(Some("10"))
+    val receipt = PauseReceipt(operation, None, Some(10))
+    owned.pause(nonce, operation) shouldBe Right(Some(receipt))
+    owned.pauseCompletion shouldBe Right(Some(receipt))
+    owned.submissionsClosed shouldBe true
+    owned.pause(nonce, operation).isLeft shouldBe true
+    owned.pause(nonce, "ef" * 32).isLeft shouldBe true
+    owned.admitSubmission(header(1)).isLeft shouldBe true
+    receipt.productIterator.toSeq shouldBe Seq(operation, None, Some(10))
+  }
+
+  it should "reject a completion query before any pause was requested" in {
+    val owned = control()
+    owned.pauseCompletion.isLeft shouldBe true
+    owned.submissionsClosed shouldBe false
+  }
+
+  it should "admit at the cap and reject above it without reserving a slot" in {
+    val owned = control(Some("10"))
+    owned.admitSubmission(header(11)).isLeft shouldBe true
+    owned.admitSubmission(header(10)) shouldBe Right(())
+    owned.admitSubmission(header(9)).isLeft shouldBe true
+  }
+
+  it should "reject zero negative and null headers before reserving a slot" in {
+    val owned = control()
+    Seq(header(0), header(-1), null).foreach(value => owned.admitSubmission(value).isLeft shouldBe true)
+    owned.admitSubmission(header(1)) shouldBe Right(())
+    control(Some("0")).admitSubmission(header(1)).isLeft shouldBe true
+  }
+
+  it should "keep a pause pending until the exact local header is applied" in {
+    val owned = control()
+    val submitted = header(10)
+    owned.admitSubmission(submitted) shouldBe Right(())
+    owned.pause(nonce, operation) shouldBe Right(None)
+    owned.observeApplied(header(9))
+    owned.pauseCompletion shouldBe Right(None)
+    owned.observeRejected(header(9).id)
+    owned.pauseCompletion shouldBe Right(None)
+    owned.observeApplied(submitted)
+    owned.pauseCompletion shouldBe Right(Some(PauseReceipt(operation,
+      Some(Watermark(submitted.id, submitted.height)), None)))
+    owned.admitSubmission(header(11)).isLeft shouldBe true
+  }
+
+  it should "retain the applied watermark even after its pending slot was cleared" in {
+    val owned = control()
+    val first = header(10)
+    owned.admitSubmission(first) shouldBe Right(())
+    owned.observeApplied(first)
+    owned.pause(nonce, operation) shouldBe Right(Some(PauseReceipt(operation,
+      Some(Watermark(first.id, 10)), None)))
+  }
+
+  it should "advance the retained watermark only through a new exact pending header" in {
+    val owned = control()
+    val first = header(10)
+    val second = header(11)
+    owned.admitSubmission(first) shouldBe Right(())
+    owned.observeApplied(first)
+    owned.admitSubmission(first).isLeft shouldBe true
+    owned.admitSubmission(second) shouldBe Right(())
+    owned.observeApplied(second)
+    owned.pause(nonce, operation) shouldBe Right(Some(PauseReceipt(operation,
+      Some(Watermark(second.id, 11)), None)))
+  }
+
+  it should "fail permanently on an unrelated applied header at the pending height" in {
+    val owned = control()
+    val submitted = header(10)
+    owned.admitSubmission(submitted) shouldBe Right(())
+    owned.pause(nonce, operation) shouldBe Right(None)
+    owned.observeApplied(header(10, timestamp = 2L))
+    owned.submissionsClosed shouldBe true
+    owned.pauseCompletion.isLeft shouldBe true
+    owned.observeApplied(submitted)
+    owned.pauseCompletion.isLeft shouldBe true
+    owned.admitSubmission(header(11)).isLeft shouldBe true
+  }
+
+  it should "fail permanently if an unrelated application overtakes the pending height" in {
+    val owned = control()
+    owned.admitSubmission(header(10)) shouldBe Right(())
+    owned.observeApplied(header(11))
+    owned.submissionsClosed shouldBe true
+    owned.pause(nonce, operation).isLeft shouldBe true
+  }
+
+  it should "fail permanently on rejection of the exact pending submission" in {
+    val owned = control()
+    val submitted = header(10)
+    owned.admitSubmission(submitted) shouldBe Right(())
+    owned.observeRejected(submitted.id)
+    owned.submissionsClosed shouldBe true
+    owned.pause(nonce, operation).isLeft shouldBe true
+    owned.observeApplied(submitted)
+    owned.admitSubmission(header(11)).isLeft shouldBe true
+  }
+
+  it should "fail closed if an applied watermark is displaced at its own height" in {
+    val owned = control()
+    owned.admitSubmission(header(10)) shouldBe Right(())
+    owned.observeApplied(header(10))
+    owned.observeApplied(header(10, timestamp = 2L))
+    owned.submissionsClosed shouldBe true
+    owned.pause(nonce, operation).isLeft shouldBe true
+  }
+
+  it should "retain zero mining time for an empty header history" in {
+    CandidateGenerator.getBlockMiningTimeAvg(Vector.empty).toMillis shouldBe 0L
+  }
+
+  it should "initialize mining time from a single applied header without a partial pair" in {
+    CandidateGenerator.getBlockMiningTimeAvg(Vector(1000L)).toMillis shouldBe 0L
+  }
+
+  it should "retain the mining time average for complete sorted header pairs" in {
+    CandidateGenerator.getBlockMiningTimeAvg(Vector(4000L, 1000L, 2000L)).toMillis shouldBe 1500L
+  }
+
+  it should "share pending reservation across concurrent simulated owners" in {
+    val owned = control()
+    val firstOwner = owned
+    val secondOwner = owned
+    val start = new CountDownLatch(1)
+    val pool = Executors.newFixedThreadPool(2)
+    try {
+      val requests = Seq(firstOwner -> header(10), secondOwner -> header(10, timestamp = 2L)).map {
+        case (owner, candidate) => pool.submit(new Callable[Either[String, Unit]] {
+          override def call(): Either[String, Unit] = {
+            if (!start.await(5, TimeUnit.SECONDS)) throw new IllegalStateException("test synchronization failed")
+            owner.admitSubmission(candidate)
+          }
+        })
+      }
+      start.countDown()
+      val results = requests.map(_.get(5, TimeUnit.SECONDS))
+      results.count(_.isRight) shouldBe 1
+      results.count(_.isLeft) shouldBe 1
+      secondOwner.pause(nonce, operation) shouldBe Right(None)
+      firstOwner.submissionsClosed shouldBe true
+      firstOwner.pause(nonce, operation).isLeft shouldBe true
+    } finally {
+      pool.shutdownNow()
+      pool.awaitTermination(5, TimeUnit.SECONDS) shouldBe true
+    }
+  }
+
+  Seq("", "0", "true", "1\n").zipWithIndex.foreach { case (value, index) =>
+    it should s"refuse malformed transaction permit opt-in $index" in {
+      intercept[IllegalArgumentException] {
+        fromEnvironment(Map(OwnerNonceSha256Env -> digest, TransactionPermitEnv -> value))
+      }
+    }
+  }
+
+  it should "require an owner for transaction permits and leave ordinary controls unable to arm" in {
+    intercept[IllegalArgumentException] { fromEnvironment(Map(TransactionPermitEnv -> "1")) }
+    val owned = control()
+    owned.hold(nonce, operation).isLeft shouldBe true
+    owned.submissionsClosed shouldBe false
+  }
+
+  it should "admit inclusion plus ten contiguous successors then hold without changing the terminal pause" in {
+    val owned = permitControl()
+    var parent = header(10)
+    owned.arm(nonce, permitOperation, held(owned, parent), transactionId) shouldBe Right(())
+    for (index <- 0 until TransactionApplications) {
+      owned.requiredPermitTransaction shouldBe (if (index == 0) Some(transactionId) else None)
+      val next = header(parent.height + 1).copy(parentId = parent.id)
+      owned.admitSubmission(next, if (index == 0) Seq(transactionId) else Seq.empty) shouldBe Right(())
+      owned.submissionsClosed shouldBe true
+      owned.admitSubmission(next, Seq(transactionId)).isLeft shouldBe true
+      owned.observeApplied(next)
+      parent = next
+    }
+    owned.submissionsClosed shouldBe true
+    owned.observeReaders(Some(parent), Some(parent))
+    owned.holdCompletion shouldBe Right(Some(HoldReceipt(operation, Watermark(parent.id, parent.height))))
+    owned.admitSubmission(header(22).copy(parentId = parent.id), Seq(transactionId)).isLeft shouldBe true
+    owned.pause(nonce, "34" * 32).isRight shouldBe true
+    owned.arm(nonce, "56" * 32, Watermark(parent.id, parent.height), transactionId).isLeft shouldBe true
+  }
+
+  it should "remain pending at ten applications complete at eleven and refuse twelve" in {
+    TransactionConfirmations shouldBe 10
+    TransactionApplications shouldBe 11
+    val owned = permitControl()
+    val initial = header(10)
+    val parent = held(owned, initial)
+    owned.arm(nonce, permitOperation, parent, transactionId) shouldBe Right(())
+    val tenth = applyPermit(owned, initial, 10)
+    val pending = owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent,
+      (Some(tenth), Some(tenth))).toOption.get
+    pending.completed shouldBe false
+    pending.finalWatermark shouldBe None
+    owned.submissionsClosed shouldBe false
+    val eleventh = applyPermit(owned, tenth, 1)
+    owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent,
+      (Some(eleventh), Some(eleventh))) shouldBe Right(pending.copy(completed = true,
+      finalWatermark = Some(Watermark(eleventh.id, initial.height + 11))))
+    owned.submissionsClosed shouldBe true
+    val twelfth = header(eleventh.height + 1).copy(parentId = eleventh.id)
+    owned.admitSubmission(twelfth, Seq(transactionId)).isLeft shouldBe true
+  }
+
+  it should "keep an earlier pending header while a hold drains" in {
+    val owned = permitControl()
+    val parent = header(10)
+    val pending = header(11).copy(parentId = parent.id)
+    owned.admitSubmission(pending) shouldBe Right(())
+    owned.hold(nonce, operation) shouldBe Right(())
+    owned.observeReaders(Some(parent), Some(parent))
+    owned.holdCompletion shouldBe Right(None)
+    owned.admitSubmission(header(12), Seq(transactionId)).isLeft shouldBe true
+    owned.observeApplied(pending)
+    owned.holdCompletion shouldBe Right(None)
+    owned.observeReaders(Some(pending), Some(parent))
+    owned.holdCompletion shouldBe Right(None)
+    owned.observeReaders(Some(pending), Some(pending))
+    owned.holdCompletion shouldBe Right(Some(HoldReceipt(operation, Watermark(pending.id, 11))))
+  }
+
+  it should "refuse wrong first transaction parent and height without consuming the permit" in {
+    val owned = permitControl()
+    val parent = header(10)
+    owned.arm(nonce, permitOperation, held(owned, parent), transactionId) shouldBe Right(())
+    val next = header(11).copy(parentId = parent.id)
+    owned.admitSubmission(next, Seq("34" * 32)).isLeft shouldBe true
+    owned.admitSubmission(header(11), Seq(transactionId)).isLeft shouldBe true
+    owned.admitSubmission(header(12).copy(parentId = parent.id), Seq(transactionId)).isLeft shouldBe true
+    owned.admitSubmission(next, Seq(transactionId)) shouldBe Right(())
+    owned.requiredPermitTransaction shouldBe Some(transactionId)
+    owned.observeApplied(next)
+    owned.requiredPermitTransaction shouldBe None
+  }
+
+  it should "refuse a permit crossing the immutable ceiling before its first emission" in {
+    val owned = permitControl(Some("20"))
+    owned.arm(nonce, permitOperation, held(owned, header(10)), transactionId).isLeft shouldBe true
+    owned.submissionsClosed shouldBe true
+  }
+
+  it should "accept exactly the ceiling and refuse overflow in a permit endpoint" in {
+    val owned = permitControl(Some("21"))
+    owned.arm(nonce, permitOperation, held(owned, header(10)), transactionId).isRight shouldBe true
+    val overflow = permitControl()
+    overflow.arm(nonce, permitOperation, held(overflow, header(Int.MaxValue - TransactionConfirmations)), transactionId).isLeft shouldBe true
+    val exactMaximum = permitControl(Some(Int.MaxValue.toString))
+    exactMaximum.arm(nonce, permitOperation, held(exactMaximum, header(Int.MaxValue - TransactionApplications)), transactionId).isRight shouldBe true
+  }
+
+  it should "retain operation replay rejection across aliases of the process control" in {
+    val owned = permitControl()
+    val parent = held(owned, header(10))
+    owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+    val replacement = owned
+    replacement.arm(nonce, permitOperation, parent, transactionId).isLeft shouldBe true
+    owned.submissionsClosed shouldBe true
+  }
+
+  it should "reject an authenticated conflicting permit and never reopen the first" in {
+    val owned = permitControl()
+    val parent = held(owned, header(10))
+    owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+    owned.arm(nonce, "34" * 32, parent, transactionId).isLeft shouldBe true
+    owned.submissionsClosed shouldBe true
+  }
+
+  it should "reject foreign authentication without poisoning the legitimate held owner" in {
+    val owned = permitControl()
+    val parent = held(owned, header(10))
+    owned.arm("00" * 32, permitOperation, parent, transactionId).isLeft shouldBe true
+    owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+  }
+
+  it should "fail closed on competing application during either held or permitted state" in {
+    for (armed <- Seq(false, true)) {
+      val owned = permitControl()
+      val parent = header(10)
+      val watermark = held(owned, parent)
+      if (armed) owned.arm(nonce, permitOperation, watermark, transactionId).isRight shouldBe true
+      owned.observeApplied(header(11).copy(parentId = parent.id))
+      owned.submissionsClosed shouldBe true
+      owned.holdCompletion.isLeft shouldBe true
+    }
+  }
+
+  it should "keep semantic rejection and terminal pause dominant over pending permit application" in {
+    for (reject <- Seq(false, true)) {
+      val owned = permitControl()
+      val parent = header(10)
+      owned.arm(nonce, permitOperation, held(owned, parent), transactionId).isRight shouldBe true
+      val pending = header(11).copy(parentId = parent.id)
+      owned.admitSubmission(pending, Seq(transactionId)).isRight shouldBe true
+      if (reject) owned.observeRejected(pending.id)
+      else owned.pause(nonce, "34" * 32) shouldBe Right(None)
+      owned.observeApplied(pending)
+      owned.submissionsClosed shouldBe true
+      owned.arm(nonce, "56" * 32, Watermark(pending.id, 11), transactionId).isLeft shouldBe true
+    }
+  }
+
+  Seq("absent hold", "wrong parent", "wrong height", "malformed transaction", "second hold").foreach { fault =>
+    it should s"refuse the isolated permit request fault $fault without reopening submissions" in {
+      val owned = permitControl()
+      val parent = header(10)
+      val watermark = Watermark(parent.id, parent.height)
+      if (fault != "absent hold") held(owned, parent)
+      val outcome = fault match {
+        case "wrong parent" => owned.arm(nonce, permitOperation, watermark.copy(headerId = "34" * 32), transactionId)
+        case "wrong height" => owned.arm(nonce, permitOperation, watermark.copy(height = 11), transactionId)
+        case "malformed transaction" => owned.arm(nonce, permitOperation, watermark, transactionId + "\n")
+        case "second hold" => owned.hold(nonce, permitOperation)
+        case _ => owned.arm(nonce, permitOperation, watermark, transactionId)
+      }
+      outcome.isLeft shouldBe true
+      owned.submissionsClosed shouldBe true
+      owned.admitSubmission(header(11).copy(parentId = parent.id), Seq(transactionId)).isLeft shouldBe true
+    }
+  }
+
+  it should "wait for a stale reader parent at hold without clearing the applied watermark" in {
+    val owned = permitControl()
+    val parent = header(10)
+    owned.admitSubmission(parent).isRight shouldBe true
+    owned.observeApplied(parent)
+    owned.hold(nonce, operation) shouldBe Right(())
+    owned.observeReaders(Some(header(9)), Some(header(9)))
+    owned.holdCompletion shouldBe Right(None)
+    owned.submissionsClosed shouldBe true
+    owned.observeReaders(Some(parent), Some(parent))
+    owned.holdCompletion shouldBe Right(Some(HoldReceipt(operation, Watermark(parent.id, 10))))
+  }
+
+  it should "bound process-lifetime request identity storage and never reopen after exhaustion" in {
+    val owned = permitControl()
+    var parent = header(10)
+    held(owned, parent)
+    for (request <- 1 until 64) {
+      val requestId = f"$request%064x"
+      owned.arm(nonce, requestId, Watermark(parent.id, parent.height), transactionId).isRight shouldBe true
+      for (_ <- 0 until TransactionApplications) {
+        val next = header(parent.height + 1).copy(parentId = parent.id)
+        owned.admitSubmission(next, Seq(transactionId)).isRight shouldBe true
+        owned.observeApplied(next)
+        parent = next
+      }
+      owned.submissionsClosed shouldBe true
+      owned.observeReaders(Some(parent), Some(parent))
+    }
+    owned.arm(nonce, "56" * 32, Watermark(parent.id, parent.height), transactionId).isLeft shouldBe true
+    owned.holdCompletion.isLeft shouldBe true
+  }
+
+  it should "close an authenticated hold before skewed readers converge" in {
+    val owned = permitControl()
+    val parent = header(10)
+    owned.hold("00" * 32, operation).isLeft shouldBe true
+    owned.submissionsClosed shouldBe false
+    owned.hold(nonce, operation) shouldBe Right(())
+    owned.observeReaders(Some(parent), Some(header(9)))
+    owned.submissionsClosed shouldBe true
+    owned.holdCompletion shouldBe Right(None)
+    owned.admitSubmission(header(11).copy(parentId = parent.id), Seq(transactionId)).isLeft shouldBe true
+    owned.observeReaders(Some(parent), Some(parent))
+    owned.holdCompletion shouldBe Right(Some(HoldReceipt(operation, Watermark(parent.id, 10))))
+  }
+
+  Seq("same height", "advanced").foreach { fault =>
+    it should s"fail closed on $fault reader conflict after hold" in {
+      val owned = permitControl()
+      val parent = header(10)
+      held(owned, parent)
+      val conflict = if (fault == "advanced") header(11) else header(10, 2L)
+      owned.observeReaders(Some(conflict), Some(parent))
+      owned.holdCompletion.isLeft shouldBe true
+      owned.observeReaders(Some(parent), Some(parent))
+      owned.holdCompletion.isLeft shouldBe true
+      owned.submissionsClosed shouldBe true
+    }
+  }
+
+  it should "claim authentication and replay before consulting arm reader bindings" in {
+    val owned = permitControl()
+    val parent = held(owned, header(10))
+    var reads = 0
+    def current: Option[Watermark] = { reads += 1; Some(parent) }
+    owned.arm("00" * 32, permitOperation, parent, transactionId, current).isLeft shouldBe true
+    reads shouldBe 0
+    owned.arm(nonce, permitOperation, parent, transactionId, current) shouldBe Right(())
+    reads shouldBe 1
+    owned.arm(nonce, permitOperation, parent.copy(height = 11), transactionId, current).isLeft shouldBe true
+    reads shouldBe 1
+    owned.submissionsClosed shouldBe true
+  }
+
+  it should "refuse an authenticated arm whose current readers no longer match the held parent" in {
+    val owned = permitControl()
+    val parent = held(owned, header(10))
+    owned.arm(nonce, permitOperation, parent, transactionId, None).isLeft shouldBe true
+    owned.submissionsClosed shouldBe true
+    owned.arm(nonce, "34" * 32, parent, transactionId, Some(parent)).isLeft shouldBe true
+  }
+
+  it should "keep status pending without reading ahead of the eleventh registered application" in {
+    val owned = permitControl()
+    val initial = header(10)
+    val parent = held(owned, initial)
+    owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+    val tenth = applyPermit(owned, initial, TransactionApplications - 1)
+    val eleventh = header(21).copy(parentId = tenth.id)
+    var reads = 0
+    def readers: (Option[Header], Option[Header]) = { reads += 1; (Some(eleventh), Some(eleventh)) }
+    val pending = TransactionPermitStatus(permitOperation, transactionId, parent, completed = false, finalWatermark = None)
+    owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers) shouldBe Right(pending)
+    owned.admitSubmission(eleventh, Seq.empty) shouldBe Right(())
+    for (_ <- 0 until 101) {
+      owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers) shouldBe Right(pending)
+    }
+    reads shouldBe 0
+    owned.observeApplied(eleventh)
+    owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers) shouldBe
+      Right(pending.copy(completed = true, finalWatermark = Some(Watermark(eleventh.id, 21))))
+    reads shouldBe 1
+    owned.submissionsClosed shouldBe true
+  }
+
+  it should "reread completed status and replace only the current identity on the next arm" in {
+    val owned = permitControl()
+    val initial = header(10)
+    val parent = held(owned, initial)
+    owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+    val last = applyPermit(owned, initial)
+    var reads = 0
+    def readers: (Option[Header], Option[Header]) = { reads += 1; (Some(last), Some(last)) }
+    for (_ <- 0 until 101) {
+      owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers).toOption.get.completed shouldBe true
+    }
+    reads shouldBe 101
+    val lag = owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, (Some(last), Some(initial)))
+    lag.toOption.get.completed shouldBe false
+    lag.toOption.get.finalWatermark shouldBe None
+    owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers).toOption.get.completed shouldBe true
+    val nextParent = Watermark(last.id, last.height)
+    owned.arm(nonce, "34" * 32, nextParent, transactionId).isRight shouldBe true
+    val before = reads
+    owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers).isLeft shouldBe true
+    reads shouldBe before
+    owned.transactionPermitStatus(nonce, "34" * 32, transactionId, nextParent, readers).toOption.get.completed shouldBe false
+    reads shouldBe before
+    owned.submissionsClosed shouldBe false
+  }
+
+  Seq("foreign nonce", "malformed operation", "stale operation", "wrong transaction", "malformed transaction",
+    "wrong parent id", "wrong parent height", "null parent").foreach { fault =>
+    it should s"refuse $fault status without reader access or changing completion" in {
+      val owned = permitControl()
+      val initial = header(10)
+      val parent = held(owned, initial)
+      owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+      val last = applyPermit(owned, initial)
+      var reads = 0
+      def readers: (Option[Header], Option[Header]) = { reads += 1; (Some(last), Some(last)) }
+      val suppliedParent = fault match {
+        case "wrong parent id" => parent.copy(headerId = "34" * 32)
+        case "wrong parent height" => parent.copy(height = parent.height + 1)
+        case "null parent" => null
+        case _ => parent
+      }
+      val suppliedOperation = if (fault == "malformed operation") permitOperation + "\n"
+        else if (fault == "stale operation") "34" * 32 else permitOperation
+      val suppliedTransaction = if (fault == "malformed transaction") transactionId + "\n"
+        else if (fault == "wrong transaction") "34" * 32 else transactionId
+      owned.transactionPermitStatus(if (fault == "foreign nonce") "00" * 32 else nonce,
+        suppliedOperation, suppliedTransaction, suppliedParent, readers).isLeft shouldBe true
+      reads shouldBe 0
+      owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers).toOption.get.completed shouldBe true
+      reads shouldBe 1
+    }
+  }
+
+  Seq("advanced", "conflicting", "reader failure").foreach { fault =>
+    it should s"fail completed status permanently on $fault readers" in {
+      val owned = permitControl()
+      val initial = header(10)
+      val parent = held(owned, initial)
+      owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+      val last = applyPermit(owned, initial)
+      def readers: (Option[Header], Option[Header]) = fault match {
+        case "reader failure" => throw new IllegalStateException("synthetic reader failure")
+        case "advanced" => (Some(header(last.height + 1)), Some(last))
+        case _ => (Some(last), Some(header(last.height, 2L)))
+      }
+      owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers).isLeft shouldBe true
+      owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent,
+        (Some(last), Some(last))).isLeft shouldBe true
+      owned.submissionsClosed shouldBe true
+    }
+  }
+
+  Seq("pause", "rejection").foreach { fault =>
+    it should s"keep $fault dominant over status without reading readers" in {
+      val owned = permitControl()
+      val initial = header(10)
+      val parent = held(owned, initial)
+      owned.arm(nonce, permitOperation, parent, transactionId).isRight shouldBe true
+      val pending = header(11).copy(parentId = initial.id)
+      owned.admitSubmission(pending, Seq(transactionId)).isRight shouldBe true
+      if (fault == "pause") owned.pause(nonce, "34" * 32) shouldBe Right(None)
+      else owned.observeRejected(pending.id)
+      var reads = 0
+      def readers: (Option[Header], Option[Header]) = { reads += 1; (Some(pending), Some(pending)) }
+      owned.transactionPermitStatus(nonce, permitOperation, transactionId, parent, readers).isLeft shouldBe true
+      reads shouldBe 0
+      owned.submissionsClosed shouldBe true
+    }
+  }
+}

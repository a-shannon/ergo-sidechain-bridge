+  ): UpcomingStateContext = {
+    val upcoming = stateContext.upcoming(minerPk, timestamp, nBits, votes, proposedUpdate, version)
+    UpcomingStateContext(
+      upcoming.lastHeaders.take(Constants.LastHeadersInContext - 1),
+      upcoming.lastExtensionOpt,
+      upcoming.predictedHeader,
+      upcoming.genesisStateDigest,
+      upcoming.currentParameters,
+      upcoming.validationSettings,
+      upcoming.votingData
+    )(upcoming.chainSettings)
+  }

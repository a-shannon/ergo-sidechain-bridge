+
+/** Real actors and a fresh NodeView; only forwarding the submitted sections is held. */
+class OwnedMiningSubmissionActorSpec extends AnyFlatSpec with Matchers with ErgoTestHelpers {
+  import org.ergoplatform.utils.ErgoNodeTestConstants._
+  import org.ergoplatform.utils.ErgoCoreTestConstants._
+  import OwnedMiningSubmissionV1._
+
+  implicit private val timeout: Timeout = defaultTimeout
+  private val nonce = "ab" * 32
+  private val operation = "cd" * 32
+  private val digest = MessageDigest.getInstance("SHA-256")
+    .digest(nonce.getBytes(StandardCharsets.UTF_8)).map(byte => f"${byte & 0xff}%02x").mkString
+
+  private case object ReleaseSubmission
+  private final class HeldForwarder(destination: ActorRef, observed: ActorRef) extends Actor {
+    private var held = Vector.empty[LocallyGeneratedModifier]
+    override def receive: Receive = {
+      case modifier: LocallyGeneratedModifier =>
+        held :+= modifier
+        observed ! modifier
+      case ReleaseSubmission =>
+        held.foreach(destination ! _)
+        held = Vector.empty
+    }
+  }
+
+  private final class Fixture(val system: ActorSystem, var generator: ActorRef, val readers: ActorRef,
+                              val forwarder: ActorRef, val submissions: TestProbe, val applied: TestProbe,
+                              val control: Control, val nodeSettings: ErgoSettings, val node: ActorRef) {
+    def liveReaders(): Readers = await((readers ? GetReaders).mapTo[Readers])
+    def barrier(): Unit = {
+      val reply = TestProbe()(system)
+      generator.tell(ArmOwnedTransactionV1("00" * 32, "12" * 32, Watermark("00" * 32, 1), "34" * 32), reply.ref)
+      reply.expectMsgPF(3.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+    }
+    def detachReaderEvents(): Unit = {
+      system.eventStream.unsubscribe(generator, classOf[NodeViewChange])
+      system.eventStream.unsubscribe(generator, classOf[FullBlockApplied])
+      barrier()
+    }
+    def setReaders(history: ErgoHistoryReader, state: UtxoStateReader): Unit = {
+      generator ! ChangedHistory(history)
+      generator ! ChangedState(state)
+      barrier()
+    }
+    def candidate(): Candidate = {
+      val reply = TestProbe()(system)
+      generator.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), reply.ref)
+      reply.expectMsgPF(3.seconds) { case StatusReply.Success(value: Candidate) => value }
+    }
+    def solve(candidate: Candidate): ErgoFullBlock =
+      nodeSettings.chainSettings.powScheme.proveCandidate(candidate.candidateBlock, defaultMinerSecret.w, 0, 1000).get
+    def submit(block: ErgoFullBlock): Unit = {
+      val reply = TestProbe()(system)
+      generator.tell(block.header.powSolution, reply.ref)
+      reply.expectMsg(2.seconds, StatusReply.success(()))
+      val sections = Vector(block.header) ++ block.mandatoryBlockSections
+      sections.foreach(section => submissions.expectMsgPF(2.seconds) {
+        case LocallyGeneratedModifier(observed) => observed.id shouldBe section.id
+      })
+    }
+    def applySubmitted(block: ErgoFullBlock): Unit = {
+      forwarder ! ReleaseSubmission
+      applied.expectMsgPF(2.seconds) { case FullBlockApplied(header) => header.id shouldBe block.id }
+    }
+    def hold(): HoldReceipt = {
+      val reply = TestProbe()(system)
+      generator.tell(HoldOwnedTransactionsV1(nonce, operation), reply.ref)
+      reply.expectMsgPF(3.seconds) { case StatusReply.Success(value: HoldReceipt) => value }
+    }
+    def arm(parent: Watermark, transactionId: String, id: String = "ef" * 32): Unit = {
+      val reply = TestProbe()(system)
+      generator.tell(ArmOwnedTransactionV1(nonce, id, parent, transactionId), reply.ref)
+      reply.expectMsg(2.seconds, StatusReply.success(()))
+    }
+    def status(parent: Watermark, transactionId: String, id: String = "ef" * 32): TransactionPermitStatus = {
+      val reply = TestProbe()(system)
+      generator.tell(GetOwnedTransactionPermitStatusV1(nonce, id, transactionId, parent), reply.ref)
+      reply.expectMsgPF(2.seconds) { case StatusReply.Success(value: TransactionPermitStatus) => value }
+    }
+    def replaceActor(): Unit = {
+      val terminated = TestProbe()(system)
+      terminated.watch(generator)
+      system.stop(generator)
+      terminated.expectTerminated(generator, 2.seconds)
+      generator = CandidateGenerator(defaultMinerSecret.publicImage, readers, forwarder,
+        nodeSettings, Some(control))(system)
+    }
+  }
+
+  // Delegate real fixture readers except for their immutable observed tip. This
+  // exposes event ordering without manufacturing a different accepted chain.
+  private def freezeReader[A <: AnyRef](api: Class[A], underlying: A, field: String, value: AnyRef): A =
+    controlledReader(api, underlying, field, () => value)
+
+  private def controlledReader[A <: AnyRef](api: Class[A], underlying: A, field: String, value: () => AnyRef): A =
+    api.cast(Proxy.newProxyInstance(api.getClassLoader, Array[Class[_]](api), new InvocationHandler {
+      override def invoke(proxy: Any, method: Method, arguments: Array[AnyRef]): AnyRef =
+        if (method.getName == field) value()
+        else method.invoke(underlying, Option(arguments).getOrElse(Array.empty[AnyRef]): _*)
+    }))
+
+  private def frozenReaders(fixture: Fixture): (ErgoHistoryReader, UtxoStateReader) = {
+    val readers = fixture.liveReaders()
+    val state = readers.s.asInstanceOf[UtxoStateReader]
+    (freezeReader(classOf[ErgoHistoryReader], readers.h, "bestFullBlockOpt", readers.h.bestFullBlockOpt),
+      freezeReader(classOf[UtxoStateReader], state, "stateContext", state.stateContext))
+  }
+
+  private def minePermit(fixture: Fixture, first: ErgoFullBlock, count: Int = TransactionApplications): ErgoFullBlock = {
+    var last = first
+    fixture.submit(first)
+    fixture.applySubmitted(first)
+    for (_ <- 1 until count) {
+      last = fixture.solve(fixture.candidate())
+      fixture.submit(last)
+      fixture.applySubmitted(last)
+    }
+    last
+  }
+
+  private def withFixture(maximum: Option[Int] = None, permits: Boolean = false)(run: Fixture => Unit): Unit = {
+    implicit val system: ActorSystem = ActorSystem()
+    var fixture: Option[Fixture] = None
+    try {
+      val control = fromEnvironment(Map(OwnerNonceSha256Env -> digest) ++
+        maximum.map(value => MaximumBlockHeightEnv -> value.toString) ++
+        (if (permits) Map(TransactionPermitEnv -> "1") else Map.empty[String, String])).get
+      val nodeSettings = settings.copy(
+        directory = Files.createTempDirectory("owned-mining-actor-").toString,
+        nodeSettings = settings.nodeSettings.copy(mining = true, stateType = StateType.Utxo,
+          internalMinerPollingInterval = 1.second, offlineGeneration = true, verifyTransactions = true),
+        chainSettings = settings.chainSettings.copy(blockInterval = 1.second,
+          powScheme = new AutolykosPowScheme(settings.chainSettings.powScheme.k, settings.chainSettings.powScheme.n))
+      )
+      val node = ErgoNodeViewRef(nodeSettings)
+      val readers = ErgoReadersHolderRef(node)
+      val submissions = TestProbe()
+      val applied = TestProbe()
+      system.eventStream.subscribe(applied.ref, classOf[FullBlockApplied])
+      val forwarder = system.actorOf(Props(new HeldForwarder(node, submissions.ref)))
+      val generator = CandidateGenerator(defaultMinerSecret.publicImage, readers, forwarder, nodeSettings, Some(control))
+      val current = new Fixture(system, generator, readers, forwarder, submissions, applied, control, nodeSettings, node)
+      fixture = Some(current)
+      run(current)
+    } finally {
+      try fixture.foreach { current =>
+        val terminated = TestProbe()
+        terminated.watch(current.generator)
+        system.stop(current.generator)
+        terminated.expectTerminated(current.generator, 2.seconds)
+      } finally TestKit.shutdownActorSystem(system)
+    }
+  }
+
+  it should "drain owned mining before acknowledgement and reject late cached solutions across actor replacement" in {
+    withFixture() { fixture =>
+      val previous = fixture.solve(fixture.candidate())
+      val current = fixture.solve(fixture.candidate())
+      fixture.submit(current)
+      val pause = TestProbe()(fixture.system)
+      fixture.generator.tell(PauseOwnedSubmissionV1(nonce, operation), pause.ref)
+      pause.expectNoMessage(200.millis)
+      val late = TestProbe()(fixture.system)
+      fixture.generator.tell(previous.header.powSolution, late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.generator.tell(current.header.powSolution, late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.generator.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.submissions.expectNoMessage(200.millis)
+      await((fixture.readers ? GetReaders).mapTo[Readers]).h.bestFullBlockOpt shouldBe None
+      fixture.forwarder ! ReleaseSubmission
+      fixture.applied.expectMsgPF(2.seconds) { case FullBlockApplied(header) => header.id shouldBe current.id }
+      pause.expectMsgPF(2.seconds) { case StatusReply.Success(receipt: PauseReceipt) =>
+        receipt shouldBe PauseReceipt(operation, Some(Watermark(current.id, current.header.height)), None)
+      }
+      val terminated = TestProbe()(fixture.system)
+      terminated.watch(fixture.generator)
+      fixture.system.stop(fixture.generator)
+      terminated.expectTerminated(fixture.generator, 2.seconds)
+      val replacement = CandidateGenerator(defaultMinerSecret.publicImage, fixture.readers, fixture.forwarder,
+        fixture.nodeSettings, Some(fixture.control))(fixture.system)
+      fixture.generator = replacement
+      replacement.tell(GenerateCandidate(Seq.empty, reply = true, forced = true), late.ref)
+      late.expectMsgPF(3.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      replacement.tell(current.header.powSolution, late.ref)
+      late.expectMsgPF(2.seconds) { case error: StatusReply[_] => error.isError shouldBe true }
+      fixture.submissions.expectNoMessage(200.millis)
+    }
+  }
+
+  it should "retain an owned mining failure on semantic rejection of a pending submission" in {
+    withFixture() { fixture =>
+      val block = fixture.solve(fixture.candidate())
+      fixture.submit(block)
+      val pause = TestProbe()(fixture.system)
+      fixture.generator.tell(PauseOwnedSubmissionV1(nonce, operation), pause.ref)
